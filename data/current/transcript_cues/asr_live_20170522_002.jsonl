{"confidence": null, "cue_index": 0, "end_sec": 26.5, "id": "TR_LIVE_20170522_002_asr_raw_zh_001_CUE_000000", "live_id": "LIVE_20170522_002", "source_cue_id": null, "speaker_entity_id": null, "start_sec": 0.0, "text": "大家好,我试试啊,我试试啊,什么情况?", "timing_status": "asr", "transcript_version_id": "TR_LIVE_20170522_002_asr_raw_zh_001"}
