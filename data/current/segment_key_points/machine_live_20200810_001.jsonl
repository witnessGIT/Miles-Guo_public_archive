{"confidence": 0.68, "created_at": "2026-10-20T08:02:27.146306+00:00", "event_id": null, "evidence_end_char": 313, "evidence_quote": "包括這個父母過生日 家人不能團結", "evidence_start_char": 297, "extraction_method": "qwen2.5-7b-instruct-4bit-grounded-keypoints-v4-forced-retry", "extraction_status": "machine", "id": "KPT_LIVE_20200810_001_SEG_000000_005", "importance": 0.7, "point_index": 5, "point_text": "父母过生日时，家人不能团聚。", "point_type": "context", "segment_id": "LIVE_20200810_001_SEG_000000", "significance": "描述了家庭团聚的情况。", "supporting_claim_id": null, "topic_id": "TOPIC_POLITICS_GOVERNANCE"}
