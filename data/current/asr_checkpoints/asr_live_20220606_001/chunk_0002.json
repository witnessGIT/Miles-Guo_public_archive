      "compression_ratio": 1.329897,
      "end": 1806.66,
      "no_speech_prob": 0.0,
      "start": 1803.24,
      "text": "七哥就是個與眾不同的正常人"
    },
    {
      "avg_logprob": -0.378443,
      "compression_ratio": 1.329897,
      "end": 1813.06,
      "no_speech_prob": 0.0,
      "start": 1809.86,
      "text": "但是七哥的情商和對你們的愛"
    },
    {
      "avg_logprob": -0.378443,
      "compression_ratio": 1.329897,
      "end": 1814.76,
      "no_speech_prob": 0.0,
      "start": 1813.06,
      "text": "絕對是和常人不一樣"
    },
    {
      "avg_logprob": -0.378443,
      "compression_ratio": 1.329897,
      "end": 1817.44,
      "no_speech_prob": 0.0,
      "start": 1814.76,
      "text": "七哥的勇敢、誠實"
    },
    {
      "avg_logprob": -0.378443,
      "compression_ratio": 1.329897,
      "end": 1820.66,
      "no_speech_prob": 0.0,
      "start": 1817.44,
      "text": "跟所有人很多人是不一樣的"
    },
    {
      "avg_logprob": -0.378443,
      "compression_ratio": 1.329897,
      "end": 1821.96,
      "no_speech_prob": 0.0,
      "start": 1820.66,
      "text": "你們有感覺"
    },
    {
      "avg_logprob": -0.378443,
      "compression_ratio": 1.329897,
      "end": 1824.34,
      "no_speech_prob": 0.0,
      "start": 1821.96,
      "text": "還是那句話"
    },
    {
      "avg_logprob": -0.378443,
      "compression_ratio": 1.329897,
      "end": 1827.14,
      "no_speech_prob": 0.0,
      "start": 1824.34,
      "text": "新中國聯邦人永不為奴"
    },
    {
      "avg_logprob": -0.267605,
      "compression_ratio": 1.46888,
      "end": 1830.64,
      "no_speech_prob": 0.0,
      "start": 1827.14,
      "text": "新中國聯邦人不會看任何人的臉色"
    },
    {
      "avg_logprob": -0.267605,
      "compression_ratio": 1.46888,
      "end": 1834.9,
      "no_speech_prob": 0.0,
      "start": 1830.64,
      "text": "新中國聯邦人不允許任何人有任何的虛假"
    },
    {
      "avg_logprob": -0.267605,
      "compression_ratio": 1.46888,
      "end": 1837.64,
      "no_speech_prob": 0.0,
      "start": 1834.9,
      "text": "必須堅持違真主義走正道主義"
    },
    {
      "avg_logprob": -0.267605,
      "compression_ratio": 1.46888,
      "end": 1841.64,
      "no_speech_prob": 0.0,
      "start": 1837.64,
      "text": "我們連在一起唯一的一個最追求的信仰"
    },
    {
      "avg_logprob": -0.267605,
      "compression_ratio": 1.46888,
      "end": 1846.34,
      "no_speech_prob": 0.0,
      "start": 1841.64,
      "text": "追求的信仰叫建設一個一人一票的"
    },
    {
      "avg_logprob": -0.267605,
      "compression_ratio": 1.46888,
      "end": 1851.2,
      "no_speech_prob": 0.0,
      "start": 1846.34,
      "text": "選舉的中國的民主法治信仰自由的政策制度"
    },
    {
      "avg_logprob": -0.267605,
      "compression_ratio": 1.46888,
      "end": 1852.68,
      "no_speech_prob": 0.0,
      "start": 1851.2,
      "text": "我們不參與"
    },
    {
      "avg_logprob": -0.267605,
      "compression_ratio": 1.46888,
      "end": 1853.68,
      "no_speech_prob": 0.0,
      "start": 1852.68,
      "text": "但我們要監督"
    },
    {
      "avg_logprob": -0.267605,
      "compression_ratio": 1.46888,
      "end": 1856.84,
      "no_speech_prob": 0.0,
      "start": 1853.68,
      "text": "我們要督促和讓它實現"
