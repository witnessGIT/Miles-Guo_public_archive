  "segments": [
    {
      "end": 9901.56,
      "start": 9900.0,
      "text": "再支人的錢還過去"
    },
    {
      "end": 9904.44,
      "start": 9902.56,
      "text": "你能想像的到嗎"
    },
    {
      "end": 9907.36,
      "start": 9905.06,
      "text": "同樣的是讓李嘉誠看他兒子"
    },
    {
      "end": 9912.46,
      "start": 9907.36,
      "text": "看他當年所有的性亂性玩小孩玩處女的視頻"
    },
    {
      "end": 9915.36,
      "start": 9914.14,
      "text": "他說這是你到這個問題"
    },
    {
      "end": 9917.3,
      "start": 9915.36,
      "text": "我會讓你超人一夜變成垃圾"
    },
    {
      "end": 9920.6,
      "start": 9918.34,
      "text": "然後你所有的錢你怎麼弄的"
    },
    {
      "end": 9924.84,
      "start": 9922.14,
      "text": "包括你換這些心臟換腎怎麼換的"
    },
    {
      "end": 9927.7,
      "start": 9924.84,
      "text": "這人死之間這個活的人摘掉腎的時候"
    },
    {
      "end": 9929.34,
      "start": 9927.7,
      "text": "怎麼換到你李嘉誠身上去的"
    },
    {
      "end": 9933.4,
      "start": 9930.0,
      "text": "哇塞這真的夠雷人的兄弟姐妹們"
    },
    {
      "end": 9941.0,
      "start": 9933.4,
      "text": "李嘉誠啊老頭竟然能接受活人切割機關的腎啊"
    },
    {
      "end": 9942.8,
      "start": 9941.0,
      "text": "他怪不得活到94了"
    },
    {
      "end": 9947.3,
      "start": 9945.8,
      "text": "太嚇人了"
    },
    {
      "end": 9953.0,
      "start": 9948.9,
      "text": "過去玩這個醜女陰道裡邊泡澡吃"
    },
    {
      "end": 9955.1,
      "start": 9953.0,
      "text": "這是孟建柱王岐山的專利"
    },
    {
      "end": 9957.8,
      "start": 9955.1,
      "text": "這香港富豪大律師全玩啊"
    },
    {
      "end": 9962.2,
      "start": 9957.8,
      "text": "他說七哥你知道嗎"
    },
    {
      "end": 9964.5,
      "start": 9962.2,
      "text": "你講那個老百姓聽不懂"
    },
    {
      "end": 9965.6,
      "start": 9964.5,
      "text": "他說我們這是"
    },
    {
      "end": 9969.4,
      "start": 9966.1,
      "text": "他說真是看完你直播我們問一個零一個"
    },
    {
      "end": 9970.6,
      "start": 9969.4,
      "text": "問一個零一個"
    },
    {
      "end": 9972.7,
      "start": 9970.6,
      "text": "只有過之沒有不及啊"
    },
    {
      "end": 9975.6,
      "start": 9972.7,
      "text": "鄭家存家族"
    },
    {
      "end": 9978.1,
      "start": 9976.1,
      "text": "他說老頭這鄭一頭咋死的"
    },
    {
      "end": 9979.4,
      "start": 9978.1,
      "text": "他不就是玩女人玩的嗎"
    },
    {
      "end": 9980.1,
      "start": 9979.4,
      "text": "吃尾根吃"
    },
    {
      "end": 9981.1,
      "start": 9980.1,
      "text": "你說太對了"
    },
    {
      "end": 9982.8,
      "start": 9981.1,
      "text": "他說鄭家存也是這樣"
    },
    {
      "end": 9984.9,
      "start": 9983.6,
      "text": "他說這全部啊"
    },
    {
      "end": 9986.3,
      "start": 9984.9,
      "text": "他資產都得還回去"
    },
    {
      "end": 9989.7,
      "start": 9987.1,
      "text": "很多香港人都是代持啊"
    },
    {
      "end": 9993.1,
      "start": 9989.7,
      "text": "東京你能想象得到嗎"
    },
    {
      "end": 9995.1,
      "start": 9993.1,
      "text": "這個你能想象得到嗎"
    },
    {
      "end": 9998.1,
      "start": 9996.1,
      "text": "這幫香港的報應啊"
    },
    {
      "end": 10000.3,
      "start": 9998.1,
      "text": "你們幫助共產黨的腐敗"
    },
    {
      "end": 10001.3,
      "start": 10000.3,
      "text": "帶著那麼的非法"
    },
    {
      "end": 10002.5,
      "start": 10001.3,
      "text": "雖然害死大陸人"
    },
    {
      "end": 10003.9,
      "start": 10002.5,
      "text": "現在輪到你們頭上去了"
    },
    {
      "end": 10005.3,
      "start": 10004.1,
      "text": "說那些大律師"
    },
    {
      "end": 10008.1,
      "start": 10005.3,
      "text": "說大律師都是幾乎變態玩"
    },
    {
      "end": 10009.1,
      "start": 10008.1,
      "text": "你玩出男"
    },
    {
      "end": 10012.5,
      "start": 10010.6,
      "text": "他說孫力軍孟建柱很簡單"
    },
    {
      "end": 10013.3,
      "start": 10012.5,
      "text": "叫他別看最別"
    },
    {
      "end": 10016.7,
      "start": 10014.2,
      "text": "先把他心靈叫他見識見識他自己"
    },
    {
      "end": 10018.0,
      "start": 10016.7,
      "text": "叫認清自己"
    },
    {
      "end": 10019.7,
      "start": 10018.5,
      "text": "認清完自己了吧"
    },
    {
      "end": 10021.0,
      "start": 10020.0,
      "text": "我們可以保護你"
    },
    {
      "end": 10023.5,
      "start": 10021.5,
      "text": "重塑一個新的你啊"
    },
    {
      "end": 10024.2,
      "start": 10023.5,
      "text": "聽黨的話"
    },
    {
      "end": 10025.7,
      "start": 10024.8,
      "text": "讓你幹啥你幹啥"
    },
    {
      "end": 10029.7,
      "start": 10028.0,
      "text": "然後香港的某地產家族啊"
    },
    {
      "end": 10031.3,
      "start": 10029.7,
      "text": "跟我一個姓呢姓郭的啊"
    },
    {
      "end": 10032.6,
      "start": 10032.0,
      "text": "我就別說了"
    },
    {
      "end": 10034.7,
      "start": 10032.6,
      "text": "因為這是我們都很好的"
    },
    {
      "end": 10035.7,
      "start": 10034.7,
      "text": "這很近的啊"
    },
    {
      "end": 10038.7,
      "start": 10035.7,
      "text": "說全家一開始好硬啊"
    },
    {
      "end": 10039.7,
      "start": 10038.7,
      "text": "因為他有本錢嘛"
    },
    {
      "end": 10042.5,
      "start": 10040.3,
      "text": "最後讓他全家在一起看視頻"
    },
    {
      "end": 10046.7,
      "start": 10043.3,
      "text": "讓爸爸叔叔兒子老婆兒媳婦"
    },
    {
      "end": 10049.3,
      "start": 10047.6,
      "text": "侄子侄子一起看視頻"
    },
    {
      "end": 10049.9,
      "start": 10049.3,
      "text": "全傻了"
    },
    {
      "end": 10052.3,
      "start": 10050.9,
      "text": "全家內部沒有在鬥爭了"
    },
    {
      "end": 10052.9,
      "start": 10052.3,
      "text": "全閉嘴"
    },
    {
      "end": 10055.3,
      "start": 10054.3,
      "text": "女的也玩"
    },
    {
      "end": 10061.0,
      "start": 10059.0,
      "text": "女的找各種服飾的人玩"
    },
    {
      "end": 10064.3,
      "start": 10063.3,
      "text": "你還想活嗎"
    },
    {
      "end": 10065.5,
      "start": 10064.5,
      "text": "想活聽黨的話"
    },
    {
      "end": 10067.0,
      "start": 10065.7,
      "text": "從做一個你"
    },
    {
      "end": 10071.7,
      "start": 10070.3,
      "text": "美國人砸不完"
    },
    {
      "end": 10073.3,
      "start": 10071.7,
      "text": "把他拿斧子砸腦袋"
    },
    {
      "end": 10075.3,
      "start": 10073.3,
      "text": "他也不相信這件事真的會發生"
    },
    {
      "end": 10080.1,
      "start": 10076.2,
      "text": "這就是今天你們看到中國和西方最根本的不同"
    },
    {
      "end": 10084.2,
      "start": 10081.1,
      "text": "我不相信當年希特勒能做出這種上進"
    },
    {
      "end": 10086.6,
      "start": 10085.0,
      "text": "人寰的這種這種地方"
    },
    {
      "end": 10094.2,
      "start": 10086.6,
      "text": "你說我你把我放屋裡邊讓你起扫和我和我兒子我給你看"
    },
    {
      "end": 10097.4,
      "start": 10094.2,
      "text": "互相過曾經互相布置的亂倫視頻"
    },
    {
      "end": 10099.2,
      "start": 10097.4,
      "text": "那我一秒鐘也活不了了"
    },
    {
      "end": 10101.8,
      "start": 10099.2,
      "text": "這人能活下去"
    },
    {
      "end": 10104.3,
      "start": 10101.8,
      "text": "共產黨就敢這麼幹"
    },
    {
      "end": 10109.8,
      "start": 10106.8,
      "text": "而且還繼續給錢還繼續活"
    },
    {
      "end": 10111.3,
      "start": 10109.8,
      "text": "繼續敢支持黨"
    },
    {
      "end": 10112.7,
      "start": 10111.3,
      "text": "這四大不要臉"
    },
    {
      "end": 10115.1,
      "start": 10112.7,
      "text": "這是天王啊"
    },
    {
      "end": 10116.9,
      "start": 10115.1,
      "text": "還有大律師啊"
    },
    {
      "end": 10118.9,
      "start": 10116.9,
      "text": "大律政啊"
    },
    {
      "end": 10122.3,
      "start": 10120.9,
      "text": "還有這些大地產商"
    },
    {
      "end": 10123.3,
      "start": 10122.3,
      "text": "大金融家"
    },
    {
      "end": 10124.9,
      "start": 10123.9,
      "text": "他大業力"
    },
    {
      "end": 10127.2,
      "start": 10124.9,
      "text": "我發現這個世界只要撐大字的"
    },
    {
      "end": 10129.9,
      "start": 10127.2,
      "text": "只要撐罪字的幾乎都是騙子"
    },
    {
      "end": 10135.7,
      "start": 10129.9,
      "text": "你知道你七哥聽到他嘴裡說出來得到驗證"
    },
    {
      "end": 10136.6,
      "start": 10135.7,
      "text": "就像埃格拉斯說"
    },
    {
      "end": 10139.5,
      "start": 10136.6,
      "text": "七哥我驗證你2017年之不一樣"
    },
    {
      "end": 10140.5,
      "start": 10139.5,
      "text": "那種感覺"
    },
    {
      "end": 10142.3,
      "start": 10141.3,
      "text": "肛門上題"
    },
    {
      "end": 10143.5,
      "start": 10142.3,
      "text": "深呼吸"
    },
    {
      "end": 10144.8,
      "start": 10143.5,
      "text": "呼吸不順"
    },
    {
      "end": 10148.3,
      "start": 10144.8,
      "text": "回身起雞皮疙瘩的那種高潮感就來了"
    },
    {
      "end": 10149.5,
      "start": 10148.3,
      "text": "還很刺激"
    },
    {
      "end": 10152.5,
      "start": 10150.5,
      "text": "但是這哥們跟我說的過程當中"
    },
    {
      "end": 10154.9,
      "start": 10152.5,
      "text": "真把我說的我高潮好多次"
    },
    {
      "end": 10157.5,
      "start": 10155.7,
      "text": "原來我們爆料革命"
    },
    {
      "end": 10159.5,
      "start": 10158.5,
      "text": "這麼偉大"
    },
    {
      "end": 10161.9,
      "start": 10160.7,
      "text": "這四大不要臉"
    },
    {
      "end": 10165.1,
      "start": 10162.7,
      "text": "香港人這也是很可憐"
    },
    {
      "end": 10168.3,
      "start": 10166.3,
      "text": "被這些人剝削了100年"
    },
    {
      "end": 10170.3,
      "start": 10168.7,
      "text": "現在又被他們出賣"
    },
    {
      "end": 10172.3,
      "start": 10170.3,
      "text": "都是一幫人渣呀"
    },
    {
      "end": 10174.3,
      "start": 10173.1,
      "text": "從某種角度說"
    },
    {
      "end": 10174.9,
      "start": 10174.3,
      "text": "東底"
    },
    {
      "end": 10175.7,
      "start": 10174.9,
      "text": "尹妹妹"
    },
    {
      "end": 10176.3,
      "start": 10175.7,
      "text": "埃格拉斯"
    },
    {
      "end": 10177.1,
      "start": 10176.3,
      "text": "菲菲呀"
    },
    {
      "end": 10178.7,
      "start": 10177.3,
      "text": "青藤你們有沒有感覺"
    },
    {
      "end": 10181.3,
      "start": 10179.4,
      "text": "某種程度上這也是好事"
    },
    {
      "end": 10186.7,
      "start": 10183.5,
      "text": "把香港砸爛了重新重建一次也是好事"
    },
    {
      "end": 10189.5,
      "start": 10186.7,
      "text": "太壞了"
    },
    {
      "end": 10192.3,
      "start": 10189.5,
      "text": "中國人就過不了幾天好日子"
    },
    {
      "end": 10194.7,
      "start": 10192.3,
      "text": "過點好日子就折騰人"
    },
    {
      "end": 10195.9,
      "start": 10194.7,
      "text": "往死的變態折騰人"
    },
    {
      "end": 10197.9,
      "start": 10195.9,
      "text": "就那些小星星們"
    },
    {
      "end": 10198.9,
      "start": 10197.9,
      "text": "就這些不要臉的東西"
    },
    {
      "end": 10200.9,
      "start": 10198.9,
      "text": "過去是游泳過去的人"
    },
    {
      "end": 10202.9,
      "start": 10200.9,
      "text": "暴富以後就這麼折騰人"
    },
    {
      "end": 10204.5,
      "start": 10202.9,
      "text": "埃格拉斯你是醫生"
    },
    {
      "end": 10206.7,
      "start": 10204.5,
      "text": "你想想李嘉誠這樣活著"
    },
    {
      "end": 10207.7,
      "start": 10206.7,
      "text": "怎麼能接受一個活著"
    },
    {
      "end": 10208.9,
      "start": 10207.7,
      "text": "把人甚至給他身上"
    },
    {
      "end": 10210.9,
      "start": 10208.9,
      "text": "他怎麼能天天喘著氣呢"
    },
    {
      "end": 10212.9,
      "start": 10210.9,
      "text": "他有多變態呢"
    },
    {
      "end": 10213.7,
      "start": 10212.9,
      "text": "變態呢"
    },
    {
      "end": 10215.7,
      "start": 10214.7,
      "text": "就這些不要臉的"
    },
    {
      "end": 10218.5,
      "start": 10215.7,
      "text": "結果他做過不是一次兩三次的移植手術"
    },
    {
      "end": 10222.1,
      "start": 10220.9,
      "text": "埃格拉斯你先說說"
    },
    {
      "end": 10222.9,
      "start": 10222.1,
      "text": "你啥感受"
    },
    {
      "end": 10229.7,
      "start": 10228.7,
      "text": "首先我很震驚"
    },
    {
      "end": 10232.9,
      "start": 10231.1,
      "text": "但是我跟了七哥那麼多年"
    },
    {
      "end": 10236.7,
      "start": 10234.9,
      "text": "可能也是部分被免疫了"
    },
    {
      "end": 10239.1,
      "start": 10236.7,
      "text": "所以我現在有些事情我也可以想"
    },
    {
      "end": 10241.1,
      "start": 10239.5,
      "text": "你比方說腎臟移植"
    },
    {
      "end": 10242.7,
      "start": 10241.1,
      "text": "這氣管移植的事情"
    },
    {
      "end": 10247.9,
      "start": 10246.3,
      "text": "我在做住院醫生的時候"
    },
    {
      "end": 10248.9,
      "start": 10247.9,
      "text": "我有一個任務"
    },
    {
      "end": 10251.5,
      "start": 10248.9,
      "text": "就是我們這個醫院"
    },
    {
      "end": 10253.5,
      "start": 10251.5,
      "text": "也是中國最早的"
    },
    {
      "end": 10255.5,
      "start": 10253.5,
      "text": "氣管移植的一個中心醫院"
    },
    {
      "end": 10257.1,
      "start": 10255.5,
      "text": "所以很多氣管移植"
    },
    {
      "end": 10258.9,
      "start": 10257.1,
      "text": "他們這個氣管的"
    },
    {
      "end": 10261.5,
      "start": 10259.5,
      "text": "這個鑽氣管者"
    },
    {
      "end": 10264.1,
      "start": 10261.5,
      "text": "都是在晚南的"
    },
    {
      "end": 10265.9,
      "start": 10264.9,
      "text": "勞鯛農場"
    },
    {
      "end": 10267.5,
      "start": 10266.3,
      "text": "因為我知道他們到時候"
    },
    {
      "end": 10268.5,
      "start": 10267.5,
      "text": "要去取氣管的時候"
    },
    {
      "end": 10269.9,
      "start": 10268.5,
      "text": "因為我也在外科系統"
    },
