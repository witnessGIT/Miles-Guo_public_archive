    },
    {
      "end": 7758.94,
      "start": 7756.9,
      "text": "他們用圈養的方式"
    },
    {
      "end": 7759.8,
      "start": 7758.94,
      "text": "在培養人"
    },
    {
      "end": 7760.94,
      "start": 7759.8,
      "text": "他們沒有培養"
    },
    {
      "end": 7761.3,
      "start": 7760.94,
      "text": "對吧"
    },
    {
      "end": 7762.4,
      "start": 7761.3,
      "text": "他只是圈養"
    },
    {
      "end": 7765.28,
      "start": 7762.4,
      "text": "用一個形式讓你得了冠軍"
    },
    {
      "end": 7766.5,
      "start": 7765.28,
      "text": "得不了你就完蛋"
    },
    {
      "end": 7766.9,
      "start": 7766.5,
      "text": "啊"
    },
    {
      "end": 7767.78,
      "start": 7766.9,
      "text": "那麼父親"
    },
    {
      "end": 7768.9,
      "start": 7767.78,
      "text": "就跟我講"
    },
    {
      "end": 7771.34,
      "start": 7768.9,
      "text": "一個人最沒本事的就是自殺"
    },
    {
      "end": 7773.34,
      "start": 7771.34,
      "text": "這就是在我從小"
    },
    {
      "end": 7774.84,
      "start": 7773.34,
      "text": "得到的教育裡面"
    },
    {
      "end": 7775.74,
      "start": 7774.84,
      "text": "我就知道"
    },
    {
      "end": 7778.84,
      "start": 7775.74,
      "text": "人不能輕易的摧殘自己"
    },
    {
      "end": 7781.34,
      "start": 7778.84,
      "text": "因為你們得益於父母"
    },
    {
      "end": 7784.34,
      "start": 7781.34,
      "text": "應該去立足於社會"
    },
    {
      "end": 7789.28,
      "start": 7784.34,
      "text": "但是不能把懦弱當成藉口"
    },
    {
      "end": 7791.78,
      "start": 7789.28,
      "text": "自己說哎呀我孝敬我那個"
    },
    {
      "end": 7792.98,
      "start": 7791.78,
      "text": "純粗扯淡"
    },
    {
      "end": 7795.56,
      "start": 7792.98,
      "text": "剛才七哥說的非常非常的"
    },
    {
      "end": 7798.02,
      "start": 7795.56,
      "text": "就是能讓我認可的"
    },
    {
      "end": 7801.1,
      "start": 7798.02,
      "text": "我也是17年在國內聽到了爆料革命"
    },
    {
      "end": 7805.3,
      "start": 7801.1,
      "text": "到今天我願意站出來的很大的原因"
    },
    {
      "end": 7807.56,
      "start": 7805.3,
      "text": "就是我認同他的觀點"
    },
    {
      "end": 7810.76,
      "start": 7807.56,
      "text": "別的就像這位醫生指的"
    },
    {
      "end": 7812.36,
      "start": 7810.76,
      "text": "他這麼好的"
    },
    {
      "end": 7813.9,
      "start": 7812.36,
      "text": "我知道他這麼好的專業"
    },
    {
      "end": 7818.04,
      "start": 7813.9,
      "text": "我知道他為什麼可以跟著爆料革命"
    },
    {
      "end": 7819.78,
      "start": 7818.04,
      "text": "因為你講了事實"
    },
    {
      "end": 7823.24,
      "start": 7819.78,
      "text": "以及可以認知的東西"
    },
    {
      "end": 7825.94,
      "start": 7823.24,
      "text": "而不是說你什麼爆了料什麼"
    },
    {
      "end": 7826.74,
      "start": 7825.94,
      "text": "這扯淡"
    },
    {
      "end": 7827.84,
      "start": 7826.74,
      "text": "對吧你沒有驗證"
    },
    {
      "end": 7829.34,
      "start": 7827.84,
      "text": "沒有最後事實裡面"
    },
    {
      "end": 7831.56,
      "start": 7829.34,
      "text": "我們認可的東西沒有邏輯"
    },
    {
      "end": 7832.56,
      "start": 7831.56,
      "text": "我認你個屁"
    },
    {
      "end": 7833.76,
      "start": 7832.56,
      "text": "我們又不是傻子"
    },
    {
      "end": 7836.16,
      "start": 7833.76,
      "text": "對吧所有這些體制內的人"
    },
    {
      "end": 7837.4,
      "start": 7836.16,
      "text": "對吧你們這些孫子"
    },
    {
      "end": 7839.16,
      "start": 7837.4,
      "text": "我們都從小在一起"
    },
    {
      "end": 7841.5,
      "start": 7839.16,
      "text": "你只是比我大個一點時間"
    },
    {
      "end": 7842.56,
      "start": 7841.5,
      "text": "就像剛才說的那些"
    },
    {
      "end": 7844.62,
      "start": 7842.56,
      "text": "王健林 徐明 許家印"
    },
    {
      "end": 7845.7,
      "start": 7844.62,
      "text": "孫紅斌"
    },
    {
      "end": 7846.7,
      "start": 7845.7,
      "text": "那個孫紅斌"
    },
    {
      "end": 7850.2,
      "start": 7846.7,
      "text": "為了拿塊地天天在天津"
    },
    {
      "end": 7851.9,
      "start": 7850.2,
      "text": "對吧陪我們吃飯"
    },
    {
      "end": 7854.84,
      "start": 7851.9,
      "text": "你胡說八道用小三那個敏洪"
    },
    {
      "end": 7855.4,
      "start": 7854.84,
      "text": "對吧"
    },
    {
      "end": 7857.84,
      "start": 7855.4,
      "text": "在重慶有項目做不了了"
    },
    {
      "end": 7860.38,
      "start": 7857.84,
      "text": "不是在找我讓我去找薄熙來"
    },
    {
      "end": 7860.98,
      "start": 7860.38,
      "text": "對吧"
    },
    {
      "end": 7863.62,
      "start": 7860.98,
      "text": "就是我見了他們這些所謂做生意的"
    },
    {
      "end": 7865.12,
      "start": 7863.62,
      "text": "都是下三爛"
    },
    {
      "end": 7866.38,
      "start": 7865.12,
      "text": "都在我眼裡"
    },
    {
      "end": 7868.02,
      "start": 7866.38,
      "text": "他們連個屁都不是"
    },
    {
      "end": 7868.32,
      "start": 7868.02,
      "text": "對吧"
    },
    {
      "end": 7870.42,
      "start": 7868.32,
      "text": "王健林送人假表太多了"
    },
    {
      "end": 7871.46,
      "start": 7870.42,
      "text": "弄假話"
    },
    {
      "end": 7871.82,
      "start": 7871.46,
      "text": "對吧"
    },
    {
      "end": 7873.72,
      "start": 7871.82,
      "text": "開始利用郭慶祥"
    },
    {
      "end": 7874.82,
      "start": 7873.72,
      "text": "萬達月寶摘"
    },
    {
      "end": 7876.52,
      "start": 7874.82,
      "text": "送給那個賈慶林"
    },
    {
      "end": 7877.42,
      "start": 7876.52,
      "text": "開始弄的嗎"
    },
    {
      "end": 7878.24,
      "start": 7877.42,
      "text": "這"
    },
    {
      "end": 7880.54,
      "start": 7878.24,
      "text": "他們走的每一步"
    },
    {
      "end": 7881.44,
      "start": 7880.54,
      "text": "每一個點"
    },
    {
      "end": 7883.04,
      "start": 7881.44,
      "text": "每一個東西"
    },
    {
      "end": 7884.84,
      "start": 7883.04,
      "text": "都是我親身經歷"
    },
    {
      "end": 7886.78,
      "start": 7884.84,
      "text": "所有在社會上的"
    },
    {
      "end": 7888.14,
      "start": 7886.78,
      "text": "在軍隊裡的"
    },
    {
      "end": 7889.14,
      "start": 7888.14,
      "text": "在體制內的"
    },
    {
      "end": 7890.64,
      "start": 7889.14,
      "text": "你們每個人"
    },
    {
      "end": 7893.24,
      "start": 7890.64,
      "text": "浩海東講的每一個人"
    },
    {
      "end": 7894.64,
      "start": 7893.24,
      "text": "我都認識吧"
    },
    {
      "end": 7896.74,
      "start": 7894.64,
      "text": "你們沒有一個人"
    },
    {
      "end": 7897.98,
      "start": 7896.74,
      "text": "可以薄熙來"
    },
    {
      "end": 7900.62,
      "start": 7897.98,
      "text": "那都是來我們這個這個會議室"
    },
    {
      "end": 7902.92,
      "start": 7900.62,
      "text": "給我們開準備會的"
    },
    {
      "end": 7903.18,
      "start": 7902.92,
      "text": "對吧"
    },
    {
      "end": 7904.06,
      "start": 7903.18,
      "text": "我們下午踢球"
    },
    {
      "end": 7906.12,
      "start": 7904.06,
      "text": "他們他來開準備會啊"
    },
    {
      "end": 7907.7,
      "start": 7906.12,
      "text": "薄熙來都都是這樣"
    },
    {
      "end": 7909.66,
      "start": 7907.7,
      "text": "你想想我跟他有多熟"
    },
    {
      "end": 7911.46,
      "start": 7909.66,
      "text": "隨便他在瀋陽當省長"
    },
    {
      "end": 7912.8,
      "start": 7911.46,
      "text": "我敲敲門就去"
    },
    {
      "end": 7913.54,
      "start": 7912.8,
      "text": "對吧"
    },
    {
      "end": 7914.86,
      "start": 7913.54,
      "text": "他在重慶當市委書記"
    },
    {
      "end": 7916.94,
      "start": 7914.86,
      "text": "我敲敲門就去"
    },
    {
      "end": 7918.0,
      "start": 7916.94,
      "text": "轉過天來的什麼"
    },
    {
      "end": 7919.64,
      "start": 7918.0,
      "text": "吳文康王立軍什麼的"
    },
    {
      "end": 7921.4,
      "start": 7919.64,
      "text": "在車會他們都聽我吃飯"
    },
    {
      "end": 7922.2,
      "start": 7921.4,
      "text": "對吧"
    },
    {
      "end": 7924.68,
      "start": 7922.2,
      "text": "那個王立軍弄個轉盤"
    },
    {
      "end": 7926.3,
      "start": 7924.68,
      "text": "最後弄個壽司回轉"
    },
    {
      "end": 7927.0,
      "start": 7926.3,
      "text": "他告訴我"
    },
    {
      "end": 7927.8,
      "start": 7927.0,
      "text": "這是我的"
    },
    {
      "end": 7928.48,
      "start": 7927.8,
      "text": "排東你看啊"
    },
    {
      "end": 7929.98,
      "start": 7928.48,
      "text": "這是我發明專利啊"
    },
    {
      "end": 7931.34,
      "start": 7929.98,
      "text": "你說這幫孫子"
    },
    {
      "end": 7933.22,
      "start": 7931.34,
      "text": "就是共產黨的"
    },
    {
      "end": 7935.56,
      "start": 7933.22,
      "text": "惡跟幼稚跟low"
    },
    {
      "end": 7937.82,
      "start": 7935.56,
      "text": "你都可以看出來"
    },
    {
      "end": 7940.12,
      "start": 7937.82,
      "text": "他們有多麼多的農民"
    },
    {
      "end": 7940.92,
      "start": 7940.12,
      "text": "我告訴你"
    },
    {
      "end": 7942.36,
      "start": 7940.92,
      "text": "他們的農民"
    },
    {
      "end": 7944.3,
      "start": 7942.36,
      "text": "他們的low"
    },
    {
      "end": 7946.3,
      "start": 7944.3,
      "text": "他們的沒有見過世面"
    },
    {
      "end": 7948.74,
      "start": 7946.3,
      "text": "他們不知道世界在發生的變化"
    },
    {
      "end": 7951.7,
      "start": 7948.74,
      "text": "以及世界文明走到什麼樣的程度"
    },
    {
      "end": 7953.48,
      "start": 7951.7,
      "text": "你們都不可想像"
    },
    {
      "end": 7955.98,
      "start": 7953.48,
      "text": "這也是為什麼我們倆站出來"
    },
    {
      "end": 7958.14,
      "start": 7955.98,
      "text": "因為我們感覺太可憐了"
    },
    {
      "end": 7959.94,
      "start": 7958.14,
      "text": "老百姓太可憐了"
    },
    {
      "end": 7961.78,
      "start": 7959.94,
      "text": "我們的父母親"
    },
    {
      "end": 7963.78,
      "start": 7961.78,
      "text": "小葉的父母親"
    },
    {
      "end": 7965.42,
      "start": 7963.78,
      "text": "我們的親戚朋友"
    },
    {
      "end": 7966.86,
      "start": 7965.42,
      "text": "我們看到了他"
    },
    {
      "end": 7968.96,
      "start": 7966.86,
      "text": "我們這二十多年"
    },
    {
      "end": 7970.46,
      "start": 7968.96,
      "text": "掙到了錢"
    },
    {
      "end": 7973.26,
      "start": 7970.46,
      "text": "而且尤其我們還職業化了"
    },
    {
      "end": 7977.56,
      "start": 7973.26,
      "text": "接觸到世界上這麼多先進的文明的東西"
    },
    {
      "end": 7980.16,
      "start": 7977.56,
      "text": "但是我們的老百姓"
    },
    {
      "end": 7982.9,
      "start": 7980.16,
      "text": "沒有任何在思想境界上"
    },
    {
      "end": 7984.54,
      "start": 7982.9,
      "text": "精神層面上的提高"
    },
    {
      "end": 7985.74,
      "start": 7984.54,
      "text": "沒有意料"
    },
    {
      "end": 7988.68,
      "start": 7985.74,
      "text": "他們依舊是抱著孩子"
    },
    {
      "end": 7989.48,
      "start": 7988.68,
      "text": "別動著"
    },
    {
      "end": 7990.18,
      "start": 7989.48,
      "text": "別磕著"
    },
    {
      "end": 7991.42,
      "start": 7990.18,
      "text": "我跟大家講"
    },
    {
      "end": 7993.72,
      "start": 7991.42,
      "text": "那是中國最牛逼的"
    },
    {
      "end": 7994.92,
      "start": 7993.72,
      "text": "他們剛才說的"
    },
    {
      "end": 7996.38,
      "start": 7994.92,
      "text": "8341的領導的"
    },
    {
      "end": 7997.36,
      "start": 7996.38,
      "text": "孩子的孩子"
    },
    {
      "end": 7997.96,
      "start": 7997.36,
      "text": "孩子"
    },
    {
      "end": 8001.16,
      "start": 7998.88,
      "text": "在四合院裡走"
    },
    {
      "end": 8002.26,
      "start": 8001.16,
      "text": "那都是混血"
    },
    {
      "end": 8003.06,
      "start": 8002.26,
      "text": "怕他摔著"
    },
    {
      "end": 8005.66,
      "start": 8004.2,
      "text": "在膝關節上"
    },
    {
      "end": 8007.12,
      "start": 8005.66,
      "text": "給他的外孫子"
    },
    {
      "end": 8009.0,
      "start": 8007.12,
      "text": "都帶上護膝"
    },
    {
      "end": 8012.16,
      "start": 8009.6,
      "text": "這都是我們看見親身經歷的"
    },
    {
      "end": 8016.76,
      "start": 8012.16,
      "text": "那個四合院幾個億"
    },
    {
      "end": 8017.76,
      "start": 8016.76,
      "text": "沒錯吧"
    },
    {
      "end": 8018.86,
      "start": 8017.76,
      "text": "在北京"
    },
    {
      "end": 8019.86,
      "start": 8018.86,
      "text": "對吧"
    },
    {
      "end": 8022.2,
      "start": 8019.86,
      "text": "人家幹的所謂這些房地產"
    },
    {
      "end": 8023.54,
      "start": 8022.2,
      "text": "他們這些傻子們"
    },
    {
      "end": 8024.84,
      "start": 8023.54,
      "text": "你們這些孫子"
    },
    {
      "end": 8026.28,
      "start": 8024.84,
      "text": "真的我講的每一句話"
    },
    {
      "end": 8027.34,
      "start": 8026.28,
      "text": "你們應該知道"
    },
    {
      "end": 8028.68,
      "start": 8027.34,
      "text": "你們幹的幾萬億"
    },
    {
      "end": 8029.88,
      "start": 8028.68,
      "text": "沒有一分錢是你的"
    },
    {
      "end": 8030.78,
      "start": 8029.88,
      "text": "對吧"
    },
    {
      "end": 8032.54,
      "start": 8030.78,
      "text": "人家幹點民宿"
    },
    {
      "end": 8033.34,
      "start": 8032.54,
      "text": "對吧"
    },
    {
      "end": 8035.12,
      "start": 8033.34,
      "text": "都比你們牛逼一萬倍"
    },
    {
      "end": 8036.58,
      "start": 8035.12,
      "text": "你們在這忙啥呢"
    },
    {
      "end": 8037.12,
      "start": 8036.58,
      "text": "對吧"
    },
    {
      "end": 8037.78,
      "start": 8037.12,
      "text": "王典林"
    },
    {
      "end": 8038.18,
      "start": 8037.78,
      "text": "徐明"
    },
    {
      "end": 8039.08,
      "start": 8038.18,
      "text": "許家印"
    },
    {
      "end": 8040.72,
      "start": 8039.08,
      "text": "孫紅斌"
    },
    {
      "end": 8041.16,
      "start": 8040.72,
      "text": "是吧"
    },
    {
      "end": 8042.6,
      "start": 8041.16,
      "text": "那個福利那個"
    },
    {
      "end": 8043.16,
      "start": 8042.6,
      "text": "哎"
    },
    {
      "end": 8043.8,
      "start": 8043.16,
      "text": "福利這個人"
    },
    {
      "end": 8044.46,
