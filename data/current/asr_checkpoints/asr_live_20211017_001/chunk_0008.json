{
  "chunk_audio_sha256": "767107c2ad713989b90424684986f66a85f5af676b8f61e78944505e82fe16b5",
  "chunk_index": 8,
  "completed_at": "2026-10-20T15:06:37Z",
  "language": "zh",
  "live_id": "LIVE_20211017_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 7200,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 7202.0,
      "start": 7200.0,
      "text": "堅定要跑出來的原因"
    },
    {
      "end": 7204.38,
      "start": 7202.38,
      "text": "那我請問體制內的兄弟姐妹們"
    },
    {
      "end": 7208.76,
      "start": 7205.16,
      "text": "你們覺得你願意擔當共產黨這100年的罪責嗎"
    },
    {
      "end": 7211.24,
      "start": 7209.88,
      "text": "你擔得起嗎"
    },
    {
      "end": 7216.12,
      "start": 7213.32,
      "text": "這是為什麼這個兄弟當初跟我聯絡說"
    },
    {
      "end": 7217.76,
      "start": 7216.42,
      "text": "我一直以為他來臥底的"
    },
    {
      "end": 7221.5,
      "start": 7217.76,
      "text": "他說七哥就憑你說99%共產黨都是好人"
    },
    {
      "end": 7222.76,
      "start": 7221.76,
      "text": "我跟定你了"
    },
    {
      "end": 7226.54,
      "start": 7224.16,
      "text": "我說那麼大的官你就憑這句話跟我"
    },
    {
      "end": 7227.62,
      "start": 7226.54,
      "text": "我說這不信當時"
    },
    {
      "end": 7230.12,
      "start": 7227.62,
      "text": "我把人當講幹玩吧"
    },
    {
      "end": 7232.1,
      "start": 7230.86,
      "text": "最後這真的是"
    },
    {
      "end": 7233.86,
      "start": 7232.1,
      "text": "最後成了咱們的戰友"
    },
    {
      "end": 7235.86,
      "start": 7233.86,
      "text": "說過很多料都來自於他"
    },
    {
      "end": 7237.74,
      "start": 7235.86,
      "text": "包括我們大笑跟他也是朋友"
    },
    {
      "end": 7238.74,
      "start": 7237.74,
      "text": "對他影響也很大"
    },
    {
      "end": 7241.12,
      "start": 7239.7,
      "text": "我們大笑跑日本去"
    },
    {
      "end": 7242.2,
      "start": 7241.12,
      "text": "他倆現在聚合了"
    },
    {
      "end": 7243.0,
      "start": 7242.2,
      "text": "是吧"
    },
    {
      "end": 7247.62,
      "start": 7244.24,
      "text": "那麼體制內的有任何腦子的人"
    },
    {
      "end": 7249.38,
      "start": 7247.62,
      "text": "你能活過36000天嗎"
    },
    {
      "end": 7251.14,
      "start": 7249.9,
      "text": "你能聽我直播的人"
    },
    {
      "end": 7252.5,
      "start": 7251.14,
      "text": "你的生命都過一半了"
    },
    {
      "end": 7254.5,
      "start": 7252.92,
      "text": "我們今天屏幕上的幾個人"
    },
    {
      "end": 7257.12,
      "start": 7254.5,
      "text": "沒有一個人超過15000天的生命了"
    },
    {
      "end": 7261.82,
      "start": 7257.62,
      "text": "那麼你們都超過36000天還能再活100年嗎"
    },
    {
      "end": 7266.26,
      "start": 7263.1,
      "text": "那你覺得你家不會被十三代牽連嗎"
    },
    {
      "end": 7269.4,
      "start": 7267.86,
      "text": "還不趕快行動"
    },
    {
      "end": 7273.36,
      "start": 7271.96,
      "text": "郭文貴不是多牛"
    },
    {
      "end": 7276.24,
      "start": 7273.36,
      "text": "但是郭文貴絕對是中國唯一一個出來"
    },
    {
      "end": 7278.64,
      "start": 7276.24,
      "text": "敢動手的人"
    },
    {
      "end": 7281.02,
      "start": 7278.64,
      "text": "我特別是說國內的企業家"
    },
    {
      "end": 7283.22,
      "start": 7281.02,
      "text": "你把錢給了共產黨"
    },
    {
      "end": 7286.02,
      "start": 7283.22,
      "text": "你覺得你家人就自由嗎"
    },
    {
      "end": 7288.22,
      "start": 7286.02,
      "text": "你回答我這個問題"
    },
    {
      "end": 7289.82,
      "start": 7288.22,
      "text": "我郭文貴今天直播"
    },
    {
      "end": 7291.38,
      "start": 7289.82,
      "text": "我希望這段你們能聽到"
    },
    {
      "end": 7294.82,
      "start": 7291.38,
      "text": "如果共產黨今天抓著你們這個"
    },
    {
      "end": 7296.68,
      "start": 7294.82,
      "text": "幾萬人的企業家"
    },
    {
      "end": 7297.82,
      "start": 7296.68,
      "text": "所有的家人"
    },
    {
      "end": 7299.6,
      "start": 7297.82,
      "text": "叫你到海外來拿錢"
    },
    {
      "end": 7302.22,
      "start": 7299.6,
      "text": "你真的你給了錢你就會自由嗎"
    },
    {
      "end": 7304.96,
      "start": 7302.22,
      "text": "像他說的讓你終生監禁不殺你嗎"
    },
    {
      "end": 7306.6,
      "start": 7305.96,
      "text": "記住我的話"
    },
    {
      "end": 7309.04,
      "start": 7306.6,
      "text": "做這個決定的人就是習近平"
    },
    {
      "end": 7311.16,
      "start": 7309.04,
      "text": "就是中南坑的所有人"
    },
    {
      "end": 7312.7,
      "start": 7311.16,
      "text": "他真心想這麼做"
    },
    {
      "end": 7314.24,
      "start": 7312.7,
      "text": "他也做不到"
    },
    {
      "end": 7319.32,
      "start": 7314.24,
      "text": "東地你知道"
    },
    {
      "end": 7321.08,
      "start": 7319.32,
      "text": "你相信習近平共產黨"
    },
    {
      "end": 7323.02,
      "start": 7321.08,
      "text": "還有未來的五年和十年嗎"
    },
    {
      "end": 7325.72,
      "start": 7323.02,
      "text": "你相信習能不被江南幹掉嗎"
    },
    {
      "end": 7328.46,
      "start": 7326.92,
      "text": "你相信不被幹掉以後"
    },
    {
      "end": 7329.66,
      "start": 7328.46,
      "text": "你還繼續回去嗎"
    },
    {
      "end": 7331.52,
      "start": 7329.66,
      "text": "你只有一條生路"
    },
    {
      "end": 7334.36,
      "start": 7331.52,
      "text": "一你自己先自由了"
    },
    {
      "end": 7335.62,
      "start": 7334.36,
      "text": "什麼錢才不要"
    },
    {
      "end": 7337.46,
      "start": 7335.62,
      "text": "你不要讓家人成為你的"
    },
    {
      "end": 7340.94,
      "start": 7337.46,
      "text": "成為家人的綁票的標的"
    },
    {
      "end": 7343.74,
      "start": 7340.94,
      "text": "他把你爹你媽頓了"
    },
    {
      "end": 7346.18,
      "start": 7343.74,
      "text": "你就說把拿碗湯給我喝了"
    },
    {
      "end": 7347.44,
      "start": 7346.18,
      "text": "你沒這個勇氣"
    },
    {
      "end": 7349.62,
      "start": 7347.44,
      "text": "你就把家人全害了"
    },
    {
      "end": 7351.02,
      "start": 7349.62,
      "text": "你只有這個勇氣"
    },
    {
      "end": 7352.48,
      "start": 7351.02,
      "text": "他真的被殺了"
    },
    {
      "end": 7354.92,
      "start": 7352.48,
      "text": "你活著是對家人最好的愛"
    },
    {
      "end": 7357.56,
      "start": 7356.16,
      "text": "他就是被殺了"
    },
    {
      "end": 7359.32,
      "start": 7357.56,
      "text": "你就要一半高興"
    },
    {
      "end": 7360.82,
      "start": 7359.32,
      "text": "一半悲傷的來面對"
    },
    {
      "end": 7362.26,
      "start": 7360.82,
      "text": "為什麼"
    },
    {
      "end": 7364.06,
      "start": 7362.26,
      "text": "你們家總比全滅了"
    },
    {
      "end": 7366.2,
      "start": 7364.06,
      "text": "在那個地獄門口等到死"
    },
    {
      "end": 7367.4,
      "start": 7366.2,
      "text": "好得多得多"
    },
    {
      "end": 7370.86,
      "start": 7369.26,
      "text": "你能出來就出來"
    },
    {
      "end": 7372.5,
      "start": 7370.86,
      "text": "你不要叫自私"
    },
    {
      "end": 7374.06,
      "start": 7372.5,
      "text": "很多人說"
    },
    {
      "end": 7375.0,
      "start": 7374.06,
      "text": "中級委員哥們說"
    },
    {
      "end": 7375.94,
      "start": 7375.0,
      "text": "他說這幫傻叉"
    },
    {
      "end": 7377.6,
      "start": 7375.94,
      "text": "都說我孝敬啊"
    },
    {
      "end": 7378.8,
      "start": 7377.6,
      "text": "我對家人好"
    },
    {
      "end": 7380.48,
      "start": 7378.8,
      "text": "這是最愚蠢的孝敬"
    },
    {
      "end": 7381.68,
      "start": 7380.48,
      "text": "這叫懦弱"
    },
    {
      "end": 7385.32,
      "start": 7383.48,
      "text": "這就像頭兩天"
    },
    {
      "end": 7388.12,
      "start": 7385.32,
      "text": "包括剛才給打電話的老領導"
    },
    {
      "end": 7389.02,
      "start": 7388.12,
      "text": "我說你打幾針啊"
    },
    {
      "end": 7390.16,
      "start": 7389.02,
      "text": "我打了三針"
    },
    {
      "end": 7391.88,
      "start": 7390.16,
      "text": "我說希望你早點死啊"
    },
    {
      "end": 7393.42,
      "start": 7391.88,
      "text": "我是這話很不吉利"
    },
    {
      "end": 7394.46,
      "start": 7393.42,
      "text": "但真希望你早點死"
    },
    {
      "end": 7396.4,
      "start": 7395.76,
      "text": "打三針"
    },
    {
      "end": 7397.32,
      "start": 7396.4,
      "text": "我說你是為了什麼"
    },
    {
      "end": 7398.5,
      "start": 7397.32,
      "text": "他說我真的是怕死"
    },
    {
      "end": 7399.76,
      "start": 7398.5,
      "text": "起個啥都不是"
    },
    {
      "end": 7400.72,
      "start": 7399.76,
      "text": "我現在後悔了"
    },
    {
      "end": 7401.7,
      "start": 7400.72,
      "text": "就是怕死"
    },
    {
      "end": 7405.3,
      "start": 7403.16,
      "text": "所以說怕死"
    },
    {
      "end": 7406.56,
      "start": 7405.3,
      "text": "懦弱打三針"
    },
    {
      "end": 7408.34,
      "start": 7406.56,
      "text": "那你危險你自己承擔"
    },
    {
      "end": 7409.5,
      "start": 7408.34,
      "text": "那麼今天"
    },
    {
      "end": 7410.84,
      "start": 7409.5,
      "text": "所有的所謂的"
    },
    {
      "end": 7412.14,
      "start": 7410.84,
      "text": "以愛家人"
    },
    {
      "end": 7413.38,
      "start": 7412.14,
      "text": "孝敬老人"
    },
    {
      "end": 7414.6,
      "start": 7413.38,
      "text": "愛家人"
    },
    {
      "end": 7415.84,
      "start": 7414.6,
      "text": "負責任"
    },
    {
      "end": 7417.64,
      "start": 7416.58,
      "text": "為藉口的"
    },
    {
      "end": 7418.58,
      "start": 7417.64,
      "text": "反抗共產黨"
    },
    {
      "end": 7419.94,
      "start": 7418.58,
      "text": "你都是騙你自己"
    },
    {
      "end": 7421.42,
      "start": 7419.94,
      "text": "因為你懦弱"
    },
    {
      "end": 7425.96,
      "start": 7421.42,
      "text": "不要再騙自己了"
    },
    {
      "end": 7431.4,
      "start": 7425.96,
      "text": "我再告訴國外的國內的所有正在往會會錢的"
    },
    {
      "end": 7432.56,
      "start": 7431.4,
      "text": "我知道誰"
    },
    {
      "end": 7433.7,
      "start": 7432.56,
      "text": "誰在德國"
    },
    {
      "end": 7435.2,
      "start": 7433.7,
      "text": "誰在意大利"
    },
    {
      "end": 7436.16,
      "start": 7435.2,
      "text": "誰在英國"
    },
    {
      "end": 7437.66,
      "start": 7436.16,
      "text": "我知道誰在日本"
    },
    {
      "end": 7438.4,
      "start": 7437.66,
      "text": "在新加坡"
    },
    {
      "end": 7441.04,
      "start": 7438.4,
      "text": "有時間我再給你們講"
    },
    {
      "end": 7442.08,
      "start": 7441.04,
      "text": "我哪天記住啊"
    },
    {
      "end": 7443.48,
      "start": 7442.08,
      "text": "你們幾個一定要記住"
    },
    {
      "end": 7444.04,
      "start": 7443.48,
      "text": "非非啊"
    },
    {
      "end": 7445.14,
      "start": 7444.04,
      "text": "你要主持這事"
    },
    {
      "end": 7446.68,
      "start": 7445.14,
      "text": "再過兩個月"
    },
    {
      "end": 7448.08,
      "start": 7446.68,
      "text": "我們同樣的人"
    },
    {
      "end": 7448.92,
      "start": 7448.08,
      "text": "我再告訴你"
    },
    {
      "end": 7452.76,
      "start": 7448.92,
      "text": "今天我剛才說過的話的很多重點沒說出來的"
    },
    {
      "end": 7453.96,
      "start": 7452.76,
      "text": "你一定要問我啊"
    },
    {
      "end": 7455.52,
      "start": 7453.96,
      "text": "記住每分美元"
    },
    {
      "end": 7456.4,
      "start": 7455.52,
      "text": "我會告訴你"
    },
    {
      "end": 7458.3,
      "start": 7456.4,
      "text": "什麼人在哪國在幹什麼"
    },
    {
      "end": 7460.2,
      "start": 7458.3,
      "text": "就在此時此刻"
    },
    {
      "end": 7462.96,
      "start": 7460.2,
      "text": "一百多億美元的資產"
    },
    {
      "end": 7464.74,
      "start": 7462.96,
      "text": "正在處理中"
    },
    {
      "end": 7467.68,
      "start": 7464.74,
      "text": "這個處理的資產的人還耍鬼計"
    },
    {
      "end": 7469.74,
      "start": 7467.68,
      "text": "在專案主的監督下"
    },
    {
      "end": 7470.84,
      "start": 7469.74,
      "text": "還藏一些東西"
    },
    {
      "end": 7472.48,
      "start": 7470.84,
      "text": "專案主這麼小的也聰明"
    },
    {
      "end": 7473.94,
      "start": 7472.48,
      "text": "你先把這大頭拿回去"
    },
    {
      "end": 7475.18,
      "start": 7473.94,
      "text": "回頭我再收拾你"
    },
    {
      "end": 7478.18,
      "start": 7475.18,
      "text": "因為你是已經是鍋裡邊的魚了"
    },
    {
      "end": 7479.98,
      "start": 7478.18,
      "text": "他只是多點幾下勺而已"
    },
    {
      "end": 7484.48,
      "start": 7482.56,
      "text": "你只有一個不妥協"
    },
    {
      "end": 7485.96,
      "start": 7484.48,
      "text": "只有反抗你才有機會"
    },
    {
      "end": 7487.26,
      "start": 7485.96,
      "text": "我跟你們這些企業家"
    },
    {
      "end": 7488.26,
      "start": 7487.26,
      "text": "非親非故"
    },
    {
      "end": 7490.26,
      "start": 7488.26,
      "text": "你生你死跟我蛋的關係"
    },
    {
      "end": 7492.1,
      "start": 7490.26,
      "text": "你生你死"
    },
    {
      "end": 7493.52,
      "start": 7492.1,
      "text": "我新中華聯邦都在這"
    },
    {
      "end": 7495.6,
      "start": 7493.52,
      "text": "我們的宣言人還在這呢"
    },
    {
      "end": 7497.1,
      "start": 7495.6,
      "text": "哪個人都比你們過得好"
    },
    {
      "end": 7500.16,
      "start": 7498.36,
      "text": "我們支持同胞"
    },
    {
      "end": 7501.14,
      "start": 7500.16,
      "text": "我想告訴大家"
    },
    {
      "end": 7503.5,
      "start": 7501.14,
      "text": "我不認為任何人江志誠"
    },
    {
      "end": 7504.4,
      "start": 7503.5,
      "text": "包括孫立軍"
    },
    {
      "end": 7505.14,
      "start": 7504.4,
      "text": "包括孟建柱"
    },
    {
      "end": 7506.04,
      "start": 7505.14,
      "text": "包括王岐山"
    },
    {
      "end": 7506.98,
      "start": 7506.04,
      "text": "包括陳峰"
    },
    {
      "end": 7508.78,
      "start": 7506.98,
      "text": "包括吳征"
    },
    {
      "end": 7510.78,
      "start": 7508.78,
      "text": "他們應該有這樣的待遇"
    },
    {
      "end": 7511.36,
      "start": 7510.78,
      "text": "包括馬雲"
    },
    {
      "end": 7512.68,
      "start": 7511.36,
      "text": "他有錯"
    },
    {
