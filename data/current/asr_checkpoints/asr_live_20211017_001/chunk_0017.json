    },
    {
      "end": 15319.24,
      "start": 15318.06,
      "text": "他们整个"
    },
    {
      "end": 15321.36,
      "start": 15319.24,
      "text": "我曾经都有过"
    },
    {
      "end": 15322.96,
      "start": 15321.36,
      "text": "而且没有一点"
    },
    {
      "end": 15324.0,
      "start": 15322.96,
      "text": "在这说"
    },
    {
      "end": 15325.08,
      "start": 15324.0,
      "text": "还记"
    },
    {
      "end": 15326.92,
      "start": 15325.08,
      "text": "还知道有规律"
    },
    {
      "end": 15328.56,
      "start": 15326.92,
      "text": "有得扯淡"
    },
    {
      "end": 15329.08,
      "start": 15328.56,
      "text": "对吧"
    },
    {
      "end": 15330.08,
      "start": 15329.08,
      "text": "赌场人都"
    },
    {
      "end": 15331.02,
      "start": 15330.08,
      "text": "就是一定说"
    },
    {
      "end": 15332.48,
      "start": 15331.02,
      "text": "你来不怕你赢"
    },
    {
      "end": 15333.18,
      "start": 15332.48,
