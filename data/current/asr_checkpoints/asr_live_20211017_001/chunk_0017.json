    },
    {
      "end": 15338.02,
      "start": 15336.76,
      "text": "就是长时间的赌"
    },
    {
      "end": 15338.64,
      "start": 15338.02,
      "text": "你一定输"
    },
    {
      "end": 15340.26,
      "start": 15338.64,
      "text": "你除非去就赌一回"
    },
    {
      "end": 15341.04,
      "start": 15340.26,
      "text": "不管输了赢了"
    },
    {
      "end": 15341.4,
      "start": 15341.04,
      "text": "你走了"
    },
    {
      "end": 15342.62,
      "start": 15341.4,
      "text": "不赌就是赢"
    },
    {
      "end": 15344.4,
      "start": 15342.62,
      "text": "一个毒品"
    },
    {
      "end": 15345.36,
      "start": 15344.4,
      "text": "一个赌博"
    },
    {
      "end": 15347.02,
      "start": 15345.36,
      "text": "让你家破人亡"
    },
    {
      "end": 15348.14,
      "start": 15347.02,
      "text": "人性敏秘"
    },
    {
      "end": 15348.82,
      "start": 15348.14,
      "text": "在这里面"
    },
    {
      "end": 15350.0,
      "start": 15348.82,
      "text": "千万大家不要沾"
    },
    {
      "end": 15351.54,
      "start": 15350.0,
      "text": "所有这一切"
    },
    {
      "end": 15352.5,
      "start": 15351.54,
      "text": "就是我"
    },
    {
      "end": 15354.58,
      "start": 15352.5,
      "text": "很坦诚不公的"
    },
    {
      "end": 15355.3,
      "start": 15354.58,
      "text": "很大家的"
    },
    {
      "end": 15357.34,
      "start": 15355.3,
      "text": "跟体制内的这些人"
    },
    {
      "end": 15358.42,
      "start": 15357.34,
      "text": "在说这些"
    },
    {
      "end": 15359.46,
      "start": 15358.42,
      "text": "行行吧"
    },
    {
      "end": 15360.32,
      "start": 15359.46,
      "text": "你们行行吧"
    },
    {
      "end": 15361.82,
      "start": 15360.32,
      "text": "好的主持人"
    },
    {
      "end": 15364.08,
      "start": 15361.82,
      "text": "好"
    },
    {
      "end": 15364.7,
      "start": 15364.08,
      "text": "谢谢"
    },
    {
      "end": 15366.88,
      "start": 15364.7,
      "text": "太生猛了"
    },
    {
      "end": 15368.12,
      "start": 15366.88,
      "text": "我就看到"
    },
    {
      "end": 15368.8,
      "start": 15368.12,
      "text": "上面评论"
    },
    {
      "end": 15370.42,
      "start": 15368.8,
      "text": "太生猛了"
    },
    {
      "end": 15373.3,
      "start": 15370.42,
      "text": "然后这个"
    },
    {
      "end": 15374.2,
      "start": 15373.3,
      "text": "张力女士"
    },
    {
      "end": 15374.74,
      "start": 15374.2,
      "text": "有没有什么"
    },
    {
      "end": 15375.42,
      "start": 15374.74,
      "text": "要分享的"
    },
    {
      "end": 15380.64,
      "start": 15375.42,
      "text": "我就是说"
    },
    {
      "end": 15383.1,
      "start": 15380.64,
      "text": "前几天在群里也发过"
    },
    {
      "end": 15386.34,
      "start": 15383.1,
      "text": "我说七哥是我们人类的灯塔"
    },
    {
      "end": 15387.26,
      "start": 15386.34,
      "text": "不光是我们"
    },
    {
      "end": 15391.72,
      "start": 15387.26,
      "text": "这个新中国爆料革命的灯塔"
    },
    {
      "end": 15392.42,
      "start": 15391.72,
      "text": "它是我们"
    },
    {
      "end": 15394.06,
      "start": 15392.42,
      "text": "全人类的灯塔"
    },
    {
      "end": 15395.58,
      "start": 15394.06,
      "text": "有七哥在哪里"
    },
    {
      "end": 15400.42,
      "start": 15395.58,
      "text": "我们人类的地方才有亮光"
    },
    {
      "end": 15402.74,
      "start": 15400.42,
      "text": "我们的所有的这些"
    },
    {
      "end": 15407.38,
      "start": 15402.74,
      "text": "萤火虫才能在黑暗里发出亮光"
    },
    {
      "end": 15408.94,
      "start": 15407.38,
      "text": "照亮这个世界"
    },
    {
      "end": 15410.84,
      "start": 15408.94,
      "text": "我觉得我们"
    },
    {
      "end": 15411.4,
      "start": 15410.84,
      "text": "就是说"
    },
    {
      "end": 15413.78,
      "start": 15411.4,
      "text": "我们之前是为了什么呢"
    },
    {
      "end": 15416.1,
      "start": 15413.78,
      "text": "就是更好的生活"
    },
    {
      "end": 15419.98,
      "start": 15416.1,
      "text": "能够想要你能够自由的发生"
    },
    {
      "end": 15422.58,
      "start": 15419.98,
      "text": "能够做你真正的自我"
    },
    {
      "end": 15424.12,
      "start": 15422.58,
      "text": "而不是在墙内的"
    },
    {
      "end": 15425.04,
      "start": 15424.12,
      "text": "你这么前"
    },
    {
      "end": 15426.28,
      "start": 15425.04,
      "text": "你只是一个"
    },
    {
      "end": 15428.62,
      "start": 15426.28,
      "text": "这个行尸走肉"
    },
    {
      "end": 15430.52,
      "start": 15428.62,
      "text": "只是被别人愚弄"
    },
    {
      "end": 15432.7,
      "start": 15430.52,
      "text": "你只是喝酒吃饭"
    },
    {
      "end": 15434.66,
      "start": 15432.7,
      "text": "你还有任何什么"
    },
    {
      "end": 15436.08,
      "start": 15434.66,
      "text": "精神上的这种"
    },
    {
      "end": 15438.56,
      "start": 15436.08,
      "text": "信仰这种高度"
    },
    {
      "end": 15440.08,
      "start": 15438.56,
      "text": "所有的这一切"
    },
    {
      "end": 15441.22,
      "start": 15440.08,
      "text": "你什么都没有"
    },
    {
      "end": 15443.34,
      "start": 15441.22,
      "text": "所以也很高兴"
    },
    {
      "end": 15445.12,
      "start": 15443.34,
      "text": "我们在这儿"
    },
    {
      "end": 15446.28,
      "start": 15445.12,
      "text": "就跟着七哥"
    },
    {
      "end": 15448.82,
      "start": 15446.28,
      "text": "我们跟着这个新中国联邦"
    },
    {
      "end": 15450.5,
      "start": 15448.82,
      "text": "我们有这样的平台"
    },
    {
      "end": 15452.62,
      "start": 15450.5,
      "text": "就是能够做我们自己"
    },
    {
      "end": 15454.56,
      "start": 15452.62,
      "text": "想要的生活"
    },
    {
      "end": 15455.52,
      "start": 15454.56,
      "text": "做我们自己"
    },
    {
      "end": 15457.6,
      "start": 15455.52,
      "text": "喜欢的这个"
    },
    {
      "end": 15459.3,
      "start": 15457.6,
      "text": "和家人"
    },
    {
      "end": 15461.78,
      "start": 15459.3,
      "text": "和所有的喜欢的人在一起"
    },
    {
      "end": 15462.94,
      "start": 15461.78,
      "text": "我们不用去勾兑"
    },
    {
      "end": 15463.84,
      "start": 15462.94,
      "text": "不用去喝酒"
    },
    {
      "end": 15465.58,
      "start": 15463.84,
      "text": "我们有很安全"
    },
    {
      "end": 15467.46,
      "start": 15465.58,
      "text": "很幸福的这样的"
    },
    {
      "end": 15468.64,
      "start": 15467.46,
      "text": "一个生活状态"
    },
    {
      "end": 15469.44,
      "start": 15468.64,
      "text": "你人"
    },
    {
      "end": 15470.7,
      "start": 15469.44,
      "text": "这个钱为什么"
    },
    {
      "end": 15472.14,
      "start": 15470.7,
      "text": "不就是为了"
    },
    {
      "end": 15473.84,
      "start": 15472.14,
      "text": "为了这一辈子"
    },
    {
      "end": 15474.6,
      "start": 15473.84,
      "text": "就这样子"
    },
    {
      "end": 15476.42,
      "start": 15474.6,
      "text": "和你爱的人在一起吗"
    },
    {
      "end": 15478.24,
      "start": 15476.42,
      "text": "所以我认为"
    },
    {
      "end": 15480.48,
      "start": 15478.24,
      "text": "就算我们在国内"
    },
    {
      "end": 15482.28,
      "start": 15480.48,
      "text": "放弃了很多的这些资产"
    },
    {
      "end": 15482.92,
      "start": 15482.28,
      "text": "就是说"
    },
    {
      "end": 15484.42,
      "start": 15482.92,
      "text": "钱是很重要"
    },
    {
      "end": 15487.38,
      "start": 15484.42,
      "text": "但是它不是唯一的"
    },
    {
      "end": 15490.52,
      "start": 15487.38,
      "text": "它钱是你人的努力"
    },
    {
      "end": 15493.26,
      "start": 15490.52,
      "text": "不是你被这个钱和绑架"
    },
    {
      "end": 15494.72,
      "start": 15493.26,
      "text": "你变成它的努力"
    },
    {
      "end": 15497.06,
      "start": 15494.72,
      "text": "所以其实放下这一切"
    },
    {
      "end": 15498.0,
      "start": 15497.06,
      "text": "所有的东西"
    },
    {
      "end": 15499.8,
      "start": 15498.0,
      "text": "你舍得了"
    },
    {
      "end": 15500.46,
      "start": 15499.8,
      "text": "你舍了"
    },
    {
      "end": 15502.38,
      "start": 15500.46,
      "text": "你才会有新的生命"
    },
    {
      "end": 15504.68,
      "start": 15502.38,
      "text": "你才会有得到更多的东西"
    },
    {
      "end": 15505.38,
      "start": 15504.68,
      "text": "好"
    },
    {
      "end": 15505.8,
      "start": 15505.38,
      "text": "谢谢"
    },
    {
      "end": 15506.9,
      "start": 15505.8,
      "text": "谢谢主持人"
    },
    {
      "end": 15510.48,
      "start": 15506.9,
      "text": "谢谢"
    },
    {
      "end": 15510.66,
      "start": 15510.48,
      "text": "谢谢"
    },
    {
      "end": 15516.22,
      "start": 15510.66,
      "text": "太好了"
    },
    {
      "end": 15517.34,
      "start": 15516.22,
      "text": "激动"
    },
    {
      "end": 15519.3,
      "start": 15517.34,
      "text": "讲的舌头都干了现在"
    },
    {
      "end": 15525.6,
      "start": 15519.3,
      "text": "那我们青天来修一下吧"
    },
    {
      "end": 15526.74,
      "start": 15525.6,
      "text": "衣服脱了"
    },
    {
      "end": 15528.44,
      "start": 15526.74,
      "text": "再要脱一件吧"
    },
    {
      "end": 15529.6,
      "start": 15528.44,
      "text": "衣服脱了"
    },
    {
      "end": 15531.32,
      "start": 15529.6,
      "text": "没有脱就没了"
    },
    {
      "end": 15536.74,
      "start": 15531.32,
      "text": "我就想说刚才文贵先生说这个"
    },
    {
      "end": 15539.76,
      "start": 15536.74,
      "text": "就是它是怎么练成的"
    },
    {
      "end": 15544.4,
      "start": 15539.76,
      "text": "我就突然想起来小时候学的那本叫做钢铁是怎样练成的"
    },
    {
      "end": 15548.06,
      "start": 15544.4,
      "text": "我觉得无论是文贵先生包括海东包括招英女士"
    },
    {
      "end": 15551.0,
      "start": 15548.06,
      "text": "就是说钢铁是千锤百练一点一点练出来的"
    },
    {
      "end": 15554.3,
      "start": 15551.0,
      "text": "就是因为七哥有这样的人生经历有这样的一个历练"
    },
    {
      "end": 15558.72,
      "start": 15554.3,
      "text": "那么东哥和招英杰有一天一天这样的磨练"
    },
    {
      "end": 15559.92,
      "start": 15558.72,
      "text": "但是他还有的天分"
    },
    {
      "end": 15561.92,
      "start": 15559.92,
      "text": "所以才会成为世界冠军"
    },
    {
      "end": 15564.94,
      "start": 15561.92,
      "text": "成为人类上的那个佼佼者"
    },
    {
      "end": 15567.38,
      "start": 15564.94,
      "text": "那我想我没有这样的人生经历"
    },
    {
      "end": 15568.28,
      "start": 15567.38,
      "text": "但是呢"
    },
    {
      "end": 15570.4,
      "start": 15568.28,
      "text": "我觉得我们也在一点一点的去历练"
    },
    {
      "end": 15572.24,
      "start": 15570.4,
      "text": "我觉得每一个人都是这样"
    },
    {
      "end": 15574.8,
      "start": 15572.24,
      "text": "从这个历练中我们会不断的成长"
    },
    {
      "end": 15576.32,
      "start": 15574.8,
      "text": "会不断的提高自己"
    },
    {
      "end": 15578.66,
      "start": 15576.32,
      "text": "会去除自己的那些不好的地方"
    },
    {
      "end": 15579.88,
      "start": 15578.66,
      "text": "去除自己的恐惧感"
    },
    {
      "end": 15581.4,
      "start": 15579.88,
      "text": "那还有一点我就觉得"
    },
    {
      "end": 15583.06,
      "start": 15581.4,
      "text": "你通过所有的这些历练"
    },
    {
      "end": 15585.24,
      "start": 15583.06,
      "text": "所有的这些锤链"
    },
    {
      "end": 15587.44,
      "start": 15585.24,
      "text": "你看到的是一种实力"
    },
    {
      "end": 15589.52,
      "start": 15587.44,
      "text": "那无论是我们的新中国联邦"
    },
    {
      "end": 15592.72,
      "start": 15589.52,
      "text": "还是所有的我们的G系列"
    },
    {
      "end": 15594.42,
      "start": 15592.72,
      "text": "它都是一个实力的体现"
    },
    {
      "end": 15596.58,
      "start": 15594.42,
      "text": "那新中国联邦所做的现在所有的事情"
    },
    {
      "end": 15598.88,
      "start": 15596.58,
      "text": "无论是从疫苗接受疫苗的真相"
    },
    {
      "end": 15599.64,
      "start": 15598.88,
      "text": "病毒真相"
    },
    {
      "end": 15601.06,
      "start": 15599.64,
      "text": "我们传递给世界的"
    },
    {
      "end": 15602.54,
      "start": 15601.06,
      "text": "如果按我话来说的话"
    },
    {
      "end": 15607.08,
      "start": 15602.54,
      "text": "就是我们在帮助人类战胜第三次世界大战"
    },
    {
      "end": 15610.26,
      "start": 15607.08,
      "text": "我觉得这就是可能我们做出的很大的一个贡献"
    },
    {
      "end": 15612.74,
      "start": 15610.26,
      "text": "因为我们真的现在就在一个战争之中"
