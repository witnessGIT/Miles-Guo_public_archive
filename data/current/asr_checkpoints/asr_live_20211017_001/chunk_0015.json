    {
      "end": 14186.5,
      "start": 14185.7,
      "text": "CTO"
    },
    {
      "end": 14191.0,
      "start": 14186.5,
      "text": "咱們工程的戰友們有得到20萬幣的還不高興"
    },
    {
      "end": 14192.3,
      "start": 14191.0,
