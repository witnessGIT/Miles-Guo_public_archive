    {
      "end": 14162.5,
      "start": 14160.9,
      "text": "因為我知道他們有多恨我"
    },
    {
      "end": 14165.8,
      "start": 14163.3,
      "text": "因為所有的我是跟機構說好的"
    },
    {
      "end": 14168.0,
      "start": 14165.8,
      "text": "包括從咱工程師裡拿下了1000多萬"
