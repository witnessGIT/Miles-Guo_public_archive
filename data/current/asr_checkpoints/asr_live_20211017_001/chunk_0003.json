      "end": 2848.0,
      "start": 2847.0,
      "text": "要不要做放化療"
    },
    {
      "end": 2850.0,
      "start": 2848.0,
      "text": "為什麼他把責任推成這樣"
    },
    {
      "end": 2855.0,
      "start": 2850.0,
      "text": "包括後來我又去諮詢了就是一些朋友啊"
