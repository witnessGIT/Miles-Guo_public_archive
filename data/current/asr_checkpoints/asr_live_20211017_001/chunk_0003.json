    },
    {
      "end": 3034.0,
      "start": 3033.0,
      "text": "你主了道啊"
    },
    {
      "end": 3035.0,
      "start": 3034.0,
      "text": "這個孫子你想想"
    },
    {
      "end": 3036.0,
      "start": 3035.0,
      "text": "最後真的沒過幾年"
    },
    {
      "end": 3038.0,
      "start": 3036.0,
      "text": "他癌症死了"
    },
    {
      "end": 3040.0,
      "start": 3038.0,
      "text": "這就是所謂的報應啊"
    },
    {
      "end": 3041.0,
      "start": 3040.0,
      "text": "當然我不相信"
    },
    {
      "end": 3042.0,
      "start": 3041.0,
      "text": "但是我就告訴你"
    },
    {
      "end": 3043.0,
      "start": 3042.0,
      "text": "人作惡"
    },
    {
      "end": 3045.0,
      "start": 3043.0,
      "text": "他從內心來講"
    },
    {
      "end": 3047.0,
      "start": 3045.0,
      "text": "他所有的出發點都是壞的"
