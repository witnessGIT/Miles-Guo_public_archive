    },
    {
      "end": 3071.0,
      "start": 3069.0,
      "text": "這個紫衫啊什麼的"
    },
    {
      "end": 3073.0,
      "start": 3071.0,
      "text": "有個木頭體裂"
    },
    {
      "end": 3074.0,
      "start": 3073.0,
