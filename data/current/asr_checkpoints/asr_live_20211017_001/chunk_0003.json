    },
    {
      "end": 2975.0,
      "start": 2973.0,
      "text": "我都說中共不得好死"
    },
    {
      "end": 2976.0,
      "start": 2975.0,
      "text": "你們真的"
    },
    {
      "end": 2978.0,
      "start": 2976.0,
      "text": "中共這些狼八蛋老雜毛們"
    },
    {
      "end": 2980.0,
      "start": 2978.0,
      "text": "這些所有的你們從惡的"
    },
    {
      "end": 2982.0,
      "start": 2980.0,
      "text": "被助紂為虐的你們這些"
    },
    {
      "end": 2984.0,
      "start": 2982.0,
      "text": "所有的人都聽著"
