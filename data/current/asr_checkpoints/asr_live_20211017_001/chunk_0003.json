      "start": 3027.0,
      "text": "什麼雞蛋啊"
    },
    {
      "end": 3029.0,
      "start": 3028.0,
      "text": "什麼這個那個"
    },
    {
      "end": 3031.0,
      "start": 3029.0,
      "text": "反正不光他的主任"
    },
    {
