      "start": 2773.0,
      "text": "快動你看看"
    },
    {
      "end": 2776.0,
      "start": 2774.0,
      "text": "要不要做放化療"
    },
    {
      "end": 2777.0,
      "start": 2776.0,
      "text": "我說什麼意思"
    },
    {
      "end": 2779.0,
      "start": 2777.0,
      "text": "他說你這個癌症指標"
    },
    {
      "end": 2780.0,
      "start": 2779.0,
      "text": "五十五十"
    },
    {
      "end": 2782.0,
      "start": 2780.0,
      "text": "兩個有點超標"
    },
    {
      "end": 2783.0,
