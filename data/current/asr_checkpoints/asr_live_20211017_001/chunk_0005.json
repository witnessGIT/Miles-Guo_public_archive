    {
      "end": 4753.3,
      "start": 4752.9,
      "text": "去"
    },
    {
      "end": 4754.0,
      "start": 4753.4,
      "text": "到香港"
    },
    {
      "end": 4755.4,
      "start": 4754.2,
      "text": "海外把你錢拿回來去"
    },
    {
      "end": 4758.6,
      "start": 4755.4,
      "text": "你看到這"
    },
    {
      "end": 4761.6,
      "start": 4758.8,
      "text": "從去年10月到今天誰出過境"
    },
    {
      "end": 4762.6,
      "start": 4761.6,
      "text": "你告訴我中國的老闆"
    },
    {
      "end": 4764.7,
      "start": 4763.1,
      "text": "你見過誰出過境"
    },
    {
      "end": 4765.4,
      "start": 4764.8,
      "text": "出過"
    },
    {
      "end": 4765.5,
      "start": 4765.5,
      "text": "出過"
    },
    {
      "end": 4766.4,
      "start": 4765.5,
      "text": "出過"
    },
    {
      "end": 4769.9,
      "start": 4766.6,
      "text": "他身邊最起碼40到50個人跟著他"
    },
    {
      "end": 4772.4,
      "start": 4771.2,
      "text": "出去拿錢去"
    },
    {
      "end": 4774.2,
      "start": 4772.4,
      "text": "我今天不點他們名字"
    },
    {
      "end": 4776.1,
      "start": 4774.2,
      "text": "我未來會一個一個告訴你"
    },
    {
      "end": 4776.9,
      "start": 4776.1,
      "text": "這個戰友說我"
    },
    {
      "end": 4778.1,
      "start": 4777.1,
      "text": "因為他說我"
    },
    {
      "end": 4779.6,
      "start": 4778.1,
      "text": "我就像印的我腦子一樣"
    },
    {
      "end": 4781.3,
      "start": 4779.7,
      "text": "因為這些人我太熟了"
    },
    {
      "end": 4785.5,
