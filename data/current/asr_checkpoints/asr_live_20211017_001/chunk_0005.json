    {
      "end": 4741.0,
      "start": 4739.4,
      "text": "全部按此處理模式"
    },
    {
      "end": 4741.9,
      "start": 4741.2,
      "text": "很簡單"
    },
    {
      "end": 4743.5,
      "start": 4742.8,
      "text": "你可以走"
    },
    {
      "end": 4744.8,
      "start": 4743.8,
      "text": "全家都是抓"
