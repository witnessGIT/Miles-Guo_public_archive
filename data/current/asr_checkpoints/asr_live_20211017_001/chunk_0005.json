    },
    {
      "end": 4680.4,
      "start": 4679.5,
      "text": "陳真馬上就回啊"
    },
    {
      "end": 4681.1,
      "start": 4680.4,
      "text": "在上海呢"
    },
    {
      "end": 4682.0,
      "start": 4681.5,
      "text": "馬上就回"
    },
    {
      "end": 4683.7,
      "start": 4682.3,
      "text": "要孟建柱要幹掉他"
    },
    {
      "end": 4684.9,
