    {
      "end": 4502.24,
      "start": 4500.0,
      "text": "加強金管全部刪除"
    },
    {
      "end": 4504.44,
      "start": 4503.14,
      "text": "而馬雲的全在那兒"
    },
    {
      "end": 4505.94,
      "start": 4504.44,
      "text": "你說馬雲興奮了"
    },
    {
      "end": 4509.7,
