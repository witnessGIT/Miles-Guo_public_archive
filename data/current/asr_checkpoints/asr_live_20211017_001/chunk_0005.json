    {
      "end": 4688.9,
      "start": 4687.6,
      "text": "十幾波人"
    },
    {
      "end": 4690.7,
      "start": 4690.1,
      "text": "部隊"
    },
    {
      "end": 4692.0,
      "start": 4691.1,
      "text": "潛水艇部隊"
    },
    {
      "end": 4694.8,
      "start": 4693.0,
      "text": "東北軍區都有人參與"
    },
    {
      "end": 4697.8,
      "start": 4696.6,
      "text": "更誇張的事情"
    },
    {
      "end": 4699.2,
      "start": 4698.1,
      "text": "他也沒有想到"
    },
    {
      "end": 4701.5,
      "start": 4699.5,
