      "start": 4789.6,
      "text": "死在監獄裡"
    },
    {
      "end": 4794.0,
      "start": 4792.5,
      "text": "如果你要不聽話"
    },
    {
      "end": 4795.9,
      "start": 4794.2,
      "text": "一定把你全家全弄死"
    },
    {
      "end": 4797.9,
      "start": 4796.8,
      "text": "在你死之前"
    },
    {
      "end": 4798.7,
      "start": 4798.0,
      "text": "你到海外去"
    },
    {
      "end": 4800.5,
      "start": 4798.8,
      "text": "注重把財產拿回來"
    },
    {
      "end": 4801.4,
      "start": 4801.0,
      "text": "交給我"
    },
    {
      "end": 4802.1,
      "start": 4801.5,
      "text": "然後抓捕你"
    },
    {
      "end": 4802.6,
      "start": 4802.2,
      "text": "跟海"
    },
    {
      "end": 4803.7,
      "start": 4802.6,
      "text": "就是陳峰一樣"
    },
    {
      "end": 4806.2,
      "start": 4805.0,
      "text": "你還別耍花招"
    },
    {
      "end": 4807.7,
      "start": 4806.2,
      "text": "你耍花招就弄死你"
    },
    {
      "end": 4809.9,
      "start": 4808.8,
      "text": "所以說兄弟姐妹們"
    },
    {
      "end": 4812.2,
      "start": 4809.9,
      "text": "我們從去年的10月到今天"
    },
    {
      "end": 4815.5,
      "start": 4813.2,
      "text": "你看這個人類上發生最大的事情"
    },
    {
      "end": 4817.0,
      "start": 4815.6,
      "text": "我今天說完這時間點"
    },
