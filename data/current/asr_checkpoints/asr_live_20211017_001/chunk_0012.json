  "segments": [
    {
      "end": 10805.0,
      "start": 10800.0,
      "text": "在去年的六四之前"
    },
    {
      "end": 10808.0,
      "start": 10805.0,
      "text": "他那天坐在沙發上的時候"
    },
    {
      "end": 10811.0,
      "start": 10808.0,
      "text": "那幾天晚上我沒睡覺以外"
    },
    {
      "end": 10815.0,
      "start": 10811.0,
      "text": "其他的時候我從來都是睡覺很好的"
    },
    {
      "end": 10817.0,
      "start": 10815.0,
      "text": "那年輕的時候當運動員的時候"
    },
    {
      "end": 10820.0,
      "start": 10817.0,
      "text": "你睡下去了你把我抬走了"
    },
    {
      "end": 10822.0,
      "start": 10820.0,
      "text": "我可能都不知道"
    },
    {
      "end": 10824.0,
      "start": 10822.0,
      "text": "就一覺都能睡12個小時的那種"
    },
    {
      "end": 10826.0,
      "start": 10824.0,
      "text": "他打呼嚕比我想多"
    },
    {
      "end": 10828.0,
      "start": 10826.0,
      "text": "現在也是"
    },
    {
      "end": 10832.0,
      "start": 10828.0,
      "text": "吃青蛙素以後好像睡眠更好了"
    },
    {
      "end": 10834.0,
      "start": 10832.0,
      "text": "你沒吃都很好"
    },
    {
      "end": 10836.0,
      "start": 10834.0,
      "text": "然後七哥說的"
    },
    {
      "end": 10838.0,
      "start": 10836.0,
      "text": "我共產黨快滅了"
    },
    {
      "end": 10842.0,
      "start": 10838.0,
      "text": "我覺得我也有這個靈感"
    },
    {
      "end": 10844.0,
      "start": 10842.0,
      "text": "因為我從來都"
    },
    {
      "end": 10846.0,
      "start": 10844.0,
      "text": "基本上很少做夢很少做夢"
    },
    {
      "end": 10850.0,
      "start": 10846.0,
      "text": "最近老孟姐外公啊"
    },
    {
      "end": 10853.0,
      "start": 10850.0,
      "text": "所謂家裡人"
    },
    {
      "end": 10855.0,
      "start": 10853.0,
      "text": "老孟姐這些家裡人"
    },
    {
      "end": 10857.0,
      "start": 10855.0,
      "text": "覺得可能快要見面了"
    },
    {
      "end": 10860.0,
      "start": 10857.0,
      "text": "有這種感覺啊"
    },
    {
      "end": 10862.0,
      "start": 10860.0,
      "text": "就是我談一點感受啊"
    },
    {
      "end": 10863.0,
      "start": 10862.0,
      "text": "齊哥你剛才說的"
    },
    {
      "end": 10864.0,
      "start": 10863.0,
      "text": "就是你在清風看護所"
    },
    {
      "end": 10867.0,
      "start": 10864.0,
      "text": "當年是很多人被槍斃了"
    },
    {
      "end": 10868.0,
      "start": 10867.0,
      "text": "你曾經看見的"
    },
    {
      "end": 10870.0,
      "start": 10868.0,
      "text": "我十四五歲的時候回青島"
    },
    {
      "end": 10872.0,
      "start": 10870.0,
      "text": "八四八五年回家探親"
    },
    {
      "end": 10876.0,
      "start": 10872.0,
      "text": "跟我父親什麼的在大苗山打架"
    },
    {
      "end": 10878.0,
      "start": 10876.0,
      "text": "最後被抓到遼寧路拍手所"
    },
    {
      "end": 10880.0,
      "start": 10878.0,
      "text": "我也曾經都被啊"
    },
    {
      "end": 10881.0,
      "start": 10880.0,
      "text": "拖光"
    },
    {
      "end": 10882.0,
      "start": 10881.0,
      "text": "跪那坐那"
    },
    {
      "end": 10883.0,
      "start": 10882.0,
      "text": "警察拿"
    },
    {
      "end": 10885.0,
      "start": 10883.0,
      "text": "電棍捋我"
    },
    {
      "end": 10886.0,
      "start": 10885.0,
      "text": "但是不通電啊"
    },
    {
      "end": 10887.0,
      "start": 10886.0,
      "text": "把我纏"
    },
    {
      "end": 10888.0,
      "start": 10887.0,
      "text": "就"
    },
    {
      "end": 10889.0,
      "start": 10888.0,
      "text": "綁在那要"
    },
    {
      "end": 10890.0,
      "start": 10889.0,
      "text": "我都經歷啊"
    },
    {
      "end": 10892.0,
      "start": 10890.0,
      "text": "七哥我告訴你就是浩海東"
    },
    {
      "end": 10894.0,
      "start": 10892.0,
      "text": "曾經經經歷的所有的事情"
    },
    {
      "end": 10896.0,
      "start": 10894.0,
      "text": "為什麼我曾經到今天"
    },
    {
      "end": 10901.0,
      "start": 10896.0,
      "text": "因為我經歷了所有能讓我最後站出來啊"
    },
    {
      "end": 10904.0,
      "start": 10901.0,
      "text": "消滅共產黨的這些所有的過程啊"
    },
    {
      "end": 10905.0,
      "start": 10904.0,
      "text": "我沒有"
    },
    {
      "end": 10906.0,
      "start": 10905.0,
      "text": "因為我當時我還告訴他們"
    },
    {
      "end": 10907.0,
      "start": 10906.0,
      "text": "我說我"
    },
    {
      "end": 10908.0,
      "start": 10907.0,
      "text": "你"
    },
    {
      "end": 10909.0,
      "start": 10908.0,
      "text": "但是畢竟自己小嘛"
    },
    {
      "end": 10910.0,
      "start": 10909.0,
      "text": "十四五歲"
    },
    {
      "end": 10911.0,
      "start": 10910.0,
      "text": "他們兩個警察來"
    },
    {
      "end": 10912.0,
      "start": 10911.0,
      "text": "肯定把我捐豬頭髮"
    },
    {
      "end": 10913.0,
      "start": 10912.0,
      "text": "但是他們"
    },
    {
      "end": 10914.0,
      "start": 10913.0,
      "text": "還畢竟我還是"
    },
    {
      "end": 10916.0,
      "start": 10914.0,
      "text": "要我現在他們早死了"
    },
    {
      "end": 10919.0,
      "start": 10916.0,
      "text": "但是一定把我壓回去了"
    },
    {
      "end": 10920.0,
      "start": 10919.0,
      "text": "完了以後我就在那"
    },
    {
      "end": 10922.0,
      "start": 10920.0,
      "text": "給我坐那兒"
    },
    {
      "end": 10924.0,
      "start": 10922.0,
      "text": "竹條子"
    },
    {
      "end": 10925.0,
      "start": 10924.0,
      "text": "瞪了完了"
    },
    {
      "end": 10926.0,
      "start": 10925.0,
      "text": "點兩塊兒鑽頭"
    },
    {
      "end": 10927.0,
      "start": 10926.0,
      "text": "把衣服脫了"
    },
    {
      "end": 10928.0,
      "start": 10927.0,
      "text": "就問"
    },
    {
      "end": 10930.0,
      "start": 10928.0,
      "text": "廣展完了"
    },
    {
      "end": 10931.0,
      "start": 10930.0,
      "text": "捋我"
    },
    {
      "end": 10933.0,
      "start": 10931.0,
      "text": "說過什麼處分"
    },
    {
      "end": 10935.0,
      "start": 10933.0,
      "text": "我說我告訴你們別打人啊"
    },
    {
      "end": 10936.0,
      "start": 10935.0,
      "text": "我說你們這邊要不要別打人啊"
    },
    {
      "end": 10937.0,
      "start": 10936.0,
      "text": "我說中國人民解放軍啊"
    },
    {
      "end": 10939.0,
      "start": 10937.0,
      "text": "我說他們一聽"
    },
    {
      "end": 10940.0,
      "start": 10939.0,
      "text": "我說這個小的"
    },
    {
      "end": 10941.0,
      "start": 10940.0,
      "text": "這麼點小孩"
    },
    {
      "end": 10942.0,
      "start": 10941.0,
      "text": "我告訴你"
    },
    {
      "end": 10943.0,
      "start": 10942.0,
      "text": "是先動手的"
    },
    {
      "end": 10945.0,
      "start": 10943.0,
      "text": "我說他們先打我"
    },
    {
      "end": 10946.0,
      "start": 10945.0,
      "text": "我們才動手"
    },
    {
      "end": 10948.0,
      "start": 10946.0,
      "text": "後來就"
    },
    {
      "end": 10949.0,
      "start": 10948.0,
      "text": "打弄完"
    },
    {
      "end": 10952.0,
      "start": 10949.0,
      "text": "當時找了王家"
    },
    {
      "end": 10953.0,
      "start": 10952.0,
      "text": "當時王永利"
    },
    {
      "end": 10954.0,
      "start": 10953.0,
      "text": "當時王永利還是"
    },
    {
      "end": 10956.0,
      "start": 10954.0,
      "text": "清早是公安局辦公室的"
    },
    {
      "end": 10958.0,
      "start": 10956.0,
      "text": "局長辦公室的主任"
    },
    {
      "end": 10960.0,
      "start": 10958.0,
      "text": "王永利幫我們撈出去"
    },
    {
      "end": 10961.0,
      "start": 10960.0,
      "text": "我我爸什麼的"
    },
    {
      "end": 10963.0,
      "start": 10961.0,
      "text": "我媽小舅在外頭"
    },
    {
      "end": 10967.0,
      "start": 10963.0,
      "text": "那現在王永利也早就被抓了"
    },
    {
      "end": 10968.0,
      "start": 10967.0,
      "text": "對吧"
    },
    {
      "end": 10969.0,
      "start": 10968.0,
      "text": "他的女兒天天上訪問問"
    },
    {
      "end": 10972.0,
      "start": 10969.0,
      "text": "就是共產黨的這種體制"
    },
    {
      "end": 10973.0,
      "start": 10972.0,
      "text": "包括我們經歷過的"
    },
    {
      "end": 10976.0,
      "start": 10973.0,
      "text": "就是都感受到了"
    },
    {
      "end": 10979.0,
      "start": 10976.0,
      "text": "這些所有的他們的不公啊"
    },
    {
      "end": 10980.0,
      "start": 10979.0,
      "text": "不講理啊"
    },
    {
      "end": 10981.0,
      "start": 10980.0,
      "text": "有法律啊"
    },
    {
      "end": 10983.0,
      "start": 10981.0,
      "text": "當然全世界都一樣啊"
    },
    {
      "end": 10984.0,
      "start": 10983.0,
      "text": "只有相對公平"
    },
    {
      "end": 10985.0,
      "start": 10984.0,
      "text": "沒有絕對公平"
    },
    {
      "end": 10987.0,
      "start": 10985.0,
      "text": "但是在共產黨裡面"
    },
    {
      "end": 10988.0,
      "start": 10987.0,
      "text": "沒有任何的保障"
    },
    {
      "end": 10990.0,
      "start": 10988.0,
      "text": "你不要想啊"
    },
    {
      "end": 10992.0,
      "start": 10990.0,
      "text": "有任何你有一點點的保障"
    },
    {
      "end": 10993.0,
      "start": 10992.0,
      "text": "剛才這個醫生說的"
    },
    {
      "end": 10996.0,
      "start": 10993.0,
      "text": "就是說你看見的這些年輕的孩子們"
    },
    {
      "end": 10998.0,
      "start": 10996.0,
      "text": "會被一個個換肾"
    },
    {
      "end": 10999.0,
      "start": 10998.0,
      "text": "真的是這樣換肝"
    },
    {
      "end": 11000.0,
      "start": 10999.0,
      "text": "因為我都剛才講了"
    },
    {
      "end": 11002.0,
      "start": 11000.0,
      "text": "清老師官局副局長"
    },
    {
      "end": 11003.0,
      "start": 11002.0,
      "text": "是吧"
    },
    {
      "end": 11004.0,
      "start": 11003.0,
      "text": "他就是換了肝"
    },
    {
      "end": 11005.0,
      "start": 11004.0,
      "text": "是吧"
    },
    {
      "end": 11006.0,
      "start": 11005.0,
      "text": "這個這個十幾年了"
    },
    {
      "end": 11007.0,
      "start": 11006.0,
      "text": "一般的人"
    },
    {
      "end": 11009.0,
      "start": 11007.0,
      "text": "你想想哪有這種"
    },
    {
      "end": 11011.0,
      "start": 11009.0,
      "text": "可能"
    },
    {
      "end": 11012.0,
      "start": 11011.0,
      "text": "在309啊"
    },
    {
      "end": 11013.0,
      "start": 11012.0,
      "text": "309你知道"
    },
    {
      "end": 11015.0,
      "start": 11013.0,
      "text": "在我們國防大學裡面"
    },
    {
      "end": 11016.0,
      "start": 11015.0,
      "text": "現在就叫陸軍總醫院了吧"
    },
    {
      "end": 11017.0,
      "start": 11016.0,
      "text": "是吧"
    },
    {
      "end": 11018.0,
      "start": 11017.0,
      "text": "就是"
    },
    {
      "end": 11019.0,
      "start": 11018.0,
      "text": "所有的這一切我經歷的"
    },
    {
      "end": 11021.0,
      "start": 11019.0,
      "text": "包括剛才七哥說的"
    },
    {
      "end": 11024.0,
      "start": 11021.0,
      "text": "香港的這97年還是98年啊"
    },
    {
      "end": 11026.0,
      "start": 11024.0,
      "text": "向華強的各個向華盛"
    },
    {
      "end": 11027.0,
      "start": 11026.0,
      "text": "當時到了北京"
    },
    {
      "end": 11028.0,
      "start": 11027.0,
      "text": "一塊吃飯"
    },
    {
      "end": 11029.0,
      "start": 11028.0,
      "text": "後來我過去"
    },
    {
      "end": 11030.0,
      "start": 11029.0,
      "text": "當時13局啊"
    },
    {
      "end": 11031.0,
      "start": 11030.0,
      "text": "還有公安部"
    },
    {
      "end": 11032.0,
      "start": 11031.0,
      "text": "丁偉"
    },
    {
      "end": 11033.0,
      "start": 11032.0,
      "text": "局長"
    },
    {
      "end": 11034.0,
      "start": 11033.0,
      "text": "當時都在向華盛"
    },
    {
      "end": 11036.0,
      "start": 11034.0,
      "text": "當時就來擺碼頭了"
    },
    {
      "end": 11038.0,
      "start": 11036.0,
      "text": "所以為什麼說"
    },
    {
      "end": 11040.0,
      "start": 11038.0,
      "text": "香港的今天"
    },
    {
      "end": 11042.0,
      "start": 11040.0,
      "text": "就是這幫孫子"
    },
    {
      "end": 11044.0,
      "start": 11042.0,
      "text": "不要臉的"
    },
    {
      "end": 11045.0,
      "start": 11044.0,
      "text": "出賣香港的"
    },
    {
      "end": 11047.0,
      "start": 11045.0,
      "text": "為了一點點個人私利"
    },
    {
      "end": 11049.0,
      "start": 11047.0,
      "text": "他們知道共產黨來了"
    },
    {
      "end": 11050.0,
      "start": 11049.0,
      "text": "他們投稿共產黨"
    },
    {
      "end": 11051.0,
      "start": 11050.0,
      "text": "是吧"
    },
    {
      "end": 11054.0,
      "start": 11051.0,
      "text": "他們要把這些所有的人控制住"
    },
    {
      "end": 11056.0,
      "start": 11054.0,
      "text": "所謂的黑社會"
    },
    {
      "end": 11057.0,
      "start": 11056.0,
      "text": "黑他媽個屁"
    },
    {
      "end": 11058.0,
      "start": 11057.0,
      "text": "我都告訴大家"
    },
    {
      "end": 11059.0,
      "start": 11058.0,
      "text": "大連的東海波還黑社會"
    },
    {
      "end": 11061.0,
      "start": 11059.0,
      "text": "我說黑他們死利波"
    },
    {
      "end": 11063.0,
      "start": 11061.0,
      "text": "你們那麼一個"
    },
    {
      "end": 11065.0,
      "start": 11063.0,
      "text": "派出所所長都抓著你們買出跑"
    },
    {
      "end": 11066.0,
      "start": 11065.0,
      "text": "對吧"
    },
    {
      "end": 11067.0,
      "start": 11066.0,
      "text": "別人你們跟我講"
    },
    {
      "end": 11068.0,
      "start": 11067.0,
      "text": "剛才七哥說到北京"
    },
    {
      "end": 11069.0,
      "start": 11068.0,
      "text": "當時有東北的"
    },
    {
      "end": 11070.0,
      "start": 11069.0,
      "text": "有什麼的"
    },
    {
      "end": 11071.0,
      "start": 11070.0,
      "text": "在天上人家都碰到過"
    },
    {
      "end": 11073.0,
      "start": 11071.0,
      "text": "大連那個死利波出來"
    },
    {
      "end": 11074.0,
      "start": 11073.0,
      "text": "哎呦"
    },
    {
      "end": 11075.0,
      "start": 11074.0,
      "text": "還能你在這兒什麼的"
    },
    {
      "end": 11076.0,
      "start": 11075.0,
      "text": "我說你也來了啊"
    },
    {
      "end": 11077.0,
      "start": 11076.0,
      "text": "我說你在這兒幹嗎"
    },
