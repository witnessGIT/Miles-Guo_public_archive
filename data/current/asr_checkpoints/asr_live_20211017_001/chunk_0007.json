{
  "chunk_audio_sha256": "f1df0e2b6cf4317a5e46acf1a551c9b5c446bf634fff35b67d71381aa115da82",
  "chunk_index": 7,
  "completed_at": "2026-10-20T15:04:38Z",
  "language": "zh",
  "live_id": "LIVE_20211017_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 6300,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 6305.68,
      "start": 6300.0,
      "text": "宋行平原来是总参政治部副主任总参纪委的副书记"
    },
    {
      "end": 6309.64,
      "start": 6305.68,
      "text": "解放军学院政委是我山东的发小"
    },
    {
      "end": 6312.28,
      "start": 6309.64,
      "text": "他爸爸是山东政法委书记"
    },
    {
      "end": 6314.78,
      "start": 6312.98,
      "text": "黄峰辉见他多多了"
    },
    {
      "end": 6316.48,
      "start": 6314.78,
      "text": "那军纪委那多牛啊"
    },
    {
      "end": 6318.82,
      "start": 6316.48,
      "text": "我那哥们被他给抓了"
    },
    {
      "end": 6321.62,
      "start": 6319.82,
      "text": "黄峰辉跟我那事"
    },
    {
      "end": 6324.62,
      "start": 6321.62,
      "text": "那是见我面永远老远的"
    },
    {
      "end": 6327.06,
      "start": 6324.62,
      "text": "从来不像海东兄那对我那么不尊敬"
    },
    {
      "end": 6327.8,
      "start": 6327.06,
      "text": "是不是"
    },
    {
      "end": 6329.64,
      "start": 6327.8,
      "text": "是不是又硬又软的"
    },
    {
      "end": 6332.18,
      "start": 6329.64,
      "text": "人家是远老远的人都很尊敬"
    },
    {
      "end": 6333.24,
      "start": 6332.18,
      "text": "开玩笑"
    },
    {
      "end": 6335.48,
      "start": 6333.24,
      "text": "所以说这个当时"
    },
    {
      "end": 6339.84,
      "start": 6335.98,
      "text": "就是这个中纪委的哥们告诉我说"
    },
    {
      "end": 6342.02,
      "start": 6339.84,
      "text": "他说你知道七个我们查宋行平的案子"
    },
    {
      "end": 6343.42,
      "start": 6342.02,
      "text": "因为有关就查得去"
    },
    {
      "end": 6346.42,
      "start": 6343.78,
      "text": "他说整个我们查完宋行平是完全被陷害的"
    },
    {
      "end": 6348.92,
      "start": 6347.32,
      "text": "谁为啥要陷害他"
    },
    {
      "end": 6351.36,
      "start": 6349.52,
      "text": "他说就是因为他最早"
    },
    {
      "end": 6353.4,
      "start": 6351.36,
      "text": "他是揭发郭伯雄和徐太后"
    },
    {
      "end": 6355.7,
      "start": 6353.66,
      "text": "他说但是我们不敢给习点出来"
    },
    {
      "end": 6357.2,
      "start": 6355.7,
      "text": "也不敢让徐新亮知道"
    },
    {
      "end": 6360.24,
      "start": 6357.2,
      "text": "因为徐新亮跟宋行平也很好"
    },
    {
      "end": 6364.2,
      "start": 6361.74,
      "text": "徐新亮是习最相信的军队的人"
    },
    {
      "end": 6369.38,
      "start": 6364.88,
      "text": "他说因为宋行平对徐新亮是个最大的威胁"
    },
    {
      "end": 6371.12,
      "start": 6369.88,
      "text": "包括王福庆"
    },
    {
      "end": 6373.24,
      "start": 6371.58,
      "text": "我真的恍然大悟"
    },
    {
      "end": 6376.28,
      "start": 6373.24,
      "text": "这就是东地今天你知道我真的是"
    },
    {
      "end": 6378.28,
      "start": 6376.28,
      "text": "咱们很多战友不懂这个军中规矩"
    },
    {
      "end": 6380.24,
      "start": 6378.28,
      "text": "我说这个东地完全都明白哪回事"
    },
    {
      "end": 6384.42,
      "start": 6380.24,
      "text": "就中央警卫局总参谋不是中国军队的力量"
    },
    {
      "end": 6385.92,
      "start": 6384.42,
      "text": "剩下的全都是前面打工的"
    },
    {
      "end": 6388.16,
      "start": 6385.92,
      "text": "让你杀人让你被杀就干这个的"
    },
    {
      "end": 6391.2,
      "start": 6388.16,
      "text": "做战部总参是最牛的"
    },
    {
      "end": 6394.2,
      "start": 6391.2,
      "text": "这是为什么当时中央警卫局"
    },
    {
      "end": 6399.34,
      "start": 6394.2,
      "text": "汪东兴时代当时最后汪东兴之后是归到谁啊"
    },
    {
      "end": 6400.84,
      "start": 6399.34,
      "text": "是归到总参的"
    },
    {
      "end": 6403.8,
      "start": 6400.84,
      "text": "总参管着中办管着中央警卫局"
    },
    {
      "end": 6405.32,
      "start": 6403.8,
      "text": "后来老江要拿回来嘛"
    },
    {
      "end": 6406.96,
      "start": 6405.32,
      "text": "这才是根本的问题"
    },
    {
      "end": 6409.8,
      "start": 6406.96,
      "text": "那么总参还有作战部"
    },
    {
      "end": 6412.72,
      "start": 6409.8,
      "text": "包括军队的纪委他也是总参"
    },
    {
      "end": 6414.66,
      "start": 6412.72,
      "text": "这里边大多数总参人"
    },
    {
      "end": 6417.16,
      "start": 6414.66,
      "text": "总政的后面弄干部是腐败的地方"
    },
    {
      "end": 6418.84,
      "start": 6417.16,
      "text": "也别看他没那么牛"
    },
    {
      "end": 6421.96,
      "start": 6418.84,
      "text": "你像余永波跟东地和我都很熟"
    },
    {
      "end": 6424.44,
      "start": 6421.96,
      "text": "余永波想干很多事最后也没干成"
    },
    {
      "end": 6428.2,
      "start": 6424.44,
      "text": "那么咱那个中纪委哥们告诉我"
    },
    {
      "end": 6430.16,
      "start": 6428.2,
      "text": "这个报案他说我去查这几个人"
    },
    {
      "end": 6432.64,
      "start": 6430.16,
      "text": "军中的时候最烂的他就是许太后"
    },
    {
      "end": 6436.42,
      "start": 6432.64,
      "text": "他说他连他家的四肌都给咬出来"
    },
    {
      "end": 6438.5,
      "start": 6436.42,
      "text": "他能咬就咬"
    },
    {
      "end": 6440.02,
      "start": 6438.5,
      "text": "他真是不要脸"
    },
    {
      "end": 6443.1,
      "start": 6440.02,
      "text": "他说还有这个钟永康的七个你说太对了"
    },
    {
      "end": 6444.72,
      "start": 6443.1,
      "text": "奸人就哭哭啼啼的"
    },
    {
      "end": 6446.92,
      "start": 6444.72,
      "text": "哎呀我老了"
    },
    {
      "end": 6449.0,
      "start": 6446.92,
      "text": "我这回身是病啊"
    },
    {
      "end": 6451.36,
      "start": 6449.0,
      "text": "给我点自由给我点空间"
    },
    {
      "end": 6453.08,
      "start": 6451.36,
      "text": "活了今天没明天"
    },
    {
      "end": 6455.8,
      "start": 6453.08,
      "text": "我中一党给习同志道歉"
    },
    {
      "end": 6457.7,
      "start": 6455.8,
      "text": "习入习我尊重他"
    },
    {
      "end": 6458.9,
      "start": 6457.7,
      "text": "他说奸人就哭"
    },
    {
      "end": 6460.4,
      "start": 6458.9,
      "text": "你这个东西你说"
    },
    {
      "end": 6463.18,
      "start": 6460.4,
      "text": "他说你为啥掌握那么多情况"
    },
    {
      "end": 6467.88,
      "start": 6463.18,
      "text": "我说在你之前跑出来是秦城监狱无把手"
    },
    {
      "end": 6469.82,
      "start": 6467.88,
      "text": "就是我救出来的"
    },
    {
      "end": 6475.9,
      "start": 6469.82,
      "text": "秦城监狱进了秦城的人秘密对我来讲没任何秘密"
    },
    {
      "end": 6477.62,
      "start": 6475.9,
      "text": "我说我今天可以告诉你"
    },
    {
      "end": 6478.94,
      "start": 6477.62,
      "text": "我今天在直播中可以说"
    },
    {
      "end": 6483.4,
      "start": 6478.94,
      "text": "秦城监狱无把手是2019年我救出来的"
    },
    {
      "end": 6489.68,
      "start": 6483.4,
      "text": "所以说这孙立军这所有藏的卷中还有傅政华"
    },
    {
      "end": 6494.32,
      "start": 6489.68,
      "text": "他说七个我告诉你这任何样东西出来惊爆世界"
    },
    {
      "end": 6501.8,
      "start": 6494.32,
      "text": "说到这的时候就咱们大家说中国老百姓多可怜"
    },
    {
      "end": 6504.3,
      "start": 6501.8,
      "text": "中国老百姓有多可悲"
    },
    {
      "end": 6506.86,
      "start": 6504.3,
      "text": "接下来我们谈另外一个今天的重要话题"
    },
    {
      "end": 6508.1,
      "start": 6506.86,
      "text": "再谈到房地产"
    },
    {
      "end": 6511.74,
      "start": 6508.1,
      "text": "中国的房地产什么概念啊"
    },
    {
      "end": 6512.6,
      "start": 6511.74,
      "text": "就平安的事儿"
    },
    {
      "end": 6514.8,
      "start": 6512.6,
      "text": "他说我亲自审的马明哲"
    },
    {
      "end": 6517.1,
      "start": 6514.8,
      "text": "我让他给我捋了个账"
    },
    {
      "end": 6520.3,
      "start": 6517.1,
      "text": "人寿多少钱投的房地产"
    },
    {
      "end": 6522.0,
      "start": 6520.3,
      "text": "两万三千亿"
    },
    {
      "end": 6526.28,
      "start": 6522.0,
      "text": "平安银行几乎说大客户"
    },
    {
      "end": 6528.74,
      "start": 6526.28,
      "text": "公开的称一点三万亿"
    },
    {
      "end": 6530.92,
      "start": 6528.74,
      "text": "他说事实上加票加什么"
    },
    {
      "end": 6532.72,
      "start": 6530.92,
      "text": "将近两万两点五万亿"
    },
    {
      "end": 6536.52,
      "start": 6532.72,
      "text": "你看这这就已经是"
    },
    {
      "end": 6538.72,
      "start": 6536.52,
      "text": "已经是快四万亿了"
    },
    {
      "end": 6540.32,
      "start": 6538.72,
      "text": "就这一个就平安干净"
    },
    {
      "end": 6543.46,
      "start": 6540.32,
      "text": "然后平安的向下的所有金融产品"
    },
    {
      "end": 6544.82,
      "start": 6543.46,
      "text": "包括平安信托"
    },
    {
      "end": 6547.92,
      "start": 6544.82,
      "text": "然后他说通过信托票据"
    },
    {
      "end": 6550.72,
      "start": 6547.92,
      "text": "下来他说又将近一万多亿"
    },
    {
      "end": 6555.34,
      "start": 6550.72,
      "text": "他说然后平安最夸张的事情"
    },
    {
      "end": 6557.34,
      "start": 6555.34,
      "text": "他平安用他所有的下面"
    },
    {
      "end": 6561.14,
      "start": 6557.34,
      "text": "平安证券和其他所有的联合票据"
    },
    {
      "end": 6562.68,
      "start": 6561.14,
      "text": "穿马甲的钱"
    },
    {
      "end": 6563.9,
      "start": 6562.68,
      "text": "他说三万多亿"
    },
    {
      "end": 6567.3,
      "start": 6563.9,
      "text": "他说一个平安就九万多亿美元"
    },
    {
      "end": 6568.34,
      "start": 6567.3,
      "text": "九万多亿人民币"
    },
    {
      "end": 6569.18,
      "start": 6568.34,
      "text": "一万多亿美元"
    },
    {
      "end": 6571.7,
      "start": 6569.18,
      "text": "他说我们查过的"
    },
    {
      "end": 6574.14,
      "start": 6571.7,
      "text": "这里面佣金回扣绝对是超过"
    },
    {
      "end": 6575.6,
      "start": 6574.14,
      "text": "百分之二十"
    },
    {
      "end": 6578.32,
      "start": 6575.6,
      "text": "滥账超过百分之五十"
    },
    {
      "end": 6579.08,
      "start": 6578.32,
      "text": "他说那这样呢"
    },
    {
      "end": 6579.92,
      "start": 6579.08,
      "text": "他说就是七哥"
    },
    {
      "end": 6580.68,
      "start": 6579.92,
      "text": "你说的太对了"
    },
    {
      "end": 6585.06,
      "start": 6580.68,
      "text": "就平安钱能拿回两万亿都不错了"
    },
    {
      "end": 6587.92,
      "start": 6585.06,
      "text": "他说平安对王岐山的行贿"
    },
    {
      "end": 6589.46,
      "start": 6587.92,
      "text": "对周亮的行贿"
    },
    {
      "end": 6592.16,
      "start": 6589.46,
      "text": "平安所有的包括张高丽"
    },
    {
      "end": 6594.1,
      "start": 6592.16,
      "text": "包括黄丽满"
    },
    {
      "end": 6595.7,
      "start": 6594.1,
      "text": "包括所有的政治局常委"
    },
    {
      "end": 6598.66,
      "start": 6595.7,
      "text": "包括王岐山所有身边的人"
    },
    {
      "end": 6600.7,
      "start": 6598.66,
      "text": "所有的三会证监会"
    },
    {
      "end": 6603.3,
      "start": 6600.7,
      "text": "包括他郭树星跟着马明哲是至交"
    },
    {
      "end": 6606.4,
      "start": 6603.3,
      "text": "他说周亮就更不用提了"
    },
    {
      "end": 6608.5,
      "start": 6606.4,
      "text": "他说七哥你说太对了"
    },
    {
      "end": 6611.24,
      "start": 6608.5,
      "text": "马明哲是中国的大瓢巴子"
    },
    {
      "end": 6614.6,
      "start": 6611.24,
      "text": "他说这绝对把关上砸个坑"
    },
    {
      "end": 6615.84,
      "start": 6614.6,
      "text": "他说再一个房地产"
    },
    {
      "end": 6619.28,
      "start": 6615.84,
      "text": "他说徐家印的房地产不是最夸张的"
    },
    {
      "end": 6622.38,
      "start": 6619.28,
      "text": "他说你看看现在香港"
    },
    {
      "end": 6623.98,
      "start": 6622.38,
      "text": "一会儿我们再说香港话题"
    },
    {
      "end": 6625.58,
      "start": 6623.98,
      "text": "说这几个房地产"
    },
    {
      "end": 6626.72,
      "start": 6625.58,
      "text": "何生创长"
    },
    {
      "end": 6629.02,
      "start": 6626.72,
      "text": "富丽"
    },
    {
      "end": 6632.56,
      "start": 6629.02,
      "text": "还有那个叫什么荣创"
    },
    {
      "end": 6634.66,
      "start": 6632.56,
      "text": "大连万达"
    },
    {
      "end": 6638.62,
      "start": 6634.66,
      "text": "他说这个包括那个那个"
    },
    {
      "end": 6639.8,
      "start": 6638.62,
      "text": "碧桂园"
    },
    {
      "end": 6643.06,
      "start": 6639.8,
      "text": "他说七哥这真的是吓死你了"
    },
    {
      "end": 6645.24,
      "start": 6643.06,
      "text": "他说全都是假贷款"
    },
    {
      "end": 6646.7,
      "start": 6645.24,
      "text": "全都是假账"
    },
    {
      "end": 6650.98,
      "start": 6646.7,
      "text": "他说共产党真的是一笔糊涂账"
    },
    {
      "end": 6652.38,
      "start": 6650.98,
      "text": "他真的不清楚"
    },
    {
      "end": 6655.68,
      "start": 6652.38,
      "text": "他说我们中纪委查账是边查边学"
    },
    {
      "end": 6657.06,
      "start": 6655.68,
      "text": "他说我们看了你直播"
    },
    {
      "end": 6658.56,
      "start": 6657.06,
      "text": "我们拿着你直播去捋一下"
    },
    {
      "end": 6660.46,
      "start": 6658.56,
      "text": "一捋就捋上来一捋就捋上来"
    },
    {
      "end": 6663.32,
      "start": 6660.46,
      "text": "我们每次都改写我们对素质的认识"
    },
    {
      "end": 6666.06,
      "start": 6663.32,
      "text": "他说真的中纪委专主是没有这个概念的"
    },
    {
      "end": 6669.66,
      "start": 6666.06,
      "text": "包括后来说就是刚才Aggles说这个"
    },
    {
      "end": 6672.3,
      "start": 6669.66,
      "text": "他说你这几个专家自杀的事情"
    },
    {
      "end": 6675.3,
      "start": 6672.3,
      "text": "是因为你报这件事情"
    },
    {
      "end": 6678.58,
      "start": 6675.3,
      "text": "是江家恨你的根本原因"
    },
    {
      "end": 6682.18,
      "start": 6678.58,
      "text": "和孟建柱王岐山追杀你的最根本原因"
    },
    {
      "end": 6684.98,
      "start": 6682.18,
      "text": "就是你这些专家你这个真相"
    },
    {
      "end": 6685.98,
      "start": 6684.98,
      "text": "包括马航"
    },
    {
      "end": 6688.36,
      "start": 6686.86,
      "text": "这是江家最恐惧的"
    },
    {
      "end": 6691.18,
      "start": 6688.36,
      "text": "他们不知道你手里哪天把东西全放出来"
    },
    {
      "end": 6693.12,
      "start": 6691.18,
      "text": "所以说一定要做掉你"
    },
    {
      "end": 6694.62,
      "start": 6693.12,
      "text": "原话就在做掉你"
    },
    {
      "end": 6697.52,
      "start": 6694.62,
      "text": "这个孙立军被几次谈话"
    },
    {
      "end": 6701.9,
      "start": 6697.52,
      "text": "被这个江志成还有江绵恒孟建柱"
    },
    {
      "end": 6703.52,
      "start": 6701.9,
      "text": "孙立军说我接到了命了"
    },
    {
      "end": 6704.96,
      "start": 6703.52,
      "text": "就不惜代表把郭文贵做掉"
    },
    {
      "end": 6709.5,
      "start": 6704.96,
      "text": "然后说这个王岐山给他说"
    },
    {
      "end": 6712.36,
      "start": 6709.5,
      "text": "你连郭文贵都搞不定你还想当什么正不及啊"
    },
    {
      "end": 6713.9,
      "start": 6712.36,
      "text": "这原话啊"
    },
    {
      "end": 6716.2,
      "start": 6713.9,
      "text": "这是我今天说的话是体制内的人"
    },
    {
      "end": 6719.0,
      "start": 6716.2,
      "text": "王岐山亲自告诉孙立军"
    },
    {
      "end": 6722.5,
      "start": 6719.0,
      "text": "你要连郭文贵搞不掉你怎么正不及呢"
    },
    {
      "end": 6724.88,
      "start": 6722.5,
      "text": "孟建柱骂他几次祖宗"
    },
    {
      "end": 6726.18,
      "start": 6724.88,
      "text": "说你连郭文贵都搞不定"
    },
    {
      "end": 6728.32,
      "start": 6726.18,
      "text": "你还老想着当常务部长"
    },
    {
      "end": 6730.04,
      "start": 6728.32,
      "text": "安全部部长怎么可能"
    },
    {
      "end": 6732.12,
      "start": 6730.04,
      "text": "孙立军要求要么到公安部常务部长"
    },
    {
      "end": 6733.32,
      "start": 6732.12,
      "text": "要么到安全部马上解决"
    },
    {
      "end": 6734.38,
      "start": 6733.32,
      "text": "最后没人解决嘛"
    },
    {
      "end": 6735.92,
      "start": 6734.38,
      "text": "说在这把他全交代"
    },
    {
      "end": 6740.86,
      "start": 6735.92,
      "text": "还有在香港抓杀这些孩子"
    },
    {
      "end": 6742.2,
      "start": 6740.86,
      "text": "孙立军全部交代啊"
    },
    {
      "end": 6743.8,
      "start": 6742.2,
      "text": "我未来跟你们好好讲讲"
    },
    {
      "end": 6748.04,
      "start": 6743.8,
      "text": "他说七哥你讲的香港的孩子被奸被杀被鸡奸"
    },
    {
      "end": 6750.6,
      "start": 6748.04,
      "text": "包括先生说你说的都是对的"
    },
    {
      "end": 6751.84,
      "start": 6750.6,
      "text": "而且比你说的还要过"
    },
    {
      "end": 6758.2,
      "start": 6755.04,
      "text": "法轮功这件事情是江家最恨的"
    },
    {
      "end": 6760.84,
      "start": 6758.2,
      "text": "然后郭文贵竟然替法轮功说话"
    },
    {
      "end": 6762.38,
      "start": 6760.84,
      "text": "这也是江家恼火我的原因"
    },
    {
      "end": 6764.52,
      "start": 6762.38,
      "text": "我从来不指望法轮功说我好话"
    },
    {
      "end": 6767.62,
      "start": 6764.52,
      "text": "最近又有人挑拨法轮功和我们的关系"
    },
    {
      "end": 6768.72,
      "start": 6767.62,
      "text": "千万别上当"
    },
    {
      "end": 6771.42,
      "start": 6768.72,
      "text": "任何情况下爆料革命不能跟法轮功人为敌"
    },
    {
      "end": 6772.92,
      "start": 6771.42,
      "text": "因为法轮功是受害者"
    },
    {
      "end": 6776.76,
      "start": 6774.06,
      "text": "然后这些专家被杀的原因"
    },
    {
      "end": 6777.6,
      "start": 6776.76,
      "text": "被干掉的原因"
    },
    {
      "end": 6779.64,
      "start": 6777.6,
      "text": "他说七哥你几乎都说明白了"
    },
    {
      "end": 6781.28,
      "start": 6779.64,
      "text": "但是关键你没说出来"
    },
    {
      "end": 6783.48,
      "start": 6781.28,
      "text": "我们都知道你知道什么"
    },
    {
      "end": 6786.3,
      "start": 6784.58,
      "text": "这是共产党恨我的一个原因"
    },
    {
      "end": 6787.64,
      "start": 6786.3,
      "text": "怕我的原因"
    },
    {
      "end": 6790.08,
      "start": 6787.64,
      "text": "再一个觉得我手里有账单"
    },
    {
      "end": 6791.04,
      "start": 6790.08,
      "text": "有证据"
    },
    {
      "end": 6794.94,
      "start": 6791.04,
      "text": "最后他说傅政华"
    },
    {
      "end": 6797.14,
      "start": 6794.94,
      "text": "他说傅政华跟他们不是一伙的"
    },
    {
      "end": 6800.54,
      "start": 6797.14,
      "text": "傅政华最重要的事情就是你把他那个录音给他爆出来"
    },
    {
      "end": 6803.38,
      "start": 6800.54,
      "text": "还有傅政华担心他在海外的钱"
    },
    {
      "end": 6804.68,
      "start": 6803.38,
      "text": "你哪天把他做掉"
    },
    {
      "end": 6806.58,
      "start": 6804.68,
      "text": "把他的钱给弄走"
    },
    {
      "end": 6808.02,
      "start": 6806.58,
      "text": "这是傅政华的原话"
    },
    {
      "end": 6811.1,
      "start": 6808.02,
      "text": "就担心郭文贵把我们家人给把老三给害了"
    },
    {
      "end": 6813.22,
      "start": 6811.1,
      "text": "把我儿子把我家钱给弄走"
    },
    {
      "end": 6814.54,
      "start": 6813.22,
      "text": "这是傅政华的原话"
    },
    {
      "end": 6818.44,
      "start": 6814.54,
      "text": "要谈掉郭文贵这个威胁"
    },
    {
      "end": 6822.44,
      "start": 6818.44,
      "text": "然后韩政私下里最担心我"
    },
    {
      "end": 6824.04,
      "start": 6822.44,
      "text": "给我孙力军说"
    },
    {
      "end": 6827.98,
      "start": 6824.04,
      "text": "那个家伙你不除掉这是我们的共同危害啊"
    },
    {
      "end": 6831.5,
      "start": 6827.98,
      "text": "海航说就不能提我名字"
    },
    {
      "end": 6834.2,
      "start": 6831.5,
      "text": "一提我名字就人都变了都变形"
    },
    {
      "end": 6835.16,
      "start": 6834.2,
      "text": "就觉得我是个"
    },
    {
      "end": 6836.4,
      "start": 6835.16,
      "text": "简直是个魔鬼一样"
    },
    {
      "end": 6838.14,
      "start": 6836.4,
      "text": "一开始骂后来连骂也不骂了"
    },
    {
      "end": 6840.44,
      "start": 6838.14,
      "text": "一提就变就软一提就完"
    },
    {
      "end": 6844.84,
      "start": 6840.44,
      "text": "从这一系列的事情上我们再回到房地产"
    },
    {
      "end": 6846.58,
      "start": 6844.84,
      "text": "他说七个你点出房地产"
    },
    {
      "end": 6847.68,
      "start": 6846.58,
      "text": "最重要的一个人"
    },
    {
      "end": 6849.14,
      "start": 6847.68,
      "text": "叨火索是谁知道"
    },
    {
      "end": 6854.68,
      "start": 6849.14,
      "text": "他说抓孙力军之前所有上面中南坑"
    },
    {
      "end": 6855.98,
      "start": 6854.68,
      "text": "郭文贵说话全是假的"
    },
    {
      "end": 6861.5,
      "start": 6857.8,
      "text": "抓完孙力军以后抓了北京银行的闫明竹"
    },
    {
      "end": 6867.84,
      "start": 6863.4,
      "text": "因为刘延平的女儿是北京银行的总会计师"
    },
    {
      "end": 6870.4,
      "start": 6868.4,
      "text": "她是闫明竹最好的哥们"
    },
    {
      "end": 6872.44,
      "start": 6870.44,
      "text": "抓了闫明竹"
    },
    {
      "end": 6874.44,
      "start": 6872.44,
      "text": "闫明竹共出了很多事"
    },
    {
      "end": 6876.64,
      "start": 6874.44,
      "text": "跟你文贵说的一模一样"
    },
    {
      "end": 6878.04,
      "start": 6876.64,
      "text": "北京银行是个大雷"
    },
    {
      "end": 6882.38,
      "start": 6878.04,
      "text": "最后肖建华在里面交代出了闫明竹"
    },
    {
      "end": 6883.68,
      "start": 6882.38,
      "text": "北京银行好多事"
    },
    {
      "end": 6885.48,
      "start": 6883.68,
      "text": "肖建华也交代"
    },
    {
      "end": 6887.6,
      "start": 6885.48,
      "text": "然后叶简明的事"
    },
    {
      "end": 6890.5,
      "start": 6887.6,
      "text": "你说到的点到的在俄罗斯"
    },
    {
      "end": 6893.54,
      "start": 6890.5,
      "text": "在哈萨拜疆这些所有的游的事情"
    },
    {
      "end": 6895.24,
      "start": 6893.54,
      "text": "你说的我们查都合适"
    },
    {
      "end": 6897.54,
      "start": 6895.24,
      "text": "这个时候整个中南坑人就转了"
    },
    {
      "end": 6899.04,
      "start": 6897.54,
      "text": "为什么郭文贵说都是真的"
    },
    {
      "end": 6901.04,
      "start": 6899.04,
      "text": "最后查明王立科"
    },
    {
      "end": 6902.04,
      "start": 6901.04,
      "text": "罗文正"
    },
    {
      "end": 6906.64,
      "start": 6902.04,
      "text": "还有这个王岐山孟建柱要杀习的这件事情之后"
    },
    {
      "end": 6909.44,
      "start": 6906.64,
      "text": "现在咱们的爆料革命就在党内的微信"
    },
    {
      "end": 6910.64,
      "start": 6909.44,
      "text": "那是非常高"
    },
    {
      "end": 6912.04,
      "start": 6910.64,
      "text": "越往上越高"
    },
    {
      "end": 6916.34,
      "start": 6912.04,
      "text": "他说七哥你点爆的可能最危险的就两件事"
    },
    {
      "end": 6919.64,
      "start": 6916.34,
      "text": "你点出了中国这专家被江家干掉"
    },
    {
      "end": 6922.44,
      "start": 6919.64,
      "text": "还有你点出了房地产这个雷"
    },
    {
      "end": 6927.04,
      "start": 6922.44,
      "text": "然后你现在还要整疫苗真像"
    },
    {
      "end": 6929.34,
      "start": 6927.04,
      "text": "他说七哥你去想想他们有多恐惧你吧"
    },
    {
      "end": 6933.64,
      "start": 6929.34,
      "text": "他说我跑出来的原因他说我多活一天睡一天"
    },
    {
      "end": 6935.64,
      "start": 6933.64,
      "text": "他说我第一个就是跟你联系"
    },
    {
      "end": 6937.04,
      "start": 6935.64,
      "text": "我担心他们给我查出来"
    },
    {
      "end": 6942.24,
      "start": 6937.04,
      "text": "另外一个他说我在国内我已经了无牵挂"
    },
    {
      "end": 6944.04,
      "start": 6942.24,
      "text": "我得出来过两天好日子"
    },
    {
      "end": 6945.64,
      "start": 6944.04,
      "text": "能过几天过几天"
    },
    {
      "end": 6947.64,
      "start": 6945.64,
      "text": "兄弟姐妹们"
    },
    {
      "end": 6949.64,
      "start": 6947.64,
      "text": "你知道爆料革命对房地产"
    },
    {
      "end": 6952.64,
      "start": 6949.64,
      "text": "咱们讲房地产这件事情对国内影响多大吗"
    },
    {
      "end": 6956.24,
      "start": 6954.64,
      "text": "就咱这位战友说"
    },
    {
      "end": 6960.84,
      "start": 6957.44,
      "text": "他说七哥就相信了你的人卖掉房子"
    },
    {
      "end": 6964.84,
      "start": 6961.64,
      "text": "卖掉所有房地产的所谓的借款和票据的"
    },
    {
      "end": 6967.44,
      "start": 6965.24,
      "text": "他说七哥真的是百万都不值"
    },
    {
      "end": 6969.24,
      "start": 6968.24,
      "text": "接近千万人"
    },
    {
      "end": 6971.04,
      "start": 6969.74,
      "text": "这些人全得救了"
    },
    {
      "end": 6973.04,
      "start": 6972.04,
      "text": "要不然全完了"
    },
    {
      "end": 6976.24,
      "start": 6973.64,
      "text": "他说七哥你想想想你们影响力有多大"
    },
    {
      "end": 6979.04,
      "start": 6977.04,
      "text": "他说这些抓起来房地产上说"
    },
    {
      "end": 6982.24,
      "start": 6979.04,
      "text": "就因为郭文贵直播很多人就赶快把房子卖掉"
    },
    {
      "end": 6985.64,
      "start": 6982.84,
      "text": "还有参与房地产公司工作"
    },
    {
      "end": 6986.84,
      "start": 6985.64,
      "text": "像合成创产的"
    },
    {
      "end": 6988.04,
      "start": 6986.84,
      "text": "像那个融创啊"
    },
    {
      "end": 6990.64,
      "start": 6988.44,
      "text": "人家就是什么三年借款利息啊"
    },
    {
      "end": 6992.24,
      "start": 6990.64,
      "text": "到期35%回报点"
    },
    {
      "end": 6993.24,
      "start": 6992.24,
      "text": "我不要了"
    },
    {
      "end": 6994.24,
      "start": 6993.24,
      "text": "我把钱拿回来"
    },
    {
      "end": 6996.24,
      "start": 6994.44,
      "text": "我现在全都把钱做安全了"
    },
    {
      "end": 7000.04,
      "start": 6998.64,
      "text": "所以兄弟姐妹们"
    },
    {
      "end": 7002.04,
      "start": 7000.04,
      "text": "我们今天的所有的直播"
    },
    {
      "end": 7003.64,
      "start": 7002.04,
      "text": "每一秒钟都是救人的"
    },
    {
      "end": 7005.44,
      "start": 7004.44,
      "text": "我们经过历史"
    },
    {
      "end": 7006.24,
      "start": 7005.44,
      "text": "像Aiglas"
    },
    {
      "end": 7007.84,
      "start": 7006.44,
      "text": "2017年听了七哥爆料"
    },
    {
      "end": 7008.64,
      "start": 7007.84,
      "text": "他是个专业人士"
    },
    {
      "end": 7010.04,
      "start": 7008.64,
      "text": "我们俩数未认识啊"
    },
    {
      "end": 7011.64,
      "start": 7010.04,
      "text": "我们俩过去从来没联系过"
    },
    {
      "end": 7014.04,
      "start": 7011.84,
      "text": "连这个直播前两个都没有单独说过话"
    },
    {
      "end": 7014.84,
      "start": 7014.24,
      "text": "是吧"
    },
    {
      "end": 7017.24,
      "start": 7015.64,
      "text": "他知道七哥说的真是假的"
    },
    {
      "end": 7018.24,
      "start": 7017.24,
      "text": "是经过验证的"
    },
    {
      "end": 7020.04,
      "start": 7018.84,
      "text": "今天直播完"
    },
    {
      "end": 7022.04,
      "start": 7020.84,
      "text": "未来也会得到验证的"
    },
    {
      "end": 7024.24,
      "start": 7023.04,
      "text": "我想告诉大家今天"
    },
    {
      "end": 7025.44,
      "start": 7024.24,
      "text": "你们注意到了没有"
    },
    {
      "end": 7026.84,
      "start": 7025.44,
      "text": "共产党真的完蛋了"
    },
    {
      "end": 7028.44,
      "start": 7026.84,
      "text": "东地也有没有"
    },
    {
      "end": 7028.84,
      "start": 7028.44,
      "text": "飞飞"
    },
    {
      "end": 7030.84,
      "start": 7028.84,
      "text": "爱格拉斯"
    },
    {
      "end": 7031.84,
      "start": 7030.84,
      "text": "你想的吗"
    },
    {
      "end": 7032.84,
      "start": 7031.84,
      "text": "他真的完了"
    },
    {
      "end": 7035.84,
      "start": 7032.84,
      "text": "我不相信共产党能躲过房地产这一劫"
    },
    {
      "end": 7038.84,
      "start": 7035.84,
      "text": "我不相信他能躲过"
    },
    {
      "end": 7040.64,
      "start": 7038.84,
      "text": "习百分之八九十"
    },
    {
      "end": 7041.84,
      "start": 7040.64,
      "text": "他完全同意我这中纪委哥们"
    },
    {
      "end": 7042.84,
      "start": 7041.84,
      "text": "他说"
    },
    {
      "end": 7045.24,
      "start": 7042.84,
      "text": "我说七哥这也是我为什么跑出的原因"
    },
    {
      "end": 7046.24,
      "start": 7045.24,
      "text": "我跟习干了那么多脏活"
    },
    {
      "end": 7047.74,
      "start": 7047.24,
      "text": "啊"
    },
    {
      "end": 7049.24,
      "start": 7048.04,
      "text": "江家会把我干掉的"
    },
    {
      "end": 7052.24,
      "start": 7049.84,
      "text": "曾家和王岐山和孟会把我干掉的"
    },
    {
      "end": 7053.84,
      "start": 7053.24,
      "text": "他说我不跑"
    },
    {
      "end": 7055.24,
      "start": 7053.84,
      "text": "我一定把我弄死吧"
    },
    {
      "end": 7057.24,
      "start": 7056.24,
      "text": "他说我干嘛让他们零食我"
    },
    {
      "end": 7058.24,
      "start": 7057.24,
      "text": "我死死不了"
    },
    {
      "end": 7058.84,
      "start": 7058.24,
      "text": "活活不了的"
    },
    {
      "end": 7060.24,
      "start": 7059.84,
      "text": "他说另外一个"
    },
    {
      "end": 7060.84,
      "start": 7060.24,
      "text": "他说"
    },
    {
      "end": 7062.64,
      "start": 7060.84,
      "text": "他们一定会"
    },
    {
      "end": 7064.24,
      "start": 7063.04,
      "text": "两边掐完以后"
    },
    {
      "end": 7066.24,
      "start": 7064.84,
      "text": "习就是过了这个关"
    },
    {
      "end": 7067.24,
      "start": 7066.24,
      "text": "习也得做掉我"
    },
    {
      "end": 7068.84,
      "start": 7067.24,
      "text": "因为我干的太多脏活"
    },
    {
      "end": 7071.44,
      "start": 7070.44,
      "text": "所以我今天"
    },
    {
      "end": 7073.84,
      "start": 7072.04,
      "text": "东地和我一个共同的兄弟"
    },
    {
      "end": 7075.84,
      "start": 7074.64,
      "text": "找他的家人跟我说"
    },
    {
      "end": 7077.04,
      "start": 7075.84,
      "text": "你不要跟海东"
    },
    {
      "end": 7079.04,
      "start": 7077.04,
      "text": "海东不要谈我们名字"
    },
    {
      "end": 7079.64,
      "start": 7079.04,
      "text": "我说你放心"
    },
    {
      "end": 7080.64,
      "start": 7079.64,
      "text": "绝对不谈你名字"
    },
    {
      "end": 7082.84,
      "start": 7081.24,
      "text": "但是我跟国内的战友们"
    },
    {
      "end": 7085.44,
      "start": 7083.14,
      "text": "我要军队的体制内的"
    },
    {
      "end": 7086.64,
      "start": 7085.44,
      "text": "包括医疗界人士"
    },
    {
      "end": 7090.64,
      "start": 7087.84,
      "text": "如果你们能像图幽幽一样做人"
    },
    {
      "end": 7093.24,
      "start": 7091.84,
      "text": "你就是一个伟大的中国人"
    },
    {
      "end": 7098.64,
      "start": 7096.24,
      "text": "如果你能像中纪委这个哥们"
    },
    {
      "end": 7099.44,
      "start": 7098.64,
      "text": "能跑到日本"
    },
    {
      "end": 7100.44,
      "start": 7099.44,
      "text": "你是牛人"
    },
    {
      "end": 7101.84,
      "start": 7100.84,
      "text": "经历过黑暗"
    },
    {
      "end": 7103.64,
      "start": 7102.04,
      "text": "从地狱到天堂"
    },
    {
      "end": 7105.84,
      "start": 7104.24,
      "text": "我认为是神中之神"
    },
    {
      "end": 7107.44,
      "start": 7106.04,
      "text": "从人间到天堂"
    },
    {
      "end": 7108.24,
      "start": 7107.44,
      "text": "你是神"
    },
    {
      "end": 7110.94,
      "start": 7109.54,
      "text": "从地狱到天堂"
    },
    {
      "end": 7112.04,
      "start": 7110.94,
      "text": "你是神中之神"
    },
    {
      "end": 7113.24,
      "start": 7112.44,
      "text": "我就跟他说"
    },
    {
      "end": 7114.44,
      "start": 7113.24,
      "text": "我一辈子不白活"
    },
    {
      "end": 7116.64,
      "start": 7115.54,
      "text": "我保证你"
    },
    {
      "end": 7117.44,
      "start": 7116.74,
      "text": "日本"
    },
    {
      "end": 7119.04,
      "start": 7117.94,
      "text": "会全力保护你"
    },
    {
      "end": 7120.84,
      "start": 7119.04,
      "text": "第二天"
    },
    {
      "end": 7122.04,
      "start": 7120.84,
      "text": "日本政府就跟他谈话"
    },
    {
      "end": 7122.94,
      "start": 7122.04,
      "text": "说从现在起"
    },
    {
      "end": 7124.44,
      "start": 7122.94,
      "text": "你所有的行动安全"
    },
    {
      "end": 7125.44,
      "start": 7124.44,
      "text": "我们全部"
    },
    {
      "end": 7126.84,
      "start": 7125.44,
      "text": "国家紧密保"
    },
    {
      "end": 7127.44,
      "start": 7126.84,
      "text": "终生的"
    },
    {
      "end": 7131.14,
      "start": 7129.64,
      "text": "他也给日本也带去了料"
    },
    {
      "end": 7131.44,
      "start": 7131.14,
      "text": "是吧"
    },
    {
      "end": 7132.64,
      "start": 7131.44,
      "text": "不带料也不可能了"
    },
    {
      "end": 7136.84,
      "start": 7133.64,
      "text": "那么我想给体制内的所有的高官们"
    },
    {
      "end": 7137.44,
      "start": 7136.84,
      "text": "告诉大家"
    },
    {
      "end": 7139.24,
      "start": 7137.44,
      "text": "你比钟永康牛吗"
    },
    {
      "end": 7140.64,
      "start": 7139.24,
      "text": "你比薄熙来牛吗"
    },
    {
      "end": 7142.44,
      "start": 7140.84,
      "text": "你比习近平牛吗"
    },
    {
      "end": 7144.04,
      "start": 7142.64,
      "text": "你比江泽民牛吗"
    },
    {
      "end": 7145.64,
      "start": 7144.24,
      "text": "你爹是常委"
    },
    {
      "end": 7146.64,
      "start": 7145.64,
      "text": "你爹政治局"
    },
    {
      "end": 7148.24,
      "start": 7147.24,
      "text": "你比江志成"
    },
    {
      "end": 7149.84,
      "start": 7148.24,
      "text": "人有个皇帝的爷爷"
    },
    {
      "end": 7150.84,
      "start": 7149.84,
      "text": "你比他牛吗"
    },
    {
      "end": 7154.34,
      "start": 7152.24,
      "text": "你比孙立军牛吗"
    },
    {
      "end": 7155.44,
      "start": 7154.54,
      "text": "你比孟建柱"
    },
    {
      "end": 7156.64,
      "start": 7155.44,
      "text": "王岐山牛吗"
    },
    {
      "end": 7158.44,
      "start": 7156.64,
      "text": "他说"
    },
    {
      "end": 7160.24,
      "start": 7158.44,
      "text": "咱这位中纪委的哥们说"
    },
    {
      "end": 7161.24,
      "start": 7160.24,
      "text": "他妻子"
    },
    {
      "end": 7163.34,
      "start": 7161.94,
      "text": "到香港去执行任务"
    },
    {
      "end": 7164.14,
      "start": 7163.34,
      "text": "回来以后"
    },
    {
      "end": 7165.14,
      "start": 7164.14,
      "text": "他妻子回了家"
    },
    {
      "end": 7166.14,
      "start": 7165.14,
      "text": "一星期不出门"
    },
    {
      "end": 7167.84,
      "start": 7166.74,
      "text": "不刷牙不洗脸"
    },
    {
      "end": 7168.74,
      "start": 7167.84,
      "text": "啥也不说话"
    },
    {
      "end": 7169.94,
      "start": 7168.94,
      "text": "就个得愈症一样"
    },
    {
      "end": 7173.54,
      "start": 7169.94,
      "text": "过了几天抱他就是哭"
    },
    {
      "end": 7174.74,
      "start": 7173.54,
      "text": "为什么"
    },
    {
      "end": 7176.54,
      "start": 7174.74,
      "text": "他说我看到了"
    },
    {
      "end": 7180.04,
      "start": 7176.54,
      "text": "在赤柱那些被鸡肩的男孩"
    },
    {
      "end": 7182.04,
      "start": 7180.04,
      "text": "被强奸和轮奸的女孩"
    },
    {
      "end": 7184.94,
      "start": 7182.04,
      "text": "还有派去这人那些魔鬼的一面"
    },
    {
      "end": 7187.04,
      "start": 7184.94,
      "text": "而且玩这些孩子"
    },
    {
      "end": 7187.94,
      "start": 7187.04,
      "text": "杀这些孩子"
    },
    {
      "end": 7190.34,
      "start": 7187.94,
      "text": "他说比我们在我们老家"
    },
    {
      "end": 7192.84,
      "start": 7190.34,
      "text": "他的妻子说我山东老乡老家"
    },
    {
      "end": 7197.04,
      "start": 7192.84,
      "text": "他说杀那个鸽子杀个鸟都残忍"
    },
    {
      "end": 7200.04,
      "start": 7197.04,
      "text": "他说这也是我"
    }
