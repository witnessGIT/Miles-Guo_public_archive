{
  "chunk_audio_sha256": "9819f4cebb0982f5cb814625af6b761fed41322040fb291cd00546e514f016be",
  "chunk_index": 10,
  "completed_at": "2026-10-20T15:10:59Z",
  "language": "zh",
  "live_id": "LIVE_20211017_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 9000,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 9002.6,
      "start": 9000.0,
      "text": "我用他说出来 因为他懂医学"
    },
    {
      "end": 9004.8,
      "start": 9002.6,
      "text": "这他说的很重要的"
    },
    {
      "end": 9008.3,
      "start": 9004.8,
      "text": "很多我就不能一念了 太多太多了"
    },
    {
      "end": 9010.3,
      "start": 9008.3,
      "text": "那么说到这儿说还有说的就是"
    },
    {
      "end": 9014.8,
      "start": 9010.3,
      "text": "今天让海东兄弟和招影妹妹好好抱抱体育界的料"
    },
    {
      "end": 9017.8,
      "start": 9014.8,
      "text": "这个也是让体制内的兄弟姐妹们"
    },
    {
      "end": 9021.5,
      "start": 9017.8,
      "text": "他说我知道海东他了解很多很多"
    },
    {
      "end": 9025.8,
      "start": 9021.5,
      "text": "那今天我这样国内的战友们知道你们都在深夜的看我们的直播"
    },
    {
      "end": 9028.7,
      "start": 9025.8,
      "text": "刚才大家都震了 都震了 都傻了"
    },
    {
      "end": 9030.4,
      "start": 9028.7,
      "text": "老领导也很感谢我们"
    },
    {
      "end": 9034.0,
      "start": 9030.4,
      "text": "我们是和中国共产党不一样的讲信用"
    },
    {
      "end": 9036.0,
      "start": 9034.0,
      "text": "我说过今天不说你名字"
    },
    {
      "end": 9039.7,
      "start": 9036.0,
      "text": "我就不会让海东兄弟说你名字 我也不会说你名字"
    },
    {
      "end": 9042.0,
      "start": 9039.7,
      "text": "而且我们永远不会说你名字"
    },
    {
      "end": 9044.5,
      "start": 9042.0,
      "text": "除非你在作恶的情况下"
    },
    {
      "end": 9047.8,
      "start": 9044.5,
      "text": "你在伤害中国老百姓是不可以的"
    },
    {
      "end": 9053.6,
      "start": 9047.8,
      "text": "那么刚才我也提到了现在这个房地产还有金融界的崩塌"
    },
    {
      "end": 9055.6,
      "start": 9053.6,
      "text": "对整个咱救了很多人"
    },
    {
      "end": 9058.4,
      "start": 9055.6,
      "text": "然后再谈一下疫苗的问题"
    },
    {
      "end": 9063.7,
      "start": 9058.4,
      "text": "东京你看这也是我这几天 特别是咱这个江西跑出来的哥们"
    },
    {
      "end": 9066.7,
      "start": 9063.7,
      "text": "江西的老表曾庆红老家的跑出来的哥们"
    },
    {
      "end": 9069.9,
      "start": 9066.7,
      "text": "他说的非常直接的一句话"
    },
    {
      "end": 9071.8,
      "start": 9069.9,
      "text": "他说七哥你去想想"
    },
    {
      "end": 9078.1,
      "start": 9071.8,
      "text": "我小姨子就做这个卖假疫苗的三十块钱一张纸"
    },
    {
      "end": 9082.6,
      "start": 9078.1,
      "text": "他说我小姨子现在手里边有个六七百万现金"
    },
    {
      "end": 9088.6,
      "start": 9082.6,
      "text": "你想三十块钱积攒的六七百万现金啊都是每张都是现金"
    },
    {
      "end": 9093.9,
      "start": 9088.6,
      "text": "他说现在看来他可能医生做了最好的事"
    },
    {
      "end": 9096.9,
      "start": 9093.9,
      "text": "我小姨子就是卖了这些假的大疫苗的这个东西"
    },
    {
      "end": 9101.2,
      "start": 9096.9,
      "text": "另外一个他就讲他说你知道疫苗有多可怕"
    },
    {
      "end": 9102.2,
      "start": 9101.2,
      "text": "大家一定要记住"
    },
    {
      "end": 9105.2,
      "start": 9102.2,
      "text": "疫苗有五十什么含量的"
    },
    {
      "end": 9108.2,
      "start": 9105.2,
      "text": "有一百含量的二百五十含量的不同的含量的东西"
    },
    {
      "end": 9111.2,
      "start": 9108.2,
      "text": "他说你知道郭宝昌这个王八蛋他说"
    },
    {
      "end": 9119.5,
      "start": 9111.2,
      "text": "他给所有的所有的家人全是高含量的这个所谓的疫苗"
    },
    {
      "end": 9123.0,
      "start": 9119.5,
      "text": "说明什么问题郭宝昌认为这个疫苗是管用的"
    },
    {
      "end": 9127.0,
      "start": 9123.0,
      "text": "哎 Alex 你要想这个问题很有意思啊"
    },
    {
      "end": 9131.2,
      "start": 9127.0,
      "text": "造这个药的郭宝昌科兴啊复兴科技"
    },
    {
      "end": 9134.0,
      "start": 9131.2,
      "text": "他认为这个给我家人多用是管用的"
    },
    {
      "end": 9138.0,
      "start": 9134.0,
      "text": "所以多用了他都用二百五十的含量的"
    },
    {
      "end": 9141.3,
      "start": 9138.0,
      "text": "纯度的一家打三斤每人都打"
    },
    {
      "end": 9146.3,
      "start": 9141.3,
      "text": "他给那些所谓的着急要买的都是假的"
    },
    {
      "end": 9148.3,
      "start": 9146.3,
      "text": "低含量的五十的甚至是没有的"
    },
    {
      "end": 9150.8,
      "start": 9148.3,
      "text": "这个世界上就这么荒唐"
    },
    {
      "end": 9155.3,
      "start": 9150.8,
      "text": "可能真的就郭宝昌这帮科兴就把王八蛋家人找死"
    },
    {
      "end": 9156.8,
      "start": 9155.3,
      "text": "你知道吗大愿他们不死啊"
    },
    {
      "end": 9158.3,
      "start": 9156.8,
      "text": "这就是报应啊"
    },
    {
      "end": 9162.3,
      "start": 9158.3,
      "text": "他说接下来你知道我好在哪的时候"
    },
    {
      "end": 9164.8,
      "start": 9162.3,
      "text": "我傻乎我打了一个高纯度的"
    },
    {
      "end": 9167.8,
      "start": 9164.8,
      "text": "后来你这一直播他说我再也不敢打了"
    },
    {
      "end": 9170.1,
      "start": 9167.8,
      "text": "我告诉所有人别打了"
    },
    {
      "end": 9175.6,
      "start": 9170.1,
      "text": "疫苗这个灾难到今天兄弟姐妹们"
    },
    {
      "end": 9177.1,
      "start": 9175.6,
      "text": "我在前天的时候"
    },
    {
      "end": 9183.1,
      "start": 9177.1,
      "text": "一位我最尊重人之一打了四针"
    },
    {
      "end": 9187.6,
      "start": 9183.1,
      "text": "我说你作为犹太人怎么可以打四针呢"
    },
    {
      "end": 9189.1,
      "start": 9187.6,
      "text": "他说我怕死啊"
    },
    {
      "end": 9192.1,
      "start": 9189.1,
      "text": "而且一开始有我就打了"
    },
    {
      "end": 9194.4,
      "start": 9192.1,
      "text": "你们一定要相信我说一句话"
    },
    {
      "end": 9199.9,
      "start": 9194.4,
      "text": "包括那些砸我脑袋的我们现在盖特的主席"
    },
    {
      "end": 9201.9,
      "start": 9199.9,
      "text": "他说我要相信科学嘛"
    },
    {
      "end": 9203.9,
      "start": 9201.9,
      "text": "我是雷神的这个总监"
    },
    {
      "end": 9204.9,
      "start": 9203.9,
      "text": "我要相信科学"
    },
    {
      "end": 9206.4,
      "start": 9204.9,
      "text": "不相信他"
    },
    {
      "end": 9207.4,
      "start": 9206.4,
      "text": "他怕死了"
    },
    {
      "end": 9215.2,
      "start": 9207.4,
      "text": "那么咱们爆料革命在全世界掀起的这场"
    },
    {
      "end": 9217.2,
      "start": 9215.2,
      "text": "疫苗反疫苗的运动"
    },
    {
      "end": 9220.7,
      "start": 9217.2,
      "text": "现在无论是法国最保守的法国"
    },
    {
      "end": 9222.2,
      "start": 9220.7,
      "text": "还是以色列"
    },
    {
      "end": 9227.0,
      "start": 9222.2,
      "text": "还包括现在就是格兰高地的以色列军人"
    },
    {
      "end": 9228.5,
      "start": 9227.0,
      "text": "都在看我们直播"
    },
    {
      "end": 9231.0,
      "start": 9228.5,
      "text": "包括保守的德国"
    },
    {
      "end": 9232.5,
      "start": 9231.0,
      "text": "俄罗斯"
    },
    {
      "end": 9234.5,
      "start": 9232.5,
      "text": "日本就不用提了"
    },
    {
      "end": 9236.5,
      "start": 9234.5,
      "text": "我可以告诉负责任大家说"
    },
    {
      "end": 9239.0,
      "start": 9236.5,
      "text": "人类上最大的贡献的就是我们"
    },
    {
      "end": 9242.7,
      "start": 9239.0,
      "text": "你看艾勒克斯当一生他那么执着"
    },
    {
      "end": 9245.0,
      "start": 9242.7,
      "text": "他绝对意识不到这个爆料革命的"
    },
    {
      "end": 9247.5,
      "start": 9245.0,
      "text": "这次反疫苗对人类影响有多大"
    },
    {
      "end": 9250.8,
      "start": 9247.5,
      "text": "这个犹太哥们打了四针的吓到说"
    },
    {
      "end": 9254.5,
      "start": 9250.8,
      "text": "迈奥斯你知道我已经俩这吃了三天青蚝素"
    },
    {
      "end": 9255.8,
      "start": 9254.5,
      "text": "加一味菌素了"
    },
    {
      "end": 9258.2,
      "start": 9257.3,
      "text": "他有拉肚子"
    },
    {
      "end": 9259.2,
      "start": 9258.2,
      "text": "他吃完拉肚子"
    },
    {
      "end": 9260.7,
      "start": 9259.2,
      "text": "我说你拉的东西是啥"
    },
    {
      "end": 9262.3,
      "start": 9260.7,
      "text": "他拉的全身的白沫沫"
    },
    {
      "end": 9265.0,
      "start": 9263.2,
      "text": "我说那这白沫沫那么好就是毒啊"
    },
    {
      "end": 9266.3,
      "start": 9265.0,
      "text": "我说啥拉白沫沫"
    },
    {
      "end": 9268.3,
      "start": 9266.3,
      "text": "我说你平常拉的都是白屎吗"
    },
    {
      "end": 9269.6,
      "start": 9268.3,
      "text": "他拉的都是黄屎"
    },
    {
      "end": 9271.7,
      "start": 9269.6,
      "text": "他说现在我拉的是白沫沫"
    },
    {
      "end": 9273.5,
      "start": 9271.7,
      "text": "我说可能是好事你找医生去"
    },
    {
      "end": 9275.5,
      "start": 9273.5,
      "text": "说到这我要再给大家提醒一遍"
    },
    {
      "end": 9278.8,
      "start": 9275.5,
      "text": "任何战友不要给战友提供是药单"
    },
    {
      "end": 9280.5,
      "start": 9278.8,
      "text": "药方你绝对不可以的"
    },
    {
      "end": 9281.3,
      "start": 9280.5,
      "text": "后果自负"
    },
    {
      "end": 9283.1,
      "start": 9281.3,
      "text": "还有任何人吃药"
    },
    {
      "end": 9284.8,
      "start": 9283.1,
      "text": "你不问一生你千万别吃"
    },
    {
      "end": 9286.7,
      "start": 9284.8,
      "text": "没有一种要适合各种性格"
    },
    {
      "end": 9288.5,
      "start": 9286.7,
      "text": "就像这位犹太的朋友"
    },
    {
      "end": 9289.7,
      "start": 9288.5,
      "text": "他吃完拉白沫"
    },
    {
      "end": 9291.4,
      "start": 9289.7,
      "text": "但是他感觉到轻松"
    },
    {
      "end": 9293.7,
      "start": 9291.4,
      "text": "他头两天是胳膊麻腿麻"
    },
    {
      "end": 9296.4,
      "start": 9293.7,
      "text": "而且突然间睡觉就醒"
    },
    {
      "end": 9298.7,
      "start": 9296.4,
      "text": "觉得这个眼睛花"
    },
    {
      "end": 9301.1,
      "start": 9298.7,
      "text": "我说那你就是快死的这个征兆吗"
    },
    {
      "end": 9302.6,
      "start": 9301.1,
      "text": "现在他吃了以后拉白沫"
    },
    {
      "end": 9303.8,
      "start": 9302.6,
      "text": "他觉得轻松多了"
    },
    {
      "end": 9306.4,
      "start": 9303.8,
      "text": "我说这个例子告诉大家"
    },
    {
      "end": 9309.6,
      "start": 9306.4,
      "text": "我们这个反疫苗影响"
    },
    {
      "end": 9311.2,
      "start": 9309.6,
      "text": "他不分族群"
    },
    {
      "end": 9312.2,
      "start": 9311.2,
      "text": "不分宗教"
    },
    {
      "end": 9313.4,
      "start": 9312.2,
      "text": "不分国界"
    },
    {
      "end": 9315.0,
      "start": 9313.4,
      "text": "但是"
    },
    {
      "end": 9315.8,
      "start": 9315.0,
      "text": "他不"
    },
    {
      "end": 9318.1,
      "start": 9315.8,
      "text": "我们不能保证我们都是正确的"
    },
    {
      "end": 9319.1,
      "start": 9318.1,
      "text": "就像这位战友说了"
    },
    {
      "end": 9321.1,
      "start": 9319.1,
      "text": "这癌症谁要了"
    },
    {
      "end": 9323.7,
      "start": 9321.1,
      "text": "胃加锤吃了几小时都拉下来了"
    },
    {
      "end": 9324.7,
      "start": 9323.7,
      "text": "是不是"
    },
    {
      "end": 9326.9,
      "start": 9324.7,
      "text": "而且这个例子多的不能再多了"
    },
    {
      "end": 9328.5,
      "start": 9326.9,
      "text": "我们这我多了去了"
    },
    {
      "end": 9330.5,
      "start": 9328.5,
      "text": "我不能保证这是真是假的"
    },
    {
      "end": 9332.5,
      "start": 9330.5,
      "text": "但是我这是我收到的信息"
    },
    {
      "end": 9335.5,
      "start": 9332.5,
      "text": "就像刚才孟杰老领导的说"
    },
    {
      "end": 9337.9,
      "start": 9335.5,
      "text": "胃切除手术完全靠型号宿"
    },
    {
      "end": 9341.5,
      "start": 9337.9,
      "text": "那么刚才还有给我说"
    },
    {
      "end": 9343.3,
      "start": 9341.5,
      "text": "他说那个海东刚才讲的那段"
    },
    {
      "end": 9345.3,
      "start": 9343.3,
      "text": "这个国内癌症的50%"
    },
    {
      "end": 9347.3,
      "start": 9345.3,
      "text": "他说那就是骗人的"
    },
    {
      "end": 9348.3,
      "start": 9347.3,
      "text": "觉得郝海东有钱"
    },
    {
      "end": 9350.5,
      "start": 9348.3,
      "text": "他说郝海东他老婆嘛"
    },
    {
      "end": 9351.5,
      "start": 9350.5,
      "text": "郝海东有钱呢"
    },
    {
      "end": 9353.2,
      "start": 9351.5,
      "text": "他说没癌症他给你整出癌症"
    },
    {
      "end": 9353.5,
      "start": 9353.2,
      "text": "他又说嘛"
    },
    {
      "end": 9355.5,
      "start": 9353.5,
      "text": "他说现在还转不来弯"
    },
    {
      "end": 9356.7,
      "start": 9355.5,
      "text": "刚才老领导跟我说"
    },
    {
      "end": 9358.3,
      "start": 9356.7,
      "text": "我说我一会告诉海东"
    },
    {
      "end": 9359.3,
      "start": 9358.3,
      "text": "我一会跟他说"
    },
    {
      "end": 9360.7,
      "start": 9359.3,
      "text": "他说他不是郝海东"
    },
    {
      "end": 9361.9,
      "start": 9360.7,
      "text": "老婆就没癌症了"
    },
    {
      "end": 9363.3,
      "start": 9361.9,
      "text": "他一看郝海东来了"
    },
    {
      "end": 9365.5,
      "start": 9363.3,
      "text": "你能有钱踢一球多少钱"
    },
    {
      "end": 9367.1,
      "start": 9365.5,
      "text": "他都以为郝海东是一般富翁的"
    },
    {
      "end": 9368.1,
      "start": 9367.1,
      "text": "必须有癌症啊"
    },
    {
      "end": 9369.9,
      "start": 9368.1,
      "text": "我老领导你真是太坏了"
    },
    {
      "end": 9370.9,
      "start": 9369.9,
      "text": "太了解共产党了"
    },
    {
      "end": 9374.5,
      "start": 9370.9,
      "text": "所以说海东回去给嫂子打电话吧"
    },
    {
      "end": 9375.5,
      "start": 9374.5,
      "text": "抱歉了"
    },
    {
      "end": 9378.3,
      "start": 9375.5,
      "text": "当年因为我把你整成癌症了"
    },
    {
      "end": 9379.9,
      "start": 9378.3,
      "text": "刚才找到答案了"
    },
    {
      "end": 9382.1,
      "start": 9379.9,
      "text": "所以说兄弟姐妹们"
    },
    {
      "end": 9385.3,
      "start": 9382.1,
      "text": "疫苗这件事情大到什么程度"
    },
    {
      "end": 9389.3,
      "start": 9385.3,
      "text": "房地产的危机大到什么程度"
    },
    {
      "end": 9394.3,
      "start": 9389.3,
      "text": "共产党的私有企业国有化什么收场"
    },
    {
      "end": 9399.1,
      "start": 9394.3,
      "text": "中国金融的崩溃谁能挽救"
    },
    {
      "end": 9404.3,
      "start": 9399.1,
      "text": "上海江派江王增珠"
    },
    {
      "end": 9407.3,
      "start": 9404.3,
      "text": "梦的势力PK席"
    },
    {
      "end": 9408.9,
      "start": 9407.3,
      "text": "谁能先收手"
    },
    {
      "end": 9409.7,
      "start": 9408.9,
      "text": "给打架似的"
    },
    {
      "end": 9411.3,
      "start": 9409.7,
      "text": "咱俩停不打了啊"
    },
    {
      "end": 9412.8,
      "start": 9411.3,
      "text": "把我最后来一把"
    },
    {
      "end": 9413.7,
      "start": 9412.8,
      "text": "然后光一刀"
    },
    {
      "end": 9415.3,
      "start": 9413.7,
      "text": "谁到最后能遵守"
    },
    {
      "end": 9416.2,
      "start": 9415.3,
      "text": "觉得能听手"
    },
    {
      "end": 9418.2,
      "start": 9416.2,
      "text": "他不停是什么"
    },
    {
      "end": 9420.5,
      "start": 9418.2,
      "text": "我跟你们说实在话"
    },
    {
      "end": 9422.0,
      "start": 9420.5,
      "text": "我不愿看到这个"
    },
    {
      "end": 9424.2,
      "start": 9422.0,
      "text": "现在他们两个打仗"
    },
    {
      "end": 9425.6,
      "start": 9424.2,
      "text": "把这些企业家祸害这样"
    },
    {
      "end": 9428.2,
      "start": 9425.6,
      "text": "祸害都是老百姓"
    },
    {
      "end": 9430.5,
      "start": 9428.2,
      "text": "而且爆料革命不希望"
    },
    {
      "end": 9433.0,
      "start": 9430.5,
      "text": "最不愿看到的是"
    },
    {
      "end": 9434.8,
      "start": 9433.0,
      "text": "发生五胡乱华"
    },
    {
      "end": 9437.7,
      "start": 9434.8,
      "text": "从西进到最后"
    },
    {
      "end": 9439.7,
      "start": 9437.7,
      "text": "整个中华民族80%"
    },
    {
      "end": 9441.3,
      "start": 9439.7,
      "text": "他是汉人被杀掉了被吃了"
    },
    {
      "end": 9442.2,
      "start": 9441.3,
      "text": "两脚羊"
    },
    {
      "end": 9445.7,
      "start": 9443.4,
      "text": "我们不希望再军阀格局"
    },
    {
      "end": 9448.7,
      "start": 9446.9,
      "text": "我们现在说到这儿的时候"
    },
    {
      "end": 9450.4,
      "start": 9448.7,
      "text": "再说到香港四大家族"
    },
    {
      "end": 9454.7,
      "start": 9451.4,
      "text": "这军纪委哥们把我这是个震撼东西啊"
    },
    {
      "end": 9456.3,
      "start": 9454.7,
      "text": "你们想一想啊"
    },
    {
      "end": 9457.7,
      "start": 9456.3,
      "text": "他说七哥你说"
    },
    {
      "end": 9459.2,
      "start": 9457.7,
      "text": "你知道四大家族吗"
    },
    {
      "end": 9462.2,
      "start": 9459.2,
      "text": "一模一样的政策"
    },
    {
      "end": 9463.3,
      "start": 9462.2,
      "text": "跟他们谈话"
    },
    {
      "end": 9464.9,
      "start": 9463.3,
      "text": "你可以跑英国"
    },
    {
      "end": 9465.7,
      "start": 9464.9,
      "text": "你可以都跑"
    },
    {
      "end": 9467.7,
      "start": 9465.7,
      "text": "跑哪都把你抓回来"
    },
    {
      "end": 9470.8,
      "start": 9467.7,
      "text": "把所有你手里的地给我还回来"
    },
    {
      "end": 9473.4,
      "start": 9470.8,
      "text": "在大陆挣的钱给我拿过来"
    },
    {
      "end": 9475.8,
      "start": 9474.8,
      "text": "保你不死"
    },
    {
      "end": 9480.8,
      "start": 9477.8,
      "text": "东西这还真是我超出我想象了"
    },
    {
      "end": 9481.0,
      "start": 9480.8,
      "text": "这个"
    },
    {
      "end": 9484.4,
      "start": 9482.0,
      "text": "你因为你叫四大家族"
    },
    {
      "end": 9485.8,
      "start": 9484.4,
      "text": "四大不要脸"
    },
    {
      "end": 9487.0,
      "start": 9485.8,
      "text": "房地产律师"
    },
    {
      "end": 9487.4,
      "start": 9487.0,
      "text": "是不是"
    },
    {
      "end": 9488.2,
      "start": 9487.4,
      "text": "明星"
    },
    {
      "end": 9489.8,
      "start": 9488.2,
      "text": "还有玩金融的人"
    },
    {
      "end": 9491.8,
      "start": 9489.8,
      "text": "包括那黑车辉杨寿成"
    },
    {
      "end": 9492.2,
      "start": 9491.8,
      "text": "是吧"
    },
    {
      "end": 9494.2,
      "start": 9492.2,
      "text": "天天找处女那个玩明星那个"
    },
    {
      "end": 9498.0,
      "start": 9495.4,
      "text": "我才给我送过好多小姑娘"
    },
    {
      "end": 9499.4,
      "start": 9498.0,
      "text": "我都挖了好多的明星"
    },
    {
      "end": 9500.9,
      "start": 9499.4,
      "text": "睡醒以后发现"
    },
    {
      "end": 9502.4,
      "start": 9500.9,
      "text": "第二天知道人家是明星"
    },
    {
      "end": 9504.4,
      "start": 9502.4,
      "text": "都给我行回过好多次"
    },
    {
      "end": 9507.4,
      "start": 9505.4,
      "text": "说所有人都把钱都得拿回来"
    },
    {
      "end": 9510.9,
      "start": 9509.4,
      "text": "国内的家人抓起来"
    },
    {
      "end": 9512.4,
      "start": 9510.9,
      "text": "香港的家人说你出不了境"
    },
    {
      "end": 9513.9,
      "start": 9512.9,
      "text": "你跑跑试试"
    },
    {
      "end": 9515.4,
      "start": 9513.9,
      "text": "你跑跑走有哪都把你抓回来"
    },
    {
      "end": 9517.4,
      "start": 9516.4,
      "text": "而且最可怕的事情"
    },
    {
      "end": 9518.4,
      "start": 9517.4,
      "text": "这些人也不敢来美国"
    },
    {
      "end": 9521.6,
      "start": 9520.4,
      "text": "你去想想四大家族"
    },
    {
      "end": 9522.7,
      "start": 9521.6,
      "text": "很多人不敢来美国的"
    },
    {
      "end": 9523.4,
      "start": 9522.7,
      "text": "黑道"
    },
    {
      "end": 9524.4,
      "start": 9523.4,
      "text": "房地产商"
    },
    {
      "end": 9526.4,
      "start": 9524.4,
      "text": "因为在美国这个税是很高的"
    },
    {
      "end": 9529.4,
      "start": 9526.4,
      "text": "这也是日本地产涨的原因"
    },
    {
      "end": 9531.4,
      "start": 9529.4,
      "text": "但是你们想到了吗"
    },
    {
      "end": 9532.4,
      "start": 9531.4,
      "text": "你像飞飞呀"
    },
    {
      "end": 9533.4,
      "start": 9532.4,
      "text": "赵颖妹妹"
    },
    {
      "end": 9534.4,
      "start": 9533.4,
      "text": "艾格斯"
    },
    {
      "end": 9535.4,
      "start": 9534.4,
      "text": "你们是一个女孩子"
    },
    {
      "end": 9536.4,
      "start": 9535.4,
      "text": "没有概念"
    },
    {
      "end": 9538.4,
      "start": 9536.4,
      "text": "香港四大不要脸是多大的经济量"
    },
    {
      "end": 9539.4,
      "start": 9538.4,
      "text": "多大的产量"
    },
    {
      "end": 9540.4,
      "start": 9539.4,
      "text": "多大的能力"
    },
    {
      "end": 9541.4,
      "start": 9540.4,
      "text": "哎"
    },
    {
      "end": 9542.4,
      "start": 9541.4,
      "text": "习"
    },
    {
      "end": 9544.4,
      "start": 9542.4,
      "text": "就敢做出这样的决定"
    },
    {
      "end": 9546.4,
      "start": 9544.4,
      "text": "把你这一百年的钱全给我吐出来"
    },
    {
      "end": 9550.4,
      "start": 9546.4,
      "text": "而且香港四大不要脸还真的这么做"
    },
    {
      "end": 9552.4,
      "start": 9550.4,
      "text": "东地青藤兄弟啊"
    },
    {
      "end": 9556.4,
      "start": 9552.4,
      "text": "你俩要是香港四大不要脸的一部分"
    },
    {
      "end": 9558.4,
      "start": 9556.4,
      "text": "你觉得你能吞下这口气吗"
    },
    {
      "end": 9560.4,
      "start": 9558.4,
      "text": "老子游泳"
    },
    {
      "end": 9561.4,
      "start": 9560.4,
      "text": "顶着西瓜皮"
    },
    {
      "end": 9562.4,
      "start": 9561.4,
      "text": "跑到这儿来了"
    },
    {
      "end": 9563.4,
      "start": 9562.4,
      "text": "我爷爷"
    },
    {
      "end": 9564.4,
      "start": 9563.4,
      "text": "我爹来的"
    },
    {
      "end": 9565.4,
      "start": 9564.4,
      "text": "现在你把我们家东西全拿走"
    },
    {
      "end": 9567.4,
      "start": 9565.4,
      "text": "哎"
    },
    {
      "end": 9568.4,
      "start": 9567.4,
      "text": "他们就在干"
    },
    {
      "end": 9569.4,
      "start": 9568.4,
      "text": "现在到香港三周的困人厅"
    },
    {
      "end": 9571.4,
      "start": 9569.4,
      "text": "你回香港三周隔离"
    },
    {
      "end": 9576.4,
      "start": 9571.4,
      "text": "这就是让你不随便进不随便出"
    },
    {
      "end": 9579.4,
      "start": 9576.4,
      "text": "在隔离期杀死谁都有最好的办法"
    },
    {
      "end": 9581.4,
      "start": 9579.4,
      "text": "灌状病毒死亡"
    },
    {
      "end": 9582.4,
      "start": 9581.4,
      "text": "是吧"
    },
    {
      "end": 9584.4,
      "start": 9582.4,
      "text": "这就合法杀人"
    },
    {
      "end": 9585.4,
      "start": 9584.4,
      "text": "大家记住啊"
    },
    {
      "end": 9587.4,
      "start": 9585.4,
      "text": "我今天不能说具体名字"
    },
    {
      "end": 9588.4,
      "start": 9587.4,
      "text": "这几个人都是我好朋友啊"
    },
    {
      "end": 9589.4,
      "start": 9588.4,
      "text": "没有上过床啊"
    },
    {
      "end": 9590.4,
      "start": 9589.4,
      "text": "这绝对的"
    },
    {
      "end": 9592.4,
      "start": 9590.4,
      "text": "最起码十几个国内的明星"
    },
    {
      "end": 9594.4,
      "start": 9592.4,
      "text": "在一年以内没有出来过"
    },
    {
      "end": 9596.4,
      "start": 9594.4,
      "text": "回大陆了都被鞭空了"
    },
    {
      "end": 9597.4,
      "start": 9596.4,
      "text": "孙力军"
    },
    {
      "end": 9602.4,
      "start": 9597.4,
      "text": "孙力军进去交代了第一个人"
    },
    {
      "end": 9604.4,
      "start": 9602.4,
      "text": "赵薇黄云龙"
    },
    {
      "end": 9607.4,
      "start": 9604.4,
      "text": "黄云龙现在在法国的农场"
    },
    {
      "end": 9610.4,
      "start": 9607.4,
      "text": "中纪委这哥们跟我说"
    },
    {
      "end": 9612.4,
      "start": 9610.4,
      "text": "黄什么龙"
    },
    {
      "end": 9614.4,
      "start": 9612.4,
      "text": "黄有龙"
    },
    {
      "end": 9616.4,
      "start": 9614.4,
      "text": "黄守龙是吧"
    },
    {
      "end": 9617.4,
      "start": 9616.4,
      "text": "有"
    },
    {
      "end": 9618.4,
      "start": 9617.4,
      "text": "黄有龙是吧"
    },
    {
      "end": 9619.4,
      "start": 9618.4,
      "text": "管他管他"
    },
    {
      "end": 9621.4,
      "start": 9619.4,
      "text": "现在龙不龙虫都不重要了"
    },
    {
      "end": 9622.4,
      "start": 9621.4,
      "text": "赵薇老公"
    },
    {
      "end": 9624.4,
      "start": 9622.4,
      "text": "所以说这挺惨的"
    },
    {
      "end": 9625.4,
      "start": 9624.4,
      "text": "这吃女人饭的"
    },
    {
      "end": 9628.4,
      "start": 9625.4,
      "text": "所以说这个中纪委跟他们告诉我"
    },
    {
      "end": 9629.4,
      "start": 9628.4,
      "text": "他说你看着啊"
    },
    {
      "end": 9632.4,
      "start": 9629.4,
      "text": "这个很快就把这个黄有龙给弄回去"
    },
    {
      "end": 9635.4,
      "start": 9633.4,
      "text": "他说绝对装回去"
    },
    {
      "end": 9636.4,
      "start": 9635.4,
      "text": "都已经早给他安排好了"
    },
    {
      "end": 9639.4,
      "start": 9637.4,
      "text": "孙力军第一个交代了他"
    },
    {
      "end": 9641.4,
      "start": 9639.4,
      "text": "交代他就针对马云去的"
    },
    {
      "end": 9643.4,
      "start": 9641.4,
      "text": "对马云的21个高管去的"
    },
    {
      "end": 9648.4,
      "start": 9645.4,
      "text": "他说这小子买过的每块表"
    },
    {
      "end": 9649.4,
      "start": 9648.4,
      "text": "他买的表"
    },
    {
      "end": 9651.4,
      "start": 9649.4,
      "text": "买的车"
    },
    {
      "end": 9654.4,
      "start": 9651.4,
      "text": "他所有收藏的酒花的钱"
    },
    {
      "end": 9655.4,
      "start": 9654.4,
      "text": "所有带吃东西"
    },
    {
      "end": 9657.4,
      "start": 9655.4,
      "text": "他一分不差都要给你好了"
    },
    {
      "end": 9660.4,
      "start": 9658.4,
      "text": "他说小燕他算啥呀他说"
    },
    {
      "end": 9661.4,
      "start": 9660.4,
      "text": "他就是个证人"
    },
    {
      "end": 9662.4,
      "start": 9661.4,
      "text": "他说在法国弄"
    },
    {
      "end": 9663.4,
      "start": 9662.4,
      "text": "你记住我话今天啊"
    },
    {
      "end": 9664.4,
      "start": 9663.4,
      "text": "黄有龙要弄回去"
    },
    {
      "end": 9665.4,
      "start": 9664.4,
      "text": "很快"
    },
    {
      "end": 9666.4,
      "start": 9665.4,
      "text": "很快就把他弄回去"
    },
    {
      "end": 9670.4,
      "start": 9666.4,
      "text": "他说这时候放养钓鱼呢"
    },
    {
      "end": 9674.4,
      "start": 9670.4,
      "text": "然后说香港的这些明星在大陆现在都不给香港"
    },
    {
      "end": 9676.4,
      "start": 9674.4,
      "text": "说你看我这大陆陪我爸爸妈妈呢"
    },
    {
      "end": 9678.4,
      "start": 9676.4,
      "text": "我不能回香港啊还得关定"
    },
    {
      "end": 9679.4,
      "start": 9678.4,
      "text": "实际上是被编控啊"
    },
    {
      "end": 9684.4,
      "start": 9679.4,
      "text": "这就这些人交代跟着大陆睡觉的这些历史啊"
    },
    {
      "end": 9685.4,
      "start": 9684.4,
      "text": "他跟我讲了讲"
    },
    {
      "end": 9687.4,
      "start": 9685.4,
      "text": "他说七个你就当笑话听听吧"
    },
    {
      "end": 9688.4,
      "start": 9687.4,
      "text": "我真恶心死我了"
    },
    {
      "end": 9690.4,
      "start": 9688.4,
      "text": "因为这些人我都认识"
    },
    {
      "end": 9693.4,
      "start": 9691.4,
      "text": "就这些人你像那谭永林"
    },
    {
      "end": 9695.4,
      "start": 9693.4,
      "text": "还有那个叫什么"
    },
    {
      "end": 9697.4,
      "start": 9695.4,
      "text": "那个小车子那个家伙"
    },
    {
      "end": 9698.4,
      "start": 9697.4,
      "text": "这些家伙"
    },
    {
      "end": 9699.4,
      "start": 9698.4,
      "text": "这些成天的还有什么"
    },
    {
      "end": 9701.4,
      "start": 9699.4,
      "text": "这曾什么曾志伟啊"
    },
    {
      "end": 9704.4,
      "start": 9701.4,
      "text": "他说这个王八蛋所有的都是"
    },
    {
      "end": 9706.4,
      "start": 9704.4,
      "text": "他说就是拿着视频给他一放"
    },
    {
      "end": 9708.4,
      "start": 9706.4,
      "text": "玩变态"
    },
    {
      "end": 9710.4,
      "start": 9708.4,
      "text": "给女孩儿玩虚拖"
