    },
    {
      "end": 2597.4,
      "start": 2595.4,
      "text": "我们通过七哥通过爆料革命"
    },
    {
      "end": 2599.4,
      "start": 2597.4,
      "text": "制造了青蒿素啊"
    },
    {
      "end": 2600.4,
      "start": 2599.4,
      "text": "对于我来讲"
    },
    {
      "end": 2602.4,
      "start": 2600.4,
      "text": "就是我们运动员不管怎么说"
    },
    {
      "end": 2605.4,
