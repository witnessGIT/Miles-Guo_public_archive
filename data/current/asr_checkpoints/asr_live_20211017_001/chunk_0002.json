    {
      "end": 2685.4,
      "start": 2684.4,
      "text": "特别是关于二次"
    },
    {
      "end": 2687.4,
      "start": 2685.4,
      "text": "我打断一下"
    },
    {
      "end": 2689.4,
      "start": 2687.4,
      "text": "我跟你表述"
    },
    {
      "end": 2690.4,
      "start": 2689.4,
      "text": "我完整的告诉你"
    },
    {
      "end": 2692.4,
      "start": 2690.4,
      "text": "可能我讲完你不大了解"
    },
    {
      "end": 2694.4,
      "start": 2692.4,
      "text": "为什么我提这个五十五十"
    },
    {
      "end": 2696.4,
      "start": 2694.4,
      "text": "是怎么来的癌症"
