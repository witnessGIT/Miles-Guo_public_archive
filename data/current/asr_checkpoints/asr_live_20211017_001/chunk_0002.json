    {
      "end": 2645.4,
      "start": 2644.4,
      "text": "首先第一点"
    },
    {
      "end": 2647.4,
      "start": 2645.4,
      "text": "我本人对化疗是极其反对"
    },
    {
      "end": 2649.4,
      "start": 2647.4,
      "text": "我是个反化疗者"
    },
    {
      "end": 2650.4,
      "start": 2649.4,
      "text": "可能反化疗的医生不多"
    },
    {
      "end": 2652.4,
      "start": 2650.4,
      "text": "我是其中追忆"
    },
    {
      "end": 2653.4,
      "start": 2652.4,
      "text": "因为化疗"
