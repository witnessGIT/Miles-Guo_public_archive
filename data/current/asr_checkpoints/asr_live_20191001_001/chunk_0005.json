{
  "chunk_audio_sha256": "3d4a406b7eb41b133c05cfeb3ac1b6e7fc8c902b68a71f4fcda9f4051d32165b",
  "chunk_index": 5,
  "completed_at": "2026-10-20T02:37:38Z",
  "language": "zh",
  "live_id": "LIVE_20191001_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 4500,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 4502.24,
      "start": 4500.0,
      "text": "请您先谈谈你的看法"
    },
    {
      "end": 4504.76,
      "start": 4502.24,
      "text": "还有你给咱们战友们怎么谈谈"
    },
    {
      "end": 4507.88,
      "start": 4504.76,
      "text": "你对看法之外"
    },
    {
      "end": 4510.24,
      "start": 4507.88,
      "text": "你还有什么样的信息给大家分享一下"
    },
    {
      "end": 4511.24,
      "start": 4510.24,
      "text": "请开始"
    },
    {
      "end": 4512.76,
      "start": 4511.24,
      "text": "好的 谢谢"
    },
    {
      "end": 4514.4,
      "start": 4512.76,
      "text": "第一个就是说"
    },
    {
      "end": 4515.56,
      "start": 4514.4,
      "text": "气色都不好"
    },
    {
      "end": 4517.24,
      "start": 4515.56,
      "text": "那些气色整个都不太好"
    },
    {
      "end": 4520.04,
      "start": 4517.24,
      "text": "整个面堂发黑 阴云密布"
    },
    {
      "end": 4521.88,
      "start": 4520.04,
      "text": "表情沉闷"
    },
    {
      "end": 4522.8,
      "start": 4521.88,
      "text": "还有就是说"
    },
    {
      "end": 4525.12,
      "start": 4522.8,
      "text": "它完全是按照一种套路来演绎"
    },
    {
      "end": 4527.24,
      "start": 4525.12,
      "text": "和事先规定好的范式"
    },
    {
      "end": 4529.2,
      "start": 4527.24,
      "text": "所以我个人坚定地认为"
    },
    {
      "end": 4530.64,
      "start": 4529.2,
      "text": "这就是最后一次"
    },
    {
      "end": 4534.24,
      "start": 4530.64,
      "text": "没有以后的再庆"
    },
    {
      "end": 4535.56,
      "start": 4534.24,
      "text": "第二完全是自嗨"
    },
    {
      "end": 4537.56,
      "start": 4535.56,
      "text": "我也同意之前的战友西斯哥"
    },
    {
      "end": 4538.4,
      "start": 4537.56,
      "text": "还有路德"
    },
    {
      "end": 4539.72,
      "start": 4538.4,
      "text": "包括文贵先生的看法"
    },
    {
      "end": 4540.64,
      "start": 4539.72,
      "text": "就是说"
    },
    {
      "end": 4542.64,
      "start": 4540.64,
      "text": "他真正演绎成这样"
    },
    {
      "end": 4544.24,
      "start": 4542.64,
      "text": "气势汹汹"
    },
    {
      "end": 4546.84,
      "start": 4544.24,
      "text": "话语喧昂 脚步铿锵"
    },
    {
      "end": 4550.04,
      "start": 4546.84,
      "text": "其实完全就是为了活动老百姓"
    },
    {
      "end": 4551.36,
      "start": 4550.04,
      "text": "很清楚不过"
    },
    {
      "end": 4553.08,
      "start": 4551.36,
      "text": "我小时候是在北京"
    },
    {
      "end": 4555.12,
      "start": 4553.08,
      "text": "我不是完全在北京长大的"
    },
    {
      "end": 4557.52,
      "start": 4555.12,
      "text": "我觉得如果真界定北京姑娘的话"
    },
    {
      "end": 4559.28,
      "start": 4557.52,
      "text": "我可能算一半北京姑娘"
    },
    {
      "end": 4561.6,
      "start": 4559.28,
      "text": "因为当年作为一个外地插班生"
    },
    {
      "end": 4563.88,
      "start": 4561.6,
      "text": "我也遭受过北京孩子的歧视"
    },
    {
      "end": 4566.28,
      "start": 4563.88,
      "text": "比如说被男同学拉着扔进男厕所"
    },
    {
      "end": 4569.16,
      "start": 4566.28,
      "text": "比如说被女生跳皮筋和玩的时候"
    },
    {
      "end": 4570.48,
      "start": 4569.16,
      "text": "就直接给我推倒骂"
    },
    {
      "end": 4571.88,
      "start": 4570.48,
      "text": "无数脏话"
    },
    {
      "end": 4573.36,
      "start": 4571.88,
      "text": "还有就是说被男女这个声"
    },
    {
      "end": 4576.24,
      "start": 4573.36,
      "text": "在路队里面直接给我推到这个煤坑里面去"
    },
    {
      "end": 4577.08,
      "start": 4576.24,
      "text": "书包啊"
    },
    {
      "end": 4578.04,
      "start": 4577.08,
      "text": "那个铅笔"
    },
    {
      "end": 4580.12,
      "start": 4578.04,
      "text": "橡皮全部都散落在那里面"
    },
    {
      "end": 4582.08,
      "start": 4580.12,
      "text": "那当我第一次插着腰"
    },
    {
      "end": 4585.12,
      "start": 4582.08,
      "text": "用金枪金苑骂出北京的金骂的时候"
    },
    {
      "end": 4586.6,
      "start": 4585.12,
      "text": "我那时候才认同"
    },
    {
      "end": 4589.8,
      "start": 4586.6,
      "text": "原来我学会了骂人和这个说脏话"
    },
    {
      "end": 4593.24,
      "start": 4589.8,
      "text": "才能真正把自己界定为成一个北京女孩子"
    },
    {
      "end": 4596.68,
      "start": 4593.24,
      "text": "我彻底改变了我在南方的那种文静秀气"
    },
    {
      "end": 4597.88,
      "start": 4596.68,
      "text": "内敛的那种气质"
    },
    {
      "end": 4599.56,
      "start": 4597.88,
      "text": "完全变成一个插着腰"
    },
    {
      "end": 4602.24,
      "start": 4599.56,
      "text": "可以跟别挥着菜刀打架的这么一个人"
    },
    {
      "end": 4604.6,
      "start": 4602.24,
      "text": "那么中共这种教育"
    },
    {
      "end": 4605.68,
      "start": 4604.6,
      "text": "或者这种文化"
    },
    {
      "end": 4608.24,
      "start": 4605.68,
      "text": "或者它的体制归根结底"
    },
    {
      "end": 4611.24,
      "start": 4608.24,
      "text": "其实就是让老百姓变成流氓的体制"
    },
    {
      "end": 4613.56,
      "start": 4611.88,
      "text": "那我们70年演绎"
    },
    {
      "end": 4614.0,
      "start": 4613.56,
      "text": "说白了"
    },
    {
      "end": 4616.8,
      "start": 4614.0,
      "text": "它割裂了所有的中华文明的渊源"
    },
    {
      "end": 4621.04,
      "start": 4616.8,
      "text": "它彻底扭曲了人伦和人的精神气质"
    },
    {
      "end": 4624.36,
      "start": 4621.04,
      "text": "它彻底把民族里的精华完全抛弃"
    },
    {
      "end": 4627.8,
      "start": 4624.36,
      "text": "然后把民族里的遭过充分扬弃"
    },
    {
      "end": 4630.88,
      "start": 4627.8,
      "text": "就是说人的恶在制度的保护下"
    },
    {
      "end": 4632.28,
      "start": 4630.88,
      "text": "可以最大的发挥"
    },
    {
      "end": 4634.36,
      "start": 4632.28,
      "text": "比如说刚才文贵先生跟Perser"
    },
    {
      "end": 4635.48,
      "start": 4634.36,
      "text": "和小皮匠聊的时候"
    },
    {
      "end": 4637.3,
      "start": 4635.48,
      "text": "我其实非常有体会"
    },
    {
      "end": 4639.26,
      "start": 4637.3,
      "text": "因为我跟百发工作关系"
    },
    {
      "end": 4641.24,
      "start": 4639.26,
      "text": "我跟张百发陈希同 王宝生这些人"
    },
    {
      "end": 4643.6,
      "start": 4641.24,
      "text": "都还有过工作界面上的接触"
    },
    {
      "end": 4645.14,
      "start": 4643.6,
      "text": "真是一夜之间"
    },
    {
      "end": 4646.68,
      "start": 4645.14,
      "text": "就自从江泽民进来北京"
    },
    {
      "end": 4648.08,
      "start": 4646.68,
      "text": "这个金瓜就没有了"
    },
    {
      "end": 4650.7,
      "start": 4648.08,
      "text": "金文化的气质在北京的观察里"
    },
    {
      "end": 4652.82,
      "start": 4650.7,
      "text": "其实是真正很少见的"
    },
    {
      "end": 4654.68,
      "start": 4652.82,
      "text": "就像刚才文贵先生也提到过"
    },
    {
      "end": 4656.64,
      "start": 4654.68,
      "text": "这个第一哥第一爷们"
    },
    {
      "end": 4658.18,
      "start": 4656.64,
      "text": "谈论的这种政治"
    },
    {
      "end": 4660.7,
      "start": 4658.18,
      "text": "完全是从大家里接头向委听到的"
    },
    {
      "end": 4664.4,
      "start": 4660.7,
      "text": "真正他们接触上层政客和官员的概率"
    },
    {
      "end": 4666.32,
      "start": 4664.4,
      "text": "和机会是非常少的"
    },
    {
      "end": 4667.4,
      "start": 4666.32,
      "text": "第三谈一谈"
    },
    {
      "end": 4670.24,
      "start": 4667.4,
      "text": "就是说香港目前还在这种局势下"
    },
    {
      "end": 4672.46,
      "start": 4670.24,
      "text": "其实林郑那天在这个"
    },
    {
      "end": 4674.82,
      "start": 4672.46,
      "text": "记者招待会上"
    },
    {
      "end": 4676.94,
      "start": 4674.82,
      "text": "那种欲言又止"
    },
    {
      "end": 4678.3,
      "start": 4676.94,
      "text": "那种娇柔造作"
    },
    {
      "end": 4680.76,
      "start": 4678.3,
      "text": "那种不屑一共那种表情"
    },
    {
      "end": 4685.82,
      "start": 4680.76,
      "text": "已经表明中共其实是我这一边在70年周年大庆"
    },
    {
      "end": 4688.54,
      "start": 4685.82,
      "text": "我那边一定会下了很命令"
    },
    {
      "end": 4690.88,
      "start": 4688.54,
      "text": "就是下了死心塌地"
    },
    {
      "end": 4692.88,
      "start": 4690.88,
      "text": "需要把香港人民给弄死"
    },
    {
      "end": 4695.04,
      "start": 4692.88,
      "text": "我们看看他的手法"
    },
    {
      "end": 4697.94,
      "start": 4695.04,
      "text": "没有一样不是打到这个人身体的要害"
    },
    {
      "end": 4701.14,
      "start": 4697.94,
      "text": "所以说他真正在那边演绎着就是说"
    },
    {
      "end": 4706.1,
      "start": 4701.14,
      "text": "跟他彻头彻尾的这个谎言对上"
    },
    {
      "end": 4707.86,
      "start": 4706.1,
      "text": "他就用人民军队来镇压"
    },
    {
      "end": 4709.46,
      "start": 4707.86,
      "text": "镇压人民镇压同胞的"
    },
    {
      "end": 4711.78,
      "start": 4709.46,
      "text": "那这边呢造成一种歌谷生平"
    },
    {
      "end": 4713.6,
      "start": 4711.78,
      "text": "去继续欺瞒世界"
    },
    {
      "end": 4716.22,
      "start": 4713.6,
      "text": "去继续欺瞒国内的子民"
    },
    {
      "end": 4718.24,
      "start": 4716.22,
      "text": "或者说连公民都不是"
    },
    {
      "end": 4719.82,
      "start": 4718.24,
      "text": "只是个居民身份证的居民"
    },
    {
      "end": 4721.96,
      "start": 4719.82,
      "text": "那么所庆幸的是"
    },
    {
      "end": 4726.22,
      "start": 4721.96,
      "text": "这个世界已经看到了希望和曙光还有真相"
    },
    {
      "end": 4727.76,
      "start": 4726.22,
      "text": "就是说比如说这次"
    },
    {
      "end": 4730.52,
      "start": 4727.76,
      "text": "他连这个一个外国这个什么"
    },
    {
      "end": 4733.14,
      "start": 4730.52,
      "text": "什么所谓的朋友或者老朋友都没有请来"
    },
    {
      "end": 4734.18,
      "start": 4733.14,
      "text": "一旦请来的话"
    },
    {
      "end": 4736.56,
      "start": 4734.18,
      "text": "人家可是要开口希望他大嗓臂"
    },
    {
      "end": 4738.2,
      "start": 4736.56,
      "text": "但是他没有达成他在笑影"
    },
    {
      "end": 4740.48,
      "start": 4738.2,
      "text": "所以说这种严库"
    },
    {
      "end": 4742.7,
      "start": 4740.48,
      "text": "这个严库的形式和格局下"
    },
    {
      "end": 4745.02,
      "start": 4742.7,
      "text": "也导致他们在城楼上"
    },
    {
      "end": 4746.12,
      "start": 4745.02,
      "text": "在车里面"
    },
    {
      "end": 4748.64,
      "start": 4746.12,
      "text": "在每个人排的这个方阵矩阵里面"
    },
    {
      "end": 4752.32,
      "start": 4748.64,
      "text": "其实是他自己心里比我们害怕多了"
    },
    {
      "end": 4754.66,
      "start": 4752.32,
      "text": "我们已经置之生死于肚外"
    },
    {
      "end": 4756.14,
      "start": 4754.66,
      "text": "所以我们已经豁出去了"
    },
    {
      "end": 4756.92,
      "start": 4756.14,
      "text": "我们不怕了"
    },
    {
      "end": 4758.64,
      "start": 4756.92,
      "text": "但他们才是最怕的人"
    },
    {
      "end": 4761.0,
      "start": 4758.64,
      "text": "也感谢文贵先生刚才提到的"
    },
    {
      "end": 4764.76,
      "start": 4761.0,
      "text": "就是说我突然就是队伍原来是这样"
    },
    {
      "end": 4767.2,
      "start": 4764.76,
      "text": "就是说他们真正是最排斥老百姓"
    },
    {
      "end": 4768.58,
      "start": 4767.2,
      "text": "最抵制金官的"
    },
    {
      "end": 4770.18,
      "start": 4768.58,
      "text": "我个人经历过六四"
    },
    {
      "end": 4771.86,
      "start": 4770.18,
      "text": "我就认为从那一天开始"
    },
    {
      "end": 4775.76,
      "start": 4771.86,
      "text": "全北京的老百姓都为他们给轮奸给强暴了"
    },
    {
      "end": 4777.76,
      "start": 4775.76,
      "text": "我就用坦克装甲车"
    },
    {
      "end": 4779.86,
      "start": 4777.76,
      "text": "我就用这个士兵和机关枪"
    },
    {
      "end": 4782.18,
      "start": 4779.86,
      "text": "我就用催泪弹让你们收声"
    },
    {
      "end": 4786.26,
      "start": 4782.18,
      "text": "谁也不要再跟我北京话说的字"
    },
    {
      "end": 4787.98,
      "start": 4786.26,
      "text": "就是说谁也不要在这反抗"
    },
    {
      "end": 4789.46,
      "start": 4787.98,
      "text": "我就用这种方式"
    },
    {
      "end": 4793.46,
      "start": 4789.46,
      "text": "我强行用女带坦克撵过你"
    },
    {
      "end": 4796.06,
      "start": 4793.46,
      "text": "我看你还想跟我这发什么声音"
    },
    {
      "end": 4801.14,
      "start": 4796.06,
      "text": "他妄图用这种方式再一次在香港同胞身上"
    },
    {
      "end": 4803.8,
      "start": 4801.14,
      "text": "达到他想达到的效果"
    },
    {
      "end": 4806.98,
      "start": 4803.8,
      "text": "可是恰恰他严重的失算"
    },
    {
      "end": 4809.04,
      "start": 4806.98,
      "text": "香港是个什么地方"
    },
    {
      "end": 4812.94,
      "start": 4809.04,
      "text": "他低估了香港的公民和子民还有同胞们"
    },
    {
      "end": 4814.84,
      "start": 4812.94,
      "text": "他低估了我们的香港人民"
    },
    {
      "end": 4816.6,
      "start": 4814.84,
      "text": "所以说我个人认为"
    },
    {
      "end": 4818.24,
      "start": 4816.6,
      "text": "这个怎么收场"
    },
    {
      "end": 4820.06,
      "start": 4818.24,
      "text": "就像之前文贵先生曝光的一样"
    },
    {
      "end": 4821.26,
      "start": 4820.06,
      "text": "已经彻底乱套了"
    },
    {
      "end": 4822.74,
      "start": 4821.26,
      "text": "或者说这个姜也好"
    },
    {
      "end": 4823.34,
      "start": 4822.74,
      "text": "猪也好"
    },
    {
      "end": 4825.16,
      "start": 4823.34,
      "text": "已经说这个药就大事了"
    },
    {
      "end": 4828.08,
      "start": 4825.16,
      "text": "我们拭目以待"
    },
    {
      "end": 4830.28,
      "start": 4828.08,
      "text": "看看到底会是什么样的结局"
    },
    {
      "end": 4832.82,
      "start": 4830.28,
      "text": "这是总体的一个今天的观感"
    },
    {
      "end": 4836.16,
      "start": 4832.82,
      "text": "我刚才是因为沉浸在这个小皮匠和Princy谈话里"
    },
    {
      "end": 4837.48,
      "start": 4836.16,
      "text": "我还一边在收拾东西"
    },
    {
      "end": 4839.48,
      "start": 4837.48,
      "text": "我都没意识到我就是下一个"
    },
    {
      "end": 4840.16,
      "start": 4839.48,
      "text": "所以不好意思"
    },
    {
      "end": 4841.52,
      "start": 4840.16,
      "text": "我一边稍微仓促了一点"
    },
    {
      "end": 4842.24,
      "start": 4841.52,
      "text": "谢谢大家"
    },
    {
      "end": 4844.82,
      "start": 4842.24,
      "text": "我觉得安红女士"
    },
    {
      "end": 4847.54,
      "start": 4844.82,
      "text": "这个北京姑娘很多特色你真都有"
    },
    {
      "end": 4850.78,
      "start": 4847.54,
      "text": "这个你讲的非常实际"
    },
    {
      "end": 4853.38,
      "start": 4850.78,
      "text": "就为什么我觉得陆安谈"
    },
    {
      "end": 4855.42,
      "start": 4853.38,
      "text": "这个受到很多人的欢迎"
    },
    {
      "end": 4856.62,
      "start": 4855.42,
      "text": "其中的核心"
    },
    {
      "end": 4859.58,
      "start": 4856.62,
      "text": "我觉得就是你们谈都是发自内心的"
    },
    {
      "end": 4860.84,
      "start": 4859.58,
      "text": "不招不优"
    },
    {
      "end": 4862.52,
      "start": 4860.84,
      "text": "不就是个造作"
    },
    {
      "end": 4864.2,
      "start": 4862.52,
      "text": "不造假"
    },
    {
      "end": 4866.78,
      "start": 4864.2,
      "text": "不像路德先生老要扮演这个什么"
    },
    {
      "end": 4868.16,
      "start": 4866.78,
      "text": "中央电视台主持人"
    },
    {
      "end": 4869.28,
      "start": 4868.16,
      "text": "最大他很累"
    },
    {
      "end": 4871.12,
      "start": 4869.28,
      "text": "他老想演个角色"
    },
    {
      "end": 4872.62,
      "start": 4871.12,
      "text": "我老说你别想演"
    },
    {
      "end": 4873.92,
      "start": 4872.62,
      "text": "你就很好了"
    },
    {
      "end": 4876.54,
      "start": 4873.92,
      "text": "我觉得安红女士就是有天赋"
    },
    {
      "end": 4878.0,
      "start": 4876.54,
      "text": "我觉得上电视啊"
    },
    {
      "end": 4879.0,
      "start": 4878.0,
      "text": "演讲啊"
    },
    {
      "end": 4880.28,
      "start": 4879.0,
      "text": "因为什么他发自内心的"
    },
    {
      "end": 4881.24,
      "start": 4880.28,
      "text": "主持性很强"
    },
    {
      "end": 4882.34,
      "start": 4881.24,
      "text": "内部的语言"
    },
    {
      "end": 4884.08,
      "start": 4882.34,
      "text": "思路的主持特别好"
    },
    {
      "end": 4885.98,
      "start": 4884.08,
      "text": "那么你像Presy啊"
    },
    {
      "end": 4887.3,
      "start": 4885.98,
      "text": "还有像这个"
    },
    {
      "end": 4889.54,
      "start": 4887.3,
      "text": "我们小皮匠都北京姑娘来了"
    },
    {
      "end": 4891.72,
      "start": 4889.54,
      "text": "你们都是天生的演讲"
    },
    {
      "end": 4892.74,
      "start": 4891.72,
      "text": "在北京这个地方"
    },
    {
      "end": 4895.14,
      "start": 4892.74,
      "text": "北京和往北方走以后啊"
    },
    {
      "end": 4896.52,
      "start": 4895.14,
      "text": "就是口才会越来越好"
    },
    {
      "end": 4898.04,
      "start": 4896.52,
      "text": "因为吃盐吃得多"
    },
    {
      "end": 4901.08,
      "start": 4898.04,
      "text": "科学家证明啊"
    },
    {
      "end": 4903.2,
      "start": 4901.08,
      "text": "吃重口味盐多的地方"
    },
    {
      "end": 4905.18,
      "start": 4903.2,
      "text": "和天气冷的地方长大的人"
    },
    {
      "end": 4906.28,
      "start": 4905.18,
      "text": "口才就越来越好"
    },
    {
      "end": 4907.7,
      "start": 4906.28,
      "text": "这是真的啊"
    },
    {
      "end": 4908.94,
      "start": 4907.7,
      "text": "这不是开玩笑的"
    },
    {
      "end": 4911.36,
      "start": 4908.94,
      "text": "所以说东北人都出那些什么"
    },
    {
      "end": 4912.26,
      "start": 4911.36,
      "text": "相声啊"
    },
    {
      "end": 4912.9,
      "start": 4912.26,
      "text": "小品啊"
    },
    {
      "end": 4914.04,
      "start": 4912.9,
      "text": "就这么出来的啊"
    },
    {
      "end": 4915.56,
      "start": 4914.04,
      "text": "还有吃猪肉吃多的人"
    },
    {
      "end": 4916.4,
      "start": 4915.56,
      "text": "口才都好"
    },
    {
      "end": 4918.4,
      "start": 4916.4,
      "text": "多吃五花肉"
    },
    {
      "end": 4919.54,
      "start": 4918.4,
      "text": "挺有意思的"
    },
    {
      "end": 4920.14,
      "start": 4919.54,
      "text": "不是开玩笑"
    },
    {
      "end": 4921.1,
      "start": 4920.14,
      "text": "你多吃猪肉"
    },
    {
      "end": 4922.36,
      "start": 4921.1,
      "text": "你马上口才更好"
    },
    {
      "end": 4924.36,
      "start": 4922.36,
      "text": "这都是都有科学研究的啊"
    },
    {
      "end": 4925.36,
      "start": 4924.36,
      "text": "我在刚才这个"
    },
    {
      "end": 4927.0,
      "start": 4925.36,
      "text": "你说你跟百发这个接触"
    },
    {
      "end": 4927.86,
      "start": 4927.0,
      "text": "就很有意思"
    },
    {
      "end": 4929.16,
      "start": 4927.86,
      "text": "因为百发没儿子"
    },
    {
      "end": 4930.04,
      "start": 4929.16,
      "text": "他有个姑娘"
    },
    {
      "end": 4931.76,
      "start": 4930.04,
      "text": "他的姑娘啊"
    },
    {
      "end": 4933.04,
      "start": 4931.76,
      "text": "就是这个老搞这个"
    },
    {
      "end": 4933.9,
      "start": 4933.04,
      "text": "他会得语"
    },
    {
      "end": 4935.34,
      "start": 4933.9,
      "text": "他搞一些那种马术啊"
    },
    {
      "end": 4936.26,
      "start": 4935.34,
      "text": "比赛啊"
    },
    {
      "end": 4937.3,
      "start": 4936.26,
      "text": "这些啊"
    },
    {
      "end": 4938.7,
      "start": 4937.3,
      "text": "百发的老伴啊"
    },
    {
      "end": 4939.94,
      "start": 4938.7,
      "text": "这个人特别朴实的"
    },
    {
      "end": 4940.16,
      "start": 4939.94,
      "text": "人"
    },
    {
      "end": 4941.54,
      "start": 4940.16,
      "text": "就典型北方人"
    },
    {
      "end": 4942.96,
      "start": 4941.54,
      "text": "天天干辣饼啊"
    },
    {
      "end": 4944.74,
      "start": 4942.96,
      "text": "他家就住在那个这个"
    },
    {
      "end": 4946.54,
      "start": 4945.16,
      "text": "闺民楼后边啊"
    },
    {
      "end": 4949.16,
      "start": 4946.54,
      "text": "就是北京那个所谓的领导家属院啊"
    },
    {
      "end": 4951.46,
      "start": 4949.84,
      "text": "这个我也多次去他家"
    },
    {
      "end": 4953.6,
      "start": 4951.7,
      "text": "百发我跟百发的人"
    },
    {
      "end": 4954.46,
      "start": 4953.6,
      "text": "我对他的评价"
    },
    {
      "end": 4956.04,
      "start": 4954.46,
      "text": "这个人是我们要学习的"
    },
    {
      "end": 4957.96,
      "start": 4956.04,
      "text": "这个了不起的做人的榜样"
    },
    {
      "end": 4961.1,
      "start": 4958.9,
      "text": "就是我发自内心的"
    },
    {
      "end": 4963.04,
      "start": 4961.1,
      "text": "我就尊敬百发"
    },
    {
      "end": 4965.9,
      "start": 4963.04,
      "text": "那个生活中的百发"
    },
    {
      "end": 4967.0,
      "start": 4965.9,
      "text": "那简直了不起"
    },
    {
      "end": 4968.38,
      "start": 4967.0,
      "text": "我给你们卷两个例子"
    },
    {
      "end": 4970.3,
      "start": 4968.38,
      "text": "这跟这有点八卦了啊"
    },
    {
      "end": 4973.48,
      "start": 4970.3,
      "text": "所有的老板当年都想靠近买发"
    },
    {
      "end": 4975.0,
      "start": 4973.48,
      "text": "就是归伟啊"
    },
    {
      "end": 4977.64,
      "start": 4975.0,
      "text": "他一直他没有卸下归伟的"
    },
    {
      "end": 4979.2,
      "start": 4977.64,
      "text": "这委员的职务啊"
    },
    {
      "end": 4982.28,
      "start": 4979.2,
      "text": "归伟这个就是北京最有钱的"
    },
    {
      "end": 4983.7,
      "start": 4982.28,
      "text": "一个归伟一个是银行嘛"
    },
    {
      "end": 4985.98,
      "start": 4983.7,
      "text": "拿项目拿钱嘛就搞房地产嘛"
    },
    {
      "end": 4987.34,
      "start": 4985.98,
      "text": "都围着百发转"
    },
    {
      "end": 4989.18,
      "start": 4987.34,
      "text": "那就无数个人了啊"
    },
    {
      "end": 4990.32,
      "start": 4989.18,
      "text": "那他太多了"
    },
    {
      "end": 4992.04,
      "start": 4990.32,
      "text": "其中最明显的一个人叫什么"
    },
    {
      "end": 4993.64,
      "start": 4992.04,
      "text": "红牛的老板叫颜斌"
    },
    {
      "end": 4996.32,
      "start": 4994.82,
      "text": "这个颜斌这个人我跟你说"
    },
    {
      "end": 4997.22,
      "start": 4996.32,
      "text": "他啥人呐"
    },
    {
      "end": 4998.14,
      "start": 4997.52,
      "text": "就是"
    },
    {
      "end": 5000.02,
      "start": 4998.72,
      "text": "很多年都能认识"
    },
    {
      "end": 5002.18,
      "start": 5000.02,
      "text": "他在河南出来是卖雪的"
    },
    {
      "end": 5003.58,
      "start": 5002.18,
      "text": "到泰国卖雪去了"
    },
    {
      "end": 5006.12,
      "start": 5004.18,
      "text": "他卖雪认识了个黑社会"
    },
    {
      "end": 5008.08,
      "start": 5006.68,
      "text": "这个家伙厉害在哪了呢"
    },
    {
      "end": 5008.78,
      "start": 5008.08,
      "text": "这黑社会吧"
    },
    {
      "end": 5010.42,
      "start": 5008.78,
      "text": "就每次要表现给老大嘛"
    },
    {
      "end": 5011.68,
      "start": 5010.42,
      "text": "就跟拍照一模一样"
    },
    {
      "end": 5012.42,
      "start": 5011.94,
      "text": "然后呢"
    },
    {
      "end": 5013.18,
      "start": 5012.42,
      "text": "贩毒品啊"
    },
    {
      "end": 5014.48,
      "start": 5013.18,
      "text": "他旁边有人就跟班"
    },
    {
      "end": 5016.18,
      "start": 5014.48,
      "text": "就就拿了烟头"
    },
    {
      "end": 5017.18,
      "start": 5016.82,
      "text": "啪"
    },
    {
      "end": 5018.28,
      "start": 5017.18,
      "text": "就挤烟头"
    },
    {
      "end": 5019.88,
      "start": 5018.28,
      "text": "那严斌就把手过去了"
    },
    {
      "end": 5021.48,
      "start": 5019.88,
      "text": "他把手啊给弄得冒烟"
    },
    {
      "end": 5022.84,
      "start": 5021.48,
      "text": "所以你看严斌整个的手"
    },
    {
      "end": 5024.82,
      "start": 5022.84,
      "text": "这里边全都是那个烟头的口"
    },
    {
      "end": 5026.02,
      "start": 5025.34,
      "text": "然后呢"
    },
    {
      "end": 5026.82,
      "start": 5026.02,
      "text": "人家就有时候"
    },
    {
      "end": 5027.82,
      "start": 5026.82,
      "text": "这个过来"
    },
    {
      "end": 5029.14,
      "start": 5027.82,
      "text": "他就马上手捧过去"
    },
    {
      "end": 5030.54,
      "start": 5029.14,
      "text": "然后啪一口汤涂在手上"
    },
    {
      "end": 5032.62,
      "start": 5030.54,
      "text": "他就赶快擦一擦"
    },
    {
      "end": 5034.18,
      "start": 5032.62,
      "text": "他扮演这角色出来"
    },
    {
      "end": 5034.98,
      "start": 5034.18,
      "text": "偷渡"
    },
    {
      "end": 5036.14,
      "start": 5034.98,
      "text": "卖雪"
    },
    {
      "end": 5036.92,
      "start": 5036.14,
      "text": "然后呢"
    },
    {
      "end": 5038.04,
      "start": 5036.92,
      "text": "给黑社当老大"
    },
    {
      "end": 5039.28,
      "start": 5038.54,
      "text": "后来这个"
    },
    {
      "end": 5040.42,
      "start": 5039.28,
      "text": "这个红牛啊"
    },
    {
      "end": 5042.52,
      "start": 5040.42,
      "text": "就被泰国的这家给带住了"
    },
    {
      "end": 5043.34,
      "start": 5042.52,
      "text": "红牛呢"
    },
    {
      "end": 5044.22,
      "start": 5043.34,
      "text": "在泰国这里边"
    },
    {
      "end": 5045.58,
      "start": 5044.22,
      "text": "它就有问题了"
    },
    {
      "end": 5046.14,
      "start": 5045.58,
      "text": "你知道吗"
    },
    {
      "end": 5047.72,
      "start": 5046.14,
      "text": "然后他就回中国就带着"
    },
    {
      "end": 5049.12,
      "start": 5047.72,
      "text": "那中国也没人看好啊"
    },
    {
      "end": 5050.32,
      "start": 5049.12,
      "text": "就给了和代理回来了"
    },
    {
      "end": 5051.52,
      "start": 5050.32,
      "text": "那个时候"
    },
    {
      "end": 5052.22,
      "start": 5051.52,
      "text": "钱了"
    },
    {
      "end": 5053.52,
      "start": 5052.22,
      "text": "他这个人就是"
    },
    {
      "end": 5055.32,
      "start": 5053.52,
      "text": "任何地方出现的地方"
    },
    {
      "end": 5057.32,
      "start": 5055.32,
      "text": "全部让你可恶心都不行"
    },
    {
      "end": 5058.82,
      "start": 5057.32,
      "text": "就他永远是这样"
    },
    {
      "end": 5060.32,
      "start": 5058.82,
      "text": "呱一口弹就住盘子上"
    },
    {
      "end": 5062.62,
      "start": 5060.32,
      "text": "你说谁受得了啊"
    },
    {
      "end": 5064.02,
      "start": 5062.62,
      "text": "永远是这样"
    },
    {
      "end": 5065.22,
      "start": 5064.02,
      "text": "永远是这样"
    },
    {
      "end": 5066.22,
      "start": 5065.22,
      "text": "永远是这样"
    },
    {
      "end": 5067.22,
      "start": 5066.22,
      "text": "那么"
    },
    {
      "end": 5069.02,
      "start": 5067.22,
      "text": "张百发这人能什么样"
    },
    {
      "end": 5069.52,
      "start": 5069.02,
      "text": "你看啊"
    },
    {
      "end": 5071.22,
      "start": 5069.52,
      "text": "他给百发贴金正式以后"
    },
    {
      "end": 5073.22,
      "start": 5071.22,
      "text": "就见了百发就吹腿"
    },
    {
      "end": 5074.42,
      "start": 5073.22,
      "text": "就跪着地儿叫吹腿"
    },
    {
      "end": 5075.72,
      "start": 5074.42,
      "text": "然后又揉肩"
    },
    {
      "end": 5077.22,
      "start": 5075.72,
      "text": "然后就揉肩"
    },
    {
      "end": 5077.92,
      "start": 5077.22,
      "text": "然后呢"
    },
    {
      "end": 5080.02,
      "start": 5077.92,
      "text": "就给百发买点这买点那"
    },
    {
      "end": 5081.22,
      "start": 5080.02,
      "text": "很舍得花钱"
    },
    {
      "end": 5083.32,
      "start": 5081.22,
      "text": "就通过百发认识很多北京人"
    },
    {
      "end": 5084.82,
      "start": 5083.32,
      "text": "然后打高尔夫"
    },
    {
      "end": 5087.52,
      "start": 5084.82,
      "text": "百发后来就高尔夫迷啊"
    },
    {
      "end": 5089.62,
      "start": 5087.52,
      "text": "说他北辰高尔夫俱乐部就他搞的嘛"
    },
    {
      "end": 5091.82,
      "start": 5089.62,
      "text": "这个当时我也占住了他钱"
    },
    {
      "end": 5093.62,
      "start": 5091.82,
      "text": "搞着一帮人"
    },
    {
      "end": 5094.22,
      "start": 5093.62,
      "text": "呼啦啦的"
    },
    {
      "end": 5095.62,
      "start": 5094.22,
      "text": "每天吃饼去"
    },
    {
      "end": 5096.22,
      "start": 5095.62,
      "text": "一话"
    },
    {
      "end": 5096.82,
      "start": 5096.22,
      "text": "文贵啊"
    },
    {
      "end": 5098.32,
      "start": 5096.82,
      "text": "上我这吃饼啊"
    },
    {
      "end": 5099.22,
      "start": 5098.32,
      "text": "过来"
    },
    {
      "end": 5099.82,
      "start": 5099.22,
      "text": "就吃大饼"
    },
    {
      "end": 5101.02,
