{
  "chunk_audio_sha256": "6acad7712b96da73093661872a0bb74c64516e291f0f16cb1234433632996586",
  "chunk_index": 4,
  "completed_at": "2026-10-20T02:35:28Z",
  "language": "zh",
  "live_id": "LIVE_20191001_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 3600,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 3603.52,
      "start": 3600.0,
      "text": "你知不知道么小皮家 江泽民说了句话"
    },
    {
      "end": 3608.6,
      "start": 3604.12,
      "text": "当年北京六四 如果不在北京闹起来 全国能闹起来吗?"
    },
    {
      "end": 3611.48,
      "start": 3609.16,
      "text": "北京人心里就不憨"
    },
    {
      "end": 3615.4,
      "start": 3612.18,
      "text": "六四他规矩 就是北京人就找事儿"
    },
    {
      "end": 3622.2,
      "start": 3615.76,
      "text": "太关心政治 查厕所的 端盘子的 出租车自机 全拦政治"
    },
    {
      "end": 3627.32,
      "start": 3622.4,
      "text": "叫这边人吓唬 吹出了个六四 叫北京人闭嘴"
    },
    {
      "end": 3634.4,
      "start": 3627.32,
      "text": "这个是上海文化和上海帮对整个北京城打压"
    },
    {
      "end": 3637.92,
      "start": 3634.4,
      "text": "是在京身上打压 在物理上把你隔离"
    },
    {
      "end": 3645.92,
      "start": 3639.04,
      "text": "最后是你看看江泽民在北京 要去首冈 他不去"
    },
    {
      "end": 3652.28,
      "start": 3646.6,
      "text": "在首都他根本不去北京 几次不去"
    },
    {
      "end": 3656.08,
      "start": 3653.4,
      "text": "最后诞生了最伟大的语言"
    },
    {
      "end": 3659.76,
      "start": 3656.08,
      "text": "朱镕基 江上来以后 你记得吧"
    },
    {
      "end": 3662.88,
      "start": 3659.96,
      "text": "大家都知道这个故事 说中南海 中南海"
    },
    {
      "end": 3665.8,
      "start": 3662.88,
      "text": "结果陈希同说 你那叫中南海吧"
    },
    {
      "end": 3668.88,
      "start": 3666.0,
      "text": "就那几勺子水 你叫中南海"
    },
    {
      "end": 3671.68,
      "start": 3669.24,
      "text": "就那几勺子水 让我北京市"
    },
    {
      "end": 3675.6,
      "start": 3671.88,
      "text": "每年花几个亿给你来循环水"
    },
    {
      "end": 3681.28,
      "start": 3675.6,
      "text": "你呼噜自己 那叫中南海 就那几勺子水 那叫中南海"
    },
    {
      "end": 3684.96,
      "start": 3681.28,
      "text": "陈希同这话 有名的中南海就这么来的"
    },
    {
      "end": 3689.76,
      "start": 3684.96,
      "text": "结果陈希同说 张北八说 我求求你了 大爷"
    },
    {
      "end": 3693.72,
      "start": 3689.76,
      "text": "你怎么别说了 行不行 咱都活两天行不行"
    },
    {
      "end": 3695.96,
      "start": 3693.96,
      "text": "朱镕基 江上就走了 你看 惹毒大火"
    },
    {
      "end": 3701.64,
      "start": 3695.96,
      "text": "还有 大家要注意到 除了中南空之处"
    },
    {
      "end": 3703.96,
      "start": 3701.64,
      "text": "记得大家都查到朱镕基 有一次吧"
    },
    {
      "end": 3706.68,
      "start": 3704.36,
      "text": "这个陈希同到中南海去"
    },
    {
      "end": 3709.64,
      "start": 3707.0,
      "text": "哎 希同 啥时候让我搬家"
    },
    {
      "end": 3711.76,
      "start": 3710.32,
      "text": "听说你帮我搬了吧"
    },
    {
      "end": 3713.88,
      "start": 3712.72,
      "text": "我都准备好了"
    },
    {
      "end": 3717.8,
      "start": 3714.12,
      "text": "因为陈希同发明了一个要把北京市搬出去"
    },
    {
      "end": 3721.64,
      "start": 3718.28,
      "text": "就是把那个中央 你搬到这个通州去吧"
    },
    {
      "end": 3724.36,
      "start": 3721.64,
      "text": "你搬大兴嘛 我这是北京市"
    },
    {
      "end": 3727.4,
      "start": 3724.36,
      "text": "就陈希同跟邓小平太好了 就狂到几点了"
    },
    {
      "end": 3730.6,
      "start": 3727.4,
      "text": "这也符合北京故乡的性质啊 也够狂"
    },
    {
      "end": 3732.04,
      "start": 3730.6,
      "text": "把中央摸手搬走"
    },
    {
      "end": 3734.36,
      "start": 3732.04,
      "text": "什么 朱镕基说 啥时候把我搬走啊"
    },
    {
      "end": 3738.68,
      "start": 3734.92,
      "text": "那时候结果是好嘛 你看看 全给他灭亡了"
    },
    {
      "end": 3739.88,
      "start": 3738.68,
      "text": "全灭亡了"
    },
    {
      "end": 3742.52,
      "start": 3739.88,
      "text": "更重要的事情 不再把你灭了"
    },
    {
      "end": 3746.68,
      "start": 3742.52,
      "text": "朱镕基见北京官员就说 哎 我们的随时准备搬哪"
    },
    {
      "end": 3748.04,
      "start": 3746.68,
      "text": "啥时候搬哪"
    },
    {
      "end": 3750.44,
      "start": 3748.6,
      "text": "曾庆红有一次 最牛的时候"
    },
    {
      "end": 3754.28,
      "start": 3750.44,
      "text": "曾庆红在北京 另外一次放言华"
    },
    {
      "end": 3756.68,
      "start": 3754.28,
      "text": "我给大家放言华的时候 贾庆林来北京"
    },
    {
      "end": 3759.8,
      "start": 3758.12,
      "text": "他说 庆林为啥你来北京啊"
    },
    {
      "end": 3765.08,
      "start": 3761.24,
      "text": "贾庆林是绝对是 最相信的铁哥们"
    },
    {
      "end": 3767.64,
      "start": 3765.08,
      "text": "就像咱们这战友包围的咱们战友一样"
    },
    {
      "end": 3769.48,
      "start": 3767.88,
      "text": "同生死亏亏万难的"
    },
    {
      "end": 3772.12,
      "start": 3770.04,
      "text": "曾庆红说 我告诉你 你就两个任务"
    },
    {
      "end": 3775.0,
      "start": 3773.0,
      "text": "保护江泽民党中央"
    },
    {
      "end": 3778.36,
      "start": 3775.2,
      "text": "第二个 把北京这个地方牢牢地控住"
    },
    {
      "end": 3783.4,
      "start": 3778.36,
      "text": "与中央挂开 当场拍拖揍人"
    },
    {
      "end": 3788.04,
      "start": 3784.6,
      "text": "在邓六斤家就是因为咽口吵架 我跟你说过很多次了"
    },
    {
      "end": 3792.36,
      "start": 3788.76,
      "text": "啥意思啊 江泽民干掉了这一系统 谁来了"
    },
    {
      "end": 3794.6,
      "start": 3792.6,
      "text": "魏建行你上一段待着去"
    },
    {
      "end": 3799.08,
      "start": 3794.6,
      "text": "我的哥们贾庆林来 贾庆林来干了啥的 北京城看到没有"
    },
    {
      "end": 3802.2,
      "start": 3799.08,
      "text": "所有金花几乎给你全部打掉"
    },
    {
      "end": 3807.88,
      "start": 3804.28,
      "text": "所以北京城是被隔离的戒严状态"
    },
    {
      "end": 3810.04,
      "start": 3807.88,
      "text": "从六四到现在就没改过"
    },
    {
      "end": 3815.16,
      "start": 3810.28,
      "text": "北京城 北京人 地道北京人活的是最郁闷的"
    },
    {
      "end": 3819.16,
      "start": 3816.12,
      "text": "在北京城干活最多是什么人 我告诉你啊"
    },
    {
      "end": 3822.04,
      "start": 3819.4,
      "text": "不是政府官员 也不是老师 也不是知识分子"
    },
    {
      "end": 3823.4,
      "start": 3822.2,
      "text": "出租车司机"
    },
    {
      "end": 3826.76,
      "start": 3824.92,
      "text": "还有一个就是什么 二房东"
    },
    {
      "end": 3829.48,
      "start": 3827.4,
      "text": "这北京城轮得很惨的"
    },
    {
      "end": 3831.96,
      "start": 3829.8,
      "text": "我们公司里边大多数都北京人嘛"
    },
    {
      "end": 3834.2,
      "start": 3832.36,
      "text": "我跟他们老聊北京 他们特别喜欢过聊"
    },
    {
      "end": 3835.96,
      "start": 3834.2,
      "text": "我们员工真的是爱死我了"
    },
    {
      "end": 3837.32,
      "start": 3835.96,
      "text": "北京人都最喜欢我"
    },
    {
      "end": 3840.12,
      "start": 3837.72,
      "text": "又我 我跟他们讲实话"
    },
    {
      "end": 3844.92,
      "start": 3840.12,
      "text": "我说哪有比北京都在惨的北京员工啊"
    },
    {
      "end": 3848.52,
      "start": 3844.92,
      "text": "北京籍的 如果你去到国家安全部门"
    },
    {
      "end": 3851.64,
      "start": 3848.52,
      "text": "或者国家情报部门 那是严重审核"
    },
    {
      "end": 3853.64,
      "start": 3851.64,
      "text": "比审核新疆人都严"
    },
    {
      "end": 3856.04,
      "start": 3853.64,
      "text": "新疆人老说我们不让我们住酒店呐"
    },
    {
      "end": 3858.2,
      "start": 3856.04,
      "text": "当那受歧视啊 我告诉你"
    },
    {
      "end": 3860.44,
      "start": 3858.2,
      "text": "北京人就在家自家门口最受歧视的"
    },
    {
      "end": 3862.04,
      "start": 3860.44,
      "text": "你到外地行 在北京不行"
    },
    {
      "end": 3866.2,
      "start": 3862.92,
      "text": "所以你看你到这个餐桌上走着你在北京城"
    },
    {
      "end": 3870.04,
      "start": 3866.2,
      "text": "你们见过几个金官耍的就像小皮匠"
    },
    {
      "end": 3874.44,
      "start": 3870.04,
      "text": "这种军事女的 没有"
    },
    {
      "end": 3880.36,
      "start": 3875.24,
      "text": "所以说 六四是北京的整个人线"
    },
    {
      "end": 3887.56,
      "start": 3880.92,
      "text": "担负着整个的 可以说是承担了整个六四以后的灾难结果"
    },
    {
      "end": 3892.76,
      "start": 3888.12,
      "text": "同样是北京六四 也让北京人在历史上创造了伟大"
    },
    {
      "end": 3899.24,
      "start": 3893.8,
      "text": "这个当时由陈希同张百发创造的金官高潮"
    },
    {
      "end": 3901.64,
      "start": 3899.24,
      "text": "再一去不复法了"
    },
    {
      "end": 3903.64,
      "start": 3901.64,
      "text": "所以我建议呢"
    },
    {
      "end": 3906.44,
      "start": 3903.64,
      "text": "佩尔西亚和小皮匠未来"
    },
    {
      "end": 3910.28,
      "start": 3906.44,
      "text": "你们能回去 爆料革命成功以后"
    },
    {
      "end": 3916.76,
      "start": 3910.28,
      "text": "能代表惊人 重新恢复惊人到应有的地位和尊严和辉煌"
    },
    {
      "end": 3925.16,
      "start": 3916.76,
      "text": "那现在习近平上台那不是又一轮洗牌啊"
    },
    {
      "end": 3928.6,
      "start": 3925.16,
      "text": "这就鲁德先生 你可爱的地方"
    },
    {
      "end": 3931.16,
      "start": 3928.6,
      "text": "你看Pricey他还是女孩子 还有这个体账"
    },
    {
      "end": 3935.24,
      "start": 3931.16,
      "text": "这体账 习近平 我刚才说到习家这块啊"
    },
    {
      "end": 3939.56,
      "start": 3935.56,
      "text": "习家最恨的也是北京城 这是北京的不行"
    },
    {
      "end": 3944.2,
      "start": 3940.76,
      "text": "他爹从监狱里边的时候出来了"
    },
    {
      "end": 3945.56,
      "start": 3944.2,
      "text": "邓小平答应他说"
    },
    {
      "end": 3947.56,
      "start": 3945.56,
      "text": "这个我让你说任大委员长"
    },
    {
      "end": 3951.0,
      "start": 3947.56,
      "text": "结果是不跟他委员长 又差点弄死他"
    },
    {
      "end": 3952.92,
      "start": 3951.0,
      "text": "最后是把他说 你去深圳吧"
    },
    {
      "end": 3955.56,
      "start": 3952.92,
      "text": "你甭来回来了 不让他回京"
    },
    {
      "end": 3959.88,
      "start": 3955.56,
      "text": "这个习近平小的时候 最惨的时候"
    },
    {
      "end": 3962.36,
      "start": 3959.88,
      "text": "他家在北京的时候 是被撵出京城"
    },
    {
      "end": 3966.36,
      "start": 3962.36,
      "text": "当年的安全部长康生曾经说过"
    },
    {
      "end": 3968.36,
      "start": 3966.36,
      "text": "用哪里人都不用北京人"
    },
    {
      "end": 3973.16,
      "start": 3968.36,
      "text": "凡是在北京有影响有思想都应该送到农村去"
    },
    {
      "end": 3975.56,
      "start": 3973.16,
      "text": "这个下乡啊就是把你北京人撵出去"
    },
    {
      "end": 3977.56,
      "start": 3975.56,
      "text": "第一个就撵着北京人"
    },
    {
      "end": 3981.56,
      "start": 3977.56,
      "text": "康生追杀习近平 他穿上他姐姐的那个花鞋"
    },
    {
      "end": 3987.56,
      "start": 3981.56,
      "text": "这个一夜走多少里度 多少次差点被杀了"
    },
    {
      "end": 3991.56,
      "start": 3987.56,
      "text": "后来到了西安 就是那个村里边的田书记"
    },
    {
      "end": 3994.56,
      "start": 3991.56,
      "text": "把他给藏在那个地瓜窖里面"
    },
    {
      "end": 3999.56,
      "start": 3994.56,
      "text": "就挖地瓜窖 下面放着地瓜 在地瓜窖里面"
    },
    {
      "end": 4002.56,
      "start": 3999.56,
      "text": "有时候把他给忘了 他在底下咕噗噗噗爬上来"
    },
    {
      "end": 4003.56,
      "start": 4002.56,
      "text": "饿死了都快"
    },
    {
      "end": 4007.56,
      "start": 4003.56,
      "text": "然后结果发现 茄子长出来了 就吃茄子"
    },
    {
      "end": 4010.56,
      "start": 4007.56,
      "text": "就吃生茄子 吃到自己前面 一说茄子都吐"
    },
    {
      "end": 4015.56,
      "start": 4010.56,
      "text": "你要给江西里面照相 茄子 他立马吐了"
    },
    {
      "end": 4017.56,
      "start": 4015.56,
      "text": "你要端一边儿茄子 那就找死了"
    },
    {
      "end": 4020.56,
      "start": 4017.56,
      "text": "他就听茄子 看茄子就晕"
    },
    {
      "end": 4024.56,
      "start": 4020.56,
      "text": "所以说当时是 习是被撵出京城的"
    },
    {
      "end": 4029.56,
      "start": 4024.56,
      "text": "全家被演出京城的 他父亲的前妻的一个女的"
    },
    {
      "end": 4034.56,
      "start": 4029.56,
      "text": "是上吊在京城的 远平和自在北京是被虐待的"
    },
    {
      "end": 4037.56,
      "start": 4034.56,
      "text": "习近平在大院里边儿 当时跟那个国谢来玩儿"
    },
    {
      "end": 4042.56,
      "start": 4037.56,
      "text": "是被国谢来给打的 所有习家伤心力都是北京城"
    },
    {
      "end": 4048.56,
      "start": 4042.56,
      "text": "他对北京人就不感情一套了 习就觉得要玩儿流氓"
    },
    {
      "end": 4053.56,
      "start": 4048.56,
      "text": "要让打架 福建人 黑白杆杆"
    },
    {
      "end": 4057.56,
      "start": 4053.56,
      "text": "在崇拜的是上海人 江泽人 喜欢死了"
    },
    {
      "end": 4062.56,
      "start": 4057.56,
      "text": "一讲去江泽人就信头来了 北京人咬牙跟着"
    },
    {
      "end": 4066.56,
      "start": 4062.56,
      "text": "这北京人 恨死了 你看他旁边有北京人吗"
    },
    {
      "end": 4069.56,
      "start": 4066.56,
      "text": "一个都没有零 分子北京"
    },
    {
      "end": 4071.56,
      "start": 4069.56,
      "text": "就习家的伤心力就是北京"
    },
    {
      "end": 4074.56,
      "start": 4071.56,
      "text": "所以现在你看到 习上来以后"
    },
    {
      "end": 4079.56,
      "start": 4074.56,
      "text": "北京人 东北人几乎你不用 你甭想"
    },
    {
      "end": 4083.56,
      "start": 4079.56,
      "text": "他对黄河以北的人 包括河南他老家"
    },
    {
      "end": 4086.56,
      "start": 4083.56,
      "text": "他老家真正是河南人 黄河以北的"
    },
    {
      "end": 4089.56,
      "start": 4086.56,
      "text": "他基本上看不起 看不上"
    },
    {
      "end": 4093.56,
      "start": 4089.56,
      "text": "对北京当地的咬牙切齿"
    },
    {
      "end": 4098.56,
      "start": 4093.56,
      "text": "最恨共产党的 绝对不是我们 绝对是习近平"
    },
    {
      "end": 4102.56,
      "start": 4098.56,
      "text": "他恨不上去 他现在又拿你用啊 你知道吗"
    },
    {
      "end": 4106.56,
      "start": 4102.56,
      "text": "就拿你用 这是变态的就是 现在成我的了"
    },
    {
      "end": 4109.56,
      "start": 4106.56,
      "text": "他要把哥们脑子叫你死几回才不拉倒"
    },
    {
      "end": 4111.56,
      "start": 4109.56,
      "text": "还有个就是北京 恨死北京了"
    },
    {
      "end": 4115.56,
      "start": 4111.56,
      "text": "当年我在这儿啥怎么行 现在他住在毛主席的故居"
    },
    {
      "end": 4118.56,
      "start": 4115.56,
      "text": "他得添的啥感觉啊 说你难听话"
    },
    {
      "end": 4120.56,
      "start": 4118.56,
      "text": "这都属于心里不正常"
    },
    {
      "end": 4122.56,
      "start": 4120.56,
      "text": "当年你把我们家给演什么 这毛泽东"
    },
    {
      "end": 4124.56,
      "start": 4122.56,
      "text": "你没想到老子住在你屋里边吧"
    },
    {
      "end": 4126.56,
      "start": 4124.56,
      "text": "他天哪有的骂多少遍啊"
    },
    {
      "end": 4128.56,
      "start": 4126.56,
      "text": "在个北京人 看北京人就不是眼"
    },
    {
      "end": 4132.56,
      "start": 4128.56,
      "text": "听这小皮镜 还有拍起这种北京音"
    },
    {
      "end": 4134.56,
      "start": 4132.56,
      "text": "你在那边人说话 你惨了"
    },
    {
      "end": 4136.56,
      "start": 4134.56,
      "text": "弄不好就把你俩给活剥了"
    },
    {
      "end": 4138.56,
      "start": 4136.56,
      "text": "不跟你开玩笑 他烦死了"
    },
    {
      "end": 4142.56,
      "start": 4138.56,
      "text": "有几次吃饭就是有那北京人说话"
    },
    {
      "end": 4144.56,
      "start": 4142.56,
      "text": "就是叭叭叭叭的 习近平原来啊"
    },
    {
      "end": 4146.56,
      "start": 4144.56,
      "text": "他在厦门的时候"
    },
    {
      "end": 4150.56,
      "start": 4146.56,
      "text": "习近平就说能不能找这些精啪的"
    },
    {
      "end": 4152.56,
      "start": 4150.56,
      "text": "得不得得不得了 沾边呆了"
    },
    {
      "end": 4155.56,
      "start": 4152.56,
      "text": "他后来到了上海以后就知道"
    },
    {
      "end": 4158.56,
      "start": 4155.56,
      "text": "这可能当皇帝了 他最爱去的就是北京饭店"
    },
    {
      "end": 4162.56,
      "start": 4158.56,
      "text": "就是心意 楼上有个大房间一整层"
    },
    {
      "end": 4166.56,
      "start": 4162.56,
      "text": "就是给周恩来老来吃饭的 恒温啊 然后如何如何的"
    },
    {
      "end": 4171.56,
      "start": 4166.56,
      "text": "里边有休息啊 中午休息的 几个房间都有啊 特殊电梯啊"
    },
    {
      "end": 4175.56,
      "start": 4171.56,
      "text": "一个北京人怎么让 他所有来的都是江泽人"
    },
    {
      "end": 4179.56,
      "start": 4175.56,
      "text": "所以说 布兰西啊 皮小皮匠挺可怜的"
    },
    {
      "end": 4182.56,
      "start": 4179.56,
      "text": "共产党不灭 你俩也就别回去了 回去也挺惨的"
    },
    {
      "end": 4185.56,
      "start": 4182.56,
      "text": "真不敢回去了"
    },
    {
      "end": 4190.56,
      "start": 4187.56,
      "text": "没想到我们北京就早已经被新疆化了"
    },
    {
      "end": 4192.56,
      "start": 4190.56,
      "text": "对啊"
    },
    {
      "end": 4196.56,
      "start": 4193.56,
      "text": "昨天这些群众 人民群众都是从外地拉过去的"
    },
    {
      "end": 4198.56,
      "start": 4196.56,
      "text": "几乎没有邮人"
    },
    {
      "end": 4201.56,
      "start": 4198.56,
      "text": "都是演员 早就演了半年了也是"
    },
    {
      "end": 4203.56,
      "start": 4201.56,
      "text": "确实是唯有这感觉"
    },
    {
      "end": 4208.56,
      "start": 4203.56,
      "text": "好像是从20就是我是零几年出来的嘛"
    },
    {
      "end": 4211.56,
      "start": 4208.56,
      "text": "就每年回国的时候就会发现一点一点的"
    },
    {
      "end": 4215.56,
      "start": 4211.56,
      "text": "真是大街上听见能说北京话的人就少了"
    },
    {
      "end": 4218.56,
      "start": 4215.56,
      "text": "偶尔遇上一个吧 就跟看见大熊猫似的"
    },
    {
      "end": 4220.56,
      "start": 4218.56,
      "text": "不是你有这感觉吗"
    },
    {
      "end": 4225.56,
      "start": 4220.56,
      "text": "我想澄清一下 我刚才看了留言"
    },
    {
      "end": 4228.56,
      "start": 4225.56,
      "text": "说我们是北京人有优越感"
    },
    {
      "end": 4232.56,
      "start": 4228.56,
      "text": "其实我们两个 刚才还有路德我相信提问这问题"
    },
    {
      "end": 4234.56,
      "start": 4232.56,
      "text": "根本就没有带着这种意思"
    },
    {
      "end": 4236.56,
      "start": 4234.56,
      "text": "就是地区歧视根本就没有"
    },
    {
      "end": 4239.56,
      "start": 4236.56,
      "text": "像我自己不是北京户口长多少年了"
    },
    {
      "end": 4243.56,
      "start": 4240.56,
      "text": "其实北京人很多 他不是什么叫北京人"
    },
    {
      "end": 4247.56,
      "start": 4243.56,
      "text": "就是很多在北京的可能大家都有二分之一"
    },
    {
      "end": 4251.56,
      "start": 4247.56,
      "text": "可能就是从外地毕业大学毕业在北京生活了几十年"
    },
    {
      "end": 4255.56,
      "start": 4251.56,
      "text": "这些全是在北京生活的人 不是北京人"
    },
    {
      "end": 4257.56,
      "start": 4255.56,
      "text": "我就想给北京人挣一下名"
    },
    {
      "end": 4259.56,
      "start": 4257.56,
      "text": "这是也给我们自己挣一下名"
    },
    {
      "end": 4265.56,
      "start": 4259.56,
      "text": "就是 至于说北京 我觉得国家上说的全对"
    },
    {
      "end": 4275.56,
      "start": 4265.56,
      "text": "我都不好意思再说了 我就说那么多"
    },
    {
      "end": 4280.56,
      "start": 4275.56,
      "text": "好的 那个小比较Presy看我们时间差不多了"
    },
    {
      "end": 4284.56,
      "start": 4280.56,
      "text": "我们时间差不多了 接下来还有后面安红的 好不好"
    },
    {
      "end": 4288.56,
      "start": 4284.56,
      "text": "好嘞 没问题 安红也是咱北京姑娘"
    },
    {
      "end": 4290.56,
      "start": 4288.56,
      "text": "都是北京姑奶奶"
    },
    {
      "end": 4294.56,
      "start": 4290.56,
      "text": "好 那我们联系就到这里 我去连安红"
    },
    {
      "end": 4296.56,
      "start": 4294.56,
      "text": "好的 好嘞 好嘞 行"
    },
    {
      "end": 4298.56,
      "start": 4296.56,
      "text": "谢谢 谢谢Presy"
    },
    {
      "end": 4300.56,
      "start": 4298.56,
      "text": "谢谢郭先生"
    },
    {
      "end": 4302.56,
      "start": 4300.56,
      "text": "我们不歧视你们 我们爱你们"
    },
    {
      "end": 4303.56,
      "start": 4302.56,
      "text": "哈哈哈哈"
    },
    {
      "end": 4307.56,
      "start": 4303.56,
      "text": "我们也爱您 不过我们还是以我们为北京人感到骄傲"
    },
    {
      "end": 4308.56,
      "start": 4307.56,
      "text": "对吧 Presy"
    },
    {
      "end": 4310.56,
      "start": 4308.56,
      "text": "没错 没错"
    },
    {
      "end": 4313.56,
      "start": 4310.56,
      "text": "我们都是北京人 谢谢Presy"
    },
    {
      "end": 4315.56,
      "start": 4313.56,
      "text": "谢谢Presy 谢谢郭先生 谢谢路德 再见"
    },
    {
      "end": 4320.56,
      "start": 4318.56,
      "text": "好 这美国 看看一会儿啊"
    },
    {
      "end": 4330.56,
