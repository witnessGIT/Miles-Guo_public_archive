  "segments": [
    {
      "end": 9004.1,
      "start": 9000.0,
      "text": "老百姓的和我們普通民眾的這樣的財富問題上"
    },
    {
      "end": 9005.88,
      "start": 9004.36,
      "text": "加以簡單的剖析"
    },
    {
      "end": 9008.44,
      "start": 9006.14,
      "text": "就在這個國慶國殤日"
    },
    {
      "end": 9012.04,
      "start": 9008.7,
      "text": "你們就是這個中共政權這個邪教政府"
    },
    {
      "end": 9017.16,
      "start": 9012.28,
      "text": "在這裡進行閱兵和展示他的財力和他的這個軍力的同時"
    },
    {
      "end": 9020.48,
      "start": 9017.4,
      "text": "我們用幾組數字來比較一下"
    },
    {
      "end": 9023.04,
      "start": 9020.74,
      "text": "中國人在中共的統治下"
    },
    {
      "end": 9025.08,
      "start": 9024.06,
      "text": "現在究竟"
    },
    {
      "end": 9027.64,
      "start": 9025.34,
      "text": "生活的是怎麼樣一個水平"
    },
    {
      "end": 9029.94,
      "start": 9027.64,
      "text": "所以這裡邊呢"
    },
    {
      "end": 9032.0,
      "start": 9030.2,
      "text": "首先我們先問一個問題"
    },
    {
      "end": 9034.3,
      "start": 9032.5,
      "text": "對中國國內的民眾"
    },
    {
      "end": 9035.58,
      "start": 9034.8,
      "text": "不妨"
    },
    {
      "end": 9037.36,
      "start": 9035.84,
      "text": "實實在在的回答自己"
    },
    {
      "end": 9041.98,
      "start": 9037.62,
      "text": "不用去騙別人不用騙政府不用騙你親周圍的親戚朋友"
    },
    {
      "end": 9043.26,
      "start": 9042.24,
      "text": "你一個月"
    },
    {
      "end": 9045.56,
      "start": 9043.52,
      "text": "你們家吃幾次牛肉"
    },
    {
      "end": 9049.4,
      "start": 9046.32,
      "text": "就是這是一個很簡單的問題現在咱們提不提豬肉"
    },
    {
      "end": 9050.42,
      "start": 9049.66,
      "text": "提牛肉"
    },
    {
      "end": 9052.48,
      "start": 9051.2,
      "text": "那麼據統計"
    },
    {
      "end": 9055.04,
      "start": 9052.98,
      "text": "世界上的牛肉這個消費"
    },
    {
      "end": 9057.6,
      "start": 9055.04,
      "text": "中國人的這個平均"
    },
    {
      "end": 9058.62,
      "start": 9057.86,
      "text": "人均牛肉"
    },
    {
      "end": 9059.9,
      "start": 9058.88,
      "text": "消費在世界上"
    },
    {
      "end": 9061.96,
      "start": 9060.16,
      "text": "排在第47位"
    },
    {
      "end": 9063.48,
      "start": 9062.72,
      "text": "人均"
    },
    {
      "end": 9064.52,
      "start": 9063.74,
      "text": "注意這個詞"
    },
    {
      "end": 9065.28,
      "start": 9064.76,
      "text": "人均"
    },
    {
      "end": 9065.8,
      "start": 9065.54,
      "text": "年"
    },
    {
      "end": 9067.58,
      "start": 9066.04,
      "text": "12.2磅"
    },
    {
      "end": 9069.64,
      "start": 9068.1,
      "text": "也就是5公斤左右"
    },
    {
      "end": 9071.68,
      "start": 9070.92,
      "text": "那麼這個"
    },
    {
      "end": 9073.48,
      "start": 9071.94,
      "text": "12.2磅別忘了這是"
    },
    {
      "end": 9074.24,
      "start": 9073.72,
      "text": "人均"
    },
    {
      "end": 9075.0,
      "start": 9074.5,
      "text": "那麼我們"
    },
    {
      "end": 9076.04,
      "start": 9075.26,
      "text": "往山西"
    },
    {
      "end": 9076.54,
      "start": 9076.54,
      "text": "!"
    },
    {
      "end": 9076.54,
      "start": 9076.54,
      "text": "!"
    },
    {
      "end": 9076.8,
      "start": 9076.54,
      "text": "!"
    },
    {
      "end": 9077.32,
      "start": 9076.8,
      "text": "!"
    },
    {
      "end": 9077.56,
      "start": 9077.56,
      "text": "!"
    },
    {
      "end": 9077.56,
      "start": 9077.56,
      "text": "!"
    },
    {
      "end": 9077.82,
      "start": 9077.56,
      "text": "!"
    },
    {
      "end": 9085.8,
      "start": 9085.04,
      "text": "農村地區"
    },
    {
      "end": 9087.6,
      "start": 9086.06,
      "text": "他自己養牛不算啊"
    },
    {
      "end": 9089.4,
      "start": 9087.86,
      "text": "很多農村地區的"
    },
    {
      "end": 9090.68,
      "start": 9089.64,
      "text": "這些大人孩子"
    },
    {
      "end": 9092.98,
      "start": 9090.92,
      "text": "他可能連牛肉什麼味他都不知道"
    },
    {
      "end": 9094.76,
      "start": 9093.74,
      "text": "這一輩子不知道什麼"
    },
    {
      "end": 9095.54,
      "start": 9095.02,
      "text": "牛肉"
    },
    {
      "end": 9096.04,
      "start": 9095.8,
      "text": "什麼味"
    },
    {
      "end": 9097.58,
      "start": 9096.56,
      "text": "這個問題沒有誇張"
    },
    {
      "end": 9100.66,
      "start": 9097.84,
      "text": "其實我記得我還不大的時候從農村到我家的親戚"
    },
    {
      "end": 9102.44,
      "start": 9100.92,
      "text": "買一種海鮮給他吃"
    },
    {
      "end": 9104.24,
      "start": 9102.96,
      "text": "這個孩子都1415歲"
    },
    {
      "end": 9107.82,
      "start": 9104.48,
      "text": "這個東西這麼好吃的居然不知道這個東西叫那種"
    },
    {
      "end": 9109.6,
      "start": 9108.08,
      "text": "叫那種就對蝦呀"
    },
    {
      "end": 9111.92,
      "start": 9110.12,
      "text": "1415歲的孩子不知道什麼是對蝦"
    },
    {
      "end": 9115.24,
      "start": 9113.2,
      "text": "那麼我們這裡所說的這個人均"
    },
    {
      "end": 9116.26,
      "start": 9115.5,
      "text": "12磅"
    },
    {
      "end": 9117.28,
      "start": 9116.78,
      "text": "說明什麼"
    },
    {
      "end": 9123.44,
      "start": 9117.54,
      "text": "就真正中央省級市級的領導幹部消費了這大部分的人均值"
    },
    {
      "end": 9125.22,
      "start": 9123.68,
      "text": "而很多地區甚至"
    },
    {
      "end": 9127.78,
      "start": 9125.48,
      "text": "一年都吃不上兩三次牛肉"
    },
    {
      "end": 9133.66,
      "start": 9127.78,
      "text": "這就是中共統治下老百姓現在對牛肉這樣一個消費來顯示"
    },
    {
      "end": 9135.72,
      "start": 9133.92,
      "text": "我們跟西方發達國家"
    },
    {
      "end": 9137.5,
      "start": 9135.98,
      "text": "跟普通的國家"
    },
    {
      "end": 9140.06,
      "start": 9137.76,
      "text": "比如說阿曼啊多米尼加呀"
    },
    {
      "end": 9141.6,
      "start": 9140.32,
      "text": "還有什麼巴基斯坦"
    },
    {
      "end": 9145.18,
      "start": 9142.12,
      "text": "我們都不如人家的這個人均牛肉消費量"
    },
    {
      "end": 9147.74,
      "start": 9145.44,
      "text": "所以說中共所暫時的虛假"
    },
    {
      "end": 9149.54,
      "start": 9148.0,
      "text": "代替不了我們的肚子"
    },
    {
      "end": 9151.08,
      "start": 9149.8,
      "text": "代替不了我們的口味"
    },
    {
      "end": 9153.12,
      "start": 9151.84,
      "text": "那麼為什麼中共"
    },
    {
      "end": 9154.92,
      "start": 9153.64,
      "text": "統治下的老百姓"
    },
    {
      "end": 9157.74,
      "start": 9155.18,
      "text": "他到今天為止他還滿足不了牛肉"
    },
    {
      "end": 9159.06,
      "start": 9158.04,
      "text": "豬肉的消費量"
    },
    {
      "end": 9161.62,
      "start": 9159.58,
      "text": "我們不妨用一組數字"
    },
    {
      "end": 9163.66,
      "start": 9161.88,
      "text": "再來解釋一下"
    },
    {
      "end": 9165.98,
      "start": 9164.94,
      "text": "就是根據"
    },
    {
      "end": 9167.76,
      "start": 9166.22,
      "text": "貨幣的發行量"
    },
    {
      "end": 9170.58,
      "start": 9168.02,
      "text": "和他的信貸投放額來說"
    },
    {
      "end": 9172.12,
      "start": 9171.1,
      "text": "我給大家知道"
    },
    {
      "end": 9173.9,
      "start": 9172.62,
      "text": "1978年"
    },
    {
      "end": 9177.74,
      "start": 9174.42,
      "text": "100塊錢人民幣現在相當於多少錢呢"
    },
    {
      "end": 9179.28,
      "start": 9178.52,
      "text": "16萬"
    },
    {
      "end": 9181.34,
      "start": 9180.06,
      "text": "16萬人民幣"
    },
    {
      "end": 9184.66,
      "start": 9181.58,
      "text": "這個有公式的到2017年年底呢是"
    },
    {
      "end": 9188.5,
      "start": 9185.42,
      "text": "100塊錢呢相當於144,600元人民幣"
    },
    {
      "end": 9190.54,
      "start": 9188.76,
      "text": "但是呢"
    },
    {
      "end": 9194.14,
      "start": 9190.8,
      "text": "17年18年去年的這個又投放了200多億的這個"
    },
    {
      "end": 9195.92,
      "start": 9194.38,
      "text": "信貸和這個貨幣發行"
    },
    {
      "end": 9197.72,
      "start": 9196.18,
      "text": "這個數字呢就預估"
    },
    {
      "end": 9199.0,
      "start": 9197.98,
      "text": "是16萬"
    },
    {
      "end": 9200.54,
      "start": 9199.26,
      "text": "而同期呢"
    },
    {
      "end": 9201.56,
      "start": 9200.78,
      "text": "美元也在貶值"
    },
    {
      "end": 9202.58,
      "start": 9201.82,
      "text": "毫無疑問"
    },
    {
      "end": 9205.4,
      "start": 9202.84,
      "text": "100美元相當於現在的多少錢呢"
    },
    {
      "end": 9206.68,
      "start": 9205.66,
      "text": "1978年"
    },
    {
      "end": 9209.5,
      "start": 9206.94,
      "text": "100美元相當於現在的"
    },
    {
      "end": 9212.32,
      "start": 9209.76,
      "text": "673.6美元"
    },
    {
      "end": 9213.6,
      "start": 9213.08,
      "text": "什麼意思"
    },
    {
      "end": 9214.36,
      "start": 9213.86,
      "text": "什麼概念"
    },
    {
      "end": 9218.46,
      "start": 9215.14,
      "text": "中國的貨幣貶值了1600倍"
    },
    {
      "end": 9220.0,
      "start": 9218.98,
      "text": "而同期"
    },
    {
      "end": 9224.34,
      "start": 9220.5,
      "text": "這個美元貶值了6.736倍"
    },
    {
      "end": 9227.68,
      "start": 9225.88,
      "text": "那麼我們往下看下一組數字"
    },
    {
      "end": 9229.46,
      "start": 9228.44,
      "text": "人民幣"
    },
    {
      "end": 9231.0,
      "start": 9229.72,
      "text": "貶值了1600倍"
    },
    {
      "end": 9232.54,
      "start": 9231.26,
      "text": "那我們的收入"
    },
    {
      "end": 9235.1,
      "start": 9232.8,
      "text": "是否根據這個人民幣的貶值"
    },
    {
      "end": 9237.14,
      "start": 9235.36,
      "text": "而做出了相應的"
    },
    {
      "end": 9238.94,
      "start": 9237.14,
      "text": "對等的這樣的增長呢"
    },
    {
      "end": 9241.74,
      "start": 9239.7,
      "text": "我們拿一個比較典型的"
    },
    {
      "end": 9244.82,
      "start": 9242.0,
      "text": "發達的沿海地區的這樣一個城市"
    },
    {
      "end": 9246.1,
      "start": 9245.08,
      "text": "青島來比喻"
    },
    {
      "end": 9248.14,
      "start": 9247.12,
      "text": "過去的這個"
    },
    {
      "end": 9248.92,
      "start": 9248.4,
      "text": "40年"
    },
    {
      "end": 9251.48,
      "start": 9249.68,
      "text": "青島的人均收入"
    },
    {
      "end": 9253.02,
      "start": 9251.74,
      "text": "平均增長多少"
    },
    {
      "end": 9254.04,
      "start": 9253.26,
      "text": "134倍"
    },
    {
      "end": 9256.86,
      "start": 9255.06,
      "text": "跟1600倍相比"
    },
    {
      "end": 9257.88,
      "start": 9257.36,
      "text": "相差"
    },
    {
      "end": 9258.9,
      "start": 9258.14,
      "text": "10倍之多"
    },
    {
      "end": 9260.18,
      "start": 9259.42,
      "text": "這還是青島"
    },
    {
      "end": 9262.22,
      "start": 9260.7,
      "text": "實際上過去70年"
    },
    {
      "end": 9264.28,
      "start": 9262.48,
      "text": "中國官方公佈的數據"
    },
    {
      "end": 9267.1,
      "start": 9264.78,
      "text": "中國人均收入過去70年"
    },
    {
      "end": 9269.18,
      "start": 9267.66,
      "text": "中共上台之後"
    },
    {
      "end": 9271.74,
      "start": 9269.7,
      "text": "過去70年中共"
    },
    {
      "end": 9273.54,
      "start": 9272.0,
      "text": "統治下的老百姓"
    },
    {
      "end": 9274.82,
      "start": 9273.8,
      "text": "人均收入"
    },
    {
      "end": 9275.84,
      "start": 9275.08,
      "text": "增長"
    },
    {
      "end": 9276.62,
      "start": 9276.1,
      "text": "60倍"
    },
    {
      "end": 9280.7,
      "start": 9277.38,
      "text": "而你七八年以來的貨幣已經增長了1600倍"
    },
    {
      "end": 9281.74,
      "start": 9281.22,
      "text": "這個"
    },
    {
      "end": 9282.76,
      "start": 9281.98,
      "text": "通貨膨脹率"
    },
    {
      "end": 9285.32,
      "start": 9284.3,
      "text": "那麼在這種"
    },
    {
      "end": 9287.36,
      "start": 9285.82,
      "text": "貨幣巨額的這個"
    },
    {
      "end": 9289.42,
      "start": 9288.38,
      "text": "貶值之下"
    },
    {
      "end": 9293.0,
      "start": 9289.68,
      "text": "我們看一看我們"
    },
    {
      "end": 9295.06,
      "start": 9293.52,
      "text": "一小時的工資來比較"
    },
    {
      "end": 9296.34,
      "start": 9295.56,
      "text": "下一則數字"
    },
    {
      "end": 9298.12,
      "start": 9296.58,
      "text": "以簡單的加拿大來對比"
    },
    {
      "end": 9300.16,
      "start": 9298.64,
      "text": "其實加拿大的這個"
    },
    {
      "end": 9301.96,
      "start": 9300.68,
      "text": "工作效率啊"
    },
    {
      "end": 9303.76,
      "start": 9302.22,
      "text": "或者它的創造力啊"
    },
    {
      "end": 9306.32,
      "start": 9304.26,
      "text": "沒有辦法跟中國人"
    },
    {
      "end": 9308.1,
      "start": 9306.56,
      "text": "中國的勞動者相比"
    },
    {
      "end": 9308.88,
      "start": 9308.36,
      "text": "實實在在"
    },
    {
      "end": 9309.9,
      "start": 9309.12,
      "text": "因為我身在加拿大"
    },
    {
      "end": 9311.68,
      "start": 9310.16,
      "text": "深知道這裡邊呢"
    },
    {
      "end": 9313.74,
      "start": 9311.94,
      "text": "我們中國人的這種聰明"
    },
    {
      "end": 9315.02,
      "start": 9314.0,
      "text": "這種才智"
    },
    {
      "end": 9316.3,
      "start": 9315.28,
      "text": "和這種勤勞"
    },
    {
      "end": 9317.32,
      "start": 9316.56,
      "text": "還有節儉"
    },
    {
      "end": 9319.62,
      "start": 9318.08,
      "text": "那麼我們以小時工資"
    },
    {
      "end": 9321.16,
      "start": 9320.14,
      "text": "來進行"
    },
    {
      "end": 9322.18,
      "start": 9321.68,
      "text": "比對"
    },
    {
      "end": 9323.98,
      "start": 9322.7,
      "text": "在加拿大的"
    },
    {
      "end": 9325.76,
      "start": 9324.24,
      "text": "最低每小時工資"
    },
    {
      "end": 9327.04,
      "start": 9326.28,
      "text": "可以買"
    },
    {
