{
  "chunk_audio_sha256": "5e8c6a51e5f34bb8b1eaad2a6c9d099ee9d213ec2b1fa438e22d7450972a6b22",
  "chunk_index": 6,
  "completed_at": "2026-10-20T02:41:50Z",
  "language": "zh",
  "live_id": "LIVE_20191001_001",
  "media_committed_to_git": false,
