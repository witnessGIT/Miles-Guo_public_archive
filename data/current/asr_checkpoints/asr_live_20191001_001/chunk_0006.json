  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 5402.62,
      "start": 5400.0,
      "text": "他也给老白白发买了无数的西装"
    },
    {
      "end": 5403.78,
      "start": 5402.62,
      "text": "所有衣服都给他买"
    },
    {
      "end": 5406.84,
      "start": 5403.78,
      "text": "他也穿着学我穿那个史蒂米·拉瑞奇"
    },
    {
      "end": 5410.56,
      "start": 5407.8,
      "text": "史蒂米·拉瑞奇这个店里边的女孩是个北京姑娘"
    },
    {
      "end": 5412.84,
      "start": 5410.84,
      "text": "这个女孩跳舞出身"
    },
    {
      "end": 5413.96,
      "start": 5412.84,
      "text": "哎呀真漂亮"
    },
    {
      "end": 5416.96,
      "start": 5414.72,
      "text": "这个女孩把我给骗了15万块钱"
    },
    {
      "end": 5418.68,
      "start": 5416.96,
      "text": "为啥呀 有一次突然找我去"
    },
    {
      "end": 5421.28,
      "start": 5419.04,
      "text": "这个说郭先生给我急着找你"
    },
    {
      "end": 5423.44,
      "start": 5421.28,
      "text": "你说老公我夫就来了"
    },
    {
      "end": 5425.88,
      "start": 5423.44,
      "text": "他说我家有什么事借15万块钱"
    },
    {
      "end": 5426.76,
      "start": 5425.88,
      "text": "我就给他了"
    },
    {
      "end": 5428.36,
      "start": 5426.76,
      "text": "结果这女孩再也没还给我过"
    },
    {
      "end": 5431.12,
      "start": 5428.36,
      "text": "后来这个女孩就跟了阎斌了"
    },
    {
      "end": 5432.36,
      "start": 5431.12,
      "text": "你知道吗"
    },
    {
      "end": 5434.76,
      "start": 5432.36,
      "text": "这个女孩跟了阎斌后来给阎斌搞的"
    },
    {
      "end": 5435.92,
      "start": 5434.76,
      "text": "阎斌弄得很惨"
    },
    {
      "end": 5438.56,
      "start": 5435.92,
      "text": "他家里人给他弄得非常非常大方"
    },
    {
      "end": 5440.16,
      "start": 5438.56,
      "text": "张百发有一次跟我说"
    },
    {
      "end": 5441.16,
      "start": 5440.16,
      "text": "他说你知道吗文贵"
    },
    {
      "end": 5444.16,
      "start": 5441.16,
      "text": "就那个卖衣服的女孩也姓张"
    },
    {
      "end": 5447.96,
      "start": 5444.16,
      "text": "找到我这来了人家怀孕了"
    },
    {
      "end": 5450.92,
      "start": 5447.96,
      "text": "把人家祸害成那样这个阎斌"
    },
    {
      "end": 5452.36,
      "start": 5450.92,
      "text": "专货害北京姑娘"
    },
    {
      "end": 5453.96,
      "start": 5452.36,
      "text": "北京姑娘杀手"
    },
    {
      "end": 5456.96,
      "start": 5453.96,
      "text": "杨伟百发说"
    },
    {
      "end": 5459.72,
      "start": 5456.96,
      "text": "这个混蛋给人家的车给人要回来"
    },
    {
      "end": 5461.56,
      "start": 5459.72,
      "text": "给人买的房子给人要回来"
    },
    {
      "end": 5463.36,
      "start": 5461.56,
      "text": "你说严斌有多快给他买房子"
    },
    {
      "end": 5465.16,
      "start": 5463.36,
      "text": "估计提供虚假文件"
    },
    {
      "end": 5466.76,
      "start": 5465.16,
      "text": "房战证办完了"
    },
    {
      "end": 5468.52,
      "start": 5466.76,
      "text": "人家也还原了也打贷了"
    },
    {
      "end": 5471.72,
      "start": 5468.52,
      "text": "说以虚假文件不实为明报案了警察"
    },
    {
      "end": 5474.72,
      "start": 5471.72,
      "text": "这都是严斌的故事"
    },
    {
      "end": 5476.72,
      "start": 5474.72,
      "text": "但是你说百发这个人"
    },
    {
      "end": 5479.92,
      "start": 5476.72,
      "text": "他能厉害就是这人他能跟他相处"
    },
    {
      "end": 5483.32,
      "start": 5479.92,
      "text": "而且他真阻止了很多北京姑娘被害"
    },
    {
      "end": 5484.92,
      "start": 5483.32,
      "text": "据说最近严斌啊"
    },
    {
      "end": 5486.48,
      "start": 5484.92,
      "text": "你看严斌被抓进去啊"
    },
    {
      "end": 5487.32,
      "start": 5486.48,
      "text": "他抓过很多回了"
    },
    {
      "end": 5489.48,
      "start": 5487.32,
      "text": "严斌最近不叫中国严斌了"
    },
    {
      "end": 5491.32,
      "start": 5489.48,
      "text": "叫另外一个什么英文名"
    },
    {
      "end": 5493.52,
      "start": 5491.32,
      "text": "在伦敦有一个酒店"
    },
    {
      "end": 5496.96,
      "start": 5493.52,
      "text": "在伦敦有很多会所"
    },
    {
      "end": 5504.72,
      "start": 5496.96,
      "text": "严斌是共产党的太子党里边的男女玩和洗钱的白手套"
    },
    {
      "end": 5508.46,
      "start": 5504.72,
      "text": "红牛这个饮料做假账"
    },
    {
      "end": 5510.26,
      "start": 5508.46,
      "text": "做到一千倍以上"
    },
    {
      "end": 5513.26,
      "start": 5510.26,
      "text": "我当时我跟一个银行行长说"
    },
    {
      "end": 5515.54,
      "start": 5513.26,
      "text": "我说严斌他怎么弄"
    },
    {
      "end": 5516.5,
      "start": 5515.54,
      "text": "他有什么价值"
    },
    {
      "end": 5518.08,
      "start": 5516.5,
      "text": "老哥我告诉你啊"
    },
    {
      "end": 5522.72,
      "start": 5518.08,
      "text": "严斌这个饮料跟水啊谁也不知道他卖几罐"
    },
    {
      "end": 5526.08,
      "start": 5522.72,
      "text": "他卖一罐他在后面写十个零"
    },
    {
      "end": 5529.08,
      "start": 5526.08,
      "text": "他说他所有贷款全是假的"
    },
    {
      "end": 5534.88,
      "start": 5529.08,
      "text": "他说他在共产党这些人的心目中最大的严斌的好处"
    },
    {
      "end": 5537.08,
      "start": 5534.88,
      "text": "这祸是你让他死就死"
    },
    {
      "end": 5538.78,
      "start": 5537.08,
      "text": "你让他舔屁股就舔屁股"
    },
    {
      "end": 5540.38,
      "start": 5538.78,
      "text": "你让他舔脚就舔脚"
    },
    {
      "end": 5542.92,
      "start": 5540.38,
      "text": "然后他说领导的情人女人"
    },
    {
      "end": 5545.22,
      "start": 5542.92,
      "text": "他能为了领导搞一个女人"
    },
    {
      "end": 5547.24,
      "start": 5545.22,
      "text": "他说他能拉着前一车车去"
    },
    {
      "end": 5551.0,
      "start": 5547.24,
      "text": "然后呢关键他能替人家洗钱"
    },
    {
      "end": 5553.48,
      "start": 5551.0,
      "text": "洗太多钱了都是现金"
    },
    {
      "end": 5557.24,
      "start": 5553.48,
      "text": "他说这货啊是中国现代版的"
    },
    {
      "end": 5561.0,
      "start": 5557.24,
      "text": "最低级的啊就是这个白手套"
    },
    {
      "end": 5564.2,
      "start": 5561.0,
      "text": "所以说这个今天阿虎女士"
    },
    {
      "end": 5565.0,
      "start": 5564.2,
      "text": "你知道谈到北京"
    },
    {
      "end": 5566.68,
      "start": 5565.0,
      "text": "咱们很兴奋就北京姑娘"
    },
    {
      "end": 5569.88,
      "start": 5566.68,
      "text": "哎呦这个北京姑娘我感触太多了"
    },
    {
      "end": 5572.0,
      "start": 5569.88,
      "text": "就严斌祸害的北京姑娘"
    },
    {
      "end": 5573.88,
      "start": 5572.0,
      "text": "就看着北京的堕落"
    },
    {
      "end": 5577.64,
      "start": 5573.88,
      "text": "最后连百花也救不了北京姑娘"
    },
    {
      "end": 5581.32,
      "start": 5577.64,
      "text": "都被这把外来的流氓给玩了啊"
    },
    {
      "end": 5583.88,
      "start": 5581.32,
      "text": "北京姑娘是实际很高傲的"
    },
    {
      "end": 5585.88,
      "start": 5583.88,
      "text": "真是想说实在话"
    },
    {
      "end": 5588.64,
      "start": 5585.88,
      "text": "绝大多数北京姑娘都有一个梦想"
    },
    {
      "end": 5589.64,
      "start": 5588.64,
      "text": "离开北京"
    },
    {
      "end": 5592.12,
      "start": 5589.64,
      "text": "就像你们已经是成功人了都离开北京了"
    },
    {
      "end": 5594.12,
      "start": 5592.12,
      "text": "不想待在北京看不下去"
    },
    {
      "end": 5596.88,
      "start": 5594.12,
      "text": "除了离开北京就他们说实在话"
    },
    {
      "end": 5597.88,
      "start": 5596.88,
      "text": "就想过点好日子"
    },
    {
      "end": 5599.88,
      "start": 5597.88,
      "text": "那么像你们出来都是成功的"
    },
    {
      "end": 5603.88,
      "start": 5599.88,
      "text": "那么我从北京看到的北京的被歧视"
    },
    {
      "end": 5608.68,
      "start": 5603.88,
      "text": "北京的多罗赫承担了六四之过"
    },
    {
      "end": 5609.88,
      "start": 5608.68,
      "text": "六四之祸"
    },
    {
      "end": 5613.88,
      "start": 5609.88,
      "text": "在北京官场商场歧视之大"
    },
    {
      "end": 5615.56,
      "start": 5613.88,
      "text": "说句实在话"
    },
    {
      "end": 5618.12,
      "start": 5615.56,
      "text": "在中国他们这官场玩个北京姑娘觉得很高尚"
    },
    {
      "end": 5620.12,
      "start": 5618.12,
      "text": "总比玩山洞姑娘觉得牛"
    },
    {
      "end": 5622.12,
      "start": 5620.12,
      "text": "这个玩个四川姑娘觉得太正常了"
    },
    {
      "end": 5623.12,
      "start": 5622.12,
      "text": "就不算高尚"
    },
    {
      "end": 5624.12,
      "start": 5623.12,
      "text": "是不是"
    },
    {
      "end": 5626.12,
      "start": 5624.12,
      "text": "他们这个是很有区域性的"
    },
    {
      "end": 5628.12,
      "start": 5626.12,
      "text": "觉得玩个东北姑娘就傻"
    },
    {
      "end": 5629.12,
      "start": 5628.12,
      "text": "都是随便玩玩"
    },
    {
      "end": 5632.12,
      "start": 5629.12,
      "text": "觉得玩个北京姑娘不可很骄傲"
    },
    {
      "end": 5636.12,
      "start": 5632.12,
      "text": "所以在北京姑娘在官场在北京实际挺危险的"
    },
    {
      "end": 5638.12,
      "start": 5636.12,
      "text": "就是刚才你说那个敌爷儿啊"
    },
    {
      "end": 5639.12,
      "start": 5638.12,
      "text": "坎爷儿啊"
    },
    {
      "end": 5640.12,
      "start": 5639.12,
      "text": "基本上是笑话"
    },
    {
      "end": 5642.12,
      "start": 5640.12,
      "text": "基本上是笑话"
    },
    {
      "end": 5644.12,
      "start": 5642.12,
      "text": "这就是说的"
    },
    {
      "end": 5646.12,
      "start": 5644.12,
      "text": "就是说的那个敌爷儿啊"
    },
    {
      "end": 5648.12,
      "start": 5646.12,
      "text": "基本上是笑话"
    },
    {
      "end": 5649.12,
      "start": 5648.12,
      "text": "就是当笑话玩儿的"
    },
    {
      "end": 5652.12,
      "start": 5649.12,
      "text": "所以说现在很多人不去谈论这个问题"
    },
    {
      "end": 5655.12,
      "start": 5652.12,
      "text": "共产党是世界上最大的种族歧视者"
    },
    {
      "end": 5657.12,
      "start": 5655.12,
      "text": "和制造种族歧视者"
    },
    {
      "end": 5659.12,
      "start": 5657.12,
      "text": "你看对新疆人西藏人少数民族"
    },
    {
      "end": 5660.12,
      "start": 5659.12,
      "text": "他都这样"
    },
    {
      "end": 5662.12,
      "start": 5660.12,
      "text": "他对北京也是这样更惨"
    },
    {
      "end": 5665.12,
      "start": 5662.12,
      "text": "而且北京在时时刻刻的被报复的"
    },
    {
      "end": 5670.12,
      "start": 5666.12,
      "text": "这是为什么要叫他们建了一个六四之后"
    },
    {
      "end": 5673.12,
      "start": 5670.12,
      "text": "叫河北的叫这个沪生河工程"
    },
    {
      "end": 5674.12,
      "start": 5673.12,
      "text": "啥叫沪生河"
    },
    {
      "end": 5676.12,
      "start": 5674.12,
      "text": "就防你北京人的"
    },
    {
      "end": 5679.12,
      "start": 5676.12,
      "text": "就不让你北京人有任何这个好舒服"
    },
    {
      "end": 5683.12,
      "start": 5680.12,
      "text": "北京人只要经枪你一扁出来"
    },
    {
      "end": 5685.12,
      "start": 5683.12,
      "text": "我告诉你中南克人都不在意"
    },
    {
      "end": 5689.12,
      "start": 5685.12,
      "text": "你中南克现在告诉我过去的几届常委哪个是北京人呢"
    },
    {
      "end": 5691.12,
      "start": 5689.12,
      "text": "你给我找出了一个"
    },
    {
      "end": 5692.12,
      "start": 5691.12,
      "text": "没有"
    },
    {
      "end": 5695.12,
      "start": 5692.12,
      "text": "你给我找出一个政治局北京人"
    },
    {
      "end": 5696.12,
      "start": 5695.12,
      "text": "没有"
    },
    {
      "end": 5697.12,
      "start": 5696.12,
      "text": "没有"
    },
    {
      "end": 5698.12,
      "start": 5697.12,
      "text": "没有"
    },
    {
      "end": 5700.12,
      "start": 5698.12,
      "text": "所以说百发当时"
    },
    {
      "end": 5702.12,
      "start": 5700.12,
      "text": "我们俩老聊天老爷子"
    },
    {
      "end": 5703.12,
      "start": 5702.12,
      "text": "我们俩太好了"
    },
    {
      "end": 5705.12,
      "start": 5704.12,
      "text": "就百发说"
    },
    {
      "end": 5707.12,
      "start": 5705.12,
      "text": "他说现在你看这共产党"
    },
    {
      "end": 5711.12,
      "start": 5707.12,
      "text": "这个六四是老百姓给中国争气点"
    },
    {
      "end": 5712.12,
      "start": 5711.12,
      "text": "说话的权力"
    },
    {
      "end": 5714.12,
      "start": 5712.12,
      "text": "他说咱冒冒气行不行啊"
    },
    {
      "end": 5716.12,
      "start": 5714.12,
      "text": "这北京人首都人"
    },
    {
      "end": 5718.12,
      "start": 5716.12,
      "text": "他说什么叫首都在下"
    },
    {
      "end": 5719.12,
      "start": 5718.12,
      "text": "叫文明首都"
    },
    {
      "end": 5721.12,
      "start": 5719.12,
      "text": "首都要起首都作用"
    },
    {
      "end": 5722.12,
      "start": 5721.12,
      "text": "他说首都起作用了"
    },
    {
      "end": 5724.12,
      "start": 5722.12,
      "text": "你不就这么打压首都啊"
    },
    {
      "end": 5727.12,
      "start": 5726.12,
      "text": "他说北京"
    },
    {
      "end": 5731.12,
      "start": 5728.12,
      "text": "在北京现在说你是北京多少年干部了"
    },
    {
      "end": 5732.12,
      "start": 5731.12,
      "text": "十年"
    },
    {
      "end": 5733.12,
      "start": 5732.12,
      "text": "主持部压根就不考察你"
    },
    {
      "end": 5736.12,
      "start": 5734.12,
      "text": "去货了没你派到外面去"
    },
    {
      "end": 5738.12,
      "start": 5736.12,
      "text": "他说这对北京人公平吗"
    },
    {
      "end": 5740.12,
      "start": 5738.12,
      "text": "所以我当时给老爷子说句话"
    },
    {
      "end": 5742.12,
      "start": 5740.12,
      "text": "我说白发老爷子"
    },
    {
      "end": 5743.12,
      "start": 5742.12,
      "text": "你最郁闷的是啥"
    },
    {
      "end": 5744.12,
      "start": 5743.12,
      "text": "他说我最郁闷"
    },
    {
      "end": 5746.12,
      "start": 5744.12,
      "text": "你看我这每天我这桌子桌围了"
    },
    {
      "end": 5749.12,
      "start": 5746.12,
      "text": "我有几个北京人哪文贵啊"
    },
    {
