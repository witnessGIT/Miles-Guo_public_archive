{
  "chunk_audio_sha256": "e5590b2304ca02251c9ea00c16a740b5552fca752b1c07b90b2ea5f82825861e",
  "chunk_index": 3,
  "completed_at": "2026-10-20T02:32:50Z",
  "language": "zh",
  "live_id": "LIVE_20191001_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 2700,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 2704.16,
      "start": 2700.0,
      "text": "有点军事能力的国家吧 G20 国家吗"
    },
    {
      "end": 2707.0,
      "start": 2704.4,
      "text": "我可以告诉你 哪家的特种训练都比这苦"
    },
    {
      "end": 2710.76,
      "start": 2708.68,
      "text": "这是一个 另外一个我跟你说"
    },
    {
      "end": 2714.4,
      "start": 2711.3,
      "text": "就是我见过的特别保镖"
    },
    {
      "end": 2719.4,
      "start": 2714.8,
      "text": "包括几个像黑水啊几个这种国际保安公司都比这苦"
    },
    {
      "end": 2721.06,
      "start": 2719.94,
      "text": "这太正常了"
    },
    {
      "end": 2725.04,
      "start": 2721.66,
      "text": "对待这个训练来讲 我觉得这个什么40秒的事"
    },
    {
      "end": 2727.9,
      "start": 2725.28,
      "text": "根本一点意义 一点都不重要"
    },
    {
      "end": 2732.26,
      "start": 2727.9,
      "text": "但是他有两个问题是跟你这问题有关系的 小皮匠的"
    },
    {
      "end": 2733.28,
      "start": 2732.26,
      "text": "你知道啊"
    },
    {
      "end": 2737.14,
      "start": 2733.28,
      "text": "就是说 这些国家这么多残酷训练"
    },
    {
      "end": 2739.16,
      "start": 2737.14,
      "text": "首先第一条 你是你愿意的"
    },
    {
      "end": 2743.52,
      "start": 2739.16,
      "text": "你有选择的 说我不干这个 你马上就可以走"
    },
    {
      "end": 2745.82,
      "start": 2743.52,
      "text": "是吧 也不会得到打击报复"
    },
    {
      "end": 2749.14,
      "start": 2745.82,
      "text": "也不会把你家给操了灭了门 是吧"
    },
    {
      "end": 2754.52,
      "start": 2749.14,
      "text": "但是人家来之前也没有骗你 我这就这玩意儿 你干不干"
    },
    {
      "end": 2757.6,
      "start": 2754.52,
      "text": "首先跟你说真相 是吧 路德先生"
    },
    {
      "end": 2761.7,
      "start": 2757.6,
      "text": "你再一个你愿不愿意是你自发的 中间你还可以走"
    },
    {
      "end": 2762.98,
      "start": 2761.7,
      "text": "走了没后果"
    },
    {
      "end": 2765.54,
      "start": 2763.24,
      "text": "是这意思吧 路德先生 你把你牵过来吧"
    },
    {
      "end": 2767.46,
      "start": 2765.54,
      "text": "你老让我一个人在这干嘛啊你啊"
    },
    {
      "end": 2771.68,
      "start": 2767.46,
      "text": "咱俩多好啊现在 这俩美女咱俩帅哥咱们挺好平衡一下"
    },
    {
      "end": 2775.0,
      "start": 2771.94,
      "text": "但是呢 共产党这个是下枪想法吧"
    },
    {
      "end": 2778.6,
      "start": 2775.0,
      "text": "这就不用说了 我让你来你不来 那你找死呢 不中党啊"
    },
    {
      "end": 2782.7,
      "start": 2778.6,
      "text": "第二 你得到的信仪是假的 他是以洗脑为名了"
    },
    {
      "end": 2784.74,
      "start": 2782.7,
      "text": "还有一个 你中间不能退 退着你就死"
    },
    {
      "end": 2788.58,
      "start": 2784.74,
      "text": "更夸张的事情 大家另外一个问题"
    },
    {
      "end": 2790.64,
      "start": 2788.58,
      "text": "Persy 你看小皮鞋 你没有注意到啊"
    },
    {
      "end": 2794.72,
      "start": 2790.64,
      "text": "这些孩子流汗流泪 他是没有钱没有报酬的"
    },
    {
      "end": 2802.66,
      "start": 2794.72,
      "text": "女孩子报酬是找个好男人 但是 憧憬着找个好男朋友"
    },
    {
      "end": 2805.72,
      "start": 2802.66,
      "text": "但他找的肯定不是好男朋友 都是那些老表脸的"
    },
    {
      "end": 2808.8,
      "start": 2807.0,
      "text": "男孩在那边希望有个事业"
    },
    {
      "end": 2812.12,
      "start": 2808.8,
      "text": "但你们都知道 中国退伍兵哪有好事业的 没有事业"
    },
    {
      "end": 2817.5,
      "start": 2813.16,
      "text": "他是首先就被欺骗 更重要的就是跟人家不一样的事情"
    },
    {
      "end": 2824.42,
      "start": 2818.28,
      "text": "所有这些人在训练当中 和训练之后是没有任何回报的"
    },
    {
      "end": 2827.28,
      "start": 2824.72,
      "text": "就是一个回报 你中一党"
    },
    {
      "end": 2831.12,
      "start": 2829.08,
      "text": "路德先生 这是本质上不同吗?"
    },
    {
      "end": 2835.22,
      "start": 2831.12,
      "text": "实际上你说训练有多苦 你不能拿着"
    },
    {
      "end": 2837.68,
      "start": 2835.22,
      "text": "Persy 小皮鞋 你俩在法国德国"
    },
    {
      "end": 2840.84,
      "start": 2837.68,
      "text": "享受着美食美酒阳光 想干啥干啥"
    },
    {
      "end": 2846.22,
      "start": 2840.84,
      "text": "说老实话 你知道 我的儿女教育 我认为我是最成功的"
    },
    {
      "end": 2849.94,
      "start": 2846.22,
      "text": "这个道德上不乱来 都是谦虚至极 特别好"
    },
    {
      "end": 2854.04,
      "start": 2849.94,
      "text": "唯一的事情 我就认为我的儿女当时就没有参加了"
    },
    {
      "end": 2855.32,
      "start": 2854.04,
      "text": "这种严酷的训练"
    },
    {
      "end": 2859.68,
      "start": 2856.34,
      "text": "后来我儿子上完大学 从剑桥上完大学"
    },
    {
      "end": 2862.24,
      "start": 2860.18,
      "text": "他就自己开始来补偿这个"
    },
    {
      "end": 2867.36,
      "start": 2863.26,
      "text": "他开飞机 军训 健身"
    },
    {
      "end": 2870.68,
      "start": 2868.38,
      "text": "最后他跟我说 爸爸 我有一课还没补完"
    },
    {
      "end": 2876.56,
      "start": 2870.68,
      "text": "就是这个铁人七象 而且他顺利的完成"
    },
    {
      "end": 2880.16,
      "start": 2877.34,
      "text": "我觉得一个人要挑战自我 成熟自我"
    },
    {
      "end": 2884.0,
      "start": 2880.16,
      "text": "经历这个不是坏事儿 经历这个才更加完美"
    },
    {
      "end": 2889.12,
      "start": 2884.0,
      "text": "但前提是 你自愿的 还是被欺骗的 还是被威胁的"
    },
    {
      "end": 2891.94,
      "start": 2890.14,
      "text": "还有是你有没有汇报"
    },
    {
      "end": 2897.06,
      "start": 2893.22,
      "text": "这个共产党穷兵独武的 这个所谓阅兵"
    },
    {
      "end": 2899.88,
      "start": 2897.56,
      "text": "是所有拿这些人的年轻生命"
    },
    {
      "end": 2902.18,
      "start": 2899.88,
      "text": "是在被欺骗无报酬的情况下"
    },
    {
      "end": 2904.24,
      "start": 2902.96,
      "text": "这本质完全不同"
    },
    {
      "end": 2907.56,
      "start": 2904.74,
      "text": "路德先生 请你给两位为女谈谈"
    },
    {
      "end": 2909.6,
      "start": 2907.56,
      "text": "在时间没问题 在时间没问题"
    },
    {
      "end": 2914.48,
      "start": 2911.66,
      "text": "小皮匠 还有Persia"
    },
    {
      "end": 2915.76,
      "start": 2914.98,
      "text": "大家好"
    },
    {
      "end": 2919.34,
      "start": 2918.06,
      "text": "你们作为北京人啊"
    },
    {
      "end": 2923.68,
      "start": 2920.1,
      "text": "我看你们的口音都是北京土生土长的"
    },
    {
      "end": 2926.76,
      "start": 2923.68,
      "text": "特别是小皮匠 金枪特别重"
    },
    {
      "end": 2930.08,
      "start": 2927.26,
      "text": "应该也是在这个胡同里长大的"
    },
    {
      "end": 2931.62,
      "start": 2930.84,
      "text": "你们小的时候"
    },
    {
      "end": 2935.2,
      "start": 2933.16,
      "text": "在北京可能被洗脑的情况"
    },
    {
      "end": 2937.76,
      "start": 2935.72,
      "text": "远超啊 可能也超过"
    },
    {
      "end": 2939.8,
      "start": 2938.52,
      "text": "超过咱们现在就是"
    },
    {
      "end": 2941.34,
      "start": 2940.06,
      "text": "像我们在湖南那种"
    },
    {
      "end": 2942.12,
      "start": 2941.6,
      "text": "我觉得"
    },
    {
      "end": 2945.44,
      "start": 2943.64,
      "text": "在这种情况下 现在为什么"
    },
    {
      "end": 2947.24,
      "start": 2945.96,
      "text": "突然有这种"
    },
    {
      "end": 2949.02,
      "start": 2947.48,
      "text": "是因为到了国外的原因呢"
    },
    {
      "end": 2949.54,
      "start": 2949.02,
      "text": "还是说"
    },
    {
      "end": 2951.08,
      "start": 2950.04,
      "text": "因为别的什么原因"
    },
    {
      "end": 2952.1,
      "start": 2951.58,
      "text": "什么原因"
    },
    {
      "end": 2957.26,
      "start": 2953.68,
      "text": "就是您问我这问题是吧 路德先生"
    },
    {
      "end": 2960.34,
      "start": 2959.56,
      "text": "我觉得"
    },
    {
      "end": 2961.62,
      "start": 2960.6,
      "text": "我觉得他也不见得"
    },
    {
      "end": 2963.16,
      "start": 2961.88,
      "text": "就是说 只要是在北京"
    },
    {
      "end": 2965.46,
      "start": 2963.4,
      "text": "就都会被洗脑的非常的严重"
    },
    {
      "end": 2967.0,
      "start": 2965.96,
      "text": "因为呀 北京"
    },
    {
      "end": 2969.3,
      "start": 2968.78,
      "text": "确实是"
    },
    {
      "end": 2972.36,
      "start": 2970.58,
      "text": "你周围可能隔着三个人"
    },
    {
      "end": 2973.9,
      "start": 2972.62,
      "text": "就能通到中央的官"
    },
    {
      "end": 2976.72,
      "start": 2975.44,
      "text": "反正北京人都这么说吧"
    },
    {
      "end": 2979.54,
      "start": 2977.24,
      "text": "就是因为你越接近他们"
    },
    {
      "end": 2982.36,
      "start": 2979.8,
      "text": "北京这流行话恰恰相反"
    },
    {
      "end": 2985.18,
      "start": 2982.36,
      "text": "在北京城的老百姓"
    },
    {
      "end": 2986.72,
      "start": 2985.44,
      "text": "离经关是最远的"
    },
    {
      "end": 2989.52,
      "start": 2987.74,
      "text": "你这个 很多人这么说"
    },
    {
      "end": 2991.84,
      "start": 2989.78,
      "text": "我们北京人呀 北京姑娘呀 北京的"
    },
    {
      "end": 2993.12,
      "start": 2992.08,
      "text": "四处四处都有个句话"
    },
    {
      "end": 2994.4,
      "start": 2993.36,
      "text": "我们离中南海"
    },
    {
      "end": 2995.92,
      "start": 2994.9,
      "text": "一强之歌"
    },
    {
      "end": 2998.48,
      "start": 2996.18,
      "text": "我们有时候上个厕所都能遇到一常委"
    },
    {
      "end": 2999.76,
      "start": 2998.74,
      "text": "我告诉所有的北京"
    },
    {
      "end": 3003.08,
      "start": 2999.76,
      "text": "我说你们真是太自我欺骗那自恋了"
    },
    {
      "end": 3005.64,
      "start": 3003.34,
      "text": "我告诉你中共从建国以来"
    },
    {
      "end": 3007.7,
      "start": 3006.16,
      "text": "防的最多就是北京"
    },
    {
      "end": 3011.02,
      "start": 3007.96,
      "text": "为啥北京公安局长和北京战区司令"
    },
    {
      "end": 3015.12,
      "start": 3011.54,
      "text": "和北京军区和中央警卫局是完全隔开的"
    },
    {
      "end": 3017.68,
      "start": 3015.88,
      "text": "从中南海大门出来"
    },
    {
      "end": 3019.22,
      "start": 3017.94,
      "text": "领导说我要到北京去"
    },
    {
      "end": 3020.24,
      "start": 3019.48,
      "text": "他就视察"
    },
    {
      "end": 3022.04,
      "start": 3020.76,
      "text": "去北京视察"
    },
    {
      "end": 3025.36,
      "start": 3022.54,
      "text": "北京老百姓看到中共的领导"
    },
    {
      "end": 3026.64,
      "start": 3025.62,
      "text": "就是中央领导"
    },
    {
      "end": 3028.44,
      "start": 3026.9,
      "text": "就那个坑里边领导的机会"
    },
    {
      "end": 3029.72,
      "start": 3028.68,
      "text": "是最少的"
    },
    {
      "end": 3031.5,
      "start": 3030.74,
      "text": "最少的"
    },
    {
      "end": 3032.28,
      "start": 3031.76,
      "text": "为什么"
    },
    {
      "end": 3034.84,
      "start": 3032.52,
      "text": "共产党修到的调宝工程式是最少的"
    },
    {
      "end": 3035.6,
      "start": 3035.08,
      "text": "所以你看"
    },
    {
      "end": 3037.14,
      "start": 3035.86,
      "text": "就连Percy小皮匠"
    },
    {
      "end": 3040.2,
      "start": 3037.4,
      "text": "就是他这样陈斯人都出来那么长时间了"
    },
    {
      "end": 3042.0,
      "start": 3040.96,
      "text": "你俩还这么认为呢"
    },
    {
      "end": 3043.28,
      "start": 3042.24,
      "text": "这绝对是误区"
    },
    {
      "end": 3045.32,
      "start": 3043.78,
      "text": "这个我有一个这个"
    },
    {
      "end": 3046.34,
      "start": 3045.84,
      "text": "北京的"
    },
    {
      "end": 3049.16,
      "start": 3047.36,
      "text": "当警卫局的哥们儿出来的"
    },
    {
      "end": 3051.72,
      "start": 3049.42,
      "text": "他说我们警卫上有一个最严密的"
    },
    {
      "end": 3054.54,
      "start": 3052.48,
      "text": "最忌讳你和北京当地人接触"
    },
    {
      "end": 3056.32,
      "start": 3055.56,
      "text": "最忌讳的"
    },
    {
      "end": 3059.92,
      "start": 3057.1,
      "text": "这个接触因为共产党最害怕就是你和当地接触"
    },
    {
      "end": 3060.68,
      "start": 3060.16,
      "text": "他就说不了了"
    },
    {
      "end": 3063.76,
      "start": 3061.2,
      "text": "所以说你离中南海是最远的"
    },
    {
      "end": 3064.78,
      "start": 3064.0,
      "text": "小米家"
    },
    {
      "end": 3065.54,
      "start": 3064.78,
      "text": "Percy"
    },
    {
      "end": 3066.56,
      "start": 3066.06,
      "text": "Please"
    },
    {
      "end": 3067.08,
      "start": 3066.56,
      "text": "你去讲"
    },
    {
      "end": 3069.12,
      "start": 3067.6,
      "text": "不过这也确实"
    },
    {
      "end": 3070.92,
      "start": 3069.12,
      "text": "我得到的信息"
    },
    {
      "end": 3071.42,
      "start": 3071.16,
      "text": "董事长"
    },
    {
      "end": 3072.44,
      "start": 3071.68,
      "text": "你有什么想说的"
    },
    {
      "end": 3075.52,
      "start": 3073.98,
      "text": "郭先生我回应您一下"
    },
    {
      "end": 3077.06,
      "start": 3075.78,
      "text": "我觉得您说的是"
    },
    {
      "end": 3077.82,
      "start": 3077.32,
      "text": "也对"
    },
    {
      "end": 3078.84,
      "start": 3078.08,
      "text": "但是我认为呢"
    },
    {
      "end": 3079.62,
      "start": 3079.1,
      "text": "我有一个"
    },
    {
      "end": 3081.4,
      "start": 3080.38,
      "text": "自己的想法呢"
    },
    {
      "end": 3082.44,
      "start": 3081.92,
      "text": "是什么呢"
    },
    {
      "end": 3084.48,
      "start": 3082.68,
      "text": "我觉得北京市民可能"
    },
    {
      "end": 3086.02,
      "start": 3084.74,
      "text": "中南坑的也好"
    },
    {
      "end": 3087.3,
      "start": 3086.28,
      "text": "是各种什么局"
    },
    {
      "end": 3088.58,
      "start": 3087.56,
      "text": "中央的"
    },
    {
      "end": 3090.12,
      "start": 3088.84,
      "text": "可能都是外地进去"
    },
    {
      "end": 3091.64,
      "start": 3090.36,
      "text": "都不是北京人"
    },
    {
      "end": 3093.7,
      "start": 3091.9,
      "text": "但是北京人经历了"
    },
    {
      "end": 3095.74,
      "start": 3093.96,
      "text": "所有的这些政治运动"
    },
    {
      "end": 3097.28,
      "start": 3096.76,
      "text": "从四五"
    },
    {
      "end": 3098.3,
      "start": 3097.54,
      "text": "到后来"
    },
    {
      "end": 3099.32,
      "start": 3098.3,
      "text": "文革在"
    },
    {
      "end": 3101.62,
      "start": 3100.1,
      "text": "天文广场六四"
    },
    {
      "end": 3102.66,
      "start": 3101.88,
      "text": "北京人呢"
    },
    {
      "end": 3103.68,
      "start": 3102.9,
      "text": "很多是"
    },
    {
      "end": 3105.22,
      "start": 3103.94,
      "text": "自己教育自己"
    },
    {
      "end": 3105.98,
      "start": 3105.46,
      "text": "每个人"
    },
    {
      "end": 3107.78,
      "start": 3106.24,
      "text": "北京人最喜欢的就是"
    },
    {
      "end": 3108.28,
      "start": 3108.02,
      "text": "整"
    },
    {
      "end": 3109.06,
      "start": 3108.28,
      "text": "谈政治"
    },
    {
      "end": 3109.82,
      "start": 3109.3,
      "text": "国事"
    },
    {
      "end": 3110.34,
      "start": 3110.08,
      "text": "所以"
    },
    {
      "end": 3111.1,
      "start": 3110.84,
      "text": "是一种"
    },
    {
      "end": 3113.14,
      "start": 3111.36,
      "text": "自己教育自己的过程"
    },
    {
      "end": 3115.2,
      "start": 3113.4,
      "text": "也可能是因为北京人经历这种"
    },
    {
      "end": 3117.24,
      "start": 3115.46,
      "text": "所有政治人的一个大的事件啊"
    },
    {
      "end": 3117.76,
      "start": 3117.5,
      "text": "还有"
    },
    {
      "end": 3119.04,
      "start": 3118.52,
      "text": "国事"
    },
    {
      "end": 3120.58,
      "start": 3119.3,
      "text": "都是在北京"
    },
    {
      "end": 3121.86,
      "start": 3120.58,
      "text": "所以我觉得北京人"
    },
    {
      "end": 3124.94,
      "start": 3122.12,
      "text": "人家就是说什么好像上海人很关心"
    },
    {
      "end": 3125.96,
      "start": 3125.44,
      "text": "经济"
    },
    {
      "end": 3126.98,
      "start": 3126.22,
      "text": "做生意"
    },
    {
      "end": 3127.74,
      "start": 3127.24,
      "text": "经济这些"
    },
    {
      "end": 3128.52,
      "start": 3128.0,
      "text": "但是北京呢"
    },
    {
      "end": 3129.28,
      "start": 3128.78,
      "text": "就是确实一个"
    },
    {
      "end": 3130.82,
      "start": 3130.06,
      "text": "老百姓吧"
    },
    {
      "end": 3132.1,
      "start": 3131.08,
      "text": "咱们说就是特别"
    },
    {
      "end": 3133.9,
      "start": 3132.36,
      "text": "其实对政治是特别关心"
    },
    {
      "end": 3134.66,
      "start": 3134.14,
      "text": "而且从"
    },
    {
      "end": 3135.18,
      "start": 3134.92,
      "text": "里面去"
    },
    {
      "end": 3136.7,
      "start": 3135.68,
      "text": "悟出了好多事情"
    },
    {
      "end": 3137.22,
      "start": 3136.96,
      "text": "所以"
    },
    {
      "end": 3137.98,
      "start": 3137.48,
      "text": "这是我的"
    },
    {
      "end": 3138.76,
      "start": 3138.24,
      "text": "我的看法"
    },
    {
      "end": 3139.78,
      "start": 3139.02,
      "text": "而且呢"
    },
    {
      "end": 3143.12,
      "start": 3140.04,
      "text": "我觉得就是我们可能接触不到这些坑里边的这些人啊"
    },
    {
      "end": 3144.14,
      "start": 3143.36,
      "text": "但是呢"
    },
    {
      "end": 3145.42,
      "start": 3144.4,
      "text": "像北京军区"
    },
    {
      "end": 3150.28,
      "start": 3145.92,
      "text": "还有一些北京地方的这些官员的多多少少都会有接触"
    },
    {
      "end": 3153.86,
      "start": 3150.54,
      "text": "就只要是在他们这个体系内部的这些人呀"
    },
    {
      "end": 3156.16,
      "start": 3154.12,
      "text": "都会带有你说的那些习气"
    },
    {
      "end": 3156.94,
      "start": 3156.42,
      "text": "所以呢"
    },
    {
      "end": 3159.24,
      "start": 3157.44,
      "text": "通过跟这些人的接触呢"
    },
    {
      "end": 3160.26,
      "start": 3159.5,
      "text": "也能有一会"
    },
    {
      "end": 3161.04,
      "start": 3160.52,
      "text": "有一些体会"
    },
    {
      "end": 3165.12,
      "start": 3161.54,
      "text": "那我年龄可能跟郭先生比我还有一点太小了"
    },
    {
      "end": 3166.92,
      "start": 3165.38,
      "text": "但是我父亲可是"
    },
    {
      "end": 3168.96,
      "start": 3166.92,
      "text": "就是他经历过六四这个"
    },
    {
      "end": 3170.0,
      "start": 3169.22,
      "text": "我这件事的"
    },
    {
      "end": 3172.8,
      "start": 3170.24,
      "text": "在家里也他也偷偷的跟我形容过"
    },
    {
      "end": 3175.12,
      "start": 3173.58,
      "text": "刘四到底发生了什么"
    },
    {
      "end": 3177.42,
      "start": 3175.36,
      "text": "也这也是一个根本原因吧"
    },
    {
      "end": 3180.48,
      "start": 3177.68,
      "text": "就我爸妈就逼着我必须得把我送出来的原因"
    },
    {
      "end": 3182.28,
      "start": 3181.0,
      "text": "其实那时候我对政治"
    },
    {
      "end": 3185.1,
      "start": 3182.54,
      "text": "我自己本人对政治并没有什么太多的感触"
    },
    {
      "end": 3187.92,
      "start": 3185.36,
      "text": "我觉得一天到晚吃喝玩乐挺开心的"
    },
    {
      "end": 3189.96,
      "start": 3188.16,
      "text": "也是到了国外之后发现"
    },
    {
      "end": 3190.98,
      "start": 3190.48,
      "text": "油管"
    },
    {
      "end": 3192.78,
      "start": 3191.24,
      "text": "哎这是一个新的东西我没见过"
    },
    {
      "end": 3194.56,
      "start": 3193.04,
      "text": "结果在这上面我发现了"
    },
    {
      "end": 3195.84,
      "start": 3194.82,
      "text": "那么多"
    },
    {
      "end": 3196.88,
      "start": 3196.36,
      "text": "真相"
    },
    {
      "end": 3198.72,
      "start": 3197.18,
      "text": "就包括我爸爸跟我说的真相"
    },
    {
      "end": 3200.24,
      "start": 3198.96,
      "text": "我也是在油管上才看到"
    },
    {
      "end": 3201.78,
      "start": 3200.5,
      "text": "在国内完全搜不到"
    },
    {
      "end": 3202.8,
      "start": 3202.04,
      "text": "于是呢就"
    },
    {
      "end": 3203.84,
      "start": 3203.06,
      "text": "慢慢的"
    },
    {
      "end": 3205.88,
      "start": 3204.86,
      "text": "一点一点的觉醒了"
    },
    {
      "end": 3206.9,
      "start": 3206.14,
      "text": "然后一直"
    },
    {
      "end": 3208.96,
      "start": 3207.16,
      "text": "又到这个爆料革命上"
    },
    {
      "end": 3212.28,
      "start": 3209.98,
      "text": "一点一点的就脑子就开开开开开制了吧"
    },
    {
      "end": 3212.8,
      "start": 3212.54,
      "text": "这感觉"
    },
    {
      "end": 3213.3,
      "start": 3213.04,
      "text": "这个"
    },
    {
      "end": 3214.32,
      "start": 3213.82,
      "text": "这种感觉"
    },
    {
      "end": 3216.88,
      "start": 3215.36,
      "text": "刚才路德先生问你这问题"
    },
    {
      "end": 3218.42,
      "start": 3217.14,
      "text": "为什么到了国外这样"
    },
    {
      "end": 3219.96,
      "start": 3218.68,
      "text": "首先是自由环境"
    },
    {
      "end": 3220.48,
      "start": 3220.22,
      "text": "是吧"
    },
    {
      "end": 3222.0,
      "start": 3220.72,
      "text": "看清真相"
    },
    {
      "end": 3223.54,
      "start": 3222.26,
      "text": "那就是这个媒体"
    },
    {
      "end": 3224.56,
      "start": 3223.8,
      "text": "真相的力量"
    },
    {
      "end": 3226.1,
      "start": 3224.82,
      "text": "我觉得这是你俩说的核心"
    },
    {
      "end": 3227.64,
      "start": 3226.1,
      "text": "还有在你俩"
    },
    {
      "end": 3228.92,
      "start": 3227.64,
      "text": "你俩想说在北京"
    },
    {
      "end": 3230.96,
      "start": 3229.18,
      "text": "比别人这个觉悟高"
    },
    {
      "end": 3232.5,
      "start": 3231.22,
      "text": "比别人看的高"
    },
    {
      "end": 3234.04,
      "start": 3232.76,
      "text": "知道的多"
    },
    {
      "end": 3235.32,
      "start": 3234.04,
      "text": "但是我再跟你说"
    },
    {
      "end": 3238.9,
      "start": 3235.58,
      "text": "很不幸的事情你说的都是不对的"
    },
    {
      "end": 3240.44,
      "start": 3239.92,
      "text": "就这一段啊"
    },
    {
      "end": 3241.46,
      "start": 3240.96,
      "text": "我告诉你"
    },
    {
      "end": 3245.3,
      "start": 3241.98,
      "text": "在北京官场和军队上能听到说北京话的人"
    },
    {
      "end": 3246.84,
      "start": 3245.82,
      "text": "少之又少"
    },
    {
      "end": 3248.12,
      "start": 3246.84,
      "text": "嗯"
    },
    {
      "end": 3249.4,
      "start": 3248.38,
      "text": "少之又少"
    },
    {
      "end": 3250.94,
      "start": 3249.92,
      "text": "你听北京话"
    },
    {
      "end": 3252.72,
      "start": 3251.2,
      "text": "这北京是被歧视的"
    },
    {
      "end": 3255.54,
      "start": 3253.24,
      "text": "就你跟北京人来一起的时候就说"
    },
    {
      "end": 3256.82,
      "start": 3255.8,
      "text": "北京人歧视外地人"
    },
    {
      "end": 3258.1,
      "start": 3257.08,
      "text": "我说很多人不知道"
    },
    {
      "end": 3259.9,
      "start": 3258.36,
      "text": "北京没几个人本身"
    },
    {
      "end": 3260.66,
      "start": 3260.16,
      "text": "大多都是"
    },
    {
      "end": 3262.2,
      "start": 3260.92,
      "text": "一两代都是外地人"
    },
    {
      "end": 3264.0,
      "start": 3262.46,
      "text": "北京人有啥歧视"
    },
    {
      "end": 3266.04,
      "start": 3264.24,
      "text": "都被你共产党外来的这些"
    },
    {
      "end": 3267.58,
      "start": 3266.56,
      "text": "说起难听的话"
    },
    {
      "end": 3268.6,
      "start": 3267.58,
      "text": "都是被一些被"
    },
    {
      "end": 3269.62,
      "start": 3268.86,
      "text": "没有教育的"
    },
    {
      "end": 3270.64,
      "start": 3269.62,
      "text": "无知的一些"
    },
    {
      "end": 3272.18,
      "start": 3271.16,
      "text": "蠢民给统战了"
    },
    {
      "end": 3274.48,
      "start": 3272.96,
      "text": "北京人心里老不服了"
    },
    {
      "end": 3275.76,
      "start": 3275.26,
      "text": "啊"
    },
    {
      "end": 3277.82,
      "start": 3276.02,
      "text": "这个地方哪有北京人说话的机会啊"
    },
    {
      "end": 3278.84,
      "start": 3277.82,
      "text": "我的首都"
    },
    {
      "end": 3279.86,
      "start": 3279.6,
      "text": "啊"
    },
    {
      "end": 3281.92,
      "start": 3280.12,
      "text": "到任何一个国家去首都上"
    },
    {
      "end": 3284.48,
      "start": 3282.16,
      "text": "他都有的特别有的独特的文化"
    },
    {
      "end": 3286.26,
      "start": 3285.24,
      "text": "都受到了尊重"
    },
    {
      "end": 3288.56,
      "start": 3286.78,
      "text": "我在这住的一帮流氓"
    },
    {
      "end": 3289.34,
      "start": 3288.82,
      "text": "啊"
    },
    {
      "end": 3290.36,
      "start": 3289.6,
      "text": "用美国话说一帮"
    },
    {
      "end": 3290.62,
      "start": 3290.36,
      "text": "啊"
    },
    {
      "end": 3291.12,
      "start": 3290.62,
      "text": "像我"
    },
    {
      "end": 3292.16,
      "start": 3291.38,
      "text": "人不是说农民"
    },
    {
      "end": 3293.94,
      "start": 3292.16,
      "text": "就一帮无知的东西"
    },
    {
      "end": 3295.74,
      "start": 3293.94,
      "text": "你在这块恨情霸道"
    },
    {
      "end": 3298.3,
      "start": 3295.98,
      "text": "由于这帮流氓进京城以后"
    },
    {
      "end": 3299.82,
      "start": 3298.3,
      "text": "说起难不叫农民进城"
    },
    {
      "end": 3300.86,
      "start": 3299.82,
      "text": "叫流氓进城"
    },
    {
      "end": 3303.16,
      "start": 3301.1,
      "text": "就看着北京人是恨不顺眼"
    },
    {
      "end": 3303.66,
      "start": 3303.16,
      "text": "恕不顺眼"
    },
    {
      "end": 3305.46,
      "start": 3303.66,
      "text": "人家北京姑娘都长得漂亮"
    },
    {
      "end": 3306.74,
      "start": 3305.72,
      "text": "说话也直"
    },
    {
      "end": 3307.5,
      "start": 3306.74,
      "text": "又有教养"
    },
    {
      "end": 3310.06,
      "start": 3308.54,
      "text": "个个的大眼珠瞪子"
    },
    {
      "end": 3310.58,
      "start": 3310.32,
      "text": "啊"
    },
    {
      "end": 3311.6,
      "start": 3310.58,
      "text": "就往裙子里面看"
    },
    {
      "end": 3313.66,
      "start": 3311.86,
      "text": "恨不得跪着地上掀起裙子来"
    },
    {
      "end": 3314.42,
      "start": 3314.16,
      "text": "啊"
    },
    {
      "end": 3315.7,
      "start": 3314.68,
      "text": "看着北京大帅哥"
    },
    {
      "end": 3317.24,
      "start": 3315.7,
      "text": "人家讲话很直接"
    },
    {
      "end": 3319.02,
      "start": 3317.24,
      "text": "觉得就人家你太傲慢了"
    },
    {
      "end": 3319.8,
      "start": 3319.02,
      "text": "你太傲慢了"
    },
    {
      "end": 3320.56,
      "start": 3320.06,
      "text": "是吧"
    },
    {
      "end": 3322.36,
      "start": 3320.82,
      "text": "这接受不了"
    },
    {
      "end": 3325.18,
      "start": 3322.36,
      "text": "北京城是中国无知"
    },
    {
      "end": 3326.2,
      "start": 3325.18,
      "text": "予有教育"
    },
    {
      "end": 3328.24,
      "start": 3326.2,
      "text": "文明的一个巨大的矛盾"
    },
    {
      "end": 3330.04,
      "start": 3328.24,
      "text": "结果导致什么"
    },
    {
      "end": 3330.8,
      "start": 3330.04,
      "text": "啊"
    },
    {
      "end": 3332.6,
      "start": 3330.8,
      "text": "大家知道特别是六四以后"
    },
    {
      "end": 3334.9,
      "start": 3333.88,
      "text": "不用北京人"
    },
    {
      "end": 3336.96,
      "start": 3335.68,
      "text": "你们从来没有谈话"
    },
    {
      "end": 3337.46,
      "start": 3336.96,
      "text": "对小皮家"
    },
    {
      "end": 3338.24,
      "start": 3337.46,
      "text": "哦"
    },
    {
      "end": 3339.0,
      "start": 3338.24,
      "text": "没有人"
    },
    {
      "end": 3340.02,
      "start": 3339.0,
      "text": "路德先生你没有谈话"
    },
    {
      "end": 3342.58,
      "start": 3340.02,
      "text": "是中央委员以上都没有北京人"
    },
    {
      "end": 3344.64,
      "start": 3342.58,
      "text": "不是你一会你要跟小皮家"
    },
    {
      "end": 3346.68,
      "start": 3344.64,
      "text": "你要跟北京国你多做几个节目"
    },
    {
      "end": 3347.44,
      "start": 3346.68,
      "text": "路德先生"
    },
    {
      "end": 3348.2,
      "start": 3347.44,
      "text": "在这边上"
    },
    {
      "end": 3350.26,
      "start": 3348.2,
      "text": "Persie你们做节目真的很不认真"
    },
    {
      "end": 3352.82,
      "start": 3350.26,
      "text": "你要把这事跟路德先生你们这样好好做做"
    },
    {
      "end": 3354.6,
      "start": 3352.82,
      "text": "你们老次举手说我谈好一次"
    },
    {
      "end": 3356.4,
      "start": 3354.6,
      "text": "你老不往点子上轮你知道吗"
    },
    {
      "end": 3357.94,
      "start": 3356.4,
      "text": "你老往那个厨房里轮"
    },
    {
      "end": 3359.72,
      "start": 3357.94,
      "text": "厨房里面没有太大的故事"
    },
    {
      "end": 3362.8,
      "start": 3360.24,
      "text": "就是为什么在六四之后"
    },
    {
      "end": 3364.6,
      "start": 3363.06,
      "text": "正谈没北京人了"
    },
    {
      "end": 3365.88,
      "start": 3364.6,
      "text": "Persie你知道吗"
    },
    {
      "end": 3367.16,
      "start": 3366.12,
      "text": "小皮家"
    },
    {
      "end": 3369.2,
      "start": 3367.92,
      "text": "北京姑娘"
    },
    {
      "end": 3371.24,
      "start": 3369.2,
      "text": "我告诉你答案"
    },
    {
      "end": 3372.28,
      "start": 3371.24,
      "text": "我跟张百发"
    },
    {
      "end": 3374.32,
      "start": 3372.28,
      "text": "我跟张百发"
    },
    {
      "end": 3375.34,
      "start": 3374.32,
      "text": "我俩是哥们"
    },
    {
      "end": 3378.42,
      "start": 3375.34,
      "text": "北京近年来出现唯一一个牛的金官就叫张百发"
    },
    {
      "end": 3379.7,
      "start": 3378.42,
      "text": "就叫张百发"
    },
    {
      "end": 3380.72,
      "start": 3379.7,
      "text": "他有点过失了"
    },
    {
      "end": 3382.76,
      "start": 3380.72,
      "text": "你研究中共的历史"
    },
    {
      "end": 3384.82,
      "start": 3382.76,
      "text": "你研究北京城的历史"
    },
    {
      "end": 3385.58,
      "start": 3384.82,
      "text": "你研究"
    },
    {
      "end": 3386.6,
      "start": 3385.58,
      "text": "你研究北京城的历史"
    },
    {
      "end": 3387.88,
      "start": 3386.6,
      "text": "你好好研究研究张百发"
    },
    {
      "end": 3388.66,
      "start": 3387.88,
      "text": "你好好研究"
    },
    {
      "end": 3389.16,
      "start": 3388.66,
      "text": "研究张百发"
    },
    {
      "end": 3390.2,
      "start": 3389.16,
      "text": "就张百发的事"
    },
    {
      "end": 3392.24,
      "start": 3390.2,
      "text": "路德先生我哪天跟小姑娘一起我"
    },
    {
      "end": 3394.04,
      "start": 3392.24,
      "text": "我给你们咱做几个节目啊"
    },
    {
      "end": 3396.08,
      "start": 3394.04,
      "text": "我跟你们好好讲讲我认识的张百发"
    },
    {
      "end": 3398.12,
      "start": 3396.08,
      "text": "小皮家"
    },
    {
      "end": 3399.92,
      "start": 3398.12,
      "text": "小皮家Persie"
    },
    {
      "end": 3401.7,
      "start": 3399.92,
      "text": "你俩回去自己抽自己脸去就"
    },
    {
      "end": 3403.24,
      "start": 3401.7,
      "text": "你俩过去做个节目不好意思"
    },
    {
      "end": 3405.8,
      "start": 3403.24,
      "text": "对不起北京姑娘那个北京俩字"
    },
    {
      "end": 3407.84,
      "start": 3405.8,
      "text": "你真的是"
    },
    {
      "end": 3410.4,
      "start": 3407.84,
      "text": "因为当时张百发给我讲"
    },
    {
      "end": 3412.46,
      "start": 3410.4,
      "text": "他说江泽民进了北京以后"
    },
    {
      "end": 3413.74,
      "start": 3412.46,
      "text": "给张百发谈话"
    },
    {
      "end": 3418.34,
      "start": 3415.02,
      "text": "一开始江泽民是坐在那个背后的那个椅子上"
    },
    {
      "end": 3419.12,
      "start": 3418.34,
      "text": "晃来晃去的"
    },
    {
      "end": 3420.9,
      "start": 3419.12,
      "text": "那时候流行的老板椅"
    },
    {
      "end": 3423.46,
      "start": 3420.9,
      "text": "前面给张百发放了一把椅子"
    },
    {
      "end": 3426.02,
      "start": 3423.46,
      "text": "张百发的旁边是当时的公安部长"
    },
    {
      "end": 3427.04,
      "start": 3426.02,
      "text": "陶四居"
    },
    {
      "end": 3432.68,
      "start": 3427.04,
      "text": "说这个陶四居就不看张百发给陶四居布完工作"
    },
    {
      "end": 3436.0,
      "start": 3432.68,
      "text": "然后那个张百发让他进来"
    },
    {
      "end": 3437.28,
      "start": 3436.0,
      "text": "然后就在坐在那儿"
    },
    {
      "end": 3438.56,
      "start": 3437.28,
      "text": "他就给问张百发"
    },
    {
      "end": 3441.12,
      "start": 3438.56,
      "text": "多少北京级的官"
    },
    {
      "end": 3445.48,
      "start": 3441.12,
      "text": "谁是北京级的官你知道吗你给我数数"
    },
    {
      "end": 3448.8,
      "start": 3445.48,
      "text": "张百发这人特别聪明啊"
    },
    {
      "end": 3450.84,
      "start": 3448.8,
      "text": "然后就拜了手指头上啊就是数"
    },
    {
      "end": 3452.64,
      "start": 3450.84,
      "text": "数数的江泽民不耐烦了"
    },
    {
      "end": 3455.96,
      "start": 3452.64,
      "text": "你都没有数了我比你有数啊"
    },
    {
      "end": 3458.28,
      "start": 3455.96,
      "text": "然后就问张百发"
    },
    {
      "end": 3461.6,
      "start": 3458.28,
      "text": "张百发你说陈希同你怎么看啊"
    },
    {
      "end": 3462.12,
      "start": 3461.6,
      "text": "你怎么看啊"
    },
    {
      "end": 3465.96,
      "start": 3462.12,
      "text": "你怎么看六四啊"
    },
    {
      "end": 3466.96,
      "start": 3465.96,
      "text": "你怎么看啊"
    },
    {
      "end": 3467.96,
      "start": 3466.96,
      "text": "你怎么看啊六四啊"
    },
    {
      "end": 3468.96,
      "start": 3467.96,
      "text": "啊"
    },
    {
      "end": 3470.6,
      "start": 3468.96,
      "text": "当时你干什么了"
    },
    {
      "end": 3470.96,
      "start": 3470.6,
      "text": "啊"
    },
    {
      "end": 3472.76,
      "start": 3470.96,
      "text": "讲完以后"
    },
    {
      "end": 3477.36,
      "start": 3472.76,
      "text": "当时陈希同员呃这个张百发原话说完了"
    },
    {
      "end": 3479.4,
      "start": 3477.36,
      "text": "陈希同的人全都对你啊"
    },
    {
      "end": 3481.72,
