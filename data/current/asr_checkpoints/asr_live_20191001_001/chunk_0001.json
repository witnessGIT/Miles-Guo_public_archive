{
  "chunk_audio_sha256": "d22d99ce7265cad427e139cc6042e730811ab6d44fa97957c83af46be5b4e738",
  "chunk_index": 1,
  "completed_at": "2026-10-20T02:28:28Z",
  "language": "zh",
  "live_id": "LIVE_20191001_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
