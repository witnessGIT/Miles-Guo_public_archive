  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 903.72,
      "start": 900.0,
      "text": "現在只是此刻跟我對話的"
    },
    {
      "end": 905.72,
      "start": 903.72,
      "text": "Persi小皮匠"
    },
    {
      "end": 909.18,
      "start": 905.72,
      "text": "一個在德國 一個在法國"
    },
    {
      "end": 912.3,
      "start": 909.18,
      "text": "一個是產生希特勒的國家"
    },
    {
      "end": 914.72,
      "start": 912.3,
      "text": "一個是產生自由革命的國家"
    },
    {
      "end": 917.06,
      "start": 914.72,
      "text": "然後現在我們所有的人"
    },
    {
      "end": 919.56,
      "start": 917.06,
      "text": "全都在國外"
    },
    {
      "end": 922.28,
      "start": 919.56,
      "text": "我們嚴格講全都是流浪分子"
    },
    {
      "end": 924.38,
      "start": 922.28,
      "text": "全都是逼單分子"
    },
    {
      "end": 926.24,
      "start": 924.38,
      "text": "是不是"
    },
    {
      "end": 929.2,
      "start": 926.24,
      "text": "所以說你不覺得今天我們這個滑稽嗎"
    },
    {
      "end": 930.82,
      "start": 929.2,
      "text": "從天安門這條線"
    },
    {
      "end": 933.5,
      "start": 930.82,
      "text": "你連到香港 連到德國"
    },
    {
      "end": 937.12,
      "start": 933.5,
      "text": "連到法國 再連到我們紐約"
    },
    {
      "end": 939.72,
      "start": 937.12,
      "text": "而且現在千千萬個在鏡頭前"
    },
    {
      "end": 942.8,
      "start": 939.72,
      "text": "來看此時此刻直播的"
    },
    {
      "end": 946.56,
      "start": 942.8,
      "text": "這個滑稽 這個荒唐"
    },
    {
      "end": 948.76,
      "start": 946.56,
      "text": "是用什麼語言能掌握"
    },
    {
      "end": 951.02,
      "start": 948.76,
      "text": "所以共產黨它這個無知啊"
    },
    {
      "end": 953.08,
      "start": 951.02,
      "text": "它真的不是一般的無知"
    },
    {
      "end": 955.56,
      "start": 953.08,
      "text": "它也不是一般的傲慢"
    },
    {
      "end": 957.08,
      "start": 955.56,
      "text": "最根本的本質"
    },
    {
      "end": 958.72,
      "start": 957.08,
      "text": "共產黨這些站在天安門的人"
    },
    {
      "end": 960.34,
      "start": 958.72,
      "text": "有幾個還有幾年活動的"
    },
    {
      "end": 963.02,
      "start": 960.34,
      "text": "不管老的時候有幾年活動啊"
    },
    {
      "end": 964.64,
      "start": 963.02,
      "text": "那麼這些人"
    },
    {
      "end": 968.14,
      "start": 964.64,
      "text": "他們真的瞭解這世界嗎"
    },
    {
      "end": 971.14,
      "start": 968.14,
      "text": "他瞭解這人民嗎"
    },
    {
      "end": 974.82,
      "start": 971.14,
      "text": "他能代表人民嗎"
    },
    {
      "end": 980.32,
      "start": 974.82,
      "text": "他真的是瞭解現在香港進行的運動嗎"
    },
    {
      "end": 982.78,
      "start": 980.32,
      "text": "答案都不是的"
    },
    {
      "end": 986.86,
      "start": 982.78,
      "text": "可是他為什麼就拿一個防火牆"
    },
    {
      "end": 989.08,
      "start": 986.86,
      "text": "就拿點糧食"
    },
    {
      "end": 991.82,
      "start": 989.08,
      "text": "就拿了幾個電視台在那裡忽悠"
    },
    {
      "end": 993.94,
      "start": 991.82,
      "text": "就那幾個人"
    },
    {
      "end": 995.2,
      "start": 993.94,
      "text": "就那幾個人啊"
    },
    {
      "end": 997.24,
      "start": 995.2,
      "text": "把整個中國"
    },
    {
      "end": 1000.86,
      "start": 997.24,
      "text": "14億人民給呼籲成這樣"
    },
    {
      "end": 1003.16,
      "start": 1000.86,
      "text": "14億人啊"
    },
    {
      "end": 1005.16,
      "start": 1003.16,
      "text": "Persi批槍你們想想沒有"
    },
    {
      "end": 1006.0,
      "start": 1005.16,
      "text": "路德先生"
    },
    {
      "end": 1007.54,
      "start": 1006.0,
      "text": "他是14億啊"
    },
    {
      "end": 1008.7,
      "start": 1007.54,
      "text": "他不是說"
    },
    {
      "end": 1010.58,
      "start": 1008.7,
      "text": "一千四百萬兩千多萬啊"
    },
    {
      "end": 1012.86,
      "start": 1010.58,
      "text": "為什麼我們這個民主變得"
    },
    {
      "end": 1015.22,
      "start": 1012.86,
      "text": "現在這麼可悲這麼可憐呢"
    },
    {
      "end": 1017.84,
      "start": 1015.22,
      "text": "這剛剛在一個小時前"
    },
    {
      "end": 1021.52,
      "start": 1017.84,
      "text": "我和這個香港現場的人嚎啕大哭"
    },
    {
      "end": 1024.98,
      "start": 1021.52,
      "text": "我說這咱這麼冷靜人啊"
    },
    {
      "end": 1026.1,
      "start": 1024.98,
      "text": "哭他是個律師"
    },
    {
      "end": 1029.38,
      "start": 1026.1,
      "text": "他說郭先生我看到這個天安門上閱兵"
    },
    {
      "end": 1031.72,
      "start": 1029.38,
      "text": "他說我就覺得我當這個中國人"
    },
    {
      "end": 1032.42,
      "start": 1031.72,
      "text": "我當香港人"
    },
    {
      "end": 1033.52,
      "start": 1032.42,
      "text": "他說我覺得我可憐"
    },
    {
      "end": 1035.98,
      "start": 1033.52,
      "text": "他說什麼年代了"
    },
    {
      "end": 1037.92,
      "start": 1035.98,
      "text": "他說中國人還玩這一套"
    },
    {
      "end": 1039.88,
      "start": 1037.92,
      "text": "北朝下部總覺得是笑話"
    },
    {
      "end": 1041.68,
      "start": 1039.88,
      "text": "他說怎麼想也不敢想"
    },
    {
      "end": 1043.38,
      "start": 1041.68,
      "text": "這個笑話就發生在天安門"
    },
    {
      "end": 1044.84,
      "start": 1043.38,
      "text": "而且還這麼發生"
    },
    {
      "end": 1048.14,
      "start": 1044.84,
      "text": "這哥們就受不了了"
    },
    {
      "end": 1051.6,
      "start": 1048.14,
      "text": "而且本來這個人是超級愛港愛國的"
    },
    {
      "end": 1055.6,
      "start": 1051.6,
      "text": "當年還準備要選那個香港特首"
    },
    {
      "end": 1056.68,
      "start": 1055.6,
      "text": "跟梁振英特好"
    },
    {
      "end": 1060.64,
      "start": 1056.68,
      "text": "而且他當時是律師界別的"
    },
    {
      "end": 1061.5,
      "start": 1060.64,
      "text": "非常帥個人"
    },
    {
      "end": 1062.34,
      "start": 1061.5,
      "text": "特別好"
    },
    {
      "end": 1063.8,
      "start": 1062.34,
      "text": "真的愛中國"
    },
    {
      "end": 1065.72,
      "start": 1063.8,
      "text": "我說你到底要愛國愛黨啊"
    },
    {
      "end": 1066.84,
      "start": 1065.72,
      "text": "後來時間長了"
    },
    {
      "end": 1069.5,
      "start": 1066.84,
      "text": "他說哎呀我發現現在多愛黨不愛國"
    },
    {
      "end": 1070.14,
      "start": 1069.5,
      "text": "再時間長了"
    },
    {
      "end": 1071.5,
      "start": 1070.14,
      "text": "你還想香港特首嗎"
    },
    {
      "end": 1073.64,
      "start": 1071.5,
      "text": "他說這個港澳辦來找我談"
    },
    {
      "end": 1074.84,
      "start": 1073.64,
      "text": "希望我來選港特首"
    },
    {
      "end": 1076.84,
      "start": 1074.84,
      "text": "他要當沒有梁振英的"
    },
    {
      "end": 1077.64,
      "start": 1076.84,
      "text": "這個哥們兒"
    },
    {
      "end": 1079.14,
      "start": 1077.64,
      "text": "沒有梁振英的"
    },
    {
      "end": 1081.0,
      "start": 1079.14,
      "text": "然後呢很多人支持他"
    },
    {
      "end": 1083.18,
      "start": 1081.0,
      "text": "後來我跟他老朋友一次聊天"
    },
    {
      "end": 1085.6,
      "start": 1083.18,
      "text": "我說我給你介紹介紹共產黨的歷史"
    },
    {
      "end": 1087.6,
      "start": 1085.6,
      "text": "爹親娘親不如黨親"
    },
    {
      "end": 1088.94,
      "start": 1087.6,
      "text": "怎麼來的"
    },
    {
      "end": 1092.14,
      "start": 1088.94,
      "text": "共產黨然後毛澤東是怎麼搞女人的"
    },
    {
      "end": 1093.94,
      "start": 1092.14,
      "text": "照你看你看看"
    },
    {
      "end": 1095.24,
      "start": 1093.94,
      "text": "這怎麼搞女人的"
    },
    {
      "end": 1097.24,
      "start": 1095.24,
      "text": "他們怎麼殺孩子的"
    },
    {
      "end": 1098.24,
      "start": 1097.24,
      "text": "他老婆說"
    },
    {
      "end": 1100.78,
      "start": 1098.24,
      "text": "郭先生你講這些都有證據嗎"
    },
    {
      "end": 1102.2,
      "start": 1100.78,
      "text": "我說你們從來不了解共產黨"
    },
    {
      "end": 1103.9,
      "start": 1102.2,
      "text": "我說我給你找點證據"
    },
    {
      "end": 1107.74,
      "start": 1103.9,
      "text": "後來我就專門把台灣一個人送給我一本書"
    },
    {
      "end": 1111.04,
      "start": 1107.74,
      "text": "說共產黨與國民黨之間的較量那本書"
    },
    {
      "end": 1113.98,
      "start": 1111.04,
      "text": "大家可能是有些人看過有些人沒看過啊"
    },
    {
      "end": 1115.9,
      "start": 1113.98,
      "text": "不是大量出版的我給他看了"
    },
    {
      "end": 1118.3,
      "start": 1115.9,
      "text": "那裏面很多圖畫"
    },
    {
      "end": 1120.66,
      "start": 1118.3,
      "text": "他老婆成了我最大的叔叔"
    },
    {
      "end": 1122.74,
      "start": 1120.66,
      "text": "最後他當然就知道了"
    },
    {
      "end": 1125.24,
      "start": 1122.74,
      "text": "現在的中國就是黨"
    },
    {
      "end": 1126.3,
      "start": 1125.24,
      "text": "剛才給我哭的時候"
    },
    {
      "end": 1128.74,
      "start": 1126.3,
      "text": "他說郭先生我現在想起你當時我說"
    },
    {
      "end": 1132.66,
      "start": 1128.74,
      "text": "我要當了香港特首我可能比林鄭月娥還壞"
    },
    {
      "end": 1137.06,
      "start": 1132.66,
      "text": "他說這個黨它就是讓人變壞的"
    },
    {
      "end": 1140.74,
      "start": 1137.06,
      "text": "他說香港的警察一百年練就是警察"
    },
    {
      "end": 1143.8,
      "start": 1140.74,
      "text": "他說他一個小時就給毀了"
    },
    {
      "end": 1147.26,
      "start": 1143.8,
      "text": "所以說這個魔鬼的力量是多大呀"
    },
    {
      "end": 1149.4,
      "start": 1147.26,
      "text": "魔鬼的力量是多大呀"
    },
    {
      "end": 1153.3,
      "start": 1149.4,
      "text": "所以這個Prescia小提教你們這問題問特別好"
    },
    {
      "end": 1158.3,
      "start": 1153.3,
      "text": "這個這次的閱兵嚴格講說白了"
    },
    {
      "end": 1160.0,
      "start": 1158.3,
      "text": "他沒有任何稀罕的"
    },
    {
      "end": 1162.9,
      "start": 1160.0,
      "text": "路德先生可以坐在船上握著說的"
    },
    {
      "end": 1164.2,
      "start": 1162.9,
      "text": "99%吧"
    },
    {
      "end": 1165.2,
      "start": 1164.2,
      "text": "我都說是百"
    },
    {
      "end": 1169.66,
      "start": 1167.26,
      "text": "我都完全這樣嗎"
    },
    {
      "end": 1171.54,
      "start": 1169.66,
      "text": "這實際上是一個"
    },
    {
      "end": 1173.66,
      "start": 1171.54,
      "text": "我們很團結啊"
    },
    {
      "end": 1175.32,
      "start": 1173.66,
      "text": "別挑戰我們"
    },
    {
      "end": 1177.42,
      "start": 1175.32,
      "text": "黨內現在就是一個時候亂習近平"
    },
    {
      "end": 1180.86,
      "start": 1177.42,
      "text": "說這次所有的徹徹底底從19大修憲"
    },
    {
      "end": 1185.76,
      "start": 1180.86,
      "text": "通過這閱兵變成了就是人民軍隊變成了所謂黨"
    },
    {
      "end": 1188.56,
      "start": 1185.76,
      "text": "黨已經變成了習就是習家軍"
    },
    {
      "end": 1190.12,
      "start": 1188.56,
      "text": "就宣佈就是習家軍了"
    },
    {
      "end": 1193.62,
      "start": 1190.12,
      "text": "然後你看看這個特別是徐其亮"
    },
    {
      "end": 1194.88,
      "start": 1193.62,
      "text": "習以小光"
    },
    {
      "end": 1197.32,
      "start": 1194.88,
      "text": "像丁憲月原來這些老兵"
    },
    {
      "end": 1200.32,
      "start": 1197.32,
      "text": "幾乎這原來的人都不在"
    },
    {
      "end": 1203.08,
      "start": 1200.32,
      "text": "更重要大家看到有個女了"
    },
    {
      "end": 1205.72,
      "start": 1203.08,
      "text": "Prescia和這個小皮將"
    },
    {
      "end": 1208.22,
      "start": 1205.72,
      "text": "你見這個天安門有幾個女的領導啊"
    },
    {
      "end": 1210.42,
      "start": 1208.22,
      "text": "包括女老領導有幾個女領導啊"
    },
    {
      "end": 1214.58,
      "start": 1210.42,
      "text": "這次我告訴你"
    },
    {
      "end": 1216.42,
      "start": 1214.58,
      "text": "是真的你在天安門上看"
    },
    {
      "end": 1218.62,
      "start": 1216.42,
      "text": "出現和被沒能出現的人"
    },
    {
      "end": 1219.92,
      "start": 1218.62,
      "text": "絕對有政治意義了"
    },
    {
      "end": 1222.72,
      "start": 1219.92,
      "text": "這就給我們頭兩天就報出來的"
    },
    {
      "end": 1223.92,
      "start": 1222.72,
      "text": "解讀出來的"
    },
    {
      "end": 1226.36,
      "start": 1223.92,
      "text": "朱鎔基和江振林的恐懼"
    },
    {
      "end": 1229.86,
      "start": 1226.36,
      "text": "曾慶紅你看現在也恐懼到不敢出來"
    },
    {
      "end": 1230.86,
      "start": 1229.86,
      "text": "先掉褲子了"
    },
    {
      "end": 1232.06,
      "start": 1230.86,
      "text": "估計找理由"
    },
    {
      "end": 1234.16,
      "start": 1232.06,
      "text": "到海南到那去治病去了"
    },
    {
      "end": 1237.66,
      "start": 1234.16,
      "text": "但是天安門上有幾個女的"
    },
    {
      "end": 1240.26,
      "start": 1237.66,
      "text": "你看有幾個女的"
    },
    {
      "end": 1243.86,
      "start": 1240.26,
      "text": "這個所有人要求是必須到場的"
    },
    {
      "end": 1246.56,
      "start": 1243.86,
      "text": "中央通知是必須到場"
    },
    {
      "end": 1249.16,
      "start": 1246.56,
      "text": "膽敢不到場的就兩種原因"
    },
    {
      "end": 1251.46,
      "start": 1249.16,
      "text": "一個是實在是病了到不了場"
    },
    {
      "end": 1254.46,
      "start": 1251.46,
      "text": "一個實在是抓了想來來不了了"
    },
    {
      "end": 1258.26,
      "start": 1254.46,
      "text": "那麼這個未來你會看到很多政治端倪"
    },
    {
      "end": 1259.96,
      "start": 1258.26,
      "text": "另外一個我聽說"
    },
    {
      "end": 1261.96,
      "start": 1259.96,
      "text": "宋平本來也是不來的"
    },
    {
      "end": 1263.56,
      "start": 1261.96,
      "text": "最後也是宋平來了"
    },
    {
      "end": 1265.06,
      "start": 1263.56,
      "text": "就宋平不來"
    },
    {
      "end": 1268.16,
      "start": 1265.06,
      "text": "就是我這個習家軍的這個法治性"
    },
    {
      "end": 1269.56,
      "start": 1268.16,
      "text": "就是說不夠"
    },
    {
      "end": 1271.76,
      "start": 1269.56,
      "text": "這個宋平是最老的嘛在裏邊對吧"
    },
    {
      "end": 1273.86,
      "start": 1271.76,
      "text": "最老一代了那不行"
    },
    {
      "end": 1277.16,
      "start": 1273.86,
      "text": "但是軍隊裏邊這幾個老同志幾乎都沒來"
    },
    {
      "end": 1278.86,
      "start": 1277.16,
      "text": "除了抓的抓死的死"
    },
    {
      "end": 1281.06,
      "start": 1278.86,
      "text": "活著幾個核心人物都沒來"
    },
    {
      "end": 1283.06,
      "start": 1281.66,
      "text": "這是很可怕的"
    },
    {
      "end": 1286.86,
      "start": 1283.06,
      "text": "習家軍裏邊竟然沒有延續性沒有老幹部"
    },
    {
      "end": 1287.86,
      "start": 1286.86,
      "text": "這個有問題"
    },
    {
      "end": 1290.86,
      "start": 1288.36,
      "text": "在一個昨天在幾個大戰區裏邊"
    },
    {
      "end": 1294.56,
      "start": 1290.86,
      "text": "我看到主要是以東部戰區為主"
    },
    {
      "end": 1297.36,
      "start": 1295.16,
      "text": "東部戰區裏邊很多將領啊"
    },
    {
      "end": 1298.86,
      "start": 1297.36,
      "text": "都是許其亮的手下"
    },
    {
      "end": 1302.76,
      "start": 1299.36,
      "text": "所以現在中國的習家軍的底子是什麼呢"
    },
    {
      "end": 1304.26,
      "start": 1302.76,
      "text": "全部都是空軍"
    },
    {
      "end": 1307.46,
      "start": 1305.36,
      "text": "但是習軍中的是海軍"
    },
    {
      "end": 1309.26,
      "start": 1307.46,
      "text": "海軍的馬勝利啊"
    },
    {
      "end": 1312.26,
      "start": 1309.26,
      "text": "還是過去的這一套東西幾乎被抓完了"
    },
    {
      "end": 1314.76,
      "start": 1312.26,
      "text": "就是張萬年的手下啊"
    },
    {
      "end": 1317.46,
      "start": 1314.76,
      "text": "還有劉華卿的老手下已經換完了"
    },
    {
      "end": 1318.66,
      "start": 1317.46,
      "text": "全部給消滅掉了"
    },
    {
      "end": 1320.76,
      "start": 1318.66,
      "text": "現在換的基本上是紮盆軍"
    },
    {
      "end": 1322.96,
      "start": 1321.26,
      "text": "現在軍隊能不能打仗"
    },
    {
      "end": 1324.06,
      "start": 1322.96,
      "text": "我可以告訴你"
    },
    {
      "end": 1326.86,
      "start": 1324.06,
      "text": "就昨天看著軍隊他絕對不能打仗"
    },
    {
      "end": 1329.86,
      "start": 1327.86,
      "text": "絕對信不齊"
    },
    {
      "end": 1333.66,
      "start": 1330.86,
      "text": "現在也能看出來對香港採取的行動啊"
    },
    {
      "end": 1336.36,
      "start": 1333.66,
      "text": "這裡邊有了深刻的內涵了"
    },
    {
      "end": 1337.36,
      "start": 1336.36,
      "text": "我知道嗎"
    },
    {
      "end": 1339.86,
      "start": 1337.36,
      "text": "為什麼他在10月1號以前"
    },
    {
      "end": 1342.36,
      "start": 1339.86,
      "text": "不宣布啊"
    },
    {
      "end": 1343.66,
      "start": 1342.36,
      "text": "這個全部戒嚴"
    },
    {
      "end": 1345.06,
      "start": 1343.66,
      "text": "除了給國慶節"
    },
    {
      "end": 1347.66,
      "start": 1345.06,
      "text": "也過個順利平安的啊"
    },
    {
      "end": 1348.66,
      "start": 1347.66,
      "text": "國慶節"
    },
    {
      "end": 1350.16,
      "start": 1348.66,
      "text": "過渡到習家軍"
    },
    {
      "end": 1352.66,
      "start": 1351.06,
      "text": "更核心的背後有一條"
    },
    {
      "end": 1355.16,
      "start": 1353.16,
      "text": "他還真不一定就敢啊"
    },
    {
      "end": 1357.66,
      "start": 1355.16,
      "text": "啊當時的動得了啊"
    },
    {
      "end": 1358.86,
      "start": 1357.66,
      "text": "真不一定動得了"
    },
    {
      "end": 1360.26,
      "start": 1358.86,
      "text": "我認為在香港這個問題呢"
    },
    {
      "end": 1362.86,
      "start": 1360.26,
      "text": "看來在黨內爭議是巨大的啊"
    },
    {
      "end": 1363.66,
      "start": 1362.86,
      "text": "因此"
    },
    {
      "end": 1366.86,
      "start": 1364.46,
      "text": "這個國慶讓我們看到了共產黨"
    },
    {
      "end": 1367.66,
      "start": 1366.86,
      "text": "真的是"
    },
    {
      "end": 1369.66,
      "start": 1368.16,
      "text": "山窮水盡啊"
    },
    {
      "end": 1371.16,
      "start": 1369.86,
      "text": "瘋狂至極"
    },
    {
      "end": 1373.66,
      "start": 1372.16,
      "text": "我先簡單說到這兒"
    },
    {
      "end": 1374.36,
      "start": 1373.66,
      "text": "Persy"
    },
    {
      "end": 1376.56,
      "start": 1374.36,
      "text": "雪皮家您倆有什麼請請指示"
    },
    {
      "end": 1378.96,
      "start": 1378.26,
      "text": "郭先生"
    },
    {
      "end": 1379.56,
      "start": 1378.96,
      "text": "我們還是"
    },
    {
      "end": 1380.96,
      "start": 1379.56,
      "text": "我們還看到了一點"
    },
    {
      "end": 1381.76,
      "start": 1380.96,
      "text": "就是"
    },
    {
      "end": 1383.46,
      "start": 1381.76,
      "text": "很多大家都看到了"
    },
    {
      "end": 1383.96,
      "start": 1383.46,
      "text": "就是"
    },
    {
      "end": 1386.16,
      "start": 1383.96,
      "text": "上一次就是60年大"
    },
    {
      "end": 1388.06,
      "start": 1386.16,
      "text": "就是60年大慶閱兵的時候"
    },
    {
      "end": 1390.66,
      "start": 1388.06,
      "text": "那些將就是中央軍委的那些人"
    },
    {
      "end": 1392.26,
      "start": 1390.66,
      "text": "幾乎全部陣亡啊"
    },
    {
      "end": 1394.36,
      "start": 1393.16,
      "text": "大家就講說"
    },
    {
      "end": 1397.06,
      "start": 1394.36,
      "text": "這個比二戰的那個傷亡還慘重"
    },
    {
      "end": 1398.66,
      "start": 1397.06,
      "text": "就是全部都換了血"
    },
    {
      "end": 1399.56,
      "start": 1398.66,
      "text": "全部都沒有了"
    },
    {
      "end": 1401.66,
      "start": 1399.56,
      "text": "然後呢今年呢還有一個特點"
    },
    {
      "end": 1404.06,
      "start": 1401.66,
      "text": "就是在閱兵的隊伍裡面呢"
    },
    {
      "end": 1404.86,
      "start": 1404.06,
      "text": "有一個"
    },
    {
      "end": 1407.26,
      "start": 1405.36,
      "text": "將軍的這麼一個方陣"
    },
    {
      "end": 1408.96,
      "start": 1407.26,
      "text": "就是27名好像是"
    },
    {
      "end": 1409.96,
      "start": 1409.16,
      "text": "將軍啊"
    },
    {
      "end": 1411.66,
      "start": 1410.36,
      "text": "在那去閱兵"
    },
    {
      "end": 1412.86,
      "start": 1411.96,
      "text": "就是我不知道"
    },
    {
      "end": 1414.06,
      "start": 1412.86,
      "text": "就算看西方啊"
    },
    {
      "end": 1414.86,
      "start": 1414.06,
      "text": "任何"
    },
    {
      "end": 1415.36,
      "start": 1414.86,
      "text": "這個國家"
    },
    {
      "end": 1417.76,
      "start": 1415.36,
      "text": "我不知道就多少年的心血啊"
    },
    {
      "end": 1420.36,
      "start": 1417.76,
      "text": "就是這些人他們應該是做"
    },
    {
      "end": 1422.56,
      "start": 1420.36,
      "text": "將軍不應該是在這兒賣著方部"
    },
    {
      "end": 1424.26,
      "start": 1422.56,
      "text": "在這兒表忠心的這種狀態啊"
    },
    {
      "end": 1425.26,
      "start": 1424.26,
      "text": "像在中國"
    },
    {
      "end": 1426.06,
      "start": 1425.26,
      "text": "所以像呢"
    },
    {
      "end": 1427.26,
      "start": 1426.06,
      "text": "剛才你講啊"
    },
    {
      "end": 1428.46,
      "start": 1427.26,
      "text": "現在就是"
    },
    {
      "end": 1429.76,
      "start": 1428.76,
      "text": "幾個人"
    },
    {
      "end": 1432.76,
      "start": 1430.26,
      "text": "這個全國人跟著他們在一起做"
    },
    {
      "end": 1436.56,
      "start": 1432.76,
      "text": "就是今天這次的這個閱兵是表現的特別特別明顯"
    },
    {
      "end": 1438.66,
      "start": 1436.56,
      "text": "就是外強中竿"
    },
    {
      "end": 1439.56,
      "start": 1438.66,
      "text": "但是呢"
    },
    {
      "end": 1442.56,
      "start": 1440.06,
      "text": "我有飛機大炮就能撐一時撐一時"
    },
    {
      "end": 1443.26,
      "start": 1442.56,
      "text": "就這個"
    },
    {
      "end": 1444.26,
      "start": 1443.76,
      "text": "狀態"
    },
    {
      "end": 1445.56,
      "start": 1444.26,
      "text": "今年特別特別明顯"
    },
    {
      "end": 1446.26,
      "start": 1445.56,
      "text": "很多人"
    },
    {
      "end": 1447.16,
      "start": 1446.26,
      "text": "我們知道北京"
    },
    {
      "end": 1448.96,
      "start": 1447.16,
      "text": "像我和小股像都是在北京啊"
    },
    {
      "end": 1451.66,
      "start": 1449.16,
      "text": "很多人年輕人都離開城市就是"
    },
    {
      "end": 1454.46,
      "start": 1452.06,
      "text": "根本就不是像大家想的說粉紅色"
    },
    {
      "end": 1455.56,
      "start": 1454.46,
      "text": "在北京啊"
    },
    {
      "end": 1455.86,
      "start": 1455.56,
      "text": "這種"
    },
    {
      "end": 1457.56,
      "start": 1455.86,
      "text": "其實微信群"
    },
    {
      "end": 1459.16,
      "start": 1457.56,
      "text": "我們自己觀察這幾天啊"
    },
    {
      "end": 1461.06,
      "start": 1459.16,
      "text": "就是有一個挺大的分裂"
    },
    {
      "end": 1462.66,
      "start": 1461.06,
      "text": "就是一群人真的就是"
    },
    {
      "end": 1466.16,
      "start": 1462.96,
      "text": "只看到祖國就是一片紅的這種狀態"
    },
    {
      "end": 1468.96,
      "start": 1466.16,
      "text": "但是相反的有一大部分人真的就是"
    },
    {
      "end": 1471.36,
      "start": 1470.56,
      "text": "煩透了"
    },
    {
      "end": 1473.06,
      "start": 1471.36,
      "text": "就覺得是第二次文革"
    },
    {
      "end": 1477.16,
      "start": 1473.06,
      "text": "就是毛澤東轉世看的特別特別清楚"
    },
    {
      "end": 1477.86,
      "start": 1477.16,
      "text": "所以"
    },
    {
      "end": 1479.86,
      "start": 1479.16,
      "text": "郭先生您對這"
    },
    {
      "end": 1480.46,
      "start": 1479.86,
      "text": "我想"
    },
    {
      "end": 1482.66,
      "start": 1480.46,
      "text": "我想就是很多人都看到這一點啊"
    },
    {
      "end": 1483.96,
      "start": 1482.66,
      "text": "就是不是說像"
    },
    {
      "end": 1484.86,
      "start": 1483.96,
      "text": "真的像文革的時候"
    },
    {
      "end": 1487.66,
      "start": 1484.86,
      "text": "他的幾乎所有的人頭都是"
    },
    {
      "end": 1488.76,
      "start": 1488.06,
      "text": "都是被傻的"
    },
    {
      "end": 1489.16,
      "start": 1488.76,
      "text": "因為"
    },
    {
      "end": 1490.16,
      "start": 1489.36,
      "text": "都是挺傻的"
    },
    {
      "end": 1491.16,
      "start": 1490.16,
      "text": "但是這一次呢"
    },
    {
      "end": 1491.76,
      "start": 1491.16,
      "text": "不是這樣"
    },
    {
      "end": 1493.76,
      "start": 1491.76,
      "text": "很多人都在慢慢的崛起"
    },
    {
      "end": 1495.66,
      "start": 1495.06,
      "text": "您說呢"
    },
    {
      "end": 1496.16,
      "start": 1495.66,
      "text": "郭先生"
    },
    {
      "end": 1496.86,
      "start": 1496.26,
      "text": "小皮"
    },
    {
      "end": 1498.36,
      "start": 1496.86,
      "text": "你觀察特別好"
    },
    {
      "end": 1499.16,
      "start": 1498.36,
      "text": "严格講"
    },
    {
      "end": 1501.76,
      "start": 1499.16,
      "text": "在昨天之前吧"
    },
    {
      "end": 1502.76,
      "start": 1502.06,
      "text": "也就是說"
    },
    {
      "end": 1504.86,
      "start": 1502.76,
      "text": "咱們大家說像文革這個詞呢"
    },
    {
      "end": 1505.46,
      "start": 1504.86,
      "text": "大家"
    },
    {
      "end": 1507.26,
      "start": 1505.66,
      "text": "還在懷疑猶豫啊"
    },
    {
      "end": 1509.16,
      "start": 1507.86,
      "text": "但是今天來看"
    },
    {
      "end": 1510.66,
      "start": 1509.16,
      "text": "他已經不是像文革了"
    },
    {
      "end": 1512.16,
      "start": 1510.66,
      "text": "他已經超文革了"
    },
    {
      "end": 1514.56,
      "start": 1512.16,
      "text": "一夜之間超過文革了"
    },
    {
      "end": 1517.56,
      "start": 1514.86,
      "text": "文革當中有兩個東西是從來沒有的"
    },
    {
      "end": 1519.26,
      "start": 1517.56,
      "text": "這跟老革命談的時候"
    },
    {
      "end": 1520.96,
      "start": 1519.46,
      "text": "就是文革當中"
    },
    {
      "end": 1522.76,
      "start": 1520.96,
      "text": "毛澤東不管如何"
    },
    {
      "end": 1524.36,
      "start": 1523.26,
      "text": "他還開個會"
    },
    {
      "end": 1525.96,
      "start": 1524.76,
      "text": "他還所謂的"
    },
    {
      "end": 1527.66,
      "start": 1526.16,
      "text": "有這個中央"
    },
    {
      "end": 1529.76,
      "start": 1527.66,
      "text": "他老提中央政府"
    },
    {
      "end": 1531.96,
      "start": 1529.76,
      "text": "他要找老奶奶吃一嗓子"
    },
    {
      "end": 1533.16,
      "start": 1531.96,
      "text": "中央政府"
    },
    {
      "end": 1533.86,
      "start": 1533.16,
      "text": "是吧"
    },
    {
      "end": 1535.16,
      "start": 1534.16,
      "text": "還有一個是什麽"
    },
    {
      "end": 1536.46,
      "start": 1535.16,
      "text": "他團結老百姓了"
    },
    {
      "end": 1537.66,
      "start": 1536.76,
      "text": "他把一些孩子"
    },
    {
      "end": 1538.96,
      "start": 1537.66,
      "text": "紅衛兵都給團結起來了"
    },
    {
      "end": 1539.56,
      "start": 1538.96,
      "text": "對吧"
    },
    {
      "end": 1541.06,
      "start": 1540.16,
      "text": "小皮獎大家"
    },
    {
      "end": 1542.86,
      "start": 1541.06,
      "text": "你這個PRECY你都記得"
    },
    {
      "end": 1544.86,
      "start": 1542.86,
      "text": "那些很多學生孩子他還是團結的"
    },
    {
      "end": 1545.26,
      "start": 1544.86,
      "text": "又不是什麽"
    },
    {
      "end": 1546.06,
      "start": 1545.26,
      "text": "又是紅衛兵啊"
    },
    {
      "end": 1546.66,
      "start": 1546.06,
      "text": "是吧"
    },
    {
      "end": 1548.56,
      "start": 1546.96,
      "text": "他還要有個群眾基礎"
    },
    {
      "end": 1550.56,
      "start": 1549.16,
      "text": "這回可不是了啊"
    },
    {
      "end": 1552.16,
      "start": 1551.06,
      "text": "這回可不是了"
    },
    {
      "end": 1553.46,
      "start": 1552.16,
      "text": "你發現他團結誰了"
    },
    {
      "end": 1555.16,
      "start": 1553.96,
      "text": "你發現他團結誰了"
    },
    {
      "end": 1556.26,
      "start": 1555.36,
      "text": "申改蘭"
    },
    {
      "end": 1559.26,
      "start": 1557.16,
      "text": "你發現他就是死去的那個叫什麽"
    },
    {
