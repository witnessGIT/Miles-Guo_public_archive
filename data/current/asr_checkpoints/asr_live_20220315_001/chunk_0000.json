      "compression_ratio": 1.461538,
      "end": 482.34,
      "no_speech_prob": 0.0,
      "start": 473.34,
      "text": "Today, Ukraine's President Volodymyr Zelenskyy visited soldiers at this hospital in the capital as Russian forces advance on the city."
