{
  "chunk_audio_sha256": "59e704c20dec1e203d1eccd055d6e93bbcca31f512389bbd514a1a6412a5d9b1",
  "chunk_index": 7,
  "completed_at": "2026-10-20T14:13:00Z",
  "language": "zh",
  "live_id": "LIVE_20211003_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 6300,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 6302.88,
      "start": 6300.0,
      "text": "不要这种心理 恰恰是敌人"
    },
    {
      "end": 6304.8,
      "start": 6302.88,
      "text": "我们的对手就玩这种游戏"
    },
    {
      "end": 6306.6,
      "start": 6304.8,
      "text": "你看看现在傅政华被抓了"
    },
    {
      "end": 6309.88,
      "start": 6306.6,
      "text": "从个人来讲 家庭来讲我太痛快了"
    },
    {
      "end": 6310.68,
      "start": 6309.88,
      "text": "是不是"
    },
    {
      "end": 6313.88,
      "start": 6310.68,
      "text": "我所有的家人被抓都是傅政华先执行的"
    },
    {
      "end": 6316.32,
      "start": 6313.88,
      "text": "第二波是孙力军和孟建柱"
    },
    {
      "end": 6319.12,
      "start": 6316.32,
      "text": "我第一个恨死的就是傅政华"
    },
    {
      "end": 6323.72,
      "start": 6319.12,
      "text": "第二个我恨的就是孟建柱孙力军"
    },
    {
      "end": 6325.32,
      "start": 6323.72,
      "text": "第四才轮到王岐山"
    },
    {
      "end": 6329.6,
      "start": 6325.32,
      "text": "但是我告诉你 爆料革命不能有我心"
    },
    {
      "end": 6332.0,
      "start": 6330.0,
      "text": "我们要灭的是共产党"
    },
    {
      "end": 6335.0,
      "start": 6332.0,
      "text": "我要看到的是"
    },
    {
      "end": 6338.2,
      "start": 6335.0,
      "text": "你看王岐山孟建柱一定被抓"
    },
    {
      "end": 6341.72,
      "start": 6338.2,
      "text": "记住啊 我说傅政华抓是今年二月份抓的"
    },
    {
      "end": 6345.84,
      "start": 6341.72,
      "text": "只有七哥告诉你们二月份傅政华被抓了"
    },
    {
      "end": 6347.36,
      "start": 6345.84,
      "text": "没有人理我 你们在说"
    },
    {
      "end": 6349.68,
      "start": 6347.36,
      "text": "你们大理我七哥胡说八道的嘛"
    },
    {
      "end": 6353.4,
      "start": 6349.68,
      "text": "他是二月份被抓 然后沈几回回家"
    },
    {
      "end": 6357.0,
      "start": 6353.4,
      "text": "吴征已经被抓了四次了 保沈"
    },
    {
      "end": 6359.84,
      "start": 6357.0,
      "text": "现在吴征唯一在忽悠这个共产党的是什么"
    },
    {
      "end": 6365.0,
      "start": 6360.0,
      "text": "杨岚要是党 现在我能保证把用强奸案"
    },
    {
      "end": 6368.8,
      "start": 6365.0,
      "text": "还有控制的几个案子 包括博讯还能把郭文贵给干灭"
    },
    {
      "end": 6370.0,
      "start": 6368.8,
      "text": "出你监狱"
    },
    {
      "end": 6372.08,
      "start": 6370.0,
      "text": "你不要抓我呀 你不要抓我呀"
    },
    {
      "end": 6374.0,
      "start": 6372.08,
      "text": "还有我海外的钱我弄回来"
    },
    {
      "end": 6377.0,
      "start": 6374.0,
      "text": "所以现在就想办法我老婆杨岚做保证"
    },
    {
      "end": 6379.0,
      "start": 6377.0,
      "text": "我绝对不会跑 你让我出国"
    },
    {
      "end": 6383.0,
      "start": 6379.0,
      "text": "让我出国 出了国他管他老婆杨岚干嘛 是吧"
    },
    {
      "end": 6385.0,
      "start": 6383.0,
      "text": "他永远就不回去了 是吧 这孙子"
    },
    {
      "end": 6389.0,
      "start": 6385.0,
      "text": "你像马云 马云最近能去香港了 马云最近到香港去了"
    },
    {
      "end": 6391.0,
      "start": 6389.0,
      "text": "马云现在说我到外面给你们弄钱去"
    },
    {
      "end": 6393.8,
      "start": 6391.0,
      "text": "马云打着机会就跑了 就肯定跑掉了"
    },
    {
      "end": 6399.0,
      "start": 6393.8,
      "text": "都是这么互相的骗 那么你要同时你还能看到"
    },
    {
      "end": 6402.0,
      "start": 6399.0,
      "text": "接下来骗的最厉害是谁呀 王岐山和孟建筑"
    },
    {
      "end": 6404.0,
      "start": 6402.0,
      "text": "还有杨洁篪还有王毅"
    },
    {
      "end": 6410.0,
      "start": 6404.0,
      "text": "杨洁篪和王毅还有陈国平还有尼坚这好人"
    },
    {
      "end": 6413.0,
      "start": 6410.0,
      "text": "这些人爆雷的时候才是共产党到大北的时候"
    },
    {
      "end": 6416.0,
      "start": 6413.0,
      "text": "王岐山 孟建筑被抓的时候"
    },
    {
      "end": 6419.0,
      "start": 6416.0,
      "text": "才能你意想不到的惊天的料才能出来"
    },
    {
      "end": 6423.0,
      "start": 6419.0,
      "text": "爆料革命 全世界的政治家记住郭文贵今天说这话"
    },
    {
      "end": 6430.0,
      "start": 6423.0,
      "text": "只有房积篪 孟建筑 杨洁篪 周亮和王毅被抓的时候"
    },
    {
      "end": 6433.0,
      "start": 6430.0,
      "text": "共产党那个楼才咯吱吱想你才能听到"
    },
    {
      "end": 6437.0,
      "start": 6433.0,
      "text": "或者是沉西 栗战书 丁薛祥被抓的时候"
    },
    {
      "end": 6439.0,
      "start": 6437.0,
      "text": "你才能听到咯吱吱咯吱吱的响"
    },
    {
      "end": 6442.0,
      "start": 6439.0,
      "text": "没这些动静 这些人你就当中"
    },
    {
      "end": 6444.0,
      "start": 6442.0,
      "text": "一秒钟都被浪费你们的时间"
    },
    {
      "end": 6448.0,
      "start": 6444.0,
      "text": "共产党的内斗现在是刚刚开始"
    },
    {
      "end": 6451.0,
      "start": 6448.0,
      "text": "甚至还没有开始"
    },
    {
      "end": 6454.0,
      "start": 6451.0,
      "text": "在这个中间唯一的两件事就是打台湾"
    },
    {
      "end": 6456.0,
      "start": 6454.0,
      "text": "会让转移你的视线"
    },
    {
      "end": 6460.0,
      "start": 6456.0,
      "text": "还有一个就是美国和中共的各种经济的崩塌"
    },
    {
      "end": 6462.0,
      "start": 6460.0,
      "text": "但是你记住"
    },
    {
      "end": 6466.0,
      "start": 6462.0,
      "text": "不会因为经济崩塌和恒大地人让共产党完蛋"
    },
    {
      "end": 6469.0,
      "start": 6466.0,
      "text": "最终的结束共产党一定是你会体现的"
    },
    {
      "end": 6472.0,
      "start": 6469.0,
      "text": "共产党的内斗升级了"
    },
    {
      "end": 6474.0,
      "start": 6472.0,
      "text": "加上经济崩塌"
    },
    {
      "end": 6476.0,
      "start": 6474.0,
      "text": "加上打台湾他一定会完"
    },
    {
      "end": 6480.0,
      "start": 6476.0,
      "text": "这些事情都是在烧的漫活"
    },
    {
      "end": 6482.0,
      "start": 6480.0,
      "text": "共产党能不能平调恒大事件"
    },
    {
      "end": 6484.0,
      "start": 6482.0,
      "text": "短暂时期我跟你说过"
    },
    {
      "end": 6486.0,
      "start": 6484.0,
      "text": "二十大以前不能让恒大出事"
    },
    {
      "end": 6490.0,
      "start": 6486.0,
      "text": "他不能让恒大出事的本身这个想法"
    },
    {
      "end": 6492.0,
      "start": 6490.0,
      "text": "他就是比天还大的事"
    },
    {
      "end": 6494.0,
      "start": 6492.0,
      "text": "比恒大出事对咱还好"
    },
    {
      "end": 6500.0,
      "start": 6494.0,
      "text": "而且恒大是代表着房地产"
    },
    {
      "end": 6502.0,
      "start": 6500.0,
      "text": "现在是郭树青"
    },
    {
      "end": 6504.0,
      "start": 6502.0,
      "text": "还有周亮来处理好极了"
    },
    {
      "end": 6508.0,
      "start": 6504.0,
      "text": "兄弟姐妹们我跟你们说实在的"
    },
    {
      "end": 6510.0,
      "start": 6508.0,
      "text": "说到这的时候就我真的觉得"
    },
    {
      "end": 6513.0,
      "start": 6510.0,
      "text": "老天爷站在了中国人民这边"
    },
    {
      "end": 6515.0,
      "start": 6513.0,
      "text": "站在爆料肯定这边"
    },
    {
      "end": 6518.0,
      "start": 6515.0,
      "text": "就像疫苗一样"
    },
    {
      "end": 6520.0,
      "start": 6518.0,
      "text": "到现在你看看"
    },
    {
      "end": 6521.0,
      "start": 6520.0,
      "text": "现在美国是辉瑞之药"
    },
    {
      "end": 6522.0,
      "start": 6521.0,
      "text": "这之药强生之药"
    },
    {
      "end": 6524.0,
      "start": 6522.0,
      "text": "什么药说出来我解药了"
    },
    {
      "end": 6526.0,
      "start": 6524.0,
      "text": "我今天负责任告诉你"
    },
    {
      "end": 6528.0,
      "start": 6526.0,
      "text": "所有的解药离不可两样东西"
    },
    {
      "end": 6530.0,
      "start": 6528.0,
      "text": "青蒿素一微菌素的分子"
    },
    {
      "end": 6532.0,
      "start": 6530.0,
      "text": "我今天记住在直播中说的话"
    },
    {
      "end": 6534.0,
      "start": 6532.0,
      "text": "谁要敢给我打赌"
    },
    {
      "end": 6535.0,
      "start": 6534.0,
      "text": "他不给我打赌"
    },
    {
      "end": 6537.0,
      "start": 6535.0,
      "text": "他我耳朵拔不着主动"
    },
    {
      "end": 6538.0,
      "start": 6537.0,
      "text": "我告诉你"
    },
    {
      "end": 6541.0,
      "start": 6538.0,
      "text": "图幽幽是改变人类的唯一的最女英雄"
    },
    {
      "end": 6543.0,
      "start": 6541.0,
      "text": "她在人类的历史作用"
    },
    {
      "end": 6546.0,
      "start": 6543.0,
      "text": "绝对会大国女娲这个级别的"
    },
    {
      "end": 6549.0,
      "start": 6548.0,
      "text": "怎么看"
    },
    {
      "end": 6552.0,
      "start": 6550.0,
      "text": "他这个人的贡献"
    },
    {
      "end": 6555.0,
      "start": 6552.0,
      "text": "我注意一下青蒿素是绝对的药"
    },
    {
      "end": 6557.0,
      "start": 6555.0,
      "text": "但是战友们千万别拿什么青蒿剂"
    },
    {
      "end": 6558.0,
      "start": 6557.0,
      "text": "你来兑药"
    },
    {
      "end": 6559.0,
      "start": 6558.0,
      "text": "你这找死呢"
    },
    {
      "end": 6560.0,
      "start": 6559.0,
      "text": "你会死人的"
    },
    {
      "end": 6562.0,
      "start": 6560.0,
      "text": "我可以负责任告诉你"
    },
    {
      "end": 6564.0,
      "start": 6562.0,
      "text": "这个任何青蒿素的"
    },
    {
      "end": 6569.0,
      "start": 6564.0,
      "text": "未加科学提炼后和科学的混合剂"
    },
    {
      "end": 6570.0,
      "start": 6569.0,
      "text": "都是毒药"
    },
    {
      "end": 6572.0,
      "start": 6571.0,
      "text": "而且我告诉你"
    },
    {
      "end": 6573.0,
      "start": 6572.0,
      "text": "只有七哥知道"
    },
    {
      "end": 6575.0,
      "start": 6573.0,
      "text": "告诉你全世界最好的青蒿素在哪里"
    },
    {
      "end": 6577.0,
      "start": 6575.0,
      "text": "就在肯塔基州在美国"
    },
    {
      "end": 6582.0,
      "start": 6577.0,
      "text": "它的种植到采取到提成到合成"
    },
    {
      "end": 6584.0,
      "start": 6582.0,
      "text": "是有几乎是脆弱到"
    },
    {
      "end": 6585.0,
      "start": 6584.0,
      "text": "就是玩科学"
    },
    {
      "end": 6587.0,
      "start": 6585.0,
      "text": "当时咱们这个科学家告诉我"
    },
    {
      "end": 6588.0,
      "start": 6587.0,
      "text": "说七哥我告诉你什么关系吧"
    },
    {
      "end": 6592.0,
      "start": 6588.0,
      "text": "是在太空中穿针引线的作用"
    },
    {
      "end": 6594.0,
      "start": 6593.0,
      "text": "如果你把这个"
    },
    {
      "end": 6596.0,
      "start": 6594.0,
      "text": "在太空中把针和线引过来了"
    },
    {
      "end": 6597.0,
      "start": 6596.0,
      "text": "你是技术到家了"
    },
    {
      "end": 6600.0,
      "start": 6597.0,
      "text": "他说这就是图油油厉害的地方"
    },
    {
      "end": 6602.0,
      "start": 6600.0,
      "text": "他把提炼接触到"
    },
    {
      "end": 6606.0,
      "start": 6602.0,
      "text": "所以战友们有人竟然自己去搞青蒿素剂给战友送"
    },
    {
      "end": 6608.0,
      "start": 6606.0,
      "text": "那你是害得太无知了"
    },
    {
      "end": 6610.0,
      "start": 6609.0,
      "text": "太无知了"
    },
    {
      "end": 6613.0,
      "start": 6610.0,
      "text": "就是所有的核心是提取合成"
    },
    {
      "end": 6615.0,
      "start": 6613.0,
      "text": "青蒿素是人拯救人类的解"
    },
    {
      "end": 6618.0,
      "start": 6615.0,
      "text": "不但青蒿素我告诉你"
    },
    {
      "end": 6620.0,
      "start": 6618.0,
      "text": "现在确定的做什么"
    },
    {
      "end": 6622.0,
      "start": 6620.0,
      "text": "第一个解冠病毒疫苗"
    },
    {
      "end": 6624.0,
      "start": 6622.0,
      "text": "绝对给你打了疫苗的人"
    },
    {
      "end": 6626.0,
      "start": 6624.0,
      "text": "特别是两针以前包含两针"
    },
    {
      "end": 6629.0,
      "start": 6627.0,
      "text": "90%以上给你清理掉"
    },
    {
      "end": 6632.0,
      "start": 6630.0,
      "text": "如果是染上了"
    },
    {
      "end": 6634.0,
      "start": 6632.0,
      "text": "几乎是他是百分之百最好有药"
    },
    {
      "end": 6636.0,
      "start": 6634.0,
      "text": "第二才是什么"
    },
    {
      "end": 6639.0,
      "start": 6636.0,
      "text": "缓解这个血压的是第三米松大悲性质"
    },
    {
      "end": 6641.0,
      "start": 6639.0,
      "text": "然后解决了一位菌树"
    },
    {
      "end": 6643.0,
      "start": 6641.0,
      "text": "但是最终最厉害的青蒿素"
    },
    {
      "end": 6646.0,
      "start": 6643.0,
      "text": "大家要记住"
    },
    {
      "end": 6648.0,
      "start": 6646.0,
      "text": "那么另外一个青蒿素是什么"
    },
    {
      "end": 6649.0,
      "start": 6648.0,
      "text": "治癌症"
    },
    {
      "end": 6650.0,
      "start": 6649.0,
      "text": "可能未来的癌症艾滋病"
    },
    {
      "end": 6654.0,
      "start": 6650.0,
      "text": "可能青蒿素就是几针或者几剂就吃完就没有"
    },
    {
      "end": 6660.0,
      "start": 6655.0,
      "text": "甚至能彻底解决脑血管心血管的整个的这个问题"
    },
    {
      "end": 6662.0,
      "start": 6660.0,
      "text": "所以这青蒿素的秘密"
    },
    {
      "end": 6664.0,
      "start": 6662.0,
      "text": "咱这科学家最近跟我沟通把我震惊了"
    },
    {
      "end": 6666.0,
      "start": 6664.0,
      "text": "不是那个石药严"
    },
    {
      "end": 6668.0,
      "start": 6666.0,
      "text": "石药严已经找他爷爷睡觉去了"
    },
    {
      "end": 6669.0,
      "start": 6668.0,
      "text": "细歌又浴测嘴了"
    },
    {
      "end": 6671.0,
      "start": 6669.0,
      "text": "他一定睡觉获得绿卡"
    },
    {
      "end": 6672.0,
      "start": 6671.0,
      "text": "最后把人搞死"
    },
    {
      "end": 6675.0,
      "start": 6672.0,
      "text": "最后搞得丑的那个样"
    },
    {
      "end": 6677.0,
      "start": 6675.0,
      "text": "咱们真正的欧洲科学家"
    },
    {
      "end": 6678.0,
      "start": 6677.0,
      "text": "他说我告诉你几个"
    },
    {
      "end": 6680.0,
      "start": 6678.0,
      "text": "你一定要记住"
    },
    {
      "end": 6683.0,
      "start": 6680.0,
      "text": "中国人可能在这个人类历史上"
    },
    {
      "end": 6686.0,
      "start": 6683.0,
      "text": "除了所谓的四大发明最大功能的情况"
    },
    {
      "end": 6687.0,
      "start": 6686.0,
      "text": "他说第三个是什么"
    },
    {
      "end": 6688.0,
      "start": 6687.0,
      "text": "女性疾病"
    },
    {
      "end": 6690.0,
      "start": 6688.0,
      "text": "几乎是对女性疾病"
    },
    {
      "end": 6692.0,
      "start": 6690.0,
      "text": "特别是更年期"
    },
    {
      "end": 6696.0,
      "start": 6692.0,
      "text": "和女性所有的中老年疾病都是有效的"
    },
    {
      "end": 6697.0,
      "start": 6696.0,
      "text": "为什么"
    },
    {
      "end": 6699.0,
      "start": 6697.0,
      "text": "他是唯一能把身体里边"
    },
    {
      "end": 6703.0,
      "start": 6699.0,
      "text": "就血液里叮的毒和变异给你清除掉"
    },
    {
      "end": 6704.0,
      "start": 6703.0,
      "text": "对待男性"
    },
    {
      "end": 6705.0,
      "start": 6704.0,
      "text": "阳尾绝对管用"
    },
    {
      "end": 6706.0,
      "start": 6705.0,
      "text": "治阳尾"
    },
    {
      "end": 6707.0,
      "start": 6706.0,
      "text": "当然了"
    },
    {
      "end": 6711.0,
      "start": 6707.0,
      "text": "清藤和这个大卫星的不用也不用吃太早了"
    },
    {
      "end": 6712.0,
      "start": 6711.0,
      "text": "治阳尾管用"
    },
    {
      "end": 6715.0,
      "start": 6712.0,
      "text": "而且对男性的脑部心脏病科特别好"
    },
    {
      "end": 6717.0,
      "start": 6715.0,
      "text": "最后一个是治的什么病"
    },
    {
      "end": 6725.0,
      "start": 6717.0,
      "text": "他说现在所有人类上都吃这种有机食物和所谓的这个无染食物造成金属"
    },
    {
      "end": 6726.0,
      "start": 6725.0,
      "text": "重金属"
    },
    {
      "end": 6728.0,
      "start": 6726.0,
      "text": "清好是清理身上的重金属最好"
    },
    {
      "end": 6731.0,
      "start": 6728.0,
      "text": "哇塞真的很重要"
    },
    {
      "end": 6734.0,
      "start": 6731.0,
      "text": "那么这种这个疫苗这个事情到今天"
    },
    {
      "end": 6736.0,
      "start": 6734.0,
      "text": "兄弟姐妹以疫苗灭供"
    },
    {
      "end": 6740.0,
      "start": 6736.0,
      "text": "咱到国际上做到77个国家"
    },
    {
      "end": 6742.0,
      "start": 6740.0,
      "text": "收到我们所有的发的信息"
    },
    {
      "end": 6743.0,
      "start": 6742.0,
      "text": "受到我们的影响"
    },
    {
      "end": 6745.0,
      "start": 6743.0,
      "text": "你看看法国电视台罵我们"
    },
    {
      "end": 6746.0,
      "start": 6745.0,
      "text": "他越骂越好"
    },
    {
      "end": 6748.0,
      "start": 6746.0,
      "text": "他最好99都骂我们"
    },
    {
      "end": 6752.0,
      "start": 6748.0,
      "text": "但他告诉人家说有人怀疑疫苗灾难记下来这一句话就够了"
    },
    {
      "end": 6755.0,
      "start": 6753.0,
      "text": "咱们战友们有时候很脆弱的心"
    },
    {
      "end": 6759.0,
      "start": 6755.0,
      "text": "看到人家那个石耀岩的时候有人摸屁股你也妒忌"
    },
    {
      "end": 6762.0,
      "start": 6759.0,
      "text": "你以为石耀岩离开我们明天就死了"
    },
    {
      "end": 6763.0,
      "start": 6762.0,
      "text": "你是高兴啊"
    },
    {
      "end": 6764.0,
      "start": 6763.0,
      "text": "你那叫变态"
    },
    {
      "end": 6766.0,
      "start": 6764.0,
      "text": "谁都有活着的权利"
    },
    {
      "end": 6769.0,
      "start": 6767.0,
      "text": "你以为王岐山嘎杯一下就死了"
    },
    {
      "end": 6770.0,
      "start": 6769.0,
      "text": "按照战友的希望"
    },
    {
      "end": 6772.0,
      "start": 6770.0,
      "text": "四年前王岐山枪毙"
    },
    {
      "end": 6773.0,
      "start": 6772.0,
      "text": "孟建柱枪毙"
    },
    {
      "end": 6774.0,
      "start": 6773.0,
      "text": "傅振华枪毙"
    },
    {
      "end": 6775.0,
      "start": 6774.0,
      "text": "孙立军枪毙"
    },
    {
      "end": 6776.0,
      "start": 6775.0,
      "text": "你才高兴呢"
    },
    {
      "end": 6778.0,
      "start": 6776.0,
      "text": "你能高兴一晚上吗"
    },
    {
      "end": 6783.0,
      "start": 6779.0,
      "text": "这后面的都是一个世界的力量在较量"
    },
    {
      "end": 6785.0,
      "start": 6783.0,
      "text": "较量了八年才把对方撂倒"
    },
    {
      "end": 6787.0,
      "start": 6785.0,
      "text": "小厨才撂倒"
    },
    {
      "end": 6789.0,
      "start": 6787.0,
      "text": "要按你战友们这种想象"
    },
    {
      "end": 6792.0,
      "start": 6789.0,
      "text": "咱统治宇宙已经是统治一亿回了"
    },
    {
      "end": 6794.0,
      "start": 6792.0,
      "text": "石耀岩路大脑袋离开咱以后"
    },
    {
      "end": 6798.0,
      "start": 6794.0,
      "text": "第二天就发现路大脑袋在垃圾堆里面捡饭吃的"
    },
    {
      "end": 6801.0,
      "start": 6798.0,
      "text": "第三天就发现老婆被人家抢走了"
    },
    {
      "end": 6803.0,
      "start": 6801.0,
      "text": "第四天路大脑袋变成绿脑袋了"
    },
    {
      "end": 6804.0,
      "start": 6803.0,
      "text": "然后石耀岩"
    },
    {
      "end": 6807.0,
      "start": 6804.0,
      "text": "身烂于腹街之中"
    },
    {
      "end": 6809.0,
      "start": 6807.0,
      "text": "就你们这才过瘾啊"
    },
    {
      "end": 6811.0,
      "start": 6809.0,
      "text": "你这比共产党还邪恶"
    },
    {
      "end": 6814.0,
      "start": 6811.0,
      "text": "就有些战友这种心里很很有问题"
    },
    {
      "end": 6817.0,
      "start": 6814.0,
      "text": "包括战友们现在一说解药"
    },
    {
      "end": 6818.0,
      "start": 6817.0,
      "text": "骑个害家清浩度"
    },
    {
      "end": 6820.0,
      "start": 6818.0,
      "text": "自己做清浩剂送给战友去了"
    },
    {
      "end": 6822.0,
      "start": 6820.0,
      "text": "你立马成了上帝了"
    },
    {
      "end": 6824.0,
      "start": 6822.0,
      "text": "每个人都想当上帝"
    },
    {
      "end": 6826.0,
      "start": 6824.0,
      "text": "那谁当老百姓啊"
    },
    {
      "end": 6829.0,
      "start": 6826.0,
      "text": "咱五点十好不好"
    },
    {
      "end": 6832.0,
      "start": 6829.0,
      "text": "这是让人心里很不舒服很难受的事"
    },
    {
      "end": 6833.0,
      "start": 6832.0,
      "text": "挣钱"
    },
    {
      "end": 6835.0,
      "start": 6833.0,
      "text": "洗碧一上市就是一万块钱一个"
    },
    {
      "end": 6837.0,
      "start": 6835.0,
      "text": "洗碧要一万块钱一个上市"
    },
    {
      "end": 6839.0,
      "start": 6837.0,
      "text": "我立马从这楼上跳下去"
    },
    {
      "end": 6841.0,
      "start": 6839.0,
      "text": "我就不能活了"
    },
    {
      "end": 6844.0,
      "start": 6841.0,
      "text": "我认为我将创造了一个魔鬼在世界上"
    },
    {
      "end": 6849.0,
      "start": 6844.0,
      "text": "你洗碧一万美金上涨十万倍"
    },
    {
      "end": 6852.0,
      "start": 6849.0,
      "text": "人类的钱不都到你家去了吗"
    },
    {
      "end": 6855.0,
      "start": 6852.0,
      "text": "他涨一千美金一个我都该跳楼"
    },
    {
      "end": 6857.0,
      "start": 6855.0,
      "text": "因为我是这个世界上的祸害"
    },
    {
      "end": 6860.0,
      "start": 6857.0,
      "text": "你说几年涨"
    },
    {
      "end": 6863.0,
      "start": 6860.0,
      "text": "我觉得没啥了不起的"
    },
    {
      "end": 6866.0,
      "start": 6863.0,
      "text": "我昨天下午跟那个习南主任开会"
    },
    {
      "end": 6868.0,
      "start": 6866.0,
      "text": "我已经一个都愿意跟他开会了"
    },
    {
      "end": 6870.0,
      "start": 6868.0,
      "text": "我说很简单嘛"
    },
    {
      "end": 6872.0,
      "start": 6870.0,
      "text": "全世界的虚拟货币你去看去"
    },
    {
      "end": 6875.0,
      "start": 6872.0,
      "text": "上市两个月都是嗷嗷着涨"
    },
    {
      "end": 6878.0,
      "start": 6875.0,
      "text": "两个月以后半年平级"
    },
    {
      "end": 6881.0,
      "start": 6878.0,
      "text": "再过半年又吵起来了又弄下去了"
    },
    {
      "end": 6885.0,
      "start": 6881.0,
      "text": "所有的玩虚拟货币的"
    },
    {
      "end": 6887.0,
      "start": 6885.0,
      "text": "包括比特币"
    },
    {
      "end": 6890.0,
      "start": 6887.0,
      "text": "在一年内几乎99被洗出去"
    },
    {
      "end": 6892.0,
      "start": 6890.0,
      "text": "你看每一个别听七哥"
    },
    {
      "end": 6894.0,
      "start": 6892.0,
      "text": "你去查些什么火币啊什么币案的"
    },
    {
      "end": 6895.0,
      "start": 6894.0,
      "text": "你去查去吧"
    },
    {
      "end": 6896.0,
      "start": 6895.0,
      "text": "为啥"
    },
    {
      "end": 6898.0,
      "start": 6896.0,
      "text": "有一点利润他不卖他觉得自己是吃亏"
    },
    {
      "end": 6900.0,
      "start": 6898.0,
      "text": "我得跑都卖了"
    },
    {
      "end": 6903.0,
      "start": 6900.0,
      "text": "然后又有机会又来了又卖了"
    },
    {
      "end": 6904.0,
      "start": 6903.0,
      "text": "又来了又卖了"
    },
    {
      "end": 6906.0,
      "start": 6904.0,
      "text": "最后整了就发收拾啥也没有了"
    },
    {
      "end": 6909.0,
      "start": 6906.0,
      "text": "做生意的人"
    },
    {
      "end": 6910.0,
      "start": 6909.0,
      "text": "开小卖店开餐厅的"
    },
    {
      "end": 6912.0,
      "start": 6910.0,
      "text": "为什么开小卖店开餐厅的人"
    },
    {
      "end": 6916.0,
      "start": 6912.0,
      "text": "几乎是十万分之一的成功力"
    },
    {
      "end": 6921.0,
      "start": 6916.0,
      "text": "因为那十万分的绝大多数都是自己待不住"
    },
    {
      "end": 6925.0,
      "start": 6921.0,
      "text": "你现在有人想到我几个洗屁买个弯流了"
    },
    {
      "end": 6928.0,
      "start": 6925.0,
      "text": "全世界一共在一千多台弯流"
    },
    {
      "end": 6931.0,
      "start": 6928.0,
      "text": "咱战手估计都干了百分之三百了"
    },
    {
      "end": 6933.0,
      "start": 6931.0,
      "text": "把未来一百年的弯流你都给买了"
    },
    {
      "end": 6935.0,
      "start": 6933.0,
      "text": "你这想的可能吗"
    },
    {
      "end": 6936.0,
      "start": 6935.0,
      "text": "所以从傅政华"
    },
    {
      "end": 6937.0,
      "start": 6936.0,
      "text": "孙利丘这所有的案子"
    },
    {
      "end": 6938.0,
      "start": 6937.0,
      "text": "孟建柱"
    },
    {
      "end": 6939.0,
      "start": 6938.0,
      "text": "王岐山"
    },
    {
      "end": 6942.0,
      "start": 6939.0,
      "text": "千万不要急功近利"
    },
    {
      "end": 6945.0,
      "start": 6943.0,
      "text": "可以有梦想"
    },
    {
      "end": 6946.0,
      "start": 6945.0,
      "text": "不要有幻想"
    },
    {
      "end": 6949.0,
      "start": 6947.0,
      "text": "没有一件事情"
    },
    {
      "end": 6951.0,
      "start": 6949.0,
      "text": "它超乎自然逻辑的"
    },
    {
      "end": 6954.0,
      "start": 6951.0,
      "text": "超乎自然逻辑的一定是灾难"
    },
    {
      "end": 6957.0,
      "start": 6954.0,
      "text": "你不能说现在艾米拉没结婚"
    },
    {
      "end": 6959.0,
      "start": 6957.0,
      "text": "说现在我没怀孕十个月"
    },
    {
      "end": 6960.0,
      "start": 6959.0,
      "text": "我也没有男朋友"
    },
    {
      "end": 6961.0,
      "start": 6960.0,
      "text": "我想要孩子"
    },
    {
      "end": 6963.0,
      "start": 6961.0,
      "text": "今天晚上我的儿子就出现了"
    },
    {
      "end": 6964.0,
      "start": 6963.0,
      "text": "站在对面十八是我儿子"
    },
    {
      "end": 6965.0,
      "start": 6964.0,
      "text": "那一定不是你儿子"
    },
    {
      "end": 6966.0,
      "start": 6965.0,
      "text": "那是骗你的"
    },
    {
      "end": 6969.0,
      "start": 6966.0,
      "text": "他需要有男朋友"
    },
    {
      "end": 6971.0,
      "start": 6969.0,
      "text": "他需要有怀孕"
    },
    {
      "end": 6973.0,
      "start": 6971.0,
      "text": "他需要有十月怀胎"
    },
    {
      "end": 6974.0,
      "start": 6973.0,
      "text": "需要生下来"
    },
    {
      "end": 6975.0,
      "start": 6974.0,
      "text": "需要时间长大"
    },
    {
      "end": 6978.0,
      "start": 6975.0,
      "text": "怎么一夜冒出一样冒出一样儿子出来"
    },
    {
      "end": 6979.0,
      "start": 6978.0,
      "text": "说我是做大脑片"
    },
    {
      "end": 6980.0,
      "start": 6979.0,
      "text": "我是艾米拉的儿子"
    },
    {
      "end": 6982.0,
      "start": 6980.0,
      "text": "艾米拉说去你大爷了"
    },
    {
      "end": 6983.0,
      "start": 6982.0,
      "text": "我才没这儿子"
    },
    {
      "end": 6985.0,
      "start": 6983.0,
      "text": "哪有这么个大儿子"
    },
    {
      "end": 6986.0,
      "start": 6985.0,
      "text": "还没毛头上"
    },
    {
      "end": 6988.0,
      "start": 6986.0,
      "text": "那一定是这结局"
    },
    {
      "end": 6989.0,
      "start": 6988.0,
      "text": "那一定是个怪胎"
    },
    {
      "end": 6992.0,
      "start": 6989.0,
      "text": "那么对待爆料革命一样的道理"
    },
    {
      "end": 6993.0,
      "start": 6992.0,
      "text": "大卫兄弟"
    },
    {
      "end": 6994.0,
      "start": 6993.0,
      "text": "这个一定你们要多讲讲"
    },
    {
      "end": 6995.0,
      "start": 6994.0,
      "text": "这个"
    },
    {
      "end": 6996.0,
      "start": 6995.0,
      "text": "这要非非"
    },
    {
      "end": 6999.0,
      "start": 6996.0,
      "text": "爆料革命就是太不切实际的想法"
    },
    {
      "end": 7001.0,
      "start": 6999.0,
      "text": "有战友在我发信息"
    },
    {
      "end": 7002.0,
      "start": 7001.0,
      "text": "我都真的不能给他回了"
    },
    {
      "end": 7005.0,
      "start": 7002.0,
      "text": "我们小郑州我发信息"
    },
    {
      "end": 7007.0,
      "start": 7005.0,
      "text": "七哥这个喜币上市以后"
    },
    {
      "end": 7008.0,
      "start": 7007.0,
      "text": "我先卖多少呢"
    },
    {
      "end": 7009.0,
      "start": 7008.0,
      "text": "是吧"
    },
    {
      "end": 7010.0,
      "start": 7009.0,
      "text": "多少价卖呢"
    },
    {
      "end": 7012.0,
      "start": 7010.0,
      "text": "然后我多少钱去还房贷呢"
    },
    {
      "end": 7013.0,
      "start": 7012.0,
      "text": "多少钱去买车"
    },
    {
      "end": 7018.0,
      "start": 7013.0,
      "text": "我这已经不是喜币的所谓的创意人了"
    },
    {
      "end": 7020.0,
      "start": 7018.0,
      "text": "我是你的财富官"
    },
    {
      "end": 7021.0,
      "start": 7020.0,
      "text": "财富经理"
    },
    {
