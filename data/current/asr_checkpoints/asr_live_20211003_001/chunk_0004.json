{
  "chunk_audio_sha256": "a5a89ba205b09a212c3c6fa9da45d0511f73cd9b28d743b46b89101bd83f4259",
  "chunk_index": 4,
  "completed_at": "2026-10-20T14:07:08Z",
  "language": "zh",
  "live_id": "LIVE_20211003_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 3600,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 3604.6,
      "start": 3600.0,
      "text": "你溫家寶還有這個胡竟然沒敢說"
    },
    {
      "end": 3606.4,
      "start": 3604.6,
      "text": "倆人都憋回去了"
    },
    {
      "end": 3609.9,
      "start": 3606.4,
      "text": "繼續執行顛倒政策海外期國內三"
    },
    {
      "end": 3613.0,
      "start": 3609.9,
      "text": "那國外的期主要是誰來弄呢"
    },
    {
      "end": 3616.9,
      "start": 3613.0,
      "text": "主要是情報部和外交部的配合"
    },
    {
      "end": 3622.8,
      "start": 3616.9,
      "text": "政法委和安全部公安部派到外交部的那些官員"
    },
    {
      "end": 3626.0,
      "start": 3622.8,
      "text": "不是聽你外交部的 是聽政法委的 聽安全部的"
    },
    {
      "end": 3629.2,
      "start": 3626.0,
      "text": "二部派局的五官不聽你什麼大使"
    },
    {
      "end": 3632.9,
      "start": 3629.2,
      "text": "你殺個屁呀 人家是聽人家二部的聽總參謀長的"
    },
    {
      "end": 3636.2,
      "start": 3632.9,
      "text": "所以說這些事情這個錢都在海外"
    },
    {
      "end": 3640.6,
      "start": 3636.2,
      "text": "很多海外你像欺民賊最近捐款的本事都厲害了"
    },
    {
      "end": 3644.2,
      "start": 3640.6,
      "text": "就要捐比特幣了 是吧 要求捐比特幣虛擬幣了"
    },
    {
      "end": 3648.2,
      "start": 3644.2,
      "text": "但是他對共產黨的東西了解是一天比一天傻"
    },
    {
      "end": 3652.6,
      "start": 3648.2,
      "text": "就沒有任何人談過共產黨在海外的錢通過誰來管理"
    },
    {
      "end": 3657.5,
      "start": 3652.6,
      "text": "後來王岐山上來 你看王岐山上來有個小子鬼的狠"
    },
    {
      "end": 3661.2,
      "start": 3657.5,
      "text": "王岐山一定是三會"
    },
    {
      "end": 3665.8,
      "start": 3661.2,
      "text": "三會就是銀監會 證監會 是吧"
    },
    {
      "end": 3669.5,
      "start": 3665.8,
      "text": "大家都看保監會 全是他的人 然後中央銀行"
    },
    {
      "end": 3675.2,
      "start": 3669.5,
      "text": "這個你在海外的錢沒有這些銀行這些監事會跟你配合"
    },
    {
      "end": 3678.9,
      "start": 3675.2,
      "text": "這叫做賣相不成 你像咱們這個GTV"
    },
    {
      "end": 3682.6,
      "start": 3678.9,
      "text": "他發了一百多個紅色的所謂的洗錢喊"
    },
    {
      "end": 3687.2,
      "start": 3682.6,
      "text": "給台灣到處發 說這都是GTV是洗錢的"
    },
    {
      "end": 3691.2,
      "start": 3687.2,
      "text": "還有發這些國家有的人就認了 連代表國家政府的"
    },
    {
      "end": 3695.6,
      "start": 3691.2,
      "text": "這就王岐山的厲害 王岐山僅僅的控制了金融情報"
    },
    {
      "end": 3702.2,
      "start": 3695.6,
      "text": "和海外的金融權力 孟建柱控制住了絕對的海外的藏的錢和密碼"
    },
    {
      "end": 3707.9,
      "start": 3702.2,
      "text": "錢裡把馬見副部長做掉 把所有執行者全抓起來 然後把錢拿回來"
    },
    {
      "end": 3711.9,
      "start": 3707.9,
      "text": "大家一定要看出這個遊戲啊 如果沒有這倆人的配合"
    },
    {
      "end": 3719.4,
      "start": 3711.9,
      "text": "你想把錢拿走是不可能的 就沒有中國的外交政法委和中國人民銀行"
    },
    {
      "end": 3723.0,
      "start": 3719.4,
      "text": "人民銀行是對外的嘛 是不是 外匯局 反販局"
    },
    {
      "end": 3728.3,
      "start": 3723.0,
      "text": "然後中國銀行就具體操作口啊 然後保監會 銀監會 還有股票啊"
    },
    {
      "end": 3732.7,
      "start": 3728.3,
      "text": "你像陳國軍在這房子 是不是 我去看過他的家"
    },
    {
      "end": 3740.5,
      "start": 3732.7,
      "text": "說這個157號 57街 88樓 86樓 87樓都是王岐山的"
    },
    {
      "end": 3744.2,
      "start": 3740.5,
      "text": "買說5700 賣了3700 是吧"
    },
    {
      "end": 3747.5,
      "start": 3744.2,
      "text": "那賣房子誰說了算呢 陳國軍得簽字"
    },
    {
      "end": 3749.2,
      "start": 3747.5,
      "text": "怎麼逼這簽字呢 把他家人抓了"
    },
    {
      "end": 3751.7,
      "start": 3749.2,
      "text": "抓了簽字 美國政府要干涉怎麼辦呢"
    },
    {
      "end": 3754.4,
      "start": 3751.7,
      "text": "中國政府發函 他犯罪了"
    },
    {
      "end": 3756.7,
      "start": 3754.4,
      "text": "誰這麼用犯罪了 政法委"
    },
    {
      "end": 3758.9,
      "start": 3756.7,
      "text": "這都是一整道活 讓外交部協調"
    },
    {
      "end": 3763.2,
      "start": 3758.9,
      "text": "所以你看看江家 楊潔篪 王滬寧"
    },
    {
      "end": 3765.2,
      "start": 3763.2,
      "text": "100%控制的外交部"
    },
    {
      "end": 3769.2,
      "start": 3765.2,
      "text": "孟建柱100%控制政法委 安全部 公安部"
    },
    {
      "end": 3773.4,
      "start": 3769.2,
      "text": "王岐山100%控制的中國人民銀行 幾大銀行"
    },
    {
      "end": 3776.4,
      "start": 3773.4,
      "text": "你習近平在他面前真的來個屁都不是"
    },
    {
      "end": 3778.2,
      "start": 3776.4,
      "text": "我一會再告訴你"
    },
    {
      "end": 3781.2,
      "start": 3778.2,
      "text": "這就大衛兄弟說的太好了"
    },
    {
      "end": 3782.7,
      "start": 3781.2,
      "text": "錢的問題"
    },
    {
      "end": 3789.4,
      "start": 3782.7,
      "text": "當時就這個陳國平和尼堅在中東接受監管"
    },
    {
      "end": 3793.4,
      "start": 3789.4,
      "text": "我今天大家一定以為習近平啥都知道"
    },
    {
      "end": 3797.4,
      "start": 3793.4,
      "text": "我跟你說實話 在某些方面他連飛飛的智商都不如"
    },
    {
      "end": 3801.2,
      "start": 3798.4,
      "text": "因為你國家大了 你不可能"
    },
    {
      "end": 3807.4,
      "start": 3801.2,
      "text": "就像一個農民知道家裡放著啥呢 現在飛飛老公老賢傻是不是"
    },
    {
      "end": 3812.4,
      "start": 3807.4,
      "text": "但是你飛飛回到家裡 你說你家現在哪雙鞋在那呢 他這不找不出來"
    },
    {
      "end": 3816.5,
      "start": 3813.4,
      "text": "雖然沒有多大的沒有幾萬尺的豪宅 是吧 飛飛找不出來"
    },
    {
      "end": 3822.7,
      "start": 3816.5,
      "text": "為什麼 畢竟比一般人家大嘛 是不是啊 你畢竟比要飯的房子大嘛"
    },
    {
      "end": 3826.7,
      "start": 3822.7,
      "text": "一個國家那麼大 你以為習近平都知道嗎 他不可能"
    },
    {
      "end": 3832.5,
      "start": 3826.7,
      "text": "一天挪好幾個地方睡覺 是不是啊 天天看假報告 是不是啊 瞪著點聽瞎話"
    },
    {
      "end": 3836.9,
      "start": 3832.5,
      "text": "然後他也是人呢 一天就這麼小時啊 他就沒有時間知道"
    },
    {
      "end": 3839.1,
      "start": 3836.9,
      "text": "你真以為他知道 他不可能"
    },
    {
      "end": 3844.5,
      "start": 3839.1,
      "text": "話又說了 剛才老弟說到了 傅振華是百分之百習的人"
    },
    {
      "end": 3851.1,
      "start": 3846.5,
      "text": "孫立軍是百分之百孟建柱的人"
    },
    {
      "end": 3854.9,
      "start": 3851.1,
      "text": "孟建柱是百分之百江家和僧家的人"
    },
    {
      "end": 3857.7,
      "start": 3854.9,
      "text": "王岐山是百分之百江家的人"
    },
    {
      "end": 3863.1,
      "start": 3857.7,
      "text": "那你告訴我 原來抓了孫立軍 特別是王立科"
    },
    {
      "end": 3864.5,
      "start": 3863.1,
      "text": "王立科是孟建柱的人"
    },
    {
      "end": 3869.7,
      "start": 3865.3,
      "text": "裴文進是孟建柱的人 都抓完了 要廝殺習"
    },
    {
      "end": 3873.5,
      "start": 3870.3,
      "text": "然後現在把傅振華抓了 大家去想想"
    },
    {
      "end": 3876.3,
      "start": 3873.9,
      "text": "傅振華幾乎就像一個狗一樣"
    },
    {
      "end": 3881.1,
      "start": 3877.3,
      "text": "從北京市局一路騙到中央 就是出賣中央康"
    },
    {
      "end": 3884.7,
      "start": 3881.1,
      "text": "他屁都不是 編造了個自己在六四的時候上天安門"
    },
    {
      "end": 3887.3,
      "start": 3884.7,
      "text": "頭盔上被打一個洞 我聽到他講過"
    },
    {
      "end": 3889.3,
      "start": 3887.3,
      "text": "這簡直是胡扯"
    },
    {
      "end": 3893.7,
      "start": 3890.1,
      "text": "而且你看看我昨天放出的他當年給我的錄音"
    },
    {
      "end": 3896.1,
      "start": 3893.7,
      "text": "我一會兒問你一個問題 你們先回答我"
    },
    {
      "end": 3899.9,
      "start": 3896.1,
      "text": "清華那個騙生的錄音後 你們的感覺疑問是什麼"
    },
    {
      "end": 3901.1,
      "start": 3899.9,
      "text": "你們每個人都在回答我"
    },
    {
      "end": 3902.7,
      "start": 3901.1,
      "text": "每個人都在回答我"
    },
    {
      "end": 3904.7,
      "start": 3902.7,
      "text": "說實話 爆料他們為真不破"
    },
    {
      "end": 3906.1,
      "start": 3904.7,
      "text": "只給你十秒鐘"
    },
    {
      "end": 3908.9,
      "start": 3906.1,
      "text": "聽完再次聽完的錄音 你啥感受"
    },
    {
      "end": 3910.7,
      "start": 3908.9,
      "text": "我給你們一個驚喜"
    },
    {
      "end": 3913.3,
      "start": 3910.7,
      "text": "所以說傅振華這個孫子一路騙上去"
    },
    {
      "end": 3914.9,
      "start": 3913.3,
      "text": "騙得了習的信任"
    },
    {
      "end": 3916.9,
      "start": 3914.9,
      "text": "習用他幹掉了"
    },
    {
      "end": 3919.3,
      "start": 3916.9,
      "text": "你別忘了那個時候就孫力軍"
    },
    {
      "end": 3922.1,
      "start": 3919.3,
      "text": "是成天孟建柱要搞死傅振華的"
    },
    {
      "end": 3925.7,
      "start": 3922.1,
      "text": "傅振華是成天要表達要搞死他的"
    },
    {
      "end": 3927.9,
      "start": 3925.7,
      "text": "這是從啥時候開始兄弟們"
    },
    {
      "end": 3930.3,
      "start": 3927.9,
      "text": "2009年就開始的鬥爭"
    },
    {
      "end": 3936.7,
      "start": 3930.3,
      "text": "一直到現在 將近十年才幹掉的"
    },
    {
      "end": 3938.7,
      "start": 3936.7,
      "text": "八九年才幹掉他"
    },
    {
      "end": 3939.7,
      "start": 3938.7,
      "text": "你以為這麼簡單"
    },
    {
      "end": 3942.5,
      "start": 3939.7,
      "text": "他們之間都擁有了最大的權力"
    },
    {
      "end": 3943.5,
      "start": 3942.5,
      "text": "最多的料"
    },
    {
      "end": 3946.3,
      "start": 3943.5,
      "text": "才花了八九年把對方來整死"
    },
    {
      "end": 3947.9,
      "start": 3946.3,
      "text": "整死是二十大之前的"
    },
    {
      "end": 3952.3,
      "start": 3947.9,
      "text": "十八大 十九大 二十大 都二十大了"
    },
    {
      "end": 3954.1,
      "start": 3952.3,
      "text": "最後收益者是誰啊"
    },
    {
      "end": 3955.5,
      "start": 3954.1,
      "text": "兩面看上去"
    },
    {
      "end": 3957.8,
      "start": 3955.5,
      "text": "幹掉傅振華收益者是習"
    },
    {
      "end": 3960.2,
      "start": 3957.8,
      "text": "為什麼呢 傅振華也掌握習很多事情"
    },
    {
      "end": 3961.2,
      "start": 3960.2,
      "text": "不確定是很多"
    },
    {
      "end": 3963.7,
      "start": 3962.2,
      "text": "孫力軍也幹掉了"
    },
    {
      "end": 3964.8,
      "start": 3963.7,
      "text": "對習有用嗎"
    },
    {
      "end": 3966.6,
      "start": 3964.8,
      "text": "孫力軍幹了很多人"
    },
    {
      "end": 3970.3,
      "start": 3967.7,
      "text": "應該是幹掉孫力軍傷害者是江家"
    },
    {
      "end": 3972.2,
      "start": 3970.3,
      "text": "是孟建柱 王岐山 是吧"
    },
    {
      "end": 3974.4,
      "start": 3972.4,
      "text": "大家看看這幾個全被做掉了"
    },
    {
      "end": 3975.2,
      "start": 3974.4,
      "text": "應該說"
    },
    {
      "end": 3978.9,
      "start": 3975.2,
      "text": "知情者殺手兩邊的人全都幹掉了"
    },
    {
      "end": 3979.7,
      "start": 3978.9,
      "text": "二十大清洗"
    },
    {
      "end": 3981.0,
      "start": 3979.7,
      "text": "事實不是怎樣"
    },
    {
      "end": 3984.2,
      "start": 3982.0,
      "text": "今天的直播的重點他就在這兒"
    },
    {
      "end": 3986.6,
      "start": 3984.2,
      "text": "重點之一啊"
    },
    {
      "end": 3987.6,
      "start": 3986.6,
      "text": "艾美麗 你先回答我"
    },
    {
      "end": 3990.6,
      "start": 3987.6,
      "text": "你聽了昨天我們放出去那個"
    },
    {
      "end": 3993.6,
      "start": 3990.6,
      "text": "2015年"
    },
    {
      "end": 3994.6,
      "start": 3993.6,
      "text": "2016年"
    },
    {
      "end": 3995.6,
      "start": 3994.6,
      "text": "2016年的這個"
    },
    {
      "end": 3997.6,
      "start": 3995.6,
      "text": "跟傅振華在變音的錄音"
    },
    {
      "end": 3998.6,
      "start": 3997.6,
      "text": "你怎麼看"
    },
    {
      "end": 3999.6,
      "start": 3998.6,
      "text": "什麼感覺"
    },
    {
      "end": 4000.6,
      "start": 3999.6,
      "text": "你說一下"
    },
    {
      "end": 4006.0,
      "start": 4000.6,
      "text": "我聽起來他很像是他自己也"
    },
    {
      "end": 4009.0,
      "start": 4006.0,
      "text": "有點像自己也被監控了"
    },
    {
      "end": 4012.0,
      "start": 4009.0,
      "text": "然後他好像都不針對文貴"
    },
    {
      "end": 4013.0,
      "start": 4012.0,
      "text": "就是七哥先"
    },
    {
      "end": 4015.0,
      "start": 4013.0,
      "text": "你提出的問題回答"
    },
    {
      "end": 4018.0,
      "start": 4015.0,
      "text": "所以我在想他是不是也自己擔心"
    },
    {
      "end": 4020.0,
      "start": 4018.0,
      "text": "自己有什麼把柄被人抓著"
    },
    {
      "end": 4023.0,
      "start": 4020.0,
      "text": "然後他就是同時在威脅別人的同時"
    },
    {
      "end": 4026.0,
      "start": 4023.0,
      "text": "他自己也自己也是很害怕的"
    },
    {
      "end": 4027.4,
      "start": 4026.0,
      "text": "是"
    },
    {
      "end": 4029.4,
      "start": 4028.4,
      "text": "很台灣問題"
    },
    {
      "end": 4031.4,
      "start": 4029.4,
      "text": "清頭你回答回答"
    },
    {
      "end": 4032.4,
      "start": 4031.4,
      "text": "清頭"
    },
    {
      "end": 4033.4,
      "start": 4032.4,
      "text": "是"
    },
