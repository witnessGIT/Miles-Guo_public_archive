  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 11704.0,
      "start": 11700.0,
      "text": "永远是把对方给弄死,就看不得你好,"
    },
    {
      "end": 11707.36,
      "start": 11704.56,
      "text": "而且我的好一定在建立在你不好的基础上。"
    },
    {
      "end": 11710.4,
      "start": 11707.36,
      "text": "哎呀,你说现在邓小平现在大都在说,"
    },
    {
      "end": 11715.0,
      "start": 11710.4,
      "text": "实际上他说的是对的,说的是对的。"
    },
    {
      "end": 11718.34,
      "start": 11715.5,
      "text": "当年邓小平是最想中国有民主法治的,"
    },
    {
      "end": 11720.76,
      "start": 11718.34,
      "text": "结果一个六四搞了他不敢了,是不是?"
    },
    {
      "end": 11723.16,
      "start": 11721.26,
      "text": "你说你当时你灭共产党呗,"
    },
    {
      "end": 11725.74,
      "start": 11723.4,
      "text": "你反腐败,反邓家,"
    },
    {
      "end": 11728.56,
      "start": 11725.74,
      "text": "最后被赵主将这把人利用,想搞掉邓小平,"
    },
    {
      "end": 11731.32,
      "start": 11728.56,
      "text": "当然他这个本能反应是被你干掉了,"
    },
    {
      "end": 11734.32,
      "start": 11731.32,
      "text": "然后还撒死那么多学生,牺牲的就是那些英雄。"
    },
    {
      "end": 11737.32,
      "start": 11734.82,
      "text": "共产党是要被灭掉,谁喊灭共产党,"
    },
    {
      "end": 11739.32,
      "start": 11737.32,
      "text": "没人喊灭共产党关键的问题。"
    },
    {
      "end": 11742.0,
      "start": 11740.16,
      "text": "这就是今天我们要学,"
    },
    {
      "end": 11744.8,
      "start": 11742.0,
      "text": "当时的六四没有一个人说灭共产党的,"
    },
    {
      "end": 11746.8,
      "start": 11744.8,
      "text": "甚至没有说搞体制的,"
    },
    {
      "end": 11748.9,
      "start": 11746.8,
      "text": "那些学生全能够一官败职的,"
    },
    {
      "end": 11751.72,
      "start": 11748.9,
      "text": "那些谈判活着的王八蛋都想升官啊,"
    },
    {
      "end": 11753.56,
      "start": 11751.72,
      "text": "那些共产党是谈判的,"
    },
    {
      "end": 11756.4,
      "start": 11753.56,
      "text": "死的那些才是真的英雄啊。"
    },
    {
      "end": 11760.4,
      "start": 11756.4,
      "text": "我们永远忽视历史,忽视真相,"
    },
    {
      "end": 11763.16,
      "start": 11760.4,
      "text": "而且我们永远不把人放在一个重要位置上,"
    },
    {
      "end": 11764.9,
      "start": 11763.16,
      "text": "一个不以人为本的社会,"
    },
    {
      "end": 11767.16,
      "start": 11764.9,
      "text": "不可能有民主法治和信仰的自由。"
    },
    {
      "end": 11769.84,
      "start": 11767.16,
      "text": "今天我们再说回到疫苗的时候,"
    },
    {
      "end": 11771.16,
      "start": 11769.84,
      "text": "你能想到啊,"
    },
    {
      "end": 11773.16,
      "start": 11771.16,
      "text": "所有人都想到自己活下去,"
    },
    {
      "end": 11775.16,
      "start": 11773.16,
      "text": "自己得了病然后没事。"
    },
    {
      "end": 11779.16,
      "start": 11775.16,
      "text": "有多少人真心想过让中国人甚至全世界人,"
    },
    {
      "end": 11781.16,
      "start": 11779.16,
      "text": "不要让疫苗给害死。"
    },
    {
      "end": 11783.66,
      "start": 11782.16,
      "text": "多少人醒来,"
    },
    {
      "end": 11784.66,
      "start": 11783.66,
      "text": "丈夫死在床上,"
    },
    {
      "end": 11785.66,
      "start": 11784.66,
      "text": "多少人醒来,"
    },
    {
      "end": 11787.16,
      "start": 11785.66,
      "text": "孩子死在床上,"
    },
    {
      "end": 11788.16,
      "start": 11787.16,
      "text": "多少人醒来,"
    },
    {
      "end": 11789.16,
      "start": 11788.16,
      "text": "老婆死在床上,"
    },
    {
      "end": 11790.16,
      "start": 11789.16,
      "text": "家人死在床上,"
    },
    {
      "end": 11791.16,
      "start": 11790.16,
      "text": "多少人突然间倒地,"
    },
    {
      "end": 11793.16,
      "start": 11791.16,
      "text": "你看有多少人,"
    },
    {
      "end": 11795.16,
      "start": 11793.16,
      "text": "你有多少人内心为别人想。"
    },
    {
      "end": 11797.16,
      "start": 11795.16,
      "text": "我可以毫不惭愧地说,"
    },
    {
      "end": 11798.16,
      "start": 11797.16,
      "text": "兄弟姐妹们,"
    },
    {
      "end": 11801.16,
      "start": 11798.16,
      "text": "我真的觉得我希望没有种族,"
    },
    {
      "end": 11808.16,
      "start": 11801.16,
      "text": "没有辐射的更少的人受到我们的信息正确的拯救。"
    },
    {
      "end": 11813.16,
      "start": 11808.16,
      "text": "所有全世界都是少一点人被疫苗给弄死,"
    },
    {
      "end": 11814.16,
      "start": 11813.16,
      "text": "太惨了。"
    },
    {
      "end": 11815.16,
      "start": 11814.16,
      "text": "我可以告诉大家,"
    },
    {
      "end": 11817.16,
      "start": 11815.16,
      "text": "疫苗的灾难,"
    },
    {
      "end": 11818.16,
      "start": 11817.16,
      "text": "七个2020年说的,"
    },
    {
      "end": 11821.16,
      "start": 11818.16,
      "text": "只有经历过共产党的情报机构,"
    },
    {
      "end": 11824.16,
      "start": 11821.16,
      "text": "军事机构和共产党的潘多拉计划的人,"
    },
    {
      "end": 11826.16,
      "start": 11824.16,
      "text": "才懂得他有多危险。"
    },
    {
      "end": 11828.16,
      "start": 11826.16,
      "text": "他不是你拼出来的,"
    },
    {
      "end": 11830.16,
      "start": 11828.16,
      "text": "是你七哥跟着一个个人,"
    },
    {
      "end": 11833.16,
      "start": 11830.16,
      "text": "就像七哥在过去爆料的时候说的,"
    },
    {
      "end": 11835.16,
      "start": 11833.16,
      "text": "李长春啊,"
    },
    {
      "end": 11836.16,
      "start": 11835.16,
      "text": "是吧,"
    },
    {
      "end": 11837.16,
      "start": 11836.16,
      "text": "张德江啊,"
    },
    {
      "end": 11838.16,
      "start": 11837.16,
      "text": "张高丽啊,"
    },
    {
      "end": 11839.16,
      "start": 11838.16,
      "text": "是吧,"
    },
    {
      "end": 11840.16,
      "start": 11839.16,
      "text": "中国的军方啊,"
    },
    {
      "end": 11841.16,
      "start": 11840.16,
      "text": "像梁光烈啊,"
    },
    {
      "end": 11842.16,
      "start": 11841.16,
      "text": "是吧,"
    },
    {
      "end": 11843.16,
      "start": 11842.16,
      "text": "你像陈炳德啊,"
    },
    {
      "end": 11845.16,
      "start": 11843.16,
      "text": "那都是无数人在嘴里边,"
    },
    {
      "end": 11846.16,
      "start": 11845.16,
      "text": "像呢,"
    },
    {
      "end": 11847.16,
      "start": 11846.16,
      "text": "安全部部长啊,"
    },
    {
      "end": 11849.16,
      "start": 11847.16,
      "text": "像周永康啊,"
    },
    {
      "end": 11851.16,
      "start": 11849.16,
      "text": "说早就共产党安乐心,"
    },
    {
      "end": 11852.16,
      "start": 11851.16,
      "text": "说这个人类,"
    },
    {
      "end": 11853.16,
      "start": 11852.16,
      "text": "包括中国要消灭一部分人,"
    },
    {
      "end": 11855.16,
      "start": 11853.16,
      "text": "第一次说要不了那么多人,"
    },
    {
      "end": 11856.16,
      "start": 11855.16,
      "text": "他不是美国人想的,"
    },
    {
      "end": 11857.16,
      "start": 11856.16,
      "text": "中国人想的,"
    },
    {
      "end": 11858.16,
      "start": 11857.16,
      "text": "而中国认为美国人,"
    },
    {
      "end": 11859.16,
      "start": 11858.16,
      "text": "中美要合作这个关系,"
    },
    {
      "end": 11863.16,
      "start": 11859.16,
      "text": "而且这个计划一直在实施中,"
    },
    {
      "end": 11865.16,
      "start": 11863.16,
      "text": "你们要看一看中国总参的,"
    },
    {
      "end": 11867.16,
      "start": 11865.16,
      "text": "装甲兵学院,"
    },
    {
      "end": 11868.16,
      "start": 11867.16,
      "text": "然后呢,"
    },
    {
      "end": 11869.16,
      "start": 11868.16,
      "text": "叫防化兵学院,"
    },
    {
      "end": 11871.16,
      "start": 11869.16,
      "text": "防化兵学院从昌平搞的时候,"
    },
    {
      "end": 11875.16,
      "start": 11871.16,
      "text": "几千亩的地方是怎么盖起来的,"
    },
    {
      "end": 11876.16,
      "start": 11875.16,
      "text": "是谁负责的,"
    },
    {
      "end": 11879.16,
      "start": 11876.16,
      "text": "那是七哥的老师全程负责的,"
    },
    {
      "end": 11882.16,
      "start": 11879.16,
      "text": "防化兵学院是干啥的,"
    },
    {
      "end": 11885.16,
      "start": 11882.16,
      "text": "防化兵就是化学部队好不好去那些门门,"
    },
    {
      "end": 11887.16,
      "start": 11885.16,
      "text": "我不知道什么叫生化武器,"
    },
    {
      "end": 11889.16,
      "start": 11887.16,
      "text": "我防什么化兵啊,"
    },
    {
      "end": 11895.16,
      "start": 11889.16,
      "text": "为啥我在香港才会用生化生物武器和化学武器啊,"
    },
    {
      "end": 11897.16,
      "start": 11895.16,
      "text": "2019年5月份呢,"
    },
    {
      "end": 11900.16,
      "start": 11897.16,
      "text": "因为共产党他早就有这准备,"
    },
    {
      "end": 11902.16,
      "start": 11900.16,
      "text": "而且我跟这些,"
    },
    {
      "end": 11903.16,
      "start": 11902.16,
      "text": "你像道士梁光烈,"
    },
    {
      "end": 11905.16,
      "start": 11903.16,
      "text": "那王八蛋玩完民心以后,"
    },
    {
      "end": 11906.16,
      "start": 11905.16,
      "text": "我说这么,"
    },
    {
      "end": 11907.16,
      "start": 11906.16,
      "text": "你们今天又演习,"
    },
    {
      "end": 11909.16,
      "start": 11907.16,
      "text": "跟美国人能打得了仗吗?"
    },
    {
      "end": 11910.16,
      "start": 11909.16,
      "text": "他说咱怎么给他打得过他吗?"
    },
    {
      "end": 11911.16,
      "start": 11910.16,
      "text": "他说不给他打,"
    },
    {
      "end": 11914.16,
      "start": 11911.16,
      "text": "咱就用化学武器生化武器,"
    },
    {
      "end": 11917.16,
      "start": 11914.16,
      "text": "还有一个用美国人打美国人啊,"
    },
    {
      "end": 11920.16,
      "start": 11917.16,
      "text": "这九几年都说的话,"
    },
    {
      "end": 11922.16,
      "start": 11920.16,
      "text": "那时候他还不是总参谋长的,"
    },
    {
      "end": 11926.16,
      "start": 11922.16,
      "text": "这外国他没常识,"
    },
    {
      "end": 11928.16,
      "start": 11926.16,
      "text": "这很多战友他没常识,"
    },
    {
      "end": 11933.16,
      "start": 11928.16,
      "text": "这个疫苗是共产党处心拘律早已经准备好的,"
    },
    {
      "end": 11935.16,
      "start": 11933.16,
      "text": "他派出了几千人上万人,"
    },
    {
      "end": 11938.16,
      "start": 11935.16,
      "text": "潜伏到全世界的武器实验室,"
    },
    {
      "end": 11941.16,
      "start": 11938.16,
      "text": "潜伏到全世界的生物研究专家,"
    },
    {
      "end": 11942.16,
      "start": 11941.16,
      "text": "而且是美国人给钱,"
    },
    {
      "end": 11946.16,
      "start": 11942.16,
      "text": "而且有计划有组织的蓝金黄买通了西方的这些所谓的,"
    },
    {
      "end": 11951.16,
      "start": 11946.16,
      "text": "媒体还有全世界的这些科学生物研究学家,"
    },
    {
      "end": 11957.16,
      "start": 11951.16,
      "text": "这个疫苗的灾难怎么可能现在你们真的看到它还没来呢?"
    },
    {
      "end": 11960.16,
      "start": 11957.16,
      "text": "最难的日子就是今年年底到明年,"
    },
    {
      "end": 11962.16,
      "start": 11960.16,
      "text": "这个疫苗才真正可怕,"
    },
    {
      "end": 11965.16,
      "start": 11962.16,
      "text": "打到身体的药你拔不出来了,"
    },
    {
      "end": 11967.16,
      "start": 11965.16,
      "text": "现在共产党要收回,"
    },
    {
      "end": 11968.16,
      "start": 11967.16,
      "text": "能给你收回吗?"
    },
    {
      "end": 11970.16,
      "start": 11968.16,
      "text": "只有非非大会,"
    },
    {
      "end": 11971.16,
      "start": 11970.16,
      "text": "你们受过这个病,"
    },
    {
      "end": 11973.16,
      "start": 11971.16,
      "text": "你真的有多痛苦多危险,"
    },
    {
      "end": 11978.16,
      "start": 11973.16,
      "text": "我知道的多少信息很多人就是忧郁症了,"
    },
    {
      "end": 11980.16,
      "start": 11978.16,
      "text": "就打完这打成忧郁症了,"
    },
    {
      "end": 11982.16,
      "start": 11980.16,
      "text": "说我这等着死呢这是,"
    },
    {
      "end": 11984.16,
      "start": 11982.16,
      "text": "你现在像国内的,"
    },
    {
      "end": 11987.16,
      "start": 11984.16,
      "text": "你像很多朋友现在原来对咱半信半疑的,"
    },
    {
      "end": 11990.16,
      "start": 11987.16,
      "text": "现在说七哥我们怎么能把这弄掉,"
    },
    {
      "end": 11991.16,
      "start": 11990.16,
      "text": "我就睡不好觉了,"
    },
    {
      "end": 11992.16,
      "start": 11991.16,
      "text": "啥时候死都不知道,"
    },
    {
      "end": 11995.16,
      "start": 11992.16,
      "text": "他说我都准备好遗书了,"
    },
    {
      "end": 11996.16,
      "start": 11995.16,
      "text": "我真的跟他们建议,"
    },
    {
      "end": 11998.16,
      "start": 11996.16,
      "text": "如果你真打了三针以上,"
    },
    {
      "end": 11999.16,
      "start": 11998.16,
      "text": "你就准备好遗书了,"
    },
    {
      "end": 12003.16,
      "start": 11999.16,
      "text": "你最起码有50%的几率,"
    },
    {
      "end": 12005.16,
      "start": 12003.16,
      "text": "未来三五年那会儿个儿屁,"
    },
    {
      "end": 12009.16,
      "start": 12005.16,
      "text": "那我们兄弟姐妹们今天在这儿的时候,"
    },
    {
      "end": 12012.16,
      "start": 12009.16,
      "text": "咱们在直播你以为在这块儿扯淡呢,"
    },
    {
      "end": 12013.16,
      "start": 12012.16,
      "text": "跟路大脑片一样,"
    },
    {
      "end": 12015.16,
      "start": 12013.16,
      "text": "到时剪点什么Google的架子,"
    },
    {
      "end": 12016.16,
      "start": 12015.16,
      "text": "然后是吧是吧,"
    },
    {
      "end": 12017.16,
      "start": 12016.16,
      "text": "癌症例癌症例,"
    },
    {
      "end": 12018.16,
      "start": 12017.16,
      "text": "是不是是吧找帝国,"
    },
    {
      "end": 12019.16,
      "start": 12018.16,
      "text": "是不是是吧,"
    },
    {
      "end": 12020.16,
      "start": 12019.16,
      "text": "就试把你一个小时,"
    },
    {
      "end": 12023.16,
      "start": 12020.16,
      "text": "我们说的这是发生内心都亲身经历的事情,"
    },
    {
      "end": 12028.16,
      "start": 12025.16,
      "text": "这个疫苗的灾难是太恐怖了,"
    },
    {
      "end": 12029.16,
      "start": 12028.16,
      "text": "打了疫苗太恐怖了,"
    },
    {
      "end": 12030.16,
      "start": 12029.16,
      "text": "我那麽飞机上,"
    },
    {
      "end": 12034.16,
      "start": 12030.16,
      "text": "这机长一哥们儿,"
    },
    {
      "end": 12035.16,
      "start": 12034.16,
      "text": "我打了两针,"
    },
    {
      "end": 12037.16,
      "start": 12035.16,
      "text": "这哥们儿说我打了两针,"
    },
    {
      "end": 12038.16,
      "start": 12037.16,
      "text": "但是怕我耳朵说,"
    },
    {
      "end": 12041.16,
      "start": 12038.16,
      "text": "郭先生我那两针护士过来以后,"
    },
    {
      "end": 12043.16,
