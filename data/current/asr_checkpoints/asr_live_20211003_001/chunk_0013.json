{
  "chunk_audio_sha256": "e41fee351a2c7c8d16da0293481d8567d7e5eee79215b71b76b55564387a445d",
  "chunk_index": 13,
  "completed_at": "2026-10-20T14:26:56Z",
  "language": "zh",
