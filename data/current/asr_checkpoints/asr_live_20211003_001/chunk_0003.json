{
  "chunk_audio_sha256": "b8ce0db2a55f6131abdddbe8011f32476d669199f68d149f51c88a880bfb2735",
  "chunk_index": 3,
  "completed_at": "2026-10-20T14:04:57Z",
  "language": "zh",
  "live_id": "LIVE_20211003_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 2700,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 2705.4,
      "start": 2700.0,
      "text": "在新疆建设兵团 局长大量的杀新疆人"
    },
    {
      "end": 2710.3,
      "start": 2705.4,
      "text": "大量的收敛当地的宝石和整个玉石"
    },
    {
      "end": 2716.9,
      "start": 2710.3,
      "text": "中国的外交部就是一个卖党部 卖国部 腐败部 性交部 性乱部"
    },
    {
      "end": 2720.2,
      "start": 2716.9,
      "text": "遭后级了 每个人都是玩这一套"
    },
    {
      "end": 2724.9,
      "start": 2720.2,
      "text": "所以你看最近 吴美海谈要谈谈这个理解"
    },
    {
      "end": 2728.8,
      "start": 2724.9,
      "text": "你从这两个人身上看到中国的外交全变了"
    },
    {
      "end": 2733.3,
      "start": 2728.8,
      "text": "还有一个最重要的事情 王沪宁是管外交的"
    },
    {
      "end": 2737.0,
      "start": 2733.3,
      "text": "你最近见到王沪宁了吗"
    },
    {
      "end": 2741.7,
      "start": 2737.0,
      "text": "杨洁篪现在去达拉斯 灭美之后"
    },
    {
      "end": 2744.2,
      "start": 2741.7,
      "text": "现在杨洁篪是国务院 在哪呢"
    },
    {
      "end": 2748.4,
      "start": 2744.2,
      "text": "王毅最近直喊话也不见人了"
    },
    {
      "end": 2750.7,
      "start": 2748.4,
      "text": "那个帅手也不得得瑟了"
    },
    {
      "end": 2756.3,
      "start": 2750.7,
      "text": "周恩来的手 一直就这么得瑟了 是吧 找不着了"
    },
    {
      "end": 2760.8,
      "start": 2756.3,
      "text": "所以今天谈谈中国外交部 到底是个什么部"
    },
    {
      "end": 2764.3,
      "start": 2760.8,
      "text": "他有多少人 他有多少实力 他有什么权利"
    },
    {
      "end": 2769.0,
      "start": 2764.3,
      "text": "现在我说到这 请你谈谈这几个人谈谈几个事"
    },
    {
      "end": 2774.5,
      "start": 2769.0,
      "text": "谢谢 你们每个人谈谈"
    },
    {
      "end": 2776.0,
      "start": 2774.5,
      "text": "好的 谢谢七哥"
    },
    {
      "end": 2780.0,
      "start": 2776.0,
      "text": "这个在文贵先生提到刚才这几个关键人的时候呢"
    },
    {
      "end": 2784.0,
      "start": 2780.0,
      "text": "我们也简单我看了一下这个 我现在看到的一个资料"
    },
    {
      "end": 2787.5,
      "start": 2784.0,
      "text": "就是我发现了就是七哥提到的这个 刚才那个共性问题"
    },
    {
      "end": 2792.0,
      "start": 2787.5,
      "text": "他们在新疆问题上 在新疆的履历 还有他们在新疆做的这个事情"
    },
    {
      "end": 2797.0,
      "start": 2792.0,
      "text": "事实上和现在我们看到的共产党 现在实际做的事情"
    },
    {
      "end": 2799.5,
      "start": 2797.0,
      "text": "我们把爆料革命的这些东西联系起来"
    },
    {
      "end": 2802.0,
      "start": 2799.5,
      "text": "仿佛以前发生的事情 我们就看明白了"
    },
    {
      "end": 2806.0,
      "start": 2802.0,
      "text": "就是以前老江 江泽民执政的时候呢 外交部呢挂两块牌子"
    },
    {
      "end": 2809.5,
      "start": 2806.0,
      "text": "一块牌子呢 叫对外的这个外事工作小组"
    },
    {
      "end": 2813.0,
      "start": 2809.5,
      "text": "一块牌子呢 就打着国家安全的工作小组"
    },
    {
      "end": 2816.5,
      "start": 2813.0,
      "text": "然后呢 我们看一下这个 先说陈国平"
    },
    {
      "end": 2822.0,
      "start": 2816.5,
      "text": "陈国平呢 在这个2009年到2011年 他担任的是部长助理"
    },
    {
      "end": 2825.5,
      "start": 2822.0,
      "text": "那么结果这七哥说他的这个背景呢 他给谁当助理"
    },
    {
      "end": 2827.5,
      "start": 2825.5,
      "text": "这样我们看一下 正好是杨洁篪"
    },
    {
      "end": 2831.5,
      "start": 2827.5,
      "text": "杨洁篪主长外交部的这个时候 他给杨洁篪当部长助理"
    },
    {
      "end": 2834.5,
      "start": 2831.5,
      "text": "那说白了 外交部杨洁篪当时代表江家"
    },
    {
      "end": 2839.0,
      "start": 2834.5,
      "text": "他去做的这些重要的事情 肯定是部长助理要有这个跟随"
    },
    {
      "end": 2841.5,
      "start": 2839.0,
      "text": "亲自落实 亲自安排"
    },
    {
      "end": 2845.5,
      "start": 2841.5,
      "text": "所以呢 他是知晓这个杨洁篪的一些这个当时的主政工作的"
    },
    {
      "end": 2849.0,
      "start": 2845.5,
      "text": "然后紧接着呢 在2011年马上接了副部长"
    },
    {
      "end": 2853.0,
      "start": 2849.0,
      "text": "所以呢 这个这个陈国平他的在国内的这个履历"
    },
    {
      "end": 2856.0,
      "start": 2853.0,
      "text": "还有在这个杨洁篪他之间的这个工作关系"
    },
    {
      "end": 2861.0,
      "start": 2856.0,
      "text": "我们就能看明白什么呢 他在外交部尤其是打着涉外"
    },
    {
      "end": 2864.0,
      "start": 2861.0,
      "text": "涉恐国家安全的时候 因为外交部挂两块牌子嘛"
    },
    {
      "end": 2867.5,
      "start": 2864.0,
      "text": "就是最早 那么再往前数 外交部战友们"
    },
    {
      "end": 2869.5,
      "start": 2867.5,
      "text": "这是大卫的这个简单理解啊"
    },
    {
      "end": 2871.0,
      "start": 2869.5,
      "text": "一会让七哥再给我们纠正一下"
    },
    {
      "end": 2874.0,
      "start": 2871.0,
      "text": "外交部最开始创造这个地方的共产党"
    },
    {
      "end": 2878.5,
      "start": 2874.0,
      "text": "谁是头子 周恩来 周恩来 纪彭飞"
    },
    {
      "end": 2881.0,
      "start": 2878.5,
      "text": "这些人是最早创造外交部"
    },
    {
      "end": 2882.5,
      "start": 2881.0,
      "text": "那周恩来就是玩情报的"
    },
    {
      "end": 2884.5,
      "start": 2882.5,
      "text": "而且当时的副部长就是李克农"
    },
    {
      "end": 2887.0,
      "start": 2884.5,
      "text": "那战友们稍稍对共产党历史都有点了解"
    },
    {
      "end": 2890.0,
      "start": 2887.0,
      "text": "那个周恩来就是中共的大头头子"
    },
    {
      "end": 2892.5,
      "start": 2890.0,
      "text": "李克农那就是直接的落实者和执行者"
    },
    {
      "end": 2898.0,
      "start": 2892.5,
      "text": "没有当年的上海渗透到国民政府的叛逃"
    },
    {
      "end": 2902.5,
      "start": 2898.0,
      "text": "可能当时中央特科在上海就被国民政府全军见面了"
    },
    {
      "end": 2903.5,
      "start": 2902.5,
      "text": "这是历史上的事情"
    },
    {
      "end": 2907.0,
      "start": 2903.5,
      "text": "那反过来讲 现在共产党一直拿着情报"
    },
    {
      "end": 2909.5,
      "start": 2907.0,
      "text": "打着国家安全情报"
    },
    {
      "end": 2911.0,
      "start": 2909.5,
      "text": "完了呢 他把外事工作小组"
    },
    {
      "end": 2913.0,
      "start": 2911.0,
      "text": "其实就是输出中共的一带一路"
    },
    {
      "end": 2915.5,
      "start": 2913.0,
      "text": "国家的邪恶的操作"
    },
    {
      "end": 2918.0,
      "start": 2915.5,
      "text": "那么到今天爆料革命说白了"
    },
    {
      "end": 2919.0,
      "start": 2918.0,
      "text": "Follow the money 对不对"
    },
    {
      "end": 2921.0,
      "start": 2919.0,
      "text": "我们看着他钱去哪"
    },
    {
      "end": 2922.5,
      "start": 2921.0,
      "text": "那待会儿七哥可能会跟我们揭示"
    },
    {
      "end": 2925.0,
      "start": 2922.5,
      "text": "无非是把盗国贼家族的利益"
    },
    {
      "end": 2927.0,
      "start": 2925.0,
      "text": "还有外交部这一年海外藏的钱"
    },
    {
      "end": 2929.0,
      "start": 2927.0,
      "text": "仅仅大卫的个人的这个经历"
    },
    {
      "end": 2930.5,
      "start": 2929.0,
      "text": "你看在一个中国大使馆"
    },
    {
      "end": 2933.5,
      "start": 2930.5,
      "text": "伦敦造币厂 七哥应该知道"
    },
    {
      "end": 2935.5,
      "start": 2933.5,
      "text": "在这个tower那边的造币厂"
    },
    {
      "end": 2937.5,
      "start": 2935.5,
      "text": "七八亿英镑买完了"
    },
    {
      "end": 2939.5,
      "start": 2937.5,
      "text": "买完了这几年 由于爆料革命"
    },
    {
      "end": 2941.5,
      "start": 2939.5,
      "text": "你看我们爆料革命是2017年出来的"
    },
    {
      "end": 2943.5,
      "start": 2941.5,
      "text": "共产党也没那个底气了"
    },
    {
      "end": 2944.5,
      "start": 2943.5,
      "text": "不敢折腾了"
    },
    {
      "end": 2948.5,
      "start": 2944.5,
      "text": "加上英国政府全面对中共海外情报的这种渗透影响"
    },
    {
      "end": 2951.5,
      "start": 2948.5,
      "text": "那么仅仅一个伦敦大家看到的就是这个局面"
    },
    {
      "end": 2952.5,
      "start": 2951.5,
      "text": "那么刚才七哥说"
    },
    {
      "end": 2957.5,
      "start": 2952.5,
      "text": "那他们在这个中东在亚欧都干了哪些事"
    },
    {
      "end": 2958.5,
      "start": 2957.5,
      "text": "那藏的钱会更多"
    },
    {
      "end": 2962.5,
      "start": 2958.5,
      "text": "而且这个陈国平还担任过亚洲司司长"
    },
    {
      "end": 2963.5,
      "start": 2962.5,
      "text": "在俄罗斯也混过"
    },
    {
      "end": 2965.5,
      "start": 2963.5,
      "text": "并且刚才也提到了"
    },
    {
      "end": 2967.5,
      "start": 2965.5,
      "text": "他在那个跟杨绪执政的期间"
    },
    {
      "end": 2971.5,
      "start": 2967.5,
      "text": "跟那个尼 他们又是有工作关系"
    },
    {
      "end": 2975.5,
      "start": 2971.5,
      "text": "所以说我觉得这里边海外藏钱干着邪恶勾当"
    },
    {
      "end": 2977.5,
      "start": 2975.5,
      "text": "这个应该是七哥掌握了很多"
    },
    {
      "end": 2980.5,
      "start": 2977.5,
      "text": "可以这个跟我们战友们稍后会说"
    },
    {
      "end": 2982.5,
      "start": 2980.5,
      "text": "另外呢 我个人啊 我还有一个什么感觉呢"
    },
    {
      "end": 2985.5,
      "start": 2982.5,
      "text": "就是外交部这些年都是两面套"
    },
    {
      "end": 2987.5,
      "start": 2985.5,
      "text": "你看那个华春莹 是吧"
    },
    {
      "end": 2990.5,
      "start": 2987.5,
      "text": "在台前叫战狼外交是一套"
    },
    {
      "end": 2991.5,
      "start": 2990.5,
      "text": "吓唬这些人"
    },
    {
      "end": 2992.5,
      "start": 2991.5,
      "text": "然后事实上下面干的呢"
    },
    {
      "end": 2994.5,
      "start": 2992.5,
      "text": "全是见不得人的勾当"
    },
    {
      "end": 2995.5,
      "start": 2994.5,
      "text": "尤其是在最近的这个"
    },
    {
      "end": 2996.5,
      "start": 2995.5,
      "text": "我这个五年吧"
    },
    {
      "end": 2998.5,
      "start": 2996.5,
      "text": "十八大十九大里边"
    },
    {
      "end": 2999.5,
      "start": 2998.5,
      "text": "那么刚才七哥提到了说"
    },
    {
      "end": 3001.5,
      "start": 2999.5,
      "text": "这几个人这两天在哪呢"
    },
    {
      "end": 3002.5,
      "start": 3001.5,
      "text": "大卫也稍微做了一下"
    },
    {
      "end": 3004.5,
      "start": 3002.5,
      "text": "我发现在十一那天"
    },
    {
      "end": 3008.5,
      "start": 3004.5,
      "text": "习搞了一个盛大的所谓纪念碑的这么一个祭拜"
    },
    {
      "end": 3009.5,
      "start": 3008.5,
      "text": "对吧"
    },
    {
      "end": 3010.5,
      "start": 3009.5,
      "text": "在这个祭拜里面呢"
    },
    {
      "end": 3012.5,
      "start": 3010.5,
      "text": "这个王岐山我也看了"
    },
    {
      "end": 3014.5,
      "start": 3012.5,
      "text": "脱着长长的这个裤子啊"
    },
    {
      "end": 3015.5,
      "start": 3014.5,
      "text": "裤裆滩朗到地"
    },
    {
      "end": 3016.5,
      "start": 3015.5,
      "text": "这个歪着头"
    },
    {
      "end": 3017.5,
      "start": 3016.5,
      "text": "而且王沪宁也出现了"
    },
    {
      "end": 3019.5,
      "start": 3017.5,
      "text": "他在栗战书后面"
    },
    {
      "end": 3020.5,
      "start": 3019.5,
      "text": "后面是韩正"
    },
    {
      "end": 3021.5,
      "start": 3020.5,
      "text": "然后呢"
    },
    {
      "end": 3022.5,
      "start": 3021.5,
      "text": "王岐山在左侧"
    },
    {
      "end": 3023.5,
      "start": 3022.5,
      "text": "站在最后"
    },
    {
      "end": 3025.5,
      "start": 3023.5,
      "text": "有这么一个金箭杯绕圈的动作"
    },
    {
      "end": 3026.5,
      "start": 3025.5,
      "text": "然后王毅呢"
    },
    {
      "end": 3027.5,
      "start": 3026.5,
      "text": "是跟着谁呢"
    },
    {
      "end": 3028.5,
      "start": 3027.5,
      "text": "跟着孙春兰的后面"
    },
    {
      "end": 3029.5,
      "start": 3028.5,
      "text": "完了"
    },
    {
      "end": 3030.5,
      "start": 3029.5,
      "text": "赵克志的后面"
    },
    {
      "end": 3031.5,
      "start": 3030.5,
      "text": "一排走过去"
    },
    {
      "end": 3032.5,
      "start": 3031.5,
      "text": "我特意还截了屏"
    },
    {
      "end": 3033.5,
      "start": 3032.5,
      "text": "所以呢"
    },
    {
      "end": 3034.5,
      "start": 3033.5,
      "text": "就是七哥问他在哪呢"
    },
    {
      "end": 3035.5,
      "start": 3034.5,
      "text": "我大卫只能说"
    },
    {
      "end": 3036.5,
      "start": 3035.5,
      "text": "都在北京了"
    },
    {
      "end": 3038.5,
      "start": 3036.5,
      "text": "都在习的眼皮底下了"
    },
    {
      "end": 3039.5,
      "start": 3038.5,
      "text": "最近都很消费"
    },
    {
      "end": 3040.5,
      "start": 3039.5,
      "text": "一顿折腾"
    },
    {
      "end": 3041.5,
      "start": 3040.5,
      "text": "那么我看的是表面"
    },
    {
      "end": 3043.5,
      "start": 3041.5,
      "text": "让七哥给我们来"
    },
    {
      "end": 3046.5,
      "start": 3043.5,
      "text": "再解释一下后面的内幕"
    },
    {
      "end": 3047.5,
      "start": 3046.5,
      "text": "谢谢七哥"
    },
    {
      "end": 3052.5,
      "start": 3051.5,
      "text": "当然这样啊"
    },
    {
      "end": 3053.5,
      "start": 3052.5,
      "text": "这个大卫兄弟"
    },
    {
      "end": 3054.5,
      "start": 3053.5,
      "text": "刚才这句话"
    },
    {
      "end": 3055.5,
      "start": 3054.5,
      "text": "我说完以后"
    },
    {
      "end": 3056.5,
      "start": 3055.5,
      "text": "我觉得"
    },
    {
      "end": 3057.5,
      "start": 3056.5,
      "text": "大卫兄弟就是"
    },
    {
      "end": 3058.5,
      "start": 3057.5,
      "text": "他这个做直播"
    },
    {
      "end": 3060.5,
      "start": 3058.5,
      "text": "为啥我特别喜欢"
    },
    {
      "end": 3062.5,
      "start": 3060.5,
      "text": "他是很认真研究的"
    },
    {
      "end": 3063.5,
      "start": 3062.5,
      "text": "很认真研究的"
    },
    {
      "end": 3066.5,
      "start": 3063.5,
      "text": "不像这个非非直播"
    },
    {
      "end": 3067.5,
