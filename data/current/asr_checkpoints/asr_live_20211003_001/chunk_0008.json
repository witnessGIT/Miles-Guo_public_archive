  "segments": [
    {
      "end": 7202.0,
      "start": 7200.0,
      "text": "已经基本上彻底改变"
    },
    {
      "end": 7204.56,
      "start": 7203.04,
      "text": "而且美国就更不用提了"
    },
    {
      "end": 7209.3,
      "start": 7205.04,
      "text": "七哥成为盖特上第一个最牛的关注量"
    },
    {
      "end": 7212.36,
      "start": 7209.3,
      "text": "信息飞翔量超过蓬佩奥五倍还多"
    },
    {
      "end": 7213.8,
      "start": 7212.36,
      "text": "后面加一血没有人多呢"
    },
    {
      "end": 7214.3,
      "start": 7213.8,
      "text": "为什么"
    },
    {
      "end": 7216.94,
      "start": 7214.3,
      "text": "就是因为他们相信七哥说的疫苗"
    },
    {
      "end": 7219.66,
      "start": 7217.66,
      "text": "我们在彻底的改变世界"
    },
    {
      "end": 7222.7,
      "start": 7220.74,
      "text": "爆料革命在彻底的改变世界"
    },
    {
      "end": 7224.14,
      "start": 7222.7,
      "text": "我说的今天这个陈国平"
    },
    {
      "end": 7225.74,
      "start": 7224.14,
      "text": "我说的这个尼尖"
    },
    {
      "end": 7228.56,
      "start": 7226.8,
      "text": "我说的王毅和杨洁篪"
    },
    {
      "end": 7229.4,
      "start": 7228.56,
      "text": "还有王沪宁"
    },
    {
      "end": 7231.06,
      "start": 7229.4,
      "text": "刚才老弟说的王沪宁在北京"
    },
    {
      "end": 7231.94,
      "start": 7231.06,
      "text": "我可以告诉你"
    },
    {
      "end": 7233.94,
      "start": 7231.94,
      "text": "王沪宁有活动在北京"
    },
    {
      "end": 7235.26,
      "start": 7233.94,
      "text": "没活动他不能在北京"
    },
    {
      "end": 7238.3,
      "start": 7236.44,
      "text": "王沪宁和杨洁篪"
    },
    {
      "end": 7239.3,
      "start": 7238.3,
      "text": "所有的活"
    },
    {
      "end": 7240.3,
      "start": 7239.3,
      "text": "现在他的生活"
    },
    {
      "end": 7242.6,
      "start": 7240.3,
      "text": "就像王岐山和孟建柱一样"
    },
    {
      "end": 7244.3,
      "start": 7242.6,
      "text": "处于国家监管状态"
    },
    {
      "end": 7246.6,
      "start": 7245.54,
      "text": "叫加强警卫"
    },
    {
      "end": 7250.4,
      "start": 7248.2,
      "text": "就像傅振华在二月份被抓一样"
    },
    {
      "end": 7252.0,
      "start": 7251.1,
      "text": "回家"
    },
    {
      "end": 7253.5,
      "start": 7252.0,
      "text": "叫做在家工作"
    },
    {
      "end": 7255.0,
      "start": 7253.5,
      "text": "监督上岗"
    },
    {
      "end": 7256.5,
      "start": 7255.54,
      "text": "给他定位叫"
    },
    {
      "end": 7257.4,
      "start": 7256.5,
      "text": "这不叫双规了"
    },
    {
      "end": 7258.56,
      "start": 7257.4,
      "text": "叫监督上岗"
    },
    {
      "end": 7259.32,
      "start": 7258.56,
      "text": "回家工作"
    },
    {
      "end": 7261.6,
      "start": 7260.86,
      "text": "卸材料"
    },
    {
      "end": 7264.42,
      "start": 7262.42,
      "text": "宣布是在一周前宣布的"
    },
    {
      "end": 7266.56,
      "start": 7264.82,
      "text": "孙力军我七哥提前五个月"
    },
    {
      "end": 7267.8,
      "start": 7266.56,
      "text": "告诉你孙力军被抓了"
    },
    {
      "end": 7268.9,
      "start": 7268.46,
      "text": "是吧"
    },
    {
      "end": 7272.8,
      "start": 7268.9,
      "text": "王岐山孟建柱是从2019年11月份"
    },
    {
      "end": 7273.52,
      "start": 7272.9,
      "text": "就属于"
    },
    {
      "end": 7276.46,
      "start": 7273.52,
      "text": "国家加强警卫状态"
    },
    {
      "end": 7278.46,
      "start": 7276.46,
      "text": "加强警卫就是已经把你双规了"
    },
    {
      "end": 7281.86,
      "start": 7280.78,
      "text": "王沪宁"
    },
    {
      "end": 7283.06,
      "start": 7281.86,
      "text": "杨洁篪"
    },
    {
      "end": 7284.46,
      "start": 7283.06,
      "text": "王毅已经属于"
    },
    {
      "end": 7287.56,
      "start": 7284.46,
      "text": "还在给国家工作中就属于加强安全状态"
    },
    {
      "end": 7290.46,
      "start": 7288.12,
      "text": "为了说确保二十大召开"
    },
    {
      "end": 7292.86,
      "start": 7291.82,
      "text": "安全召开"
    },
    {
      "end": 7294.02,
      "start": 7292.86,
      "text": "你先安全了"
    },
    {
      "end": 7295.52,
      "start": 7294.56,
      "text": "西哥男人给大卫"
    },
    {
      "end": 7295.9,
      "start": 7295.52,
      "text": "啊"
    },
    {
      "end": 7296.4,
      "start": 7295.9,
      "text": "飞飞啊"
    },
    {
      "end": 7297.9,
      "start": 7296.4,
      "text": "七哥要派出一人给你啊"
    },
    {
      "end": 7300.22,
      "start": 7297.9,
      "text": "安全的等待爆料革命啊"
    },
    {
      "end": 7301.3,
      "start": 7300.22,
      "text": "新中国联邦"
    },
    {
      "end": 7302.46,
      "start": 7301.3,
      "text": "你未来你当总书记"
    },
    {
      "end": 7303.52,
      "start": 7302.46,
      "text": "当副总书记啊"
    },
    {
      "end": 7304.9,
      "start": 7303.52,
      "text": "一人给你拍一百个保险"
    },
    {
      "end": 7306.56,
      "start": 7304.9,
      "text": "你俩就知道完了"
    },
    {
      "end": 7307.52,
      "start": 7306.56,
      "text": "这完了"
    },
    {
      "end": 7309.56,
      "start": 7307.52,
      "text": "你还能活着吗"
    },
    {
      "end": 7310.72,
      "start": 7309.56,
      "text": "你俩谁想双修"
    },
    {
      "end": 7311.78,
      "start": 7310.72,
      "text": "偷情也偷不了了"
    },
    {
      "end": 7312.56,
      "start": 7311.78,
      "text": "是不是"
    },
    {
      "end": 7313.78,
      "start": 7312.56,
      "text": "打个电话都被监督"
    },
    {
      "end": 7316.66,
      "start": 7314.78,
      "text": "这就是共产党的政治游戏"
    },
    {
      "end": 7318.26,
      "start": 7316.66,
      "text": "大家要看到这个本质"
    },
    {
      "end": 7320.62,
      "start": 7318.26,
      "text": "西哥今天直播特别想告诉大家的"
    },
    {
      "end": 7323.18,
      "start": 7320.62,
      "text": "我们站在了人类上最前端"
    },
    {
      "end": 7325.56,
      "start": 7323.18,
      "text": "当我们神经不正常的时候"
    },
    {
      "end": 7328.78,
      "start": 7325.56,
      "text": "你去想想后果多严重啊"
    },
    {
      "end": 7332.66,
      "start": 7328.78,
      "text": "你要买每个几个币买个650"
    },
    {
      "end": 7333.26,
      "start": 7332.66,
      "text": "是吧"
    },
    {
      "end": 7334.06,
      "start": 7333.26,
      "text": "然后呢"
    },
    {
      "end": 7336.38,
      "start": 7334.06,
      "text": "你现在你一秒钟一眨眼"
    },
    {
      "end": 7337.12,
      "start": 7336.38,
      "text": "王岐山死了"
    },
    {
      "end": 7338.32,
      "start": 7337.12,
      "text": "一眨眼杨介石死"
    },
    {
      "end": 7339.82,
      "start": 7338.32,
      "text": "一眨眼中南坑老子"
    },
    {
      "end": 7340.68,
      "start": 7339.82,
      "text": "咱们都死了"
    },
    {
      "end": 7341.86,
      "start": 7340.68,
      "text": "你那不叫灭共"
    },
    {
      "end": 7343.08,
      "start": 7341.86,
      "text": "你这灭地球呢"
    },
    {
      "end": 7345.68,
      "start": 7343.08,
      "text": "那比光的速度还快呢"
    },
    {
      "end": 7347.82,
      "start": 7345.68,
      "text": "所以说兄弟姐妹们"
    },
    {
      "end": 7349.02,
      "start": 7347.82,
      "text": "七哥从山上一回来"
    },
    {
      "end": 7350.42,
      "start": 7349.02,
      "text": "纽约城南家的了"
    },
    {
      "end": 7351.42,
      "start": 7350.42,
      "text": "七哥一回来"
    },
    {
      "end": 7352.96,
      "start": 7351.42,
      "text": "宣布下一分钟"
    },
    {
      "end": 7354.12,
      "start": 7352.96,
      "text": "共产党就没了"
    },
    {
      "end": 7355.32,
      "start": 7354.12,
      "text": "就跟路纳导骗似的"
    },
    {
      "end": 7356.02,
      "start": 7355.32,
      "text": "啊来了"
    },
    {
      "end": 7357.66,
      "start": 7356.02,
      "text": "重磅重磅重磅"
    },
    {
      "end": 7358.72,
      "start": 7357.66,
      "text": "蛇妖言"
    },
    {
      "end": 7359.22,
      "start": 7358.72,
      "text": "是吧"
    },
    {
      "end": 7360.36,
      "start": 7359.22,
      "text": "找了一个爷爷"
    },
    {
      "end": 7361.18,
      "start": 7360.36,
      "text": "睡在一起了"
    },
    {
      "end": 7362.32,
      "start": 7361.18,
      "text": "这叫重磅吗"
    },
    {
      "end": 7363.66,
      "start": 7362.32,
      "text": "是不是"
    },
    {
      "end": 7365.02,
      "start": 7363.66,
      "text": "心态"
    },
    {
      "end": 7366.22,
      "start": 7365.02,
      "text": "能力"
    },
    {
      "end": 7368.78,
      "start": 7366.22,
      "text": "基本的常识和判断力"
    },
    {
      "end": 7370.36,
      "start": 7368.78,
      "text": "决定了一个人"
    },
    {
      "end": 7371.92,
      "start": 7370.36,
      "text": "一个集体的走向合法"
    },
    {
      "end": 7374.82,
      "start": 7371.92,
      "text": "怎么看待富正华"
    },
    {
      "end": 7375.92,
      "start": 7374.82,
      "text": "怎么看待恒大"
    },
    {
      "end": 7377.06,
      "start": 7375.92,
      "text": "怎么看待疫苗"
    },
    {
      "end": 7378.84,
      "start": 7377.06,
      "text": "怎么看待疫苗灭共"
    },
    {
      "end": 7381.12,
      "start": 7378.84,
      "text": "怎么看待外交"
    },
    {
      "end": 7382.36,
      "start": 7381.12,
      "text": "现在最近的失利"
    },
    {
      "end": 7383.52,
      "start": 7382.36,
      "text": "和怎么看待"
    },
    {
      "end": 7384.16,
      "start": 7383.52,
      "text": "真正国家"
    },
    {
      "end": 7385.14,
      "start": 7384.16,
      "text": "现在停电的问题"
    },
    {
      "end": 7386.66,
      "start": 7385.14,
      "text": "我可以告诉大家"
    },
    {
      "end": 7387.62,
      "start": 7386.66,
      "text": "国内的停电"
    },
    {
      "end": 7388.52,
      "start": 7387.62,
      "text": "是有计划"
    },
    {
      "end": 7389.58,
      "start": 7388.52,
      "text": "有阴谋的停电"
    },
    {
      "end": 7392.72,
      "start": 7389.58,
      "text": "根本和政治斗争没任何关系"
    },
    {
      "end": 7395.62,
      "start": 7392.72,
      "text": "你看到台湾那些报道"
    },
    {
      "end": 7396.58,
      "start": 7395.62,
      "text": "还有欧洲都把美国"
    },
    {
      "end": 7398.48,
      "start": 7396.58,
      "text": "愚蠢的跟猪一样"
    },
    {
      "end": 7400.72,
      "start": 7398.48,
      "text": "台湾有人发给我"
    },
    {
      "end": 7402.12,
      "start": 7400.72,
      "text": "叫什么关键时刻"
    },
    {
      "end": 7404.14,
      "start": 7402.12,
      "text": "什么习斗争啦"
    },
    {
      "end": 7405.14,
      "start": 7404.14,
      "text": "什么九省十省"
    },
    {
      "end": 7406.48,
      "start": 7405.14,
      "text": "我笑的都快不行了"
    },
    {
      "end": 7407.54,
      "start": 7406.48,
      "text": "台湾这个地方"
    },
    {
      "end": 7408.94,
      "start": 7407.54,
      "text": "就从这方面上来讲"
    },
    {
      "end": 7410.78,
      "start": 7408.94,
      "text": "这个真是大难来头的一个先兆"
    },
    {
      "end": 7412.84,
      "start": 7410.78,
      "text": "就是全人民过的生活太好"
    },
    {
      "end": 7414.14,
      "start": 7412.84,
      "text": "都在那块撅着屁股"
    },
    {
      "end": 7415.58,
      "start": 7414.14,
      "text": "都在那块吃饭"
    },
    {
      "end": 7417.3,
      "start": 7415.58,
      "text": "完全忘了天上来的威胁"
    },
    {
      "end": 7419.34,
      "start": 7417.3,
      "text": "就是你看到台湾的新闻"
    },
    {
      "end": 7420.98,
      "start": 7419.34,
      "text": "已经百分之百被共同控制"
    },
    {
      "end": 7424.18,
      "start": 7420.98,
      "text": "即使台湾这样的独立的"
    },
    {
      "end": 7425.6,
      "start": 7424.18,
      "text": "所谓人权的独立的地方"
    },
    {
      "end": 7427.52,
      "start": 7425.6,
      "text": "对大陆的军情"
    },
    {
      "end": 7430.08,
      "start": 7427.52,
      "text": "政情 民情 经济情况"
    },
    {
      "end": 7431.54,
      "start": 7430.08,
      "text": "没有一点点的判断"
    },
    {
      "end": 7433.08,
      "start": 7431.54,
      "text": "这样的地方"
    },
    {
      "end": 7433.94,
      "start": 7433.08,
      "text": "怎么能不出事呢"
    },
    {
      "end": 7436.94,
      "start": 7434.94,
      "text": "怎么能不出事呢"
    },
    {
      "end": 7438.36,
      "start": 7436.94,
      "text": "这次大陆的停电"
    },
    {
      "end": 7441.26,
      "start": 7438.36,
      "text": "是组织上有计划国家行为"
    },
    {
      "end": 7443.86,
      "start": 7441.26,
      "text": "绝对不是政治斗争"
    },
    {
      "end": 7445.36,
      "start": 7443.86,
      "text": "大家一定要记住"
    },
    {
      "end": 7446.92,
      "start": 7445.36,
      "text": "因为太小看共产党了"
    },
    {
      "end": 7448.4,
      "start": 7446.92,
      "text": "好 我先说到这儿"
    },
    {
      "end": 7449.16,
      "start": 7448.4,
      "text": "就以上的问题"
    },
    {
      "end": 7451.5,
      "start": 7449.16,
      "text": "请你们几个再评价"
    },
    {
      "end": 7453.0,
      "start": 7451.5,
      "text": "我在这听着学习"
    },
    {
      "end": 7457.66,
      "start": 7453.0,
      "text": "大卫哥您先请吧"
    },
    {
      "end": 7463.5,
      "start": 7457.66,
      "text": "好的 谢谢 谢谢几个"
    },
    {
      "end": 7466.06,
      "start": 7463.5,
      "text": "刚才我听的这段"
    },
    {
      "end": 7471.56,
      "start": 7466.06,
      "text": "其实我是想觉得七哥跟我们在分享一个叫暴力革命的心态问题"
    },
    {
      "end": 7473.92,
      "start": 7471.56,
      "text": "因为几两天七哥去山里"
    },
    {
      "end": 7475.9,
      "start": 7473.92,
      "text": "说实话咱们都很关心"
    },
    {
      "end": 7479.7,
      "start": 7475.9,
      "text": "因为大家每天除了期待龙育先生的盖客"
    },
    {
      "end": 7485.0,
      "start": 7479.7,
      "text": "我们当然是想期待体制那样墙那样有些大的消息出来"
    },
    {
      "end": 7486.9,
      "start": 7485.0,
      "text": "这个心情是可以理解的"
    },
    {
      "end": 7490.5,
      "start": 7486.9,
      "text": "还有就是我们很多战友"
    },
    {
      "end": 7494.86,
      "start": 7490.5,
      "text": "因为他有些是刚刚加入的爆料革命战友"
    },
    {
      "end": 7498.16,
      "start": 7494.86,
      "text": "他也特别希望看到所谓的好消息"
    },
    {
      "end": 7499.7,
      "start": 7498.16,
      "text": "这个心理可以理解"
    },
    {
      "end": 7501.2,
      "start": 7499.7,
      "text": "但是就像七哥刚才讲的"
    },
    {
      "end": 7506.1,
      "start": 7501.2,
      "text": "我们再去寻找金矿的路上"
    },
    {
      "end": 7508.1,
      "start": 7506.1,
      "text": "可能我们钻石已经掉了一地了"
    },
    {
      "end": 7510.6,
      "start": 7508.1,
      "text": "就是爆料革命的这路上的这几年"
    },
    {
      "end": 7512.1,
      "start": 7510.6,
      "text": "我就说我自己的感受"
    },
    {
      "end": 7514.2,
      "start": 7512.1,
      "text": "我不去说我能代表什么战友"
    },
    {
      "end": 7515.1,
      "start": 7514.2,
      "text": "我就说我自己"
    },
    {
      "end": 7516.2,
      "start": 7515.1,
      "text": "我这四年呢"
    },
    {
      "end": 7517.9,
      "start": 7516.2,
      "text": "其实我就要几个有次评价我"
    },
    {
      "end": 7520.6,
      "start": 7517.9,
      "text": "我就是从底层挣扎的这么一个"
    },
    {
      "end": 7524.9,
      "start": 7520.6,
      "text": "而且把青春的那个最好年华的那个十年八年"
    },
    {
      "end": 7526.7,
      "start": 7524.9,
      "text": "给扔给了体制"
    },
    {
      "end": 7528.6,
      "start": 7526.7,
      "text": "然后又上国外又折腾"
    },
    {
      "end": 7531.0,
      "start": 7528.6,
      "text": "咱们没做什么违法乱纪的事"
    },
    {
      "end": 7531.6,
      "start": 7531.0,
      "text": "对吧 七哥"
    },
    {
      "end": 7533.8,
      "start": 7531.6,
      "text": "老弟就是踏踏实实的"
    },
    {
      "end": 7536.0,
      "start": 7533.8,
      "text": "咱们就是海外普通的一个小的华人"
    },
    {
      "end": 7536.8,
      "start": 7536.0,
      "text": "可以这么讲"
    },
    {
      "end": 7540.1,
      "start": 7536.8,
      "text": "但是咱们挺着凶脯的做人做事"
    },
    {
      "end": 7542.4,
      "start": 7540.1,
      "text": "所以说我觉得这爆料革命的这几年"
    },
    {
      "end": 7544.4,
      "start": 7542.4,
      "text": "对我个人来讲真的是一个升华"
    },
    {
      "end": 7545.4,
      "start": 7544.4,
      "text": "一个学习"
    },
    {
      "end": 7548.6,
      "start": 7545.4,
      "text": "然后呢原来的身上的那种匪气啊"
    },
    {
      "end": 7549.9,
      "start": 7548.6,
      "text": "那个躁动啊"
    },
    {
      "end": 7551.6,
      "start": 7549.9,
      "text": "还有七哥说的那种不自然"
    },
    {
      "end": 7552.7,
      "start": 7551.6,
      "text": "那种不自信"
    },
    {
      "end": 7555.5,
      "start": 7552.7,
      "text": "其实是源于从共产党的体制里出来以后"
    },
    {
      "end": 7556.2,
      "start": 7555.5,
      "text": "到了海外"
    },
    {
      "end": 7558.3,
      "start": 7556.2,
      "text": "不知道该做成一个什么样的华人"
    },
    {
      "end": 7560.2,
      "start": 7558.3,
      "text": "真的今天七哥当着七哥的面"
    },
    {
      "end": 7561.8,
      "start": 7560.2,
      "text": "其实就一师一友"
    },
    {
      "end": 7565.3,
      "start": 7561.8,
      "text": "我一直把七哥向我视为我的一个兄长"
    },
    {
      "end": 7566.1,
      "start": 7565.3,
      "text": "因为什么呢"
    },
    {
      "end": 7568.0,
      "start": 7566.1,
      "text": "我看他去怎么做事情"
    },
    {
      "end": 7569.7,
      "start": 7568.0,
      "text": "他去怎么解决危机"
    },
    {
      "end": 7571.2,
      "start": 7569.7,
      "text": "家人遇到危难的"
    },
    {
      "end": 7572.1,
      "start": 7571.2,
      "text": "员工遇到危难"
    },
    {
      "end": 7572.9,
      "start": 7572.1,
      "text": "遇到困难的时候"
    },
    {
      "end": 7575.1,
      "start": 7572.9,
      "text": "他是怎么去心里去克服的"
    },
    {
      "end": 7576.2,
      "start": 7575.1,
      "text": "心不为所动"
    },
    {
      "end": 7577.6,
      "start": 7576.2,
      "text": "然后做出冷静的判断"
    },
    {
      "end": 7578.7,
      "start": 7577.6,
      "text": "这是老弟这四年"
    },
    {
      "end": 7581.6,
      "start": 7578.7,
      "text": "我给您学习的最重要的一些东西"
    },
    {
      "end": 7583.1,
      "start": 7581.6,
      "text": "包括遇到压力面前"
    },
    {
      "end": 7585.1,
      "start": 7583.1,
      "text": "那个抵抗压力走过来"
    },
    {
      "end": 7587.3,
      "start": 7585.1,
      "text": "我也否则我也不可能走到今天"
    },
    {
      "end": 7589.1,
      "start": 7587.3,
      "text": "早被九指腰给那个了"
    },
    {
      "end": 7590.7,
      "start": 7589.1,
      "text": "他说七哥给灭了"
    },
    {
      "end": 7591.1,
      "start": 7590.7,
      "text": "对"
    },
    {
      "end": 7592.9,
      "start": 7591.1,
      "text": "其实我想说什么呢"
    },
    {
      "end": 7596.0,
      "start": 7592.9,
      "text": "就是说这四年刚才七哥分享的"
    },
    {
      "end": 7597.4,
      "start": 7596.0,
      "text": "我觉得是每一个爆料革命战友"
    },
    {
      "end": 7599.1,
      "start": 7597.4,
      "text": "都在成长和学习的"
    },
    {
      "end": 7601.7,
      "start": 7599.1,
      "text": "咱们爆料革命不是说一步登天的"
    },
    {
      "end": 7602.2,
      "start": 7601.7,
      "text": "但是呢"
    },
    {
      "end": 7603.1,
      "start": 7602.2,
      "text": "在这个过程里头"
    },
    {
      "end": 7604.9,
      "start": 7603.1,
      "text": "我们要看到自己的这个价值"
    },
    {
      "end": 7605.5,
      "start": 7604.9,
      "text": "是吧"
    },
    {
      "end": 7606.1,
      "start": 7605.5,
      "text": "咱们的"
    },
    {
      "end": 7607.2,
      "start": 7606.1,
      "text": "你说还有什么"
    },
    {
      "end": 7608.7,
      "start": 7607.2,
      "text": "咱们作为男战友"
    },
    {
      "end": 7611.5,
      "start": 7608.7,
      "text": "有比七哥跟我们眼前最好的一个榜样了"
    },
    {
      "end": 7612.0,
      "start": 7611.5,
      "text": "是吧"
    },
    {
      "end": 7612.5,
      "start": 7612.0,
      "text": "从穿着"
    },
    {
      "end": 7617.5,
      "start": 7612.5,
      "text": "从这个气质和西方政商两界的这个这么多年的一个合作"
    },
    {
      "end": 7618.9,
      "start": 7617.5,
      "text": "这就像我一直说的"
    },
    {
      "end": 7621.4,
      "start": 7618.9,
      "text": "咱们爆料革命战友真的要对自己有信心"
    },
    {
      "end": 7623.3,
      "start": 7621.4,
      "text": "爆料革命靠的是实力"
    },
    {
      "end": 7624.2,
      "start": 7623.3,
      "text": "不是靠嘴"
    },
    {
      "end": 7625.2,
      "start": 7624.2,
      "text": "不是靠表演"
    },
    {
      "end": 7626.7,
      "start": 7625.2,
      "text": "我们不是当明星当演员的"
    },
    {
      "end": 7627.6,
      "start": 7626.7,
      "text": "这是爆料的"
    },
    {
      "end": 7628.9,
      "start": 7627.6,
      "text": "这是跟共产党拼命的"
    },
    {
      "end": 7629.6,
      "start": 7628.9,
      "text": "所以呢"
    },
    {
      "end": 7631.3,
      "start": 7629.6,
      "text": "我今天听到七哥上面的"
    },
    {
      "end": 7631.8,
      "start": 7631.3,
      "text": "我觉得呢"
    },
    {
      "end": 7633.0,
      "start": 7631.8,
      "text": "就老弟从我来讲"
    },
    {
      "end": 7634.4,
      "start": 7633.0,
      "text": "我觉得更加扎实"
    },
    {
      "end": 7635.2,
      "start": 7634.4,
      "text": "咱们呢"
    },
    {
      "end": 7636.6,
      "start": 7635.2,
      "text": "那个这个对吧"
    },
    {
      "end": 7638.0,
      "start": 7636.6,
      "text": "咱们叫叫高调做事"
    },
    {
      "end": 7638.8,
      "start": 7638.0,
      "text": "低调做人"
    },
    {
      "end": 7640.3,
      "start": 7638.8,
      "text": "在爆料革命的这个队伍里呢"
    },
    {
      "end": 7642.6,
      "start": 7640.3,
      "text": "多向那个身边的兄弟姐妹战友们学习"
    },
    {
      "end": 7644.0,
      "start": 7642.6,
      "text": "能人都在战友当中"
    },
    {
      "end": 7646.0,
      "start": 7644.0,
      "text": "他们只是因为各种原因"
    },
    {
      "end": 7647.0,
      "start": 7646.0,
      "text": "没有发生"
    },
    {
      "end": 7648.6,
      "start": 7647.0,
      "text": "还有那么多科学家是吧"
    },
    {
      "end": 7650.7,
      "start": 7648.6,
      "text": "给七哥提供那个体制内消息的"
    },
    {
      "end": 7651.7,
      "start": 7650.7,
      "text": "千千万万的"
    },
    {
      "end": 7654.3,
      "start": 7651.7,
      "text": "我也相信现在在镜头前"
    },
    {
      "end": 7656.0,
      "start": 7654.3,
      "text": "公检法的兄弟姐妹们对吧"
    },
    {
      "end": 7657.7,
      "start": 7656.0,
      "text": "很多人都支持七哥"
    },
    {
      "end": 7658.6,
      "start": 7657.7,
      "text": "都明镜了"
    },
    {
      "end": 7660.7,
      "start": 7658.6,
      "text": "心里都明白这帮王八蛋是什么东西"
    },
    {
      "end": 7661.8,
      "start": 7660.7,
      "text": "就像七哥说的"
    },
    {
      "end": 7662.8,
      "start": 7661.8,
      "text": "这样的人"
    },
    {
      "end": 7664.3,
      "start": 7662.8,
      "text": "能控制政法委"
    },
    {
      "end": 7665.9,
      "start": 7664.3,
      "text": "控制这个国家安全"
    },
    {
      "end": 7667.2,
      "start": 7665.9,
      "text": "控制国家外事"
    },
    {
      "end": 7668.8,
      "start": 7667.2,
      "text": "还管着天大的钱"
    },
    {
      "end": 7669.2,
      "start": 7668.8,
      "text": "是吧"
    },
    {
      "end": 7670.4,
      "start": 7669.2,
      "text": "然后还还说什么"
    },
    {
      "end": 7672.7,
      "start": 7670.4,
      "text": "这个为人民公安为人民"
    },
    {
      "end": 7675.4,
      "start": 7672.7,
      "text": "我相信今天看到的这个节目的"
    },
    {
      "end": 7676.8,
      "start": 7675.4,
      "text": "听到七哥说话的"
    },
    {
      "end": 7678.8,
      "start": 7676.8,
      "text": "公检法的兄弟姐妹们"
    },
    {
      "end": 7680.5,
      "start": 7678.8,
      "text": "绝对心里头会"
    },
    {
      "end": 7681.4,
      "start": 7680.5,
      "text": "黑白"
    },
    {
      "end": 7682.1,
      "start": 7681.4,
      "text": "敬畏分明"
    },
    {
      "end": 7682.8,
      "start": 7682.1,
      "text": "黑白两边"
    },
    {
      "end": 7683.7,
      "start": 7682.8,
      "text": "站得很清楚"
    },
    {
      "end": 7685.6,
      "start": 7683.7,
      "text": "只是等待那个时机而已"
    },
    {
      "end": 7686.2,
      "start": 7685.6,
      "text": "对吧"
    },
    {
      "end": 7686.6,
      "start": 7686.2,
      "text": "所以呢"
    },
    {
      "end": 7688.3,
      "start": 7686.6,
      "text": "我觉得对于我们战友们"
    },
    {
      "end": 7689.1,
      "start": 7688.3,
      "text": "自信"
    },
    {
      "end": 7690.0,
      "start": 7689.1,
      "text": "自强"
    },
    {
      "end": 7690.5,
      "start": 7690.0,
      "text": "然后呢"
    },
    {
      "end": 7691.5,
      "start": 7690.5,
      "text": "我们要不断的学习"
    },
    {
      "end": 7692.3,
      "start": 7691.5,
      "text": "不断的进步"
    },
    {
      "end": 7694.0,
      "start": 7692.3,
      "text": "没有什么比我们扎扎实实"
    },
    {
      "end": 7694.9,
      "start": 7694.0,
      "text": "做好每一步"
    },
    {
      "end": 7696.3,
      "start": 7694.9,
      "text": "眼前的能做好"
    },
    {
      "end": 7696.8,
      "start": 7696.3,
      "text": "珍惜"
    },
    {
      "end": 7698.9,
      "start": 7696.8,
      "text": "每一个能拥有的更重要的"
    },
    {
      "end": 7700.1,
      "start": 7698.9,
      "text": "而不是好高无远"
    },
    {
      "end": 7701.4,
      "start": 7700.1,
      "text": "而不是这个这个"
    },
    {
      "end": 7702.5,
      "start": 7701.4,
      "text": "急于求成"
    },
    {
      "end": 7704.2,
      "start": 7702.5,
      "text": "这个趋功近利"
    },
    {
      "end": 7705.9,
      "start": 7704.2,
      "text": "这就是我的一点看法吧"
    },
    {
      "end": 7706.4,
      "start": 7705.9,
      "text": "这就是我的一点看法吧"
    },
    {
      "end": 7709.4,
      "start": 7706.4,
      "text": "更多的是一些心灵上的感悟嘛"
    },
    {
      "end": 7710.2,
      "start": 7709.4,
      "text": "谢谢七哥"
    },
    {
      "end": 7710.8,
      "start": 7710.2,
      "text": "谢谢这样的"
    },
    {
      "end": 7744.18,
      "start": 7740.8,
      "text": "还有一个我们不要光去想我们将来会得到什么"
    },
    {
      "end": 7746.34,
      "start": 7744.18,
      "text": "要看到自己现在已经得到了什么"
    },
    {
      "end": 7748.84,
      "start": 7746.34,
      "text": "从我自己个人来说过去这四年"
    },
    {
      "end": 7750.32,
      "start": 7748.84,
      "text": "我真的学习了很多东西"
    },
    {
      "end": 7751.34,
      "start": 7750.32,
      "text": "至少我开智了"
    },
    {
      "end": 7753.1,
      "start": 7751.34,
      "text": "我能够学会去分析"
    },
    {
      "end": 7754.2,
      "start": 7753.1,
      "text": "用自己的思维"
    },
    {
      "end": 7756.06,
      "start": 7754.2,
      "text": "自己的一些逻辑去分析事情"
    },
    {
      "end": 7757.98,
      "start": 7756.06,
      "text": "而且我们在这个过程中"
    },
    {
      "end": 7760.16,
      "start": 7757.98,
      "text": "就从疫苗病毒开始到现在开始"
    },
    {
      "end": 7761.34,
      "start": 7760.16,
      "text": "我们躲过了病毒"
    },
    {
      "end": 7762.28,
      "start": 7761.34,
      "text": "我们躲过了疫苗"
    },
    {
      "end": 7763.82,
      "start": 7762.28,
      "text": "这都是我们现在获得的"
    },
    {
      "end": 7765.36,
      "start": 7763.82,
      "text": "而且有些东西它不是"
    },
    {
      "end": 7768.34,
      "start": 7765.36,
      "text": "而且还要看到现在全球的经济危机"
    },
    {
      "end": 7769.84,
      "start": 7768.34,
      "text": "因为我过去也查了一些"
    },
    {
      "end": 7773.1,
      "start": 7769.84,
      "text": "从20年代的德国二战以前"
    },
    {
      "end": 7775.24,
      "start": 7773.1,
      "text": "包括美国的经济大萧条的时候"
    },
    {
      "end": 7778.58,
      "start": 7775.24,
      "text": "那整个的货币的贬值都会贬值到"
    },
    {
      "end": 7781.36,
      "start": 7778.58,
      "text": "我们看到过津巴布韦"
    },
    {
      "end": 7782.54,
      "start": 7781.36,
      "text": "看到过委内瑞拉"
    },
    {
      "end": 7783.76,
      "start": 7782.54,
      "text": "所有的这些贬值"
    },
    {
      "end": 7785.62,
      "start": 7783.76,
      "text": "这是一个非常大的一个危险"
    },
    {
      "end": 7788.9,
      "start": 7785.62,
      "text": "那么我们保值就已经是很大的一块了"
    },
    {
      "end": 7790.18,
      "start": 7788.9,
      "text": "还不要说以后的一个增值"
    },
    {
      "end": 7791.16,
      "start": 7790.18,
      "text": "所以我们真的是要"
    },
    {
      "end": 7793.58,
      "start": 7791.16,
      "text": "真的感恩自己每一天所获得的"
    },
    {
      "end": 7794.38,
      "start": 7793.58,
      "text": "已经得到的"
    },
    {
      "end": 7796.48,
      "start": 7794.38,
      "text": "能够静下心来一件一件的做事情"
    },
    {
      "end": 7798.44,
      "start": 7796.48,
      "text": "一天一天的去把这个事情做到了"
    },
    {
      "end": 7800.06,
      "start": 7798.44,
      "text": "它的结果是必然的"
    },
    {
      "end": 7801.44,
      "start": 7800.06,
      "text": "但是绝对不能心急"
    },
    {
      "end": 7802.54,
      "start": 7801.44,
      "text": "不能做到那梦想"
    },
    {
      "end": 7804.84,
      "start": 7802.54,
      "text": "也不能说明天这个事情就一定会发生"
    },
    {
      "end": 7809.0,
      "start": 7804.84,
      "text": "我觉得跟随七哥这几年"
    },
    {
      "end": 7811.24,
      "start": 7809.0,
      "text": "七哥就17年就已经说了"
    },
    {
      "end": 7813.02,
      "start": 7811.24,
      "text": "恒大一定会出这个问题"
    },
    {
      "end": 7813.8,
      "start": 7813.02,
      "text": "一定会倒掉"
    },
    {
      "end": 7814.74,
      "start": 7813.8,
      "text": "而且会倒得很惨"
    },
    {
      "end": 7816.96,
      "start": 7814.74,
      "text": "那就是基于它对这个事情的基础"
    },
    {
      "end": 7818.24,
      "start": 7816.96,
      "text": "基本的一个判断"
    },
    {
      "end": 7820.68,
      "start": 7818.24,
      "text": "那我们对共产党的这个倒台也是一个基本判断"
    },
    {
      "end": 7821.56,
      "start": 7820.68,
      "text": "它一定会倒"
    },
    {
      "end": 7822.84,
      "start": 7821.56,
      "text": "只是说什么都倒"
    },
    {
      "end": 7824.24,
      "start": 7822.84,
      "text": "但是作为我们来说"
    },
    {
      "end": 7825.6,
      "start": 7824.24,
      "text": "我们要有这个坚定的信念"
    },
    {
      "end": 7827.04,
      "start": 7825.6,
      "text": "而且静下心来"
    },
    {
      "end": 7828.32,
      "start": 7827.04,
      "text": "一天一天做自己的事情"
    },
    {
      "end": 7829.84,
      "start": 7828.32,
      "text": "不管是从一个直播开始"
    },
    {
      "end": 7831.52,
      "start": 7829.84,
      "text": "还是从一个盖文开始"
    },
    {
      "end": 7832.76,
      "start": 7831.52,
      "text": "只有你自己做到了"
    },
    {
      "end": 7834.24,
      "start": 7832.76,
      "text": "它那个必然结果一定会出现"
    },
    {
      "end": 7837.2,
      "start": 7834.24,
      "text": "而且比我们可能真正预期的还要再早一些"
    },
    {
      "end": 7837.76,
      "start": 7837.2,
      "text": "谢谢"
    },
    {
      "end": 7841.48,
      "start": 7837.76,
      "text": "谢谢清澄"
    },
    {
      "end": 7842.72,
      "start": 7841.48,
      "text": "然后"
    },
    {
      "end": 7845.8,
      "start": 7842.72,
      "text": "有请我们的安米丽"
    },
    {
      "end": 7849.04,
      "start": 7845.8,
      "text": "好的"
    },
    {
      "end": 7851.58,
      "start": 7849.04,
      "text": "就是刚刚听完七哥讲的"
    },
    {
      "end": 7853.58,
      "start": 7851.58,
      "text": "她说的这些特质"
    },
    {
      "end": 7854.96,
      "start": 7853.58,
      "text": "好像就是以前的我"
    },
    {
      "end": 7857.06,
      "start": 7854.96,
      "text": "我就是那种很心急的个性"
    },
    {
      "end": 7858.46,
      "start": 7857.06,
      "text": "每天都想着"
    },
    {
      "end": 7860.4,
      "start": 7858.46,
      "text": "为什么共产党还不倒"
    },
    {
      "end": 7862.42,
      "start": 7860.4,
      "text": "那就是"
    },
    {
      "end": 7865.88,
      "start": 7862.42,
      "text": "以前我是比较关心这个台湾的政治"
    },
    {
      "end": 7868.1,
      "start": 7865.88,
      "text": "然后每次新闻爆出来"
    },
    {
      "end": 7869.14,
      "start": 7868.1,
      "text": "我们就发现"
    },
    {
      "end": 7871.6,
      "start": 7869.14,
      "text": "所谓一些不公不义的事情的时候"
    },
    {
      "end": 7872.94,
      "start": 7871.6,
      "text": "我们就会去关注它"
    },
    {
      "end": 7874.94,
      "start": 7872.94,
      "text": "可是我们有一些缺点就是"
    },
    {
      "end": 7877.12,
      "start": 7874.94,
      "text": "当新闻过去没多久之后"
    },
    {
      "end": 7879.8,
      "start": 7877.12,
      "text": "我们可能就会把这些事情就遗忘了"
    },
    {
      "end": 7881.72,
      "start": 7879.8,
      "text": "那最后呢"
    },
    {
      "end": 7884.32,
      "start": 7881.72,
      "text": "因为这个香港反重中的事情"
    },
    {
      "end": 7885.22,
      "start": 7884.32,
      "text": "让我发现说"
    },
    {
      "end": 7886.6,
      "start": 7885.22,
      "text": "其实台湾的政治呢"
    },
    {
      "end": 7889.58,
      "start": 7886.6,
      "text": "跟这个共产党有很大很大的一个牵连"
    },
    {
      "end": 7890.58,
      "start": 7889.58,
      "text": "我才发现说"
    },
    {
      "end": 7894.1,
      "start": 7890.58,
      "text": "共产党才是这个背后最大的一个魔王"
    },
    {
      "end": 7897.0,
      "start": 7894.1,
      "text": "所以呢我就回来再去审视"
    },
    {
      "end": 7898.54,
      "start": 7897.0,
      "text": "这个台湾的这个政治"
    },
    {
      "end": 7899.84,
      "start": 7898.54,
      "text": "还有这个媒体啊"
    },
    {
      "end": 7900.86,
      "start": 7899.84,
      "text": "发现就是说"
    },
    {
      "end": 7902.7,
      "start": 7900.86,
      "text": "这真的像七哥讲的这样子"
    },
    {
      "end": 7904.94,
      "start": 7902.7,
      "text": "因为台湾的这个节目啊"
    },
    {
      "end": 7907.48,
      "start": 7904.94,
      "text": "它其实只是为了吸引人家的眼球"
    },
    {
      "end": 7909.54,
      "start": 7907.48,
      "text": "所以它其实并不是那么的一个"
    },
    {
      "end": 7910.84,
      "start": 7909.54,
      "text": "专业的去讲解"
    },
    {
      "end": 7913.74,
      "start": 7910.84,
      "text": "那这个媒体也是啊"
    },
    {
      "end": 7916.4,
      "start": 7913.74,
      "text": "那基本上真的就是被共产党控制"
    },
    {
      "end": 7918.62,
      "start": 7916.4,
      "text": "所以回答刚刚七哥问的问题"
    },
    {
      "end": 7920.0,
      "start": 7918.62,
      "text": "就是说如果真的"
    },
    {
      "end": 7923.02,
      "start": 7920.0,
      "text": "媒体去把这些新闻"
    },
    {
      "end": 7924.78,
      "start": 7923.02,
      "text": "疫苗的这个灾难的新闻"
    },
    {
      "end": 7925.88,
      "start": 7924.78,
      "text": "真的放出来的话"
    },
    {
      "end": 7927.58,
      "start": 7925.88,
      "text": "我是比较悲观的"
    },
    {
      "end": 7928.5,
      "start": 7927.58,
      "text": "觉得是说"
    },
    {
      "end": 7930.7,
      "start": 7928.5,
      "text": "他们可能掩盖不住了"
    },
    {
      "end": 7931.98,
      "start": 7930.7,
      "text": "但是他们想要做一些"
    },
    {
      "end": 7933.74,
      "start": 7931.98,
      "text": "额外的去拟补"
    },
    {
      "end": 7937.04,
      "start": 7933.74,
      "text": "或者是又要利用这些药去赚钱"
    },
    {
      "end": 7938.14,
      "start": 7937.04,
      "text": "然后顺便呢"
    },
    {
      "end": 7939.62,
      "start": 7938.14,
      "text": "把这个疫苗的灾难去"
    },
    {
      "end": 7942.52,
      "start": 7939.62,
      "text": "降低它的这个反弹的力道"
    },
    {
      "end": 7945.16,
      "start": 7942.52,
      "text": "那当然如果这些"
    },
    {
      "end": 7947.62,
      "start": 7945.16,
      "text": "因为这些人啊"
    },
    {
      "end": 7949.06,
      "start": 7947.62,
      "text": "就是看新闻媒体的人"
    },
    {
      "end": 7950.0,
      "start": 7949.06,
      "text": "而去吃药的人"
    },
    {
      "end": 7952.72,
      "start": 7950.0,
      "text": "如果他们因为疫苗的问题"
    },
    {
      "end": 7953.66,
      "start": 7952.72,
      "text": "然后呢"
    },
    {
      "end": 7955.08,
      "start": 7953.66,
      "text": "可以得到缓解的话"
    },
    {
      "end": 7957.62,
      "start": 7955.08,
      "text": "我认为可能还是一件好事情"
    },
    {
      "end": 7960.04,
      "start": 7957.62,
      "text": "那再来再看到就是说"
    },
    {
      "end": 7963.68,
      "start": 7960.04,
      "text": "这个整个我们自己啊"
    },
    {
      "end": 7967.96,
      "start": 7963.68,
      "text": "有时候要先去看自己的问题在哪里"
    },
    {
      "end": 7970.76,
      "start": 7967.96,
      "text": "然后你知道自己的错误在哪里的时候"
    },
    {
      "end": 7973.04,
      "start": 7970.76,
      "text": "你才有办法去做一个改进"
    },
    {
      "end": 7974.86,
      "start": 7973.04,
      "text": "那我现在也知道就是说"
    },
    {
      "end": 7977.12,
      "start": 7974.86,
      "text": "我真的我们真的不能心急"
    },
    {
      "end": 7977.7,
      "start": 7977.12,
      "text": "然后呢"
    },
    {
      "end": 7981.7,
      "start": 7977.7,
      "text": "尽量就是能够做好自己现在该做的事情"
    },
    {
      "end": 7982.84,
      "start": 7981.7,
      "text": "我觉得就是一个"
    },
    {
      "end": 7985.08,
      "start": 7982.84,
      "text": "就像我现在我也没有想过说"
    },
    {
      "end": 7987.1,
      "start": 7985.08,
      "text": "我可以在这边跟七哥直播"
    },
    {
      "end": 7990.92,
      "start": 7987.1,
      "text": "然后我觉得现在就是尽力做好"
    },
    {
      "end": 7991.88,
      "start": 7990.92,
      "text": "自己该做的事情"
    },
    {
      "end": 7994.54,
      "start": 7991.88,
      "text": "我就觉得自己已经是很大的进步了"
    },
    {
      "end": 7995.8,
      "start": 7994.54,
      "text": "谢谢七哥"
    },
    {
      "end": 7996.54,
      "start": 7995.8,
      "text": "对"
    },
    {
      "end": 8000.3,
      "start": 7996.54,
      "text": "好谢谢艾米妮"
    },
    {
      "end": 8002.46,
      "start": 8000.3,
      "text": "谢谢"
    },
    {
      "end": 8008.18,
      "start": 8002.46,
      "text": "我自己反正大家都看得出来"
    },
    {
      "end": 8009.7,
      "start": 8008.18,
      "text": "我这个人性格很跳脱"
    },
    {
      "end": 8011.02,
      "start": 8009.7,
      "text": "然后想一出试一出"
    },
    {
      "end": 8012.78,
      "start": 8011.02,
      "text": "然后以前想一想"
    },
    {
      "end": 8014.38,
      "start": 8012.78,
      "text": "基本上听七哥讲讲"
    },
    {
      "end": 8015.38,
      "start": 8014.38,
      "text": "又压回去一点"
    },
    {
      "end": 8016.86,
      "start": 8015.38,
      "text": "现在是不等直播"
    },
    {
      "end": 8018.52,
      "start": 8016.86,
      "text": "就有可能在这个直播前"
    },
    {
      "end": 8019.34,
      "start": 8018.52,
      "text": "就七哥说"
    },
    {
      "end": 8020.8,
      "start": 8019.34,
      "text": "你怎么缺心眼啊"
    },
    {
      "end": 8022.12,
      "start": 8020.8,
      "text": "然后又被压抑啊"
    },
    {
      "end": 8025.7,
      "start": 8022.12,
      "text": "然后这个我老公一直跟我说的"
    },
    {
      "end": 8027.34,
      "start": 8025.7,
      "text": "他说这个赚得到的"
    },
    {
      "end": 8029.96,
      "start": 8027.34,
      "text": "就是赚得越晚的钱一定是大钱"
    },
    {
      "end": 8033.18,
      "start": 8029.96,
      "text": "所以那我觉得这个反过来说"
    },
    {
      "end": 8034.72,
      "start": 8033.18,
      "text": "这个爆料革命这件事情啊"
    },
    {
      "end": 8040.28,
      "start": 8034.72,
      "text": "这事情那么大肯定是需要时间和这个各种各样的奇迹去酝酿的"
    },
    {
      "end": 8042.66,
      "start": 8040.28,
      "text": "然后刚刚艾米妮又提到这个媒体的事情"
    },
    {
      "end": 8046.0,
      "start": 8042.66,
      "text": "我们觉得说这个我们现在也在做媒体"
    },
    {
      "end": 8048.44,
      "start": 8046.0,
      "text": "所以这个我们既然有一个好的开始"
    },
    {
      "end": 8050.16,
      "start": 8048.44,
      "text": "我们就要做有良心的媒体"
    },
    {
      "end": 8054.58,
      "start": 8050.16,
      "text": "能够真正的是帮助到说大家能够获得准确和真实的消息"
    },
    {
      "end": 8058.18,
      "start": 8054.58,
      "text": "那然后刚刚这个七哥讲到那个停电的问题"
    },
    {
      "end": 8059.62,
      "start": 8058.18,
      "text": "我问题又来了"
    },
    {
      "end": 8061.88,
      "start": 8059.62,
      "text": "这个我先猜一猜吧"
    },
    {
      "end": 8064.3,
      "start": 8061.88,
      "text": "这个停电如果他们是有计划的"
    },
    {
      "end": 8068.84,
      "start": 8064.3,
      "text": "是不是说是因为是想对世界的经济有所影响"
    },
    {
      "end": 8072.82,
      "start": 8068.84,
      "text": "这个我知道我可能又没有打在这个点上"
    },
    {
      "end": 8075.88,
      "start": 8072.82,
      "text": "那七哥不知道会接下去会不会跟我们分享一下"
    },
    {
      "end": 8077.58,
      "start": 8075.88,
      "text": "好感谢大家"
    },
    {
      "end": 8080.34,
      "start": 8077.58,
      "text": "感谢感谢啊"
    },
    {
      "end": 8083.94,
      "start": 8080.34,
      "text": "感谢这个两位美女两位帅哥说的"
    },
    {
      "end": 8085.96,
      "start": 8083.94,
      "text": "今天我觉得咱们是大直播以来"
    },
    {
      "end": 8088.38,
      "start": 8085.96,
      "text": "我觉得是咱们互动的质量最高的一次"
    },
    {
      "end": 8089.72,
      "start": 8088.38,
      "text": "所以这就是进步"
    },
    {
      "end": 8094.74,
      "start": 8089.72,
      "text": "时间是积累成功和收获的必备的条件"
    },
    {
      "end": 8098.34,
      "start": 8094.74,
      "text": "很多战友说灭共留给下一代"
    },
    {
      "end": 8099.3,
      "start": 8098.34,
      "text": "我绝对不会的"
    },
    {
      "end": 8100.18,
      "start": 8099.3,
      "text": "我要告诉大家"
