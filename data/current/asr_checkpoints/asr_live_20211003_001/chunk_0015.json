    {
      "end": 14147.2,
      "start": 14145.2,
      "text": "找什么这讲那讲"
    },
    {
      "end": 14148.2,
      "start": 14147.2,
      "text": "扯王八族的事"
    },
    {
      "end": 14149.2,
      "start": 14148.2,
      "text": "现在是几大家族"
