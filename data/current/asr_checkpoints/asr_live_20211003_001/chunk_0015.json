      "text": "所以"
    },
    {
      "end": 14035.2,
      "start": 14033.2,
      "text": "谢谢大卫哥"
    },
    {
      "end": 14036.2,
      "start": 14035.2,
      "text": "谢谢郭先生"
    },
    {
      "end": 14039.2,
      "start": 14036.2,
      "text": "然后清腾你有什么要分享的吗"
    },
    {
      "end": 14045.2,
      "start": 14039.2,
      "text": "好我就说一下就是刚才七哥让我们查的这个数据"
