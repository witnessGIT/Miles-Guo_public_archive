    {
      "end": 14292.2,
      "start": 14286.2,
      "text": "我这有监测的"
    },
    {
      "end": 14297.2,
      "start": 14292.2,
      "text": "佐马太厉害了"
    },
    {
      "end": 14298.2,
      "start": 14297.2,
      "text": "你这个佐马要好好珍惜啊"
    },
    {
      "end": 14299.2,
