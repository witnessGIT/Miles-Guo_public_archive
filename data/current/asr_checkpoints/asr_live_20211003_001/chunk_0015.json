    {
      "end": 14355.2,
      "start": 14354.2,
      "text": "我说你都会爱"
    },
    {
      "end": 14356.2,
      "start": 14355.2,
      "text": "这是当时我来看守所"
    },
    {
      "end": 14357.2,
      "start": 14356.2,
      "text": "我给你们讲过的故事"
    },
    {
      "end": 14358.2,
      "start": 14357.2,
      "text": "问过"
    },
    {
      "end": 14360.2,
      "start": 14358.2,
      "text": "一个人和动物和猪"
    },
    {
      "end": 14361.2,
      "start": 14360.2,
      "text": "关在岛上的时候"
    },
    {
      "end": 14362.2,
      "start": 14361.2,
      "text": "他都会产生爱情"
    },
    {
      "end": 14363.2,
      "start": 14362.2,
      "text": "因为他没有选择"
    },
    {
      "end": 14365.2,
      "start": 14363.2,
      "text": "他总不能跟数据性交去"
    },
    {
      "end": 14366.2,
      "start": 14365.2,
      "text": "是吧"
    },
    {
      "end": 14368.2,
      "start": 14366.2,
      "text": "日久生情"
    },
