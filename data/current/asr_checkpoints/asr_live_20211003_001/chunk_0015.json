      "text": "不但跟你一点亲也没有"
    },
    {
      "end": 14332.2,
      "start": 14330.2,
      "text": "啥叫亲近呢"
    },
    {
      "end": 14334.2,
      "start": 14332.2,
      "text": "亲就是有血缘关系"
    },
    {
      "end": 14335.2,
      "start": 14334.2,
      "text": "近就是你身边的人"
    },
    {
      "end": 14336.2,
      "start": 14335.2,
      "text": "任何一个人"
    },
    {
      "end": 14337.2,
      "start": 14336.2,
      "text": "记住你想明白"
    },
    {
      "end": 14338.2,
      "start": 14337.2,
      "text": "一个人"
