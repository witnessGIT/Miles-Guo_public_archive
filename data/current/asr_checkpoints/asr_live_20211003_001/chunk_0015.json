    {
      "end": 14254.2,
      "start": 14253.2,
      "text": "给中国人干好事"
    },
    {
      "end": 14255.2,
      "start": 14254.2,
      "text": "不能让他们干坏事"
    },
    {
      "end": 14257.2,
      "start": 14255.2,
      "text": "谢谢京城"
    },
    {
      "end": 14258.2,
      "start": 14257.2,
      "text": "刚才什么玩意儿"
    },
    {
      "end": 14259.2,
      "start": 14258.2,
      "text": "撕拉撕拉老响"
    },
    {
      "end": 14261.2,
      "start": 14259.2,
      "text": "跟尿尿声音似的"
    },
    {
      "end": 14263.2,
      "start": 14261.2,
      "text": "是不是你们都想屁屁一下子了"
    },
    {
      "end": 14264.2,
      "start": 14263.2,
      "text": "咱们是不是都分别"
    },
    {
      "end": 14266.2,
      "start": 14264.2,
      "text": "都静下虚手间屁屁下去"
    },
    {
      "end": 14270.2,
      "start": 14266.2,
      "text": "你这边越来越来越做越困难"
    },
    {
      "end": 14271.2,
      "start": 14270.2,
      "text": "你这边越来越来越困难"
