{
  "chunk_audio_sha256": "e4a542f2e6bafc950d6c50bc23eb98d181d05e2ac4ccb114c58a8ab81673a165",
  "chunk_index": 6,
  "completed_at": "2026-10-20T14:11:07Z",
  "language": "zh",
  "live_id": "LIVE_20211003_001",
  "media_committed_to_git": false,
