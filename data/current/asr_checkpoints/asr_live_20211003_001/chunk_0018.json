    {
      "end": 16473.72,
      "start": 16473.48,
      "text": "赞助你"
    },
    {
      "end": 16475.0,
      "start": 16473.98,
      "text": "但是你要给我出证明"
    },
    {
      "end": 16476.28,
      "start": 16475.26,
      "text": "我们是一个在海外"
    },
    {
      "end": 16477.56,
      "start": 16476.54,
      "text": "为中国征求自由的"
    },
    {
      "end": 16478.84,
      "start": 16477.82,
      "text": "然后把这历史一说"
    },
    {
      "end": 16480.12,
      "start": 16479.1,
      "text": "哎他愿意出啊"
    },
    {
      "end": 16480.9,
      "start": 16480.64,
      "text": "是吧"
    },
    {
      "end": 16481.92,
      "start": 16481.4,
      "text": "我说出啊"
    },
    {
      "end": 16484.48,
      "start": 16482.68,
      "text": "一下子50多个机构要给我们出"
    },
    {
      "end": 16486.02,
      "start": 16485.5,
      "text": "拿过去"
    },
    {
      "end": 16487.04,
      "start": 16486.78,
      "text": "是不是"
    },
    {
      "end": 16488.32,
      "start": 16487.04,
      "text": "都是你的所谓的NGO"
    },
    {
      "end": 16489.08,
      "start": 16488.32,
      "text": "认识的"
    },
    {
      "end": 16491.64,
      "start": 16490.12,
      "text": "我不行再给你弄50个"
    },
    {
      "end": 16493.7,
      "start": 16493.18,
      "text": "多少钱"
    },
    {
      "end": 16497.02,
      "start": 16493.96,
      "text": "1000美金到3000美金出一张纸"
    },
    {
      "end": 16500.36,
      "start": 16498.56,
      "text": "就可以买一个新中国联邦"
    },
    {
      "end": 16502.92,
      "start": 16500.86,
      "text": "一张纸不就是几十万美元吗"
    },
    {
      "end": 16504.96,
      "start": 16503.94,
      "text": "几十万美元吗"
    },
    {
      "end": 16506.5,
      "start": 16505.22,
      "text": "不超过100万美元"
    },
    {
      "end": 16507.26,
      "start": 16506.76,
      "text": "你就所谓的"
    },
    {
      "end": 16508.28,
      "start": 16507.52,
      "text": "这都是虚假的"
    },
    {
      "end": 16510.08,
      "start": 16508.54,
      "text": "骗人的所谓的合法性"
    },
    {
      "end": 16511.88,
      "start": 16511.1,
      "text": "就像那个"
    },
    {
      "end": 16513.4,
      "start": 16512.38,
      "text": "法国正常说"
    },
    {
      "end": 16515.96,
      "start": 16513.66,
      "text": "郭文贵所说的疫苗灾难没有任何证据"
    },
    {
      "end": 16516.72,
      "start": 16515.96,
      "text": "听得多有道理啊"
    },
    {
      "end": 16518.52,
      "start": 16516.98,
      "text": "听得多有道理啊"
    },
    {
      "end": 16519.54,
      "start": 16519.04,
      "text": "还有那些记者"
    },
    {
      "end": 16520.32,
      "start": 16519.8,
      "text": "通常前"
    },
    {
      "end": 16521.34,
      "start": 16520.82,
      "text": "一个这个英国的"
    },
    {
      "end": 16523.64,
      "start": 16521.6,
      "text": "就是这个英国是最虚伪的国家啊"
    },
    {
      "end": 16524.66,
      "start": 16523.9,
      "text": "这个麻烦知道我"
    },
    {
      "end": 16525.18,
      "start": 16524.92,
      "text": "说"
    },
    {
      "end": 16527.74,
      "start": 16525.44,
      "text": "哎你郭文贵说疫苗灾难你有什么证据啊"
    },
    {
      "end": 16530.8,
      "start": 16529.02,
      "text": "我说那我现在我请问你一句话"
    },
    {
      "end": 16531.84,
      "start": 16531.58,
      "text": "啊"
    },
    {
      "end": 16533.88,
