    {
      "end": 16468.36,
      "start": 16466.82,
      "text": "我们就找这些机构"
    },
    {
      "end": 16470.14,
      "start": 16469.12,
      "text": "我们要赞助你"
    },
    {
      "end": 16471.94,
      "start": 16471.16,
