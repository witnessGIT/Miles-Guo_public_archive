    },
    {
      "end": 16538.74,
      "start": 16536.18,
      "text": "是哪来的你有证据吗"
    },
    {
      "end": 16539.26,
      "start": 16539.0,
      "text": "没有"
    },
    {
      "end": 16541.56,
      "start": 16540.78,
      "text": "有没有人"
