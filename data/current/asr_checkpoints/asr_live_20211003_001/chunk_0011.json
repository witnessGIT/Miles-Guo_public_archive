      "text": "是吧"
    },
    {
      "end": 10067.96,
      "start": 10066.96,
      "text": "在韩国"
    },
    {
      "end": 10070.96,
      "start": 10067.96,
      "text": "我最近这个韩国非常的近我不知道为啥了"
