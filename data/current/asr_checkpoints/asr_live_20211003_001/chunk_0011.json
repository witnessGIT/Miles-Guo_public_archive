    },
    {
      "end": 10027.76,
      "start": 10026.56,
      "text": "绝对是这样子"
    },
    {
      "end": 10031.76,
      "start": 10027.76,
      "text": "他是一个合法的公益的代表中国人民的"
    },
    {
      "end": 10036.36,
      "start": 10031.76,
      "text": "推动政治议程和中国追求法治民主信仰自由议程的"
    },
    {
      "end": 10037.76,
      "start": 10036.36,
      "text": "根本的开始"
