    },
    {
      "end": 8793.26,
      "start": 8792.26,
      "text": "我让全世界在家呆着"
    },
    {
      "end": 8795.26,
      "start": 8793.26,
      "text": "没人敢问我疫苗哪来的"
    },
    {
      "end": 8797.26,
      "start": 8795.26,
      "text": "没人敢问我病毒哪来的"
    },
    {
      "end": 8798.26,
      "start": 8797.26,
      "text": "牛不牛"
    },
    {
      "end": 8799.26,
      "start": 8798.26,
      "text": "哦 腰部"
    },
    {
      "end": 8800.26,
      "start": 8799.26,
      "text": "从来没那么大声过"
    },
    {
      "end": 8801.38,
      "start": 8800.26,
      "text": "过去叫卖国部"
    },
    {
      "end": 8802.38,
      "start": 8801.38,
      "text": "现在已经叫枪国部"
    },
    {
      "end": 8803.14,
      "start": 8802.38,
      "text": "叫战狼部"
    },
    {
      "end": 8804.26,
      "start": 8803.14,
      "text": "战狼部"
    },
    {
      "end": 8806.26,
      "start": 8804.26,
      "text": "一切起源于俄罗斯"
    },
    {
      "end": 8809.38,
      "start": 8806.26,
      "text": "美国的软弱"
    },
    {
      "end": 8811.38,
      "start": 8809.38,
      "text": "华尔街的背叛"
    },
    {
      "end": 8812.38,
      "start": 8811.38,
      "text": "好莱坞"
    },
    {
      "end": 8814.38,
      "start": 8812.38,
      "text": "还有香港四大家族的标脸"
    },
    {
      "end": 8817.38,
      "start": 8814.38,
      "text": "整个这些促成了习的狂妄"
    },
    {
      "end": 8818.5,
      "start": 8817.38,
      "text": "当然"
    },
    {
      "end": 8819.5,
      "start": 8818.5,
      "text": "当然"
    },
    {
      "end": 8820.5,
      "start": 8819.5,
      "text": "对中国人是不是好事"
    },
    {
      "end": 8822.5,
      "start": 8820.5,
      "text": "对我们爆料革命这都是天大的好事"
    },
    {
      "end": 8824.66,
      "start": 8822.5,
      "text": "没他咱打不到这个境"
    },
    {
      "end": 8825.5,
      "start": 8824.66,
      "text": "灭不了共"
    },
    {
      "end": 8827.5,
      "start": 8825.5,
      "text": "你要胡锦涛这好人"
    },
    {
      "end": 8828.5,
      "start": 8827.5,
      "text": "江泽民下来"
    },
    {
      "end": 8830.5,
      "start": 8828.5,
      "text": "邓小平咱打灭老共"
    },
    {
      "end": 8831.5,
      "start": 8830.5,
      "text": "你灭不了共的"
    },
    {
      "end": 8832.5,
      "start": 8831.5,
      "text": "他中国人有钱有饭吃"
    },
    {
      "end": 8834.1,
      "start": 8832.5,
      "text": "灭啥共啊"
    },
    {
      "end": 8834.5,
      "start": 8834.1,
      "text": "把咱给灭了"
    },
    {
      "end": 8835.5,
      "start": 8834.5,
      "text": "是吧"
    },
    {
      "end": 8837.5,
      "start": 8835.5,
      "text": "就像昨天最后一个问我"
    },
    {
      "end": 8839.5,
      "start": 8837.5,
      "text": "说我的观点是"
    },
    {
      "end": 8840.5,
      "start": 8839.5,
      "text": "我说我坚决不希望习死"
    },
    {
      "end": 8843.22,
      "start": 8840.5,
      "text": "我希望习来把我给杀了"
    },
    {
      "end": 8844.78,
      "start": 8843.22,
      "text": "他说为什么这样"
    },
    {
      "end": 8846.5,
      "start": 8844.78,
      "text": "他杀了我我就成英雄了"
    },
    {
      "end": 8848.34,
      "start": 8846.5,
      "text": "谁杀习就把习变成英雄了"
    },
    {
      "end": 8849.54,
      "start": 8848.34,
      "text": "谁杀了我我就成英雄了"
    },
    {
      "end": 8850.5,
      "start": 8849.54,
      "text": "他来杀我了"
    },
    {
      "end": 8852.58,
      "start": 8850.5,
      "text": "这哥们佩服我佩服都不行了"
    },
    {
      "end": 8854.26,
      "start": 8852.58,
      "text": "你是什么美国华人"
    },
    {
      "end": 8855.22,
      "start": 8854.26,
      "text": "我说我再告诉你"
    },
    {
      "end": 8857.66,
      "start": 8855.22,
      "text": "习不用任何人杀"
    },
    {
      "end": 8859.3,
      "start": 8857.66,
      "text": "他自己会自杀"
    },
    {
      "end": 8861.14,
      "start": 8859.3,
      "text": "我和他不一样的结局"
    },
    {
      "end": 8862.86,
      "start": 8861.14,
      "text": "刚才话没跟你们说完"
    },
    {
      "end": 8863.98,
      "start": 8862.86,
      "text": "我说我跟他变成局"
    },
    {
      "end": 8864.9,
      "start": 8863.98,
      "text": "我不会自杀"
    },
    {
      "end": 8866.1,
      "start": 8864.9,
      "text": "他一定会自杀"
    },
    {
      "end": 8867.9,
      "start": 8866.1,
      "text": "他说为什么"
    },
    {
      "end": 8869.14,
      "start": 8867.9,
      "text": "为什么"
    },
    {
      "end": 8871.14,
      "start": 8869.14,
      "text": "因为他会打台湾"
    },
    {
      "end": 8874.46,
      "start": 8871.14,
      "text": "因为他会把中国的所有的有钱人"
    },
    {
      "end": 8875.74,
      "start": 8874.46,
      "text": "所以让他死得更惨"
    },
    {
      "end": 8878.22,
      "start": 8875.74,
      "text": "而且他会抓更多党员"
    },
    {
      "end": 8880.38,
      "start": 8878.22,
      "text": "或者习会找出"
    },
    {
      "end": 8882.3,
      "start": 8880.38,
      "text": "像萨达姆当年到英国"
    },
    {
      "end": 8883.78,
      "start": 8882.3,
      "text": "杀他的部长一样"
    },
    {
      "end": 8885.14,
      "start": 8883.78,
      "text": "第一次杀老婆"
    },
    {
      "end": 8886.06,
      "start": 8885.14,
      "text": "第二次把他给杀了"
    },
    {
      "end": 8887.5,
      "start": 8886.06,
      "text": "他不那么干"
    },
    {
      "end": 8888.78,
      "start": 8887.5,
      "text": "全世界"
    },
    {
      "end": 8890.32,
      "start": 8888.78,
      "text": "全世界"
    },
    {
      "end": 8892.78,
      "start": 8890.32,
      "text": "不可能灭了萨达姆"
    },
    {
      "end": 8896.24,
      "start": 8892.78,
      "text": "他不把他女婿的尸体"
    },
    {
      "end": 8897.34,
      "start": 8896.24,
      "text": "拖到巴格达"
    },
    {
      "end": 8898.8,
      "start": 8897.34,
      "text": "他不去英国去杀"
    },
    {
      "end": 8899.8,
      "start": 8898.8,
      "text": "他的部长"
    },
    {
      "end": 8901.08,
      "start": 8899.8,
      "text": "教育部长"
    },
    {
      "end": 8902.04,
      "start": 8901.08,
      "text": "不可能"
    },
    {
      "end": 8903.16,
      "start": 8902.04,
      "text": "他是副总统"
    },
    {
      "end": 8903.64,
      "start": 8903.16,
      "text": "当时是"
    },
    {
      "end": 8904.52,
      "start": 8903.64,
      "text": "他的副总统"
    },
    {
      "end": 8905.82,
      "start": 8904.52,
      "text": "他不可能"
    },
    {
      "end": 8906.68,
      "start": 8905.82,
      "text": "这是灭的"
    },
    {
      "end": 8907.52,
      "start": 8906.68,
      "text": "包括卡扎菲"
    },
    {
      "end": 8909.68,
      "start": 8907.52,
      "text": "卡扎菲当年不挑战美国"
    },
    {
      "end": 8911.04,
      "start": 8909.68,
      "text": "不支持恐怖主义分子"
    },
    {
      "end": 8912.68,
      "start": 8911.04,
      "text": "不可能"
    },
    {
      "end": 8913.8,
      "start": 8912.68,
      "text": "却干掉卡扎菲"
    },
    {
      "end": 8914.68,
      "start": 8913.8,
      "text": "当时李根说"
    },
    {
      "end": 8916.12,
      "start": 8914.68,
      "text": "必须把这小子灭了"
    },
    {
      "end": 8918.0,
      "start": 8916.12,
      "text": "我说现在习挑战美国"
    },
    {
      "end": 8919.8,
      "start": 8918.0,
      "text": "习就差了"
    },
    {
      "end": 8921.24,
      "start": 8919.8,
      "text": "把人给脱失在街头"
    },
    {
      "end": 8922.76,
      "start": 8921.24,
      "text": "把我爹扔到马路上去"
    },
    {
      "end": 8923.88,
      "start": 8922.76,
      "text": "把这杨广"
    },
    {
      "end": 8925.52,
      "start": 8923.88,
      "text": "这没脸上了"
    },
    {
      "end": 8926.6,
      "start": 8925.52,
      "text": "全世界都知道了"
    },
    {
      "end": 8928.1,
      "start": 8926.6,
      "text": "他不疯狂"
    },
    {
      "end": 8929.4,
      "start": 8928.1,
      "text": "他就不会自杀"
    },
    {
      "end": 8935.16,
      "start": 8929.4,
      "text": "把我爹把盘古员工给拿出"
    },
    {
      "end": 8937.04,
      "start": 8935.16,
      "text": "把龙头变成包头变成鸟头"
    },
    {
      "end": 8937.98,
      "start": 8937.04,
      "text": "他是拿不掉的"
    },
    {
      "end": 8940.98,
      "start": 8937.98,
      "text": "他绝对证明了习不自信习的恐惧"
    },
    {
      "end": 8942.6,
      "start": 8940.98,
      "text": "所有党内比咱明白"
    },
    {
      "end": 8944.7,
      "start": 8942.6,
      "text": "他把我爹扔在马路上"
    },
    {
      "end": 8946.96,
      "start": 8944.7,
      "text": "他把所有的员工扔到马路上"
    },
    {
      "end": 8949.34,
      "start": 8946.96,
      "text": "我告诉你造成的恐惧绝不是咱们"
    },
    {
      "end": 8950.88,
      "start": 8949.34,
      "text": "最多是党内的人"
    },
    {
      "end": 8953.68,
      "start": 8950.88,
      "text": "他说习这小子和王什么都敢干"
    },
    {
      "end": 8955.1,
      "start": 8953.68,
      "text": "他对我们会更狠"
    },
    {
      "end": 8958.28,
      "start": 8955.1,
      "text": "所以我告诉美国的朋友"
    },
    {
      "end": 8959.76,
      "start": 8958.28,
      "text": "另外一个我要告诉你"
    },
    {
      "end": 8961.8,
      "start": 8959.76,
      "text": "他一定会打台湾"
    },
    {
      "end": 8963.68,
      "start": 8961.8,
      "text": "他一定会疯狂"
    },
    {
      "end": 8965.12,
      "start": 8963.68,
      "text": "就像在新疆打屠杀"
    },
    {
      "end": 8968.0,
      "start": 8965.12,
      "text": "他一定要证明这个世界"
    },
    {
      "end": 8968.78,
      "start": 8968.0,
      "text": "他是太阳"
    },
    {
      "end": 8971.66,
      "start": 8968.78,
      "text": "但是我从来没见过"
    },
    {
      "end": 8973.68,
      "start": 8971.66,
      "text": "人间出现过另外一个太阳"
    },
    {
      "end": 8974.84,
      "start": 8973.68,
      "text": "他一定会自杀"
    },
    {
      "end": 8978.6,
      "start": 8974.84,
      "text": "俄罗斯这次对他绝对是重锤的打击"
    },
    {
      "end": 8981.54,
      "start": 8978.6,
      "text": "我今天跟你们讲这话的时候"
    },
    {
      "end": 8984.46,
      "start": 8981.54,
      "text": "就是我们得到信息不是来自中共国"
    },
    {
      "end": 8986.2,
      "start": 8984.46,
      "text": "是俄罗斯的哥们告诉我的"
    },
    {
      "end": 8988.98,
      "start": 8986.2,
      "text": "我的绝对的好的女朋友"
    },
    {
      "end": 8989.66,
      "start": 8988.98,
      "text": "俄罗斯人"
    },
    {
      "end": 8991.98,
      "start": 8989.66,
      "text": "也是普京的最亲信的人"
    },
    {
      "end": 8992.84,
      "start": 8991.98,
      "text": "给我讲"
    },
    {
      "end": 8995.08,
      "start": 8992.84,
      "text": "我说你跟他们说完以后"
    },
    {
      "end": 8996.08,
      "start": 8995.08,
      "text": "这个中共啥反应"
    },
    {
      "end": 8996.98,
      "start": 8996.08,
      "text": "他说整个全傻"
    },
    {
      "end": 8999.72,
      "start": 8996.98,
      "text": "他说Miles你说太对了"
