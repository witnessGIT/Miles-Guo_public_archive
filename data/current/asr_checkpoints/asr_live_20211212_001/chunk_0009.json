{
  "chunk_audio_sha256": "2db93a134810e9f14b31199d55c4d3c463b95a8c90120e94f0ad23edcdbcc648",
  "chunk_index": 9,
  "completed_at": "2026-10-21T11:30:44Z",
  "language": "zh",
  "live_id": "LIVE_20211212_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 8100,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 8105.2,
      "start": 8100.0,
      "text": "你失在前 戀在後 不是戀在前 失在後"
    },
    {
      "end": 8109.4,
      "start": 8106.1,
      "text": "失戀是因為你失去你曾經的戀"
    },
    {
      "end": 8114.0,
      "start": 8110.9,
      "text": "是因為你先有戀 先有黏糊 先有失去理智"
    },
    {
      "end": 8118.2,
      "start": 8114.0,
      "text": "戀就先失去理智嘛 無我嘛 沒有任何現實生活的考慮嘛"
    },
    {
      "end": 8123.0,
      "start": 8118.7,
      "text": "你失去了這個不冷靜的感情那一刻的時候要記住"
    },
    {
      "end": 8127.8,
      "start": 8123.7,
      "text": "不是僅僅你的原因 不一定對方的原因 一定是多方原因"
    },
    {
      "end": 8133.4,
      "start": 8127.8,
      "text": "不管什麽原因都是好的 它不會是壞的"
    },
    {
      "end": 8138.4,
      "start": 8133.4,
      "text": "說實在話 沒有比失戀再讓你人生更成熟"
    },
    {
      "end": 8141.6,
      "start": 8138.4,
      "text": "沒有比失戀是上帝給你最大的恩賜"
    },
    {
      "end": 8143.6,
      "start": 8141.6,
      "text": "因為你有機會藏更新的東西"
    },
    {
      "end": 8147.6,
      "start": 8143.6,
      "text": "一生都吃饅頭 都吃米飯 一生都吃鮑魚"
    },
    {
      "end": 8149.9,
      "start": 8147.6,
      "text": "或一生都吃屎 都是悲哀"
    },
    {
      "end": 8155.2,
      "start": 8149.9,
      "text": "你只有吃過西餐 中餐 熱餐 冷餐"
    },
    {
      "end": 8159.0,
      "start": 8155.2,
      "text": "多種餐吃過 你才知道美食是多樣性是最好的"
    },
    {
      "end": 8161.8,
      "start": 8159.0,
      "text": "廣吃肉也不行 廣吃青菜也不行"
    },
    {
      "end": 8163.3,
      "start": 8161.8,
      "text": "多試試去"
    },
    {
      "end": 8165.8,
      "start": 8163.3,
      "text": "什麽情況你不要試呢"
    },
    {
      "end": 8167.8,
      "start": 8165.8,
      "text": "不要為了試去試一試"
    },
    {
      "end": 8172.4,
      "start": 8167.8,
      "text": "尊重自然 你到了美國你就吃美國餐"
    },
    {
      "end": 8175.3,
      "start": 8172.4,
      "text": "你到哪國就吃哪國餐 沒啥了不起的"
    },
    {
      "end": 8180.1,
      "start": 8175.3,
      "text": "還有一個記住 沒有比獨佔和所謂的獨有"
    },
    {
      "end": 8182.9,
      "start": 8180.1,
      "text": "忠誠在騙人的 純撤球蛋的"
    },
    {
      "end": 8185.9,
      "start": 8182.9,
      "text": "最好的忠誠就是不忠誠"
    },
    {
      "end": 8188.9,
      "start": 8185.9,
      "text": "最好的忠誠就是不忠誠"
    },
    {
      "end": 8190.9,
      "start": 8188.9,
      "text": "讓你自己的愉悅"
    },
    {
      "end": 8193.9,
      "start": 8190.9,
      "text": "世界上誰高興也沒你自己高興重要"
    },
    {
      "end": 8197.9,
      "start": 8193.9,
      "text": "誰快樂也沒你高興也沒有多少人真在乎你高興不高興"
    },
    {
      "end": 8200.5,
      "start": 8197.9,
      "text": "就像我跟妳七嫂當時寫情書一樣"
    },
    {
      "end": 8203.7,
      "start": 8200.5,
      "text": "我要是死了 妳還能說死到老嗎"
    },
    {
      "end": 8204.9,
      "start": 8203.7,
      "text": "妳愚蠢"
    },
    {
      "end": 8207.1,
      "start": 8204.9,
      "text": "我這親父看上所給她寫信 我要被槍斃了"
    },
    {
      "end": 8209.9,
      "start": 8207.1,
      "text": "馬上嫁人 是不是"
    },
    {
      "end": 8212.3,
      "start": 8209.9,
      "text": "嫁得又快又好 是吧"
    },
    {
      "end": 8213.7,
      "start": 8212.3,
      "text": "這是最簡單的道理"
    },
    {
      "end": 8218.3,
      "start": 8213.7,
      "text": "妳憑什麽 妳死了妳還給妳穿上鐵固材手藝術"
    },
    {
      "end": 8221.1,
      "start": 8218.3,
      "text": "這是多麽的愚蠢 多麽的自私"
    },
    {
      "end": 8222.7,
      "start": 8221.1,
      "text": "話又說過來了"
    },
    {
      "end": 8225.1,
      "start": 8222.7,
      "text": "又有多少人在乎妳這麽做呢"
    },
    {
      "end": 8227.7,
      "start": 8225.1,
      "text": "對不對啊"
    },
    {
      "end": 8231.7,
      "start": 8227.7,
      "text": "最好的辦法妳過得快樂 妳愛的人自然會快樂"
    },
    {
      "end": 8234.7,
      "start": 8231.7,
      "text": "妳一定要相信一條 只要妳開心了"
    },
    {
      "end": 8238.7,
      "start": 8234.7,
      "text": "妳去嘗試了 妳忠於妳自己了 一切都好"
    },
    {
      "end": 8242.3,
      "start": 8238.7,
      "text": "失戀的 解決失戀最好的辦法往前看"
    },
    {
      "end": 8245.3,
      "start": 8242.3,
      "text": "然後找到更好的 自己開心"
    },
    {
      "end": 8247.7,
      "start": 8245.3,
      "text": "所有的愛情最後回到個本質"
    },
    {
      "end": 8250.1,
      "start": 8247.7,
      "text": "妳高興 妳的愛人當然高興"
    },
    {
      "end": 8252.9,
      "start": 8250.1,
      "text": "如果妳高興 她不高興 那她就是王八蛋"
    },
    {
      "end": 8256.5,
      "start": 8252.9,
      "text": "妳就活求該 妳就不應該讓她高興 妳還繼續要讓妳自己高興"
    },
    {
      "end": 8261.5,
      "start": 8256.5,
      "text": "所以說遵循原則很簡單 所有的愛都讓自己開心"
    },
    {
      "end": 8263.5,
      "start": 8261.5,
      "text": "如果愛不讓開心 就把它滅掉"
    },
    {
      "end": 8266.5,
      "start": 8263.5,
      "text": "如果滅掉以後 對方不開心 那自己更不得愛"
    },
    {
      "end": 8268.5,
      "start": 8266.5,
      "text": "讓自己更開心 都這麽簡單"
    },
    {
      "end": 8269.5,
      "start": 8268.5,
      "text": "沒有任何東西"
    },
    {
      "end": 8272.1,
      "start": 8269.5,
      "text": "這個方面 無窮無盡的自私"
    },
    {
      "end": 8277.1,
      "start": 8272.1,
      "text": "只要妳但凡放掉了妳愛自己 讓自己不高興"
    },
    {
      "end": 8280.1,
      "start": 8277.1,
      "text": "不自私了 妳就是成了傻子"
    },
    {
      "end": 8282.1,
      "start": 8280.1,
      "text": "妳就成了犧牲體 就這麽簡單"
    },
    {
      "end": 8284.1,
      "start": 8282.1,
      "text": "好的 接著說下個話題"
    },
    {
      "end": 8287.7,
      "start": 8284.1,
      "text": "要不然今天幾個小時就沒有"
    },
    {
      "end": 8289.5,
      "start": 8287.7,
      "text": "好的 謝謝文貴先生"
    },
    {
      "end": 8291.3,
      "start": 8289.5,
      "text": "那麽我看這時間已經10點半了"
    },
    {
      "end": 8293.7,
      "start": 8291.3,
      "text": "就是剛才文貴先生開篇提了3個問題"
    },
    {
      "end": 8296.7,
      "start": 8293.7,
      "text": "我想是不是可以揭曉另外一個就是關於過去"
    },
    {
      "end": 8300.7,
      "start": 8296.7,
      "text": "24小時內發生了對CCP不利的一個事情"
    },
    {
      "end": 8302.7,
      "start": 8300.7,
      "text": "容我猜測一下"
    },
    {
      "end": 8306.9,
      "start": 8302.7,
      "text": "就是因為我看到今天有一個鳳凰網財經峰會上"
    },
    {
      "end": 8310.5,
      "start": 8306.9,
      "text": "有那個央行原行長戴向龍說了一句話"
    },
    {
      "end": 8314.3,
      "start": 8310.5,
      "text": "說我國不存在2007年次貸危機形成的機制"
    },
    {
      "end": 8317.7,
      "start": 8314.3,
      "text": "我在想這個七哥說的那個對CCP不利的事情"
    },
    {
      "end": 8322.1,
      "start": 8317.7,
      "text": "是不是國內這個經濟 金融方面的一些問題"
    },
    {
      "end": 8323.3,
      "start": 8322.1,
      "text": "跟這個是不是相關"
    },
    {
      "end": 8326.3,
      "start": 8323.3,
      "text": "謝謝 請七哥給大家解惑"
    },
    {
      "end": 8330.5,
      "start": 8326.3,
      "text": "好 這個在過去吧"
    },
    {
      "end": 8333.7,
      "start": 8330.5,
      "text": "也就是說我們上次直播現在大概48小時"
    },
    {
      "end": 8335.9,
      "start": 8333.7,
      "text": "我們今天說過去24小時"
    },
    {
      "end": 8338.3,
      "start": 8335.9,
      "text": "我覺得對共產黨這個最大的"
    },
    {
      "end": 8341.5,
      "start": 8338.3,
      "text": "我覺得一個最大刺激是受不了的"
    },
    {
      "end": 8343.5,
      "start": 8341.5,
      "text": "就是來自剛才我們談到的俄羅斯"
    },
    {
      "end": 8348.3,
      "start": 8345.5,
      "text": "俄羅斯派去的特使"
    },
    {
      "end": 8351.3,
      "start": 8348.3,
      "text": "非常明確的所謂的"
    },
    {
      "end": 8355.7,
      "start": 8351.3,
      "text": "在官方通報了和俄美交流之後"
    },
    {
      "end": 8356.9,
      "start": 8355.7,
      "text": "會談之後"
    },
    {
      "end": 8358.9,
      "start": 8356.9,
      "text": "這次說私下的交談"
    },
    {
      "end": 8360.5,
      "start": 8358.9,
      "text": "告訴了中方"
    },
    {
      "end": 8362.9,
      "start": 8360.5,
      "text": "在任何情況下"
    },
    {
      "end": 8364.5,
      "start": 8362.9,
      "text": "這對台灣是個好事"
    },
    {
      "end": 8366.9,
      "start": 8364.5,
      "text": "任何情況下你打台灣我不會跟你一起"
    },
    {
      "end": 8370.1,
      "start": 8366.9,
      "text": "原來說你弄我吆喝"
    },
    {
      "end": 8371.1,
      "start": 8370.1,
      "text": "甚至跟你技術人支持"
    },
    {
      "end": 8373.1,
      "start": 8371.1,
      "text": "這個對他是個致命的"
    },
    {
      "end": 8375.1,
      "start": 8373.1,
      "text": "這我不會的"
    },
    {
      "end": 8376.9,
      "start": 8375.1,
      "text": "這是肯定的"
    },
    {
      "end": 8378.9,
      "start": 8376.9,
      "text": "俄羅斯的性格不會說跟你商量啊"
    },
    {
      "end": 8379.5,
      "start": 8378.9,
      "text": "對不起啊"
    },
    {
      "end": 8381.3,
      "start": 8379.5,
      "text": "沒得說這就是我的決定"
    },
    {
      "end": 8383.5,
      "start": 8381.3,
      "text": "這共產黨就會說對不起啊"
    },
    {
      "end": 8384.5,
      "start": 8383.5,
      "text": "什麼繞彎什麼的"
    },
    {
      "end": 8385.5,
      "start": 8384.5,
      "text": "歷史啊"
    },
    {
      "end": 8386.5,
      "start": 8385.5,
      "text": "五千年扯淡的事兒"
    },
    {
      "end": 8387.5,
      "start": 8386.5,
      "text": "很清楚"
    },
    {
      "end": 8389.5,
      "start": 8387.5,
      "text": "打台灣我是參與"
    },
    {
      "end": 8391.5,
      "start": 8389.5,
      "text": "第二句話很可怕"
    },
    {
      "end": 8395.3,
      "start": 8391.5,
      "text": "所有中樞之間簽署的油"
    },
    {
      "end": 8396.3,
      "start": 8395.3,
      "text": "氣的協議"
    },
    {
      "end": 8397.3,
      "start": 8396.3,
      "text": "你們必須執行"
    },
    {
      "end": 8399.9,
      "start": 8397.3,
      "text": "言外之意啥意思啊"
    },
    {
      "end": 8401.7,
      "start": 8399.9,
      "text": "你該給我的錢"
    },
    {
      "end": 8402.7,
      "start": 8401.7,
      "text": "給我買我的油"
    },
    {
      "end": 8402.9,
      "start": 8402.7,
      "text": "買我的金"
    },
    {
      "end": 8403.9,
      "start": 8402.9,
      "text": "一點也不能少"
    },
    {
      "end": 8404.9,
      "start": 8403.9,
      "text": "你少了又反過來"
    },
    {
      "end": 8405.9,
      "start": 8404.9,
      "text": "我不是不支持你"
    },
    {
      "end": 8406.9,
      "start": 8405.9,
      "text": "我就打你了"
    },
    {
      "end": 8407.9,
      "start": 8406.9,
      "text": "我就跟美國戰略了"
    },
    {
      "end": 8412.1,
      "start": 8407.9,
      "text": "這對習來講是"
    },
    {
      "end": 8413.7,
      "start": 8412.1,
      "text": "簡直是巨大的羞辱"
    },
    {
      "end": 8415.9,
      "start": 8413.7,
      "text": "他是聯俄抗美"
    },
    {
      "end": 8416.9,
      "start": 8415.9,
      "text": "聯俄收台"
    },
    {
      "end": 8419.9,
      "start": 8416.9,
      "text": "這個戰略關係是整個過去十幾年"
    },
    {
      "end": 8422.3,
      "start": 8419.9,
      "text": "世界局勢變化的一切根本的原因"
    },
    {
      "end": 8423.9,
      "start": 8422.3,
      "text": "這已經完了"
    },
    {
      "end": 8427.3,
      "start": 8423.9,
      "text": "第三條是更讓他接受不了的"
    },
    {
      "end": 8429.7,
      "start": 8427.3,
      "text": "俄國和印度"
    },
    {
      "end": 8432.1,
      "start": 8429.7,
      "text": "北朝鮮"
    },
    {
      "end": 8434.1,
      "start": 8432.1,
      "text": "巴基斯坦"
    },
    {
      "end": 8435.3,
      "start": 8434.1,
      "text": "伊朗"
    },
    {
      "end": 8438.3,
      "start": 8435.3,
      "text": "將形成一個新的聯盟關係"
    },
    {
      "end": 8443.5,
      "start": 8438.3,
      "text": "你看看就沒有共產黨"
    },
    {
      "end": 8446.7,
      "start": 8443.5,
      "text": "而且明確就沒有要求你進去"
    },
    {
      "end": 8449.3,
      "start": 8446.9,
      "text": "什麼概念"
    },
    {
      "end": 8451.5,
      "start": 8449.3,
      "text": "這幾個人要聯合起來跟美國講書"
    },
    {
      "end": 8454.1,
      "start": 8451.5,
      "text": "咱們不打"
    },
    {
      "end": 8455.3,
      "start": 8454.1,
      "text": "咱交易"
    },
    {
      "end": 8461.5,
      "start": 8455.3,
      "text": "說特別是俄羅斯反對中國在阿富汗幹的事情"
    },
    {
      "end": 8462.7,
      "start": 8461.5,
      "text": "很明確"
    },
    {
      "end": 8464.5,
      "start": 8462.7,
      "text": "告訴你為什麼這麼幹"
    },
    {
      "end": 8467.1,
      "start": 8464.5,
      "text": "這就是俄國的外交"
    },
    {
      "end": 8468.9,
      "start": 8467.1,
      "text": "俄國外交是世界上"
    },
    {
      "end": 8471.1,
      "start": 8468.9,
      "text": "俄國歷史一千年來"
    },
    {
      "end": 8473.1,
      "start": 8471.1,
      "text": "他最成功的就是他的外交"
    },
    {
      "end": 8475.9,
      "start": 8473.1,
      "text": "不要臉"
    },
    {
      "end": 8477.3,
      "start": 8475.9,
      "text": "完全不要臉"
    },
    {
      "end": 8478.9,
      "start": 8477.3,
      "text": "完全是拿著主意"
    },
    {
      "end": 8480.3,
      "start": 8478.9,
      "text": "完全是胡扯"
    },
    {
      "end": 8481.3,
      "start": 8480.3,
      "text": "就現實主意"
    },
    {
      "end": 8482.1,
      "start": 8481.3,
      "text": "很告訴你"
    },
    {
      "end": 8484.3,
      "start": 8482.1,
