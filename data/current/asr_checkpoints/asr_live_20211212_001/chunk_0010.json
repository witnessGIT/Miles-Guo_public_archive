    },
    {
      "end": 9648.6,
      "start": 9647.02,
      "text": "能去的國家都發現"
    },
    {
      "end": 9649.94,
      "start": 9648.6,
      "text": "基本上都是"
    },
    {
      "end": 9651.54,
      "start": 9649.94,
      "text": "背後帶棉花那種人"
    },
    {
      "end": 9652.2,
      "start": 9651.54,
      "text": "是吧"
    },
    {
      "end": 9654.28,
      "start": 9652.2,
      "text": "臉上還留著殺人的血跡的人"
    },
    {
      "end": 9655.84,
      "start": 9654.28,
      "text": "全部給錢"
    },
    {
      "end": 9657.14,
      "start": 9655.84,
      "text": "而且很多出去代表"
    },
    {
      "end": 9658.28,
      "start": 9657.14,
      "text": "叫總統代表"
    },
    {
      "end": 9659.48,
      "start": 9658.28,
      "text": "據說我今天說的話"
    },
    {
      "end": 9661.38,
      "start": 9659.48,
      "text": "這都是過去24小時發生的事"
    },
    {
      "end": 9665.18,
      "start": 9662.88,
      "text": "而且美國明天"
    },
    {
      "end": 9667.22,
      "start": 9665.18,
      "text": "西方世界有更多歐洲國家"
    },
    {
      "end": 9668.72,
      "start": 9667.22,
      "text": "宣布抵制東奧會"
    },
    {
      "end": 9669.78,
      "start": 9668.72,
      "text": "現在給英國說了"
    },
    {
      "end": 9671.46,
      "start": 9669.78,
      "text": "只要你來"
    },
    {
      "end": 9672.36,
      "start": 9671.46,
      "text": "只要你總統"
    },
    {
      "end": 9674.1,
      "start": 9672.36,
      "text": "有找個招來"
    },
    {
      "end": 9675.22,
      "start": 9674.1,
      "text": "我的核電站的錢"
    },
    {
      "end": 9676.62,
      "start": 9675.22,
      "text": "哪怕都白給你"
    },
    {
      "end": 9678.56,
      "start": 9676.62,
      "text": "都到這程度了"
    },
    {
      "end": 9680.3,
      "start": 9678.56,
      "text": "對意大利已經開出什麼條件"
    },
    {
      "end": 9682.46,
      "start": 9680.3,
      "text": "一百億美元"
    },
    {
      "end": 9683.84,
      "start": 9682.46,
      "text": "長期貸款"
    },
    {
      "end": 9684.78,
      "start": 9683.84,
      "text": "馬上到賬"
    },
    {
      "end": 9687.18,
      "start": 9684.78,
      "text": "對德國說"
    },
    {
      "end": 9689.4,
      "start": 9687.18,
      "text": "只要你派出哪怕的重量級人來"
    },
    {
      "end": 9692.28,
      "start": 9689.4,
      "text": "德國汽車在中國的各種政策"
    },
    {
      "end": 9695.78,
      "start": 9692.28,
      "text": "馬上進入更新的中國政府採購性的"
    },
    {
      "end": 9699.46,
      "start": 9695.78,
      "text": "就是這個奧運會"
    },
    {
      "end": 9701.78,
      "start": 9699.46,
      "text": "40英里的昌平"
    },
    {
      "end": 9703.78,
      "start": 9701.78,
      "text": "張家界"
    },
    {
      "end": 9706.96,
      "start": 9703.78,
      "text": "和奧運會現場的整個的奧美會"
    },
    {
      "end": 9709.12,
      "start": 9706.96,
      "text": "中共要以輕一國之力"
    },
    {
      "end": 9710.46,
      "start": 9709.12,
      "text": "要找一幫要販子"
    },
    {
      "end": 9712.46,
      "start": 9710.46,
      "text": "充當那些貴賓"
    },
    {
      "end": 9714.26,
      "start": 9712.46,
      "text": "到現場參加這個"
    },
    {
      "end": 9716.46,
      "start": 9714.26,
      "text": "找著小姐充滿新娘的中奧會"
    },
    {
      "end": 9718.1,
      "start": 9716.46,
      "text": "你可見有多慘"
    },
    {
      "end": 9721.2,
      "start": 9718.1,
      "text": "你知道彭帥這個事兒對他影響"
    },
    {
      "end": 9724.2,
      "start": 9721.2,
      "text": "習下決心要幹掉張高麗"
    },
    {
      "end": 9726.1,
      "start": 9724.2,
      "text": "說一半的功勞"
    },
    {
      "end": 9728.1,
      "start": 9726.1,
      "text": "是張高麗的彭帥搞出來的"
    },
    {
      "end": 9729.9,
      "start": 9728.1,
      "text": "這叫天意啊"
    },
    {
      "end": 9734.08,
      "start": 9729.9,
      "text": "彭帥這件事情是謹上天花"
    },
    {
      "end": 9736.38,
      "start": 9734.08,
      "text": "老天送我們給李啊彭帥"
    },
    {
      "end": 9738.58,
      "start": 9736.38,
      "text": "我們未來得給彭帥點起弊"
    },
    {
      "end": 9739.34,
      "start": 9738.58,
      "text": "你知道嗎"
    },
    {
      "end": 9742.22,
      "start": 9739.34,
      "text": "他加速了共產黨奧運會的滅亡"
    },
    {
      "end": 9743.96,
      "start": 9742.22,
      "text": "弄點躺平弊"
    },
    {
      "end": 9745.88,
      "start": 9743.96,
      "text": "咱也可以甚至給他起個"
    },
    {
      "end": 9747.92,
      "start": 9745.88,
      "text": "專門給彭帥搞一個弊"
    },
    {
      "end": 9751.5,
      "start": 9747.92,
      "text": "叫做天空無限大"
    },
    {
      "end": 9753.22,
      "start": 9751.5,
      "text": "然後地球伊麗莎的"
    },
    {
      "end": 9756.12,
      "start": 9753.22,
      "text": "上面戴上這個胡騰的彭帥"
    },
    {
      "end": 9757.5,
      "start": 9756.12,
      "text": "這實在太有意義了"
    },
    {
      "end": 9759.0,
      "start": 9757.5,
      "text": "你們沒有意識到"
    },
    {
      "end": 9761.2,
      "start": 9759.0,
      "text": "這件事情對他們的羞辱"
    },
    {
      "end": 9763.1,
      "start": 9761.2,
      "text": "很多人說這是真正的"
    },
    {
      "end": 9766.14,
      "start": 9763.1,
      "text": "習近平的滑鐵盧開始"
    },
    {
      "end": 9768.26,
      "start": 9766.14,
      "text": "這個滑鐵盧又搞了俄羅斯這樣"
    },
    {
      "end": 9769.0,
      "start": 9768.26,
      "text": "這對他來講"
    },
    {
      "end": 9770.74,
      "start": 9769.0,
      "text": "這真的是糯米諾骨牌"
    },
    {
      "end": 9772.24,
      "start": 9770.74,
      "text": "垮起開始"
    },
    {
      "end": 9773.04,
      "start": 9772.24,
      "text": "謝謝"
    },
    {
      "end": 9773.9,
      "start": 9773.04,
      "text": "下個問題"
    },
    {
      "end": 9775.1,
      "start": 9773.9,
      "text": "兄弟姐妹"
    },
    {
      "end": 9777.06,
      "start": 9775.1,
      "text": "請"
    },
    {
      "end": 9778.16,
      "start": 9777.06,
      "text": "好的"
    },
    {
      "end": 9779.98,
      "start": 9778.16,
      "text": "我的問題"
    },
    {
      "end": 9780.88,
      "start": 9779.98,
      "text": "我的問題呢"
    },
    {
      "end": 9783.38,
      "start": 9780.88,
      "text": "就是文貴先生在上一次直播說"
    },
    {
      "end": 9785.74,
      "start": 9783.38,
      "text": "美國會在中期選舉以後"
    },
    {
      "end": 9789.22,
      "start": 9785.74,
      "text": "會對中共有十大招數會出來"
    },
    {
      "end": 9792.92,
      "start": 9789.22,
      "text": "除了有剔除WTO還有Swift系統"
    },
    {
      "end": 9795.0,
      "start": 9792.92,
      "text": "那我想問問您不知道方便透露之後"
    },
    {
      "end": 9796.12,
      "start": 9795.0,
      "text": "還有哪八招嗎"
    },
    {
      "end": 9800.0,
      "start": 9796.12,
      "text": "或者是在哪個方面會對中共進行制裁"
    },
    {
      "end": 9800.54,
      "start": 9800.0,
      "text": "謝謝"
    },
    {
      "end": 9802.54,
      "start": 9800.54,
      "text": "小新年齡小孩"
    },
    {
      "end": 9804.54,
      "start": 9802.54,
      "text": "最談戀愛之間"
    },
    {
      "end": 9807.02,
      "start": 9804.54,
      "text": "就是高手跟你最重要的事情"
    },
    {
      "end": 9810.18,
      "start": 9807.02,
      "text": "就是給你老遠給你帶來一個讓你好奇的東西"
    },
    {
      "end": 9812.66,
      "start": 9810.78,
      "text": "好奇就是戀愛的一個基礎"
    },
    {
      "end": 9814.86,
      "start": 9812.66,
      "text": "當沒有好奇沒有新鮮感的時候就拉倒"
    },
    {
      "end": 9816.66,
      "start": 9815.46,
      "text": "這是絕對的"
    },
    {
      "end": 9819.42,
      "start": 9816.66,
      "text": "你永遠對答案很感興趣"
    },
    {
      "end": 9821.42,
      "start": 9819.42,
      "text": "越來越答案"
    },
    {
      "end": 9825.04,
      "start": 9821.42,
      "text": "聰明的男人每天都給你話出好多個問號來"
    },
    {
      "end": 9826.4,
      "start": 9825.04,
      "text": "然後你明天就要答案"
    },
    {
      "end": 9826.7,
      "start": 9826.4,
      "text": "是吧"
    },
    {
      "end": 9827.96,
      "start": 9826.7,
      "text": "就這麼簡單"
    },
    {
      "end": 9830.3,
      "start": 9827.96,
      "text": "七個教你這兒千萬別上了大"
    },
    {
      "end": 9832.84,
      "start": 9830.3,
      "text": "關於這八個問題說實在的"
    },
    {
      "end": 9834.24,
      "start": 9832.84,
      "text": "我還真不能說"
    },
    {
      "end": 9836.5,
      "start": 9834.24,
      "text": "就比如說上次我說完以後"
    },
    {
      "end": 9840.84,
      "start": 9836.5,
      "text": "大家要看一看美國現在民主黨出現了多少總統候選人"
    },
    {
      "end": 9842.98,
      "start": 9840.84,
      "text": "大家看一看"
    },
    {
      "end": 9845.78,
      "start": 9842.98,
      "text": "幾乎多過十個"
    },
    {
      "end": 9847.98,
      "start": 9845.78,
      "text": "這在兩個月前幾乎是不可能的"
    },
    {
      "end": 9853.12,
      "start": 9847.98,
      "text": "共和黨幾乎也超過十個"
    },
    {
      "end": 9858.32,
      "start": 9853.12,
      "text": "所以說2022年的中期選舉"
    },
    {
      "end": 9862.66,
      "start": 9858.32,
      "text": "共和黨沒有出現巨大的天崩地裂的意外說他一定會贏"
    },
    {
      "end": 9864.52,
      "start": 9862.66,
      "text": "他贏完以後"
    },
    {
      "end": 9866.52,
      "start": 9864.52,
      "text": "川普的定位"
    },
    {
      "end": 9868.26,
      "start": 9866.52,
      "text": "班農的定位"
    },
    {
      "end": 9871.26,
      "start": 9868.26,
      "text": "還有這些要選這個"
    },
    {
      "end": 9873.64,
      "start": 9871.26,
      "text": "共和黨的這個未來總統人的定位"
    },
    {
      "end": 9874.26,
      "start": 9873.64,
      "text": "哇塞"
    },
    {
      "end": 9875.74,
      "start": 9874.26,
      "text": "和民主黨選中的定位"
    },
    {
      "end": 9876.58,
      "start": 9875.74,
      "text": "這個是大戰"
    },
    {
      "end": 9879.0,
      "start": 9876.58,
      "text": "但是有一件事你可以看得出來"
    },
    {
      "end": 9883.54,
      "start": 9879.0,
      "text": "所有的能想像到的這兩黨的總統候選人"
    },
    {
      "end": 9888.74,
      "start": 9883.54,
      "text": "百分之百都會去滅公"
    },
    {
      "end": 9889.88,
      "start": 9888.74,
      "text": "百分之百"
    },
    {
      "end": 9891.42,
      "start": 9889.88,
      "text": "不是少"
    },
    {
      "end": 9893.18,
      "start": 9891.42,
      "text": "你別看就像南西普魯斯一樣"
    },
    {
      "end": 9895.08,
      "start": 9893.18,
      "text": "他還得滅公"
    },
    {
      "end": 9896.48,
      "start": 9895.08,
      "text": "你不管三偉健"
    },
    {
      "end": 9898.22,
      "start": 9896.48,
      "text": "他兒子他兒媳婦"
    },
    {
      "end": 9899.42,
      "start": 9898.22,
      "text": "搞了多少億元"
    },
    {
      "end": 9900.02,
      "start": 9899.42,
      "text": "花了多少"
