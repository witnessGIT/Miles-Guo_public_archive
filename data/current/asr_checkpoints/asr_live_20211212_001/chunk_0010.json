  "segments": [
    {
      "end": 9002.24,
      "start": 9000.0,
      "text": "他絕對是我姐妹"
    },
    {
      "end": 9004.14,
      "start": 9002.24,
      "text": "有一天他也給我做了任職直播的時候"
    },
    {
      "end": 9005.14,
      "start": 9004.14,
      "text": "你們會驚訝的"
    },
    {
      "end": 9007.24,
      "start": 9005.14,
      "text": "也有很有可能的"
    },
    {
      "end": 9010.24,
      "start": 9007.24,
      "text": "他說我真的是在你身上看到了中國人的本質"
    },
    {
      "end": 9012.24,
      "start": 9010.24,
      "text": "他說中國人真的是鬧肿"
    },
    {
      "end": 9014.54,
      "start": 9012.24,
      "text": "他說真的是"
    },
    {
      "end": 9016.24,
      "start": 9014.54,
      "text": "他交過兩三個中國男朋友"
    },
    {
      "end": 9019.26,
      "start": 9016.24,
      "text": "他說所有中國男朋友跟我離開的時候"
    },
    {
      "end": 9021.76,
      "start": 9019.26,
      "text": "都有一個非常好的藉口"
    },
    {
      "end": 9023.36,
      "start": 9021.76,
      "text": "我不適合你"
    },
    {
      "end": 9027.2,
      "start": 9023.36,
      "text": "你說這中國男人有表演的啥程度"
    },
    {
      "end": 9028.2,
      "start": 9027.2,
      "text": "我不是小新啊"
    },
    {
      "end": 9029.3,
      "start": 9028.2,
      "text": "卡琳沒有經歷過"
    },
    {
      "end": 9030.44,
      "start": 9029.3,
      "text": "對不起了"
    },
    {
      "end": 9032.3,
      "start": 9030.44,
      "text": "我跟你睡了半年一年"
    },
    {
      "end": 9033.74,
      "start": 9032.3,
      "text": "把你錢也花了"
    },
    {
      "end": 9035.94,
      "start": 9033.74,
      "text": "我對不起你我不適合你"
    },
    {
      "end": 9037.8,
      "start": 9035.94,
      "text": "我只有中國男人的不要臉"
    },
    {
      "end": 9038.74,
      "start": 9037.8,
      "text": "你說"
    },
    {
      "end": 9040.98,
      "start": 9039.94,
      "text": "你背叛人家了"
    },
    {
      "end": 9042.34,
      "start": 9040.98,
      "text": "說我不適合你"
    },
    {
      "end": 9046.38,
      "start": 9044.18,
      "text": "是不是我沒有本事愛你"
    },
    {
      "end": 9047.96,
      "start": 9046.38,
      "text": "我沒資格愛你啊"
    },
    {
      "end": 9049.18,
      "start": 9047.96,
      "text": "我腎也不行啊"
    },
    {
      "end": 9050.32,
      "start": 9049.18,
      "text": "我也沒有前途啊"
    },
    {
      "end": 9053.42,
      "start": 9050.32,
      "text": "他說我的三個中國男人都是我不適合你"
    },
    {
      "end": 9055.66,
      "start": 9053.42,
      "text": "他說我太知道不是他們不適合我"
    },
    {
      "end": 9057.46,
      "start": 9055.66,
      "text": "他們是覺得跟我在"
    },
    {
      "end": 9059.3,
      "start": 9057.46,
      "text": "他們有了心歡了你就心歡嗎"
    },
    {
      "end": 9062.3,
      "start": 9059.3,
      "text": "你就大膽的說老子就不喜歡你了"
    },
    {
      "end": 9062.8,
      "start": 9062.3,
      "text": "是吧"
    },
    {
      "end": 9063.84,
      "start": 9062.8,
      "text": "我有更好的了"
    },
    {
      "end": 9064.64,
      "start": 9063.84,
      "text": "你怎麼牛啊"
    },
    {
      "end": 9065.24,
      "start": 9064.64,
      "text": "是吧"
    },
    {
      "end": 9065.94,
      "start": 9065.24,
      "text": "他不"
    },
    {
      "end": 9067.94,
      "start": 9065.94,
      "text": "他說共產黨就是這個"
    },
    {
      "end": 9071.84,
      "start": 9067.94,
      "text": "共產黨他說我跟他們說完這個最大的感受"
    },
    {
      "end": 9073.64,
      "start": 9071.84,
      "text": "他說中國的楊潔篪"
    },
    {
      "end": 9076.58,
      "start": 9073.64,
      "text": "還有中國的所有的國家"
    },
    {
      "end": 9079.58,
      "start": 9076.58,
      "text": "包括習整個這個他們的一個最大的問題"
    },
    {
      "end": 9081.64,
      "start": 9079.58,
      "text": "我們哪做錯了嗎"
    },
    {
      "end": 9083.58,
      "start": 9081.64,
      "text": "怎麼挽回呀"
    },
    {
      "end": 9085.88,
      "start": 9083.58,
      "text": "就是失戀的心理要挽回"
    },
    {
      "end": 9088.68,
      "start": 9085.88,
      "text": "強者從來不會要挽回的"
    },
    {
      "end": 9089.78,
      "start": 9088.68,
      "text": "習哥一輩子談戀愛"
    },
    {
      "end": 9090.62,
      "start": 9089.78,
      "text": "從來沒求誰說"
    },
    {
      "end": 9091.5,
      "start": 9090.62,
      "text": "哎呀你再愛我嗎"
    },
    {
      "end": 9092.2,
      "start": 9091.5,
      "text": "你喜歡我嗎"
    },
    {
      "end": 9093.4,
      "start": 9092.2,
      "text": "從來沒有過"
    },
    {
      "end": 9094.6,
      "start": 9093.4,
      "text": "從來沒有過"
    },
    {
      "end": 9095.8,
      "start": 9094.6,
      "text": "啊"
    },
    {
      "end": 9098.5,
      "start": 9095.8,
      "text": "怎麼可能強者說挽回呀"
    },
    {
      "end": 9101.6,
      "start": 9098.5,
      "text": "凡是女人想失戀以後再回來的女人"
    },
    {
      "end": 9103.74,
      "start": 9101.6,
      "text": "一定這個女人一輩子不會有愛的"
    },
    {
      "end": 9107.44,
      "start": 9103.74,
      "text": "這個男人一定看不起你"
    },
    {
      "end": 9109.64,
      "start": 9107.44,
      "text": "凡是男人求女人你繼續愛我啊"
    },
    {
      "end": 9110.5,
      "start": 9109.64,
      "text": "咱倆繼續戀愛吧"
    },
    {
      "end": 9114.44,
      "start": 9110.5,
      "text": "這個男人一定是沒有出息的"
    },
    {
      "end": 9117.64,
      "start": 9114.44,
      "text": "你看這個俄羅斯和習的關係就說出來"
    },
    {
      "end": 9118.18,
      "start": 9117.64,
      "text": "求我呢"
    },
    {
      "end": 9118.98,
      "start": 9118.18,
      "text": "怎麼挽回呀"
    },
    {
      "end": 9120.08,
      "start": 9118.98,
      "text": "哎呦我塞"
    },
    {
      "end": 9123.32,
      "start": 9120.08,
      "text": "人家更看不起"
    },
    {
      "end": 9127.8,
      "start": 9123.32,
      "text": "而且我相信黨內都知道"
    },
    {
      "end": 9129.56,
      "start": 9127.8,
      "text": "你知道這次人權會議"
    },
    {
      "end": 9133.0,
      "start": 9129.56,
      "text": "這完全是作秀的不扯"
    },
    {
      "end": 9136.0,
      "start": 9133.0,
      "text": "你知道俄羅斯要幹啥事嗎"
    },
    {
      "end": 9139.1,
      "start": 9136.0,
      "text": "俄羅斯要跟歐盟要聯合起來要搞一搞"
    },
    {
      "end": 9144.54,
      "start": 9139.1,
      "text": "所謂的歐洲的人權高峰會"
    },
    {
      "end": 9147.22,
      "start": 9144.54,
      "text": "俄羅斯永遠就認為就鬥這三個事兒"
    },
    {
      "end": 9149.02,
      "start": 9147.22,
      "text": "世界誰是老大"
    },
    {
      "end": 9150.72,
      "start": 9149.02,
      "text": "他現在當然是美國老大他不是"
    },
    {
      "end": 9153.46,
      "start": 9150.72,
      "text": "第二就是歐洲必須是我俄羅斯的"
    },
    {
      "end": 9155.82,
      "start": 9153.46,
      "text": "你英國也好你法國也好德國也好"
    },
    {
      "end": 9159.56,
      "start": 9155.82,
      "text": "你必須是你得靠我啊就是誰的歐洲啊"
    },
    {
      "end": 9161.96,
      "start": 9159.56,
      "text": "不管是誰的歐洲我俄羅斯當老大"
    },
    {
      "end": 9167.76,
      "start": 9161.96,
      "text": "第三俄羅斯一直在亞洲和歐洲之間尋求利益平衡"
    },
    {
      "end": 9171.06,
      "start": 9167.76,
      "text": "現在所謂的俄羅斯不可能入歐"
    },
    {
      "end": 9172.1,
      "start": 9171.06,
      "text": "入不入歐"
    },
    {
      "end": 9173.38,
      "start": 9172.1,
      "text": "歐洲我都要說了算"
    },
    {
      "end": 9174.98,
      "start": 9173.38,
      "text": "我供你的氣我供你的能源"
    },
    {
      "end": 9176.94,
      "start": 9174.98,
      "text": "我的導彈我的一切"
    },
    {
      "end": 9179.04,
      "start": 9176.94,
      "text": "我的整個的軍事力量啊"
    },
    {
      "end": 9182.38,
      "start": 9179.04,
      "text": "北約扯蛋的事跟在那邊站不著啊"
    },
    {
      "end": 9184.88,
      "start": 9182.38,
      "text": "現在俄羅斯說我要給你搞人權了啊"
    },
    {
      "end": 9189.56,
      "start": 9185.82,
      "text": "俄羅斯要真正的哥們要脫掉戰裝"
    },
    {
      "end": 9191.96,
      "start": 9189.56,
      "text": "換上西裝了玩點紳士的了"
    },
    {
      "end": 9195.56,
      "start": 9193.66,
      "text": "這對中國是絕對打臉的"
    },
    {
      "end": 9198.56,
      "start": 9197.06,
      "text": "習是很明確的"
    },
    {
      "end": 9202.26,
      "start": 9198.56,
      "text": "有人權的國家就不可能有好的政府"
    },
    {
      "end": 9204.68,
      "start": 9203.18,
      "text": "人權不適合中國"
    },
    {
      "end": 9209.18,
      "start": 9206.88,
      "text": "這就是全世界都在說的一句話"
    },
    {
      "end": 9212.12,
      "start": 9209.18,
      "text": "連非洲沒有文字的國家都有選舉"
    },
    {
      "end": 9213.18,
      "start": 9212.12,
      "text": "中國人不可能有選舉"
    },
    {
      "end": 9215.68,
      "start": 9213.18,
      "text": "而中國人深信不疑不能有選舉"
    },
    {
      "end": 9218.56,
      "start": 9215.82,
      "text": "就像你看到那個假的習近平的女兒"
    },
    {
      "end": 9219.56,
      "start": 9218.56,
      "text": "她那個選鑽石啊"
    },
    {
      "end": 9221.96,
      "start": 9219.56,
      "text": "還批評黨內不能腐敗啊"
    },
    {
      "end": 9223.56,
      "start": 9221.96,
      "text": "還不能奢侈啊"
    },
    {
      "end": 9224.52,
      "start": 9223.56,
      "text": "她勞德蘭斯啊"
    },
    {
      "end": 9225.56,
      "start": 9224.52,
      "text": "斯人飛機啊"
    },
    {
      "end": 9227.56,
      "start": 9225.56,
      "text": "你這是多變態的這種想法"
    },
    {
      "end": 9228.56,
      "start": 9227.56,
      "text": "它是很重要的"
    },
    {
      "end": 9231.56,
      "start": 9228.56,
      "text": "這個女的甚至比習近平女的重要的"
    },
    {
      "end": 9235.0,
      "start": 9231.56,
      "text": "你們持續關注那個推特賬號"
    },
    {
      "end": 9236.3,
      "start": 9235.0,
      "text": "會很有意思的啊"
    },
    {
      "end": 9238.3,
      "start": 9236.3,
      "text": "這就是變態"
    },
    {
      "end": 9240.3,
      "start": 9238.3,
      "text": "那麼現在俄羅斯跟中共之間的這種變態"
    },
    {
      "end": 9241.3,
      "start": 9240.3,
      "text": "出了個國了"
    },
    {
      "end": 9243.3,
      "start": 9241.3,
      "text": "這對我們爆料革命絕對有利的"
    },
    {
      "end": 9245.3,
      "start": 9243.3,
      "text": "據習美國人也知道這個情況"
    },
    {
      "end": 9245.9,
      "start": 9245.3,
      "text": "為什麼"
    },
    {
      "end": 9246.8,
      "start": 9245.9,
      "text": "提前告訴美國"
    },
    {
      "end": 9248.92,
      "start": 9246.8,
      "text": "我們會向中共明確表態"
    },
    {
      "end": 9252.66,
      "start": 9248.92,
      "text": "這是大事啊"
    },
    {
      "end": 9253.66,
      "start": 9252.66,
      "text": "先蝎子下個問題"
    },
    {
      "end": 9254.66,
      "start": 9253.66,
      "text": "謝謝"
    },
    {
      "end": 9262.86,
      "start": 9254.66,
      "text": "那個要不嘉賓們再問問問題"
    },
    {
      "end": 9264.7,
      "start": 9262.86,
      "text": "那個大連先生你有問題嗎"
    },
    {
      "end": 9266.3,
      "start": 9264.7,
      "text": "好的"
    },
    {
      "end": 9267.4,
      "start": 9266.3,
      "text": "有的問題"
    },
    {
      "end": 9268.0,
      "start": 9267.4,
      "text": "謝謝"
    },
    {
      "end": 9270.2,
      "start": 9268.0,
      "text": "因為之前一直聽七哥直播"
    },
    {
      "end": 9272.22,
      "start": 9270.2,
      "text": "其實發生這個俄羅斯這個事"
    },
    {
      "end": 9274.62,
      "start": 9272.22,
      "text": "有就是在我心目當中一點都不意外"
    },
    {
      "end": 9275.92,
      "start": 9274.62,
      "text": "這也在預料之中"
    },
    {
      "end": 9279.92,
      "start": 9275.92,
      "text": "就是七哥之前很早前直播也都透露過"
    },
    {
      "end": 9282.46,
      "start": 9279.92,
      "text": "只是我站在個人角度有點無法理解"
    },
    {
      "end": 9285.16,
      "start": 9282.46,
      "text": "這共產黨怎麼那麼多高人"
    },
    {
      "end": 9288.66,
      "start": 9285.16,
      "text": "就別人過來都不吃你的東西"
    },
    {
      "end": 9289.96,
      "start": 9288.66,
      "text": "再光這一點的話"
    },
    {
      "end": 9293.18,
      "start": 9289.96,
      "text": "都不可能說跟你做最後的說生死"
    },
    {
      "end": 9294.94,
      "start": 9293.18,
      "text": "站在寫棒的打台灣"
    },
    {
      "end": 9296.74,
      "start": 9294.94,
      "text": "或者做這麼大的交易"
    },
    {
      "end": 9299.14,
      "start": 9296.74,
      "text": "我就是跟別人談了一天"
    },
    {
      "end": 9301.12,
      "start": 9299.14,
      "text": "把自己身家的生意都談完了"
    },
    {
      "end": 9302.94,
      "start": 9301.12,
      "text": "晚上邀請對方到我家吃頓飯"
    },
    {
      "end": 9303.98,
      "start": 9302.94,
      "text": "別人都不來"
    },
    {
      "end": 9304.88,
      "start": 9303.98,
      "text": "別人嫌棄你"
    },
    {
      "end": 9306.62,
      "start": 9304.88,
      "text": "或者說不相信你"
    },
    {
      "end": 9308.42,
      "start": 9306.62,
      "text": "這怎麼可能生意能成呢"
    },
    {
      "end": 9310.12,
      "start": 9308.42,
      "text": "但我的問題就是"
    },
    {
      "end": 9312.26,
      "start": 9310.12,
      "text": "因為冬奧會已經被滅了"
    },
    {
      "end": 9314.96,
      "start": 9312.26,
      "text": "被我們爆料革命滅了"
    },
    {
      "end": 9318.46,
      "start": 9314.96,
      "text": "那共產黨會不會提前對台灣動手呢"
    },
    {
      "end": 9321.34,
      "start": 9318.46,
      "text": "在結合俄羅斯的這種情況"
    },
    {
      "end": 9322.6,
      "start": 9321.34,
      "text": "對他來說"
    },
    {
      "end": 9324.1,
      "start": 9322.6,
      "text": "對他來說是不是會不會想不到"
    },
    {
      "end": 9326.38,
      "start": 9324.1,
      "text": "就越脫越不好這種情況"
    },
    {
      "end": 9326.88,
      "start": 9326.38,
      "text": "謝謝"
    },
    {
      "end": 9331.78,
      "start": 9326.88,
      "text": "我覺得冬奧會這件事情對他們打擊"
    },
    {
      "end": 9333.08,
      "start": 9331.78,
      "text": "這是一個"
    },
    {
      "end": 9333.78,
      "start": 9333.08,
      "text": "大家記住"
