  "segments": [
    {
      "end": 7203.0,
      "start": 7200.0,
      "text": "生理的优越性和文化的多样性"
    },
    {
      "end": 7206.72,
      "start": 7204.2,
      "text": "所以它住进和中国不可能成为共产党"
    },
    {
      "end": 7208.32,
      "start": 7206.72,
      "text": "它骨子里不会给你成为共产党"
    },
    {
      "end": 7211.28,
      "start": 7209.24,
      "text": "再加上农业啊 地理位置啊"
    },
    {
      "end": 7212.88,
      "start": 7211.28,
      "text": "各方面它永远地理位置"
    },
    {
      "end": 7214.28,
      "start": 7212.88,
      "text": "战略它俩永远不会成为共产党"
    },
    {
      "end": 7218.32,
      "start": 7216.28,
      "text": "所以这种情况下看到我们过去"
    },
    {
      "end": 7221.36,
      "start": 7218.88,
      "text": "共产党所谓SVIA来的是"
    },
    {
      "end": 7223.68,
      "start": 7221.6,
      "text": "是因为它的武器 它的工业"
    },
    {
      "end": 7226.0,
      "start": 7224.88,
      "text": "还有一个北边"
    },
    {
      "end": 7228.44,
      "start": 7226.0,
      "text": "它经不起中国的北边是最弱的"
    },
    {
      "end": 7231.72,
      "start": 7228.44,
      "text": "中国从来是从过去的五千年"
    },
    {
      "end": 7236.76,
      "start": 7231.72,
      "text": "就是墓民族 墓墓族到南边的耕地族"
    },
    {
      "end": 7240.2,
      "start": 7236.76,
      "text": "把你打了 抢你的石头 抢你完 回去了"
    },
    {
      "end": 7241.96,
      "start": 7240.2,
      "text": "或者在这块执政 执政完了以后"
    },
    {
      "end": 7243.08,
      "start": 7241.96,
      "text": "它自己变成了汉民"
    },
    {
      "end": 7246.28,
      "start": 7243.08,
      "text": "然后呢 耕地族又被北边又来了 越来越这样"
    },
    {
      "end": 7250.6,
      "start": 7246.28,
      "text": "整个中国从历史的北边和到俄罗斯"
    },
    {
      "end": 7252.12,
      "start": 7250.6,
      "text": "永远都是战争"
    },
    {
      "end": 7254.92,
      "start": 7253.48,
      "text": "它现在也没改变"
    },
    {
      "end": 7260.2,
      "start": 7254.92,
      "text": "那么整个中国在任何情况下到现在为止"
    },
    {
      "end": 7263.24,
      "start": 7260.2,
      "text": "根本没办法抵御北边大门的安全"
    },
    {
      "end": 7266.6,
      "start": 7263.24,
      "text": "这就是中国人的风水上"
    },
    {
      "end": 7270.28,
      "start": 7266.6,
      "text": "东北西北一个叫银厄之首"
    },
    {
      "end": 7273.32,
      "start": 7270.28,
      "text": "西北叫银厄大凶"
    },
    {
      "end": 7275.08,
      "start": 7273.32,
      "text": "东北为大凶之位"
    },
    {
      "end": 7276.2,
      "start": 7275.08,
      "text": "战争之位"
    },
    {
      "end": 7278.6,
      "start": 7276.2,
      "text": "中国的风水就决定了中国的历史"
    },
    {
      "end": 7280.6,
      "start": 7278.6,
      "text": "你都看得很清楚了"
    },
    {
      "end": 7285.88,
      "start": 7280.6,
      "text": "所以说咱们俄罗斯和中国之间永远是被利用的"
    },
    {
      "end": 7288.92,
      "start": 7285.88,
      "text": "二战 中日 中枢"
    },
    {
      "end": 7292.68,
      "start": 7288.92,
      "text": "所有的过去大清朝 明朝 宋朝"
    },
    {
      "end": 7295.88,
      "start": 7292.68,
      "text": "再往前推汉朝 无不如此"
    },
    {
      "end": 7299.64,
      "start": 7295.88,
      "text": "包括现在的土耳其和俄罗斯的关系"
    },
    {
      "end": 7303.16,
      "start": 7299.64,
      "text": "死海 从死海到黑海 整个的关系"
    },
    {
      "end": 7305.16,
      "start": 7303.16,
      "text": "地理 天然 人性 文化"
    },
    {
      "end": 7307.16,
      "start": 7305.16,
      "text": "注定俄罗斯和中国不会成立"
    },
    {
      "end": 7310.6,
      "start": 7307.16,
      "text": "所以现在习跟它之间是一种灾难性的错误"
    },
    {
      "end": 7315.16,
      "start": 7310.6,
      "text": "现在俄罗斯已经在越南 在柬埔寨"
    },
    {
      "end": 7321.56,
      "start": 7315.16,
      "text": "还有那个什么 菲律宾都要搞军事基地了"
    },
    {
      "end": 7325.48,
      "start": 7321.56,
      "text": "都要搞军事基地 人家已经开油快八九个月了"
    },
    {
      "end": 7327.4,
      "start": 7325.48,
      "text": "每天就在那里转着油转起"
    },
    {
      "end": 7330.2,
      "start": 7327.4,
      "text": "中国不敢说一句话"
    },
    {
      "end": 7333.96,
      "start": 7330.2,
      "text": "习本身就是宠俄派"
    },
    {
      "end": 7335.8,
      "start": 7333.96,
      "text": "这也是绕天一安排"
    },
    {
      "end": 7337.84,
      "start": 7335.8,
      "text": "他本身就是宠俄派"
    },
    {
      "end": 7340.92,
      "start": 7337.84,
      "text": "他宠拜斯大林"
    },
    {
      "end": 7343.96,
      "start": 7340.92,
      "text": "他宠拜希特勒"
    },
    {
      "end": 7347.8,
      "start": 7343.96,
      "text": "他宠拜当年的沙皇"
    },
    {
      "end": 7349.96,
      "start": 7347.8,
      "text": "你去看吧 他宠拜这几个人"
    },
    {
      "end": 7353.56,
      "start": 7349.96,
      "text": "现在他越来越像那几个人了"
    },
    {
      "end": 7356.52,
      "start": 7353.56,
      "text": "所以说在这种情况下注定了"
    },
    {
      "end": 7361.16,
      "start": 7356.52,
      "text": "中国人民要为俄罗斯陪葬一百年"
    },
    {
      "end": 7364.84,
      "start": 7361.16,
      "text": "从1912年到现在一直会陪葬下来"
    },
    {
      "end": 7367.0,
      "start": 7364.84,
      "text": "最后结束共产党"
    },
    {
      "end": 7368.44,
      "start": 7367.0,
      "text": "这是一定的结局"
    },
    {
      "end": 7370.76,
      "start": 7368.44,
      "text": "中国和苏之间可以和平相处"
    },
    {
      "end": 7373.48,
      "start": 7370.76,
      "text": "不可能成为紧密的恐怖"
    },
    {
      "end": 7375.08,
      "start": 7373.48,
      "text": "谢谢 等一下我打个电话"
    },
    {
      "end": 7377.32,
      "start": 7375.08,
      "text": "你们先说着啊"
    },
    {
      "end": 7379.88,
      "start": 7377.32,
      "text": "正在看直播的战友"
    },
    {
      "end": 7381.56,
      "start": 7379.88,
      "text": "你们老让我回电话"
    },
    {
      "end": 7382.6,
      "start": 7381.56,
      "text": "我在直播呢"
    },
    {
      "end": 7384.68,
      "start": 7382.6,
      "text": "你说你在国内我也不能不回啊"
    },
    {
      "end": 7385.08,
      "start": 7384.68,
      "text": "你先说"
    },
    {
      "end": 7389.88,
      "start": 7385.08,
      "text": "好了 这个文贵先生离开了"
    },
    {
      "end": 7391.16,
      "start": 7389.88,
      "text": "今天的这个话题呢"
    },
    {
      "end": 7393.96,
      "start": 7391.16,
      "text": "比较多 没有固定的话题"
    },
    {
      "end": 7396.92,
      "start": 7393.96,
      "text": "导致我也不知道该怎么去主持"
    },
    {
      "end": 7398.76,
      "start": 7396.92,
      "text": "现在文贵先生又走了"
    },
    {
      "end": 7400.6,
      "start": 7398.76,
      "text": "我都不知道该咋整了"
    },
    {
      "end": 7403.16,
      "start": 7400.6,
      "text": "那我先简单 我也谈一谈"
    },
    {
      "end": 7404.12,
      "start": 7403.16,
      "text": "本来是不想谈的"
    },
    {
      "end": 7405.24,
      "start": 7404.12,
      "text": "但是文贵先生走了"
    },
    {
      "end": 7406.84,
      "start": 7405.24,
      "text": "咱们得掐住这个时间"
    },
    {
      "end": 7412.36,
      "start": 7406.84,
      "text": "就说刚才文贵先生讲到双十二的重大的历史的事件"
    },
    {
      "end": 7414.68,
      "start": 7412.36,
      "text": "完了之后提到了一个断代的问题"
    },
    {
      "end": 7416.2,
      "start": 7414.68,
      "text": "就在那个时候"
    },
    {
      "end": 7420.68,
      "start": 7416.2,
      "text": "中华民族整个社会都处在一个断代的一个时间档口"
    },
    {
      "end": 7424.2,
      "start": 7420.68,
      "text": "那么那个时候如果历史不是朝那个方向发展的话"
    },
    {
      "end": 7427.8,
      "start": 7424.2,
      "text": "很可能我们在很短的时间内就会有我们自己的"
    },
    {
      "end": 7433.96,
      "start": 7427.8,
      "text": "另外的一个完全自不同的一个民族的一个发展"
    },
    {
      "end": 7436.12,
      "start": 7433.96,
      "text": "一个中国"
    },
    {
      "end": 7437.8,
      "start": 7436.12,
      "text": "那么其实我就在想"
    },
    {
      "end": 7440.2,
      "start": 7437.8,
      "text": "对 还有他也讲说"
    },
    {
      "end": 7444.12,
      "start": 7440.2,
      "text": "现在咱们这个要再出现这么一个断代的话"
    },
    {
      "end": 7445.48,
      "start": 7444.12,
      "text": "代价非常非常大"
    },
    {
      "end": 7446.84,
      "start": 7445.48,
      "text": "但是我就想说"
    },
    {
      "end": 7449.08,
      "start": 7446.84,
      "text": "我们现在新中国联邦爆料革命"
    },
    {
      "end": 7451.96,
      "start": 7449.08,
      "text": "其实是有一种成天意的感觉"
    },
    {
      "end": 7452.68,
      "start": 7451.96,
      "text": "因为什么呢"
    },
    {
      "end": 7455.4,
      "start": 7452.68,
      "text": "因为刚才讲到这个iTunes打榜"
    },
    {
      "end": 7458.28,
      "start": 7455.4,
      "text": "实际上有7000多万的这样的一个打榜"
    },
    {
      "end": 7461.48,
      "start": 7458.28,
      "text": "但实际上已经被共产党压到只剩200多万"
    },
    {
      "end": 7463.56,
      "start": 7461.48,
      "text": "那么我们去看这个7000多万的时候"
    },
    {
      "end": 7465.32,
      "start": 7463.56,
      "text": "我想这个数字虽然只是一个数字"
    },
    {
      "end": 7467.24,
      "start": 7465.32,
      "text": "但是它背后代表的一个意义是"
    },
    {
      "end": 7470.76,
      "start": 7467.24,
      "text": "我们有这么多勇敢善良正义"
    },
    {
      "end": 7474.52,
      "start": 7470.76,
      "text": "明是非的我们的中国人新中国联邦人"
    },
    {
      "end": 7477.64,
      "start": 7474.52,
      "text": "然后这是一个多么多么强大的一个"
    },
    {
      "end": 7479.24,
      "start": 7477.64,
      "text": "一个我们未来的一个基石"
    },
    {
      "end": 7480.92,
      "start": 7479.24,
      "text": "我们拥有这样的一个基石"
    },
    {
      "end": 7484.28,
      "start": 7480.92,
      "text": "实际上我们就可以弥补掉那个断代的不存在"
    },
    {
      "end": 7485.64,
      "start": 7484.28,
      "text": "我们可以用这样的一个基石"
    },
    {
      "end": 7487.16,
      "start": 7485.64,
      "text": "我们可以去打造一个更美好的"
    },
    {
      "end": 7493.32,
      "start": 7487.16,
      "text": "更加的民族的更加文明的这样的一个新中国联邦"
    },
    {
      "end": 7494.36,
      "start": 7493.32,
      "text": "和我们的未来"
    },
    {
      "end": 7495.96,
      "start": 7494.36,
      "text": "我就想说这么多"
    },
    {
      "end": 7497.72,
      "start": 7495.96,
      "text": "但文贵先生还没回来"
    },
    {
      "end": 7501.16,
      "start": 7497.72,
      "text": "那个大根先生你再来一段好吗"
    },
    {
      "end": 7503.0,
      "start": 7501.16,
      "text": "好的谢谢你"
    },
    {
      "end": 7508.12,
      "start": 7503.0,
      "text": "这个事情就是听刚刚七哥说的意思就是断代"
    },
    {
      "end": 7509.24,
      "start": 7508.12,
      "text": "想出现断代"
    },
    {
      "end": 7512.04,
      "start": 7509.24,
      "text": "它的代价就是人命"
    },
    {
      "end": 7515.84,
      "start": 7512.04,
      "text": "就是我觉得就是可以弥补"
    },
    {
      "end": 7518.2,
      "start": 7515.84,
      "text": "但是这个是无法替代的"
    },
    {
      "end": 7523.56,
      "start": 7518.2,
      "text": "所以说现在的话反正就很难受嘛"
    },
    {
      "end": 7526.44,
      "start": 7523.56,
      "text": "我们都看得到就是即将到来的这些"
    },
    {
      "end": 7529.32,
      "start": 7526.44,
      "text": "这些事情特别像疫苗啊"
    },
    {
      "end": 7532.6,
      "start": 7529.32,
      "text": "就是特别像国内接种的这个人数"
    },
    {
      "end": 7537.64,
      "start": 7532.6,
      "text": "然后如果从这一点上来看的话"
    },
    {
      "end": 7541.08,
      "start": 7537.64,
      "text": "我们又即将迎来这个断代"
    },
    {
      "end": 7544.92,
      "start": 7541.08,
      "text": "所以说这个可能是我们作为一个中国人啊"
    },
    {
      "end": 7546.44,
      "start": 7544.92,
      "text": "几千年来"
    },
    {
      "end": 7551.72,
      "start": 7546.44,
      "text": "甚至我我个人觉得再加上几千年之后"
    },
    {
      "end": 7554.04,
      "start": 7551.72,
      "text": "这是我们唯一的一次机会了"
    },
    {
      "end": 7558.28,
      "start": 7554.04,
      "text": "就是因为七哥能出生在中国这种概率"
    },
    {
      "end": 7560.92,
      "start": 7558.28,
      "text": "就是七哥但凡不是出生在中国"
    },
    {
      "end": 7564.36,
      "start": 7560.92,
      "text": "我相信他不会说为一个另一个国家做"
    },
    {
      "end": 7567.56,
      "start": 7564.36,
      "text": "就是做做另一个民族做这些事情"
    },
    {
      "end": 7571.88,
      "start": 7567.56,
      "text": "就是我我个人觉得就是这是我们唯一的机会了"
    },
    {
      "end": 7574.2,
      "start": 7571.88,
      "text": "几千来年来几千年之后"
    },
    {
      "end": 7577.8,
      "start": 7574.2,
      "text": "所以说直接给他干干完算了"
    },
    {
      "end": 7580.28,
      "start": 7577.8,
      "text": "就是大家过过正常日子"
    },
    {
      "end": 7581.48,
      "start": 7580.28,
      "text": "谢谢"
    },
    {
      "end": 7584.68,
      "start": 7583.48,
      "text": "谢谢大根先生"
    },
    {
      "end": 7586.68,
      "start": 7584.68,
      "text": "啊那我这边也不怎么多说了"
    },
    {
      "end": 7588.68,
      "start": 7586.68,
      "text": "我看那个评论区都在说"
    },
    {
      "end": 7590.44,
      "start": 7588.68,
      "text": "大家希望文贵先生快说来"
    },
    {
      "end": 7591.88,
      "start": 7590.44,
      "text": "没有今天没有PPT了"
    },
    {
      "end": 7592.76,
      "start": 7591.88,
      "text": "那我就大概分享"
    },
    {
      "end": 7595.56,
      "start": 7592.76,
      "text": "就是我觉得这个我对爆料革命非常非常感恩"
    },
    {
      "end": 7596.92,
      "start": 7595.56,
      "text": "就是刚刚文贵先生也说了"
    },
    {
      "end": 7599.16,
      "start": 7596.92,
      "text": "其实这个爆料革命的过程"
    },
    {
      "end": 7600.84,
      "start": 7599.16,
      "text": "其实也是个渐身渐心的过程"
    },
    {
      "end": 7602.12,
      "start": 7600.84,
      "text": "我们心定了"
    },
    {
      "end": 7605.0,
      "start": 7602.12,
      "text": "你看透了物了以后才不会才不会乱"
    },
    {
      "end": 7607.4,
      "start": 7605.0,
      "text": "尤其尤其是就是咱们做爆了革命"
    },
    {
      "end": 7609.24,
      "start": 7607.4,
      "text": "和很多很多的战友有接触"
    },
    {
      "end": 7610.6,
      "start": 7609.24,
      "text": "每个人的人心也不一样"
    },
    {
      "end": 7611.32,
      "start": 7610.6,
      "text": "那这个"
    },
    {
      "end": 7613.64,
      "start": 7611.32,
      "text": "这个怎么样我们来就是解决这个问题"
    },
    {
      "end": 7615.0,
      "start": 7613.64,
      "text": "怎么样面对这个问题"
    },
    {
      "end": 7616.92,
      "start": 7615.0,
      "text": "而这个也是我最近一直在思考的"
    },
    {
      "end": 7619.24,
      "start": 7616.92,
      "text": "就是我觉得战友就是对我们都非常宽容"
    },
    {
      "end": 7622.12,
      "start": 7619.24,
      "text": "比如说我我是从来没有做过主持这个"
    },
    {
      "end": 7624.44,
      "start": 7622.12,
      "text": "有时候这个播报也非常接宝"
    },
    {
      "end": 7625.72,
      "start": 7624.44,
      "text": "然后大家都是非常的鼓励"
    },
    {
      "end": 7626.52,
      "start": 7625.72,
      "text": "我觉得非常感恩"
    },
    {
      "end": 7628.28,
      "start": 7626.52,
      "text": "但是对我本身而言"
    },
    {
      "end": 7629.24,
      "start": 7628.28,
      "text": "我自己也很清楚"
    },
    {
      "end": 7630.68,
      "start": 7629.24,
      "text": "我我是不专业的"
    },
    {
      "end": 7633.4,
      "start": 7630.68,
      "text": "然后还有呢就是这个有时候土字也不清楚"
    },
    {
      "end": 7634.68,
      "start": 7633.4,
      "text": "很多是需要练习的"
    },
    {
      "end": 7636.92,
      "start": 7634.68,
      "text": "所以这个对自己的认识一定要非常清楚"
    },
    {
      "end": 7637.96,
      "start": 7636.92,
      "text": "然后每次我"
    },
    {
      "end": 7640.84,
      "start": 7637.96,
      "text": "我在想我说就是早上那个我祷告的时候"
    },
    {
      "end": 7642.2,
      "start": 7640.84,
      "text": "我给大家快速分享一下"
    },
    {
      "end": 7643.32,
      "start": 7642.2,
      "text": "我都不好意思说太多"
    },
    {
      "end": 7644.68,
      "start": 7643.32,
      "text": "对就是有一个四步"
    },
    {
      "end": 7647.24,
      "start": 7644.68,
      "text": "就第一个就是英文的叫Pray"
    },
    {
      "end": 7647.88,
      "start": 7647.24,
      "text": "就是Pray"
    },
    {
      "end": 7648.52,
      "start": 7647.88,
      "text": "Praise"
    },
    {
      "end": 7649.88,
      "start": 7648.52,
      "text": "就是第一个你首先要赞美"
    },
    {
      "end": 7651.56,
      "start": 7649.88,
      "text": "就像文贵先生说要感恩"
    },
    {
      "end": 7652.76,
      "start": 7651.56,
      "text": "然后第二个呢就是Repent"
    },
    {
      "end": 7654.6,
      "start": 7652.76,
      "text": "就是你要你要就是反馈自己"
    },
    {
      "end": 7655.88,
      "start": 7654.6,
      "text": "就是就是就就祷告说"
    },
    {
      "end": 7657.64,
      "start": 7655.88,
      "text": "你觉得你哪里面做的错的"
    },
    {
      "end": 7658.84,
      "start": 7657.64,
      "text": "祈祷神的原谅"
    },
    {
      "end": 7660.12,
      "start": 7658.84,
      "text": "然后就是第三个"
    },
    {
      "end": 7660.84,
      "start": 7660.12,
      "text": "第三个是A"
    },
    {
      "end": 7661.44,
      "start": 7660.84,
      "text": "就是Ask"
    },
    {
      "end": 7664.44,
      "start": 7661.44,
      "text": "你要向神就是想要就是祈祷祷告"
    },
    {
      "end": 7665.56,
      "start": 7664.44,
      "text": "然后最后一个是Yield"
    },
    {
      "end": 7666.76,
      "start": 7665.56,
      "text": "就是你这完全放松"
    },
    {
      "end": 7668.84,
      "start": 7666.76,
      "text": "就是让神告诉你的一个消息"
    },
    {
      "end": 7670.12,
      "start": 7668.84,
      "text": "所以每次我在第二步"
    },
    {
      "end": 7671.08,
      "start": 7670.12,
      "text": "就是在这个Repent"
    },
    {
      "end": 7672.72,
      "start": 7671.08,
      "text": "就是反省的过程中"
    },
    {
      "end": 7673.64,
      "start": 7672.72,
      "text": "我就觉得"
    },
    {
      "end": 7675.52,
      "start": 7673.64,
      "text": "觉得如果就是我"
    },
    {
      "end": 7676.32,
      "start": 7675.52,
      "text": "我就是怎么说"
    },
    {
      "end": 7677.72,
      "start": 7676.32,
      "text": "这个这个是神给我"
    },
    {
      "end": 7678.88,
      "start": 7677.72,
      "text": "我觉得我能坐在这里"
    },
    {
      "end": 7680.08,
      "start": 7678.88,
      "text": "是因为神觉得"
    },
    {
      "end": 7682.96,
      "start": 7680.08,
      "text": "我有这个一定的一定程度的这个这个"
    },
    {
      "end": 7683.88,
      "start": 7682.96,
      "text": "啊"
    },
    {
      "end": 7686.76,
      "start": 7683.88,
      "text": "才才能来帮就是神来传递他"
    },
    {
      "end": 7689.88,
      "start": 7686.76,
      "text": "我们我们应该做的这个传播真相的这个事情"
    },
    {
      "end": 7691.08,
      "start": 7689.88,
      "text": "但是如果我"
    },
    {
      "end": 7692.64,
      "start": 7691.08,
      "text": "我觉得我是真成了神了"
    },
    {
      "end": 7695.2,
      "start": 7692.64,
      "text": "我觉得我把神的这个给我的能力"
    },
    {
      "end": 7696.28,
      "start": 7695.2,
      "text": "我觉得我就是神了"
    },
    {
      "end": 7697.36,
      "start": 7696.28,
      "text": "但是完全不可以的"
    },
    {
      "end": 7697.8,
      "start": 7697.36,
      "text": "就是"
    },
    {
      "end": 7698.92,
      "start": 7697.8,
      "text": "所以每天我都觉得就是"
    },
    {
      "end": 7700.56,
      "start": 7698.92,
      "text": "我觉得站有非常大"
    },
    {
      "end": 7702.48,
      "start": 7700.56,
      "text": "就是怎么说宽容啊"
    },
    {
      "end": 7705.36,
      "start": 7702.48,
      "text": "就是但是我们还有很多需要成长努力的地方啊"
    },
    {
      "end": 7705.68,
      "start": 7705.36,
      "text": "不好意思"
    },
    {
      "end": 7706.32,
      "start": 7705.68,
      "text": "今天说太多了"
    },
    {
      "end": 7706.96,
      "start": 7706.32,
      "text": "很激动"
    },
    {
      "end": 7708.16,
      "start": 7706.96,
      "text": "好"
    },
    {
      "end": 7709.36,
      "start": 7708.16,
      "text": "谢谢您请"
    },
    {
      "end": 7711.6,
      "start": 7709.36,
      "text": "感谢小新啊"
    },
    {
      "end": 7713.24,
      "start": 7711.6,
      "text": "她小新非常的谦逊"
    },
    {
      "end": 7717.12,
      "start": 7713.24,
      "text": "其实谦逊本身就是一个人的品质啊"
    },
    {
      "end": 7718.68,
      "start": 7717.12,
      "text": "非常优良的一个品质"
    },
    {
      "end": 7723.14,
      "start": 7718.68,
      "text": "因为你首先谦逊你才能对别人包容"
    },
    {
      "end": 7725.88,
      "start": 7723.14,
      "text": "然后呢才能自我反省去提升自己"
    },
    {
      "end": 7727.44,
      "start": 7725.88,
      "text": "所以有这种品质的人呢"
    },
    {
      "end": 7729.16,
      "start": 7727.44,
      "text": "将来一定是非常优秀的"
    },
    {
      "end": 7733.12,
      "start": 7729.16,
      "text": "那么我参与爆料革命这四五年来呢"
    },
    {
      "end": 7734.86,
      "start": 7733.12,
      "text": "我的最大的体会呢"
    },
    {
      "end": 7737.36,
      "start": 7734.86,
      "text": "就是我们战友之间一定要包容"
    },
    {
      "end": 7739.08,
      "start": 7737.36,
      "text": "每个人都每个人缺点"
    },
    {
      "end": 7741.88,
      "start": 7739.08,
      "text": "但是呢我们有一个共同的基础"
    },
    {
      "end": 7742.92,
      "start": 7741.88,
      "text": "共同的目标呢"
    },
    {
      "end": 7746.5,
      "start": 7742.92,
      "text": "我们去建立这个目标和基础的情况下呢"
    },
    {
      "end": 7747.38,
      "start": 7746.5,
      "text": "我们去包容"
    },
    {
      "end": 7749.96,
      "start": 7747.38,
      "text": "但是呢正如今天的话题"
    },
    {
      "end": 7752.08,
      "start": 7749.96,
      "text": "1212呢"
    },
    {
      "end": 7752.98,
      "start": 7752.08,
      "text": "他这个张旭良"
    },
    {
      "end": 7754.92,
      "start": 7752.98,
      "text": "他就是一个最大的一个欺民贼"
    },
    {
      "end": 7756.92,
      "start": 7754.92,
      "text": "所以我们现在就看出来"
    },
    {
      "end": 7762.36,
      "start": 7756.92,
      "text": "从最初跟随七哥的那些所谓的什么战友"
    },
    {
      "end": 7764.76,
      "start": 7762.36,
      "text": "那什么假牧师啊什么"
    },
    {
      "end": 7766.98,
      "start": 7764.76,
      "text": "这两天我发现一个问题"
    },
    {
      "end": 7768.4,
      "start": 7766.98,
      "text": "想跟大家分享啊"
    },
    {
      "end": 7769.54,
      "start": 7768.4,
      "text": "这个假牧师呢"
    },
    {
      "end": 7772.48,
      "start": 7769.54,
      "text": "他已经打了三针的疫苗"
    },
    {
      "end": 7776.12,
      "start": 7772.48,
      "text": "所以我们爆料革命有多么的难能可贵"
    },
    {
      "end": 7777.7,
      "start": 7776.12,
      "text": "我们本身我们爆料革命战友"
    },
    {
      "end": 7779.04,
      "start": 7777.7,
      "text": "大家都没有打疫苗"
    },
    {
      "end": 7782.0,
      "start": 7779.04,
      "text": "而且我们知道这个疫苗的危机"
    },
    {
      "end": 7785.0,
      "start": 7782.0,
      "text": "通过七哥知道这个疫苗的灾害和危机"
    },
    {
      "end": 7789.02,
      "start": 7785.0,
      "text": "和将来的那种巨大的这个黑暗的势力"
    },
    {
      "end": 7791.06,
      "start": 7789.02,
      "text": "那么这些欺民贼"
    },
    {
      "end": 7794.94,
      "start": 7791.06,
      "text": "能曾经和我们爆料革命有缘相识"
    },
    {
      "end": 7796.98,
      "start": 7794.94,
      "text": "但是呢无缘跟随下去"
    },
    {
      "end": 7798.26,
      "start": 7796.98,
      "text": "那就是他的本质"
    },
    {
      "end": 7802.18,
      "start": 7798.26,
      "text": "他本身的那种个性的那种狂妄自大"
    },
    {
      "end": 7804.8,
      "start": 7802.18,
      "text": "以及他本身的不具备这种谦逊"
    },
    {
      "end": 7806.36,
      "start": 7804.8,
      "text": "所以他走不到最后嘛"
    },
    {
      "end": 7808.64,
      "start": 7806.36,
      "text": "包括录大脑片"
    },
    {
      "end": 7809.8,
      "start": 7808.64,
      "text": "还有九指药"
    },
    {
      "end": 7813.6,
      "start": 7809.8,
      "text": "他们呢其实也是张学良一类的代表"
    },
    {
      "end": 7814.6,
      "start": 7813.6,
      "text": "虽然没有他们出名"
    },
    {
      "end": 7817.64,
      "start": 7814.6,
      "text": "但是呢他们也是这种人性的这种卑微"
    },
    {
      "end": 7820.62,
      "start": 7817.64,
      "text": "和这种自私狂妄自大"
    },
    {
      "end": 7823.08,
      "start": 7820.62,
      "text": "导致了他们目前的这种情况"
    },
    {
      "end": 7826.28,
      "start": 7823.08,
      "text": "所以我认为大家都是占有"
    },
    {
      "end": 7830.2,
      "start": 7826.28,
      "text": "包容 谦逊是一个最好的一个品质"
    },
    {
      "end": 7832.28,
      "start": 7830.2,
      "text": "大家去在这个基础上去包容"
    },
    {
      "end": 7833.62,
      "start": 7832.28,
      "text": "好 我们的七哥来了"
    },
    {
      "end": 7836.34,
      "start": 7833.62,
      "text": "请我们七哥继续跟我们分享"
    },
    {
      "end": 7843.6,
      "start": 7838.64,
      "text": "七哥没声音"
    },
    {
      "end": 7845.6,
      "start": 7843.6,
      "text": "七哥忘记开麦了"
    },
    {
      "end": 7849.56,
      "start": 7845.6,
      "text": "我七哥同时都干五件事啊"
    },
    {
      "end": 7851.56,
      "start": 7849.56,
      "text": "卡丽奖非常好"
    },
    {
      "end": 7854.04,
      "start": 7851.56,
      "text": "这个国内的有战友说"
    },
    {
      "end": 7856.64,
      "start": 7854.04,
      "text": "这个关于对失恋的解读特别好"
    },
    {
      "end": 7858.76,
      "start": 7856.64,
      "text": "然后这很好"
    },
    {
      "end": 7861.6,
      "start": 7858.76,
      "text": "咱们这个女性啊"
    },
    {
      "end": 7864.0,
      "start": 7861.6,
      "text": "这个她是一个很成功的"
    },
    {
      "end": 7866.32,
      "start": 7864.0,
      "text": "从这个清华出来的高材生"
    },
    {
      "end": 7867.72,
      "start": 7866.32,
      "text": "失恋了啊"
    },
    {
      "end": 7869.8,
      "start": 7867.72,
      "text": "最近说很很难受"
    },
    {
      "end": 7874.4,
      "start": 7869.8,
      "text": "我就给大家我就想一想啊"
    },
    {
      "end": 7876.72,
      "start": 7874.4,
      "text": "我是过来人了"
    },
    {
      "end": 7878.72,
      "start": 7876.72,
      "text": "你们有过的我都有过"
    },
    {
      "end": 7881.6,
      "start": 7878.72,
      "text": "而且我快速的都快成班是吧"
    },
    {
      "end": 7883.8,
      "start": 7881.6,
      "text": "我没有见过一个"
    },
    {
      "end": 7885.36,
      "start": 7883.8,
      "text": "反正我生日没见过一个"
    },
    {
      "end": 7888.32,
      "start": 7885.36,
      "text": "像中国人传说的梁山波 朱英台呀"
    },
    {
      "end": 7890.32,
      "start": 7888.32,
      "text": "罗密尾 朱利叶呀"
    },
    {
      "end": 7892.32,
      "start": 7890.32,
      "text": "对方死了我就不活了"
    },
    {
      "end": 7893.32,
      "start": 7892.32,
      "text": "死了化成蝴蝶了"
    },
    {
      "end": 7894.12,
      "start": 7893.32,
      "text": "我没见过"
    },
    {
      "end": 7895.32,
      "start": 7894.12,
      "text": "我看过很多死的"
    },
    {
      "end": 7896.32,
      "start": 7895.32,
      "text": "是吧"
    },
    {
      "end": 7898.32,
      "start": 7896.32,
      "text": "但对方很快都成婚了"
    },
    {
      "end": 7900.32,
      "start": 7898.32,
      "text": "我小时候一个让我认为"
    },
    {
      "end": 7902.32,
      "start": 7900.32,
      "text": "最最让我敬重的一个人"
    },
    {
      "end": 7903.32,
      "start": 7902.32,
      "text": "哎呀"
    },
    {
      "end": 7904.84,
      "start": 7903.32,
      "text": "那个琴棋书画呀"
    },
    {
      "end": 7905.76,
      "start": 7904.84,
      "text": "那个写字呀"
    },
    {
      "end": 7907.28,
      "start": 7905.76,
      "text": "那个爱情啊"
    },
    {
      "end": 7909.36,
      "start": 7907.28,
      "text": "你说只要说到男女爱情"
    },
    {
      "end": 7910.28,
      "start": 7909.36,
      "text": "历史上"
    },
    {
      "end": 7911.92,
      "start": 7910.28,
      "text": "她通的都不行了"
    },
    {
      "end": 7913.96,
      "start": 7911.92,
      "text": "我很多清书都帮我代写"
    },
    {
      "end": 7915.36,
      "start": 7913.96,
      "text": "我给发清书啊"
    },
    {
      "end": 7917.48,
      "start": 7915.36,
      "text": "写一次领一次"
    },
    {
      "end": 7921.52,
      "start": 7917.48,
      "text": "结果她太太就出了车祸"
    },
    {
      "end": 7926.28,
      "start": 7921.52,
      "text": "她第二百天就找到了自己的心恋"
    },
    {
      "end": 7929.96,
      "start": 7926.28,
      "text": "我当时就是已经是痛恨到不行了"
    },
    {
      "end": 7931.88,
      "start": 7929.96,
      "text": "我那时候还没有今天的境界呢"
    },
    {
      "end": 7933.16,
      "start": 7931.88,
      "text": "还以为这是不对的呢"
    },
    {
      "end": 7935.68,
      "start": 7933.32,
      "text": "我跟她说"
    },
    {
      "end": 7937.88,
      "start": 7935.68,
      "text": "我说你能不能再人人呢"
    },
    {
      "end": 7939.48,
      "start": 7937.88,
      "text": "按照山东人的规矩"
    },
    {
      "end": 7940.56,
      "start": 7939.48,
      "text": "差一年"
    },
    {
      "end": 7942.08,
      "start": 7940.56,
      "text": "还有一百多天"
    },
    {
      "end": 7943.56,
      "start": 7942.08,
      "text": "能不能呢"
    },
    {
      "end": 7945.56,
      "start": 7943.56,
      "text": "她笑的时候"
    },
    {
      "end": 7946.68,
      "start": 7945.56,
      "text": "她说你觉得我是坏人是什么"
    },
    {
      "end": 7948.08,
      "start": 7946.68,
      "text": "我说你是大坏人"
    },
    {
      "end": 7949.16,
      "start": 7948.08,
      "text": "她说我告诉你"
    },
    {
      "end": 7950.48,
      "start": 7949.16,
      "text": "男女之间"
    },
    {
      "end": 7953.36,
      "start": 7950.48,
      "text": "所有之间的爱和表达"
    },
    {
      "end": 7955.12,
      "start": 7953.36,
      "text": "它无非两种方式"
    },
    {
      "end": 7957.16,
      "start": 7955.12,
      "text": "一种最重要的生意上不行"
    },
    {
      "end": 7958.08,
      "start": 7957.16,
      "text": "一切都不行"
    },
    {
      "end": 7959.28,
      "start": 7958.08,
      "text": "她都是胡扯"
    },
    {
      "end": 7960.16,
      "start": 7959.28,
      "text": "她说性不行"
    },
    {
      "end": 7961.16,
      "start": 7960.16,
      "text": "姐姐不行啊"
    },
    {
      "end": 7963.52,
      "start": 7961.16,
      "text": "我现在越来越觉得她说的是对的"
    },
    {
      "end": 7965.12,
      "start": 7963.52,
      "text": "你没有生理的爱怎么可能"
    },
    {
      "end": 7966.32,
      "start": 7965.12,
      "text": "搓淡的事情"
    },
    {
      "end": 7967.2,
      "start": 7966.32,
      "text": "她那都是战友"
    },
    {
      "end": 7968.4,
      "start": 7967.2,
      "text": "都是牺牲"
    },
    {
      "end": 7971.64,
      "start": 7968.4,
      "text": "第二个精神上没有满足的"
    },
    {
      "end": 7973.16,
      "start": 7971.64,
      "text": "如果精神得到满足的"
    },
    {
      "end": 7975.2,
      "start": 7973.16,
      "text": "她说这个就不完美"
    },
    {
      "end": 7977.24,
      "start": 7975.2,
      "text": "有生理上不完美"
    },
    {
      "end": 7980.04,
      "start": 7977.24,
      "text": "有生理可以延续婚姻"
    },
    {
      "end": 7983.84,
      "start": 7980.04,
      "text": "有生理加精神是完美的婚姻"
    },
    {
      "end": 7984.84,
      "start": 7983.84,
      "text": "我说那金钱和利益"
    },
    {
      "end": 7987.96,
      "start": 7984.84,
      "text": "她说女人就是只要性不满足"
    },
    {
      "end": 7988.9,
      "start": 7987.96,
      "text": "钱不满足"
    },
    {
      "end": 7990.84,
      "start": 7988.9,
      "text": "这女人不可能百分之百"
    },
    {
      "end": 7992.04,
      "start": 7990.84,
      "text": "这两样都满足"
    },
    {
      "end": 7992.96,
      "start": 7992.04,
      "text": "加上精神上"
    },
    {
      "end": 7995.04,
      "start": 7992.96,
      "text": "她说你就是百分之百性"
    },
    {
      "end": 7995.84,
      "start": 7995.04,
      "text": "她说现在我可以告诉你"
    },
    {
      "end": 7997.64,
      "start": 7995.84,
      "text": "我跟她已经没有性关了"
    },
    {
      "end": 7999.56,
      "start": 7998.4,
      "text": "她已经不存在"
    },
    {
      "end": 8000.76,
      "start": 7999.56,
      "text": "各位有性的关系了"
    },
    {
      "end": 8003.24,
      "start": 8000.76,
      "text": "我可以用最简单的句话"
    },
    {
      "end": 8005.0,
      "start": 8003.24,
      "text": "如果按照她说的话"
    },
    {
      "end": 8007.44,
      "start": 8005.0,
      "text": "我的幸福就是她的幸福"
    },
    {
      "end": 8008.76,
      "start": 8007.44,
      "text": "和重要的她的幸福"
    },
    {
      "end": 8010.6,
      "start": 8008.76,
      "text": "那我现在就要幸福给她看"
    },
    {
      "end": 8013.76,
      "start": 8010.6,
      "text": "我幸福她在那一间她能幸福啊"
    },
    {
      "end": 8015.2,
      "start": 8013.76,
      "text": "所以我要找结婚啊"
    },
    {
      "end": 8016.76,
      "start": 8015.2,
      "text": "找伴侣啊"
    },
    {
      "end": 8019.8,
      "start": 8016.76,
      "text": "哎你听着这是流氓逻辑啊"
    },
    {
      "end": 8021.8,
      "start": 8019.8,
      "text": "事实就这样"
    },
    {
      "end": 8023.36,
      "start": 8021.8,
      "text": "她过得好着呢"
    },
    {
      "end": 8024.64,
      "start": 8023.36,
      "text": "不幸的事情"
    },
    {
      "end": 8026.76,
      "start": 8024.64,
      "text": "她很快她也得病了"
    },
    {
      "end": 8029.12,
      "start": 8026.76,
      "text": "她的第二人妻子离她远去"
    },
    {
      "end": 8031.32,
      "start": 8029.12,
      "text": "她第二人妻子给她说的话"
    },
    {
      "end": 8032.16,
      "start": 8031.32,
      "text": "基本上的话"
    },
    {
      "end": 8034.52,
      "start": 8032.16,
      "text": "因为你不能满足我性的需要"
    },
    {
      "end": 8036.6,
      "start": 8034.52,
      "text": "所以我要找另外的幸福去了"
    },
    {
      "end": 8039.92,
      "start": 8036.6,
      "text": "因为我的幸福就是你的幸福"
    },
    {
      "end": 8042.8,
      "start": 8039.92,
      "text": "哎这回我找这哥们了啊"
    },
    {
      "end": 8044.32,
      "start": 8042.8,
      "text": "他在山东济南啊"
    },
    {
      "end": 8044.92,
      "start": 8044.32,
      "text": "我说行了"
    },
    {
      "end": 8045.92,
      "start": 8044.92,
      "text": "报应来了"
    },
    {
      "end": 8047.2,
      "start": 8045.92,
      "text": "他哈哈大笑"
    },
    {
      "end": 8049.62,
      "start": 8047.2,
      "text": "他说我真的能做到"
    },
    {
      "end": 8051.36,
      "start": 8049.62,
      "text": "他的幸福就是比我幸福"
    },
    {
      "end": 8055.0,
      "start": 8051.36,
      "text": "我这不她说啊她走了啊叫燕子啊"
    },
    {
      "end": 8056.12,
      "start": 8055.0,
      "text": "燕子嫁人了"
    },
    {
      "end": 8057.52,
      "start": 8056.12,
      "text": "我看她幸福很开心啊"
    },
    {
      "end": 8059.72,
      "start": 8057.52,
      "text": "我一星期不适应后来我很幸福啊"
    },
    {
      "end": 8061.32,
      "start": 8059.72,
      "text": "啊"
    },
    {
      "end": 8064.2,
      "start": 8061.32,
      "text": "就像我说我的小时候余春印在云南被枪毙"
    },
    {
      "end": 8066.72,
      "start": 8064.2,
      "text": "枪毙之前我老去看着去啊"
    },
    {
      "end": 8070.2,
      "start": 8066.72,
      "text": "她爱上了回民的小花在小关仪啊"
    },
    {
      "end": 8072.76,
      "start": 8070.2,
      "text": "她就坐着让我感到我当时就哭了啊"
    },
    {
      "end": 8073.76,
      "start": 8072.76,
      "text": "我照顾她"
    },
    {
      "end": 8076.4,
      "start": 8073.76,
      "text": "她说我给小花写了一说我肯定被枪毙"
    },
    {
      "end": 8077.5,
      "start": 8076.4,
      "text": "就马上嫁人"
    },
    {
      "end": 8080.3,
      "start": 8077.5,
      "text": "我不能给你未来但是我能给你自由"
    },
    {
      "end": 8082.94,
      "start": 8080.3,
      "text": "哇塞当时对我十几岁的我来讲"
    },
    {
      "end": 8084.06,
      "start": 8082.94,
      "text": "我这哥们太有境界了"
    },
    {
      "end": 8086.34,
      "start": 8084.06,
      "text": "我不能给你未来我能给你自由"
    },
    {
      "end": 8087.06,
      "start": 8086.34,
      "text": "我说行"
    },
    {
      "end": 8088.66,
      "start": 8087.06,
      "text": "余春印你够哥们"
    },
    {
      "end": 8090.46,
      "start": 8088.66,
      "text": "但现在小花也没嫁人"
    },
    {
      "end": 8093.46,
      "start": 8090.46,
      "text": "小花我说过跟凯勒西长得特别特别像"
    },
    {
      "end": 8094.26,
      "start": 8093.46,
      "text": "特别特别像"
    },
    {
      "end": 8096.34,
      "start": 8094.26,
      "text": "啊回民啊"
    },
    {
      "end": 8097.9,
      "start": 8096.34,
      "text": "那么我要告诉大家"
    },
    {
      "end": 8099.86,
      "start": 8097.9,
      "text": "失恋的根本原因"
    }
