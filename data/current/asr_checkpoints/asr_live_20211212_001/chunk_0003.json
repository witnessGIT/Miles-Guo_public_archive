      "text": "苹果商店"
    },
    {
      "end": 2818.6,
      "start": 2817.06,
      "text": "MV发行"
    },
    {
      "end": 2820.66,
      "start": 2818.6,
      "text": "大家去想想啊"
    },
    {
      "end": 2822.26,
      "start": 2820.66,
      "text": "我今天不能说太具体"
    },
    {
      "end": 2823.36,
      "start": 2822.26,
      "text": "我告诉你"
    },
    {
      "end": 2826.46,
      "start": 2823.36,
      "text": "咱们这个歌绝对超过7000万次的"
    },
    {
      "end": 2827.52,
      "start": 2826.46,
      "text": "听看"
    },
    {
      "end": 2829.1,
      "start": 2827.52,
      "text": "绝对超过7000万"
    },
    {
      "end": 2830.66,
      "start": 2829.1,
      "text": "但是我们反映出来"
    },
    {
      "end": 2832.32,
      "start": 2830.66,
      "text": "却不到200万次"
    },
    {
      "end": 2834.1,
      "start": 2832.32,
      "text": "这已经很牛了啊"
    },
    {
      "end": 2837.32,
      "start": 2834.1,
      "text": "七歌绝对和战友创造了过去"
