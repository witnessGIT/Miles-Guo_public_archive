    },
    {
      "end": 2751.1,
      "start": 2747.26,
      "text": "20亿的用户里边最关键是什么"
    },
    {
      "end": 2752.86,
      "start": 2751.1,
      "text": "它控制的WhatsApp"
    },
    {
      "end": 2754.16,
      "start": 2752.86,
      "text": "Instagram"
    },
    {
      "end": 2756.22,
      "start": 2754.16,
      "text": "Facebook的视频"
    },
    {
      "end": 2758.42,
      "start": 2756.22,
      "text": "这三样加在一起"
    },
    {
      "end": 2760.72,
      "start": 2758.42,
      "text": "是因为视频流"
    },
    {
      "end": 2763.08,
      "start": 2760.72,
