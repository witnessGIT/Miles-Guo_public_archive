      "text": "然後我就想"
    },
    {
      "end": 6114.12,
      "start": 6113.12,
      "text": "我就說跟那個"
    },
    {
      "end": 6115.12,
      "start": 6114.12,
      "text": "啊"
    },
    {
      "end": 6116.12,
      "start": 6115.12,
      "text": "就是我們歸到中心一陣子"
    },
    {
      "end": 6117.12,
      "start": 6116.12,
      "text": "那就是我們下日了"
    },
    {
      "end": 6118.12,
      "start": 6117.12,
      "text": "sabit"
    },
    {
      "end": 6119.12,
