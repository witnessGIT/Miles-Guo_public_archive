{
  "chunk_audio_sha256": "4c2b9501b95739635e5a3ee52fae592ca1c8391a3fc3042b55b13fad6cead243",
  "chunk_index": 6,
  "completed_at": "2026-10-21T11:24:18Z",
  "language": "zh",
  "live_id": "LIVE_20211212_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 5400,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 5403.48,
      "start": 5400.0,
      "text": "對自己的地位 她那個自己這個家族的維護"
    },
    {
      "end": 5405.4,
      "start": 5403.48,
      "text": "超出你常人的想像"
    },
    {
      "end": 5409.64,
      "start": 5407.7,
      "text": "她這個女兒的生活奢侈"
    },
    {
      "end": 5413.14,
      "start": 5409.64,
      "text": "遠比你亮出的粉鑽 讓她厲害的多得多"
    },
    {
      "end": 5414.58,
      "start": 5413.14,
      "text": "她算個毛啊"
    },
    {
      "end": 5417.68,
      "start": 5414.58,
      "text": "不是 她真的放個屁都能放出那些東西出來"
    },
    {
      "end": 5420.92,
      "start": 5419.42,
      "text": "她給香港的任何一個大佬說"
    },
    {
      "end": 5424.1,
      "start": 5420.92,
      "text": "哎 給我拿100個億 我去消遣一下"
    },
    {
      "end": 5426.6,
      "start": 5424.1,
      "text": "100個億能買啥 你看了那又能買1萬遍"
    },
    {
      "end": 5430.6,
      "start": 5426.6,
      "text": "我想我不要買鑽石 我把鑽石礦都買了"
    },
    {
      "end": 5432.8,
      "start": 5430.6,
      "text": "下一分鐘就辦成"
    },
    {
      "end": 5438.48,
      "start": 5434.8,
      "text": "DBS的老闆 見了習的家人以後"
    },
    {
      "end": 5440.92,
      "start": 5438.48,
      "text": "當時買完了 人家離開說這是誰啊"
    },
    {
      "end": 5441.84,
      "start": 5440.92,
      "text": "這是習的家人"
    },
    {
      "end": 5444.16,
      "start": 5441.84,
      "text": "哇塞 這老闆從樓上衝下來"
    },
    {
      "end": 5445.48,
      "start": 5444.16,
      "text": "把所有人給罵一頓"
    },
    {
      "end": 5448.82,
      "start": 5445.48,
      "text": "你為什麼不叫我啊 為什麼不跟我說暴怒"
    },
    {
      "end": 5452.76,
      "start": 5448.82,
      "text": "鑽石大王 是吧 黑白兩道"
    },
    {
      "end": 5456.16,
      "start": 5452.76,
      "text": "怎麼打的 竟然是失態到基點"
    },
    {
      "end": 5457.16,
      "start": 5456.16,
      "text": "大家就傻了"
    },
    {
      "end": 5460.16,
      "start": 5458.16,
      "text": "說這哥們兒跟他工作二三十年前"
    },
    {
      "end": 5461.36,
      "start": 5460.16,
      "text": "沒見到發過評論罵過人"
    },
    {
      "end": 5463.66,
      "start": 5462.26,
      "text": "有習的家人那麼厲害嗎"
    },
    {
      "end": 5466.84,
      "start": 5463.96,
      "text": "他說我告訴你 只要習的家人愛上我們"
    },
    {
      "end": 5469.58,
      "start": 5466.84,
      "text": "我們就馬上就分人百倍"
    },
    {
      "end": 5473.24,
      "start": 5471.74,
      "text": "這是哪年 我告訴大家"
    },
    {
      "end": 5475.44,
      "start": 5473.94,
      "text": "2007年"
    },
    {
      "end": 5480.16,
      "start": 5478.72,
      "text": "你還看那個粉傳"
    },
    {
      "end": 5483.08,
      "start": 5480.16,
      "text": "這就看出戰友認知性有多差"
    },
    {
      "end": 5486.08,
      "start": 5483.08,
      "text": "你以為他練個粉傳你很受不了是嗎"
    },
    {
      "end": 5487.88,
      "start": 5486.08,
      "text": "他還拿著那個辦飯吃就行"
    },
    {
      "end": 5490.08,
      "start": 5487.88,
      "text": "他真的 對他來講"
    },
    {
      "end": 5493.08,
      "start": 5490.08,
      "text": "你不知道共產黨當官當了政治局委員"
    },
    {
      "end": 5496.5,
      "start": 5493.08,
      "text": "到了常委 又當了習近平這個啥概念"
    },
    {
      "end": 5498.06,
      "start": 5496.5,
      "text": "他要啥有啥"
    },
    {
      "end": 5499.9,
      "start": 5498.06,
      "text": "他天下都是他的"
    },
    {
      "end": 5503.46,
      "start": 5499.9,
      "text": "你怎麼還覺得還有什麼貴賤啊"
    },
    {
      "end": 5506.24,
      "start": 5503.46,
      "text": "還多少 對他來講已經完全不算事了"
    },
    {
      "end": 5511.24,
      "start": 5506.24,
      "text": "我們的李慕子小姐出國是什麼"
    },
    {
      "end": 5514.24,
      "start": 5511.24,
      "text": "跟著爸媽出國沒有一個人敢偷拍他照片的"
    },
    {
      "end": 5516.24,
      "start": 5514.24,
      "text": "你偷拍的就像金正恩一樣"
    },
    {
      "end": 5519.62,
      "start": 5516.24,
      "text": "我把狗狗了你 全吃了你"
    },
    {
      "end": 5524.12,
      "start": 5521.22,
      "text": "看習近平瞪一下人不一定把人嚇死"
    },
    {
      "end": 5528.12,
      "start": 5524.12,
      "text": "如果李慕子彭麗媛要看到哪個將軍說我瞪點看見"
    },
    {
      "end": 5530.12,
      "start": 5528.12,
      "text": "他就咬咬牙覺得他嚇死了"
    },
    {
      "end": 5535.12,
      "start": 5532.12,
      "text": "黃峰輝第一個最惹上的人是誰啊"
    },
    {
      "end": 5537.12,
      "start": 5535.12,
      "text": "就是彭麗媛 是吧"
    },
    {
      "end": 5541.12,
      "start": 5537.12,
      "text": "跟楊維文他老拿楊維文不當個事啊 是吧"
    },
    {
      "end": 5544.12,
      "start": 5541.12,
      "text": "最後黃峰輝被抓了吧"
    },
    {
      "end": 5548.12,
      "start": 5544.12,
      "text": "抓的很徹底吧 是吧"
    },
    {
      "end": 5551.12,
      "start": 5548.12,
      "text": "人家習的女兒李慕子出來沒有人"
    },
    {
      "end": 5552.12,
      "start": 5551.12,
      "text": "很多人沒見過他本人"
    },
    {
      "end": 5554.12,
      "start": 5552.12,
      "text": "他有各種身份出席"
    },
    {
      "end": 5559.12,
      "start": 5554.12,
      "text": "很多傻瓜啊 包括馬化騰這麼聰明一個人"
    },
    {
      "end": 5562.12,
      "start": 5559.12,
      "text": "一開始他並不知道習近平的"
    },
    {
      "end": 5564.12,
      "start": 5562.12,
      "text": "人家跟他接觸了幾次以後"
    },
    {
      "end": 5566.12,
      "start": 5564.12,
      "text": "這個人可以留著用"
    },
    {
      "end": 5570.12,
      "start": 5566.12,
      "text": "但是絕對要注意他跟西方的親近"
    },
    {
      "end": 5572.12,
      "start": 5570.12,
      "text": "你還見馬化騰出國嗎"
    },
    {
      "end": 5574.12,
      "start": 5572.12,
      "text": "沒見他出國了吧"
    },
    {
      "end": 5576.12,
      "start": 5574.12,
      "text": "不再出國了吧"
    },
    {
      "end": 5579.12,
      "start": 5576.12,
      "text": "就跟馬雲 馬雲這個人是有野心的"
    },
    {
      "end": 5581.12,
      "start": 5579.12,
      "text": "搞政治野心的 他必須被幹掉啊"
    },
    {
      "end": 5583.12,
      "start": 5582.12,
      "text": "是吧"
    },
    {
      "end": 5587.12,
      "start": 5584.12,
      "text": "那很多故事我現在不好意思講都是我的朋友啊"
    },
    {
      "end": 5590.12,
      "start": 5587.12,
      "text": "都不知道跟李慕子吃完飯了啊"
    },
    {
      "end": 5592.12,
      "start": 5590.12,
      "text": "還吹牛呢 哎呀 這麼的"
    },
    {
      "end": 5594.12,
      "start": 5592.12,
      "text": "我心裡話你是末日到了"
    },
    {
      "end": 5596.12,
      "start": 5594.12,
      "text": "我知道他是誰"
    },
    {
      "end": 5601.12,
      "start": 5598.12,
      "text": "哪天我給你放出來公主的照片"
    },
    {
      "end": 5603.12,
      "start": 5601.12,
      "text": "公主的視頻 公主的生活"
    },
    {
      "end": 5606.12,
      "start": 5603.12,
      "text": "兄弟 記住啊 七哥在今天爆料承諾"
    },
    {
      "end": 5610.12,
      "start": 5606.12,
      "text": "我會把李慕子的生活照片過去放給你"
    },
    {
      "end": 5613.12,
      "start": 5610.12,
      "text": "記住你看看我2017年爆料的時候"
    },
    {
      "end": 5614.12,
      "start": 5613.12,
      "text": "我在哈佛大學"
    },
    {
      "end": 5616.12,
      "start": 5614.12,
      "text": "我在李慕子的敘舍外面"
    },
    {
      "end": 5618.12,
      "start": 5616.12,
      "text": "我錄那兒視頻沒有人到現在發現的"
    },
    {
      "end": 5620.12,
      "start": 5618.12,
      "text": "你們好好看看我2017年放的推特"
    },
    {
      "end": 5622.12,
      "start": 5620.12,
      "text": "在哈佛大學的時候"
    },
    {
      "end": 5626.12,
      "start": 5622.12,
      "text": "美國政府 奧巴馬政府"
    },
    {
      "end": 5630.12,
      "start": 5626.12,
      "text": "就已經給他一個專業的特勤局團隊"
    },
    {
      "end": 5634.12,
      "start": 5630.12,
      "text": "就已經給他一個專業的特勤局團隊"
    },
    {
      "end": 5635.12,
      "start": 5634.12,
      "text": "保護了"
    },
    {
      "end": 5638.12,
      "start": 5636.12,
      "text": "就沒有人拍過他照片"
    },
    {
      "end": 5640.12,
      "start": 5638.12,
      "text": "那時候的公主就那麼牛了"
    },
    {
      "end": 5642.12,
      "start": 5640.12,
      "text": "你想今天哪"
    },
    {
      "end": 5644.12,
      "start": 5642.12,
      "text": "你想今天那"
    },
    {
      "end": 5648.12,
      "start": 5644.12,
      "text": "那孫瑶啊 冠軍啊 劉承傑"
    },
    {
      "end": 5650.12,
      "start": 5648.12,
      "text": "那跟他一比呢又差哪去了"
    },
    {
      "end": 5652.12,
      "start": 5650.12,
      "text": "他不是有海航"
    },
    {
      "end": 5654.12,
      "start": 5652.12,
      "text": "千萬大家別傻了說"
    },
    {
      "end": 5655.12,
      "start": 5654.12,
      "text": "他擁有啥"
    },
    {
      "end": 5657.12,
      "start": 5655.12,
      "text": "他擁有啥你都不要辦點驚訝"
    },
    {
      "end": 5661.12,
      "start": 5657.12,
      "text": "吃人肉喝人心你都不要覺得是驚訝"
    },
    {
      "end": 5663.12,
      "start": 5661.12,
      "text": "而且他不覺得有任何不正常"
    },
    {
      "end": 5668.12,
      "start": 5663.12,
      "text": "這就是什麼"
    },
    {
      "end": 5669.12,
      "start": 5668.12,
      "text": "大家今天反過來又說"
    },
    {
      "end": 5673.12,
      "start": 5669.12,
      "text": "中國人已經沒有了任何善惡分辨的能力"
    },
    {
      "end": 5675.12,
      "start": 5673.12,
      "text": "和真假辨解的能力"
    },
    {
      "end": 5679.12,
      "start": 5677.12,
      "text": "這就是你看到今天雙十二的時候"
    },
    {
      "end": 5682.12,
      "start": 5679.12,
      "text": "沒有任何人到現在還看清楚"
    },
    {
      "end": 5685.12,
      "start": 5683.12,
      "text": "什麼什麼什麼張將軍啊"
    },
    {
      "end": 5688.12,
      "start": 5685.12,
      "text": "張少將啊 張少帥啊"
    },
    {
      "end": 5691.12,
      "start": 5688.12,
      "text": "共產黨誇的一定是壞的"
    },
    {
      "end": 5696.12,
      "start": 5693.12,
      "text": "共產黨恨的一定是好的"
    },
    {
      "end": 5699.12,
      "start": 5696.12,
      "text": "你想共產黨多把他形容是一個"
    },
    {
      "end": 5702.12,
      "start": 5699.12,
      "text": "什麼張少帥什麼電視劇當中"
    },
    {
      "end": 5704.12,
      "start": 5702.12,
      "text": "一定是相反的"
    },
    {
      "end": 5706.12,
      "start": 5704.12,
      "text": "這哥們是想"
    },
    {
      "end": 5710.12,
      "start": 5706.12,
      "text": "張少良這個人想幹誰就幹誰"
    },
    {
      "end": 5712.12,
      "start": 5710.12,
      "text": "這就是個東北"
    },
    {
      "end": 5713.12,
      "start": 5712.12,
      "text": "所以說我跟妳講"
    },
    {
      "end": 5714.12,
      "start": 5713.12,
      "text": "我出生在東北"
    },
    {
      "end": 5716.12,
      "start": 5714.12,
      "text": "我從小到大我就真的"
    },
    {
      "end": 5718.12,
      "start": 5716.12,
      "text": "我就是東北人永遠別管中國"
    },
    {
      "end": 5720.12,
      "start": 5718.12,
      "text": "管中國中國就"
    },
    {
      "end": 5722.12,
      "start": 5720.12,
      "text": "只能往後走永遠不會往前走"
    },
    {
      "end": 5724.12,
      "start": 5722.12,
      "text": "要麽左走右走一定不會往前走"
    },
    {
      "end": 5726.12,
      "start": 5724.12,
      "text": "我深信不疑"
    },
    {
      "end": 5730.12,
      "start": 5726.12,
      "text": "東北這個文化東北這個地方"
    },
    {
      "end": 5731.12,
      "start": 5730.12,
      "text": "真的沒有"
    },
    {
      "end": 5734.12,
      "start": 5731.12,
      "text": "絕對不會像江澤一樣培養出這種"
    },
    {
      "end": 5736.12,
      "start": 5734.12,
      "text": "治國之棟梁"
    },
    {
      "end": 5738.12,
      "start": 5736.12,
      "text": "人類之文明之英雄和先鋒"
    },
    {
      "end": 5742.12,
      "start": 5738.12,
      "text": "不論是過去的楚國"
    },
    {
      "end": 5745.12,
      "start": 5742.12,
      "text": "還是吴國我認為什麼國"
    },
    {
      "end": 5748.12,
      "start": 5745.12,
      "text": "都比東北國這個要強得多"
    },
    {
      "end": 5750.12,
      "start": 5748.12,
      "text": "張將軍這家人都這樣"
    },
    {
      "end": 5752.12,
      "start": 5750.12,
      "text": "大宋朝孫暉中被點油燈"
    },
    {
      "end": 5754.12,
      "start": 5752.12,
      "text": "整個北方人"
    },
    {
      "end": 5756.12,
      "start": 5754.12,
      "text": "遼國人怎麽對付他"
    },
    {
      "end": 5758.12,
      "start": 5756.12,
      "text": "滿洲人怎麽統治漢人"
    },
    {
      "end": 5760.12,
      "start": 5758.12,
      "text": "咱東北這個地方就不出這個治國之棟梁"
    },
    {
      "end": 5762.12,
      "start": 5760.12,
      "text": "沒有人類的文明"
    },
    {
      "end": 5768.12,
      "start": 5762.12,
      "text": "所以說今天雙十二十五日我們有太多話題要談了"
    },
    {
      "end": 5770.12,
      "start": 5768.12,
      "text": "我們今天絕對是我們值得警醒的日子"
    },
    {
      "end": 5772.12,
      "start": 5770.12,
      "text": "要懂得基本的歷史的判斷"
    },
    {
      "end": 5774.12,
      "start": 5772.12,
      "text": "日本人說了一句話"
    },
    {
      "end": 5776.12,
      "start": 5774.12,
      "text": "沒有張少帥就沒有中國共產黨"
    },
    {
      "end": 5778.12,
      "start": 5776.12,
      "text": "沒有張少帥"
    },
    {
      "end": 5780.12,
      "start": 5778.12,
      "text": "日本人不是美國人打敗"
    },
    {
      "end": 5782.12,
      "start": 5780.12,
      "text": "可能是在中國會死更多人"
    },
    {
      "end": 5784.12,
      "start": 5782.12,
      "text": "日本人都把他當英雄高級了"
    },
    {
      "end": 5786.12,
      "start": 5784.12,
      "text": "你說他晚日了嗎"
    },
    {
      "end": 5788.12,
      "start": 5786.12,
      "text": "日本都定位他沒有他沒有毛澤東"
    },
    {
      "end": 5790.12,
      "start": 5788.12,
      "text": "沒有他沒有他"
    },
    {
      "end": 5791.12,
