      "text": "毛是騙子"
    },
    {
      "end": 5300.7,
      "start": 5300.0,
      "text": "不用說了"
    },
    {
      "end": 5301.9,
      "start": 5300.7,
      "text": "整個共產黨都是騙子"
    },
    {
      "end": 5303.9,
      "start": 5302.6,
      "text": "張學良是騙子"
    },
    {
      "end": 5305.6,
      "start": 5304.0,
      "text": "雷鋒也是騙子"
    },
    {
      "end": 5308.9,
      "start": 5306.7,
      "text": "今天的中南科更是大騙子"
    },
    {
      "end": 5311.2,
      "start": 5310.5,
      "text": "是吧"
    },
    {
      "end": 5315.2,
      "start": 5312.2,
      "text": "只要這個社會沒有恢復到真實的本色"
