{
  "chunk_audio_sha256": "c1d58f3f3bc395f544f5b88af9ce88c333c3451d60ca77af7df26e627a6c163d",
  "chunk_index": 5,
  "completed_at": "2026-10-21T02:07:58Z",
  "language": "zh",
  "live_id": "LIVE_20211212_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 4500,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 4504.18,
      "start": 4500.0,
      "text": "斯大林當時的司令叫左翼夫"
    },
    {
      "end": 4508.38,
      "start": 4504.76,
      "text": "左翼夫親自給當時的解放軍的彭德懷他們說"
    },
    {
      "end": 4511.88,
      "start": 4508.68,
      "text": "記住你敢動蔣介石壹個號碼我沒有你們全捏死"
    },
    {
      "end": 4516.12,
      "start": 4514.9,
      "text": "當時誰是老大"
    },
    {
      "end": 4519.52,
      "start": 4517.0,
      "text": "他想滅日嗎開什麽玩笑啊"
    },
    {
      "end": 4525.02,
      "start": 4523.02,
      "text": "保蔣李克農對李克農"
    },
    {
      "end": 4526.72,
      "start": 4525.2,
      "text": "三彪先生李克農"
    },
    {
      "end": 4529.0,
      "start": 4528.06,
      "text": "頑固子弟"
    },
    {
      "end": 4531.5,
      "start": 4529.0,
      "text": "所以說當時整個是"
    },
    {
      "end": 4534.6,
      "start": 4532.0,
      "text": "大家沒鬧明白什麽1212張駛良的英雄"
    },
    {
      "end": 4538.3,
      "start": 4534.9,
      "text": "他把一個完全中國人歷史性的轉變"
    },
    {
      "end": 4539.7,
      "start": 4538.6,
      "text": "就是一個流氓"
    },
    {
      "end": 4541.2,
      "start": 4539.9,
      "text": "就是個頑固子弟"
    },
    {
      "end": 4544.6,
      "start": 4541.4,
      "text": "就是一個共產黨買通的一個走狗"
    },
    {
      "end": 4547.2,
      "start": 4545.0,
      "text": "而且最關鍵的問題就是蘇聯"
    },
    {
      "end": 4551.7,
      "start": 4547.5,
      "text": "這個三彪說對的是拖住日本不到攻打原蘇聯去"
    },
    {
      "end": 4553.5,
      "start": 4552.4,
      "text": "又是犧牲中國人"
    },
    {
      "end": 4559.0,
      "start": 4555.8,
      "text": "你們知道大家有個基本的數字大家知道嗎"
    },
    {
      "end": 4562.0,
      "start": 4559.0,
      "text": "中國在抗日戰爭當中死多少人"
    },
    {
      "end": 4563.2,
      "start": 4562.4,
      "text": "你們誰知道"
    },
    {
      "end": 4565.6,
      "start": 4564.3,
      "text": "死多少軍隊你們知道嗎"
    },
    {
      "end": 4566.9,
      "start": 4566.1,
      "text": "誰回答"
    },
    {
      "end": 4573.3,
      "start": 4569.6,
      "text": "我在日本我在說我看過日本的不公開的很多檔案"
    },
    {
      "end": 4576.9,
      "start": 4574.2,
      "text": "中國軍人所謂的官方300萬是錯的"
    },
    {
      "end": 4578.9,
      "start": 4577.1,
      "text": "中國死了380萬軍人"
    },
    {
      "end": 4581.4,
      "start": 4579.9,
      "text": "1300萬老百姓"
    },
    {
      "end": 4586.6,
      "start": 4583.9,
      "text": "這380萬軍人有幾個是張學良的兵"
    },
    {
      "end": 4591.2,
      "start": 4586.6,
      "text": "中國人被洗腦被欺騙到愚蠢的"
    },
    {
      "end": 4593.2,
      "start": 4591.4,
      "text": "人類上罕見"
    },
    {
      "end": 4594.9,
      "start": 4593.4,
      "text": "14億人的國家"
    },
    {
      "end": 4598.1,
      "start": 4595.7,
      "text": "全地球有人類以來"
    },
    {
      "end": 4601.0,
      "start": 4598.2,
      "text": "中國有8000年所謂的可查詢的歷史"
    },
    {
      "end": 4602.8,
      "start": 4601.5,
      "text": "唯一沒有選舉"
    },
    {
      "end": 4606.3,
      "start": 4603.1,
      "text": "就連非洲喝著泥沟裏的水"
    },
    {
      "end": 4609.6,
      "start": 4606.9,
      "text": "喝著剛剛的毛屎坑的水沒有廁所的地方"
    },
    {
      "end": 4610.9,
      "start": 4609.8,
      "text": "到處啥尿的地方"
    },
    {
      "end": 4613.2,
      "start": 4611.5,
      "text": "沒有公共系統的地方都有選舉"
    },
    {
      "end": 4616.0,
      "start": 4614.3,
      "text": "全人類只有中國人沒有選舉"
    },
    {
      "end": 4617.5,
      "start": 4616.0,
      "text": "連北朝鮮都有選舉"
    },
    {
      "end": 4620.7,
      "start": 4619.2,
      "text": "只有中國沒有選舉"
    },
    {
      "end": 4624.6,
      "start": 4622.3,
      "text": "全人類上只有一個人群"
    },
    {
      "end": 4626.0,
      "start": 4624.6,
      "text": "14億人佔了世界上"
    },
    {
      "end": 4627.9,
      "start": 4626.2,
      "text": "六分之一的人類"
    },
    {
      "end": 4631.1,
      "start": 4628.1,
      "text": "從來不去看戳穿歷史的假"
    },
    {
      "end": 4635.1,
      "start": 4633.1,
      "text": "全人類上只有中國人"
    },
    {
      "end": 4636.9,
      "start": 4635.3,
      "text": "就是蘇聯俄羅斯"
    },
    {
      "end": 4639.2,
      "start": 4636.9,
      "text": "一直以來就是殺了中國人最多的"
    },
    {
      "end": 4640.7,
      "start": 4639.3,
      "text": "從來不去面對"
    },
    {
      "end": 4643.5,
      "start": 4640.8,
      "text": "而且永遠去罵打著跟著"
    },
    {
      "end": 4645.1,
      "start": 4643.6,
      "text": "從來沒有怨恨的"
    },
    {
      "end": 4646.3,
      "start": 4645.1,
      "text": "西方的關係"
    },
    {
      "end": 4649.1,
      "start": 4647.7,
      "text": "永遠記住八國聯軍"
    },
    {
      "end": 4651.4,
      "start": 4649.4,
      "text": "從來不記住蘇聯到中國幹什麼事"
    },
    {
      "end": 4654.5,
      "start": 4652.0,
      "text": "當時蘇聯支持中共和瞭解這些"
    },
    {
      "end": 4656.4,
      "start": 4654.7,
      "text": "包括讓蔣介石回去"
    },
    {
      "end": 4657.5,
      "start": 4656.4,
      "text": "就讓中國人死人去"
    },
    {
      "end": 4660.1,
      "start": 4657.9,
      "text": "1200萬的老百姓"
    },
    {
      "end": 4661.2,
      "start": 4660.2,
      "text": "1300萬老百姓"
    },
    {
      "end": 4663.0,
      "start": 4661.6,
      "text": "白白的抗戰死掉"
    },
    {
      "end": 4665.4,
      "start": 4663.4,
      "text": "你就是在前面當人師牆去了"
    },
    {
      "end": 4668.9,
      "start": 4667.5,
      "text": "張學良幹了什麼事"
    },
    {
      "end": 4670.5,
      "start": 4670.2,
      "text": "是吧"
    },
    {
      "end": 4671.7,
      "start": 4670.5,
      "text": "把共產黨培養出來了"
    },
    {
      "end": 4674.2,
      "start": 4672.4,
      "text": "共產黨在25000里"
    },
    {
      "end": 4675.9,
      "start": 4674.2,
      "text": "所謂的長征在逃跑當中"
    },
    {
      "end": 4678.4,
      "start": 4676.0,
      "text": "到了西北已經剩了幾千人了"
    },
    {
      "end": 4681.0,
      "start": 4679.4,
      "text": "毛澤東就沒想到回去"
    },
    {
      "end": 4683.6,
      "start": 4682.0,
      "text": "毛澤東甚至當時就"
    },
    {
      "end": 4685.0,
      "start": 4683.6,
      "text": "就已經和中文來"
    },
    {
      "end": 4686.4,
      "start": 4685.1,
      "text": "你看黨的內部的歷史"
    },
    {
      "end": 4687.4,
      "start": 4686.6,
      "text": "甚至想過什麼"
    },
    {
      "end": 4688.9,
      "start": 4687.5,
      "text": "毛澤東說只要保我一條命"
    },
    {
      "end": 4692.2,
      "start": 4688.9,
      "text": "我絕對是當老師回滾槍裡"
    },
    {
      "end": 4694.9,
      "start": 4692.5,
      "text": "根本不存在所謂他得牛叉"
    },
    {
      "end": 4697.7,
      "start": 4695.1,
      "text": "什麼李克農跟他完全胡扯"
    },
    {
      "end": 4699.9,
      "start": 4698.9,
      "text": "紀彭菲"
    },
    {
      "end": 4702.9,
      "start": 4700.5,
      "text": "紀聖德是跟李克農"
    },
    {
      "end": 4705.8,
      "start": 4703.1,
      "text": "是跟周恩來整個全城是參與這事"
    },
    {
      "end": 4707.0,
      "start": 4706.2,
      "text": "用他的話說"
    },
    {
      "end": 4710.0,
      "start": 4707.2,
      "text": "共產黨說的沒有一件事是真的在這個事"
    },
    {
      "end": 4714.1,
      "start": 4711.9,
      "text": "我當時的震驚是什麼程度"
    },
    {
      "end": 4717.3,
      "start": 4714.6,
      "text": "就像有人在我腦子拿著一刀劈了我一刀一樣"
    },
    {
      "end": 4721.3,
      "start": 4718.9,
      "text": "看到表這個表"
    },
    {
      "end": 4725.8,
      "start": 4722.9,
      "text": "當時幹掉這個國民黨的特務"
    },
    {
      "end": 4727.4,
      "start": 4726.2,
      "text": "這就是我爹幹的"
    },
    {
      "end": 4728.9,
      "start": 4727.6,
      "text": "紀彭菲還有李克農幹的"
    },
    {
      "end": 4730.3,
      "start": 4729.5,
      "text": "得了一個表"
    },
    {
      "end": 4731.0,
      "start": 4730.4,
      "text": "戰利品"
    },
    {
      "end": 4733.8,
      "start": 4733.3,
      "text": "是吧"
    },
    {
      "end": 4735.9,
      "start": 4734.2,
      "text": "說在這個西安事變這事當中"
    },
    {
      "end": 4737.6,
      "start": 4736.0,
      "text": "完全是這個張學良"
    },
    {
      "end": 4738.9,
      "start": 4737.8,
      "text": "是個典型就是"
    },
    {
      "end": 4740.8,
      "start": 4739.1,
      "text": "我們爆料革命永遠小心的"
    },
    {
      "end": 4743.2,
      "start": 4741.7,
      "text": "這種人面獸心"
    },
    {
      "end": 4745.4,
      "start": 4743.6,
      "text": "你完全一己自私"
    },
    {
      "end": 4746.8,
      "start": 4745.7,
      "text": "軍閥思想"
    },
    {
      "end": 4748.5,
      "start": 4747.1,
      "text": "一切為家族"
    },
    {
      "end": 4749.9,
      "start": 4748.9,
      "text": "家族"
    },
    {
      "end": 4750.5,
      "start": 4749.9,
      "text": "記住"
    },
    {
      "end": 4751.5,
      "start": 4750.5,
      "text": "為了自己的家族"
    },
    {
      "end": 4753.1,
      "start": 4751.7,
      "text": "為了一己自私"
    },
    {
      "end": 4755.2,
      "start": 4753.3,
      "text": "還有民意心"
    },
    {
      "end": 4757.8,
      "start": 4756.3,
      "text": "還打著民族的幌子"
    },
    {
      "end": 4758.8,
      "start": 4757.8,
      "text": "國家的幌子"
    },
    {
      "end": 4761.5,
      "start": 4759.4,
      "text": "為的是所有的權利和利益的"
    },
    {
      "end": 4763.3,
      "start": 4761.6,
      "text": "這是對我們最危險的條件"
    },
    {
      "end": 4766.6,
      "start": 4763.3,
      "text": "就像這個音樂"
    },
    {
      "end": 4768.2,
      "start": 4766.7,
      "text": "你打榜你成為你自己"
    },
    {
      "end": 4769.9,
      "start": 4768.3,
      "text": "認為自己我是歌王啦"
    },
    {
      "end": 4771.7,
      "start": 4770.0,
      "text": "我是搖滾歌星啦"
    },
    {
      "end": 4772.7,
      "start": 4771.8,
      "text": "我會唱歌啦"
    },
    {
      "end": 4773.8,
      "start": 4772.7,
      "text": "就說死呢"
    },
    {
      "end": 4775.6,
      "start": 4774.4,
      "text": "沒有戰友評分給我"
    },
    {
      "end": 4776.4,
      "start": 4775.7,
      "text": "我算老幾"
    },
    {
      "end": 4780.0,
      "start": 4776.4,
      "text": "我現在要躺在這種名義裏邊"
    },
    {
      "end": 4781.2,
      "start": 4780.0,
      "text": "還怎麽可能滅共"
    },
    {
      "end": 4782.1,
      "start": 4781.4,
      "text": "這算什麽"
    },
    {
      "end": 4782.7,
      "start": 4782.2,
      "text": "是吧"
    },
    {
      "end": 4784.7,
      "start": 4783.2,
      "text": "它只能是我們那個共互"
    },
    {
      "end": 4788.5,
      "start": 4786.5,
      "text": "所以你看這個雙十二的時候"
    },
    {
      "end": 4789.9,
      "start": 4788.8,
      "text": "今天這個日子"
    },
    {
      "end": 4791.9,
      "start": 4790.2,
      "text": "我沐浴更衣啊"
    },
    {
      "end": 4793.6,
      "start": 4792.1,
      "text": "我剛才我在宋經的時候"
    },
    {
      "end": 4796.3,
      "start": 4793.8,
      "text": "我其中就一個希望上天"
    },
    {
      "end": 4799.3,
      "start": 4796.5,
      "text": "永遠不會碰到中國再有任何一個張學良"
    },
    {
      "end": 4802.2,
      "start": 4799.3,
      "text": "如果習被幹掉了"
    },
    {
      "end": 4803.6,
      "start": 4802.3,
      "text": "會出現多少張學良"
    },
    {
      "end": 4804.1,
      "start": 4803.6,
      "text": "你知道嗎"
    },
    {
      "end": 4806.2,
      "start": 4804.2,
      "text": "會出現一百個一萬個張學良"
    },
    {
      "end": 4808.6,
      "start": 4807.2,
      "text": "打著各種什麽"
    },
    {
      "end": 4810.3,
      "start": 4808.7,
      "text": "抗日 抗美 抗什麽"
    },
    {
      "end": 4811.7,
      "start": 4810.4,
      "text": "抗誰都行"
    },
    {
      "end": 4813.6,
      "start": 4812.4,
      "text": "就是你要相信我"
    },
    {
      "end": 4814.6,
      "start": 4813.6,
      "text": "我稱民族英雄"
    },
    {
      "end": 4818.1,
      "start": 4815.3,
      "text": "沒有一個獨裁者不是打著民族英雄"
    },
    {
      "end": 4820.0,
      "start": 4818.8,
      "text": "國家安危"
    },
    {
      "end": 4821.2,
      "start": 4820.4,
      "text": "然後呢"
    },
    {
      "end": 4822.7,
      "start": 4821.3,
      "text": "所謂外敵內侵"
    },
    {
      "end": 4824.3,
      "start": 4822.9,
      "text": "他是救世主的身份出來"
    },
    {
      "end": 4825.2,
      "start": 4824.3,
      "text": "沒有一個不是這樣"
    },
    {
      "end": 4827.4,
      "start": 4825.8,
      "text": "所以所有的獨裁者"
    },
    {
      "end": 4829.2,
      "start": 4827.7,
      "text": "挑動內部種族矛盾"
    },
    {
      "end": 4831.1,
      "start": 4829.3,
      "text": "社會矛盾 經濟矛盾"
    },
    {
      "end": 4833.1,
      "start": 4831.7,
      "text": "然後內部政治矛盾"
    },
    {
      "end": 4835.4,
      "start": 4833.5,
      "text": "然後幹掉宗教 自己當神"
    },
    {
      "end": 4836.6,
      "start": 4835.6,
      "text": "然後最後不行"
    },
    {
      "end": 4837.1,
      "start": 4836.6,
      "text": "戰爭"
    },
    {
      "end": 4838.5,
      "start": 4837.5,
      "text": "永遠是這個"
    },
    {
      "end": 4842.3,
      "start": 4840.6,
      "text": "張學良差點挑起了"
    },
    {
      "end": 4845.2,
      "start": 4843.4,
      "text": "蘇聯對核武去給中國"
    },
    {
      "end": 4849.9,
      "start": 4846.7,
      "text": "甚至他的結果導致美國人都敢對我們動手"
    },
    {
      "end": 4853.8,
      "start": 4850.8,
      "text": "你當時你知道當時美國炸日本的時候"
    },
    {
      "end": 4856.1,
      "start": 4854.2,
      "text": "所有的那個飛機炸通經的時候"
    },
    {
      "end": 4856.9,
      "start": 4856.1,
      "text": "飛機在哪兒啊"
    },
    {
      "end": 4857.9,
      "start": 4856.9,
      "text": "換彈藥在哪兒啊"
    },
    {
      "end": 4858.9,
      "start": 4858.2,
      "text": "全在中國"
    },
    {
      "end": 4860.2,
      "start": 4858.9,
      "text": "他飛不回來的"
    },
    {
      "end": 4864.2,
      "start": 4862.5,
      "text": "反過來當時美國做過什麽"
    },
    {
      "end": 4866.3,
      "start": 4864.3,
      "text": "美國掉過來飛機就可以佔你中國"
    },
    {
      "end": 4870.8,
      "start": 4868.3,
      "text": "北朝鮮是毛澤東多危險的舉動"
    },
    {
      "end": 4873.3,
      "start": 4871.9,
      "text": "美國都嘗試"
    },
    {
      "end": 4876.4,
      "start": 4873.4,
      "text": "包括蘇聯想給中國搞核武器"
    },
    {
      "end": 4877.7,
      "start": 4876.6,
      "text": "想放核武器"
    },
    {
      "end": 4879.0,
      "start": 4877.8,
      "text": "第一個要幹掉中國的事"
    },
    {
      "end": 4880.2,
      "start": 4879.1,
      "text": "蘇聯"
    },
    {
      "end": 4881.7,
      "start": 4880.6,
      "text": "你們看歷史了嗎"
    },
    {
      "end": 4883.4,
      "start": 4882.1,
      "text": "兩到三次"
    },
    {
      "end": 4885.8,
      "start": 4884.2,
      "text": "斯達林都想給中國"
    },
    {
      "end": 4888.0,
      "start": 4886.5,
      "text": "甚至赫魯曉夫給中國放核武器"
    },
    {
      "end": 4888.8,
      "start": 4888.0,
      "text": "滅了這個國家"
    },
    {
      "end": 4894.6,
      "start": 4891.1,
      "text": "毛澤東的北朝鮮滅掉了百萬國民黨的叛軍"
    },
    {
      "end": 4897.4,
      "start": 4896.4,
      "text": "他有多狠呢"
    },
    {
      "end": 4899.3,
      "start": 4897.4,
      "text": "為了自己的兒子能接他的班"
    },
    {
      "end": 4902.1,
      "start": 4899.9,
      "text": "把整個國民黨的軍送到軍"
    },
    {
      "end": 4902.6,
      "start": 4902.2,
      "text": "凍死了"
    },
    {
      "end": 4904.9,
      "start": 4903.4,
      "text": "所謂的平軍湖戰役"
    },
    {
      "end": 4906.6,
      "start": 4904.9,
      "text": "只有七哥告訴你們這下"
    },
    {
      "end": 4909.0,
      "start": 4906.6,
      "text": "當時張震"
    },
    {
      "end": 4910.2,
      "start": 4909.1,
      "text": "中國警方的警方"
    },
    {
      "end": 4911.2,
      "start": 4910.2,
      "text": "張震原話"
    },
    {
      "end": 4913.2,
      "start": 4911.8,
      "text": "說這個共產黨的這個"
    },
    {
      "end": 4914.6,
      "start": 4913.3,
      "text": "長軍湖戰役"
    },
    {
      "end": 4917.8,
      "start": 4915.2,
      "text": "在歷史上未來要成為人類大屠殺"
    },
    {
      "end": 4919.8,
      "start": 4918.4,
      "text": "是軍人中的恥辱"
    },
    {
      "end": 4921.2,
      "start": 4920.2,
      "text": "這麽多軍人"
    },
    {
      "end": 4923.6,
      "start": 4921.6,
      "text": "竟然沒人看出老毛的想"
    },
    {
      "end": 4925.5,
      "start": 4923.7,
      "text": "就把這些人送到前線"
    },
    {
      "end": 4926.7,
      "start": 4925.7,
      "text": "所謂的叛軍"
    },
    {
      "end": 4928.2,
      "start": 4927.0,
      "text": "自己不相信他們"
    },
    {
      "end": 4929.5,
      "start": 4928.3,
      "text": "把他們給弄死"
    },
    {
      "end": 4931.9,
      "start": 4929.5,
      "text": "還是培養一個自己的接班人兒子"
    },
    {
      "end": 4933.9,
      "start": 4932.7,
      "text": "但是天不住毛啊"
    },
    {
      "end": 4935.6,
      "start": 4934.2,
      "text": "這是張震原話啊"
    },
    {
      "end": 4938.1,
      "start": 4936.7,
      "text": "兩次跟我親自講"
    },
    {
      "end": 4939.3,
      "start": 4938.1,
      "text": "他旁邊的人家就捂著"
    },
    {
      "end": 4940.2,
      "start": 4939.3,
      "text": "別說別說了"
    },
    {
      "end": 4941.6,
      "start": 4940.5,
      "text": "人家還是不相信我們"
    },
    {
      "end": 4943.1,
      "start": 4941.9,
      "text": "說這小孩他又不懂小"
    },
    {
      "end": 4944.1,
      "start": 4943.1,
      "text": "國民黨講這幹什麽"
    },
    {
      "end": 4947.5,
      "start": 4946.6,
      "text": "這對我人生"
    },
    {
      "end": 4949.1,
      "start": 4947.5,
      "text": "你們想想七哥的震撼"
    },
    {
      "end": 4951.7,
      "start": 4949.9,
      "text": "你知道共產黨這個流氓有多可怕"
    },
    {
      "end": 4953.8,
      "start": 4952.2,
      "text": "百萬人就被送上了前線"
    },
    {
      "end": 4955.5,
      "start": 4954.0,
      "text": "那百萬人跟國民黨"
    },
    {
      "end": 4956.9,
      "start": 4955.9,
      "text": "共產黨什麽之分"
    },
    {
      "end": 4958.2,
      "start": 4956.9,
      "text": "都是中國人的孩子"
    },
    {
      "end": 4961.8,
      "start": 4959.5,
      "text": "看常軍胡戰役的人"
    },
    {
      "end": 4962.7,
      "start": 4961.8,
      "text": "竟然把國民"
    },
    {
      "end": 4963.7,
      "start": 4962.7,
      "text": "都帶著一個心"
    },
    {
      "end": 4964.9,
      "start": 4963.7,
      "text": "仇恨國民黨"
    },
    {
      "end": 4967.2,
      "start": 4966.0,
      "text": "我們是共產黨"
    },
    {
      "end": 4968.2,
      "start": 4967.3,
      "text": "所以共產黨"
    },
    {
      "end": 4969.2,
      "start": 4968.2,
      "text": "國民黨的官"
    },
    {
      "end": 4970.6,
      "start": 4969.2,
      "text": "國民黨的兵該死"
    },
    {
      "end": 4972.1,
      "start": 4971.3,
      "text": "或者說"
    },
    {
      "end": 4973.7,
      "start": 4972.2,
      "text": "這些人到前線去"
    },
    {
      "end": 4975.3,
      "start": 4974.0,
      "text": "為我們犧牲了"
    },
    {
      "end": 4976.6,
      "start": 4975.4,
      "text": "他從來沒有想過"
    },
    {
      "end": 4977.9,
      "start": 4976.6,
      "text": "沒有幾個中人想過"
    },
    {
      "end": 4980.3,
      "start": 4978.6,
      "text": "這些孩子是完全犧牲的"
    },
    {
      "end": 4981.7,
      "start": 4980.4,
      "text": "他都是中國人的孩子"
    },
    {
      "end": 4983.6,
      "start": 4981.8,
      "text": "沒有他爹媽沒有黨派的"
    },
    {
      "end": 4991.8,
      "start": 4983.6,
      "text": "今天的一二一二讓我們在看國民黨和共產黨的時候"
    },
    {
      "end": 4996.0,
      "start": 4992.3,
      "text": "你用多少的哭聲都無法挽回和歌頌"
    },
    {
      "end": 5000.3,
      "start": 4996.3,
      "text": "和被被送上前線的北朝鮮人感到悲哀"
    },
    {
      "end": 5003.8,
      "start": 5000.6,
      "text": "而且你無法想像張學良這樣的"
    },
    {
      "end": 5006.1,
      "start": 5003.8,
      "text": "真的叫做欺民賊"
    },
    {
      "end": 5007.8,
      "start": 5006.8,
      "text": "盜國賊"
    },
    {
      "end": 5009.8,
      "start": 5008.8,
      "text": "偽君子"
    },
    {
      "end": 5011.0,
      "start": 5010.0,
      "text": "假英雄"
    },
    {
      "end": 5013.4,
      "start": 5011.6,
      "text": "所害死多少中國人"
    },
    {
      "end": 5014.5,
      "start": 5013.9,
      "text": "沒有他"
    },
    {
      "end": 5015.7,
      "start": 5014.5,
      "text": "沒有今天中國人"
    },
    {
      "end": 5018.3,
      "start": 5016.8,
      "text": "被虐待了這個上百年"
    },
    {
      "end": 5020.6,
      "start": 5019.2,
      "text": "就沒有毛澤東"
    },
    {
      "end": 5021.1,
      "start": 5020.6,
      "text": "周南坑"
    },
    {
      "end": 5023.3,
      "start": 5022.8,
      "text": "咱們也說"
    },
    {
      "end": 5024.3,
      "start": 5023.3,
      "text": "之後蔣家如何"
    },
    {
      "end": 5025.4,
      "start": 5024.4,
      "text": "國民黨如何"
    },
    {
      "end": 5027.1,
      "start": 5026.1,
      "text": "任何情況下"
    },
    {
      "end": 5029.3,
      "start": 5027.4,
      "text": "都會比共產黨"
    },
    {
      "end": 5032.1,
      "start": 5030.0,
      "text": "今天統治中國差"
    },
    {
      "end": 5036.2,
      "start": 5032.1,
      "text": "我跟美國護士學院的很多人過去在講著說"
    },
    {
      "end": 5037.3,
      "start": 5036.4,
      "text": "如果說"
    },
    {
      "end": 5038.1,
      "start": 5037.3,
      "text": "人生沒有如果"
    },
    {
      "end": 5038.9,
      "start": 5038.1,
      "text": "我從來不相信如果"
    },
    {
      "end": 5040.9,
      "start": 5039.7,
      "text": "就是沒有共產黨"
    },
    {
      "end": 5042.0,
      "start": 5040.9,
      "text": "也沒有國民黨的"
    },
    {
      "end": 5042.8,
      "start": 5042.0,
      "text": "中國會是什麼樣"
    },
    {
      "end": 5045.7,
      "start": 5043.5,
      "text": "或者說共產黨沒搞大躍進"
    },
    {
      "end": 5047.3,
      "start": 5045.8,
      "text": "沒搞這個北朝鮮戰爭"
    },
    {
      "end": 5049.4,
      "start": 5048.1,
      "text": "沒搞三反五反"
    },
    {
      "end": 5050.4,
      "start": 5049.9,
      "text": "是不是"
    },
    {
      "end": 5052.0,
      "start": 5050.6,
      "text": "也沒有搞文化大革命"
    },
    {
      "end": 5053.0,
      "start": 5052.1,
      "text": "中國會是什麼樣"
    },
    {
      "end": 5055.7,
      "start": 5053.4,
      "text": "只給中國20年的時間"
    },
    {
      "end": 5058.4,
      "start": 5056.2,
      "text": "中國一定會走向民主"
    },
    {
      "end": 5060.9,
      "start": 5058.8,
      "text": "一定會是比今天強"
    },
    {
      "end": 5062.8,
      "start": 5060.9,
      "text": "本質性不是多少倍的"
    },
    {
      "end": 5064.2,
      "start": 5062.8,
      "text": "本質性的改變"
    },
    {
      "end": 5065.9,
      "start": 5064.8,
      "text": "因為那時候中國人"
    },
    {
      "end": 5067.0,
      "start": 5066.3,
      "text": "非常單純"
    },
    {
      "end": 5068.8,
      "start": 5067.0,
      "text": "就像回到時期時代一樣"
    },
    {
      "end": 5069.6,
      "start": 5069.0,
      "text": "啥也不懂"
    },
    {
      "end": 5071.2,
      "start": 5069.8,
      "text": "你給他灌啥他就是啥"
    },
    {
      "end": 5073.0,
      "start": 5071.7,
      "text": "你說是民主守護就民主守護"
    },
    {
      "end": 5074.1,
      "start": 5073.0,
      "text": "你說法治法就是守護"
    },
    {
      "end": 5075.5,
      "start": 5074.4,
      "text": "你說信宗教就是什麼"
    },
    {
      "end": 5077.1,
      "start": 5075.8,
      "text": "就像當年西藏"
    },
    {
      "end": 5079.0,
      "start": 5077.4,
      "text": "西藏過去什麼叫沒有叫啊"
    },
    {
      "end": 5082.0,
      "start": 5080.0,
      "text": "西藏是完全山民暴民啊"
    },
    {
      "end": 5083.6,
      "start": 5082.7,
      "text": "吃人肉啊"
    },
    {
      "end": 5086.5,
      "start": 5084.9,
      "text": "西藏那是最暴略的"
    },
    {
      "end": 5088.0,
      "start": 5086.8,
      "text": "後來是穆斯林教"
    },
    {
      "end": 5090.9,
      "start": 5088.0,
      "text": "穆斯林信了一段時間迅速"
    },
    {
      "end": 5092.4,
      "start": 5091.4,
      "text": "英國人來了"
    },
    {
      "end": 5093.1,
      "start": 5092.4,
      "text": "印度人來了"
    },
    {
      "end": 5093.9,
      "start": 5093.1,
      "text": "把他帶著"
    },
    {
      "end": 5094.7,
      "start": 5094.1,
      "text": "印度人來了"
    },
    {
      "end": 5096.4,
      "start": 5094.7,
      "text": "帶上這個佛教"
    },
    {
      "end": 5100.4,
      "start": 5098.6,
      "text": "你再看看這個波斯國"
    },
    {
      "end": 5101.4,
      "start": 5100.9,
      "text": "伊朗"
    },
    {
      "end": 5102.6,
      "start": 5101.6,
      "text": "伊朗原來信什麼教"
    },
    {
      "end": 5104.0,
      "start": 5102.6,
      "text": "大家好好看看伊朗國"
    },
    {
      "end": 5106.3,
      "start": 5104.6,
      "text": "波斯國是信什麼教的"
    },
    {
      "end": 5107.9,
      "start": 5106.9,
      "text": "侍從信了"
    },
    {
      "end": 5111.7,
      "start": 5109.4,
      "text": "遂了這些所謂的極端的穆斯林教"
    },
    {
      "end": 5112.9,
      "start": 5111.9,
      "text": "把伊朗變成這樣"
    },
    {
      "end": 5117.8,
      "start": 5112.9,
      "text": "人類從文明到不文明"
    },
    {
      "end": 5121.1,
      "start": 5118.3,
      "text": "和從一個歷史性的叫斷代"
    },
    {
      "end": 5122.4,
      "start": 5121.7,
      "text": "叫斷代"
    },
    {
      "end": 5124.4,
      "start": 5123.1,
      "text": "這個時代被斷掉的時候"
    },
    {
      "end": 5125.8,
      "start": 5124.7,
      "text": "是最容易轉變的"
    },
    {
      "end": 5127.5,
      "start": 5125.8,
      "text": "連宗教信仰文化都可以改變"
    },
    {
      "end": 5129.2,
      "start": 5128.2,
      "text": "語言都可以改變"
    },
    {
      "end": 5132.2,
      "start": 5131.1,
      "text": "在非洲的國家"
    },
    {
      "end": 5133.6,
      "start": 5132.2,
      "text": "很多國家是沒有文字的"
    },
    {
      "end": 5134.6,
      "start": 5133.8,
      "text": "只有嘴說話"
    },
    {
      "end": 5135.9,
      "start": 5134.6,
      "text": "很多人沒有文字的"
    },
    {
      "end": 5137.5,
      "start": 5136.1,
      "text": "就不存在文化來說"
    },
    {
      "end": 5139.2,
      "start": 5137.7,
      "text": "文字都沒有文化呢"
    },
    {
      "end": 5140.6,
      "start": 5139.9,
      "text": "都有選舉"
    },
    {
      "end": 5142.6,
      "start": 5141.3,
      "text": "我們中國人竟然沒有選舉"
    },
    {
      "end": 5145.9,
      "start": 5143.9,
      "text": "中國人根本不知道自己是"
    },
    {
      "end": 5148.5,
      "start": 5146.1,
      "text": "連豬狗不如的現在一個精神狀態"
    },
    {
      "end": 5151.9,
      "start": 5148.9,
      "text": "真的豬狗都比我們有精神狀態"
    },
    {
      "end": 5153.9,
      "start": 5152.7,
      "text": "美國歐洲的豬"
    },
    {
      "end": 5155.7,
      "start": 5154.2,
      "text": "是怎麼吃怎麼喝怎麼樣的"
    },
    {
      "end": 5157.0,
      "start": 5156.0,
      "text": "聽著音樂睡覺"
    },
    {
      "end": 5158.3,
      "start": 5157.3,
      "text": "聽著音樂起床"
    },
    {
      "end": 5160.7,
      "start": 5158.6,
      "text": "聽著音樂被幹掉"
    },
    {
      "end": 5162.4,
      "start": 5161.2,
      "text": "我們中國人是聽著什麼"
    },
    {
      "end": 5166.6,
      "start": 5164.8,
      "text": "反過來說這就是當時中國人"
    },
    {
      "end": 5168.0,
      "start": 5166.7,
      "text": "最重要斷代的時代"
    },
    {
      "end": 5170.8,
      "start": 5168.3,
      "text": "是最容易選出民主和法治進行的"
    },
    {
      "end": 5172.8,
      "start": 5170.8,
      "text": "掛機選上社會主義"
    },
    {
      "end": 5173.8,
      "start": 5172.8,
      "text": "共產主義"
    },
    {
      "end": 5176.1,
      "start": 5173.8,
      "text": "這個毒已經進了我們這好幾代人了"
    },
    {
      "end": 5178.2,
      "start": 5176.4,
      "text": "你想再搞個斷代時代"
    },
    {
      "end": 5179.5,
      "start": 5178.4,
      "text": "你還得死多少人"
    },
    {
      "end": 5181.1,
      "start": 5179.7,
      "text": "王大革命死一億人"
    },
    {
      "end": 5185.0,
      "start": 5182.4,
      "text": "最制戰爭死掉一千五百萬"
    },
    {
      "end": 5188.0,
      "start": 5185.9,
      "text": "你還要死的人才能達到斷代嗎"
    },
    {
      "end": 5192.0,
      "start": 5188.0,
      "text": "人類的文明是從過去的封建社會"
    },
    {
      "end": 5193.2,
      "start": 5192.2,
      "text": "到了工業文明"
    },
    {
      "end": 5195.1,
      "start": 5193.7,
      "text": "到了民主法治"
    },
    {
      "end": 5197.5,
      "start": 5195.4,
      "text": "從過去的全人類的家天下"
    },
    {
      "end": 5200.0,
      "start": 5197.8,
      "text": "變成了一個民天下"
    },
    {
      "end": 5202.5,
      "start": 5200.7,
      "text": "最好的一個工業文明時代"
    },
    {
      "end": 5204.8,
      "start": 5202.6,
      "text": "和從過去的天下"
    },
    {
      "end": 5208.8,
      "start": 5205.0,
      "text": "都是幾個家族的變成了人民當家作主"
    },
    {
      "end": 5211.5,
      "start": 5209.6,
      "text": "這個張學良其中起到了一個"
    },
    {
      "end": 5213.0,
      "start": 5211.7,
      "text": "最關鍵作用之一"
    },
    {
      "end": 5213.7,
      "start": 5213.2,
      "text": "就是戰爭死"
    },
    {
      "end": 5216.1,
      "start": 5213.7,
      "text": "中國人大概有70多次選擇"
    },
    {
      "end": 5218.0,
      "start": 5216.4,
      "text": "張學良幹掉了其中一次"
    },
    {
      "end": 5222.8,
      "start": 5221.5,
      "text": "這就是今天"
    },
    {
      "end": 5224.2,
      "start": 5223.1,
      "text": "我可以告訴大家"
    },
    {
      "end": 5226.4,
      "start": 5224.4,
      "text": "如果台灣沒有今天的民主"
    },
    {
      "end": 5229.2,
      "start": 5227.2,
      "text": "當時沒有1212的話"
    },
    {
      "end": 5230.0,
      "start": 5229.2,
      "text": "雙12的話"
    },
    {
      "end": 5232.7,
      "start": 5230.4,
      "text": "中國人的民主一定比台灣好"
    },
    {
      "end": 5234.4,
      "start": 5232.7,
      "text": "你但凡了解台灣歷史"
    },
    {
      "end": 5236.5,
      "start": 5235.3,
      "text": "你看看台灣"
    },
    {
      "end": 5239.5,
      "start": 5236.9,
      "text": "原住民高雄台中台北"
    },
    {
      "end": 5241.6,
