    {
      "end": 5316.6,
      "start": 5315.3,
      "text": "有真正存在"
    },
    {
      "end": 5318.2,
      "start": 5316.7,
      "text": "永遠不可能有安全"
    },
    {
      "end": 5319.9,
      "start": 5318.3,
      "text": "永遠不可能有健康"
    },
