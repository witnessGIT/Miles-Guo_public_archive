      "end": 5268.2,
      "start": 5267.3,
      "text": "沒有共產黨"
    },
    {
      "end": 5270.0,
      "start": 5268.5,
      "text": "一定也好過共產黨"
    },
    {
      "end": 5271.6,
      "start": 5270.1,
      "text": "中國最起碼是半民主"
    },
    {
      "end": 5272.4,
      "start": 5271.7,
      "text": "半封建社"
    },
    {
      "end": 5275.7,
      "start": 5273.7,
      "text": "不會差以今天的印度"
    },
    {
      "end": 5280.7,
      "start": 5278.5,
      "text": "這就是今天雙十二七個說的時候"
    },
    {
      "end": 5283.7,
      "start": 5281.2,
      "text": "你從中國人被剝奪了音樂"
    },
    {
      "end": 5287.5,
      "start": 5285.2,
      "text": "人起碼的動物的本能動靜"
    },
    {
      "end": 5289.2,
      "start": 5288.5,
      "text": "對上天"
    },
    {
      "end": 5290.1,
      "start": 5289.2,
      "text": "對自身"
    },
    {
      "end": 5290.8,
      "start": 5290.1,
      "text": "對人類"
    },
    {
      "end": 5293.2,
      "start": 5290.9,
      "text": "所有的訴求的工具都沒有以後"
    },
    {
      "end": 5295.2,
      "start": 5293.2,
      "text": "在中國出現了一切"
    },
    {
      "end": 5298.2,
      "start": 5295.2,
      "text": "中國一切一切都是幫騙子回到了中國"
    },
    {
      "end": 5299.9,
