      "text": "整個台灣的東半島"
    },
    {
      "end": 5243.3,
      "start": 5242.0,
      "text": "幾乎是原始時代"
    },
    {
      "end": 5245.2,
      "start": 5243.7,
      "text": "農業農耕文化"
    },
    {
      "end": 5246.6,
      "start": 5245.7,
      "text": "西半島"
    },
    {
      "end": 5248.2,
      "start": 5247.1,
      "text": "對著大陸這邊的"
    },
    {
      "end": 5249.3,
      "start": 5248.3,
      "text": "什麼芯片"
