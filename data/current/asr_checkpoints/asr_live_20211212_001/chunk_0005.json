      "end": 5321.7,
      "start": 5320.0,
      "text": "永遠不可能有安全"
    },
    {
      "end": 5324.7,
      "start": 5323.2,
      "text": "再一個就是善惡"
    },
    {
      "end": 5328.2,
      "start": 5325.3,
      "text": "現在中國人就不知道什麼叫善什麼叫惡"
    },
    {
      "end": 5329.2,
      "start": 5328.5,
      "text": "你看到一個"
    },
    {
      "end": 5331.5,
      "start": 5329.5,
      "text": "這兩天爭論很多的是習的女兒那個"
    },
    {
      "end": 5333.2,
      "start": 5331.7,
      "text": "那肯定不是習的女兒"
    },
    {
      "end": 5334.2,
      "start": 5333.5,
      "text": "我可以告訴大家"
    },
    {
      "end": 5335.0,
      "start": 5334.5,
      "text": "我跟你們說"
    },
    {
      "end": 5335.5,
      "start": 5335.0,
      "text": "嚇你們大跳"
    },
    {
      "end": 5336.2,
      "start": 5335.5,
      "text": "我非常了解"
    },
    {
      "end": 5337.2,
      "start": 5336.5,
      "text": "他就在對面"
    },
    {
      "end": 5338.7,
      "start": 5337.2,
      "text": "157號57"
    },
    {
      "end": 5340.2,
      "start": 5338.9,
      "text": "王岐山講他也有房子"
    },
    {
      "end": 5342.0,
      "start": 5340.9,
      "text": "習的女兒"
    },
    {
      "end": 5344.9,
      "start": 5343.2,
      "text": "真正的名字叫木子"
    },
    {
      "end": 5346.9,
      "start": 5345.4,
      "text": "真正名字叫木子護照"
    },
    {
      "end": 5348.0,
      "start": 5347.2,
      "text": "李木子"
    },
    {
      "end": 5350.0,
      "start": 5348.9,
      "text": "我可以告訴大家"
    },
    {
      "end": 5352.0,
      "start": 5351.2,
      "text": "叫李木子"
    },
    {
      "end": 5354.2,
      "start": 5352.0,
      "text": "就在我直播前"
    },
    {
      "end": 5355.3,
      "start": 5354.2,
      "text": "我都知道他在那"
    },
    {
      "end": 5358.3,
      "start": 5357.0,
      "text": "他住在黨校旁邊"
    },
    {
      "end": 5360.3,
      "start": 5358.5,
      "text": "跟李長春是隔壁鄰居"
    },
    {
      "end": 5366.7,
      "start": 5362.2,
      "text": "他大概有60個人的所謂不務特警"
    },
    {
      "end": 5368.7,
      "start": 5367.4,
      "text": "但是他經常來美國"
    },
    {
      "end": 5370.2,
      "start": 5369.2,
      "text": "他也在這有房子"
    },
    {
      "end": 5371.0,
      "start": 5370.4,
      "text": "沒錯"
    },
    {
      "end": 5373.8,
      "start": 5372.0,
      "text": "生活你看到那個粉專"
