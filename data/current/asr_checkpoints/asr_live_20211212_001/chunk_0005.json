      "end": 5250.9,
      "start": 5250.4,
      "text": "台北"
    },
    {
      "end": 5251.4,
      "start": 5250.9,
      "text": "政府"
    },
    {
      "end": 5252.5,
      "start": 5251.4,
      "text": "都在這"
    },
    {
      "end": 5256.6,
      "start": 5255.0,
      "text": "他能在最短的時間"
    },
    {
      "end": 5257.7,
      "start": 5256.6,
      "text": "能搞出這個民主"
    },
    {
      "end": 5260.0,
      "start": 5257.8,
      "text": "那蔣介石如果是不被國民黨干掉的話"
    },
    {
      "end": 5262.0,
      "start": 5260.1,
      "text": "他倆中國一定搞得比這個還沒"
    },
    {
      "end": 5263.7,
      "start": 5262.7,
      "text": "不會比這個再差"
    },
    {
      "end": 5265.2,
      "start": 5263.8,
      "text": "一定比這個還搞得還沒"
    },
    {
      "end": 5267.2,
      "start": 5265.8,
      "text": "假如沒有國民黨"
