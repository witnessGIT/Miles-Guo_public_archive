    {
      "end": 5375.6,
      "start": 5374.2,
      "text": "勞斯萊斯斯頓飛機"
    },
    {
      "end": 5376.2,
      "start": 5375.7,
      "text": "我這姐妹"
    },
    {
      "end": 5377.5,
      "start": 5376.2,
      "text": "你們覺得很誇張是嗎"
    },
    {
      "end": 5381.6,
      "start": 5378.5,
      "text": "時候比這誇張不少多少倍了"
    },
    {
      "end": 5383.7,
      "start": 5383.0,
      "text": "我又說"
    },
    {
      "end": 5384.8,
      "start": 5383.7,
      "text": "你們五年前說"
    },
    {
      "end": 5386.5,
      "start": 5384.8,
      "text": "我一說幾千億幾萬億"
    },
    {
      "end": 5387.5,
      "start": 5386.5,
      "text": "誇張"
    },
    {
      "end": 5390.0,
      "start": 5387.7,
      "text": "這麼一動幾萬億幾千億"
    },
    {
      "end": 5390.9,
      "start": 5390.3,
      "text": "現在都知道"
    },
    {
      "end": 5392.0,
      "start": 5390.9,
      "text": "你們一說一人"
    },
    {
      "end": 5393.8,
      "start": 5392.0,
      "text": "一張嘴都是萬億千億了"
    },
    {
      "end": 5395.3,
      "start": 5394.3,
      "text": "我怕嚇著你們"
    },
    {
      "end": 5399.0,
      "start": 5395.3,
      "text": "習對家人的愛和照顧"
    },
    {
      "end": 5400.0,
