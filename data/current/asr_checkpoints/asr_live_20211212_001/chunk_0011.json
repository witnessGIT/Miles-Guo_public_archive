      "end": 10133.0,
      "start": 10132.6,
      "text": "第二"
    },
    {
      "end": 10135.3,
      "start": 10133.9,
      "text": "这本书能出版吗"
    },
    {
      "end": 10136.6,
      "start": 10135.9,
      "text": "这在中国"
    },
    {
      "end": 10138.1,
      "start": 10137.6,
      "text": "答案是"
    },
    {
      "end": 10138.7,
      "start": 10138.3,
      "text": "不可能"
    },
    {
      "end": 10140.2,
      "start": 10139.6,
      "text": "第三条"
    },
    {
      "end": 10144.1,
      "start": 10141.7,
      "text": "如果是中国的皮特·纳瓦罗"
    },
    {
      "end": 10147.0,
      "start": 10145.7,
      "text": "他有机会"
    },
    {
      "end": 10148.7,
      "start": 10147.7,
      "text": "有可能"
    },
    {
      "end": 10151.0,
      "start": 10148.7,
      "text": "把这个信息写到书上吗"
    },
    {
      "end": 10153.0,
      "start": 10151.9,
      "text": "他命都早贝"
    },
    {
      "end": 10155.1,
      "start": 10154.6,
      "text": "第四"
    },
    {
      "end": 10157.7,
      "start": 10156.1,
      "text": "这本书出来以后"
    },
    {
      "end": 10159.8,
      "start": 10158.0,
      "text": "习近平让你就是以上"
    },
    {
      "end": 10161.8,
      "start": 10160.2,
      "text": "全部是答案是Yes的话"
    },
    {
      "end": 10162.9,
      "start": 10162.2,
      "text": "你可以写"
    },
    {
      "end": 10163.8,
      "start": 10162.9,
      "text": "你能出版"
    },
    {
      "end": 10166.2,
      "start": 10165.1,
      "text": "你都能印出来"
    },
    {
      "end": 10168.0,
      "start": 10166.6,
      "text": "他敢找习近平说"
    },
    {
      "end": 10171.6,
      "start": 10168.3,
      "text": "你竟然不推广我说你女婿女儿的书吗"
    },
    {
      "end": 10173.0,
      "start": 10172.4,
      "text": "吓死你"
    },
    {
      "end": 10174.6,
      "start": 10173.3,
      "text": "中国离得有多遥远"
    },
    {
      "end": 10176.6,
      "start": 10175.6,
      "text": "没有人去思考这问题"
    },
    {
      "end": 10177.7,
      "start": 10177.3,
      "text": "第五条"
    },
    {
      "end": 10178.3,
      "start": 10177.7,
      "text": "更可怕"
    },
    {
      "end": 10182.1,
      "start": 10179.6,
      "text": "这本书成为了美国最场销书"
    },
    {
      "end": 10184.3,
      "start": 10183.4,
      "text": "最好的书"
    },
    {
      "end": 10186.5,
      "start": 10185.0,
      "text": "川普竟然没否认"
    },
    {
      "end": 10190.1,
      "start": 10189.2,
      "text": "在中国"
    },
    {
      "end": 10192.1,
      "start": 10190.2,
      "text": "立马的不是人要么死了"
    },
    {
      "end": 10192.9,
      "start": 10192.1,
      "text": "要么被抓了"
    },
    {
      "end": 10193.9,
      "start": 10192.9,
      "text": "要么不能出版"
    },
    {
      "end": 10194.9,
      "start": 10194.1,
      "text": "一定是否认"
    },
    {
      "end": 10195.9,
      "start": 10194.9,
      "text": "都是胡扯"
    },
    {
      "end": 10197.0,
      "start": 10195.9,
      "text": "一切胡扯"
    },
    {
      "end": 10197.8,
      "start": 10197.0,
      "text": "郭文贵"
    },
    {
      "end": 10198.6,
      "start": 10197.8,
      "text": "骗子"
    },
    {
      "end": 10199.2,
      "start": 10198.6,
      "text": "流氓"
    },
    {
      "end": 10199.9,
      "start": 10199.2,
      "text": "过三秒"
    },
    {
      "end": 10200.6,
      "start": 10199.9,
      "text": "过视频"
    },
    {
      "end": 10201.8,
      "start": 10200.6,
      "text": "一个新的视频"
    },
    {
      "end": 10203.3,
      "start": 10201.8,
      "text": "孙瑶"
    },
    {
      "end": 10204.3,
      "start": 10203.3,
