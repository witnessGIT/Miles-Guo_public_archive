    },
    {
      "end": 10204.9,
      "start": 10204.3,
      "text": "也都出来了"
    },
    {
      "end": 10207.1,
      "start": 10204.9,
      "text": "第六个大家想想"
    },
    {
      "end": 10208.3,
      "start": 10207.1,
      "text": "可怕在哪里"
    },
    {
      "end": 10211.2,
      "start": 10209.3,
      "text": "如果皮特·纳瓦罗"
    },
    {
      "end": 10213.1,
      "start": 10211.2,
      "text": "在中国写了这本书"
    },
    {
      "end": 10216.3,
      "start": 10213.1,
      "text": "他会被定义为卖国罪"
    },
    {
      "end": 10219.1,
      "start": 10216.3,
      "text": "因为你是全世界通败"
    },
    {
      "end": 10222.2,
      "start": 10219.5,
      "text": "最后一条"
    },
    {
      "end": 10223.6,
      "start": 10222.2,
      "text": "皮特·纳瓦罗"
