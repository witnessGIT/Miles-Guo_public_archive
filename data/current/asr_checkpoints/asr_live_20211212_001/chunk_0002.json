      "end": 2573.52,
      "start": 2572.52,
      "text": "最重要的事情"
    },
    {
      "end": 2575.22,
      "start": 2573.52,
      "text": "整个伊拉克大约军"
    },
    {
      "end": 2576.52,
      "start": 2575.22,
      "text": "就跟希特勒"
