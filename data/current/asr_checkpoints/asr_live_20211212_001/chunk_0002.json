      "text": "用残疾人唱的吗"
    },
    {
      "end": 2627.42,
      "start": 2626.52,
      "text": "没有的"
    },
    {
      "end": 2630.72,
      "start": 2627.42,
      "text": "全是少女少男"
    },
    {
      "end": 2634.22,
      "start": 2630.72,
      "text": "而且要唱出那种所谓的"
    },
    {
      "end": 2635.92,
      "start": 2634.22,
      "text": "天赖的声音也好"
    },
    {
      "end": 2637.12,
      "start": 2635.92,
      "text": "青春的声音也好"
    },
    {
      "end": 2638.42,
      "start": 2637.12,
      "text": "你看那个什么什么"
    },
    {
      "end": 2639.72,
      "start": 2638.42,
      "text": "那个杨子军的歌"
    },
    {
      "end": 2641.42,
      "start": 2639.72,
      "text": "从小时候我们都记得"
    },
    {
      "end": 2643.82,
      "start": 2641.42,
      "text": "墙上套出那种小红鞋是吧"
    },
    {
      "end": 2644.92,
      "start": 2643.82,
      "text": "咔咔的唱"
    },
    {
      "end": 2646.32,
      "start": 2644.92,
      "text": "什么大有作为"
    },
    {
      "end": 2648.42,
      "start": 2646.32,
      "text": "音乐"
    },
    {
      "end": 2651.12,
      "start": 2648.42,
      "text": "是主导任何动物"
    },
    {
      "end": 2653.12,
      "start": 2651.42,
      "text": "和地球人类的"
    },
    {
      "end": 2654.12,
      "start": 2653.12,
      "text": "最便宜的"
    },
    {
      "end": 2655.22,
      "start": 2654.12,
      "text": "最有力的"
    },
    {
      "end": 2656.12,
      "start": 2655.22,
      "text": "最广泛的"
    },
    {
      "end": 2657.82,
      "start": 2656.12,
      "text": "最深远的"
    },
    {
      "end": 2660.52,
      "start": 2657.82,
      "text": "武器"
    },
    {
      "end": 2664.02,
      "start": 2660.52,
      "text": "洗脑力气有仨"
    },
    {
      "end": 2667.12,
      "start": 2664.02,
      "text": "动静叫音乐"
    },
