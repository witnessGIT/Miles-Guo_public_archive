      "text": "毛泽东你就更不用提了"
    },
    {
      "end": 2588.48,
      "start": 2587.74,
      "text": "是吧"
    },
    {
      "end": 2590.78,
      "start": 2588.48,
      "text": "把西安那烫上的那个这个"
    },
    {
      "end": 2592.38,
      "start": 2590.78,
      "text": "杏娇的民歌"
    },
    {
      "end": 2592.98,
      "start": 2592.38,
      "text": "是吧"
    },
    {
      "end": 2594.78,
      "start": 2592.98,
      "text": "改成了东方红太阳声啊"
    },
    {
      "end": 2595.48,
      "start": 2594.78,
      "text": "旧金山上"
    },
    {
      "end": 2596.68,
      "start": 2595.48,
      "text": "所有的音乐"
    },
    {
      "end": 2598.28,
      "start": 2596.68,
      "text": "把改完音乐的人"
    },
    {
      "end": 2599.52,
      "start": 2598.28,
      "text": "就是你在家里啥也得干"
    },
    {
      "end": 2600.42,
      "start": 2599.52,
      "text": "天天给我写歌"
    },
    {
      "end": 2604.32,
      "start": 2600.42,
      "text": "周恩来一搞又一搞的皮啊"
    },
    {
      "end": 2607.32,
      "start": 2604.32,
      "text": "郭摩洛 梁树明这些大佬们"
    },
    {
      "end": 2608.42,
      "start": 2607.32,
      "text": "一个一个的审啊"
    },
    {
      "end": 2609.82,
      "start": 2608.42,
      "text": "你看他歌改过很多次"
    },
    {
      "end": 2610.82,
      "start": 2609.82,
      "text": "阅律啊"
    },
    {
      "end": 2612.22,
      "start": 2610.82,
      "text": "全部你记住"
    },
    {
      "end": 2614.72,
      "start": 2612.22,
      "text": "共产党学来了什么"
    },
    {
      "end": 2615.72,
      "start": 2614.72,
      "text": "德国"
    },
    {
      "end": 2618.28,
      "start": 2615.72,
      "text": "希特勒和斯大林的所有的人力"
    },
    {
      "end": 2619.12,
      "start": 2618.28,
      "text": "都才一来"
    },
    {
      "end": 2621.42,
      "start": 2619.12,
      "text": "用少女少男来唱的歌"
    },
    {
      "end": 2623.82,
      "start": 2621.42,
      "text": "你见过有一个这些国家歌"
    },
    {
      "end": 2625.22,
      "start": 2623.82,
      "text": "用老人家唱的吗"
    },
    {
      "end": 2626.52,
