      "text": "完全不负责任"
    },
    {
      "end": 1187.66,
      "start": 1186.14,
      "text": "完全挑战美国"
    },
    {
      "end": 1188.92,
      "start": 1187.66,
      "text": "完全挑战西方"
    },
    {
      "end": 1192.26,
      "start": 1188.92,
      "text": "使全世界人民如任何不存在"
    },
    {
      "end": 1193.88,
      "start": 1192.26,
      "text": "这种流氓"
    },
    {
      "end": 1196.06,
      "start": 1193.88,
      "text": "这种黑社会的感觉"
    },
    {
      "end": 1198.18,
      "start": 1196.06,
      "text": "完全地展示给这个世界"
    },
    {
      "end": 1200.84,
      "start": 1198.18,
      "text": "共产党已经完全失控了"
    },
    {
      "end": 1203.62,
      "start": 1200.84,
      "text": "那么它是世界爱好和平"
    },
    {
      "end": 1206.04,
      "start": 1203.62,
      "text": "追求法治民主自由的"
    },
    {
      "end": 1208.0,
      "start": 1206.04,
      "text": "所有人的最大的敌人"
    },
    {
      "end": 1209.28,
      "start": 1208.0,
      "text": "那么我们现在请"
    },
    {
      "end": 1210.46,
      "start": 1209.28,
