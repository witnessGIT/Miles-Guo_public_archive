    {
      "end": 1281.44,
      "start": 1262.6,
      "text": "非常高興"
    },
    {
      "end": 1282.36,
      "start": 1281.44,
      "text": "我們今天傑森六十先生"
    },
    {
      "end": 1284.36,
      "start": 1282.36,
      "text": "談的觀點"
    },
    {
      "end": 1286.28,
      "start": 1284.36,
      "text": "在西方我們現在發現"
    },
    {
      "end": 1288.52,
      "start": 1286.28,
      "text": "並沒有很多人在關注"
    },
    {
      "end": 1290.44,
      "start": 1288.52,
      "text": "共產黨的百年大庭"
    },
    {
      "end": 1291.28,
      "start": 1290.44,
      "text": "它的意義是什麼"
    },
    {
      "end": 1293.92,
      "start": 1291.28,
      "text": "一九二一年到二零二一年"
    },
    {
      "end": 1295.56,
      "start": 1293.92,
      "text": "他昨天習近平的講話中"
    },
    {
      "end": 1297.24,
      "start": 1295.56,
      "text": "他手裏有個英文稿"
    },
    {
      "end": 1300.24,
      "start": 1297.24,
      "text": "多次的提到了兩個百年的計畫"
    },
    {
      "end": 1304.36,
      "start": 1300.24,
      "text": "就前一百年共產黨要完全的統治亞洲"
    },
    {
      "end": 1306.56,
      "start": 1304.36,
      "text": "統治所有的中國人民"
    },
    {
      "end": 1308.16,
      "start": 1306.56,
      "text": "輸出共產主義"
    },
    {
      "end": 1310.84,
      "start": 1308.16,
      "text": "昨天明確的告訴全世界人民"
    },
    {
      "end": 1312.24,
      "start": 1310.84,
      "text": "習近平講的那句話"
    },
    {
      "end": 1316.32,
      "start": 1312.24,
      "text": "共產黨是中國人唯一的代表和權力"
    },
    {
      "end": 1319.24,
      "start": 1316.32,
      "text": "共產黨和中國人民不能被分開"
    },
    {
      "end": 1321.88,
      "start": 1319.24,
      "text": "第三個共產主義行"
    },
    {
      "end": 1325.52,
      "start": 1321.88,
      "text": "共產主義是最好的一個人類的管理的方式"
    },
    {
      "end": 1327.24,
      "start": 1325.52,
      "text": "請傑森·米瑞現在想想"
    },
    {
      "end": 1329.8,
      "start": 1327.24,
      "text": "為什麼西方媒體沒有關注到共產黨"
    },
    {
      "end": 1333.32,
      "start": 1329.8,
      "text": "已經明確地認為這個世界需要共產主義"
    },
    {
      "end": 1334.96,
      "start": 1333.32,
      "text": "需要共產主義的管理模式"
    },
    {
      "end": 1335.6,
      "start": 1334.96,
      "text": "你來怎麼看"
    },
    {
      "end": 1337.12,
      "start": 1335.6,
      "text": "因為在美國的馬克思"
    },
    {
      "end": 1339.36,
      "start": 1337.12,
      "text": "已經是大家很敏感的詞了"
    },
    {
      "end": 1342.84,
      "start": 1339.36,
      "text": "但昨天習近平明確地說"
    },
