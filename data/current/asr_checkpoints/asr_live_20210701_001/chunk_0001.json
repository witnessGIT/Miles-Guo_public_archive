      "end": 1173.82,
      "start": 1169.98,
      "text": "完全的背道而驰的那种景象回到了北朝鲜的时代"
    },
    {
      "end": 1175.98,
      "start": 1173.82,
      "text": "而且绑架了14亿中国人民"
    },
    {
      "end": 1180.22,
      "start": 1175.98,
      "text": "完全不提这个冠状病毒给在世界带来的威胁"
    },
    {
      "end": 1182.16,
      "start": 1180.22,
      "text": "和对世界上人类的杀害"
    },
    {
      "end": 1184.72,
      "start": 1182.16,
      "text": "和正在持续的对人类的威胁"
    },
    {
      "end": 1186.14,
