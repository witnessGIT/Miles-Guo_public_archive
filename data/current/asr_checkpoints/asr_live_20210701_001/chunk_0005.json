{
  "chunk_audio_sha256": "7c498c2b0bf9808027e81b6f90e05303b0c090dc98b488031b0b99bd7e4ce776",
  "chunk_index": 5,
  "completed_at": "2026-10-20T13:25:17Z",
  "language": "zh",
  "live_id": "LIVE_20210701_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 4500,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 4502.52,
      "start": 4500.0,
      "text": "中国大陆的同胞强迫去打疫苗"
    },
    {
      "end": 4504.0,
      "start": 4502.52,
      "text": "在这个情况下面"
    },
    {
      "end": 4507.56,
      "start": 4504.0,
      "text": "您怎么去看今天中共它默示这个病毒真相"
    },
    {
      "end": 4512.12,
      "start": 4507.56,
      "text": "并且还持续地去迫害我们中国同胞在病毒问题上"
    },
    {
      "end": 4513.12,
      "start": 4512.12,
      "text": "谢谢二位"
    },
    {
      "end": 4519.04,
      "start": 4516.44,
      "text": "我觉得有很多"
    },
    {
      "end": 4522.64,
      "start": 4519.04,
      "text": "咱们中国人有一些很不好的毛病"
    },
    {
      "end": 4524.32,
      "start": 4522.64,
      "text": "喜欢占便宜"
    },
    {
      "end": 4529.88,
      "start": 4524.32,
      "text": "你看有很多他们比如在网上看见的"
    },
    {
      "end": 4533.56,
      "start": 4529.88,
      "text": "说哪有送什么电影票了"
    },
    {
      "end": 4534.68,
      "start": 4533.56,
      "text": "送什么东西了"
    },
    {
      "end": 4537.48,
      "start": 4534.68,
      "text": "你们打疫苗还有送这送那的"
    },
    {
      "end": 4542.48,
      "start": 4537.48,
      "text": "他就用这种方法去引诱你们去打疫苗"
    },
    {
      "end": 4549.24,
      "start": 4542.48,
      "text": "有些像比如说是老师什么一些医务人员这些"
    },
    {
      "end": 4551.44,
      "start": 4549.24,
      "text": "他们是必须要打疫苗"
    },
    {
      "end": 4556.28,
      "start": 4551.44,
      "text": "因为我家里就有人他们是医生的"
    },
    {
      "end": 4559.76,
      "start": 4556.28,
      "text": "有老师的他们就打了疫苗了"
    },
    {
      "end": 4565.56,
      "start": 4559.88,
      "text": "但是这东西它有很多这种方面的因素"
    },
    {
      "end": 4573.24,
      "start": 4565.56,
      "text": "我觉得后面还说是18岁以下的孩子也要打疫苗"
    },
    {
      "end": 4577.56,
      "start": 4573.24,
      "text": "所以我认为不把共产党早一点灭掉"
    },
    {
      "end": 4581.56,
      "start": 4577.56,
      "text": "我们的孩子我们都没有一个能够幸免"
    },
    {
      "end": 4585.56,
      "start": 4581.56,
      "text": "他们一定会做这样的事情包括你出行"
    },
    {
      "end": 4589.24,
      "start": 4585.56,
      "text": "你不让你坐飞机不让你坐火车不让你坐汽车"
    },
    {
      "end": 4593.24,
      "start": 4589.24,
      "text": "所有的东西它都会利用这些手段强制你们打疫苗"
    },
    {
      "end": 4597.08,
      "start": 4593.24,
      "text": "所以没办法这就是一个邪恶的体制"
    },
    {
      "end": 4602.76,
      "start": 4597.08,
      "text": "这就是我们俩的这个有我们的羽毛球学校"
    },
    {
      "end": 4605.76,
      "start": 4602.76,
      "text": "足球学校包括我们的我的清训基地啊什么"
    },
    {
      "end": 4608.6,
      "start": 4605.76,
      "text": "他的羽毛球馆未来会见我们在湖北啊"
    },
    {
      "end": 4610.76,
      "start": 4608.6,
      "text": "大爷离了武汉不远啊"
    },
    {
      "end": 4617.44,
      "start": 4610.76,
      "text": "你们要知道军运会开过以后没几天应该就在军会期间"
    },
    {
      "end": 4624.44,
      "start": 4617.44,
      "text": "习近平到过湖北军区的联勤部跟党员们开了个会啊"
    },
    {
      "end": 4629.44,
      "start": 4624.44,
      "text": "很小的范围很这个这个报道没有任何天气什么波澜"
    },
    {
      "end": 4632.44,
      "start": 4629.44,
      "text": "但是你们要知道这是很诡异啊"
    },
    {
      "end": 4637.12,
      "start": 4632.44,
      "text": "他为什么说了他自己对疫情亲自指挥亲自部署"
    },
    {
      "end": 4639.28,
      "start": 4637.12,
      "text": "这不是他胡说的啊"
    },
    {
      "end": 4645.1,
      "start": 4639.28,
      "text": "共产共独的释放对邪恶对他们的一步一步的那"
    },
    {
      "end": 4647.76,
      "start": 4645.1,
      "text": "他们都是有步骤有计划的"
    },
    {
      "end": 4649.5,
      "start": 4647.76,
      "text": "他们不是心血来潮"
    },
    {
      "end": 4654.84,
      "start": 4649.5,
      "text": "所以他对任何的这种犯下的罪恶都是有机可查"
    },
    {
      "end": 4656.08,
      "start": 4654.84,
      "text": "有机可循的"
    },
    {
      "end": 4659.7,
      "start": 4656.08,
      "text": "所以共产党你别以为他们是啊心血来潮"
    },
    {
      "end": 4662.14,
      "start": 4659.7,
      "text": "大家的他们是一步一步的啊"
    },
    {
      "end": 4664.74,
      "start": 4662.14,
      "text": "他们这种邪恶的组织如果不灭掉"
    },
    {
      "end": 4667.32,
      "start": 4664.74,
      "text": "全人类将永无安宁"
    },
    {
      "end": 4669.6,
      "start": 4667.32,
      "text": "以及会得可能会毁灭"
    },
    {
      "end": 4673.16,
      "start": 4669.6,
      "text": "所以我们要认清共产党的这种邪恶"
    },
    {
      "end": 4676.38,
      "start": 4673.16,
      "text": "就从这些最根本的最基础的东西"
    },
    {
      "end": 4678.3,
      "start": 4676.38,
      "text": "我们来向世界上揭露他们"
    },
    {
      "end": 4679.82,
      "start": 4678.3,
      "text": "好的小肥像"
    },
    {
      "end": 4685.76,
      "start": 4679.82,
      "text": "刚才小肥像的问题特别特别的好"
    },
    {
      "end": 4688.04,
      "start": 4685.76,
      "text": "这个长老鹅问的都问到关键的地方了"
    },
    {
      "end": 4692.08,
      "start": 4688.04,
      "text": "我觉得刚才尹妹妹今天你俩的这种发自内心的感受"
    },
    {
      "end": 4695.24,
      "start": 4692.08,
      "text": "这个我觉得希望真的中国人能明白"
    },
    {
      "end": 4697.26,
      "start": 4695.24,
      "text": "刚才说中国人爱占小便宜"
    },
    {
      "end": 4699.64,
      "start": 4697.26,
      "text": "再一个把这个地方当成了拉关系"
    },
    {
      "end": 4702.12,
      "start": 4699.64,
      "text": "这个所谓的交朋友"
    },
    {
      "end": 4704.3,
      "start": 4702.12,
      "text": "甚至捞资本拍点照片"
    },
    {
      "end": 4707.72,
      "start": 4704.3,
      "text": "回去忽悠比自己旁边更傻的人"
    },
    {
      "end": 4711.38,
      "start": 4707.72,
      "text": "所以中国它就是政治是庞氏骗局"
    },
    {
      "end": 4712.96,
      "start": 4711.38,
      "text": "经济庞氏骗局"
    },
    {
      "end": 4716.0,
      "start": 4712.96,
      "text": "就没有人问过昨天天安门城楼上"
    },
    {
      "end": 4717.48,
      "start": 4716.0,
      "text": "这么伟大的党"
    },
    {
      "end": 4719.18,
      "start": 4717.48,
      "text": "都这么牛的党"
    },
    {
      "end": 4720.36,
      "start": 4719.18,
      "text": "都一百年了"
    },
    {
      "end": 4721.88,
      "start": 4720.36,
      "text": "你连个芯片都找不出来"
    },
    {
      "end": 4725.02,
      "start": 4721.88,
      "text": "你连一个自主自身产权的汽车都没有"
    },
    {
      "end": 4726.9,
      "start": 4725.02,
      "text": "你连足球的现在"
    },
    {
      "end": 4728.74,
      "start": 4726.9,
      "text": "郝海东先生离开以后"
    },
    {
      "end": 4730.88,
      "start": 4728.74,
      "text": "连个像样的足球你都踢不出来"
    },
    {
      "end": 4732.3,
      "start": 4730.88,
      "text": "网球就没有了"
    },
    {
      "end": 4733.4,
      "start": 4732.3,
      "text": "叶昭有女士了"
    },
    {
      "end": 4735.4,
      "start": 4733.4,
      "text": "你还能赢世界杯吗"
    },
    {
      "end": 4737.18,
      "start": 4735.4,
      "text": "那下面的人咱不用别人"
    },
    {
      "end": 4738.08,
      "start": 4737.18,
      "text": "我昨天就想啊"
    },
    {
      "end": 4739.08,
      "start": 4738.08,
      "text": "我在这看到"
    },
    {
      "end": 4740.58,
      "start": 4739.08,
      "text": "昨天我泡了个澡"
    },
    {
      "end": 4742.22,
      "start": 4740.58,
      "text": "我把它放在那我看到"
    },
    {
      "end": 4743.66,
      "start": 4742.22,
      "text": "我说我让叶昭影"
    },
    {
      "end": 4745.44,
      "start": 4743.66,
      "text": "我妹妹到了天安门上站着"
    },
    {
      "end": 4747.28,
      "start": 4745.44,
      "text": "说我一个人打你下面所有人"
    },
    {
      "end": 4748.46,
      "start": 4747.28,
      "text": "有人敢举手吗"
    },
    {
      "end": 4749.66,
      "start": 4748.46,
      "text": "没人敢举手"
    },
    {
      "end": 4752.46,
      "start": 4749.66,
      "text": "我让郝海东先生把一只脚放在天安门上说"
    },
    {
      "end": 4754.3,
      "start": 4752.46,
      "text": "我一只脚欺骗你们所有人"
    },
    {
      "end": 4756.04,
      "start": 4754.3,
      "text": "有人敢还手还脚吗"
    },
    {
      "end": 4757.04,
      "start": 4756.04,
      "text": "没人敢"
    },
    {
      "end": 4758.96,
      "start": 4757.04,
      "text": "这不是我们吹牛吧"
    },
    {
      "end": 4760.16,
      "start": 4758.96,
      "text": "这是真的吗"
    },
    {
      "end": 4762.76,
      "start": 4760.16,
      "text": "所以说今天我就特别的感触"
    },
    {
      "end": 4765.76,
      "start": 4762.76,
      "text": "我说如果郝海东一脚扫平你们这些人"
    },
    {
      "end": 4769.42,
      "start": 4765.76,
      "text": "那么叶昭影和一球打败你所有人"
    },
    {
      "end": 4771.42,
      "start": 4769.42,
      "text": "你吹什么狼蛋呢在这儿啊"
    },
    {
      "end": 4773.58,
      "start": 4771.42,
      "text": "你吹啥狼蛋呢"
    },
    {
      "end": 4775.76,
      "start": 4773.58,
      "text": "那么下面人也听得很认真"
    },
    {
      "end": 4778.96,
      "start": 4775.76,
      "text": "这就是我真的是我觉得我很小的时候"
    },
    {
      "end": 4781.86,
      "start": 4778.96,
      "text": "我有幸见过邓小平两三次啊"
    },
    {
      "end": 4783.76,
      "start": 4781.86,
      "text": "我跟我拜拜见邓小平的时候"
    },
    {
      "end": 4786.14,
      "start": 4783.76,
      "text": "我记得非常清楚啊"
    },
    {
      "end": 4788.64,
      "start": 4786.14,
      "text": "抽着烟在那儿弹着烟邓小平"
    },
    {
      "end": 4791.14,
      "start": 4788.64,
      "text": "我拜拜问他那些傻话啊"
    },
    {
      "end": 4793.3,
      "start": 4791.14,
      "text": "说你看看最近看你这个讲话呀"
    },
    {
      "end": 4795.3,
      "start": 4793.3,
      "text": "这说的跟过去好像还不一样了"
    },
    {
      "end": 4798.3,
      "start": 4795.3,
      "text": "我是不是理解有误会呀"
    },
    {
      "end": 4800.64,
      "start": 4798.3,
      "text": "小平同事看看他啊"
    },
    {
      "end": 4803.64,
      "start": 4800.64,
      "text": "要认认真真真地说假话"
    },
    {
      "end": 4805.64,
      "start": 4803.64,
      "text": "认认真真真地说假话"
    },
    {
      "end": 4809.3,
      "start": 4805.64,
      "text": "要不然才会认认真真真地去听话"
    },
    {
      "end": 4809.64,
      "start": 4809.3,
      "text": "是吧"
    },
    {
      "end": 4810.3,
      "start": 4809.64,
      "text": "下不然认真真去听话"
    },
    {
      "end": 4812.3,
      "start": 4810.3,
      "text": "昨天我真发现了"
    },
    {
      "end": 4814.96,
      "start": 4812.3,
      "text": "你看看我昨天我看这里边啊"
    },
    {
      "end": 4817.8,
      "start": 4814.96,
      "text": "你看看十月革命一声炮响"
    },
    {
      "end": 4819.96,
      "start": 4817.8,
      "text": "给中国送来马克思的立军主义"
    },
    {
      "end": 4821.96,
      "start": 4819.96,
      "text": "在中国和人民的中华民伟大觉醒中"
    },
    {
      "end": 4823.96,
      "start": 4821.96,
      "text": "马克思在中国应运诞生了"
    },
    {
      "end": 4825.96,
      "start": 4823.96,
      "text": "为人民谋幸福"
    },
    {
      "end": 4829.96,
      "start": 4825.96,
      "text": "北伐战争 土地战争 抗制战争 解放战争"
    },
    {
      "end": 4831.8,
      "start": 4829.96,
      "text": "武装革命的反对武装反革命"
    },
    {
      "end": 4836.3,
      "start": 4831.8,
      "text": "推翻了帝国主义 封建主义 官僚质民主义的三桌大三"
    },
    {
      "end": 4838.3,
      "start": 4836.3,
      "text": "你说我儿子八倍祖宗的"
    },
    {
      "end": 4843.16,
      "start": 4838.3,
      "text": "你能写出这种话 你敢对着世界的媒体"
    },
    {
      "end": 4846.46,
      "start": 4843.16,
      "text": "你还敢说 下面那么多人认真地听"
    },
    {
      "end": 4849.46,
      "start": 4846.46,
      "text": "听完一会放到世界媒体上去"
    },
    {
      "end": 4851.96,
      "start": 4849.46,
      "text": "你真把全人类都当傻子吗"
    },
    {
      "end": 4855.76,
      "start": 4851.96,
      "text": "东介颖妹妹你觉得是不是悲哀呀"
    },
    {
      "end": 4858.14,
      "start": 4855.76,
      "text": "怎么悲哀才能了解"
    },
    {
      "end": 4860.9,
      "start": 4858.14,
      "text": "因为什么话能形容这种愚蠢"
    },
    {
      "end": 4862.8,
      "start": 4860.9,
      "text": "这种无知 这种自嗨"
    },
    {
      "end": 4865.54,
      "start": 4862.8,
      "text": "然后到了他北朝鲜那小旗子辉的"
    },
    {
      "end": 4867.4,
      "start": 4865.54,
      "text": "穿着北朝鲜的"
    },
    {
      "end": 4869.56,
      "start": 4867.4,
      "text": "人家阿里山姑娘的"
    },
    {
      "end": 4872.46,
      "start": 4869.56,
      "text": "叫牙蛋青色的那个衣服"
    },
    {
      "end": 4875.94,
      "start": 4872.46,
      "text": "一排又一排 很便宜 都是化学的"
    },
    {
      "end": 4877.84,
      "start": 4875.94,
      "text": "你觉得那很牛吗"
    },
    {
      "end": 4879.44,
      "start": 4877.84,
      "text": "你觉得很厉害吗"
    },
    {
      "end": 4881.56,
      "start": 4879.44,
      "text": "那你生产个芯片出来不就完了吗"
    },
    {
      "end": 4883.84,
      "start": 4881.56,
      "text": "所以说颖妹妹动地"
    },
    {
      "end": 4885.96,
      "start": 4883.84,
      "text": "你想想昨天主席在那"
    },
    {
      "end": 4888.16,
      "start": 4885.96,
      "text": "你做到多少你认识我认识的"
    },
    {
      "end": 4890.06,
      "start": 4888.16,
      "text": "你觉得可不可怜"
    },
    {
      "end": 4891.44,
      "start": 4890.06,
      "text": "你俩得想想 谢谢"
    },
    {
      "end": 4893.74,
      "start": 4891.44,
      "text": "是的 齐哥"
    },
    {
      "end": 4898.2,
      "start": 4893.74,
      "text": "你刚才就是讲到北朝鲜这个事情的时候"
    },
    {
      "end": 4900.8,
      "start": 4898.2,
      "text": "就让我想起来我们当年去到那"
    },
    {
      "end": 4903.7,
      "start": 4900.8,
      "text": "就是共产党跟他们是多么的一样"
    },
    {
      "end": 4909.2,
      "start": 4903.7,
      "text": "当我们当时吃饭吃饭一开始去上矿泉水"
    },
    {
      "end": 4912.36,
      "start": 4909.2,
      "text": "到吃了几天以后呢"
    },
    {
      "end": 4916.26,
      "start": 4912.36,
      "text": "矿泉水啊上来的那个瓶盖全都是拧开了"
    },
    {
      "end": 4917.74,
      "start": 4916.26,
      "text": "一开始都是正常"
    },
    {
      "end": 4918.9,
      "start": 4917.74,
      "text": "那么一瓶上来"
    },
    {
      "end": 4920.7,
      "start": 4918.9,
      "text": "我们打开盖"
    },
    {
      "end": 4921.44,
      "start": 4920.7,
      "text": "后来"
    },
    {
      "end": 4922.3,
      "start": 4921.44,
      "text": "还是拧开了"
    },
    {
      "end": 4923.76,
      "start": 4922.3,
      "text": "到后来怎么了一看"
    },
    {
      "end": 4925.6,
      "start": 4923.76,
      "text": "他们全灌自然水在给我"
    },
    {
      "end": 4928.22,
      "start": 4925.6,
      "text": "他们已经穷了"
    },
    {
      "end": 4930.82,
      "start": 4928.22,
      "text": "就是弄虚作假"
    },
    {
      "end": 4934.12,
      "start": 4930.82,
      "text": "没有任何的底线"
    },
    {
      "end": 4935.22,
      "start": 4934.12,
      "text": "是吧"
    },
    {
      "end": 4938.72,
      "start": 4935.22,
      "text": "这都是中共一样一样一样的"
    },
    {
      "end": 4941.0,
      "start": 4938.72,
      "text": "而且他们的愚昧到了极点"
    },
    {
      "end": 4942.22,
      "start": 4941.0,
      "text": "就是"
    },
    {
      "end": 4945.68,
      "start": 4942.22,
      "text": "这个您肯定都知道"
    },
    {
      "end": 4946.68,
      "start": 4945.68,
      "text": "那杨海言"
    },
    {
      "end": 4948.02,
      "start": 4946.68,
      "text": "大家要知道"
    },
    {
      "end": 4949.08,
      "start": 4948.02,
      "text": "他的父亲"
    },
    {
      "end": 4949.96,
      "start": 4949.08,
      "text": "那杨德忠"
    },
    {
      "end": 4952.32,
      "start": 4949.96,
      "text": "那是中南海的真的最牛逼的"
    },
    {
      "end": 4954.36,
      "start": 4952.32,
      "text": "那是周恩来的侍卫长"
    },
    {
      "end": 4955.92,
      "start": 4954.36,
      "text": "真正的"
    },
    {
      "end": 4957.72,
      "start": 4955.92,
      "text": "真正的老大"
    },
    {
      "end": 4958.96,
      "start": 4957.72,
      "text": "我都说了嘛"
    },
    {
      "end": 4960.42,
      "start": 4958.96,
      "text": "他的外孙子"
    },
    {
      "end": 4961.36,
      "start": 4960.42,
      "text": "当有一天"
    },
    {
      "end": 4964.56,
      "start": 4961.36,
      "text": "我去到南池子的时候"
    },
    {
      "end": 4966.86,
      "start": 4964.56,
      "text": "他陪他外孙子玩"
    },
    {
      "end": 4969.58,
      "start": 4966.86,
      "text": "他给他外孙子的膝关节"
    },
    {
      "end": 4972.18,
      "start": 4969.58,
      "text": "都带上两个护膝"
    },
    {
      "end": 4973.42,
      "start": 4972.22,
      "text": "这是我看到的"
    },
    {
      "end": 4973.92,
      "start": 4973.42,
      "text": "就是说"
    },
    {
      "end": 4976.42,
      "start": 4973.92,
      "text": "我知道中国人难了"
    },
    {
      "end": 4976.78,
      "start": 4976.42,
      "text": "懂吗"
    },
    {
      "end": 4977.32,
      "start": 4976.78,
      "text": "就是说"
    },
    {
      "end": 4979.68,
      "start": 4977.32,
      "text": "在这么高级的家庭里面"
    },
    {
      "end": 4982.48,
      "start": 4979.68,
      "text": "所有的真正的核心"
    },
    {
      "end": 4984.12,
      "start": 4982.48,
      "text": "真正他们的生杀大权"
    },
    {
      "end": 4986.56,
      "start": 4984.12,
      "text": "握在他们手里面的时候"
    },
    {
      "end": 4989.16,
      "start": 4986.56,
      "text": "他们对未来就是这么一个"
    },
    {
      "end": 4991.28,
      "start": 4989.16,
      "text": "当然他们非常非常爱"
    },
    {
      "end": 4993.46,
      "start": 4991.28,
      "text": "所谓的他们想江山带带船"
    },
    {
      "end": 4993.92,
      "start": 4993.46,
      "text": "是吧"
    },
    {
      "end": 4996.18,
      "start": 4993.92,
      "text": "但是他们这么样就是"
    },
    {
      "end": 4999.12,
      "start": 4996.18,
      "text": "让孩子就怕摔着碰着"
    },
    {
      "end": 5000.72,
      "start": 4999.12,
      "text": "还讲到了你"
    },
    {
      "end": 5001.86,
      "start": 5000.72,
      "text": "之前说陈同华"
    },
    {
      "end": 5004.16,
      "start": 5001.86,
      "text": "陈同华后来能去"
    },
    {
      "end": 5005.96,
      "start": 5004.16,
      "text": "中石油能那个"
    },
    {
      "end": 5007.9,
      "start": 5005.96,
      "text": "就是他犯完错误以后"
    },
    {
      "end": 5009.26,
      "start": 5007.9,
      "text": "在杨德忠家"
    },
    {
      "end": 5010.66,
      "start": 5009.26,
      "text": "待了一年多"
    },
    {
      "end": 5013.22,
      "start": 5010.66,
      "text": "一直陪老头去到那儿"
    },
    {
      "end": 5013.5,
      "start": 5013.22,
      "text": "哇塞"
    },
    {
      "end": 5014.26,
      "start": 5013.5,
      "text": "点头哈腰"
    },
    {
      "end": 5015.42,
      "start": 5014.26,
      "text": "陪着喝水喝茶"
    },
    {
      "end": 5017.06,
      "start": 5015.42,
      "text": "可能大会扑克下会象棋"
    },
    {
      "end": 5017.76,
      "start": 5017.06,
      "text": "一年多"
    },
    {
      "end": 5018.86,
      "start": 5017.76,
      "text": "给他恢复了"
    },
    {
      "end": 5019.96,
      "start": 5018.86,
      "text": "这个工作"
    },
    {
      "end": 5021.7,
      "start": 5019.96,
      "text": "那陈同华这之前犯错误"
    },
    {
      "end": 5022.46,
      "start": 5021.7,
      "text": "给抹掉"
    },
    {
      "end": 5023.32,
      "start": 5022.46,
      "text": "一年多"
    },
    {
      "end": 5025.6,
      "start": 5023.32,
      "text": "在杨德忠家"
    },
    {
      "end": 5026.72,
      "start": 5025.6,
      "text": "就陪着这个"
    },
    {
      "end": 5031.12,
      "start": 5026.72,
      "text": "就是说中共所有走过的路里面"
    },
    {
      "end": 5033.32,
      "start": 5031.12,
      "text": "当你看到人民大会堂"
    },
    {
      "end": 5035.42,
      "start": 5033.32,
      "text": "站着的这些人的时候"
    },
    {
      "end": 5037.48,
      "start": 5035.42,
      "text": "你们就知道他们有多low"
    },
    {
      "end": 5038.58,
      "start": 5037.48,
      "text": "刚才七哥说了"
    },
    {
      "end": 5042.52,
      "start": 5038.58,
      "text": "郝海东叶昭尹可以在这大言不灿的告诉他们"
    },
    {
      "end": 5048.08,
      "start": 5042.52,
      "text": "我们站在天安门城楼上的时候一定是一脚一球一拍子拍死他们"
    },
    {
      "end": 5048.58,
      "start": 5048.08,
      "text": "因为什么"
    },
    {
      "end": 5053.14,
      "start": 5048.58,
      "text": "因为我们现在一路可以保持好的状态"
    },
    {
      "end": 5053.92,
      "start": 5053.14,
      "text": "好的身体"
    },
    {
      "end": 5054.12,
      "start": 5053.92,
      "text": "好的"
    },
    {
      "end": 5056.72,
      "start": 5054.12,
      "text": "甭说他们现在这些"
    },
    {
      "end": 5059.12,
      "start": 5056.72,
      "text": "这个这个这个退役的跟我们一边大了"
    },
    {
      "end": 5061.02,
      "start": 5059.12,
      "text": "就现役的这些无垒他们"
    },
    {
      "end": 5063.42,
      "start": 5061.02,
      "text": "跟郝海东什么这些腰腹"
    },
    {
      "end": 5064.98,
      "start": 5063.42,
      "text": "引体向上"
    },
    {
      "end": 5066.16,
      "start": 5064.98,
      "text": "这些核心力量"
    },
    {
      "end": 5066.98,
      "start": 5066.16,
      "text": "这些爆发力"
    },
    {
      "end": 5068.62,
      "start": 5066.98,
      "text": "没有一个人敢吹牛逼"
    },
    {
      "end": 5069.62,
      "start": 5068.62,
      "text": "他能做过我的"
    },
    {
      "end": 5071.58,
      "start": 5069.62,
      "text": "我都50多了"
    },
    {
      "end": 5072.4,
      "start": 5071.58,
      "text": "七哥"
    },
    {
      "end": 5073.38,
      "start": 5072.4,
      "text": "我可以"
    },
    {
      "end": 5074.52,
      "start": 5073.38,
      "text": "他们知道我"
    },
    {
      "end": 5076.3,
      "start": 5074.52,
      "text": "因为我讲的每一句话"
    },
    {
      "end": 5077.46,
      "start": 5076.3,
      "text": "他们都知道"
    },
    {
      "end": 5079.22,
      "start": 5077.46,
      "text": "他们都看坏都没有吹牛逼"
    },
    {
      "end": 5080.0,
      "start": 5079.22,
      "text": "对吧"
    },
    {
      "end": 5081.8,
      "start": 5080.0,
      "text": "那当年讲白了"
    },
    {
      "end": 5083.6,
      "start": 5081.8,
      "text": "今天应该薄熙来站在上面"
    },
    {
      "end": 5084.22,
      "start": 5083.6,
      "text": "对吧"
    },
    {
      "end": 5086.5,
      "start": 5084.22,
      "text": "那我们跟薄熙来挑上门就进"
    },
    {
      "end": 5087.76,
      "start": 5086.5,
      "text": "我们好得很"
    },
    {
      "end": 5088.96,
      "start": 5087.76,
      "text": "他在大连地址"
    },
    {
      "end": 5092.8,
      "start": 5088.96,
      "text": "但是我不认为一个人能改变了中国"
    },
    {
      "end": 5094.62,
      "start": 5092.8,
      "text": "因为这是体制的问题"
    },
    {
      "end": 5095.5,
      "start": 5094.62,
      "text": "当然了"
    },
    {
      "end": 5097.2,
      "start": 5095.5,
      "text": "劣币驱出良弊"
    },
    {
      "end": 5100.5,
      "start": 5097.2,
      "text": "他们肯定不会让薄熙来到了今天这个位置上"
    },
    {
      "end": 5103.5,
      "start": 5100.5,
      "text": "因为胡锦涛文家乐他们吓死了"
    },
    {
      "end": 5106.86,
      "start": 5103.5,
      "text": "那他上来今天咱们你太明白了"
    },
    {
      "end": 5109.9,
      "start": 5106.86,
      "text": "我先来上来第一个干死你孙家宝"
    },
    {
      "end": 5112.32,
      "start": 5109.9,
      "text": "他得吓死他的儿子温云松"
    },
    {
      "end": 5114.32,
      "start": 5112.32,
      "text": "那都是博说的呀"
    },
    {
      "end": 5116.2,
      "start": 5114.32,
      "text": "说那么你这个臭小子"
    },
    {
      "end": 5117.86,
      "start": 5116.2,
      "text": "我第一个上来先把他干了"
    },
    {
      "end": 5120.2,
      "start": 5117.86,
      "text": "这个东西"
    },
    {
      "end": 5121.9,
      "start": 5120.2,
      "text": "他都是有联系的"
    },
    {
      "end": 5123.4,
      "start": 5121.9,
      "text": "今天的政治"
    },
    {
      "end": 5125.56,
      "start": 5123.4,
      "text": "看见天安城楼上的"
    },
    {
      "end": 5128.86,
      "start": 5125.56,
      "text": "你们就看见了共产党他们没几天"
    },
    {
      "end": 5129.8,
      "start": 5128.86,
      "text": "真的是几个"
    },
    {
      "end": 5130.44,
      "start": 5129.8,
      "text": "因为什么"
    },
    {
      "end": 5132.24,
      "start": 5130.44,
      "text": "因为就是这样"
    },
    {
      "end": 5133.4,
      "start": 5132.24,
      "text": "有点能力的"
    },
    {
      "end": 5134.56,
      "start": 5133.4,
      "text": "有点个性的"
    },
    {
      "end": 5135.74,
      "start": 5134.56,
      "text": "有点才能的"
    },
    {
      "end": 5136.86,
      "start": 5135.74,
      "text": "一定被干掉"
    },
    {
      "end": 5137.44,
      "start": 5136.86,
      "text": "对吧"
    },
    {
      "end": 5137.86,
      "start": 5137.44,
      "text": "对啊"
    },
    {
      "end": 5139.9,
      "start": 5137.86,
      "text": "就像我们体育界一样"
    },
    {
      "end": 5142.9,
      "start": 5139.9,
      "text": "你打的时间比较长了"
    },
    {
      "end": 5144.32,
      "start": 5142.9,
      "text": "你退一晚的"
    },
    {
      "end": 5146.2,
      "start": 5144.32,
      "text": "就你想当教练不可能"
    },
    {
      "end": 5147.32,
      "start": 5146.2,
      "text": "没你的位置了"
    },
    {
      "end": 5147.82,
      "start": 5147.32,
      "text": "对吧"
    },
    {
      "end": 5151.52,
      "start": 5147.82,
      "text": "你只能去跟领导拍马屁去讲好话"
    },
    {
      "end": 5155.5,
      "start": 5151.52,
      "text": "给你安排一个什么工作"
    },
    {
      "end": 5157.32,
      "start": 5155.5,
      "text": "给你安排一个当教"
    },
    {
      "end": 5159.18,
      "start": 5157.32,
      "text": "像我们你说"
    },
    {
      "end": 5161.68,
      "start": 5159.18,
      "text": "你当一个普通的教练"
    },
    {
      "end": 5163.86,
      "start": 5161.68,
      "text": "这么优秀的运动员退一向"
    },
    {
      "end": 5165.08,
      "start": 5163.86,
      "text": "心理又不平和"
    },
    {
      "end": 5167.48,
      "start": 5165.08,
      "text": "但是你想要好的位置"
    },
    {
      "end": 5168.26,
      "start": 5167.48,
      "text": "好的那个"
    },
    {
      "end": 5169.76,
      "start": 5168.26,
      "text": "但谁给你啊"
    },
    {
      "end": 5171.48,
      "start": 5169.76,
      "text": "你不去拍马屁你能吗"
    },
    {
      "end": 5171.98,
      "start": 5171.48,
      "text": "对吧"
    },
    {
      "end": 5173.42,
      "start": 5171.98,
      "text": "所以他就是这种"
    },
    {
      "end": 5174.76,
      "start": 5173.42,
      "text": "七哥跟你讲一个"
    },
    {
      "end": 5175.48,
      "start": 5174.76,
      "text": "也是啊"
    },
    {
      "end": 5177.66,
      "start": 5175.48,
      "text": "我亲自啊"
    },
    {
      "end": 5177.94,
      "start": 5177.66,
      "text": "这个"
    },
    {
      "end": 5179.48,
      "start": 5177.94,
      "text": "我讲的七哥"
    },
    {
      "end": 5180.1,
      "start": 5179.48,
      "text": "他们应该都"
    },
    {
      "end": 5181.2,
      "start": 5180.1,
      "text": "共产党应该都明白"
    },
    {
      "end": 5182.72,
      "start": 5181.2,
      "text": "好也都没讲的一个事"
    },
    {
      "end": 5184.18,
      "start": 5182.72,
      "text": "我亲身经历啊"
    },
    {
      "end": 5184.92,
      "start": 5184.18,
      "text": "我不经历的"
    },
    {
      "end": 5185.64,
      "start": 5184.92,
      "text": "我不那个的"
    },
    {
      "end": 5187.1,
      "start": 5185.64,
      "text": "我胡说八道啊"
    },
    {
      "end": 5187.88,
      "start": 5187.1,
      "text": "我没说肯定"
    },
    {
      "end": 5189.18,
      "start": 5187.88,
      "text": "但是我经历的事"
    },
    {
      "end": 5191.72,
      "start": 5189.18,
      "text": "我讲说运动员退下来啊"
    },
    {
      "end": 5193.26,
      "start": 5191.72,
      "text": "他们就要干什么"
    },
    {
      "end": 5195.34,
      "start": 5193.26,
      "text": "有个打平凡球的王涛啊"
    },
    {
      "end": 5196.66,
      "start": 5195.34,
      "text": "也是我们八一队的啊"
    },
    {
      "end": 5197.12,
      "start": 5196.66,
      "text": "就是"
    },
    {
      "end": 5199.62,
      "start": 5197.12,
      "text": "邦时他们都是要"
    },
    {
      "end": 5201.5,
      "start": 5199.62,
      "text": "竞争副大队长"
    },
    {
      "end": 5203.18,
      "start": 5201.5,
      "text": "还不是大队长啊"
    },
    {
      "end": 5203.64,
      "start": 5203.18,
      "text": "八一队的"
    },
    {
      "end": 5206.3,
      "start": 5203.64,
      "text": "但是他们都要去送礼的"
    },
    {
      "end": 5207.1,
      "start": 5206.3,
      "text": "当然了"
    },
    {
      "end": 5208.22,
      "start": 5207.1,
      "text": "他没有找到我"
    },
    {
      "end": 5209.36,
      "start": 5208.22,
      "text": "这里面有一个"
    },
    {
      "end": 5211.44,
      "start": 5209.36,
      "text": "政治部的干部"
    },
    {
      "end": 5212.12,
      "start": 5211.44,
      "text": "叫王永华"
    },
    {
      "end": 5213.64,
      "start": 5212.12,
      "text": "他找到我"
    },
    {
      "end": 5214.04,
      "start": 5213.64,
      "text": "他说"
    },
    {
      "end": 5214.78,
      "start": 5214.04,
      "text": "我靠你"
    },
    {
      "end": 5216.82,
      "start": 5214.78,
      "text": "我知道你认识这个"
    },
    {
      "end": 5217.66,
      "start": 5216.82,
      "text": "总政的人啊"
    },
    {
      "end": 5218.0,
      "start": 5217.66,
      "text": "什么的"
    },
    {
      "end": 5219.74,
      "start": 5218.0,
      "text": "他说你帮我来"
    },
    {
      "end": 5220.5,
      "start": 5219.74,
      "text": "花钱也好"
    },
    {
      "end": 5221.24,
      "start": 5220.5,
      "text": "干什么也好"
    },
    {
      "end": 5222.36,
      "start": 5221.24,
      "text": "说说说我们"
    },
    {
      "end": 5223.98,
      "start": 5222.36,
      "text": "争私大队长"
    },
    {
      "end": 5224.7,
      "start": 5223.98,
      "text": "两个人"
    },
    {
      "end": 5225.9,
      "start": 5224.7,
      "text": "一个王涛一个我"
    },
    {
      "end": 5226.5,
      "start": 5225.9,
      "text": "我"
    },
    {
      "end": 5227.92,
      "start": 5226.5,
      "text": "我得找总政的人啊"
    },
    {
      "end": 5229.0,
      "start": 5227.92,
      "text": "我得去送礼啊"
    },
    {
      "end": 5230.02,
      "start": 5229.0,
      "text": "我得那个什么的"
    },
    {
      "end": 5230.52,
      "start": 5230.02,
      "text": "我说"
    },
    {
      "end": 5232.86,
      "start": 5230.52,
      "text": "我说我不管这事"
    },
    {
      "end": 5233.2,
      "start": 5232.86,
      "text": "我说"
    },
    {
      "end": 5233.98,
      "start": 5233.2,
      "text": "但是呢"
    },
    {
      "end": 5235.1,
      "start": 5233.98,
      "text": "你要是想认识"
    },
    {
      "end": 5235.58,
      "start": 5235.1,
      "text": "你要那个"
    },
    {
      "end": 5237.14,
      "start": 5235.58,
      "text": "我可以给你们组个饭局"
    },
    {
      "end": 5238.46,
      "start": 5237.14,
      "text": "你们当时啊"
    },
    {
      "end": 5240.16,
      "start": 5238.46,
      "text": "我找了总政治部"
    },
    {
      "end": 5241.06,
      "start": 5240.16,
      "text": "因为徐太后"
    },
    {
      "end": 5242.18,
      "start": 5241.06,
      "text": "已经是这个"
    },
    {
      "end": 5243.12,
      "start": 5242.18,
      "text": "这个军委屈皮了"
    },
    {
      "end": 5244.8,
      "start": 5243.12,
      "text": "已经不在总政治部当主任"
    },
    {
      "end": 5245.36,
      "start": 5244.8,
      "text": "完了"
    },
    {
      "end": 5245.86,
      "start": 5245.36,
      "text": "但是呢"
    },
    {
      "end": 5246.94,
      "start": 5245.86,
      "text": "他留下了一个"
    },
    {
      "end": 5248.84,
      "start": 5246.94,
      "text": "他当时也都是东北的老师"
    },
    {
      "end": 5249.9,
      "start": 5248.84,
      "text": "应该啊"
    },
    {
      "end": 5251.9,
      "start": 5249.9,
      "text": "都是大连那边的"
    },
    {
      "end": 5253.04,
      "start": 5251.9,
      "text": "叫同士平"
    },
    {
      "end": 5255.1,
      "start": 5253.04,
      "text": "总政治部副主任"
    },
    {
      "end": 5255.86,
      "start": 5255.1,
      "text": "你们可以去查"
    },
    {
      "end": 5256.42,
      "start": 5255.86,
      "text": "对吧"
    },
    {
      "end": 5257.24,
      "start": 5256.42,
      "text": "当时那个"
    },
    {
      "end": 5258.04,
      "start": 5257.24,
      "text": "完了一块"
    },
    {
      "end": 5258.98,
      "start": 5258.04,
      "text": "我就叫他们"
    },
    {
      "end": 5259.58,
      "start": 5258.98,
      "text": "完了"
    },
    {
      "end": 5260.5,
      "start": 5259.58,
      "text": "王永华什么的"
    },
    {
      "end": 5261.18,
      "start": 5260.5,
      "text": "吃个饭"
    },
    {
      "end": 5261.68,
      "start": 5261.18,
      "text": "类似的"
    },
    {
      "end": 5262.42,
      "start": 5261.68,
      "text": "我说别的事"
    },
    {
      "end": 5262.86,
      "start": 5262.42,
      "text": "我不管"
    },
    {
      "end": 5264.46,
      "start": 5262.86,
      "text": "你去拿钱送礼"
    },
    {
      "end": 5265.24,
      "start": 5264.46,
      "text": "你去干什么"
    },
    {
      "end": 5266.24,
      "start": 5265.24,
      "text": "你去弄想"
    },
    {
      "end": 5267.64,
      "start": 5266.24,
      "text": "你去弄想"
    },
    {
      "end": 5271.24,
      "start": 5267.64,
      "text": "把我的指示告诉你们"
    },
    {
      "end": 5272.32,
      "start": 5271.24,
