    {
      "end": 13385.38,
      "start": 13380.74,
      "text": "被划分为地主的人和其亲属进行惨无人道的折磨"
    },
    {
      "end": 13388.14,
      "start": 13385.38,
      "text": "导致大量的人死亡"
    },
    {
      "end": 13391.8,
      "start": 13388.14,
      "text": "其中对女性更充满性暴力"
    },
    {
      "end": 13396.98,
      "start": 13391.8,
      "text": "强奸、轮奸、性虐待的事情实有所闻"
    },
    {
      "end": 13401.22,
      "start": 13396.98,
      "text": "大量的无赖流氓成为土改的极先锋"
    },
    {
      "end": 13405.22,
      "start": 13401.22,
      "text": "使得中共土改始终充满恐怖血腥"
    },
    {
      "end": 13406.6,
      "start": 13405.22,
      "text": "并遍及全国"
    },
    {
      "end": 13408.78,
      "start": 13406.6,
      "text": "抗日爱国士绅牛友兰"
    },
    {
      "end": 13411.64,
      "start": 13408.78,
      "text": "在1947年的禁卵土改时"
    },
    {
      "end": 13415.0,
      "start": 13411.64,
      "text": "有流氓将她的鼻子用铁丝穿过"
    },
    {
      "end": 13416.16,
      "start": 13415.0,
      "text": "系上绳子"
    },
    {
      "end": 13419.5,
      "start": 13416.16,
      "text": "用强迫她儿子牛鹰罐牵着游街"
    },
    {
      "end": 13421.94,
      "start": 13419.5,
      "text": "牛友兰不堪忍受"
    },
    {
      "end": 13423.4,
      "start": 13421.94,
      "text": "绝食而死"
    },
    {
      "end": 13430.28,
      "start": 13423.4,
      "text": "土改剥夺了农村乡绅阶层的土地和一切财产"
    },
    {
      "end": 13433.38,
      "start": 13430.28,
      "text": "剥夺了200至400万人的生命"
    },
    {
      "end": 13436.94,
      "start": 13433.38,
      "text": "从而彻底消灭了农村的精英阶层"
    },
    {
      "end": 13440.96,
      "start": 13436.94,
      "text": "改变了中国农村的社会结构和传统文化"
    },
    {
      "end": 13445.66,
      "start": 13440.96,
      "text": "土改把上千万人划分为地主和富农"
    },
    {
      "end": 13447.68,
      "start": 13445.66,
      "text": "成为政治上的贱民"
    },
    {
      "end": 13450.56,
      "start": 13447.68,
      "text": "在以后发生的政治运动中"
    },
    {
      "end": 13453.24,
      "start": 13450.56,
      "text": "生命安全得不到任何保障"
    },
    {
      "end": 13456.32,
      "start": 13453.24,
      "text": "例如之后的文革运动中"
    },
    {
      "end": 13461.04,
      "start": 13456.32,
      "text": "1967年8月至10月的湖南道县大屠杀"
    },
    {
      "end": 13464.22,
      "start": 13461.04,
      "text": "非正常死亡9093人"
    },
    {
      "end": 13467.44,
      "start": 13464.22,
      "text": "其中7696人被杀"
    },
    {
      "end": 13470.66,
      "start": 13467.44,
      "text": "1397人被逼自杀"
    },
    {
      "end": 13475.04,
      "start": 13470.66,
      "text": "其中四类分子3576人"
    },
    {
      "end": 13478.32,
      "start": 13475.04,
      "text": "四类分子子女4057人"
    },
    {
      "end": 13480.6,
      "start": 13478.32,
      "text": "占被杀总人数的84%"
    },
    {
      "end": 13484.34,
      "start": 13480.6,
      "text": "其中未成年人826人"
    },
    {
      "end": 13486.28,
      "start": 13484.34,
      "text": "最小的才10天"
    },
    {
      "end": 13490.86,
      "start": 13486.28,
      "text": "自从土改将谋财害命"
    },
    {
      "end": 13492.02,
      "start": 13490.86,
      "text": "杀人越货"
    },
    {
      "end": 13495.4,
      "start": 13492.02,
      "text": "颠倒为备受赞扬的正义事业之后"
    },
    {
      "end": 13497.36,
      "start": 13495.4,
      "text": "人心涣散了"
    },
    {
      "end": 13499.64,
      "start": 13497.36,
      "text": "传统道德观念崩溃了"
    },
    {
      "end": 13501.64,
