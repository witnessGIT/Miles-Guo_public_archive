  "segments": [
    {
      "end": 12603.08,
      "start": 12600.0,
      "text": "任何人現在活著都生不死"
    },
    {
      "end": 12607.68,
      "start": 12603.84,
      "text": "因為錦濤就給為了表忠心就給習說了"
    },
    {
      "end": 12609.22,
      "start": 12607.94,
      "text": "所有這些目標款"
    },
    {
      "end": 12613.06,
      "start": 12609.48,
      "text": "一切以你安全和政治的前處為止"
    },
    {
      "end": 12615.1,
      "start": 12613.56,
      "text": "已經黨的問題了"
    },
    {
      "end": 12617.66,
      "start": 12615.36,
      "text": "習知道對你好,你想殺誰"
    },
    {
      "end": 12620.48,
      "start": 12617.92,
      "text": "我就一個要求,海鋒你做起床"
    },
    {
      "end": 12625.08,
      "start": 12621.5,
      "text": "昨天胡錦濤這個偽君子"
    },
    {
      "end": 12627.4,
      "start": 12625.34,
      "text": "我哥們絕對偽君子"
    },
    {
      "end": 12629.7,
      "start": 12627.9,
      "text": "你看他犧牲的一個方派"
    },
    {
      "end": 12632.0,
      "start": 12629.7,
      "text": "換成是站在那邊的僵尸一樣的"
    },
    {
      "end": 12634.06,
      "start": 12632.26,
      "text": "手都都都都都發抖是不是"
    },
    {
      "end": 12636.86,
      "start": 12634.3,
      "text": "你說但是江派你恰恰去吧"
    },
    {
      "end": 12638.66,
      "start": 12637.12,
      "text": "他就老子很不利"
    },
    {
      "end": 12642.5,
      "start": 12639.18,
      "text": "他就曾孟建柱,你不要看這個孟建柱曾"
    },
    {
      "end": 12643.78,
      "start": 12642.76,
      "text": "還有朱鎔基"
    },
    {
      "end": 12646.86,
      "start": 12644.3,
      "text": "還有上海市的市委書記市長"
    },
    {
      "end": 12649.16,
      "start": 12647.1,
      "text": "這些人所有的百位你能看出來"
    },
    {
      "end": 12651.2,
      "start": 12649.42,
      "text": "習刻意的弱化江派"
    },
    {
      "end": 12654.54,
      "start": 12651.98,
      "text": "江派就恰恰若胡配合演戲"
    },
    {
      "end": 12656.32,
      "start": 12655.04,
      "text": "這說明了什麼問題"
    },
    {
      "end": 12658.38,
      "start": 12656.58,
      "text": "習江支派的鬥爭"
    },
    {
      "end": 12659.76,
      "start": 12658.38,
      "text": "他以後說他會牽勻"
    },
    {
      "end": 12660.68,
      "start": 12659.92,
      "text": "他閃得他"
    },
    {
      "end": 12661.7,
      "start": 12660.94,
      "text": "他卻很 leads"
    },
    {
      "end": 12662.74,
      "start": 12661.96,
      "text": "他歸到他"
    },
    {
      "end": 12663.38,
      "start": 12662.98,
      "text": "他很順頭"
    },
    {
      "end": 12664.02,
      "start": 12663.5,
      "text": "他要 Master"
    },
    {
      "end": 12664.66,
      "start": 12664.26,
      "text": "他要剪人"
    },
    {
      "end": 12665.06,
      "start": 12664.78,
      "text": "他要剪人"
    },
    {
      "end": 12665.54,
      "start": 12665.18,
      "text": "他要剪人"
    },
    {
      "end": 12666.32,
      "start": 12665.8,
      "text": "他要剪人"
    },
    {
      "end": 12666.88,
      "start": 12666.58,
      "text": "他要剪人"
    },
    {
      "end": 12667.34,
      "start": 12667.08,
      "text": "他要剪人"
    },
    {
      "end": 12667.94,
