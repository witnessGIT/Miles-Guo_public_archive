    {
      "end": 13114.74,
      "start": 13112.74,
      "text": "是說我們的 這句話最後給拿掉了"
    },
    {
      "end": 13116.04,
      "start": 13114.74,
      "text": "是需要拿掉的"
    },
    {
      "end": 13118.12,
      "start": 13116.04,
      "text": "另外一句話說"
    },
    {
      "end": 13120.68,
      "start": 13118.12,
      "text": "不管是在任何情況下"
    },
    {
      "end": 13121.74,
      "start": 13120.68,
      "text": "作為中國人"
    },
    {
      "end": 13124.32,
      "start": 13121.74,
      "text": "你挑戰中國共產黨的權威"
    },
    {
      "end": 13126.36,
