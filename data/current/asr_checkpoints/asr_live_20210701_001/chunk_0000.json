  "segments": [
    {
      "end": 10.64,
      "start": 0.0,
      "text": "CCP的视觉本质"
    },
    {
      "end": 13.34,
      "start": 10.64,
      "text": "2.中共土改的反人类真相"
    },
    {
      "end": 14.98,
      "start": 13.34,
      "text": "雪红的土地"
    },
    {
      "end": 17.62,
      "start": 14.98,
      "text": "中共土改采访中的作者谭松"
    },
    {
      "end": 21.82,
      "start": 17.62,
      "text": "采访了上半位川东地区1952年土改的亲历者"
    },
    {
      "end": 23.48,
      "start": 21.82,
      "text": "通过他们的口述"
    },
    {
      "end": 26.28,
      "start": 23.48,
      "text": "还原这段选心残暴了历史真相"
    },
    {
      "end": 28.18,
      "start": 26.28,
      "text": "当时在土改运动中"
    },
    {
      "end": 32.3,
      "start": 28.18,
      "text": "对女性的凝辱和残暴是人类文明难以想象的"
    },
    {
      "end": 34.38,
      "start": 32.3,
      "text": "有个叫梁文华的女性"
    },
    {
      "end": 37.32,
      "start": 34.38,
      "text": "她因为是当地最美的一个美人而遭殃"
    },
    {
      "end": 38.76,
      "start": 37.32,
      "text": "她本来也不是地主"
    },
    {
      "end": 39.72,
      "start": 38.76,
      "text": "她是个老师"
    },
    {
      "end": 41.48,
      "start": 39.72,
      "text": "她父亲是银行的经理"
    },
    {
      "end": 42.58,
      "start": 41.48,
      "text": "买了点田地"
    },
    {
      "end": 44.1,
      "start": 42.58,
      "text": "所以她父亲被拉来斗"
    },
    {
      "end": 45.28,
      "start": 44.1,
      "text": "因为她长得漂亮"
    },
    {
      "end": 47.64,
      "start": 45.28,
      "text": "所以这些民兵们就把梁文华也抓"
    },
    {
      "end": 51.26,
      "start": 47.64,
      "text": "一晚上十几个民兵活活把她能监制死"
    },
    {
      "end": 53.82,
      "start": 51.26,
      "text": "还有一个叫彭吉珍的女子"
    },
    {
      "end": 55.46,
      "start": 53.82,
      "text": "为了向她必要经营"
    },
    {
      "end": 57.9,
      "start": 55.46,
      "text": "居然把她活活地放在炭火上烤"
    },
    {
      "end": 60.66,
      "start": 57.9,
      "text": "烤得她的乳房和肚皮往下滴油"
    },
    {
      "end": 62.32,
      "start": 60.66,
      "text": "李斗银之死"
    },
    {
      "end": 65.02,
      "start": 62.32,
      "text": "李斗银毕业于北京大学"
    },
    {
      "end": 67.44,
      "start": 65.02,
      "text": "曾经担任农门中学小学校长"
    },
    {
      "end": 69.02,
      "start": 67.44,
      "text": "给她用的型叫材质"
    },
    {
      "end": 71.98,
      "start": 69.02,
      "text": "土改民兵用一种叫做脚拿子的钢夹子"
    },
    {
      "end": 73.0,
      "start": 71.98,
      "text": "来夹她手指"
    },
    {
      "end": 74.24,
      "start": 73.0,
      "text": "脚拿子用脚踩"
    },
    {
      "end": 77.42,
      "start": 74.24,
      "text": "钢夹子却是用来扭体扭钢的那个夹子"
    },
    {
      "end": 80.06,
      "start": 77.42,
      "text": "他们把李斗银的手指夹在钢夹子里"
    },
    {
      "end": 81.12,
      "start": 80.06,
      "text": "只有几分钟"
    },
    {
      "end": 82.28,
      "start": 81.12,
      "text": "手指先夹扁"
    },
    {
      "end": 83.62,
      "start": 82.28,
      "text": "骨头都夹断了"
    },
    {
      "end": 85.3,
      "start": 83.62,
      "text": "最后只剩一张皮了"
    },
    {
      "end": 86.68,
      "start": 85.3,
      "text": "人皮不容易夹断"
    },
    {
      "end": 89.06,
      "start": 86.68,
      "text": "他们把第一节夹了又夹第二节"
    },
    {
      "end": 91.02,
      "start": 89.06,
      "text": "手指夹了两节才夹完"
    },
    {
      "end": 92.86,
      "start": 91.02,
      "text": "把这只手整残了后"
    },
    {
      "end": 94.06,
      "start": 92.86,
      "text": "再整另一只手"
    },
    {
      "end": 94.84,
      "start": 94.06,
      "text": "不光是手"
    },
    {
      "end": 96.28,
      "start": 94.84,
      "text": "把两只手裁断了后"
    },
    {
      "end": 97.18,
      "start": 96.28,
      "text": "再裁两只脚"
    },
    {
      "end": 98.46,
      "start": 97.18,
      "text": "加那个肉和骨头"
    },
    {
      "end": 99.22,
      "start": 98.46,
      "text": "慢慢搅"
    },
    {
      "end": 100.28,
      "start": 99.22,
      "text": "一直把它搅断"
    },
    {
      "end": 101.4,
      "start": 100.28,
      "text": "要好久的时间"
    },
    {
      "end": 102.36,
      "start": 101.4,
      "text": "要痛好久"
    },
    {
      "end": 103.54,
      "start": 102.36,
      "text": "一节一节的裁"
    },
    {
      "end": 104.2,
      "start": 103.54,
      "text": "裁断"
    },
    {
      "end": 106.12,
      "start": 104.2,
      "text": "所以这种形罚叫裁脂"
    },
    {
      "end": 107.72,
      "start": 106.12,
      "text": "李斗银当时没有死"
    },
    {
      "end": 108.64,
      "start": 107.72,
      "text": "她的消化器官"
    },
    {
      "end": 110.26,
      "start": 108.64,
      "text": "呼吸器官还是完好的"
    },
    {
      "end": 111.54,
      "start": 110.26,
      "text": "不容易一下子死"
    },
    {
      "end": 113.5,
      "start": 111.54,
      "text": "他们事后把她丢在一个猪圈里"
    },
    {
      "end": 115.4,
      "start": 113.5,
      "text": "老乡送稀饭又活了几天"
    },
    {
      "end": 116.94,
      "start": 115.4,
      "text": "母子两只死"
    },
    {
      "end": 118.22,
      "start": 116.94,
      "text": "有个小娃娃"
    },
    {
      "end": 119.78,
      "start": 118.22,
      "text": "把她妈抓来吊齐后"
    },
    {
      "end": 122.08,
      "start": 119.78,
      "text": "他们把她踩满月的小娃娃抱来"
    },
    {
      "end": 123.08,
      "start": 122.08,
      "text": "用毛竿子"
    },
    {
      "end": 124.48,
      "start": 123.08,
      "text": "从她肛门戳进去"
    },
    {
      "end": 126.6,
      "start": 124.48,
      "text": "他们把戳在毛竿子上的奶娃"
    },
    {
      "end": 127.82,
      "start": 126.6,
      "text": "举到她妈胸前"
    },
    {
      "end": 128.28,
      "start": 127.82,
      "text": "说"
    },
    {
      "end": 129.02,
      "start": 128.28,
      "text": "你看哟"
    },
    {
      "end": 130.62,
      "start": 129.02,
      "text": "你儿子他亲热你了"
    },
    {
      "end": 131.7,
      "start": 130.62,
      "text": "他想喝口奶"
    },
    {
      "end": 132.98,
      "start": 131.7,
      "text": "她妈也死了"
    },
    {
      "end": 134.2,
      "start": 132.98,
      "text": "两个都死了"
    },
    {
      "end": 134.84,
      "start": 134.2,
      "text": "妈姓彭"
    },
    {
      "end": 136.44,
      "start": 134.84,
      "text": "这样的例子"
    },
    {
      "end": 137.44,
      "start": 136.44,
      "text": "成百上千个"
    },
    {
      "end": 139.96,
      "start": 137.44,
      "text": "被中共宣传为英雄人物的方志明"
    },
    {
      "end": 142.12,
      "start": 139.96,
      "text": "在江青岛家领导土改运动"
    },
    {
      "end": 144.06,
      "start": 142.12,
      "text": "带头抓捕并处死了地主"
    },
    {
      "end": 145.38,
      "start": 144.06,
      "text": "亲叔叔方宜田"
    },
    {
      "end": 146.9,
      "start": 145.38,
      "text": "他在亲评中透露"
    },
    {
      "end": 148.88,
      "start": 146.9,
      "text": "从事革命工作十余年"
    },
    {
      "end": 151.2,
      "start": 148.88,
      "text": "经手的款项总数十百万"
    },
    {
      "end": 153.82,
      "start": 151.2,
      "text": "当辖内仅有的香生被榨干后"
    },
    {
      "end": 155.64,
      "start": 153.82,
      "text": "走透无路的红军领袖"
    },
    {
      "end": 156.54,
      "start": 155.64,
      "text": "想拿了绑票"
    },
    {
      "end": 159.62,
      "start": 156.54,
      "text": "方志明绑架了美国传教士达能及妻女"
    },
    {
      "end": 161.42,
      "start": 159.62,
      "text": "索要巨额奸金遭巨后"
    },
    {
      "end": 162.84,
      "start": 161.42,
      "text": "将夫妇娘砍头"
    },
    {
      "end": 164.96,
      "start": 162.84,
      "text": "中共的土改的手法"
    },
    {
      "end": 166.7,
      "start": 164.96,
      "text": "从现在的反人类暴政"
    },
    {
      "end": 168.7,
      "start": 166.7,
      "text": "基本上是一脉相承的"
    },
    {
      "end": 170.96,
      "start": 168.7,
      "text": "土改的时候运用了三种手法"
    },
    {
      "end": 172.0,
      "start": 170.96,
      "text": "谎言欺骗"
    },
    {
      "end": 173.0,
      "start": 172.0,
      "text": "暴力镇压"
    },
    {
      "end": 174.0,
      "start": 173.0,
      "text": "利益收买"
    },
    {
      "end": 175.04,
      "start": 174.0,
      "text": "这三种手法"
    },
    {
      "end": 176.66,
      "start": 175.04,
      "text": "在后来几十年的统治"
    },
    {
      "end": 177.64,
      "start": 176.66,
      "text": "如文革"
    },
    {
      "end": 178.88,
      "start": 177.64,
      "text": "法轮功镇压"
    },
    {
      "end": 179.62,
      "start": 178.88,
      "text": "新疆"
    },
    {
      "end": 180.38,
      "start": 179.62,
      "text": "西藏"
    },
    {
      "end": 181.48,
      "start": 180.38,
      "text": "香港问题等"
    },
    {
      "end": 182.38,
      "start": 181.48,
      "text": "没有改变"
    },
    {
      "end": 193.38,
      "start": 191.42,
      "text": "陆生"
    },
    {
      "end": 194.18,
      "start": 193.38,
      "text": "陆生"
    },
    {
      "end": 194.82,
      "start": 194.18,
      "text": "阳"
    },
    {
      "end": 195.54,
      "start": 194.82,
      "text": "达"
    },
    {
      "end": 196.12,
      "start": 195.54,
      "text": "达"
    },
    {
      "end": 196.5,
      "start": 196.12,
      "text": "达"
    },
    {
      "end": 196.9,
      "start": 196.5,
      "text": "达"
    },
    {
      "end": 197.28,
      "start": 196.9,
      "text": "达"
    },
    {
      "end": 199.54,
      "start": 197.28,
      "text": "GU"
    },
    {
      "end": 229.52,
      "start": 199.54,
      "text": "优优独播剧场——YoYo Television Series Exclusive"
    },
    {
      "end": 235.54,
      "start": 229.54,
      "text": "它实际上土地改革呢是中共共产主义革命的一个组成部分"
    },
    {
      "end": 243.26,
      "start": 235.54,
      "text": "那么这个部分呢重点是要裹挟最大多数的中国人口加入到中共的这个革命当中去"
    },
    {
      "end": 248.58,
      "start": 243.26,
      "text": "那么中共的革命呢是以马克思列宁主义这个共产主义的暴力革命"
    },
    {
      "end": 252.12,
      "start": 248.58,
      "text": "以阶级斗争为刚这是他们的真正目的"
    },
    {
      "end": 257.4,
      "start": 252.12,
      "text": "但是一般中国人呢他们不愿意无缘无故的加入到这个阶级斗争当中去"
    },
    {
      "end": 263.78,
      "start": 257.4,
      "text": "那么中共要把想把这么大的人口裹挟到他的革命当中去成为他的炮灰的话"
    },
    {
      "end": 267.34,
      "start": 263.78,
      "text": "那么他就必须要让每个人都沾血"
    },
    {
      "end": 269.16,
      "start": 267.34,
      "text": "这是中共革命的特点"
    },
    {
      "end": 272.64,
      "start": 269.16,
      "text": "让农民呢一旦这个在土地革命当中"
    },
    {
      "end": 275.32,
      "start": 272.64,
      "text": "在土地这个所谓土改当中"
    },
    {
      "end": 277.64,
      "start": 275.32,
      "text": "如果说手上都沾了血以后呢"
    },
    {
      "end": 279.8,
      "start": 277.64,
      "text": "它就变成了中共革命的一个部分了"
    },
    {
      "end": 281.58,
      "start": 279.8,
      "text": "它就没有办法跟中国分开来了"
    },
    {
      "end": 284.96,
      "start": 281.58,
      "text": "这就是为什么土改要大规模的杀地主"
    },
    {
      "end": 286.74,
      "start": 284.96,
      "text": "要让农民去参加斗争会"
    },
    {
      "end": 288.9,
      "start": 286.74,
      "text": "也就是说让他们没有退路"
    },
    {
      "end": 295.44,
      "start": 288.9,
      "text": "通过暴力这种革命就把那个地整个那个所谓的地主阶级全部打成建民"
    },
    {
      "end": 300.04,
      "start": 295.44,
      "text": "这样的时候跟那个共产党阶级斗争嘛"
    },
    {
      "end": 303.64,
      "start": 300.04,
      "text": "形成了非常大的那种阶级对立的那种仇恨"
    },
    {
      "end": 306.64,
      "start": 303.64,
      "text": "这个他也要需要一个暴力的手段"
    },
    {
      "end": 311.02,
      "start": 306.64,
      "text": "然后呢他另外呢就是说他通过这个暴力的手段呢"
    },
    {
      "end": 315.58,
      "start": 311.02,
      "text": "他可以把共产党的政权完全彻底的建立到最基层去"
    },
    {
      "end": 320.3,
      "start": 315.58,
      "text": "就建立什么党支部啦建立他一个相册称政政权"
    },
    {
      "end": 323.14,
      "start": 320.3,
      "text": "所以他他也选择了这种方式"
    },
    {
      "end": 325.98,
      "start": 323.14,
      "text": "他发动了一个暴力暴力这种土改"
    },
    {
      "end": 329.56,
      "start": 325.98,
      "text": "他叫所谓的积极分子去去做"
    },
    {
      "end": 332.6,
      "start": 329.56,
      "text": "那些积极分子往往是农村的二流子"
    },
    {
      "end": 334.16,
      "start": 332.6,
      "text": "就是无爷的"
    },
    {
      "end": 337.76,
      "start": 334.16,
      "text": "其实真正的那种就是说你是老老实实农民的话"
    },
    {
      "end": 341.18,
      "start": 337.76,
      "text": "他还接受不了这种暴力土改的这种情况"
    },
    {
      "end": 342.62,
      "start": 341.18,
      "text": "就是一些地痞流氓"
    },
    {
      "end": 346.62,
      "start": 342.62,
      "text": "就是说就好意勿闹的就没有很惨"
    },
    {
      "end": 348.84,
      "start": 346.62,
      "text": "然后也不愿意老老实实劳动的"
    },
    {
      "end": 351.66,
      "start": 348.84,
      "text": "就赌博啦流荡啦就是这种人"
    },
    {
      "end": 356.16,
      "start": 351.66,
      "text": "这个中共的这个农民这个运动"
    },
    {
      "end": 360.4,
      "start": 356.16,
      "text": "就是说就依这些人为积极分子"
    },
    {
      "end": 362.22,
      "start": 360.4,
      "text": "用这些人做革命的主力军"
    },
    {
      "end": 365.64,
      "start": 362.22,
      "text": "这个是早在中共二十年代的时候"
    },
    {
      "end": 367.84,
      "start": 365.64,
      "text": "毛泽东搞湖南农民运动考察"
    },
    {
      "end": 370.34,
      "start": 367.84,
      "text": "湖南农民运动的时候已经开始实行了"
    },
    {
      "end": 373.76,
      "start": 370.34,
      "text": "毛泽东在他的湖南农民运动考察报告里边"
    },
    {
      "end": 375.84,
      "start": 373.76,
      "text": "就是说我们要用这些人"
    },
    {
      "end": 379.68,
      "start": 375.84,
      "text": "那么这些人就手段就是无所不用其极的"
    },
    {
      "end": 385.9,
      "start": 379.68,
      "text": "1953年春季"
    },
    {
      "end": 388.42,
      "start": 385.9,
      "text": "广东省西部地区的土改中"
    },
    {
      "end": 391.1,
      "start": 388.42,
      "text": "有1156人自杀"
    },
