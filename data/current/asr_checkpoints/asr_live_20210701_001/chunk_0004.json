    },
    {
      "end": 3920.52,
      "start": 3919.12,
      "text": "完成第一段的直播"
    },
    {
      "end": 3922.42,
      "start": 3920.92,
      "text": "也就是說昨天呢"
    },
    {
      "end": 3923.42,
      "start": 3922.42,
      "text": "我們都看了"
    },
    {
      "end": 3924.52,
      "start": 3923.42,
      "text": "我不知道你看了沒有"
    },
    {
      "end": 3926.02,
      "start": 3924.72,
      "text": "我把中英文版的"
    },
    {
      "end": 3927.92,
      "start": 3926.02,
      "text": "我這認真學習了N遍了啊"
    },
    {
      "end": 3929.12,
      "start": 3928.12,
      "text": "我都快背下來了"
    },
    {
      "end": 3932.52,
      "start": 3929.62,
      "text": "這個共產黨的百年明蛋的講話"
    },
    {
      "end": 3936.22,
      "start": 3932.92,
      "text": "還有那個天上的陰雲密布的北京的天氣"
    },
    {
      "end": 3938.72,
      "start": 3936.72,
      "text": "以及一下子讓我想到了"
    },
    {
      "end": 3941.02,
      "start": 3939.32,
      "text": "我去北朝鮮時"
    },
    {
      "end": 3943.52,
      "start": 3941.32,
      "text": "北朝鮮帶給我的那種感覺"
    },
    {
      "end": 3945.32,
      "start": 3943.52,
      "text": "完全出現了北京天安門"
    },
    {
      "end": 3947.72,
      "start": 3945.72,
      "text": "服裝揮舞的旗幟"
    },
    {
      "end": 3948.62,
      "start": 3947.72,
      "text": "身體語言"
    },
    {
      "end": 3949.82,
      "start": 3948.82,
      "text": "包括表情"
    },
    {
      "end": 3952.02,
      "start": 3950.02,
      "text": "包括下面聽到習近平喊"
    },
    {
      "end": 3954.62,
      "start": 3952.82,
      "text": "這個就像教師一般的"
    },
    {
      "end": 3955.92,
      "start": 3954.72,
      "text": "給我們來教會我們"
    },
    {
      "end": 3957.22,
      "start": 3956.22,
      "text": "那是不行的"
    },
    {
      "end": 3958.12,
      "start": 3957.22,
      "text": "也就是說"
    },
    {
      "end": 3959.32,
      "start": 3958.42,
      "text": "完全不聽了"
    },
    {
      "end": 3960.92,
      "start": 3959.52,
      "text": "要威脅這世界了"
    },
    {
      "end": 3962.42,
      "start": 3961.32,
      "text": "太多感受了"
    },
    {
      "end": 3964.22,
      "start": 3962.72,
      "text": "今天第一個想問一個"
    },
    {
      "end": 3965.32,
      "start": 3964.22,
      "text": "請教一個問題"
    },
    {
      "end": 3966.82,
      "start": 3965.72,
      "text": "海東兄弟"
    },
    {
      "end": 3967.42,
      "start": 3966.82,
      "text": "尹妹妹"
    },
    {
      "end": 3969.12,
      "start": 3967.42,
      "text": "作為你兩個運動員"
    },
    {
      "end": 3970.12,
      "start": 3969.12,
      "text": "世界級的"
    },
    {
      "end": 3972.52,
      "start": 3970.52,
      "text": "知名的中國人來看"
    },
    {
      "end": 3975.92,
      "start": 3972.92,
      "text": "昨天天安門回到了北朝鮮的時代"
    },
    {
      "end": 3977.72,
      "start": 3976.22,
      "text": "和這麽快的速度"
    },
    {
      "end": 3980.92,
      "start": 3978.02,
      "text": "把中國人帶入了一個行屍走肉"
    },
    {
      "end": 3983.02,
      "start": 3981.52,
      "text": "吃了人屍完的"
    },
    {
      "end": 3986.12,
      "start": 3983.52,
      "text": "所謂的絕對核心的獨裁時代"
    },
    {
      "end": 3988.52,
      "start": 3986.52,
      "text": "你倆看到這一幕的時候"
    },
    {
      "end": 3990.02,
      "start": 3988.52,
      "text": "!為我們是中國人"
    },
    {
      "end": 3991.52,
      "start": 3990.22,
      "text": "為我們是同胞"
    },
    {
      "end": 3993.82,
      "start": 3991.62,
      "text": "為我們是新中國聯邦人"
    },
    {
      "end": 3996.32,
      "start": 3994.52,
      "text": "看到這些你有什麽感受"
    },
    {
      "end": 3998.92,
      "start": 3996.32,
      "text": "先請尹妹妹回答"
    },
    {
      "end": 3999.92,
      "start": 3998.92,
      "text": "然後東弟回答"
    },
    {
      "end": 4000.82,
      "start": 3999.92,
      "text": "你別想話"
    },
    {
      "end": 4002.82,
      "start": 4001.12,
      "text": "再一個回答問題要直接"
    },
    {
      "end": 4004.62,
      "start": 4002.82,
      "text": "我們接下來就長島哥"
    },
    {
      "end": 4006.32,
      "start": 4004.82,
      "text": "小飛要問你倆"
    },
    {
      "end": 4007.62,
      "start": 4006.52,
      "text": "你倆要直接"
    },
    {
      "end": 4008.52,
      "start": 4007.92,
      "text": "快"
    },
    {
      "end": 4009.22,
      "start": 4008.72,
      "text": "準"
    },
    {
      "end": 4011.32,
      "start": 4009.82,
      "text": "謝了尹妹妹東弟"
    },
    {
      "end": 4014.62,
      "start": 4013.52,
      "text": "謝謝齊哥"
    },
    {
      "end": 4016.22,
      "start": 4014.92,
      "text": "這個我的感受"
    },
    {
      "end": 4017.62,
      "start": 4016.22,
      "text": "因為我一直"
    },
    {
      "end": 4019.92,
      "start": 4018.42,
      "text": "這種感受"
    },
    {
      "end": 4020.82,
      "start": 4019.92,
      "text": "共產黨"
    },
    {
      "end": 4023.02,
      "start": 4021.02,
      "text": "就之前一直都給我們開會"
    },
    {
      "end": 4024.32,
      "start": 4023.02,
      "text": "一開會就是"
    },
    {
      "end": 4026.92,
      "start": 4024.32,
      "text": "他的老套的話"
    },
    {
      "end": 4028.62,
      "start": 4026.92,
      "text": "給運動員洗腦"
    },
    {
      "end": 4030.42,
      "start": 4028.62,
      "text": "就是永遠正確的廢話"
    },
    {
      "end": 4031.22,
      "start": 4030.42,
      "text": "一大堆"
    },
    {
      "end": 4033.22,
      "start": 4032.02,
      "text": "然後一直到"
    },
    {
      "end": 4036.12,
      "start": 4033.52,
      "text": "包括看到什麽中央電視臺"
    },
    {
      "end": 4038.82,
      "start": 4036.12,
      "text": "那些我們也有去錄製節目什麽的"
    },
    {
      "end": 4043.22,
      "start": 4038.82,
      "text": "然後底下觀眾做的那都是他們叫來的大爺大媽什麽"
    },
    {
      "end": 4045.42,
      "start": 4043.32,
      "text": "然後導演說鼓掌"
    },
    {
      "end": 4046.82,
      "start": 4045.42,
      "text": "然後底下都鼓掌了"
    },
    {
      "end": 4050.42,
      "start": 4048.12,
      "text": "他們永遠都是那一套東西"
    },
    {
      "end": 4054.22,
      "start": 4051.22,
      "text": "到現在這個永遠都沒變"
    },
    {
      "end": 4058.82,
      "start": 4054.22,
      "text": "只是變得就是現在是更高級更現代化更升級版"
    },
    {
      "end": 4062.62,
      "start": 4058.82,
      "text": "然後那個演員的可能數量越來越多"
    },
    {
      "end": 4065.22,
      "start": 4062.62,
      "text": "給我的感覺就是這樣"
    },
    {
      "end": 4065.72,
      "start": 4065.22,
      "text": "所以"
    },
    {
      "end": 4069.32,
      "start": 4066.92,
      "text": "基本上我們也都不看這些東西"
    },
    {
      "end": 4071.22,
      "start": 4069.32,
      "text": "因為太沒有意思"
    },
    {
      "end": 4072.82,
      "start": 4071.22,
      "text": "不是發自內心的"
    },
    {
      "end": 4074.42,
      "start": 4072.82,
      "text": "大家都是被"
    },
    {
      "end": 4078.22,
      "start": 4075.52,
      "text": "為了去撈取一些人脈"
    },
    {
      "end": 4080.22,
      "start": 4078.22,
      "text": "去撈取一些政治資本"
    },
    {
      "end": 4081.12,
      "start": 4080.22,
      "text": "然後他們"
    },
    {
      "end": 4084.32,
      "start": 4081.82,
      "text": "才去到那個台前"
    },
    {
      "end": 4086.82,
      "start": 4084.62,
      "text": "所有人坐在那兒"
    },
    {
      "end": 4090.22,
      "start": 4086.82,
      "text": "然後被淋了一身的雨"
    },
    {
      "end": 4094.22,
      "start": 4090.22,
      "text": "然後面無表情像個僵屍一樣坐在那兒"
    },
    {
      "end": 4095.22,
      "start": 4094.52,
      "text": "沒辦法"
    },
    {
      "end": 4097.52,
      "start": 4095.22,
      "text": "這個就是被裹挾"
    },
    {
      "end": 4099.22,
      "start": 4097.52,
      "text": "被這個"
    },
    {
      "end": 4102.22,
      "start": 4100.42,
      "text": "被這個體制綁架"
    },
    {
      "end": 4103.62,
      "start": 4102.22,
      "text": "所以每個人都是這樣"
    },
    {
      "end": 4105.62,
      "start": 4103.62,
      "text": "他去了以後"
    },
    {
      "end": 4110.02,
      "start": 4105.62,
      "text": "他還可以在後面的這個酒桌上面"
    },
    {
      "end": 4111.42,
      "start": 4110.02,
      "text": "他還有話可以講"
    },
    {
      "end": 4111.92,
      "start": 4111.42,
      "text": "對吧"
    },
    {
      "end": 4113.62,
      "start": 4111.92,
      "text": "跟大家跟別人炫耀"
    },
    {
      "end": 4116.02,
      "start": 4113.62,
      "text": "其實你真正問他心裡他願意去嗎"
    },
    {
      "end": 4118.32,
      "start": 4116.02,
      "text": "我覺得未必都是他願意去的"
    },
    {
      "end": 4122.22,
      "start": 4120.22,
      "text": "好了幾個"
    },
    {
      "end": 4123.92,
      "start": 4122.22,
      "text": "那麼我談一點感受"
    },
    {
      "end": 4124.92,
      "start": 4123.92,
      "text": "就是你剛才說的"
    },
    {
      "end": 4126.32,
      "start": 4124.92,
      "text": "你也是去過北朝鮮的"
    },
    {
      "end": 4127.22,
      "start": 4126.32,
      "text": "我也一樣"
    },
    {
      "end": 4128.82,
      "start": 4127.22,
      "text": "我89年90年"
    },
    {
      "end": 4130.82,
      "start": 4128.82,
      "text": "我們當時國澳都去北朝鮮"
    },
    {
      "end": 4132.32,
      "start": 4131.82,
      "text": "就是"
    },
    {
      "end": 4135.02,
      "start": 4132.52,
      "text": "當我們看到現在的中共"
    },
    {
      "end": 4137.62,
      "start": 4135.02,
      "text": "已經回到了那種年代"
    },
    {
      "end": 4139.62,
      "start": 4138.02,
      "text": "我們也是從那兒過來"
    },
    {
      "end": 4142.02,
      "start": 4139.62,
      "text": "那麼8990我們慢慢走到今天"
    },
    {
      "end": 4143.82,
      "start": 4142.02,
      "text": "但是到了今天又退回去了"
    },
    {
      "end": 4144.82,
      "start": 4144.12,
      "text": "是什麼"
    },
    {
      "end": 4147.22,
      "start": 4144.92,
      "text": "就是他們極度的愚昧"
    },
    {
      "end": 4148.42,
      "start": 4147.62,
      "text": "虛假"
    },
    {
      "end": 4149.42,
      "start": 4148.42,
      "text": "貧窮"
    },
    {
      "end": 4152.42,
      "start": 4149.62,
      "text": "當時他們為了要我們一包方便麵"
    },
    {
      "end": 4154.92,
      "start": 4152.42,
      "text": "那個姓金的小金的陪同"
    },
    {
      "end": 4156.82,
      "start": 4155.12,
      "text": "都會一直跟在後面"
    },
    {
      "end": 4158.02,
      "start": 4156.82,
      "text": "我們吃不了啊"
    },
    {
      "end": 4159.52,
      "start": 4158.02,
      "text": "我們帶點方便麵給他"
    },
    {
      "end": 4161.02,
      "start": 4159.52,
      "text": "哇他們高興壞了"
    },
    {
      "end": 4163.42,
      "start": 4161.22,
      "text": "就是一個國家一個民族"
    },
    {
      "end": 4165.12,
      "start": 4163.62,
      "text": "當他們在"
    },
    {
      "end": 4166.92,
      "start": 4165.92,
      "text": "精神"
    },
    {
      "end": 4167.92,
      "start": 4167.22,
      "text": "方面"
    },
    {
      "end": 4170.62,
      "start": 4168.22,
      "text": "一些虛假的東西來給老百姓"
    },
    {
      "end": 4173.02,
      "start": 4171.02,
      "text": "吃點這種偉鴿"
    },
    {
      "end": 4174.02,
      "start": 4173.32,
      "text": "當"
    },
    {
      "end": 4177.02,
      "start": 4174.52,
      "text": "他們在物質上極度匮乏的時候"
    },
    {
      "end": 4179.42,
      "start": 4177.02,
      "text": "他們表現出他們的虛假"
    },
    {
      "end": 4180.42,
      "start": 4179.82,
      "text": "就是這樣"
    },
    {
      "end": 4183.32,
      "start": 4180.72,
      "text": "再一個他們的信仰有多麽的廉價"
    },
    {
      "end": 4185.62,
      "start": 4183.32,
      "text": "這是我親自親身經歷"
    },
    {
      "end": 4187.72,
      "start": 4185.82,
      "text": "我1988年"
    },
    {
      "end": 4188.72,
      "start": 4187.72,
      "text": "我18歲"
    },
    {
      "end": 4189.92,
      "start": 4189.12,
      "text": "一個年輕人"
    },
    {
      "end": 4191.92,
      "start": 4191.02,
      "text": "他們就告訴我"
    },
    {
      "end": 4198.52,
      "start": 4193.12,
      "text": "郝瑞東你今年是這個優秀的青年團"
    },
    {
      "end": 4199.72,
      "start": 4198.72,
      "text": "共青團團員了"
    },
    {
      "end": 4200.52,
      "start": 4199.92,
      "text": "我什麼"
    },
    {
      "end": 4201.82,
      "start": 4200.52,
      "text": "我說我都不是團員"
    },
    {
      "end": 4202.62,
      "start": 4201.82,
      "text": "怎麼還優秀"
    },
    {
      "end": 4203.42,
      "start": 4202.82,
      "text": "是嗎"
    },
    {
      "end": 4204.42,
      "start": 4203.52,
      "text": "好你入黨了"
    },
    {
      "end": 4205.52,
      "start": 4204.92,
      "text": "完了就"
    },
    {
      "end": 4207.32,
      "start": 4205.52,
      "text": "這就是中共"
    },
    {
      "end": 4209.52,
      "start": 4207.82,
      "text": "他們的信仰有多麽的廉價"
    },
    {
      "end": 4210.92,
      "start": 4209.52,
      "text": "有多麽的假"
    },
    {
      "end": 4212.82,
      "start": 4211.32,
      "text": "完了我88年"
    },
    {
      "end": 4213.52,
      "start": 4212.82,
      "text": "就被"
    },
    {
      "end": 4214.82,
      "start": 4213.92,
      "text": "弄成了黨員"
    },
    {
      "end": 4216.12,
      "start": 4215.52,
      "text": "你入黨了"
    },
    {
      "end": 4216.82,
      "start": 4216.12,
      "text": "這就是他們"
    },
    {
      "end": 4218.62,
      "start": 4217.52,
      "text": "他們對他們的信仰"
    },
    {
      "end": 4220.32,
      "start": 4218.62,
      "text": "組織沒有任何的"
    },
    {
      "end": 4222.22,
      "start": 4220.52,
      "text": "真正發自內心的愛"
    },
    {
      "end": 4223.92,
      "start": 4222.52,
      "text": "他們就是利用"
    },
    {
      "end": 4225.62,
      "start": 4224.52,
      "text": "你踢著球好一點"
    },
    {
      "end": 4227.72,
      "start": 4225.92,
      "text": "當然我現在已經早就退黨了"
    },
    {
      "end": 4229.92,
      "start": 4227.92,
      "text": "我從八爺隊轉回大聯萬達的時候"
    },
    {
      "end": 4231.32,
      "start": 4229.92,
      "text": "組織關係也都丟了"
    },
    {
      "end": 4231.92,
      "start": 4231.32,
      "text": "都沒了"
    },
    {
      "end": 4235.92,
      "start": 4231.92,
      "text": "但是他們的入黨就是這麼的隨意"
    },
    {
      "end": 4237.12,
      "start": 4235.92,
      "text": "以及他們的廉價"
    },
    {
      "end": 4242.72,
      "start": 4237.12,
      "text": "所以他們不可能完成他們所謂的正確偉大光榮的黨"
    },
    {
      "end": 4243.62,
      "start": 4242.92,
      "text": "狗屁"
    },
    {
      "end": 4244.42,
      "start": 4243.92,
      "text": "對吧"
    },
    {
      "end": 4248.12,
