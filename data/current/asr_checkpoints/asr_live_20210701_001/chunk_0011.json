      "text": "你们在讲话"
    },
    {
      "end": 10195.62,
      "start": 10194.42,
      "text": "哈哈哈哈"
    },
    {
      "end": 10197.42,
      "start": 10195.62,
      "text": "那是我们的"
    },
    {
      "end": 10198.42,
      "start": 10197.42,
      "text": "在这些节目还主播"
