    {
      "end": 10312.62,
      "start": 10312.02,
      "text": "嗯"
    },
    {
      "end": 10314.02,
      "start": 10312.62,
      "text": "现在现在是"
    },
    {
      "end": 10315.22,
      "start": 10314.02,
      "text": "以假灭动"
