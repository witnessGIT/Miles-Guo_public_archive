    },
    {
      "end": 10283.62,
      "start": 10282.62,
      "text": "嗯"
    },
    {
      "end": 10285.62,
      "start": 10283.62,
      "text": "这一年就是做了太多太多了"
    },
    {
      "end": 10286.62,
