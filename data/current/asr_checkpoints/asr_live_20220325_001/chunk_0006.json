    {
      "avg_logprob": -0.220563,
      "compression_ratio": 1.412844,
      "end": 6006.52,
      "no_speech_prob": 0.0,
      "start": 6004.48,
      "text": "还有一个为别人当枪。"
    },
    {
      "avg_logprob": -0.220563,
      "compression_ratio": 1.412844,
      "end": 6009.52,
      "no_speech_prob": 0.0,
      "start": 6006.52,
      "text": "我跟他不认识,不存在私仇,"
    },
    {
      "avg_logprob": -0.220563,
      "compression_ratio": 1.412844,
      "end": 6011.64,
      "no_speech_prob": 0.0,
      "start": 6009.52,
      "text": "我跟他没打过交道,不存在利益,"
    },
    {
      "avg_logprob": -0.220563,
      "compression_ratio": 1.412844,
      "end": 6012.68,
      "no_speech_prob": 0.0,
      "start": 6011.64,
      "text": "他只有当枪。"
    },
    {
      "avg_logprob": -0.220563,
      "compression_ratio": 1.412844,
      "end": 6015.24,
      "no_speech_prob": 0.0,
      "start": 6012.68,
      "text": "当谁的枪,我的敌人是谁呢?"
    },
    {
      "avg_logprob": -0.266008,
      "compression_ratio": 1.333333,
      "end": 6018.82,
      "no_speech_prob": 0.0,
      "start": 6015.24,
      "text": "我的敌人就是共产党。"
    },
    {
      "avg_logprob": -0.266008,
      "compression_ratio": 1.333333,
      "end": 6023.44,
      "no_speech_prob": 0.0,
      "start": 6018.82,
      "text": "就这,还有人露大脑袋,也有人相信他,"
