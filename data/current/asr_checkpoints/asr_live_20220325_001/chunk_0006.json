    {
      "avg_logprob": -0.151997,
      "compression_ratio": 1.505495,
      "end": 6076.42,
      "no_speech_prob": 0.0,
      "start": 6072.84,
      "text": "有这么多无知的中国海外同胞和中国同胞,"
