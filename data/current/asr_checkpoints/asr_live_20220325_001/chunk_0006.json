    {
      "avg_logprob": -0.266008,
      "compression_ratio": 1.333333,
      "end": 6030.08,
      "no_speech_prob": 0.0,
      "start": 6027.78,
      "text": "那个拉茨维克斯的程水岩的孙子,"
