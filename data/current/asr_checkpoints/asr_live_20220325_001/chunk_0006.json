    {
      "avg_logprob": -0.151997,
      "compression_ratio": 1.505495,
      "end": 6083.6,
      "no_speech_prob": 0.0,
      "start": 6081.28,
      "text": "他却没有任何辨别真假的能力,"
    },
    {
      "avg_logprob": -0.151997,
      "compression_ratio": 1.505495,
      "end": 6084.88,
      "no_speech_prob": 0.0,
      "start": 6083.6,
      "text": "被他们利用几十年。"
