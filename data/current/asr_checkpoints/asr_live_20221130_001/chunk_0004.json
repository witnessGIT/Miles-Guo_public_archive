    {
      "avg_logprob": -0.301889,
      "compression_ratio": 1.285714,
      "end": 4308.0,
      "no_speech_prob": 0.0,
      "start": 4300.0,
      "text": "对对对吧,有人在想杀人呐,屋里头血流声,想杀人呐,可能杀人呐。"
