      "avg_logprob": -0.150639,
      "compression_ratio": 1.259067,
      "end": 4300.0,
      "no_speech_prob": 0.0,
      "start": 4294.0,
      "text": "西方媒体你看的报道,真正的核心感报道,有一家报道的。"
