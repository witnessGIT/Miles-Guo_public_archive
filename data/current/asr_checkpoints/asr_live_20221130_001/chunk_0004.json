    {
      "avg_logprob": -0.150639,
      "compression_ratio": 1.259067,
      "end": 4290.0,
      "no_speech_prob": 0.0,
      "start": 4286.0,
      "text": "会合作啊,但不要指望他们,不可能起决定作用。"
