    {
      "avg_logprob": -0.150639,
      "compression_ratio": 1.259067,
      "end": 4286.0,
      "no_speech_prob": 0.0,
      "start": 4280.0,
      "text": "所以说不要指望人家,只有我们的双腿双手。"
