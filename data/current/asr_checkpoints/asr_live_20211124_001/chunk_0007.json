    {
      "end": 6650.4,
      "start": 6648.4,
      "text": "咱不賣它就只漲"
    },
    {
      "end": 6652.4,
      "start": 6650.4,
      "text": "咱不能讓它老漲"
    },
    {
      "end": 6654.4,
      "start": 6652.4,
      "text": "咱要賣它就下來"
    },
    {
      "end": 6655.4,
      "start": 6654.4,
      "text": "這不一樣的道理嗎"
    },
    {
      "end": 6658.4,
      "start": 6655.4,
      "text": "就這麼簡單啊"
    },
    {
      "end": 6661.4,
      "start": 6658.4,
      "text": "咱就等著大鱷魚來錢嘛"
    },
    {
      "end": 6662.4,
      "start": 6661.4,
      "text": "是吧"
    },
    {
      "end": 6663.4,
      "start": 6662.4,
      "text": "來大錢嘛"
    },
    {
      "end": 6664.4,
      "start": 6663.4,
      "text": "咱一賣沒人接手"
    },
    {
      "end": 6666.4,
      "start": 6664.4,
      "text": "那不就砸下來了嗎"
    },
    {
      "end": 6668.4,
      "start": 6666.4,
      "text": "有人接手就越買越漲嗎"
    },
    {
      "end": 6671.4,
      "start": 6668.4,
      "text": "現在你如果是今天大頭賣的話"
    },
    {
      "end": 6673.4,
      "start": 6671.4,
      "text": "是不是他肯定往下撒"
    },
    {
      "end": 6674.4,
      "start": 6673.4,
      "text": "如果沒人賣"
    },
    {
      "end": 6675.4,
      "start": 6674.4,
      "text": "有人買"
    },
    {
      "end": 6676.4,
      "start": 6675.4,
      "text": "只能漲"
    },
    {
      "end": 6678.4,
      "start": 6676.4,
      "text": "而是漲到你無法想像的程度"
    },
    {
      "end": 6682.4,
      "start": 6680.4,
      "text": "那麼現在問題來了"
    },
    {
      "end": 6684.4,
      "start": 6682.4,
      "text": "北交所自己玩都漲不起來"
    },
    {
      "end": 6685.4,
      "start": 6684.4,
      "text": "你啥幹什麼"
    },
    {
      "end": 6687.4,
      "start": 6685.4,
      "text": "就咱們洗碟一樣的道理"
    },
    {
      "end": 6688.4,
      "start": 6687.4,
      "text": "咱們洗碟"
    },
    {
      "end": 6690.4,
      "start": 6688.4,
      "text": "但自己買自己都漲不起來"
    },
    {
      "end": 6691.4,
      "start": 6690.4,
      "text": "就說明什麼"
    },
    {
      "end": 6692.4,
      "start": 6691.4,
      "text": "完全沒信心了"
    },
    {
      "end": 6695.4,
      "start": 6694.4,
      "text": "完全沒信心了"
    },
    {
      "end": 6697.4,
      "start": 6695.4,
      "text": "也沒錢了"
    },
    {
      "end": 6701.4,
      "start": 6699.4,
      "text": "就像我說咱們戰友進來那個聽說啊"
    },
    {
      "end": 6702.4,
      "start": 6701.4,
      "text": "小十個億"
    },
    {
      "end": 6704.4,
      "start": 6702.4,
      "text": "你十個億都砸進去"
    },
    {
      "end": 6706.4,
      "start": 6704.4,
      "text": "你能砸多少錢啊"
    },
    {
      "end": 6709.4,
      "start": 6706.4,
      "text": "十個億砸進去才不到兩百萬個幣"
    },
    {
      "end": 6712.4,
      "start": 6710.4,
      "text": "你買回來你沒錢砸呀"
    },
    {
      "end": 6715.4,
      "start": 6712.4,
      "text": "他只能一部分把錢拿走"
    },
    {
      "end": 6716.4,
      "start": 6715.4,
      "text": "所以北交所"
    },
    {
      "end": 6717.4,
      "start": 6716.4,
      "text": "深交所"
    },
    {
      "end": 6718.4,
      "start": 6717.4,
      "text": "上交所"
    },
    {
      "end": 6719.4,
      "start": 6718.4,
      "text": "沒有外資"
    },
    {
      "end": 6725.4,
      "start": 6719.4,
      "text": "就像咱洗碟沒有機構打進來開始一樣"
    },
    {
      "end": 6727.4,
      "start": 6725.4,
      "text": "就這麼簡單的道理"
    },
    {
      "end": 6728.4,
      "start": 6727.4,
      "text": "是不是啊"
    },
    {
      "end": 6729.4,
      "start": 6728.4,
      "text": "誰掏一個子兒"
    },
    {
      "end": 6731.4,
      "start": 6729.4,
      "text": "就有今天大位的你們幾個每個人的份子"
    },
    {
      "end": 6732.4,
      "start": 6731.4,
      "text": "誰掏走"
    },
    {
      "end": 6733.4,
      "start": 6732.4,
      "text": "咱就這麼多錢"
    },
    {
      "end": 6734.4,
      "start": 6733.4,
      "text": "你給我掏走了"
    },
    {
      "end": 6737.4,
      "start": 6734.4,
      "text": "必須得沒外國人來玩這麼行"
    },
    {
      "end": 6740.4,
      "start": 6737.4,
      "text": "咱沒有機構召治者怎麼能行啊"
    },
    {
      "end": 6742.4,
      "start": 6741.4,
      "text": "是吧"
    },
    {
      "end": 6743.4,
      "start": 6742.4,
      "text": "只有家賊"
    },
    {
      "end": 6745.4,
      "start": 6743.4,
      "text": "現在咱們出現了幾個家賊"
    },
    {
      "end": 6746.4,
      "start": 6745.4,
      "text": "剛才三十七塊九毛九"
    },
    {
      "end": 6747.4,
      "start": 6746.4,
      "text": "剛才有人拋"
    },
    {
      "end": 6748.4,
      "start": 6747.4,
      "text": "剛才我看的"
    },
    {
      "end": 6751.4,
      "start": 6748.4,
      "text": "這塊這塊有人往下拋"
    },
    {
      "end": 6752.4,
      "start": 6751.4,
      "text": "又拋了一些小幾千個"
    },
    {
      "end": 6753.4,
      "start": 6752.4,
      "text": "是吧"
    },
    {
      "end": 6755.4,
      "start": 6754.4,
      "text": "兄弟姐妹們"
    },
    {
      "end": 6757.4,
      "start": 6755.4,
      "text": "共產黨的經濟到了什麼程度了"
    },
    {
      "end": 6760.4,
      "start": 6757.4,
      "text": "你們沒有剛才做PPT的三票先生"
    },
    {
      "end": 6762.4,
      "start": 6760.4,
      "text": "絕對是我敬佩的"
    },
    {
      "end": 6764.4,
      "start": 6762.4,
      "text": "還有泰山大牢"
    },
    {
      "end": 6767.4,
      "start": 6765.4,
      "text": "但是他永遠是金融家"
    },
    {
      "end": 6770.4,
      "start": 6768.4,
      "text": "他絕對不是中國政治的"
    },
    {
      "end": 6772.4,
      "start": 6770.4,
      "text": "中國叫紅色資本"
    },
    {
      "end": 6774.4,
      "start": 6773.4,
      "text": "咱以後就說柳傳志那個"
    },
    {
      "end": 6776.4,
      "start": 6774.4,
      "text": "啥叫紅色資本"
    },
    {
      "end": 6779.4,
      "start": 6776.4,
      "text": "就是他們的腦子裡邊沒有這個"
    },
    {
      "end": 6782.4,
      "start": 6781.4,
      "text": "啥叫紅色資本"
    },
    {
      "end": 6784.4,
      "start": 6782.4,
      "text": "說句實在話"
    },
    {
      "end": 6785.4,
      "start": 6784.4,
      "text": "紅色資本就是一句話"
    },
    {
      "end": 6787.4,
      "start": 6786.4,
      "text": "就是玩老千"
    },
    {
      "end": 6789.4,
      "start": 6788.4,
      "text": "就我說大衛兄弟玩普克牌"
    },
    {
      "end": 6791.4,
      "start": 6789.4,
      "text": "大衛兄弟拿大牌"
    },
    {
      "end": 6792.4,
      "start": 6791.4,
      "text": "甩"
    },
    {
      "end": 6793.4,
      "start": 6792.4,
      "text": "看紅的藍的"
    },
    {
      "end": 6794.4,
      "start": 6793.4,
      "text": "壓"
    },
    {
      "end": 6795.4,
      "start": 6794.4,
      "text": "壓哪個"
    },
    {
      "end": 6796.4,
      "start": 6795.4,
      "text": "壓"
    },
    {
      "end": 6797.4,
      "start": 6796.4,
      "text": "一打開"
    },
    {
      "end": 6798.4,
      "start": 6797.4,
      "text": "這是贏了"
    },
    {
      "end": 6799.4,
      "start": 6798.4,
      "text": "一翻兩瞪眼"
    },
    {
      "end": 6800.4,
      "start": 6799.4,
      "text": "是吧"
    },
    {
      "end": 6802.4,
      "start": 6800.4,
      "text": "就是抽老千就叫紅色資本"
    },
    {
      "end": 6805.4,
      "start": 6802.4,
      "text": "抽老千的權利就是紅色資本的權利"
    },
    {
      "end": 6810.4,
      "start": 6805.4,
      "text": "現在共產黨的所謂股票市場"
    },
    {
      "end": 6812.4,
      "start": 6810.4,
      "text": "純扯淡的就是玩老千"
    },
    {
      "end": 6814.4,
      "start": 6812.4,
      "text": "他玩的是誰"
    },
    {
      "end": 6815.4,
      "start": 6814.4,
      "text": "就是玩的老百姓"
    },
    {
      "end": 6819.4,
      "start": 6815.4,
      "text": "沒有任何就是騙老百姓錢的地方"
    },
    {
      "end": 6822.4,
      "start": 6820.4,
      "text": "你現在像洗碧一個最簡單的道理"
    },
    {
      "end": 6823.4,
      "start": 6822.4,
      "text": "洗碧在那擱著呢"
    },
    {
      "end": 6825.4,
      "start": 6823.4,
      "text": "交易所在那擱著呢"
    },
    {
      "end": 6827.4,
      "start": 6825.4,
      "text": "大家拿了一億美元進去在那擱著呢"
    },
    {
      "end": 6830.4,
      "start": 6827.4,
      "text": "然後現在市場認可的價錢在那擱著呢"
    },
    {
      "end": 6832.4,
      "start": 6830.4,
      "text": "然後有沒有機構同事你可以看得著摩托劍"
    },
    {
      "end": 6833.4,
      "start": 6832.4,
      "text": "他有一個透明"
    },
    {
      "end": 6837.4,
      "start": 6834.4,
      "text": "他有一個受澳大利亞法律"
    },
    {
      "end": 6838.4,
      "start": 6837.4,
      "text": "巴哈馬法律"
    },
    {
      "end": 6840.4,
      "start": 6838.4,
      "text": "大英帝國美國法律"
    },
    {
      "end": 6841.4,
      "start": 6840.4,
      "text": "全球法律監管"
    },
    {
      "end": 6842.4,
      "start": 6841.4,
      "text": "共產黨的誰監管他"
    },
    {
      "end": 6844.4,
      "start": 6842.4,
      "text": "我看看你的數據"
    },
    {
      "end": 6845.4,
      "start": 6844.4,
      "text": "他不讓你看"
    },
    {
      "end": 6847.4,
      "start": 6845.4,
      "text": "我看看你的這個錢"
    },
    {
      "end": 6848.4,
      "start": 6847.4,
      "text": "我不讓你看"
    },
    {
      "end": 6850.4,
      "start": 6848.4,
      "text": "我投進去多了不行"
    },
    {
      "end": 6852.4,
      "start": 6850.4,
      "text": "我拿走也不行"
    },
    {
      "end": 6854.4,
      "start": 6852.4,
      "text": "你這是說啥的呀"
    },
    {
      "end": 6858.4,
      "start": 6855.4,
      "text": "所以戰友們今天談到共產黨的資本的時候"
    },
    {
      "end": 6861.4,
      "start": 6859.4,
      "text": "你要知道紅色資本"
    },
    {
      "end": 6862.4,
      "start": 6861.4,
      "text": "他就是抽老千的"
    },
    {
      "end": 6863.4,
      "start": 6862.4,
      "text": "他就是個賭局"
    },
    {
      "end": 6867.4,
      "start": 6865.4,
      "text": "我的家人"
    },
    {
      "end": 6869.4,
      "start": 6867.4,
      "text": "我其中有兩個嫂子就是玩股票的"
    },
    {
      "end": 6872.4,
      "start": 6870.4,
      "text": "嫂子竟然傻乎乎乎的"
    },
    {
      "end": 6874.4,
      "start": 6872.4,
      "text": "每天早上坐在那塊七八個小時"
    },
    {
      "end": 6875.4,
      "start": 6874.4,
      "text": "看個看電腦"
    },
    {
      "end": 6878.4,
      "start": 6875.4,
      "text": "每天回來跟我們家人懸繞"
    },
    {
      "end": 6880.4,
      "start": 6878.4,
      "text": "我在關系業的時候高島跑了"
    },
    {
      "end": 6881.4,
      "start": 6880.4,
      "text": "掙了兩千"
    },
    {
      "end": 6882.4,
      "start": 6881.4,
      "text": "我第一次買進多少"
    },
    {
      "end": 6884.4,
      "start": 6882.4,
      "text": "這都是十多年前的事兒了"
    },
    {
      "end": 6885.4,
      "start": 6884.4,
      "text": "他從來問我"
    },
    {
      "end": 6886.4,
      "start": 6885.4,
      "text": "我一聲也不知"
    },
    {
      "end": 6887.4,
      "start": 6886.4,
      "text": "哎呀兄弟"
    },
    {
      "end": 6888.4,
      "start": 6887.4,
      "text": "你給我說點內部消息呀"
    },
    {
      "end": 6889.4,
      "start": 6888.4,
      "text": "我說你記住"
    },
    {
      "end": 6891.4,
      "start": 6889.4,
      "text": "中國玩股票"
    },
    {
      "end": 6893.4,
      "start": 6891.4,
      "text": "又有任何一個人掙了錢"
    },
    {
      "end": 6894.4,
      "start": 6893.4,
      "text": "我說你七弟"
    },
    {
      "end": 6895.4,
      "start": 6894.4,
      "text": "我去給他舔腳去"
    },
    {
      "end": 6896.4,
      "start": 6895.4,
      "text": "我不是七腳"
    },
    {
      "end": 6897.4,
      "start": 6896.4,
      "text": "我拿舌頭舔腳去"
    },
    {
      "end": 6898.4,
      "start": 6897.4,
      "text": "包括你"
    },
    {
      "end": 6901.4,
      "start": 6899.4,
      "text": "他說啥我都服你"
    },
    {
      "end": 6902.4,
      "start": 6901.4,
      "text": "就這你嫂子不服你"
    },
    {
      "end": 6903.4,
      "start": 6902.4,
      "text": "我說那你走著看"
    },
    {
      "end": 6907.4,
      "start": 6903.4,
      "text": "我哥那點錢幾乎讓他工資那點錢"
    },
    {
      "end": 6908.4,
      "start": 6907.4,
      "text": "加著發點付的"
    },
    {
      "end": 6909.4,
      "start": 6908.4,
      "text": "全都賠得光光的"
    },
    {
      "end": 6912.4,
      "start": 6910.4,
      "text": "我記住那天我發出的照片"
    },
    {
      "end": 6913.4,
      "start": 6912.4,
      "text": "站在我旁邊那個人"
    },
    {
      "end": 6915.4,
      "start": 6913.4,
      "text": "當時是我們的工程的總指揮"
    },
    {
      "end": 6918.4,
      "start": 6916.4,
      "text": "我跟你們講過一段的故事"
    },
    {
      "end": 6920.4,
      "start": 6918.4,
      "text": "就在那個盤古摩根"
    },
    {
      "end": 6924.4,
      "start": 6920.4,
      "text": "2008年之後突然間就是我們開奧運會前"
    },
    {
      "end": 6925.4,
      "start": 6924.4,
      "text": "奧運會後"
    },
    {
      "end": 6926.4,
      "start": 6925.4,
      "text": "2007年年底啊"
    },
    {
      "end": 6928.4,
      "start": 6927.4,
      "text": "所有的工程師對面"
    },
    {
      "end": 6929.4,
      "start": 6928.4,
      "text": "一半人說"
    },
    {
      "end": 6932.4,
      "start": 6929.4,
      "text": "就像咱們爆料革命路大腦的石耀炎一樣"
    },
    {
      "end": 6933.4,
      "start": 6932.4,
      "text": "說郭先生"
    },
    {
      "end": 6935.4,
      "start": 6933.4,
      "text": "我們可能要辭職了"
    },
    {
      "end": 6936.4,
      "start": 6935.4,
      "text": "我說為什麼呀"
    },
    {
      "end": 6938.4,
      "start": 6936.4,
      "text": "我在國內的場面比較大"
    },
    {
      "end": 6941.4,
      "start": 6938.4,
      "text": "一出行都是十幾台車幾十個人呼呼呼呼呼的"
    },
    {
      "end": 6943.4,
      "start": 6941.4,
      "text": "旁邊的人都傻一傻"
    },
    {
      "end": 6944.4,
      "start": 6943.4,
      "text": "咋回事"
    },
    {
      "end": 6946.4,
      "start": 6944.4,
      "text": "就一半中一半就直直了"
    },
    {
      "end": 6947.4,
      "start": 6946.4,
      "text": "股票"
    },
    {
      "end": 6948.4,
      "start": 6947.4,
      "text": "我們都賺錢了"
    },
    {
      "end": 6950.4,
      "start": 6949.4,
      "text": "跟卡雷西那一樣"
    },
    {
      "end": 6952.4,
      "start": 6950.4,
      "text": "因為卡雷西玩股票那一樣"
    },
    {
      "end": 6953.4,
      "start": 6952.4,
      "text": "我們都賺大錢了"
    },
    {
      "end": 6954.4,
      "start": 6953.4,
      "text": "說實在話"
    },
    {
      "end": 6955.4,
      "start": 6954.4,
      "text": "誰賺了300"
    },
    {
      "end": 6956.4,
      "start": 6955.4,
      "text": "他賺了1000"
    },
    {
      "end": 6957.4,
      "start": 6956.4,
      "text": "他賺了1000"
    },
    {
      "end": 6958.4,
      "start": 6957.4,
      "text": "他賺多少"
    },
    {
      "end": 6960.4,
      "start": 6958.4,
      "text": "他說我跟我閨女雙爛爛好了"
    },
    {
      "end": 6961.4,
      "start": 6960.4,
      "text": "回去啊"
    },
    {
      "end": 6963.4,
      "start": 6961.4,
      "text": "把家的房子都押出去了"
    },
    {
      "end": 6965.4,
      "start": 6963.4,
      "text": "就專職炒股票了"
    },
    {
      "end": 6966.4,
      "start": 6965.4,
      "text": "我說你想好了嗎"
    },
    {
      "end": 6967.4,
      "start": 6966.4,
      "text": "想好了"
    },
    {
      "end": 6968.4,
      "start": 6967.4,
      "text": "我這樣"
    },
    {
      "end": 6969.4,
      "start": 6968.4,
      "text": "工資給你留"
    },
    {
      "end": 6970.4,
      "start": 6969.4,
      "text": "一年工資"
    },
    {
      "end": 6971.4,
      "start": 6970.4,
      "text": "你現在就可以走了"
    },
    {
      "end": 6973.4,
      "start": 6972.4,
      "text": "他說你看我工作還要交接"
    },
    {
      "end": 6974.4,
      "start": 6973.4,
      "text": "我不用交接"
    },
    {
      "end": 6976.4,
      "start": 6975.4,
      "text": "我全拿"
    },
    {
      "end": 6979.4,
      "start": 6977.4,
      "text": "七個人生經歷了無數這樣的事"
    },
    {
      "end": 6980.4,
      "start": 6979.4,
      "text": "酒店總局裡辭職"
    },
    {
      "end": 6982.4,
      "start": 6980.4,
      "text": "我們最多一年換我三次"
    },
    {
      "end": 6983.4,
      "start": 6982.4,
      "text": "在三四個酒店總局裡"
    },
    {
      "end": 6984.4,
      "start": 6983.4,
      "text": "都老外"
    },
    {
      "end": 6986.4,
      "start": 6984.4,
      "text": "你不答應我條件我就走人"
    },
    {
      "end": 6987.4,
      "start": 6986.4,
      "text": "我現在就是走"
    },
    {
      "end": 6988.4,
      "start": 6987.4,
      "text": "你來報紙都不能回"
    },
    {
      "end": 6989.4,
      "start": 6988.4,
      "text": "立馬就走人"
    },
    {
      "end": 6990.4,
      "start": 6989.4,
      "text": "你們可以查查這個歷史"
    },
    {
      "end": 6993.4,
      "start": 6990.4,
      "text": "我說我現在是臨時老總"
    },
    {
      "end": 6995.4,
      "start": 6993.4,
      "text": "過去的極致要精神多了"
    },
    {
      "end": 6997.4,
      "start": 6995.4,
      "text": "這幾個人全走了"
    },
    {
      "end": 6998.4,
      "start": 6997.4,
      "text": "大家都知道後來"
    },
    {
      "end": 7000.4,
      "start": 6998.4,
      "text": "當時這股票發生什麼事"
    },
    {
      "end": 7001.4,
      "start": 7000.4,
      "text": "全是窮家當產"
    },
    {
      "end": 7003.4,
      "start": 7002.4,
      "text": "你看到我身邊好幾個人"
    },
    {
      "end": 7004.4,
      "start": 7003.4,
      "text": "都是窮家當產"
    },
    {
      "end": 7006.4,
      "start": 7005.4,
      "text": "跳樓的跳樓"
    },
    {
      "end": 7007.4,
      "start": 7006.4,
      "text": "自殺的自殺"
    },
    {
      "end": 7009.4,
      "start": 7008.4,
      "text": "就中國"
    },
    {
      "end": 7012.4,
      "start": 7009.4,
      "text": "中國人對股票市場的這個賭博性"
    },
    {
      "end": 7013.4,
      "start": 7012.4,
      "text": "參與性"
    },
    {
      "end": 7015.4,
      "start": 7013.4,
      "text": "九十幾都是小客戶"
    },
    {
      "end": 7017.4,
      "start": 7015.4,
      "text": "而美國八九十都是機構客戶"
    },
    {
      "end": 7018.4,
      "start": 7017.4,
      "text": "你就知道"
    },
    {
      "end": 7020.4,
      "start": 7018.4,
      "text": "這個中共的股"
    },
    {
      "end": 7022.4,
      "start": 7020.4,
      "text": "整個股市就是個賭場"
    },
    {
      "end": 7024.4,
      "start": 7022.4,
      "text": "他為啥要開北交所"
    },
    {
      "end": 7026.4,
      "start": 7025.4,
      "text": "他是個政治的需要"
    },
    {
      "end": 7030.4,
      "start": 7027.4,
      "text": "他為什麼要把現在馬雲這幫人要幹掉"
    },
    {
      "end": 7032.4,
      "start": 7030.4,
      "text": "我今天要跟你一會兒說一個我的觀點"
    },
    {
      "end": 7034.4,
      "start": 7033.4,
      "text": "柳傳志的事件"
    },
    {
      "end": 7036.4,
      "start": 7034.4,
      "text": "咱今天可能都準備了"
    },
    {
      "end": 7037.4,
      "start": 7036.4,
      "text": "兄弟姐妹們"
    },
    {
      "end": 7040.4,
      "start": 7038.4,
      "text": "你讓我發自內心的說"
    },
    {
      "end": 7042.4,
      "start": 7040.4,
      "text": "馬雲絕不應該是如此"
    },
    {
      "end": 7047.4,
      "start": 7045.4,
      "text": "馬雲怎麼最該如此啊"
    },
    {
      "end": 7050.4,
      "start": 7048.4,
      "text": "柳傳志也不最該如此"
    },
    {
      "end": 7052.4,
      "start": 7050.4,
      "text": "他女兒滴滴也不應該最該如此"
    },
    {
      "end": 7054.4,
      "start": 7052.4,
      "text": "那麼這本質和交易所什麼關係"
    },
    {
      "end": 7055.4,
      "start": 7054.4,
      "text": "他是一場大掠奪的開始"
    },
    {
      "end": 7058.4,
      "start": 7055.4,
      "text": "他是共產黨的殺富積貧"
    },
    {
      "end": 7059.4,
      "start": 7058.4,
      "text": "什麼叫做共享財富"
    },
    {
      "end": 7060.4,
      "start": 7059.4,
      "text": "就是殺富積貧"
    },
    {
      "end": 7062.4,
      "start": 7060.4,
      "text": "他關鍵是是不是殺富積了貧"
    },
    {
      "end": 7071.4,
      "start": 7062.4,
      "text": "貧的會更貧"
    },
    {
      "end": 7073.4,
      "start": 7072.4,
      "text": "貧的會沒有"
    },
    {
      "end": 7075.4,
      "start": 7073.4,
      "text": "只有共產黨會富有"
    },
    {
      "end": 7077.4,
      "start": 7075.4,
      "text": "就像殺掉兩百萬多個地主"
    },
    {
      "end": 7079.4,
      "start": 7077.4,
      "text": "中國人最後文化大革命"
    },
    {
      "end": 7082.4,
      "start": 7079.4,
      "text": "大約死了將近八千萬到一億人"
    },
    {
      "end": 7086.4,
      "start": 7084.4,
      "text": "而且土地盡歸共產黨"
    },
    {
      "end": 7087.4,
      "start": 7086.4,
      "text": "到今天都是共產黨"
    },
    {
      "end": 7093.4,
      "start": 7087.4,
      "text": "雅虎現在讓你還拿沒有土地產權的"
    },
    {
      "end": 7095.4,
      "start": 7093.4,
      "text": "讓你拿房地產稅"
    },
    {
      "end": 7098.4,
      "start": 7096.4,
      "text": "這一場革命"
    },
    {
      "end": 7100.4,
      "start": 7098.4,
      "text": "所謂的殺富豪分土地"
    },
    {
      "end": 7102.4,
      "start": 7100.4,
      "text": "從所有的開始"
    },
    {
      "end": 7103.4,
      "start": 7102.4,
      "text": "它叫依法搶劫"
    },
    {
      "end": 7105.4,
      "start": 7104.4,
      "text": "這話是誰先說的"
    },
    {
      "end": 7106.4,
      "start": 7105.4,
      "text": "我告訴你"
    },
    {
      "end": 7109.4,
      "start": 7106.4,
      "text": "這是最早的是王滬寧給習說的"
    },
    {
      "end": 7112.4,
      "start": 7109.4,
      "text": "我們不能再殺地主分田地了"
    },
    {
      "end": 7114.4,
      "start": 7112.4,
      "text": "但我們可以通過市場行為"
    },
    {
      "end": 7116.4,
      "start": 7114.4,
      "text": "合法的降財富"
    },
    {
      "end": 7119.4,
      "start": 7116.4,
      "text": "給他來個均貧富"
    },
    {
      "end": 7121.4,
      "start": 7119.4,
      "text": "這是王滬寧的原話"
    },
    {
      "end": 7122.4,
      "start": 7121.4,
      "text": "啥時候說的"
    },
    {
      "end": 7124.4,
      "start": 7122.4,
      "text": "2006年"
    },
    {
      "end": 7125.4,
      "start": 7124.4,
      "text": "那時候王滬寧"
    },
    {
      "end": 7127.4,
      "start": 7125.4,
      "text": "那時候我盤古中心"
    },
    {
      "end": 7129.4,
      "start": 7127.4,
      "text": "你們真不知道你七哥有多牛"
    },
    {
      "end": 7131.4,
      "start": 7129.4,
      "text": "那從早到晚"
    },
    {
      "end": 7134.4,
      "start": 7131.4,
      "text": "24小時都是全人類最牛的官員"
    },
    {
      "end": 7135.4,
      "start": 7134.4,
      "text": "奧運官員"
    },
    {
      "end": 7136.4,
      "start": 7135.4,
      "text": "政府官員"
    },
    {
      "end": 7139.4,
      "start": 7136.4,
      "text": "那法國總統薩爾克奇大早上起來提前拜訪"
    },
    {
      "end": 7141.4,
      "start": 7139.4,
      "text": "知道七哥不下去接他"
    },
    {
      "end": 7144.4,
      "start": 7141.4,
      "text": "當時的陳剛副市長帶他去參加"
    },
    {
      "end": 7146.4,
      "start": 7144.4,
      "text": "正在建設的鳥巢"
    },
    {
      "end": 7147.4,
      "start": 7146.4,
      "text": "你去上網查查"
    },
    {
      "end": 7149.4,
      "start": 7147.4,
      "text": "邀請郭文貴一定陪他餐"
    },
    {
      "end": 7150.4,
      "start": 7149.4,
      "text": "跟小流氓似的"
    },
    {
      "end": 7151.4,
      "start": 7150.4,
      "text": "晃晃噹噹噹的"
    },
    {
      "end": 7153.4,
      "start": 7151.4,
      "text": "他老婆的個子比他還高"
    },
    {
      "end": 7155.4,
      "start": 7153.4,
      "text": "他老婆我認識比他還早呢"
    },
    {
      "end": 7159.4,
      "start": 7155.4,
      "text": "結果說我在盤古"
    },
    {
      "end": 7161.4,
      "start": 7159.4,
      "text": "當時的摩根中心臨時工地"
    },
    {
      "end": 7162.4,
      "start": 7161.4,
      "text": "我那餐廳"
    },
    {
      "end": 7165.4,
      "start": 7162.4,
      "text": "他們都聽說那裡有早餐最好"
    },
    {
      "end": 7167.4,
      "start": 7165.4,
      "text": "法國幾個達索公司說"
    },
    {
      "end": 7169.4,
      "start": 7167.4,
      "text": "你一定要去上這麥克風的工程吃早餐"
    },
    {
      "end": 7171.4,
      "start": 7169.4,
      "text": "我說他老婆可以來他不要來"
    },
    {
      "end": 7173.4,
      "start": 7171.4,
      "text": "我超級討厭這個人"
    },
    {
      "end": 7175.4,
      "start": 7173.4,
      "text": "七哥當年就這麼牛叉這個人物"
    },
    {
      "end": 7178.4,
      "start": 7175.4,
      "text": "你好好看看我身邊長的人的長相"
    },
    {
      "end": 7179.4,
      "start": 7178.4,
      "text": "穿的衣裳"
    },
    {
      "end": 7183.4,
      "start": 7179.4,
      "text": "我當時在北城東路的辦公室"
    },
    {
      "end": 7186.4,
      "start": 7183.4,
      "text": "今天中國人沒有任何人擁有這樣的辦公室"
    },
    {
      "end": 7187.4,
      "start": 7186.4,
      "text": "我可以告訴大家"
    },
    {
      "end": 7191.4,
      "start": 7187.4,
      "text": "我的整個辦公室的安防設備空調"
    },
    {
      "end": 7193.4,
      "start": 7191.4,
      "text": "我是Re-array全封系統"
    },
    {
      "end": 7195.4,
      "start": 7193.4,
      "text": "你看當時"
    },
    {
      "end": 7197.4,
      "start": 7195.4,
      "text": "保馬的整個總裁都在我那裡吃飯"
    },
    {
      "end": 7199.4,
      "start": 7197.4,
      "text": "每次都給狗一樣在地上爬"
