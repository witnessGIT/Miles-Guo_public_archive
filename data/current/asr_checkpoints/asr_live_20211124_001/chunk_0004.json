  "segments": [
    {
      "end": 3601.28,
      "start": 3600.0,
      "text": "他也有他的錢"
    },
    {
      "end": 3605.12,
      "start": 3602.3,
      "text": "只有戰友拿到這種大機構投資者"
    },
    {
      "end": 3606.84,
      "start": 3605.38,
      "text": "百億千億的錢的時候"
    },
    {
      "end": 3610.24,
      "start": 3606.84,
      "text": "你會覺得這錢是來自機構投資者的錢"
    },
    {
      "end": 3612.54,
      "start": 3610.76,
      "text": "你不能吃戰友們的錢"
    },
    {
      "end": 3614.6,
      "start": 3612.92,
      "text": "你不能吃大衛的錢"
    },
    {
      "end": 3617.16,
      "start": 3614.6,
      "text": "大衛的本來屬於我的40塊錢"
    },
    {
      "end": 3618.04,
      "start": 3617.16,
      "text": "你賣走了"
    },
    {
      "end": 3620.22,
      "start": 3618.04,
      "text": "我為我40塊錢成了4毛錢了"
    },
    {
      "end": 3621.76,
      "start": 3620.48,
      "text": "那你這不是坑人嗎"
    },
    {
      "end": 3623.04,
      "start": 3622.1,
      "text": "你懂我意思了嗎"
    },
    {
      "end": 3624.84,
      "start": 3623.3,
      "text": "所以這是個基本的常識"
    },
    {
      "end": 3625.6,
      "start": 3624.84,
      "text": "謝謝卡利希"
    },
    {
      "end": 3630.76,
      "start": 3630.0,
      "text": "大衛"
    },
    {
      "end": 3634.6,
      "start": 3631.02,
      "text": "好 齊哥 順著剛才您提到這個話題"
    },
    {
      "end": 3638.2,
      "start": 3635.12,
      "text": "我今天稍早看到華爾街時報"
    },
    {
      "end": 3639.72,
      "start": 3638.44,
      "text": "就把這個币安"
    },
    {
      "end": 3641.26,
      "start": 3640.24,
      "text": "他的這個平臺"
    },
    {
      "end": 3646.38,
      "start": 3641.78,
      "text": "還有他用他的原話華爾街報紙的寫的是沒有"
    },
    {
      "end": 3647.16,
      "start": 3646.64,
      "text": "執照"
    },
    {
      "end": 3648.44,
      "start": 3647.4,
      "text": "沒有總部"
    },
    {
      "end": 3651.24,
      "start": 3648.68,
      "text": "然後呢760億美元的交易量"
    },
    {
      "end": 3652.52,
      "start": 3651.5,
      "text": "那麼我就想說"
    },
    {
      "end": 3653.04,
      "start": 3652.52,
      "text": "是嗎"
    },
    {
      "end": 3654.06,
      "start": 3653.04,
      "text": "我想問您一個問題"
    },
    {
      "end": 3655.6,
      "start": 3654.06,
      "text": "對 就華爾街時報有一個"
    },
    {
      "end": 3656.62,
      "start": 3655.86,
      "text": "有一篇新聞"
    },
    {
      "end": 3657.64,
      "start": 3657.14,
      "text": "23號"
    },
    {
      "end": 3659.94,
      "start": 3657.64,
      "text": "美東時間的這個已經出來了"
    },
    {
      "end": 3661.22,
      "start": 3660.46,
      "text": "所以我想說什麼呢"
    },
    {
      "end": 3662.24,
      "start": 3661.48,
      "text": "就是共產黨"
    },
    {
      "end": 3663.78,
      "start": 3662.5,
      "text": "為什麼在這個時候"
    },
    {
      "end": 3665.06,
      "start": 3664.3,
      "text": "和這個"
    },
    {
      "end": 3665.84,
      "start": 3665.32,
      "text": "币安"
    },
    {
      "end": 3666.6,
      "start": 3666.08,
      "text": "有這個合作"
    },
    {
      "end": 3667.88,
      "start": 3666.6,
      "text": "他出賣了這麼大"
    },
    {
      "end": 3669.16,
      "start": 3668.14,
      "text": "戰友的KPCC"
    },
    {
      "end": 3670.96,
      "start": 3669.68,
      "text": "然後呢再結合這兩天"
    },
    {
      "end": 3671.72,
      "start": 3670.96,
      "text": "標普500啊"
    },
    {
      "end": 3672.74,
      "start": 3671.98,
      "text": "看一下美國的股指"
    },
    {
      "end": 3673.52,
      "start": 3672.74,
      "text": "這樣可以看一下"
    },
    {
      "end": 3675.3,
      "start": 3674.02,
      "text": "剛好連續幾天"
    },
    {
      "end": 3676.32,
      "start": 3675.3,
      "text": "尤其到上週五"
    },
    {
      "end": 3677.86,
      "start": 3676.84,
      "text": "出現一個頭部的"
    },
    {
      "end": 3678.64,
      "start": 3678.12,
      "text": "這個"
    },
    {
      "end": 3679.92,
      "start": 3679.4,
      "text": "變化"
    },
    {
      "end": 3680.94,
      "start": 3680.16,
      "text": "事實上來講"
    },
    {
      "end": 3682.22,
      "start": 3680.94,
      "text": "就是美元"
    },
    {
      "end": 3682.98,
      "start": 3682.48,
      "text": "美債"
    },
    {
      "end": 3684.0,
      "start": 3683.24,
      "text": "最近這幾"
    },
    {
      "end": 3685.28,
      "start": 3684.0,
      "text": "一個多月發生的"
    },
    {
      "end": 3686.82,
      "start": 3685.8,
      "text": "恐慌逃離的現象"
    },
    {
      "end": 3688.1,
      "start": 3686.82,
      "text": "已經開始慢慢顯現了"
    },
    {
      "end": 3689.12,
      "start": 3688.62,
      "text": "那麼我想說"
    },
    {
      "end": 3690.14,
      "start": 3689.12,
      "text": "七哥會不會是"
    },
    {
      "end": 3691.18,
      "start": 3690.4,
      "text": "就是以您對美國"
    },
    {
      "end": 3692.46,
      "start": 3691.42,
      "text": "華爾街這些人的了解"
    },
    {
      "end": 3693.48,
      "start": 3693.22,
      "text": "對吧"
    },
    {
      "end": 3693.98,
      "start": 3693.48,
      "text": "Follow the money"
    },
    {
      "end": 3695.78,
      "start": 3694.76,
      "text": "這麼敏感的時刻"
    },
    {
      "end": 3697.32,
      "start": 3696.04,
      "text": "避安又出現這樣的事情"
    },
    {
      "end": 3698.34,
      "start": 3697.58,
      "text": "是不是意味著我們"
    },
    {
      "end": 3699.36,
      "start": 3698.6,
      "text": "洗幣還有咱們這個"
    },
    {
      "end": 3700.14,
      "start": 3699.62,
      "text": "機器的迎來一個"
    },
    {
      "end": 3700.64,
      "start": 3700.38,
      "text": "巨大的機會"
    },
    {
      "end": 3701.16,
      "start": 3700.9,
      "text": "因為"
    },
    {
      "end": 3702.18,
      "start": 3701.42,
      "text": "投資者本然"
    },
    {
      "end": 3703.2,
      "start": 3702.44,
      "text": "天然的屬性"
    },
    {
      "end": 3703.72,
      "start": 3703.46,
      "text": "它要避險"
    },
    {
      "end": 3705.0,
      "start": 3704.22,
      "text": "大家可以看一下"
    },
    {
      "end": 3705.5,
      "start": 3705.26,
      "text": "這個"
    },
    {
      "end": 3706.28,
      "start": 3705.76,
      "text": "華爾街"
    },
    {
      "end": 3707.04,
      "start": 3706.54,
      "text": "標普500"
    },
    {
      "end": 3708.06,
      "start": 3707.3,
      "text": "上週週五的"
    },
    {
      "end": 3708.58,
      "start": 3708.32,
      "text": "收盤"
    },
    {
      "end": 3709.1,
      "start": 3708.84,
      "text": "那個情況"
    },
    {
      "end": 3710.12,
      "start": 3709.34,
      "text": "已經出現了一個"
    },
    {
      "end": 3711.14,
      "start": 3710.38,
      "text": "頭部形態"
    },
    {
      "end": 3712.16,
      "start": 3711.4,
      "text": "我覺得這是不是一個"
    },
    {
      "end": 3712.68,
      "start": 3712.16,
      "text": "切記呢"
    },
    {
      "end": 3712.94,
      "start": 3712.68,
      "text": "七哥"
    },
    {
      "end": 3714.22,
      "start": 3712.94,
      "text": "好"
    },
    {
      "end": 3715.76,
      "start": 3714.98,
      "text": "各位兄弟"
    },
    {
      "end": 3716.78,
      "start": 3716.02,
      "text": "所以說這個"
    },
    {
      "end": 3718.32,
      "start": 3717.04,
      "text": "幹過警察的人啊"
    },
    {
      "end": 3719.6,
      "start": 3718.58,
      "text": "他知道這個"
    },
    {
      "end": 3721.64,
      "start": 3720.1,
      "text": "心理學裡邊的根本基礎"
    },
    {
      "end": 3722.42,
      "start": 3721.9,
      "text": "就是邏輯"
    },
    {
      "end": 3723.18,
      "start": 3722.92,
      "text": "是吧"
    },
    {
      "end": 3724.72,
      "start": 3723.94,
      "text": "共產黨"
    },
    {
      "end": 3725.22,
      "start": 3724.98,
      "text": "絕"
    },
    {
      "end": 3727.28,
      "start": 3725.48,
      "text": "趙昌鵬是百分之百"
    },
    {
      "end": 3728.56,
      "start": 3727.54,
      "text": "把東西給了共產黨"
    },
    {
      "end": 3730.34,
      "start": 3729.32,
      "text": "他為什麼要滅他"
    },
    {
      "end": 3731.38,
      "start": 3731.12,
      "text": "是吧"
    },
    {
      "end": 3732.66,
      "start": 3731.62,
      "text": "就是現在剛才"
    },
    {
      "end": 3734.7,
      "start": 3732.9,
      "text": "我們的漂亮的三百年的"
    },
    {
      "end": 3735.22,
      "start": 3734.96,
      "text": "菲菲的"
    },
    {
      "end": 3736.5,
      "start": 3735.46,
      "text": "剛才已經回答了問題"
    },
    {
      "end": 3738.28,
      "start": 3737.52,
      "text": "他有錢"
    },
    {
      "end": 3739.56,
      "start": 3738.54,
      "text": "他已經沒有任何避漏"
    },
    {
      "end": 3740.34,
      "start": 3739.56,
      "text": "沒有任何交易了"
    },
    {
      "end": 3741.1,
      "start": 3740.34,
      "text": "我想錢拿走"
    },
    {
      "end": 3741.86,
      "start": 3741.1,
      "text": "他不給他"
    },
    {
      "end": 3743.4,
      "start": 3742.38,
      "text": "那你先放在這吧"
    },
    {
      "end": 3744.68,
      "start": 3743.66,
      "text": "放在我的錢包裡邊"
    },
    {
      "end": 3747.24,
      "start": 3745.7,
      "text": "趙昌鵬要自己宣布說"
    },
    {
      "end": 3748.52,
      "start": 3747.5,
      "text": "這錢我不還你了"
    },
    {
      "end": 3749.54,
      "start": 3749.04,
      "text": "他是犯罪"
    },
    {
      "end": 3751.86,
      "start": 3750.82,
      "text": "趙昌鵬這個世界"
    },
    {
      "end": 3752.88,
      "start": 3751.86,
      "text": "沒有幾個國家可以去了"
    },
    {
      "end": 3753.64,
      "start": 3753.14,
      "text": "除了非洲"
    },
    {
      "end": 3754.16,
      "start": 3753.9,
      "text": "迪拜"
    },
    {
      "end": 3754.92,
      "start": 3754.66,
      "text": "台灣"
    },
    {
      "end": 3755.94,
      "start": 3755.18,
      "text": "他沒有任何國家"
    },
    {
      "end": 3758.0,
      "start": 3756.72,
      "text": "像日本啊"
    },
    {
      "end": 3758.76,
      "start": 3758.26,
      "text": "像美國啊"
    },
    {
      "end": 3760.04,
      "start": 3759.02,
      "text": "像叫做"
    },
    {
      "end": 3761.32,
      "start": 3760.56,
      "text": "西語國家"
    },
    {
      "end": 3763.12,
      "start": 3761.84,
      "text": "西法系國家"
    },
    {
      "end": 3765.16,
      "start": 3763.62,
      "text": "幾乎都得把他抓起來"
    },
    {
      "end": 3766.96,
      "start": 3765.68,
      "text": "而且終身會在大佬裡邊"
    },
    {
      "end": 3769.26,
      "start": 3767.46,
      "text": "他會比那個危機創始人還可怕"
    },
    {
      "end": 3771.06,
      "start": 3769.26,
      "text": "因為他所有的"
    },
    {
      "end": 3773.1,
      "start": 3771.56,
      "text": "幣的交易的數據的背後"
    },
    {
      "end": 3775.92,
      "start": 3773.62,
      "text": "都是當初的冒險和非法操作"
    },
    {
      "end": 3778.74,
      "start": 3777.2,
      "text": "他已經不是沒總部"
    },
    {
      "end": 3780.02,
      "start": 3778.98,
      "text": "也不是說"
    },
    {
      "end": 3781.54,
      "start": 3780.26,
      "text": "這個這個沒有場地了"
    },
    {
      "end": 3782.82,
      "start": 3781.8,
      "text": "也不是沒公司了"
    },
    {
      "end": 3785.14,
      "start": 3783.08,
      "text": "他完全他是真真正正的詐騙"
    },
    {
      "end": 3786.66,
      "start": 3785.9,
      "text": "你想想啊"
    },
    {
      "end": 3787.7,
      "start": 3786.92,
      "text": "以下三個問題"
    },
    {
      "end": 3788.72,
      "start": 3787.94,
      "text": "你就給你的答案"
    },
    {
      "end": 3792.3,
      "start": 3789.22,
      "text": "他能參加王岐山布隆伯格的高峰會"
    },
    {
      "end": 3793.84,
      "start": 3793.32,
      "text": "誰安排的"
    },
    {
      "end": 3795.12,
      "start": 3794.34,
      "text": "王岐山安排"
    },
    {
      "end": 3797.42,
      "start": 3795.12,
      "text": "豬都能知道吧"
    },
    {
      "end": 3802.28,
      "start": 3799.72,
      "text": "而且目的就砸著洗壁"
    },
    {
      "end": 3803.06,
      "start": 3802.54,
      "text": "他砸著洗壁"
    },
    {
      "end": 3804.08,
      "start": 3803.06,
      "text": "他有啥鳥好處"
    },
    {
      "end": 3806.12,
      "start": 3804.6,
      "text": "咱洗壁跟他一點利益衝突都沒有"
    },
    {
      "end": 3808.94,
      "start": 3807.66,
      "text": "是共產黨跟咱有衝突"
    },
    {
      "end": 3810.48,
      "start": 3809.2,
      "text": "他替共產黨去幹那事去了"
    },
    {
      "end": 3811.24,
      "start": 3810.74,
      "text": "是吧"
    },
    {
      "end": 3812.78,
      "start": 3812.52,
      "text": "第二"
    },
    {
      "end": 3814.06,
      "start": 3813.04,
      "text": "他哪不藏身"
    },
    {
      "end": 3815.08,
      "start": 3814.32,
      "text": "就藏在一個"
    },
    {
      "end": 3816.36,
      "start": 3815.34,
      "text": "跟共產黨情報"
    },
    {
      "end": 3817.9,
      "start": 3816.36,
      "text": "緊密合作的迪拜"
    },
    {
      "end": 3822.76,
      "start": 3819.94,
      "text": "而且我們現在迪拜上也爭取我們的地方"
    },
    {
      "end": 3824.3,
      "start": 3823.02,
      "text": "而且他能在那兒待著"
    },
    {
      "end": 3826.08,
      "start": 3824.8,
      "text": "帶著上千個人"
    },
    {
      "end": 3826.6,
      "start": 3826.34,
      "text": "是吧"
    },
    {
      "end": 3827.36,
      "start": 3826.86,
      "text": "大量的錢"
    },
    {
      "end": 3828.64,
      "start": 3827.88,
      "text": "你想他要幹什麼"
    },
    {
      "end": 3829.92,
      "start": 3829.42,
      "text": "第三個"
    },
    {
      "end": 3833.26,
      "start": 3830.44,
      "text": "為什麼這麼多人資料被交給共產黨以後"
    },
    {
      "end": 3834.8,
      "start": 3833.52,
      "text": "像菲菲特人錢不給你"
    },
    {
      "end": 3838.12,
      "start": 3835.56,
      "text": "現在共產黨要是把他給滅了"
    },
    {
      "end": 3838.88,
      "start": 3838.38,
      "text": "就很簡單"
    },
    {
      "end": 3839.66,
      "start": 3839.14,
      "text": "趙晨彭你看"
    },
    {
      "end": 3840.42,
      "start": 3839.66,
      "text": "我完了"
    },
    {
      "end": 3841.7,
      "start": 3840.94,
      "text": "我公司垮了"
    },
    {
      "end": 3844.26,
      "start": 3842.48,
      "text": "我的資料我啥也沒了"
    },
    {
      "end": 3845.04,
      "start": 3844.52,
      "text": "我破產了"
    },
    {
      "end": 3845.8,
