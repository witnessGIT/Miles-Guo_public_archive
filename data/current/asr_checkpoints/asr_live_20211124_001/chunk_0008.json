{
  "chunk_audio_sha256": "d3f794b8eb41299592938b65d4092ee6bcb642f58f117e42ecc231aa4b87d72d",
  "chunk_index": 8,
  "completed_at": "2026-10-21T09:36:04Z",
  "language": "zh",
  "live_id": "LIVE_20211124_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 7200,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 7203.32,
      "start": 7200.0,
      "text": "德国人挺没求出息的你知道吗"
    },
    {
      "end": 7204.48,
      "start": 7203.32,
      "text": "非常没出息"
    },
    {
      "end": 7206.46,
      "start": 7204.48,
      "text": "德国人是很让人看不起的人"
    },
    {
      "end": 7209.68,
      "start": 7206.46,
      "text": "就那宝马总裁宝马主席逮住好酒使劲喝"
    },
    {
      "end": 7211.3,
      "start": 7209.68,
      "text": "逮住姑娘使劲抱"
    },
    {
      "end": 7214.5,
      "start": 7211.3,
      "text": "然后还装着一副德性很正直"
    },
    {
      "end": 7215.58,
      "start": 7214.5,
      "text": "绝不是你想想那样"
    },
    {
      "end": 7218.38,
      "start": 7215.58,
      "text": "上海女孩嫁给德国人的没几个好下场"
    },
    {
      "end": 7220.78,
      "start": 7218.38,
      "text": "上海有个女孩写了个叫什么"
    },
    {
      "end": 7222.38,
      "start": 7220.78,
      "text": "上海宝贝"
    },
    {
      "end": 7225.38,
      "start": 7222.38,
      "text": "阐述和上海一个德国男孩"
    },
    {
      "end": 7227.58,
      "start": 7225.38,
      "text": "如此连续做爱两三天"
    },
    {
      "end": 7230.6,
      "start": 7227.58,
      "text": "发现他略做爱发现身上那些金色的毛"
    },
    {
      "end": 7233.42,
      "start": 7230.6,
      "text": "他从来没说我德国人是不洗脚不洗澡"
    },
    {
      "end": 7235.84,
      "start": 7233.42,
      "text": "喷香水臭气熏天"
    },
    {
      "end": 7237.68,
      "start": 7235.84,
      "text": "而且贪婪自己"
    },
    {
      "end": 7238.46,
      "start": 7237.68,
      "text": "我跟你说"
    },
    {
      "end": 7240.96,
      "start": 7238.46,
      "text": "我过去对这个民族极为的尊敬"
    },
    {
      "end": 7243.66,
      "start": 7240.96,
      "text": "我到了这个二战所有希特勒家"
    },
    {
      "end": 7245.76,
      "start": 7243.66,
      "text": "所有希特勒家建筑所有全干亡"
    },
    {
      "end": 7248.1,
      "start": 7245.76,
      "text": "包括他的御用建筑师"
    },
    {
      "end": 7249.54,
      "start": 7248.1,
      "text": "你都知道那是我的好朋友"
    },
    {
      "end": 7250.48,
      "start": 7249.54,
      "text": "我看完以后"
    },
    {
      "end": 7253.02,
      "start": 7250.48,
      "text": "还有跟德国宝马奔驰打完交道"
    },
    {
      "end": 7254.1,
      "start": 7253.02,
      "text": "我说滚得远远的"
    },
    {
      "end": 7255.08,
      "start": 7254.1,
      "text": "滚得远远的"
    },
    {
      "end": 7255.96,
      "start": 7255.08,
      "text": "大家都不想打理他"
    },
    {
      "end": 7258.64,
      "start": 7255.96,
      "text": "没有人不贪钱的"
    },
    {
      "end": 7260.18,
      "start": 7258.64,
      "text": "没有人不贪婪的"
    },
    {
      "end": 7262.04,
      "start": 7260.18,
      "text": "还极为自私和小气"
    },
    {
      "end": 7264.06,
      "start": 7262.04,
      "text": "所以他们的总理来"
    },
    {
      "end": 7264.46,
      "start": 7264.06,
      "text": "什么的"
    },
    {
      "end": 7265.3,
      "start": 7264.46,
      "text": "前任的人来"
    },
    {
      "end": 7265.82,
      "start": 7265.3,
      "text": "到我这来"
    },
    {
      "end": 7266.72,
      "start": 7265.82,
      "text": "我一个不接待"
    },
    {
      "end": 7268.26,
      "start": 7266.72,
      "text": "希特勒就这么牛"
    },
    {
      "end": 7271.88,
      "start": 7268.26,
      "text": "我在盘古看到的股市当中"
    },
    {
      "end": 7273.36,
      "start": 7271.88,
      "text": "当时中国股市就着"
    },
    {
      "end": 7275.1,
      "start": 7273.36,
      "text": "不管是中国人还有德国人"
    },
    {
      "end": 7278.22,
      "start": 7275.1,
      "text": "我在德国人炒中国股市"
    },
    {
      "end": 7279.64,
      "start": 7278.22,
      "text": "我说你们这是什么情况"
    },
    {
      "end": 7283.64,
      "start": 7279.64,
      "text": "宝马的奔驰的代理商没有不炒的"
    },
    {
      "end": 7285.86,
      "start": 7283.64,
      "text": "而且特别上海大众的"
    },
    {
      "end": 7287.26,
      "start": 7285.96,
      "text": "那些德国人都炒"
    },
    {
      "end": 7290.18,
      "start": 7287.26,
      "text": "都是穷家当产"
    },
    {
      "end": 7293.94,
      "start": 7290.18,
      "text": "所以共产党的赌局"
    },
    {
      "end": 7295.62,
      "start": 7293.94,
      "text": "你要看到"
    },
    {
      "end": 7298.14,
      "start": 7295.62,
      "text": "从共产党的赌局的股市"
    },
    {
      "end": 7299.64,
      "start": 7298.14,
      "text": "看到包括卡利西"
    },
    {
      "end": 7300.56,
      "start": 7299.64,
      "text": "不知道有多少"
    },
    {
      "end": 7301.78,
      "start": 7300.56,
      "text": "把心酸的内人给分享"
    },
    {
      "end": 7303.86,
      "start": 7301.78,
      "text": "兄弟姐妹们"
    },
    {
      "end": 7305.78,
      "start": 7303.86,
      "text": "我们今天看到这个的时候"
    },
    {
      "end": 7307.7,
      "start": 7305.78,
      "text": "要知道共产党的本质的时候"
    },
    {
      "end": 7311.22,
      "start": 7307.7,
      "text": "我们中国人是世界上最可悲"
    },
    {
      "end": 7312.06,
      "start": 7311.22,
      "text": "最可恨"
    },
    {
      "end": 7313.28,
      "start": 7312.06,
      "text": "最无知的民族"
    },
    {
      "end": 7317.5,
      "start": 7313.28,
      "text": "我非常同意国内的有些人说的话"
    },
    {
      "end": 7319.34,
      "start": 7317.5,
      "text": "我们中国这一代人"
    },
    {
      "end": 7320.62,
      "start": 7319.34,
      "text": "过去五十年"
    },
    {
      "end": 7322.66,
      "start": 7320.62,
      "text": "或者过去一百年"
    },
    {
      "end": 7323.5,
      "start": 7322.66,
      "text": "和到现在"
    },
    {
      "end": 7324.18,
      "start": 7323.5,
      "text": "包括我们"
    },
    {
      "end": 7326.44,
      "start": 7324.18,
      "text": "我们未来的人类"
    },
    {
      "end": 7328.96,
      "start": 7326.44,
      "text": "可能对我们这几代人要大审判"
    },
    {
      "end": 7330.94,
      "start": 7328.96,
      "text": "无知"
    },
    {
      "end": 7331.68,
      "start": 7330.94,
      "text": "贪婪"
    },
    {
      "end": 7332.58,
      "start": 7331.68,
      "text": "无信仰"
    },
    {
      "end": 7334.08,
      "start": 7332.58,
      "text": "没人性"
    },
    {
      "end": 7336.66,
      "start": 7334.08,
      "text": "最可怕的"
    },
    {
      "end": 7337.36,
      "start": 7336.66,
      "text": "无知到了"
    },
    {
      "end": 7337.86,
      "start": 7337.36,
      "text": "贪婪"
    },
    {
      "end": 7339.84,
      "start": 7337.86,
      "text": "到了你无法想象的程度"
    },
    {
      "end": 7341.6,
      "start": 7339.84,
      "text": "对地球之毁害"
    },
    {
      "end": 7343.56,
      "start": 7341.6,
      "text": "对人类之伤害"
    },
    {
      "end": 7345.96,
      "start": 7343.56,
      "text": "对宗教信仰之打击"
    },
    {
      "end": 7349.52,
      "start": 7345.96,
      "text": "对全人类的整个文明进步之影响"
    },
    {
      "end": 7353.42,
      "start": 7349.52,
      "text": "你看看国内一个袁鹏飞"
    },
    {
      "end": 7354.78,
      "start": 7353.42,
      "text": "这样的一个中文老师"
    },
    {
      "end": 7356.28,
      "start": 7354.78,
      "text": "他都没有资格活下去"
    },
    {
      "end": 7357.44,
      "start": 7356.28,
      "text": "一个吹永元"
    },
    {
      "end": 7358.28,
      "start": 7357.44,
      "text": "他都容不下"
    },
    {
      "end": 7361.76,
      "start": 7358.28,
      "text": "你连一个彭帅这样的女孩"
    },
    {
      "end": 7363.04,
      "start": 7361.76,
      "text": "都被搞了十八年"
    },
    {
      "end": 7364.42,
      "start": 7363.04,
      "text": "宇宙无限大"
    },
    {
      "end": 7365.4,
      "start": 7364.42,
      "text": "地球是一面沙"
    },
    {
      "end": 7368.8,
      "start": 7365.4,
      "text": "你想想一个郭晶晶"
    },
    {
      "end": 7369.46,
      "start": 7368.8,
      "text": "傅明侠"
    },
    {
      "end": 7370.66,
      "start": 7369.46,
      "text": "十一岁都在闭嘴"
    },
    {
      "end": 7372.1,
      "start": 7370.66,
      "text": "去群居去了"
    },
    {
      "end": 7374.32,
      "start": 7372.1,
      "text": "这样的国家和民族"
    },
    {
      "end": 7376.2,
      "start": 7374.32,
      "text": "我们怎么面对我们的未来"
    },
    {
      "end": 7380.12,
      "start": 7376.2,
      "text": "现在冠状病毒是来自中共"
    },
    {
      "end": 7381.08,
      "start": 7380.12,
      "text": "没人敢说"
    },
    {
      "end": 7381.8,
      "start": 7381.08,
      "text": "没人敢问"
    },
    {
      "end": 7383.54,
      "start": 7381.8,
      "text": "你谈刚才疫苗"
    },
    {
      "end": 7386.6,
      "start": 7383.54,
      "text": "为啥没人问疫苗哪来的"
    },
    {
      "end": 7388.7,
      "start": 7386.6,
      "text": "那个冠状病毒怎么来的"
    },
    {
      "end": 7389.84,
      "start": 7388.7,
      "text": "你怎么有的疫苗"
    },
    {
      "end": 7391.12,
      "start": 7389.84,
      "text": "它疫苗的研发"
    },
    {
      "end": 7392.26,
      "start": 7391.12,
      "text": "最起码信息"
    },
    {
      "end": 7392.92,
      "start": 7392.26,
      "text": "你可以公开"
    },
    {
      "end": 7394.18,
      "start": 7392.92,
      "text": "竟然不让公开"
    },
    {
      "end": 7395.64,
      "start": 7394.18,
      "text": "要五十年以后再公开"
    },
    {
      "end": 7396.18,
      "start": 7395.64,
      "text": "你见了"
    },
    {
      "end": 7397.88,
      "start": 7396.18,
      "text": "有什么见不得鬼"
    },
    {
      "end": 7400.52,
      "start": 7397.88,
      "text": "就共产党对人类之伤害"
    },
    {
      "end": 7402.32,
      "start": 7400.52,
      "text": "对人类伤害之深"
    },
    {
      "end": 7404.02,
      "start": 7402.32,
      "text": "比中国的空气污染"
    },
    {
      "end": 7406.1,
      "start": 7404.02,
      "text": "土地污染水污染"
    },
    {
      "end": 7407.94,
      "start": 7406.1,
      "text": "还要严重的多的多"
    },
    {
      "end": 7411.22,
      "start": 7407.94,
      "text": "中国人要为此付出的代价"
    },
    {
      "end": 7414.36,
      "start": 7411.22,
      "text": "绝不是你今天我在屏幕上能说的话"
    },
    {
      "end": 7416.66,
      "start": 7414.36,
      "text": "我想想心都疼"
    },
    {
      "end": 7417.36,
      "start": 7416.66,
      "text": "肝都疼"
    },
    {
      "end": 7419.72,
      "start": 7417.36,
      "text": "就是我现在就是看到"
    },
    {
      "end": 7422.64,
      "start": 7419.72,
      "text": "就是人家怎么不会歧视我们华人呢"
    },
    {
      "end": 7425.48,
      "start": 7422.64,
      "text": "怎么会不歧视我们呢"
    },
    {
      "end": 7427.4,
      "start": 7425.48,
      "text": "共产党给我们造的孽"
    },
    {
      "end": 7428.86,
      "start": 7427.4,
      "text": "我们把共产党给我们分开了"
    },
    {
      "end": 7431.12,
      "start": 7428.86,
      "text": "但真的就能彻底分开吗"
    },
    {
      "end": 7434.32,
      "start": 7431.12,
      "text": "你看看他怎么对待同胞的"
    },
    {
      "end": 7436.2,
      "start": 7434.32,
      "text": "你看他怎么对待像马云"
    },
    {
      "end": 7438.44,
      "start": 7436.2,
      "text": "我绝对我恨马云这个小子"
    },
    {
      "end": 7441.32,
      "start": 7438.44,
      "text": "所有的这些资本家我都恨过来勾兑的"
    },
    {
      "end": 7442.72,
      "start": 7441.32,
      "text": "但是从个人上说"
    },
    {
      "end": 7444.22,
      "start": 7442.72,
      "text": "他们有选择吗"
    },
    {
      "end": 7446.52,
      "start": 7444.22,
      "text": "话又说过来了"
    },
    {
      "end": 7448.2,
      "start": 7446.52,
      "text": "从本人来讲"
    },
    {
      "end": 7450.14,
      "start": 7448.2,
      "text": "马云不是恶人"
    },
    {
      "end": 7452.56,
      "start": 7450.14,
      "text": "柳传志也不是恶人"
    },
    {
      "end": 7454.08,
      "start": 7452.56,
      "text": "这些人我这都是"
    },
    {
      "end": 7456.74,
      "start": 7454.08,
      "text": "我都是亲身经历我才有话说"
    },
    {
      "end": 7458.58,
      "start": 7456.74,
      "text": "马化腾也不是恶人"
    },
    {
      "end": 7460.06,
      "start": 7458.58,
      "text": "徐家印也不是恶人"
    },
    {
      "end": 7461.64,
      "start": 7460.06,
      "text": "是不是"
    },
    {
      "end": 7464.88,
      "start": 7461.64,
      "text": "但是他必须要成为最坏的那个人"
    },
    {
      "end": 7466.22,
      "start": 7464.88,
      "text": "是社会"
    },
    {
      "end": 7469.42,
      "start": 7466.22,
      "text": "不是掠币驱诸良币"
    },
    {
      "end": 7472.42,
      "start": 7469.42,
      "text": "是掠币把良币要变成"
    },
    {
      "end": 7474.72,
      "start": 7472.42,
      "text": "掠币"
    },
    {
      "end": 7476.6,
      "start": 7474.72,
      "text": "他太可悲了"
    },
    {
      "end": 7478.86,
      "start": 7476.6,
      "text": "你把掠币好人"
    },
    {
      "end": 7480.76,
      "start": 7478.86,
      "text": "管坏人管好人"
    },
    {
      "end": 7483.98,
      "start": 7480.76,
      "text": "坏人统治好人"
    },
    {
      "end": 7484.66,
      "start": 7483.98,
      "text": "行"
    },
    {
      "end": 7485.66,
      "start": 7484.66,
      "text": "你剥削我行"
    },
    {
      "end": 7487.34,
      "start": 7485.66,
      "text": "关键是坏人要把好人"
    },
    {
      "end": 7490.5,
      "start": 7487.34,
      "text": "要变成比他更恶的人"
    },
    {
      "end": 7491.86,
      "start": 7490.5,
      "text": "整个社会都是这样的"
    },
    {
      "end": 7493.34,
      "start": 7491.86,
      "text": "然后搞出一股票市场"
    },
    {
      "end": 7494.66,
      "start": 7493.34,
      "text": "太大爷来的"
    },
    {
      "end": 7495.26,
      "start": 7494.66,
      "text": "我告诉你"
    },
    {
      "end": 7497.06,
      "start": 7495.26,
      "text": "你看看只有七个敢说"
    },
    {
      "end": 7498.02,
      "start": 7497.06,
      "text": "告诉美国人"
    },
    {
      "end": 7500.82,
      "start": 7498.02,
      "text": "我这个恒大可以转换票据"
    },
    {
      "end": 7501.9,
      "start": 7500.82,
      "text": "不破产"
    },
    {
      "end": 7502.9,
      "start": 7501.9,
      "text": "我融创不破产"
    },
    {
      "end": 7504.2,
      "start": 7502.9,
      "text": "复利不破产"
    },
    {
      "end": 7505.58,
      "start": 7504.2,
      "text": "然后你答应我奥运会"
    },
    {
      "end": 7507.8,
      "start": 7505.58,
      "text": "你看他老子开门奥运会就给你破产"
    },
    {
      "end": 7509.14,
      "start": 7507.8,
      "text": "他一定玩这一局"
    },
    {
      "end": 7511.24,
      "start": 7510.14,
      "text": "所以美国人问我说"
    },
    {
      "end": 7513.14,
      "start": 7511.24,
      "text": "我说你们美国人长点脑子行不行"
    },
    {
      "end": 7514.52,
      "start": 7513.14,
      "text": "奥运会钱不破产"
    },
    {
      "end": 7515.4,
      "start": 7514.52,
      "text": "我换票去"
    },
    {
      "end": 7517.4,
      "start": 7515.4,
      "text": "你钱哪来的"
    },
    {
      "end": 7521.3,
      "start": 7517.4,
      "text": "一个高盛的高管竟然问我这种愚蠢的话"
    },
    {
      "end": 7523.34,
      "start": 7521.3,
      "text": "他说你觉得Miles这不是很好的交易吗"
    },
    {
      "end": 7524.74,
      "start": 7523.34,
      "text": "我们可以拨"
    },
    {
      "end": 7525.6,
      "start": 7524.74,
      "text": "股票不破产"
    },
    {
      "end": 7526.94,
      "start": 7525.6,
      "text": "哇塞他大爷来的"
    },
    {
      "end": 7528.54,
      "start": 7526.94,
      "text": "我简直气的我"
    },
    {
      "end": 7531.42,
      "start": 7528.54,
      "text": "所以我看到这些愚蠢的住的时候"
    },
    {
      "end": 7533.3,
      "start": 7531.42,
      "text": "我就发现我们太伟大了"
    },
    {
      "end": 7535.76,
      "start": 7533.3,
      "text": "我不是要亲我自己的定"
    },
    {
      "end": 7537.56,
      "start": 7535.76,
      "text": "我真的要亲我自己的定一万次"
    },
    {
      "end": 7540.36,
      "start": 7537.56,
      "text": "你们每个人都可以每天请你们定一一次"
    },
    {
      "end": 7542.1,
      "start": 7540.36,
      "text": "因为咱们太干净了"
    },
    {
      "end": 7543.56,
      "start": 7542.1,
      "text": "他这种事他也敢相信"
    },
    {
      "end": 7547.38,
      "start": 7543.56,
      "text": "共产党是让我融创我恒大"
    },
    {
      "end": 7549.22,
      "start": 7547.38,
      "text": "你为啥能控制他不破产"
    },
    {
      "end": 7551.14,
      "start": 7549.22,
      "text": "说明这是你控制的结果"
    },
    {
      "end": 7553.52,
      "start": 7551.14,
      "text": "你是经济超限战的结果"
    },
    {
      "end": 7555.6,
      "start": 7553.52,
      "text": "你能控制他什么时候死"
    },
    {
      "end": 7557.18,
      "start": 7555.6,
      "text": "就说明你绝对了他的生死"
    },
    {
      "end": 7558.5,
      "start": 7557.18,
      "text": "这还有什么事"
    },
    {
      "end": 7560.64,
      "start": 7558.5,
      "text": "自由市场经济资产"
    },
    {
      "end": 7561.86,
      "start": 7560.64,
      "text": "这么起码的逻辑"
    },
    {
      "end": 7564.76,
      "start": 7561.86,
      "text": "这帮王八蛋就被这个金钱摊得迷糊了双眼"
    },
    {
      "end": 7566.24,
      "start": 7564.76,
      "text": "更夸张的事情"
    },
    {
      "end": 7568.18,
      "start": 7566.24,
      "text": "现在奥运会你去参加了"
    },
    {
      "end": 7569.5,
      "start": 7568.18,
      "text": "他说我不让我推迟"
    },
    {
      "end": 7571.24,
      "start": 7569.5,
      "text": "我用金融票去"
    },
    {
      "end": 7572.58,
      "start": 7571.24,
      "text": "最后谁给钱呢"
    },
    {
      "end": 7574.38,
      "start": 7572.58,
      "text": "奥运会看完第二天"
    },
    {
      "end": 7576.5,
      "start": 7574.38,
      "text": "徐家庭就已经宣布破产了"
    },
    {
      "end": 7576.76,
      "start": 7576.5,
      "text": "是吧"
    },
    {
      "end": 7577.88,
      "start": 7576.76,
      "text": "融创福利"
    },
    {
      "end": 7579.1,
      "start": 7577.88,
      "text": "而且给你多加几家"
    },
    {
      "end": 7580.08,
      "start": 7579.1,
      "text": "合成创产"
    },
    {
      "end": 7581.32,
      "start": 7580.08,
      "text": "是吧"
    },
    {
      "end": 7582.06,
      "start": 7581.32,
      "text": "都给你来上"
    },
    {
      "end": 7582.76,
      "start": 7582.06,
      "text": "万达"
    },
    {
      "end": 7586.24,
      "start": 7582.76,
      "text": "这个世界就黑暗到什么程度了"
    },
    {
      "end": 7586.9,
      "start": 7586.24,
      "text": "兄弟姐妹们"
    },
    {
      "end": 7588.5,
      "start": 7586.9,
      "text": "说这话在美国"
    },
    {
      "end": 7589.68,
      "start": 7588.5,
      "text": "华尔街都敢有人信"
    },
    {
      "end": 7591.14,
      "start": 7589.68,
      "text": "你觉得美国的金融市场"
    },
    {
      "end": 7591.94,
      "start": 7591.14,
      "text": "你敢相信吗"
    },
    {
      "end": 7595.86,
      "start": 7591.94,
      "text": "美国在中国投了将近五万亿官方"
    },
    {
      "end": 7597.06,
      "start": 7595.86,
      "text": "实际上七万亿"
    },
    {
      "end": 7599.32,
      "start": 7597.06,
      "text": "甚至达到十万亿的票据"
    },
    {
      "end": 7602.78,
      "start": 7599.32,
      "text": "你觉得这金融市场能撑下去吗"
    },
    {
      "end": 7605.12,
      "start": 7602.78,
      "text": "他自己那玩都玩不了"
    },
    {
      "end": 7607.1,
      "start": 7605.12,
      "text": "自己做自己装"
    },
    {
      "end": 7608.28,
      "start": 7607.1,
      "text": "是吧"
    },
    {
      "end": 7610.26,
      "start": 7608.28,
      "text": "大卫兄弟拿撒扑克给飞飞玩"
    },
    {
      "end": 7611.88,
      "start": 7610.26,
      "text": "玩玩自己一个扑克没了"
    },
    {
      "end": 7612.8,
      "start": 7611.88,
      "text": "你咋玩啊"
    },
    {
      "end": 7614.06,
      "start": 7612.8,
      "text": "他忽悠不下去了"
    },
    {
      "end": 7615.42,
      "start": 7614.06,
      "text": "他咋能忽悠咋呢"
    },
    {
      "end": 7616.46,
      "start": 7615.42,
      "text": "他忽悠不了了"
    },
    {
      "end": 7617.66,
      "start": 7616.46,
      "text": "我告诉大卫兄弟"
    },
    {
      "end": 7618.48,
      "start": 7617.66,
      "text": "咱俩玩扑克牌"
    },
    {
      "end": 7619.66,
      "start": 7618.48,
      "text": "一伸手一个牌"
    },
    {
      "end": 7621.92,
      "start": 7619.66,
      "text": "七哥你再给我拿一张牌出来"
    },
    {
      "end": 7623.14,
      "start": 7621.92,
      "text": "他拿不出来了"
    },
    {
      "end": 7623.94,
      "start": 7623.14,
      "text": "就这他也说"
    },
    {
      "end": 7624.74,
      "start": 7623.94,
      "text": "那你玩吧"
    },
    {
      "end": 7627.9,
      "start": 7624.74,
      "text": "世界之黑暗"
    },
    {
      "end": 7631.5,
      "start": 7627.9,
      "text": "是人们已经因为这个七十年的和平"
    },
    {
      "end": 7633.68,
      "start": 7631.5,
      "text": "和共产党的邪恶的力量"
    },
    {
      "end": 7635.74,
      "start": 7633.68,
      "text": "和整个媒体的控制"
    },
    {
      "end": 7637.22,
      "start": 7635.74,
      "text": "整个的洗脑"
    },
    {
      "end": 7638.88,
      "start": 7637.22,
      "text": "和经济上的垄断"
    },
    {
      "end": 7640.28,
      "start": 7638.88,
      "text": "把人类变成了"
    },
    {
      "end": 7641.98,
      "start": 7640.28,
      "text": "真的是一个大地狱一样"
    },
    {
      "end": 7646.72,
      "start": 7641.98,
      "text": "必须要有一个人类的大猩猩"
    },
    {
      "end": 7648.4,
      "start": 7646.72,
      "text": "人类不到大猩猩"
    },
    {
      "end": 7649.82,
      "start": 7648.4,
      "text": "太可怕了"
    },
    {
      "end": 7651.84,
      "start": 7649.82,
      "text": "我说的话都是不用听我的"
    },
    {
      "end": 7653.34,
      "start": 7651.84,
      "text": "你自己排一排"
    },
    {
      "end": 7654.56,
      "start": 7653.34,
      "text": "看一看是不是"
    },
    {
      "end": 7656.94,
      "start": 7654.56,
      "text": "现在很多买的房子"
    },
    {
      "end": 7659.0,
      "start": 7656.94,
      "text": "未来就这疫苗灾难以后"
    },
    {
      "end": 7660.62,
      "start": 7659.0,
      "text": "真的是有房子没人住"
    },
    {
      "end": 7662.08,
      "start": 7660.62,
      "text": "不是你买不买房子"
    },
    {
      "end": 7664.14,
      "start": 7662.08,
      "text": "是房子谁给你家电"
    },
    {
      "end": 7664.9,
      "start": 7664.14,
      "text": "谁给你家水"
    },
    {
      "end": 7666.28,
      "start": 7664.9,
      "text": "这么用"
    },
    {
      "end": 7668.34,
      "start": 7666.28,
      "text": "大卫兄弟你来说说"
    },
    {
      "end": 7669.02,
      "start": 7668.34,
      "text": "谢谢"
    },
    {
      "end": 7671.56,
      "start": 7669.02,
      "text": "我看得很着急"
    },
    {
      "end": 7675.28,
      "start": 7671.56,
      "text": "没有一点都没着急"
    },
    {
      "end": 7675.56,
      "start": 7675.28,
      "text": "七哥"
    },
    {
      "end": 7677.28,
      "start": 7675.56,
      "text": "这是我回应一下"
    },
    {
      "end": 7678.5,
      "start": 7677.28,
      "text": "我刚才说的"
    },
    {
      "end": 7681.58,
      "start": 7678.5,
      "text": "我觉得这场灾难"
    },
    {
      "end": 7682.74,
      "start": 7681.58,
      "text": "到今天"
    },
    {
      "end": 7684.14,
      "start": 7682.74,
      "text": "你看咱们从供应链"
    },
    {
      "end": 7686.3,
      "start": 7684.14,
      "text": "还有资本市场"
    },
    {
      "end": 7687.48,
      "start": 7686.3,
      "text": "都能看到"
    },
    {
      "end": 7689.12,
      "start": 7687.48,
      "text": "刚才七哥说的北交所"
    },
    {
      "end": 7689.9,
      "start": 7689.12,
      "text": "我先把北交所"
    },
    {
      "end": 7690.72,
      "start": 7689.9,
      "text": "这我补充一下"
    },
    {
      "end": 7693.58,
      "start": 7690.72,
      "text": "北交所共产党选了81个股票"
    },
    {
      "end": 7695.14,
      "start": 7693.58,
      "text": "所谓的身体好的"
    },
    {
      "end": 7696.98,
      "start": 7695.14,
      "text": "81个股票里边"
    },
    {
      "end": 7698.18,
      "start": 7696.98,
      "text": "大家看有个什么奇怪"
    },
    {
      "end": 7700.18,
      "start": 7698.18,
      "text": "大家看 71个股票里边"
    },
    {
      "end": 7703.22,
      "start": 7700.18,
      "text": "传统的所谓的优质股都跌"
    },
    {
      "end": 7704.72,
      "start": 7703.22,
      "text": "然后10个涨的是啥呢"
    },
    {
      "end": 7707.46,
      "start": 7704.72,
      "text": "是那个所谓的一些新鲜概念股"
    },
    {
      "end": 7711.38,
      "start": 7707.46,
      "text": "也就是北交所在六中全会这么大的政治背景下"
    },
    {
      "end": 7712.56,
      "start": 7711.38,
      "text": "这么牛的"
    },
    {
      "end": 7714.16,
      "start": 7712.56,
      "text": "这么共产党站台的"
    },
    {
      "end": 7717.1,
      "start": 7714.16,
      "text": "竟然靠10个讲故事编故事的股票"
    },
    {
      "end": 7719.2,
      "start": 7717.1,
      "text": "来在市场里拉台"
    },
    {
      "end": 7721.2,
      "start": 7719.2,
      "text": "那不就是来圈韭菜"
    },
    {
      "end": 7724.02,
      "start": 7721.2,
      "text": "让这个土通的投资者进场吗"
    },
    {
      "end": 7725.26,
      "start": 7724.02,
      "text": "而且刚才七哥也讲了"
    },
    {
      "end": 7727.26,
      "start": 7725.26,
      "text": "美国20万亿的体量的市值"
    },
    {
      "end": 7730.3,
      "start": 7727.26,
      "text": "大家看一下这个我刚才说到的这个美债收益率"
    },
    {
      "end": 7731.8,
      "start": 7730.3,
      "text": "美债收益率最近的变化"
    },
    {
      "end": 7733.8,
      "start": 7731.8,
      "text": "还有今天就在咱们直播此时此刻"
    },
    {
      "end": 7734.8,
      "start": 7733.8,
      "text": "因为我这个窗口嘛"
    },
    {
      "end": 7736.3,
      "start": 7734.8,
      "text": "我这可以看到黄金的变化了"
    },
    {
      "end": 7738.0,
      "start": 7736.3,
      "text": "黄金的变化"
    },
    {
      "end": 7739.26,
      "start": 7738.0,
      "text": "数字货币的变化"
    },
    {
      "end": 7740.26,
      "start": 7739.26,
      "text": "因为我没法分享屏幕"
    },
    {
      "end": 7741.3,
      "start": 7740.26,
      "text": "我不知道导播那端"
    },
    {
      "end": 7742.9,
      "start": 7741.3,
      "text": "我想说什么呢"
    },
    {
      "end": 7745.84,
      "start": 7742.9,
      "text": "这个市场上现在已经到了非常脆弱的时候"
    },
    {
      "end": 7747.26,
      "start": 7745.84,
      "text": "美国尚且如此"
    },
    {
      "end": 7750.34,
      "start": 7747.26,
      "text": "否则拜登政府为什么会要释放原油储备呢"
    },
    {
      "end": 7753.4,
      "start": 7750.34,
      "text": "他都这个这个巧妇难为五米之吹了"
    },
    {
      "end": 7756.3,
      "start": 7753.4,
      "text": "然后共产党这个时候去搞金融超限战"
    },
    {
      "end": 7759.84,
      "start": 7756.3,
      "text": "再看一看昨天我跟七哥在那个我们天伙团的群里"
    },
    {
      "end": 7762.5,
      "start": 7759.84,
      "text": "那个DWAC股票对吧七哥"
    },
    {
      "end": 7763.26,
      "start": 7762.5,
      "text": "他玩假"
    },
    {
      "end": 7765.0,
      "start": 7763.26,
      "text": "你看那股票走成什么样了"
    },
    {
      "end": 7766.1,
      "start": 7765.0,
      "text": "刚刚有一个反弹"
    },
    {
      "end": 7767.1,
      "start": 7766.1,
      "text": "但是我可以告诉这两个人"
    },
    {
      "end": 7769.64,
      "start": 7767.1,
      "text": "人家这个已经开启调查了"
    },
    {
      "end": 7770.04,
      "start": 7769.64,
      "text": "对"
    },
    {
      "end": 7772.8,
      "start": 7770.04,
      "text": "把SEC发起这个倡议调查了"
    },
    {
      "end": 7775.34,
      "start": 7772.8,
      "text": "你说调查结果出来会是什么呀"
    },
    {
      "end": 7778.54,
      "start": 7775.34,
      "text": "这不就证实了之前跟川普总统合作"
    },
    {
      "end": 7779.54,
      "start": 7778.54,
      "text": "吴征对吧"
    },
    {
      "end": 7782.14,
      "start": 7779.54,
      "text": "共产党这些特务们造假"
    },
    {
      "end": 7785.48,
      "start": 7782.14,
      "text": "玩金融是不是玩虚假这个宣传"
    },
    {
      "end": 7787.54,
      "start": 7785.48,
      "text": "在美国SEC体制下"
    },
    {
      "end": 7789.9,
      "start": 7787.54,
      "text": "这个法律框架下你这么玩"
    },
    {
      "end": 7790.74,
      "start": 7789.9,
      "text": "所以说我想说什么"
    },
    {
      "end": 7792.04,
      "start": 7790.74,
      "text": "就是北交所"
    },
    {
      "end": 7793.8,
      "start": 7792.04,
      "text": "会成为一个闹剧"
    },
    {
      "end": 7794.58,
      "start": 7793.8,
      "text": "一个丑闻"
    },
    {
      "end": 7795.44,
      "start": 7794.58,
      "text": "一个笑法"
    },
    {
      "end": 7798.48,
      "start": 7795.44,
      "text": "因为今天中国最大的问题就是"
    },
    {
      "end": 7801.24,
      "start": 7798.48,
      "text": "你没有真正的自主的这些科技产业"
    },
    {
      "end": 7803.12,
      "start": 7801.24,
      "text": "你没有自己可以拿的出来"
    },
    {
      "end": 7805.86,
      "start": 7803.12,
      "text": "可以真正展现给世界的你的好的价值"
    },
    {
      "end": 7806.72,
      "start": 7805.86,
      "text": "战略资产"
    },
    {
      "end": 7808.14,
      "start": 7806.72,
      "text": "你比如像那个台积电的芯片"
    },
    {
      "end": 7809.98,
      "start": 7808.14,
      "text": "美国的这些芯片没有"
    },
    {
      "end": 7811.98,
      "start": 7809.98,
      "text": "所以就看美国市场"
    },
    {
      "end": 7814.68,
      "start": 7811.98,
      "text": "上一周除了芯片板块"
    },
    {
      "end": 7816.48,
      "start": 7814.68,
      "text": "有一个小的涨幅以外"
    },
    {
      "end": 7817.42,
      "start": 7816.48,
      "text": "从大盘"
    },
    {
      "end": 7818.98,
      "start": 7817.42,
      "text": "从整个其他产业"
    },
    {
      "end": 7819.38,
      "start": 7818.98,
      "text": "你看看"
    },
    {
      "end": 7821.08,
      "start": 7819.38,
      "text": "基本上都是在跌"
    },
    {
      "end": 7823.84,
      "start": 7821.08,
      "text": "为什么市场进入到一个恐慌期了"
    },
    {
      "end": 7826.12,
      "start": 7823.84,
      "text": "美联储这边也要表态了"
    },
    {
      "end": 7828.08,
      "start": 7826.12,
      "text": "开始进入缩表期了"
    },
    {
      "end": 7829.62,
      "start": 7828.08,
      "text": "所以说我就想总结一句"
    },
    {
      "end": 7831.62,
      "start": 7829.62,
      "text": "共产党在世界经济最脆弱的时候"
    },
    {
      "end": 7833.42,
      "start": 7831.62,
      "text": "玩假必然会死无葬身之地"
    },
    {
      "end": 7834.68,
      "start": 7833.42,
      "text": "因为他自己没有"
    },
    {
      "end": 7835.18,
      "start": 7834.68,
      "text": "就像七个说的"
    },
    {
      "end": 7836.48,
      "start": 7835.18,
      "text": "没有其他牌了"
    },
    {
      "end": 7838.0,
      "start": 7836.48,
      "text": "压不过你也压不出来了"
    },
    {
      "end": 7841.08,
      "start": 7838.0,
      "text": "那么你拿出那个北交所的几个"
    },
    {
      "end": 7843.56,
      "start": 7841.08,
      "text": "这个所谓的头牌小姐倒上去"
    },
    {
      "end": 7844.98,
      "start": 7843.56,
      "text": "你也演不下去这个大戏"
    },
    {
      "end": 7845.92,
      "start": 7844.98,
      "text": "共产党真的完了"
    },
    {
      "end": 7846.74,
      "start": 7845.92,
      "text": "所以战友们"
    },
    {
      "end": 7847.74,
      "start": 7846.74,
      "text": "我们看的是什么"
    },
    {
      "end": 7848.36,
      "start": 7847.74,
      "text": "不是看热闹"
    },
    {
      "end": 7852.82,
      "start": 7848.36,
      "text": "我们是看你的钱你的命怎么赶紧在这个背景下去逃离"
    },
    {
      "end": 7854.48,
      "start": 7852.82,
      "text": "来到新中国联邦"
    },
    {
      "end": 7855.78,
      "start": 7854.48,
      "text": "赶紧联系各农场"
    },
    {
      "end": 7858.12,
      "start": 7855.78,
      "text": "包括七哥刚才提到的这个币安的"
    },
    {
      "end": 7859.48,
      "start": 7858.12,
      "text": "这个受害的战友"
    },
    {
      "end": 7861.32,
      "start": 7859.48,
      "text": "或者是受到这个威胁的战友"
    },
    {
      "end": 7861.7,
      "start": 7861.32,
      "text": "对吧"
    },
    {
      "end": 7862.7,
      "start": 7861.7,
      "text": "积极和农场联系"
    },
    {
      "end": 7865.92,
      "start": 7862.7,
      "text": "那么我觉得这个是你该选择的时候了"
    },
    {
      "end": 7867.26,
      "start": 7865.92,
      "text": "赶紧来到爆料革命的队伍"
    },
    {
      "end": 7868.6,
      "start": 7867.26,
      "text": "赶紧联系各农场"
    },
    {
      "end": 7869.32,
      "start": 7868.6,
      "text": "好"
    },
    {
      "end": 7869.88,
      "start": 7869.32,
      "text": "谢谢"
    },
    {
      "end": 7870.8,
      "start": 7869.88,
      "text": "我就回应一下这个"
    },
    {
      "end": 7872.06,
      "start": 7870.8,
      "text": "好的"
    },
    {
      "end": 7873.02,
      "start": 7872.06,
      "text": "感谢大卫"
    },
    {
      "end": 7876.04,
      "start": 7873.02,
      "text": "那么也想请那个菲菲和卡利西"
    },
    {
      "end": 7877.52,
      "start": 7876.04,
      "text": "帮我们一回来分享一下"
    },
    {
      "end": 7879.04,
      "start": 7877.52,
      "text": "您的感感想"
    },
    {
      "end": 7879.4,
      "start": 7879.04,
      "text": "谢谢"
    },
    {
      "end": 7881.28,
      "start": 7879.4,
      "text": "好"
    },
    {
      "end": 7881.98,
      "start": 7881.28,
      "text": "谢谢清腾"
    },
    {
      "end": 7882.64,
      "start": 7881.98,
      "text": "谢谢大卫"
    },
    {
      "end": 7887.18,
      "start": 7882.64,
      "text": "然后其实我最近都不太关心这个股票啊什么的这些市场"
    },
    {
      "end": 7892.14,
      "start": 7887.18,
      "text": "因为我觉得这个事情就非非在这个事情上面输掉太多钱了"
    },
    {
      "end": 7894.94,
      "start": 7892.14,
      "text": "就血的这个教训"
    },
    {
      "end": 7897.08,
      "start": 7894.94,
      "text": "所以我对这件事情最近一点都不关心"
    },
    {
      "end": 7901.94,
      "start": 7897.08,
      "text": "然后我是觉得说这个中国的经济啊有没有这场疫情都需要崩掉的"
    },
    {
      "end": 7906.62,
      "start": 7901.94,
      "text": "就是不可能就是只是时间长一点或者晚一就是短一点"
    },
    {
      "end": 7909.3,
      "start": 7906.62,
      "text": "就这次这个疫情只是加剧了这个事情"
    },
    {
      "end": 7911.96,
      "start": 7909.3,
      "text": "然后我觉得共产党组织为什么要崩掉呢"
    },
    {
      "end": 7914.56,
      "start": 7911.96,
      "text": "他们经济都是虚的所有的东西都是假的"
    },
    {
      "end": 7916.92,
      "start": 7914.56,
      "text": "就是他们没有创新什么东西都没有"
    },
    {
      "end": 7919.06,
      "start": 7916.92,
      "text": "就我我我我举个例子啊"
    },
    {
      "end": 7922.4,
      "start": 7919.06,
      "text": "最近是有一个呃我很要好的一个朋友"
    },
    {
      "end": 7925.58,
      "start": 7922.4,
      "text": "他是对我们原来也一起大家都穷哈哈的"
    },
    {
      "end": 7929.1,
      "start": 7925.58,
      "text": "然后他们就踩到了这个改革开放的这个这个路上"
    },
    {
      "end": 7931.1,
      "start": 7929.1,
      "text": "然后家里有了那个上市公司"
    },
    {
      "end": 7933.54,
      "start": 7931.1,
      "text": "然后最近喜币上市我就跟他说"
    },
    {
      "end": 7936.84,
      "start": 7933.54,
      "text": "我说我说这个我给他看了我们的那个交易价格"
    },
    {
      "end": 7938.7,
      "start": 7936.84,
      "text": "然后他第一反应是跟我说"
    },
    {
      "end": 7941.62,
      "start": 7938.7,
      "text": "他说哇这个郭老板厉害啊"
    },
    {
      "end": 7943.32,
      "start": 7941.62,
      "text": "这个一下子就赚了一个亿啊"
    },
    {
      "end": 7944.4,
      "start": 7943.32,
      "text": "然后一亿美金"
    },
    {
      "end": 7947.78,
      "start": 7944.4,
      "text": "我想你这个认知简直就是有问题啊"
    },
    {
      "end": 7951.34,
      "start": 7947.78,
      "text": "然后然后我就那我说你你要不要买一点呢"
    },
    {
      "end": 7954.34,
      "start": 7951.34,
      "text": "那你知道他是怎么处置他的那个上市公司的吗"
    },
    {
      "end": 7956.18,
      "start": 7954.34,
      "text": "他当他能够套现的时候"
    },
    {
      "end": 7958.48,
      "start": 7956.18,
      "text": "他就处置掉了自己大部分的股份"
    },
    {
      "end": 7960.74,
      "start": 7958.48,
      "text": "所以他对自己的企业都没有信心的"
    },
    {
      "end": 7965.54,
      "start": 7960.74,
      "text": "然后那个他他们是他是一个地级市的这个一个一个"
    },
    {
      "end": 7967.22,
      "start": 7965.54,
      "text": "算是像地头蛇一样"
    },
    {
      "end": 7969.64,
      "start": 7967.22,
      "text": "他们那个地级市的市长就跟他最要好"
    },
    {
      "end": 7970.94,
      "start": 7969.64,
      "text": "那个市长都被抓起来了"
    },
    {
      "end": 7973.14,
      "start": 7970.94,
      "text": "然后他们去通关都没有把他弄出来"
    },
    {
      "end": 7974.18,
      "start": 7973.14,
      "text": "然后他就最近跟我说"
    },
    {
      "end": 7975.74,
      "start": 7974.18,
      "text": "他说他以前很相信共产党"
    },
    {
      "end": 7978.14,
      "start": 7975.74,
      "text": "他觉得哎呀我们这个党很伟大"
    },
    {
      "end": 7979.74,
      "start": 7978.14,
      "text": "然后就跟我先生讲的一样"
    },
    {
      "end": 7984.18,
      "start": 7979.74,
      "text": "就是那个就是这个局他是那个抽老千老是能够抽到的那个人"
    },
    {
      "end": 7985.58,
      "start": 7984.18,
      "text": "然后觉得自己很厉害"
    },
    {
      "end": 7987.14,
      "start": 7985.58,
      "text": "但是呢最近他又跟我说"
    },
    {
      "end": 7988.1,
      "start": 7987.14,
      "text": "他说真的不行了"
    },
    {
      "end": 7991.34,
      "start": 7988.1,
      "text": "他说这个我不能这个钱再多出来"
    },
    {
      "end": 7992.42,
      "start": 7991.34,
      "text": "我一定要赶紧套现"
    },
    {
      "end": 7996.1,
      "start": 7992.42,
      "text": "然后呢那我说你应该至少你钱应该移出美国"
    },
    {
      "end": 7998.42,
      "start": 7996.1,
      "text": "但是他他不敢你知道吗"
    },
    {
      "end": 8001.46,
      "start": 7998.42,
      "text": "他就他地级市的市长抓走了以后呢"
    },
    {
      "end": 8004.02,
      "start": 8001.46,
      "text": "他他想去捞那个人都没捞出来呢"
    },
    {
      "end": 8008.46,
      "start": 8004.02,
      "text": "他就觉得说这个钱就跟郭先生的认知开始有一点接近了"
    },
    {
      "end": 8010.9,
      "start": 8008.46,
      "text": "他说啊这个钱越多都是共产党的"
    },
    {
      "end": 8011.9,
      "start": 8010.9,
      "text": "所以他拿出来"
    },
    {
      "end": 8014.3,
      "start": 8011.9,
      "text": "但他拿出来做一件什么很愚蠢的事情的呢"
    },
    {
      "end": 8017.3,
      "start": 8014.3,
      "text": "他把他的拿出来的钱全部买了那个房地产"
    },
    {
      "end": 8019.46,
      "start": 8017.3,
      "text": "因为他觉得那个东西不好值啊"
    },
    {
      "end": 8021.3,
      "start": 8019.46,
      "text": "哈哈哈哈"
    },
    {
      "end": 8023.62,
      "start": 8021.3,
      "text": "那我说你为什么不拿出来买点洗币的"
    },
    {
      "end": 8024.9,
      "start": 8023.62,
      "text": "他说我买了洗币"
    },
    {
      "end": 8026.3,
      "start": 8024.9,
      "text": "共产党肯定要收拾我"
    },
    {
      "end": 8027.9,
      "start": 8026.3,
      "text": "他说我只要但凡"
    },
    {
      "end": 8031.06,
      "start": 8027.9,
      "text": "他们又现在虚拟虚拟币国内管的太紧了"
    },
    {
      "end": 8034.46,
      "start": 8031.06,
      "text": "就是说他们很害怕就是去买了任何"
    },
    {
      "end": 8036.26,
      "start": 8034.46,
      "text": "不要说郭先生的虚拟币"
    },
    {
      "end": 8037.94,
      "start": 8036.26,
      "text": "他任何虚拟币都不敢买"
    },
    {
      "end": 8039.22,
      "start": 8037.94,
      "text": "所以就买了这个房地产"
    },
    {
      "end": 8041.1,
      "start": 8039.22,
      "text": "然后最近听说要收房地产税"
    },
    {
      "end": 8043.7,
      "start": 8041.1,
      "text": "他就投一个投就很大很大的"
    },
    {
      "end": 8045.34,
      "start": 8043.7,
      "text": "这个东西"
    },
    {
      "end": 8046.82,
      "start": 8045.34,
      "text": "所以所以你想想看"
    },
    {
      "end": 8049.5,
      "start": 8046.82,
      "text": "他还是这种我们一直就是认识"
    },
    {
      "end": 8051.18,
      "start": 8049.5,
      "text": "然后在我们认识的人里面"
    },
    {
      "end": 8053.62,
      "start": 8051.18,
      "text": "还算是比较有有有见识的"
    },
    {
      "end": 8055.78,
      "start": 8053.62,
      "text": "然后才能走到今天这一步"
    },
    {
      "end": 8057.42,
      "start": 8055.78,
      "text": "他都是这样一个认知水平"
    },
    {
      "end": 8058.74,
      "start": 8057.42,
      "text": "他都是整个企业"
    },
    {
      "end": 8060.78,
      "start": 8058.74,
      "text": "他的企业还是在相关产业"
    },
    {
      "end": 8061.7,
      "start": 8060.78,
      "text": "还是做的比较好的"
    },
    {
      "end": 8062.78,
      "start": 8061.7,
      "text": "全部都是空的"
    },
    {
      "end": 8064.78,
      "start": 8062.78,
      "text": "他连自己都不相信他的企业"
    },
    {
      "end": 8066.86,
      "start": 8064.78,
      "text": "那反过来说我们其实就是说"
    },
    {
      "end": 8069.38,
      "start": 8066.86,
      "text": "像我是很相信我们这个洗联储"
    },
    {
      "end": 8071.26,
      "start": 8069.38,
      "text": "我们整个整个集系列"
    },
    {
      "end": 8072.78,
      "start": 8071.26,
      "text": "然后因为我是觉得说"
    },
    {
      "end": 8074.34,
      "start": 8072.78,
      "text": "我们玩的是实的东西"
    },
    {
      "end": 8076.26,
      "start": 8074.34,
      "text": "其实我们是大家都觉得"
    },
    {
      "end": 8077.74,
      "start": 8076.26,
      "text": "好像都是互联网公司"
    },
    {
      "end": 8078.66,
      "start": 8077.74,
      "text": "是虚拟地"
    },
    {
      "end": 8080.46,
      "start": 8078.66,
      "text": "但实际上我是觉得说"
    },
    {
      "end": 8082.38,
      "start": 8080.46,
      "text": "是有很多很多东西在支撑的"
    },
    {
      "end": 8083.92,
      "start": 8082.38,
      "text": "那最简单的东西就是说"
    },
    {
      "end": 8085.94,
      "start": 8083.92,
      "text": "我们现在能够爆出这个疫苗"
    },
    {
      "end": 8087.46,
      "start": 8085.94,
      "text": "然后这个事情来说"
    },
    {
      "end": 8089.3,
      "start": 8087.46,
      "text": "我就觉得这就是一个巨大的价值"
    },
    {
      "end": 8092.22,
      "start": 8089.3,
      "text": "这个是一个巨大的信誉在里面"
    },
    {
      "end": 8095.06,
      "start": 8092.22,
      "text": "当然还有其他的就不在这里赘述了"
    },
    {
      "end": 8096.14,
      "start": 8095.06,
      "text": "这个交给凯丽西吧"
    },
    {
      "end": 8096.42,
      "start": 8096.14,
      "text": "谢谢"
    },
    {
      "end": 8097.46,
      "start": 8096.42,
      "text": "谢谢"
    },
    {
      "end": 8098.46,
      "start": 8097.46,
      "text": "我等一下"
    },
    {
      "end": 8099.38,
      "start": 8098.46,
      "text": "我打算一下"
    },
    {
      "end": 8099.94,
      "start": 8099.38,
      "text": "请不吝点赞连"
    },
    {
      "end": 8100.46,
      "start": 8099.94,
      "text": "谢谢"
