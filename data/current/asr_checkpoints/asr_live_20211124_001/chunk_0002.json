    {
      "end": 2535.78,
      "start": 2534.24,
      "text": "叫所有人都不值钱了"
    },
    {
      "end": 2537.44,
      "start": 2535.78,
      "text": "这是不可以的"
    },
    {
      "end": 2538.56,
      "start": 2537.44,
      "text": "最起码我要等着"
    },
    {
      "end": 2540.44,
