      "end": 2525.74,
      "start": 2525.14,
      "text": "说白了"
    },
    {
      "end": 2527.68,
      "start": 2525.74,
      "text": "享受40块钱的福利"
    },
    {
      "end": 2529.68,
      "start": 2527.68,
      "text": "100块钱的福利币大家都享受"
    },
    {
      "end": 2530.86,
      "start": 2529.68,
      "text": "大家说走都走"
    },
