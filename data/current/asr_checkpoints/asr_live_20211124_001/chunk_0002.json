    {
      "end": 2542.4,
      "start": 2541.8,
      "text": "是吧"
    },
    {
      "end": 2543.24,
      "start": 2542.4,
      "text": "咱几个一算"
    },
    {
      "end": 2544.9,
      "start": 2543.24,
      "text": "飞飞你卖100"
    },
    {
      "end": 2546.24,
      "start": 2544.9,
      "text": "甘利西你卖100"
    },
    {
      "end": 2547.86,
      "start": 2546.24,
      "text": "青藤你就卖10个吧"
    },
    {
      "end": 2549.28,
      "start": 2547.86,
      "text": "大卫你因为你是大佬"
    },
    {
      "end": 2549.92,
      "start": 2549.28,
      "text": "你就卖一个"
    },
    {
      "end": 2551.44,
      "start": 2549.92,
      "text": "大家说行我开心"
    },
    {
      "end": 2553.6,
      "start": 2551.44,
      "text": "这时候大家夸上市场"
    },
    {
      "end": 2555.98,
      "start": 2553.6,
      "text": "是机构者把投资的钱给了我们"
    },
    {
      "end": 2558.1,
      "start": 2555.98,
      "text": "而且我们想的不是40"
    },
    {
      "end": 2559.86,
      "start": 2558.1,
      "text": "我们肯定不会卖那么便宜的家"
    },
    {
      "end": 2560.98,
      "start": 2559.86,
      "text": "大家把钱花去了"
    },
    {
      "end": 2561.48,
      "start": 2560.98,
      "text": "是吧"
    },
    {
      "end": 2563.02,
      "start": 2561.48,
      "text": "我们不能说咱四个卖"
    },
    {
      "end": 2564.48,
      "start": 2563.02,
      "text": "咱五个卖完了"
    },
    {
      "end": 2568.16,
      "start": 2564.48,
      "text": "结果发现村长的比较一块钱了"
