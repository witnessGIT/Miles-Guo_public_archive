    {
      "end": 2519.8,
      "start": 2518.68,
      "text": "你明白吗大费兄弟"
    },
    {
      "end": 2522.64,
      "start": 2519.8,
      "text": "你让他拿走就等于把所有的兄弟钱都拿走了"
