    {
      "end": 2996.14,
      "start": 2994.14,
      "text": "一个是Billboard的这个200专辑榜"
    },
    {
      "end": 2999.14,
      "start": 2996.14,
      "text": "一个是HOT100单曲榜"
    },
    {
      "end": 3003.14,
      "start": 2999.14,
      "text": "首先呢说一下这两大榜的统计时间"
    },
    {
      "end": 3005.14,
      "start": 3003.14,
      "text": "这Billboard的200呢是专达榜"
    },
    {
      "end": 3007.14,
      "start": 3005.14,
      "text": "这Billboard的200呢是专辑榜"
    },
    {
      "end": 3009.14,
      "start": 3007.14,
      "text": "统计时间是从每周一到每周日"
    },
    {
      "end": 3013.14,
      "start": 3009.14,
      "text": "按周来计算来统计"
    },
    {
      "end": 3016.14,
      "start": 3013.14,
      "text": "所以呢假如某专辑在周三发布"
    },
    {
      "end": 3019.14,
      "start": 3016.14,
      "text": "那么它的首周呢是周三到周日"
    },
    {
      "end": 3021.14,
      "start": 3019.14,
      "text": "而不是周三到下周三"
    },
    {
      "end": 3023.14,
      "start": 3021.14,
      "text": "所以有一些专辑呢"
    },
    {
      "end": 3026.14,
      "start": 3023.14,
      "text": "首周会没有算满7天"
    },
    {
      "end": 3028.14,
      "start": 3026.14,
      "text": "然后这个HOT100是单曲榜"
    },
    {
      "end": 3031.14,
      "start": 3028.14,
      "text": "单曲的这个排名呢是由三大因素来决定的"
    },
    {
      "end": 3033.14,
