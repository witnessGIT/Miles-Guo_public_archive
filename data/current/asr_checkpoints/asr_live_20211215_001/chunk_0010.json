    },
    {
      "end": 9501.92,
      "start": 9500.92,
      "text": "共同的幸福"
    },
    {
      "end": 9503.92,
      "start": 9501.92,
      "text": "這樣一個群體"
    },
    {
      "end": 9505.92,
      "start": 9503.92,
      "text": "在哪兒都是個國家"
