{
  "chunk_audio_sha256": "96bfb51d10ed7e36b82094ae4760659bfba46f63294a861a20147eef1e7aeb72",
  "chunk_index": 10,
  "completed_at": "2026-10-21T12:05:30Z",
  "language": "zh",
  "live_id": "LIVE_20211215_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 9000,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 9001.0,
      "start": 9000.0,
      "text": "沒有任何目的的"
    },
    {
      "end": 9006.4,
      "start": 9002.74,
      "text": "而且他說原來很多人是不相信我們的"
    },
    {
      "end": 9010.08,
      "start": 9006.4,
      "text": "就給他說你不要以為郭老闆都是騙的都是臉錢的"
    },
    {
      "end": 9012.08,
      "start": 9010.08,
      "text": "日本人是很難相信別人的"
    },
    {
      "end": 9014.22,
      "start": 9012.08,
      "text": "很難的現在都相信我們"
    },
    {
      "end": 9018.78,
      "start": 9016.12,
      "text": "我告訴你當你有共同的安全的時候"
    },
    {
      "end": 9021.38,
      "start": 9019.76,
      "text": "當你有共同的利益的時候"
    },
    {
      "end": 9024.02,
      "start": 9022.02,
      "text": "如果你在有這個生殖器上關係的時候"
    },
    {
      "end": 9026.46,
      "start": 9024.76,
      "text": "你不可能不擔心對方"
    },
    {
      "end": 9028.0,
      "start": 9026.46,
      "text": "不可能不去關心對方"
    },
    {
      "end": 9033.44,
      "start": 9028.0,
      "text": "我告訴你伊維菌書這個藥神到沉默什麼程度"
    },
    {
      "end": 9034.44,
      "start": 9033.44,
      "text": "這個青蠍素"
    },
    {
      "end": 9037.18,
      "start": 9034.44,
      "text": "我把我們菲菲還有AGLES"
    },
    {
      "end": 9039.48,
      "start": 9037.18,
      "text": "咱們這個青蠍素團隊整理的文件"
    },
    {
      "end": 9040.68,
      "start": 9039.48,
      "text": "英文的中文的"
    },
    {
      "end": 9043.32,
      "start": 9040.68,
      "text": "包括發給日本的全世界的朋友"
    },
    {
      "end": 9046.18,
      "start": 9043.32,
      "text": "土耳其的希臘的"
    },
    {
      "end": 9047.58,
      "start": 9046.18,
      "text": "義大利的馬爾塔"
    },
    {
      "end": 9048.86,
      "start": 9047.58,
      "text": "發到任何人那裡去"
    },
    {
      "end": 9051.02,
      "start": 9048.86,
      "text": "反饋都是沒有"
    },
    {
      "end": 9052.5,
      "start": 9051.02,
      "text": "我從沒見過哪個人"
    },
    {
      "end": 9054.26,
      "start": 9052.5,
      "text": "他說我認為你這是胡扯"
    },
    {
      "end": 9056.6,
      "start": 9054.26,
      "text": "他買不買跟他求是啥關係是不是"
    },
    {
      "end": 9060.98,
      "start": 9056.6,
      "text": "吃了青蠍素以後這種從病床上多年病床上"
    },
    {
      "end": 9062.04,
      "start": 9060.98,
      "text": "癌症病床上"
    },
    {
      "end": 9064.04,
      "start": 9062.04,
      "text": "多年的糖尿病上"
    },
    {
      "end": 9066.42,
      "start": 9064.04,
      "text": "多年的什麼腹科病上"
    },
    {
      "end": 9067.48,
      "start": 9066.42,
      "text": "多年的病全出來"
    },
    {
      "end": 9070.86,
      "start": 9067.48,
      "text": "說到這兒我要跟你講伊維菌書"
    },
    {
      "end": 9072.92,
      "start": 9070.86,
      "text": "你看看伊維菌書這個神藥"
    },
    {
      "end": 9076.92,
      "start": 9072.92,
      "text": "最近這一天我讓戰友找了很多伊維菌書的跟輯出來"
    },
    {
      "end": 9079.4,
      "start": 9076.92,
      "text": "他是救了整個非洲"
    },
    {
      "end": 9080.86,
      "start": 9079.4,
      "text": "我去過那裡非洲"
    },
    {
      "end": 9081.86,
      "start": 9080.86,
      "text": "你們沒去過"
    },
    {
      "end": 9084.96,
      "start": 9081.86,
      "text": "你到非洲有核芒症的地方"
    },
    {
      "end": 9086.96,
      "start": 9084.96,
      "text": "你看到真到了人間的地獄啊"
    },
    {
      "end": 9092.0,
      "start": 9086.96,
      "text": "一個村子裡有將近三分之一的人眼睛是看不見了"
    },
    {
      "end": 9092.64,
      "start": 9092.0,
      "text": "非常強壯"
    },
    {
      "end": 9093.94,
      "start": 9092.64,
      "text": "都是拿著棍兒出的"
    },
    {
      "end": 9098.32,
      "start": 9093.94,
      "text": "你說那個非洲的地方喝的那個髒水真的是太髒了"
    },
    {
      "end": 9100.32,
      "start": 9098.32,
      "text": "吃東西也不洗"
    },
    {
      "end": 9103.92,
      "start": 9100.32,
      "text": "瘧疾還有這個核芒症"
    },
    {
      "end": 9104.58,
      "start": 9103.92,
      "text": "瞎著"
    },
    {
      "end": 9106.38,
      "start": 9104.58,
      "text": "都是直接就是瞎了"
    },
    {
      "end": 9110.32,
      "start": 9106.38,
      "text": "伊維菌書五粒就讓他把眼睛睜開"
    },
    {
      "end": 9114.32,
      "start": 9110.32,
      "text": "你看世界上最貪婪的"
    },
    {
      "end": 9116.1,
      "start": 9114.32,
      "text": "這輝瑞也還有中國的國藥啊"
    },
    {
      "end": 9117.2,
      "start": 9116.1,
      "text": "這些製藥廠"
    },
    {
      "end": 9121.58,
      "start": 9117.2,
      "text": "你想想人家美國這個製藥廠啊"
    },
    {
      "end": 9122.58,
      "start": 9121.58,
      "text": "叫這個聯邦製藥"
    },
    {
      "end": 9124.58,
      "start": 9122.58,
      "text": "這個什麼幫製藥"
    },
    {
      "end": 9127.84,
      "start": 9124.58,
      "text": "竟然製造了伊維菌書是免費給非洲人的"
    },
    {
      "end": 9131.18,
      "start": 9127.84,
      "text": "我到那去我是打了疫苗的"
    },
    {
      "end": 9132.92,
      "start": 9131.18,
      "text": "我也害怕你知道嗎"
    },
    {
      "end": 9136.58,
      "start": 9132.92,
      "text": "而且就有人當時就拉肚子拉到不行"
    },
    {
      "end": 9141.72,
      "start": 9136.58,
      "text": "伊維菌書是日本人一個農民在日本的土地上"
    },
    {
      "end": 9148.1,
      "start": 9141.72,
      "text": "就靠自己一個農村裏邊相信大自然給了人類所有的需要的力量"
    },
    {
      "end": 9150.72,
      "start": 9148.1,
      "text": "和醫藥和解決問題的辦法"
    },
    {
      "end": 9152.1,
      "start": 9150.72,
      "text": "就這麼一個日本人"
    },
    {
      "end": 9154.5,
      "start": 9152.1,
      "text": "幾十年幹了一件事"
    },
    {
      "end": 9156.14,
      "start": 9154.5,
      "text": "研究這一位菌書"
    },
    {
      "end": 9158.1,
      "start": 9156.14,
      "text": "現在日本的英雄都英雄"
    },
    {
      "end": 9160.34,
      "start": 9158.1,
      "text": "而且日本國家全力支持"
    },
    {
      "end": 9161.34,
      "start": 9160.34,
      "text": "最後跟美國合作"
    },
    {
      "end": 9162.44,
      "start": 9161.34,
      "text": "把它分子化"
    },
    {
      "end": 9163.64,
      "start": 9162.44,
      "text": "把它醫藥化"
    },
    {
      "end": 9164.98,
      "start": 9163.64,
      "text": "把它變成成救人"
    },
    {
      "end": 9166.14,
      "start": 9164.98,
      "text": "最後是免費救人"
    },
    {
      "end": 9168.94,
      "start": 9166.14,
      "text": "你告訴我中國共產黨有一個這事他幹過嗎"
    },
    {
      "end": 9171.38,
      "start": 9168.94,
      "text": "從共產黨的歷史上找一件這事"
    },
    {
      "end": 9174.12,
      "start": 9171.72,
      "text": "同樣是圖悠悠"
    },
    {
      "end": 9176.62,
      "start": 9174.12,
      "text": "在中國沒人問君"
    },
    {
      "end": 9179.0,
      "start": 9176.62,
      "text": "獲完諾貝爾獎以後沒人搭理他"
    },
    {
      "end": 9182.2,
      "start": 9179.0,
      "text": "中國政府把青豪素免費給過哪個國家"
    },
    {
      "end": 9184.7,
      "start": 9182.2,
      "text": "他讓青豪素在人裏治過多少人"
    },
    {
      "end": 9189.2,
      "start": 9184.7,
      "text": "我告訴你青豪素比伊維菌書還要牛萬倍一倍"
    },
    {
      "end": 9192.94,
      "start": 9189.2,
      "text": "他絕對可以百分之百消除癌症"
    },
    {
      "end": 9194.54,
      "start": 9192.94,
      "text": "不是百分之九十九"
    },
    {
      "end": 9197.94,
      "start": 9194.54,
      "text": "如果你們相信我青豪素"
    },
    {
      "end": 9200.32,
      "start": 9197.94,
      "text": "會讓所有現在躺出來病床上的人"
    },
    {
      "end": 9201.52,
      "start": 9200.32,
      "text": "真的能站起來"
    },
    {
      "end": 9202.56,
      "start": 9201.52,
      "text": "真的能活起來"
    },
    {
      "end": 9203.72,
      "start": 9202.56,
      "text": "真的沒癌症"
    },
    {
      "end": 9207.4,
      "start": 9205.52,
      "text": "我就有些話現在不能告訴你"
    },
    {
      "end": 9210.0,
      "start": 9207.4,
      "text": "七哥說話是很保守的在這事"
    },
    {
      "end": 9211.5,
      "start": 9210.0,
      "text": "我是很小心的"
    },
    {
      "end": 9212.8,
      "start": 9211.5,
      "text": "人家給我講的這話"
    },
    {
      "end": 9214.24,
      "start": 9212.8,
      "text": "我是很多人在這不能說的"
    },
    {
      "end": 9217.28,
      "start": 9214.24,
      "text": "就是咱們告訴這這是解藥的"
    },
    {
      "end": 9218.68,
      "start": 9217.28,
      "text": "當時共產黨說"
    },
    {
      "end": 9221.36,
      "start": 9218.68,
      "text": "郭文貴講出青豪素這三字的時候"
    },
    {
      "end": 9222.68,
      "start": 9221.36,
      "text": "是解藥的時候"
    },
    {
      "end": 9225.56,
      "start": 9222.68,
      "text": "這郭文貴對我們的威脅就增加了無限倍"
    },
    {
      "end": 9228.16,
      "start": 9227.06,
      "text": "為什麼"
    },
    {
      "end": 9231.7,
      "start": 9229.26,
      "text": "當時所謂國安委的說"
    },
    {
      "end": 9234.3,
      "start": 9231.7,
      "text": "青豪素會改變人類的壽命"
    },
    {
      "end": 9237.94,
      "start": 9235.96,
      "text": "這是共產黨知道能救人"
    },
    {
      "end": 9239.46,
      "start": 9237.94,
      "text": "他就不告訴你能救人"
    },
    {
      "end": 9242.94,
      "start": 9239.46,
      "text": "和日本人說能明知道救人跟美國人開放"
    },
    {
      "end": 9244.14,
      "start": 9242.94,
      "text": "我讓你去救人"
    },
    {
      "end": 9246.28,
      "start": 9244.14,
      "text": "這是完全不同的政府啊"
    },
    {
      "end": 9250.68,
      "start": 9247.28,
      "text": "所以一危均術"
    },
    {
      "end": 9252.62,
      "start": 9250.68,
      "text": "妳看日本的這朋友說"
    },
    {
      "end": 9254.98,
      "start": 9252.62,
      "text": "就是因為旁邊我上這直播跟妳說了"
    },
    {
      "end": 9257.12,
      "start": 9254.98,
      "text": "他壹家六口人"
    },
    {
      "end": 9259.12,
      "start": 9257.12,
      "text": "仨不相信的仨相信的"
    },
    {
      "end": 9260.7,
      "start": 9259.12,
      "text": "倆死了"
    },
    {
      "end": 9263.76,
      "start": 9260.7,
      "text": "不相信的死了"
    },
    {
      "end": 9266.2,
      "start": 9263.76,
      "text": "相信的連染上都沒染上"
    },
    {
      "end": 9268.66,
      "start": 9266.2,
      "text": "還有壹家八口的"
    },
    {
      "end": 9271.14,
      "start": 9268.66,
      "text": "是六個不相信的倆相信的"
    },
    {
      "end": 9272.14,
      "start": 9271.14,
      "text": "這倆從來沒得上"
    },
    {
      "end": 9273.8,
      "start": 9272.14,
      "text": "他家有得兩次一個死了"
    },
    {
      "end": 9277.28,
      "start": 9273.8,
      "text": "這不是很簡單"
    },
    {
      "end": 9278.68,
      "start": 9277.28,
      "text": "妳可以不相信我們"
    },
    {
      "end": 9279.68,
      "start": 9278.68,
      "text": "妳試試"
    },
    {
      "end": 9282.62,
      "start": 9280.68,
      "text": "壹味菌術到了什麽程度"
    },
    {
      "end": 9284.58,
      "start": 9282.62,
      "text": "他們家裏邊人有得了兩次的"
    },
    {
      "end": 9285.92,
      "start": 9284.58,
      "text": "就是活下來的"
    },
    {
      "end": 9288.82,
      "start": 9285.92,
      "text": "兩粒壹味菌術完全症狀消失"
    },
    {
      "end": 9291.4,
      "start": 9290.1,
      "text": "就這麽誇張"
    },
    {
      "end": 9292.76,
      "start": 9291.4,
      "text": "所以我昨天我說我不是說"
    },
    {
      "end": 9294.16,
      "start": 9292.76,
      "text": "我馬上來壹粒吃了"
    },
    {
      "end": 9295.46,
      "start": 9294.16,
      "text": "就這麽自信"
    },
    {
      "end": 9297.86,
      "start": 9295.46,
      "text": "因為我到現在還沒發現壹粒失敗了"
    },
    {
      "end": 9298.86,
      "start": 9297.86,
      "text": "壹粒失敗了"
    },
    {
      "end": 9299.86,
      "start": 9298.86,
      "text": "壹粒失敗了"
    },
    {
      "end": 9302.86,
      "start": 9299.86,
      "text": "我們在帛琉"
    },
    {
      "end": 9305.8,
      "start": 9302.86,
      "text": "大家壹一定要想這個帛琉"
    },
    {
      "end": 9306.8,
      "start": 9305.8,
      "text": "在帛琉"
    },
    {
      "end": 9308.9,
      "start": 9306.8,
      "text": "那會壹共16個警察"
    },
    {
      "end": 9311.34,
      "start": 9308.9,
      "text": "我到那去享受皇帝的待遇"
    },
    {
      "end": 9312.82,
      "start": 9311.34,
      "text": "最漂亮的地方水啊"
    },
    {
      "end": 9314.38,
      "start": 9312.82,
      "text": "那太漂亮的帛琉"
    },
    {
      "end": 9315.92,
      "start": 9314.38,
      "text": "就流球咱們所說的"
    },
    {
      "end": 9317.72,
      "start": 9315.92,
      "text": "其中有兩個警察"
    },
    {
      "end": 9319.72,
      "start": 9317.72,
      "text": "他說我們這染上了"
    },
    {
      "end": 9321.72,
      "start": 9319.72,
      "text": "因為出去旅遊的回來"
    },
    {
      "end": 9322.72,
      "start": 9321.72,
      "text": "怎麽辦"
    },
    {
      "end": 9324.32,
      "start": 9322.72,
      "text": "我說馬上吃壹味菌術"
    },
    {
      "end": 9325.32,
      "start": 9324.32,
      "text": "他說我沒有啊"
    },
    {
      "end": 9327.46,
      "start": 9325.32,
      "text": "我說我讓人馬上給妳寄過去"
    },
    {
      "end": 9329.96,
      "start": 9328.46,
      "text": "寄到以後"
    },
    {
      "end": 9330.96,
      "start": 9329.96,
      "text": "吃壹味菌術"
    },
    {
      "end": 9331.96,
      "start": 9330.96,
      "text": "兩粒全消"
    },
    {
      "end": 9333.78,
      "start": 9331.96,
      "text": "然後吃清浩素"
    },
    {
      "end": 9335.78,
      "start": 9333.78,
      "text": "在那個流球人看上去很矮"
    },
    {
      "end": 9336.38,
      "start": 9335.78,
      "text": "妳知道嗎"
    },
    {
      "end": 9337.38,
      "start": 9336.38,
      "text": "有這個氣候原因"
    },
    {
      "end": 9338.38,
      "start": 9337.38,
      "text": "就像很矮很矮"
    },
    {
      "end": 9339.78,
      "start": 9338.38,
      "text": "這就像像蠟人一樣"
    },
    {
      "end": 9340.28,
      "start": 9339.78,
      "text": "黑人"
    },
    {
      "end": 9341.98,
      "start": 9340.28,
      "text": "其中壹個"
    },
    {
      "end": 9344.28,
      "start": 9341.98,
      "text": "他是做了兩次癌症手術"
    },
    {
      "end": 9345.92,
      "start": 9344.28,
      "text": "根本沒下過病"
    },
    {
      "end": 9347.92,
      "start": 9345.92,
      "text": "吃了11粒清浩素"
    },
    {
      "end": 9348.92,
      "start": 9347.92,
      "text": "從床上走下來"
    },
    {
      "end": 9350.92,
      "start": 9348.92,
      "text": "第一次走進大海"
    },
    {
      "end": 9353.92,
      "start": 9352.92,
      "text": "妳想想戰友們這種"
    },
    {
      "end": 9354.92,
      "start": 9353.92,
      "text": "大家看看清浩素的"
    },
    {
      "end": 9356.92,
      "start": 9354.92,
      "text": "看到我們在群裏邊"
    },
    {
      "end": 9357.92,
      "start": 9356.92,
      "text": "清浩素群"
    },
    {
      "end": 9358.92,
      "start": 9357.92,
      "text": "壹個女孩打了這個疫苗"
    },
    {
      "end": 9359.92,
      "start": 9358.92,
      "text": "對了"
    },
    {
      "end": 9360.92,
      "start": 9359.92,
      "text": "在那個流球的"
    },
    {
      "end": 9362.92,
      "start": 9360.92,
      "text": "也是打了三針疫苗"
    },
    {
      "end": 9363.92,
      "start": 9362.92,
      "text": "我嚇死了看他們直播"
    },
    {
      "end": 9364.92,
      "start": 9363.92,
      "text": "吃"
    },
    {
      "end": 9366.92,
      "start": 9364.92,
      "text": "身上到處瘀斑啊"
    },
    {
      "end": 9369.92,
      "start": 9367.92,
      "text": "然後老師自己發抖"
    },
    {
      "end": 9370.92,
      "start": 9369.92,
      "text": "然後就開始吃清浩素"
    },
    {
      "end": 9371.92,
      "start": 9370.92,
      "text": "現在症狀全消"
    },
    {
      "end": 9372.92,
      "start": 9371.92,
      "text": "妳看我們清浩素群裏"
    },
    {
      "end": 9373.92,
      "start": 9372.92,
      "text": "有個女孩"
    },
    {
      "end": 9374.92,
      "start": 9373.92,
      "text": "整個身上都是瘀斑"
    },
    {
      "end": 9376.92,
      "start": 9374.92,
      "text": "現在逐漸消失"
    },
    {
      "end": 9380.92,
      "start": 9378.92,
      "text": "妳告訴我這是我們吹牛的嗎"
    },
    {
      "end": 9381.92,
      "start": 9380.92,
      "text": "我們是胡說的嗎"
    },
    {
      "end": 9383.92,
      "start": 9381.92,
      "text": "我們今天救多少人"
    },
    {
      "end": 9386.92,
      "start": 9385.92,
      "text": "所以現在體制內的"
    },
    {
      "end": 9387.92,
      "start": 9386.92,
      "text": "這個警察"
    },
    {
      "end": 9390.92,
      "start": 9387.92,
      "text": "說郭先生我不是妳的粉絲"
    },
    {
      "end": 9391.92,
      "start": 9390.92,
      "text": "我也不是反對妳的"
    },
    {
      "end": 9394.92,
      "start": 9391.92,
      "text": "我最起碼做到一個良知"
    },
    {
      "end": 9396.92,
      "start": 9394.92,
      "text": "我是全家吃了清浩素"
    },
    {
      "end": 9398.92,
      "start": 9396.92,
      "text": "我們的病基本都好"
    },
    {
      "end": 9400.92,
      "start": 9398.92,
      "text": "而且特別是我女兒打了疫苗以後"
    },
    {
      "end": 9401.92,
      "start": 9400.92,
      "text": "她說我嚇死了"
    },
    {
      "end": 9403.92,
      "start": 9401.92,
      "text": "但吃完疫苗我現在放棄了"
    },
    {
      "end": 9408.92,
      "start": 9404.92,
      "text": "她說在我手裏不會有一個爆料革命人被被被被被被"
    },
    {
      "end": 9409.92,
      "start": 9408.92,
      "text": "!一定不會"
    },
    {
      "end": 9412.92,
      "start": 9409.92,
      "text": "我現在這位戰友是啥名我不知道"
    },
    {
      "end": 9413.92,
      "start": 9412.92,
      "text": "發信息"
    },
    {
      "end": 9414.92,
      "start": 9413.92,
      "text": "不能叫戰友這位朋友"
    },
    {
      "end": 9415.92,
      "start": 9414.92,
      "text": "發信息"
    },
    {
      "end": 9416.92,
      "start": 9415.92,
      "text": "我給她說"
    },
    {
      "end": 9418.92,
      "start": 9416.92,
      "text": "妳做了對著起妳良心的事情"
    },
    {
      "end": 9419.92,
      "start": 9418.92,
      "text": "但我不會感激妳"
    },
    {
      "end": 9423.92,
      "start": 9422.92,
      "text": "所以說兄弟兄們"
    },
    {
      "end": 9425.92,
      "start": 9423.92,
      "text": "要想到這個五十幾個民族的時候"
    },
    {
      "end": 9427.92,
      "start": 9425.92,
      "text": "妳想到她什麽能把他們連在一起"
    },
    {
      "end": 9431.92,
      "start": 9429.92,
      "text": "多少人因為輕浩素"
    },
    {
      "end": 9433.92,
      "start": 9431.92,
      "text": "因為疫苗菌素"
    },
    {
      "end": 9434.92,
      "start": 9433.92,
      "text": "因為打疫苗被我們救了"
    },
    {
      "end": 9437.92,
      "start": 9435.92,
      "text": "她怎麽能和我們不在一起"
    },
    {
      "end": 9442.92,
      "start": 9438.92,
      "text": "未來她們在使用我們的Gcoin"
    },
    {
