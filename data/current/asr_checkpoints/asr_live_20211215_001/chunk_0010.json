    {
      "end": 9475.92,
      "start": 9474.92,
      "text": "妳想進中南海嗎"
    },
    {
      "end": 9476.92,
      "start": 9475.92,
      "text": "妳想進天安門嗎"
    },
    {
      "end": 9478.92,
      "start": 9476.92,
      "text": "那妳千萬別跟新中聯邦"
    },
    {
      "end": 9480.92,
      "start": 9478.92,
      "text": "我們不想要那個破地方"
