    {
      "end": 1554.78,
      "start": 1552.78,
      "text": "對 唯一堆人看著"
    },
    {
      "end": 1556.78,
      "start": 1554.78,
      "text": "不用到了 跟我自己聽的"
    },
    {
      "end": 1561.78,
      "start": 1560.78,
      "text": "這衣服真漂亮"
    },
    {
      "end": 1563.78,
      "start": 1561.78,
      "text": "那你說那哨子"
    },
    {
      "end": 1565.78,
      "start": 1563.78,
      "text": "他那幾個哨子真是沉甸甸的"
    },
    {
      "end": 1567.78,
      "start": 1565.78,
      "text": "他為什麽不出聲呢"
    },
    {
      "end": 1569.78,
      "start": 1567.78,
      "text": "他是為了給你裝飾嗎"
    },
    {
      "end": 1571.78,
      "start": 1569.78,
      "text": "那個 看看啊"
    },
    {
      "end": 1574.78,
      "start": 1571.78,
      "text": "哇哦 這是什麽"
    },
    {
      "end": 1575.78,
      "start": 1574.78,
      "text": "看這個"
    },
    {
      "end": 1577.78,
      "start": 1575.78,
      "text": "這回這個可了成地咯"
    },
    {
      "end": 1579.78,
      "start": 1577.78,
      "text": "你看這個"
    },
    {
      "end": 1581.78,
      "start": 1579.78,
      "text": "就是袖上惡意平常的"
    },
    {
      "end": 1582.78,
      "start": 1581.78,
      "text": "要新加個了解"
    },
    {
      "end": 1585.78,
      "start": 1582.78,
      "text": "這個就是什麽的"
    },
    {
      "end": 1587.78,
      "start": 1585.78,
      "text": "踢翻身的 踢板的拉鍊"
    },
    {
      "end": 1589.78,
      "start": 1587.78,
      "text": "看到沒有"
    },
    {
      "end": 1590.78,
      "start": 1589.78,
      "text": "然後看這個"
    },
    {
      "end": 1593.78,
      "start": 1590.78,
      "text": "後面這個地方 親屬的 logo"
    },
    {
      "end": 1594.78,
      "start": 1593.78,
      "text": "是吧"
    },
    {
      "end": 1596.78,
      "start": 1594.78,
      "text": "然後你看這個感覺"
    },
    {
      "end": 1597.78,
      "start": 1596.78,
      "text": "哇塞"
    },
    {
      "end": 1599.78,
      "start": 1597.78,
      "text": "這衣服啊"
    },
    {
      "end": 1601.78,
      "start": 1599.78,
      "text": "什麽叫時尚啊"
    },
    {
      "end": 1603.78,
      "start": 1601.78,
      "text": "時尚就在這"
    },
    {
      "end": 1604.78,
      "start": 1603.78,
      "text": "就是你穿上以後"
    },
    {
      "end": 1606.78,
      "start": 1604.78,
      "text": "你真感覺你不一樣"
    },
    {
      "end": 1607.78,
      "start": 1606.78,
      "text": "你真感覺"
    },
    {
      "end": 1610.78,
      "start": 1607.78,
      "text": "這個就是你穿上以後"
    },
    {
      "end": 1611.78,
      "start": 1610.78,
