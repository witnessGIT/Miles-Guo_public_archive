{
  "chunk_audio_sha256": "12832a4d58fe5fc812b4bea8412152507fb6e0a8ad24e61c1ece927992b1373a",
  "chunk_index": 5,
  "completed_at": "2026-10-21T11:55:49Z",
  "language": "zh",
  "live_id": "LIVE_20211215_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 4500,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 4503.46,
      "start": 4500.0,
      "text": "今天的大饼 还有一个所谓的计划"
    },
    {
      "end": 4506.72,
      "start": 4504.0,
      "text": "你知道共产党在全世界你们没跟他接触过"
    },
    {
      "end": 4510.56,
      "start": 4507.92,
      "text": "他有很多优越性是西方人很羡慕的"
    },
    {
      "end": 4512.36,
      "start": 4511.0,
      "text": "为什么 常委学习"
    },
    {
      "end": 4514.72,
      "start": 4512.64,
      "text": "你看到那个假习近平的女儿在说"
    },
    {
      "end": 4518.68,
      "start": 4515.0,
      "text": "只有共产党常委学习 叫全常委学习制"
    },
    {
      "end": 4521.64,
      "start": 4519.0,
      "text": "所以中共的高官你跟他一聊天"
    },
    {
      "end": 4525.12,
      "start": 4521.72,
      "text": "哇塞 你知道只要是个局级干部鼻子都会痒起来"
    },
    {
      "end": 4527.68,
      "start": 4525.4,
      "text": "就对外国人要指手画脚的"
    },
    {
      "end": 4532.08,
      "start": 4527.68,
      "text": "你看你们这些 每四年换一个总统"
    },
    {
      "end": 4535.12,
      "start": 4532.28,
      "text": "上街不下街 上街不下街"
    },
    {
      "end": 4538.68,
      "start": 4535.12,
      "text": "左边不右边 右边不左边 根本不能兑现"
    },
    {
      "end": 4541.0,
      "start": 4538.96,
      "text": "互相颠倒 谁给你们打颠倒啊"
    },
    {
      "end": 4543.8,
      "start": 4541.52,
      "text": "你们的总统从来不学习 这搞选举"
    },
    {
      "end": 4546.52,
      "start": 4543.8,
      "text": "你看我们的领导人都集体学习 是吧"
    },
    {
      "end": 4548.84,
      "start": 4546.96,
      "text": "哇 很骄傲啊 政治优越性"
    },
    {
      "end": 4552.08,
      "start": 4550.24,
      "text": "你看这假习近平女儿说这个了"
    },
    {
      "end": 4553.68,
      "start": 4552.32,
      "text": "他们是学习的 他说什么"
    },
    {
      "end": 4554.92,
      "start": 4553.68,
      "text": "还有一个五年计划"
    },
    {
      "end": 4558.52,
      "start": 4554.92,
      "text": "八五计划 六五计划 七五计划 每五年一计划 他有计划"
    },
    {
      "end": 4562.92,
      "start": 4559.52,
      "text": "中国老百姓很享受这个 你看我们党又有了五年计划"
    },
    {
      "end": 4566.44,
      "start": 4562.92,
      "text": "下个五年计划 下十年计划 然后两个百年计划习近平来了"
    },
    {
      "end": 4569.32,
      "start": 4566.44,
      "text": "然后习近平的中国梦 从希特勒的"
    },
    {
      "end": 4573.32,
      "start": 4569.32,
      "text": "我从这个梦游当中 走向了我的"
    },
    {
      "end": 4576.92,
      "start": 4573.32,
      "text": "自信的走向我的人生 变成了中国人的梦"
    },
    {
      "end": 4580.52,
      "start": 4576.92,
      "text": "从1912到现在没有不花大饼的时候"
    },
    {
      "end": 4585.8,
      "start": 4582.52,
      "text": "你看 去年上半年讲的是今年是什么"
    },
    {
      "end": 4586.92,
      "start": 4585.8,
      "text": "六中全会"
    },
    {
      "end": 4590.36,
      "start": 4588.44,
      "text": "六中全会 你看六中完了"
    },
    {
      "end": 4592.72,
      "start": 4590.36,
      "text": "现在明天开始开两会了 是吧"
    },
    {
      "end": 4596.12,
      "start": 4592.72,
      "text": "然后在这个中间这个大跨越就是冬季奥运会"
    },
    {
      "end": 4599.12,
      "start": 4596.52,
      "text": "所以共同党永远为一个目标为一个目标来做"
    },
    {
      "end": 4602.12,
      "start": 4599.12,
      "text": "你看着好像很计划 还有自己的学习机制"
    },
    {
      "end": 4605.72,
      "start": 4602.72,
      "text": "大家千万记住 你往回看这件事情"
    },
    {
      "end": 4609.72,
      "start": 4606.92,
      "text": "冬奥会彻底失败"
    },
    {
      "end": 4613.72,
      "start": 4610.52,
      "text": "18大习王成功了 19大他成功了"
    },
    {
      "end": 4616.92,
      "start": 4613.72,
      "text": "但是冬奥会彻底失败 20大能成功吗"
    },
    {
      "end": 4620.52,
      "start": 4617.72,
      "text": "20大之前房地产的问题能解决吗"
    },
    {
      "end": 4626.52,
      "start": 4621.52,
      "text": "20大之前所有的你的90万亿美元的和100万亿美元也好"
    },
    {
      "end": 4629.12,
      "start": 4626.52,
      "text": "你说56万亿美元好 官方56万亿"
    },
    {
      "end": 4630.92,
      "start": 4629.12,
      "text": "就说你56万亿美元的房地产"
    },
    {
      "end": 4633.12,
      "start": 4631.32,
      "text": "这个经济你能解决得了吗"
    },
    {
      "end": 4637.32,
      "start": 4633.12,
      "text": "1.2亿人失业呀"
    },
    {
      "end": 4643.92,
      "start": 4639.12,
      "text": "这是1.2亿人失业最起码意味着几千万套房子"
    },
    {
      "end": 4645.92,
      "start": 4643.92,
      "text": "记住啊 咱就别说1亿套"
    },
    {
      "end": 4649.32,
      "start": 4645.92,
      "text": "也别说1乘以2 咱就谦虚点说"
    },
    {
      "end": 4650.92,
      "start": 4649.72,
      "text": "3千万套房子"
    },
    {
      "end": 4655.92,
      "start": 4651.92,
      "text": "按共产党的逻辑一年开发1千万套房子上市"
    },
    {
      "end": 4659.32,
      "start": 4655.92,
      "text": "1千万套11平方米"
    },
    {
      "end": 4662.12,
      "start": 4661.12,
      "text": "那你算一下这样"
    },
    {
      "end": 4665.72,
      "start": 4662.12,
      "text": "丽山一看你这都是绝顶聪明人是不是"
    },
    {
      "end": 4666.72,
      "start": 4665.72,
      "text": "都是有钱的人"
    },
    {
      "end": 4668.32,
      "start": 4666.72,
      "text": "你自己掰的手指头"
    },
    {
      "end": 4670.72,
      "start": 4668.32,
      "text": "不用掰两手 掰一个手给他算上账"
    },
    {
      "end": 4674.52,
      "start": 4670.72,
      "text": "说你怎么还你这50万亿的贷款怎么还下去"
    },
    {
      "end": 4679.12,
      "start": 4675.52,
      "text": "你的这个1千万套的打工的房子也就没了"
    },
    {
      "end": 4681.72,
      "start": 4679.12,
      "text": "他不是说买不起每年的1千万套了"
    },
    {
      "end": 4684.72,
      "start": 4681.72,
      "text": "这3千万套他就可能还不起了"
    },
    {
      "end": 4686.12,
      "start": 4684.72,
      "text": "他怎么买新呢"
    },
    {
      "end": 4689.32,
      "start": 4687.12,
      "text": "这1亿多人没工作了"
    },
    {
      "end": 4690.72,
      "start": 4689.32,
      "text": "我怎么往下弄呢"
    },
    {
      "end": 4693.92,
      "start": 4692.32,
      "text": "然后冬奥会过后"
    },
    {
      "end": 4697.52,
      "start": 4693.92,
      "text": "整个张家口的房产开发了多少房子"
    },
    {
      "end": 4698.92,
      "start": 4697.52,
      "text": "共产党官方说"
    },
    {
      "end": 4701.52,
      "start": 4698.92,
      "text": "开发了将近5千万平方米房子"
    },
    {
      "end": 4702.52,
      "start": 4701.52,
      "text": "大家去看一看去"
    },
    {
      "end": 4706.92,
      "start": 4702.52,
      "text": "整个张家口房产代替整个河北省张家口"
    },
    {
      "end": 4710.52,
      "start": 4706.92,
      "text": "还有什么旁边的成德呀周围车区"
    },
    {
      "end": 4711.52,
      "start": 4710.52,
      "text": "大家去看一看去"
    },
    {
      "end": 4713.12,
      "start": 4711.52,
      "text": "从哪些奥迷会到现在"
    },
    {
      "end": 4715.92,
      "start": 4713.12,
      "text": "几乎是无痕迹的开发"
    },
    {
      "end": 4718.52,
      "start": 4717.32,
      "text": "大家知道投多少钱吗"
    },
    {
      "end": 4719.72,
      "start": 4718.52,
      "text": "官方5千亿"
    },
    {
      "end": 4722.92,
      "start": 4719.72,
      "text": "民间投资2.5万亿人民币的相关房地产"
    },
    {
      "end": 4726.92,
      "start": 4724.92,
      "text": "这些房地产都会成为垃圾"
    },
    {
      "end": 4729.12,
      "start": 4726.92,
      "text": "你拿啥赔"
    },
    {
      "end": 4732.32,
      "start": 4729.12,
      "text": "好就像说这个恒大一样"
    },
    {
      "end": 4733.52,
      "start": 4732.32,
      "text": "恒大你看一开始"
    },
    {
      "end": 4736.32,
      "start": 4733.52,
      "text": "属于内部经济问题"
    },
    {
      "end": 4740.32,
      "start": 4736.32,
      "text": "广东房地产局部发展不平衡的问题"
    },
    {
      "end": 4743.32,
      "start": 4740.32,
      "text": "和恒大自我能解决经济平衡的问题"
    },
    {
      "end": 4745.72,
      "start": 4743.32,
      "text": "这属于局部的现象问题"
    },
    {
      "end": 4747.52,
      "start": 4745.72,
      "text": "到最后广东约谈"
    },
    {
      "end": 4749.52,
      "start": 4747.52,
      "text": "到最后恒大不能破产"
    },
    {
      "end": 4751.12,
      "start": 4749.52,
      "text": "就是保你冬奥会"
    },
    {
      "end": 4754.12,
      "start": 4751.12,
      "text": "你这一个恒大讲了十几个谎言"
    },
    {
      "end": 4758.32,
      "start": 4755.12,
      "text": "我跟毛美国人通电话"
    },
    {
      "end": 4759.52,
      "start": 4758.32,
      "text": "我说来来来"
    },
    {
      "end": 4761.32,
      "start": 4759.52,
      "text": "你等等我发你几个信息"
    },
    {
      "end": 4762.72,
      "start": 4761.32,
      "text": "从共产党恒大是说的"
    },
    {
      "end": 4764.52,
      "start": 4762.72,
      "text": "而且我给他找的都是英文的"
    },
    {
      "end": 4766.12,
      "start": 4764.52,
      "text": "发完以后半天"
    },
    {
      "end": 4767.12,
      "start": 4766.12,
      "text": "哥们儿傻眼了"
    },
    {
      "end": 4769.52,
      "start": 4767.12,
      "text": "我说你们就是因为贪婪"
    },
    {
      "end": 4771.32,
      "start": 4769.52,
      "text": "不想让自己失败"
    },
    {
      "end": 4774.12,
      "start": 4771.32,
      "text": "不想面对恒大还不了你钱的"
    },
    {
      "end": 4775.12,
      "start": 4774.12,
      "text": "这个灾难结果"
    },
    {
      "end": 4776.32,
      "start": 4775.12,
      "text": "你再骗你自己"
    },
    {
      "end": 4779.32,
      "start": 4776.32,
      "text": "这跟你这人得病了"
    },
    {
      "end": 4781.82,
      "start": 4779.32,
      "text": "给自己扎点什么强行针"
    },
    {
      "end": 4782.62,
      "start": 4781.82,
      "text": "是一模一样"
    },
    {
      "end": 4783.42,
      "start": 4782.62,
      "text": "你必死"
    },
    {
      "end": 4786.52,
      "start": 4783.42,
      "text": "还是没有人可以还得了"
    },
    {
      "end": 4788.32,
      "start": 4786.52,
      "text": "这个恒大三千亿美元的债"
    },
    {
      "end": 4791.12,
      "start": 4788.32,
      "text": "一个六十多亿的公司"
    },
    {
      "end": 4792.72,
      "start": 4791.12,
      "text": "三千亿美元的债"
    },
    {
      "end": 4795.32,
      "start": 4792.72,
      "text": "你不觉得是人类上最荒唐的结局吗"
    },
    {
      "end": 4799.02,
      "start": 4796.12,
      "text": "盘古大官盘古公司"
    },
    {
      "end": 4801.02,
      "start": 4799.02,
      "text": "注射资金才一个亿两个亿"
    },
    {
      "end": 4801.82,
      "start": 4801.02,
      "text": "我都不知道"
    },
    {
      "end": 4804.82,
      "start": 4801.82,
      "text": "净资产一千多个亿"
    },
    {
      "end": 4806.12,
      "start": 4804.82,
      "text": "你让他破产"
    },
    {
      "end": 4808.42,
      "start": 4806.12,
      "text": "你把他杨国给撵大街上去"
    },
    {
      "end": 4811.12,
      "start": 4808.42,
      "text": "他一共六十多亿的注射公司"
    },
    {
      "end": 4813.42,
      "start": 4811.12,
      "text": "欠了两万亿"
    },
    {
      "end": 4814.82,
      "start": 4813.42,
      "text": "你让他活下去"
    },
    {
      "end": 4816.92,
      "start": 4814.82,
      "text": "你觉得中国的经济还能有救吗"
    },
    {
      "end": 4818.42,
      "start": 4816.92,
      "text": "万达"
    },
    {
      "end": 4820.32,
      "start": 4818.42,
      "text": "融创"
    },
    {
      "end": 4821.82,
      "start": 4820.32,
      "text": "绿地"
    },
    {
      "end": 4823.62,
      "start": 4821.82,
      "text": "荣茂"
    },
    {
      "end": 4824.82,
      "start": 4823.62,
      "text": "上海荣茂"
    },
    {
      "end": 4828.52,
      "start": 4824.82,
      "text": "上海荣茂的一千亿烂账意味着啥呀"
    },
    {
      "end": 4830.52,
      "start": 4828.52,
      "text": "大家去算算账去"
    },
    {
      "end": 4832.72,
      "start": 4830.52,
      "text": "荣茂是上海啊"
    },
    {
      "end": 4836.22,
      "start": 4832.72,
      "text": "整个房地产界的绝对劳斯莱斯基"
    },
    {
      "end": 4839.22,
      "start": 4836.22,
      "text": "那背后是江家"
    },
    {
      "end": 4841.52,
      "start": 4839.22,
      "text": "是整个朱镕基家族"
    },
    {
      "end": 4843.02,
      "start": 4841.52,
      "text": "上海几大家族"
    },
    {
      "end": 4845.12,
      "start": 4843.02,
      "text": "包括吴邦国家族都要捧的"
    },
    {
      "end": 4847.32,
      "start": 4845.12,
      "text": "叫上海邦的恒大"
    },
    {
      "end": 4849.12,
      "start": 4847.32,
      "text": "他是不跟你这个"
    },
    {
      "end": 4850.92,
      "start": 4849.12,
      "text": "这所谓北京帮玩的"
    },
    {
      "end": 4854.02,
      "start": 4850.92,
      "text": "荣茂都还不了钱了"
    },
    {
      "end": 4858.52,
      "start": 4854.82,
      "text": "荣茂的房地产是在北京奥运村北边最核心"
    },
    {
      "end": 4860.52,
      "start": 4858.52,
      "text": "唯一在村里边的房地产开发商"
    },
    {
      "end": 4863.42,
      "start": 4860.52,
      "text": "在上海上市最好的地"
    },
    {
      "end": 4865.72,
      "start": 4863.42,
      "text": "整个外滩的地很多都给的他"
    },
    {
      "end": 4868.22,
      "start": 4865.72,
      "text": "他都还不了钱了"
    },
    {
      "end": 4869.92,
      "start": 4868.22,
      "text": "你知道他意味着什么吗"
    },
    {
      "end": 4870.52,
      "start": 4869.92,
      "text": "兄弟姐妹"
    },
    {
      "end": 4874.32,
      "start": 4870.52,
      "text": "所以说你看我可以说过吗"
    },
    {
      "end": 4876.82,
      "start": 4874.32,
      "text": "恒大绝对不是最重要的"
    },
    {
      "end": 4878.02,
      "start": 4876.82,
      "text": "荣创第一重要"
    },
    {
      "end": 4879.32,
      "start": 4878.02,
      "text": "然后像荣茂"
    },
    {
      "end": 4880.12,
      "start": 4879.32,
      "text": "富丽"
    },
    {
      "end": 4881.22,
      "start": 4880.12,
      "text": "万达"
    },
    {
      "end": 4882.72,
      "start": 4881.22,
      "text": "绿地"
    },
    {
      "end": 4883.82,
      "start": 4882.72,
      "text": "和声创展"
    },
    {
      "end": 4886.52,
      "start": 4884.82,
      "text": "大家记住"
    },
    {
      "end": 4888.52,
      "start": 4886.52,
      "text": "就是我当年我到这个"
    },
    {
      "end": 4890.52,
      "start": 4888.52,
      "text": "印尼"
    },
    {
      "end": 4892.52,
      "start": 4890.52,
      "text": "我讲这个独裁苏哈托这个王八蛋"
    },
    {
      "end": 4894.02,
      "start": 4892.52,
      "text": "我跟他家人见面的时候"
    },
    {
      "end": 4895.52,
      "start": 4894.02,
      "text": "晚上喝酒"
    },
    {
      "end": 4897.02,
      "start": 4895.52,
      "text": "我就真的是喝不下去这个酒"
    },
    {
      "end": 4898.52,
      "start": 4897.02,
      "text": "我很少这个情绪化的"
    },
    {
      "end": 4900.52,
      "start": 4898.52,
      "text": "天塌下来我照吃照喝"
    },
    {
      "end": 4902.22,
      "start": 4900.52,
      "text": "就那天我就怎么都吃饭"
    },
    {
      "end": 4904.22,
      "start": 4902.22,
      "text": "我看到香港人大陆人"
    },
    {
      "end": 4905.22,
      "start": 4904.22,
      "text": "对苏哈托家族"
    },
    {
      "end": 4905.92,
      "start": 4905.22,
      "text": "还有儿子"
    },
    {
      "end": 4907.22,
      "start": 4905.92,
      "text": "还有女儿那种恭维"
    },
    {
      "end": 4910.72,
      "start": 4907.22,
      "text": "就这个民族真的让人感到真的是被人家强奸了"
    },
    {
      "end": 4911.22,
      "start": 4910.72,
      "text": "轮奸了"
    },
    {
      "end": 4913.22,
      "start": 4911.22,
      "text": "真的还给人家擦屁股那种"
    },
    {
      "end": 4914.22,
      "start": 4913.22,
      "text": "真的是太不要脸"
    },
    {
      "end": 4915.92,
      "start": 4914.22,
      "text": "我就告诉他儿子"
    },
    {
      "end": 4916.62,
      "start": 4915.92,
      "text": "你记住"
    },
    {
      "end": 4918.62,
      "start": 4916.62,
      "text": "中国人有一天一定给你算账"
    },
    {
      "end": 4922.12,
      "start": 4919.62,
      "text": "其中有一个就是容貌房地产的父老总在场"
    },
    {
      "end": 4924.62,
      "start": 4922.62,
      "text": "我说你这个王八蛋你记住啊"
    },
    {
      "end": 4927.82,
      "start": 4925.62,
      "text": "你的爷爷是移民到香港的"
    },
    {
      "end": 4933.22,
      "start": 4927.82,
      "text": "当时在印尼被杀害的人当中是日本二战的时候"
    },
    {
      "end": 4935.52,
      "start": 4934.42,
      "text": "日本二战的时候"
    },
    {
      "end": 4937.22,
      "start": 4935.52,
      "text": "扎掉了80%香港人"
    },
    {
      "end": 4941.22,
      "start": 4937.22,
      "text": "120万香港人剩了不到十几万香港人"
    },
    {
      "end": 4942.12,
      "start": 4941.22,
      "text": "大家知道吗"
    },
    {
      "end": 4944.92,
      "start": 4942.12,
      "text": "日本在香港的杀撃是一种灭港形式的"
    },
    {
      "end": 4946.72,
      "start": 4944.92,
      "text": "80%被杀掉了"
    },
    {
      "end": 4948.82,
      "start": 4946.72,
      "text": "跑出香港的人到了印尼"
    },
    {
      "end": 4951.22,
      "start": 4948.82,
      "text": "就是最早的印尼华侨和福建华侨"
    },
    {
      "end": 4952.82,
      "start": 4951.22,
      "text": "二代和三代"
    },
    {
      "end": 4956.22,
      "start": 4952.82,
      "text": "结果在印尼时300万华人被杀被碾"
    },
    {
      "end": 4958.02,
      "start": 4956.22,
      "text": "50万人当场干掉"
    },
    {
      "end": 4961.62,
      "start": 4960.22,
      "text": "其中容貌的"
    },
    {
      "end": 4963.82,
      "start": 4962.52,
      "text": "房地产的老总"
    },
    {
      "end": 4966.92,
      "start": 4964.32,
      "text": "还有当时的和声创产的"
    },
    {
      "end": 4968.42,
      "start": 4966.92,
      "text": "里边是财务总经的杀利产"
    },
    {
      "end": 4972.22,
      "start": 4969.02,
      "text": "我说这就是中国记住房地产业的中国人"
    },
    {
      "end": 4973.62,
      "start": 4972.22,
      "text": "几乎没有什么有素质"
    },
    {
      "end": 4976.02,
      "start": 4974.02,
      "text": "有素质的中国人搞不了中国房地产"
    },
    {
      "end": 4977.02,
      "start": 4976.02,
      "text": "要会骗"
    },
    {
      "end": 4978.12,
      "start": 4977.02,
      "text": "要会骗贷款"
    },
    {
      "end": 4979.72,
      "start": 4978.32,
      "text": "要会忽悠小客户"
    },
    {
      "end": 4980.92,
      "start": 4979.92,
      "text": "还敢冒险"
    },
    {
      "end": 4985.42,
      "start": 4981.82,
      "text": "我非常同意外国在曼加顿为啥川普总统被人看不起"
    },
    {
      "end": 4988.22,
      "start": 4985.42,
      "text": "美国有钱人是把房地产当成很low的"
    },
    {
      "end": 4989.22,
      "start": 4988.22,
      "text": "你知道"
    },
    {
      "end": 4991.22,
      "start": 4989.22,
      "text": "这是川普总统很挣扎的一件事"
    },
    {
      "end": 4994.42,
      "start": 4991.22,
      "text": "你们要知道在美国搞房地产是很low的"
    },
    {
      "end": 4995.92,
      "start": 4994.42,
      "text": "在曼加顿没人看得起你"
    },
    {
      "end": 4998.72,
      "start": 4996.82,
      "text": "他到现在也是这样看不起你"
    },
    {
      "end": 5001.82,
      "start": 4999.72,
      "text": "实际上中国房地产很多人看不起你"
    },
    {
      "end": 5003.02,
      "start": 5001.82,
      "text": "我是很同意的"
    },
    {
      "end": 5005.52,
      "start": 5003.02,
      "text": "我没见过房地产只有几个真的有水平的"
    },
    {
      "end": 5008.42,
      "start": 5006.12,
      "text": "我为啥我觉得柳传之人家是有水平的"
    },
    {
      "end": 5011.12,
      "start": 5008.52,
      "text": "人家是搞技术的还有技术含量的"
    },
    {
      "end": 5013.92,
      "start": 5011.32,
      "text": "房地产都一帮的混蛋都一帮冒险家"
    },
    {
      "end": 5016.92,
      "start": 5013.92,
      "text": "今天你在恒大事件看出来了"
    },
    {
      "end": 5019.72,
      "start": 5017.32,
      "text": "一帮子骗的一帮的谎言"
    },
    {
      "end": 5022.82,
      "start": 5019.72,
      "text": "一帮子没有任何社会道德社会良知的人"
    },
    {
      "end": 5026.12,
      "start": 5023.32,
      "text": "老百姓把一生三代都压给你了"
    },
    {
      "end": 5027.32,
      "start": 5026.12,
      "text": "你还在骗老百姓呢"
    },
    {
      "end": 5030.72,
      "start": 5029.42,
      "text": "这就是刚才看到这个"
    },
    {
      "end": 5033.22,
      "start": 5030.72,
      "text": "你见过有一个地产商有一个有良知的行动吗"
    },
    {
      "end": 5035.42,
      "start": 5033.42,
      "text": "你见过一个地产商像盘股一样"
    },
    {
      "end": 5038.02,
      "start": 5035.62,
      "text": "走出给员工补偿要求N加2"
    },
    {
      "end": 5039.12,
      "start": 5038.02,
      "text": "法院给N加1"
    },
    {
      "end": 5041.92,
      "start": 5039.62,
      "text": "盘股公司要给离开的时候要搬家费"
    },
    {
      "end": 5047.12,
      "start": 5041.92,
      "text": "行李费车费还有什么也包括有孩子的养奶费都想给了"
    },
    {
      "end": 5049.22,
      "start": 5047.32,
      "text": "因为盘股当然有钱啊"
    },
    {
      "end": 5051.82,
      "start": 5050.22,
      "text": "6亿现金是不是"
    },
    {
      "end": 5054.12,
      "start": 5052.12,
      "text": "发100次都发不完是吧"
    },
    {
      "end": 5054.72,
      "start": 5054.12,
      "text": "这员工"
    },
    {
      "end": 5056.32,
      "start": 5055.22,
      "text": "因为他有钱"
    },
    {
      "end": 5057.62,
      "start": 5056.52,
      "text": "这是刘彦平说的"
    },
    {
      "end": 5060.02,
      "start": 5057.62,
      "text": "这是比阿里巴巴2017年说的"
    },
    {
      "end": 5062.32,
      "start": 5060.02,
      "text": "是中国最好的企业当时说15%"
    },
    {
      "end": 5064.12,
      "start": 5062.32,
      "text": "我说没有只有5%负债"
    },
    {
      "end": 5068.22,
      "start": 5065.22,
      "text": "在美国如果有一个50%负债的公司"
    },
    {
      "end": 5069.72,
      "start": 5068.22,
      "text": "那你的公司是美国最好的"
    },
    {
      "end": 5073.82,
      "start": 5070.72,
      "text": "我们是5%的负债是天下最好的"
    },
    {
      "end": 5076.72,
      "start": 5074.62,
      "text": "那么房地产商你要明白问题"
    },
    {
      "end": 5079.52,
      "start": 5076.72,
      "text": "是多少你一个60多亿的注册公司"
    },
    {
      "end": 5080.92,
      "start": 5079.52,
      "text": "6亿多还是我不知道恒当"
    },
    {
      "end": 5082.72,
      "start": 5081.12,
      "text": "你带了2万亿"
    },
    {
      "end": 5084.52,
      "start": 5082.72,
      "text": "你带了2万亿的钱呢"
    },
    {
      "end": 5085.92,
      "start": 5084.52,
      "text": "这就是个骗局啊"
    },
    {
      "end": 5087.32,
      "start": 5085.92,
      "text": "这是个犯罪集团啊"
    },
    {
      "end": 5089.12,
      "start": 5087.72,
      "text": "那哪一家又不是呢"
    },
    {
      "end": 5090.12,
      "start": 5089.12,
      "text": "连容貌都是"
    },
    {
      "end": 5093.42,
      "start": 5092.62,
      "text": "兄弟姐妹们"
    },
    {
      "end": 5095.52,
      "start": 5093.42,
      "text": "所以说这个房地产不是开玩笑的"
    },
    {
      "end": 5097.12,
      "start": 5095.92,
      "text": "冬奥会之后"
    },
    {
      "end": 5098.62,
      "start": 5097.12,
      "text": "房地产崩塌的时候"
    },
    {
      "end": 5100.62,
      "start": 5098.62,
      "text": "你会看到无数的人"
    },
    {
      "end": 5102.82,
      "start": 5101.42,
      "text": "魂飞魄散"
    },
    {
      "end": 5103.72,
      "start": 5102.82,
      "text": "为啥叫魂飞魄散"
    },
    {
      "end": 5104.62,
      "start": 5103.72,
      "text": "你不是没家了"
    },
    {
      "end": 5105.92,
      "start": 5104.62,
      "text": "不是像旁古鸟到大街上"
    },
    {
      "end": 5106.92,
      "start": 5105.92,
      "text": "动你临下十度"
    },
    {
      "end": 5109.62,
      "start": 5107.42,
      "text": "还有人后边追杀要钱"
    },
    {
      "end": 5112.72,
      "start": 5111.52,
      "text": "就像这个四川那些"
    },
    {
      "end": 5114.72,
      "start": 5112.72,
      "text": "我这个老的同事"
    },
    {
      "end": 5115.62,
      "start": 5115.12,
      "text": "是吧"
    },
    {
      "end": 5117.42,
      "start": 5116.02,
      "text": "人家原来挣了钱"
    },
    {
      "end": 5118.32,
      "start": 5117.42,
      "text": "人家买的房子"
    },
    {
      "end": 5119.82,
      "start": 5118.32,
      "text": "人家不欠贷款"
    },
    {
      "end": 5122.02,
      "start": 5120.32,
      "text": "不欠贷款的你不能卖"
    },
    {
      "end": 5125.52,
      "start": 5124.12,
      "text": "在北京有贷款的"
    },
    {
      "end": 5127.12,
      "start": 5125.52,
      "text": "你现在你要听我的"
    },
    {
      "end": 5129.22,
      "start": 5127.12,
      "text": "还要假贷款还利息"
    },
    {
      "end": 5131.42,
      "start": 5130.42,
      "text": "你像这这这"
    },
    {
      "end": 5132.52,
      "start": 5131.42,
      "text": "这是个什么概念"
    },
    {
      "end": 5134.12,
      "start": 5132.52,
      "text": "哪有这种不要脸的事情啊"
    },
    {
      "end": 5135.52,
      "start": 5134.72,
      "text": "人家的房子"
    },
    {
      "end": 5136.32,
      "start": 5135.52,
      "text": "你不让人家卖"
    },
    {
      "end": 5137.12,
      "start": 5136.32,
      "text": "人家贷款"
    },
    {
      "end": 5138.32,
      "start": 5137.12,
      "text": "他要假贷款还你利息"
    },
    {
      "end": 5140.22,
      "start": 5138.32,
      "text": "你现在天下哪有这种事情"
    },
    {
      "end": 5141.82,
      "start": 5140.62,
      "text": "我又要跟你上床"
    },
    {
      "end": 5143.42,
      "start": 5142.42,
      "text": "我还不想脱裤子"
    },
    {
      "end": 5145.92,
      "start": 5144.92,
      "text": "就这种是吧"
    },
    {
      "end": 5147.42,
      "start": 5146.22,
      "text": "这是什么概念这是"
    },
    {
      "end": 5149.32,
      "start": 5148.42,
      "text": "所以说房地产"
    },
    {
      "end": 5150.22,
      "start": 5149.32,
      "text": "今天讲到这的时候"
    },
    {
      "end": 5150.82,
      "start": 5150.22,
      "text": "兄弟姐妹们"
    },
    {
      "end": 5152.92,
      "start": 5151.32,
      "text": "它一定是会成为"
    },
    {
      "end": 5154.82,
      "start": 5152.92,
      "text": "中国共产党灭亡的最核心"
    },
    {
      "end": 5156.92,
      "start": 5155.82,
      "text": "一定是"
    },
    {
      "end": 5158.52,
      "start": 5157.12,
      "text": "导致血崩的那个"
    },
    {
      "end": 5159.72,
      "start": 5158.52,
      "text": "关键的血花"
    },
    {
      "end": 5161.62,
      "start": 5160.12,
      "text": "所以今天我请兄弟姐妹们"
    },
    {
      "end": 5162.62,
      "start": 5161.62,
      "text": "但凡有家人的"
    },
    {
      "end": 5163.82,
      "start": 5162.62,
      "text": "你不要要求结果"
    },
    {
      "end": 5165.32,
      "start": 5164.22,
      "text": "一定告诉家人"
    },
    {
      "end": 5167.22,
      "start": 5165.72,
      "text": "能拿一块拿一块"
    },
    {
      "end": 5168.72,
      "start": 5167.22,
      "text": "能拿一毛拿一毛"
    },
    {
      "end": 5170.02,
      "start": 5168.92,
      "text": "赶快揍人"
    },
    {
      "end": 5173.22,
      "start": 5171.72,
      "text": "这就是今天讲房地产的目的"
    },
    {
      "end": 5174.42,
      "start": 5174.02,
      "text": "谢谢"
    },
    {
      "end": 5175.12,
      "start": 5174.62,
      "text": "说完了"
    },
    {
      "end": 5177.02,
      "start": 5175.12,
      "text": "掌声响起"
    },
    {
      "end": 5177.82,
      "start": 5177.02,
      "text": "你们不哭啥"
    },
    {
      "end": 5179.22,
      "start": 5177.82,
      "text": "我俩就不哭了"
    },
    {
      "end": 5181.72,
      "start": 5181.22,
      "text": "感谢"
    },
    {
      "end": 5182.72,
      "start": 5181.72,
      "text": "听入神了"
    },
    {
      "end": 5183.32,
      "start": 5182.72,
      "text": "哈哈哈"
    },
    {
      "end": 5184.22,
      "start": 5183.32,
      "text": "谢谢七哥"
    },
    {
      "end": 5185.12,
      "start": 5184.22,
      "text": "这种分享"
    },
    {
      "end": 5185.72,
      "start": 5185.12,
      "text": "真的"
    },
    {
      "end": 5186.32,
      "start": 5185.72,
      "text": "大家"
    },
    {
      "end": 5188.22,
      "start": 5186.32,
      "text": "最后说的这句话"
    },
    {
      "end": 5189.02,
      "start": 5188.22,
      "text": "真的"
    },
    {
      "end": 5189.82,
      "start": 5189.32,
      "text": "想办"
    },
    {
      "end": 5190.72,
      "start": 5189.82,
      "text": "想办设法"
    },
    {
      "end": 5191.92,
      "start": 5191.32,
      "text": "一定要"
    },
    {
      "end": 5193.02,
      "start": 5192.12,
      "text": "哪怕少赔一点"
    },
    {
      "end": 5194.02,
      "start": 5193.02,
      "text": "少赔一点"
    },
    {
      "end": 5194.52,
      "start": 5194.02,
      "text": "现在"
    },
    {
      "end": 5195.32,
      "start": 5194.72,
      "text": "能出手的"
    },
    {
      "end": 5196.02,
      "start": 5195.32,
      "text": "赶紧出手"
    },
    {
      "end": 5198.52,
      "start": 5196.52,
      "text": "尽量能躲过这场危机"
    },
    {
      "end": 5200.02,
      "start": 5199.72,
      "text": "那好"
    },
    {
      "end": 5200.72,
      "start": 5200.02,
      "text": "那接下来"
    },
    {
      "end": 5201.32,
      "start": 5200.72,
      "text": "七哥"
    },
    {
      "end": 5202.52,
      "start": 5201.32,
      "text": "我能问个问题吗"
    },
    {
      "end": 5204.32,
      "start": 5202.52,
      "text": "第二个问题可以吗"
    },
    {
      "end": 5206.12,
      "start": 5205.12,
      "text": "好"
    },
    {
      "end": 5206.92,
      "start": 5206.12,
      "text": "您请"
    },
    {
      "end": 5209.72,
      "start": 5208.72,
      "text": "那个七哥"
    },
    {
      "end": 5210.62,
      "start": 5209.72,
      "text": "我想问一下"
    },
    {
      "end": 5212.02,
      "start": 5210.62,
      "text": "现在国内的房地产"
    },
    {
      "end": 5212.92,
      "start": 5212.02,
      "text": "它是"
    },
    {
      "end": 5214.92,
      "start": 5213.42,
      "text": "就是已经都是限量了"
    },
    {
      "end": 5216.22,
      "start": 5214.92,
      "text": "就是说它定价了"
    },
    {
      "end": 5217.12,
      "start": 5216.22,
      "text": "它不会让你"
    },
    {
      "end": 5217.52,
      "start": 5217.12,
      "text": "就是说"
    },
    {
      "end": 5218.52,
      "start": 5217.52,
      "text": "比如说现在"
    },
    {
      "end": 5220.72,
      "start": 5218.52,
      "text": "这个房子可以卖到700万"
    },
    {
      "end": 5221.62,
      "start": 5220.72,
      "text": "但是它不允许"
    },
    {
      "end": 5222.62,
      "start": 5221.62,
      "text": "它只允许你"
    },
    {
      "end": 5224.02,
      "start": 5222.62,
      "text": "就是挂在500万"
    },
    {
      "end": 5225.62,
      "start": 5224.02,
      "text": "但是真正到了500万的"
    },
    {
      "end": 5226.62,
      "start": 5225.62,
      "text": "这个房子的时候"
    },
    {
      "end": 5227.52,
      "start": 5226.92,
      "text": "其实"
    },
    {
      "end": 5229.42,
      "start": 5227.82,
      "text": "在买方来说"
    },
    {
      "end": 5231.12,
      "start": 5229.42,
      "text": "它是银行带不出来钱的"
    },
    {
      "end": 5233.22,
      "start": 5231.32,
      "text": "除非你是现金全部交易"
    },
    {
      "end": 5234.12,
      "start": 5233.22,
      "text": "但不是所有人"
    },
    {
      "end": 5235.62,
      "start": 5234.12,
      "text": "都可以有现金交易的"
    },
    {
      "end": 5236.12,
      "start": 5235.62,
      "text": "但是"
    },
    {
      "end": 5238.22,
      "start": 5237.12,
      "text": "我们告诉家人"
    },
    {
      "end": 5239.62,
      "start": 5238.22,
      "text": "你尽量能卖就卖"
    },
    {
      "end": 5241.32,
      "start": 5239.62,
      "text": "这也是很难的一件事"
    },
    {
      "end": 5242.52,
      "start": 5241.32,
      "text": "这个要怎么去"
    },
    {
      "end": 5244.22,
      "start": 5242.52,
      "text": "跟他们去讲这件事呢"
    },
    {
      "end": 5245.12,
      "start": 5244.22,
      "text": "还有一个"
    },
    {
      "end": 5245.92,
      "start": 5245.12,
      "text": "他们都是说"
    },
    {
      "end": 5247.02,
      "start": 5245.92,
      "text": "把现在的房子"
    },
    {
      "end": 5247.92,
      "start": 5247.02,
      "text": "就是尽量"
    },
    {
      "end": 5248.92,
      "start": 5247.92,
      "text": "比如说铺垫房"
    },
    {
      "end": 5250.32,
      "start": 5248.92,
      "text": "还有自己住的房子"
    },
    {
      "end": 5252.62,
      "start": 5250.32,
      "text": "都到银行去做一个再次抵押"
    },
    {
      "end": 5253.62,
      "start": 5252.62,
      "text": "可以借出来"
    },
    {
      "end": 5255.02,
      "start": 5253.62,
      "text": "就是可以抵押出钱来"
    },
    {
      "end": 5256.22,
      "start": 5255.02,
      "text": "然后再去还利息"
    },
    {
      "end": 5258.22,
      "start": 5256.22,
      "text": "那这样是不是一个好的解决方法"
    },
    {
      "end": 5259.02,
      "start": 5258.22,
      "text": "或者是说"
    },
    {
      "end": 5260.12,
      "start": 5259.02,
      "text": "如果当这个房地产"
    },
    {
      "end": 5261.32,
      "start": 5260.12,
      "text": "崩塌的时候"
    },
    {
      "end": 5262.82,
      "start": 5261.32,
      "text": "是不是也是让人又来要追杀"
    },
    {
      "end": 5263.82,
      "start": 5262.82,
      "text": "又来还钱"
    },
    {
      "end": 5266.82,
      "start": 5263.82,
      "text": "因为没有东西可以让他再去生钱了"
    },
    {
      "end": 5268.32,
      "start": 5266.82,
      "text": "我想请"
    },
    {
      "end": 5268.82,
      "start": 5268.32,
      "text": "齐哥"
    },
    {
      "end": 5269.32,
      "start": 5268.82,
      "text": "很难"
    },
    {
      "end": 5269.72,
      "start": 5269.32,
      "text": "很难"
    },
    {
      "end": 5270.82,
      "start": 5269.72,
      "text": "让我们解释一下"
    },
    {
      "end": 5271.82,
      "start": 5270.82,
      "text": "仅仅深圳"
    },
    {
      "end": 5273.82,
      "start": 5271.82,
      "text": "你看丽莎你问的问题非常好的"
    },
    {
      "end": 5275.82,
      "start": 5273.82,
      "text": "就像你想掏现的很难很难"
    },
    {
      "end": 5278.32,
      "start": 5275.82,
      "text": "仅仅过去七个月"
    },
    {
      "end": 5280.32,
      "start": 5278.32,
      "text": "香港的商铺"
    },
    {
      "end": 5282.32,
      "start": 5280.32,
      "text": "流进的资金"
    },
    {
      "end": 5283.82,
      "start": 5282.32,
      "text": "是多少钱呢"
    },
    {
      "end": 5285.32,
      "start": 5283.82,
      "text": "6000多亿"
    },
    {
      "end": 5287.82,
      "start": 5285.32,
      "text": "6000多亿"
    },
    {
      "end": 5290.82,
      "start": 5287.82,
      "text": "你可以算出这一个账就出来了"
    },
    {
      "end": 5292.32,
      "start": 5290.82,
      "text": "一个小小的香港值钱"
    },
    {
      "end": 5293.82,
      "start": 5292.32,
      "text": "就是九龙两条街"
    },
    {
      "end": 5296.82,
      "start": 5293.82,
      "text": "中环几条街和湾仔几条街"
    },
    {
      "end": 5298.82,
      "start": 5296.82,
      "text": "商铺暴涨"
    },
    {
      "end": 5300.82,
      "start": 5298.82,
      "text": "说明什么问题"
    },
    {
      "end": 5303.82,
      "start": 5300.82,
      "text": "这6000亿几乎99%都是大陆的钱"
    },
    {
      "end": 5305.82,
      "start": 5303.82,
      "text": "不是外国的钱"
    },
    {
      "end": 5308.82,
      "start": 5305.82,
      "text": "说明大陆的人很多透明人"
    },
    {
      "end": 5309.82,
      "start": 5308.82,
      "text": "还有共产党的官员"
    },
    {
      "end": 5312.32,
      "start": 5309.82,
      "text": "绝大多数都当官的人的家人"
    },
    {
      "end": 5314.32,
      "start": 5312.32,
      "text": "把国内的物业处理掉"
    },
    {
      "end": 5316.82,
      "start": 5314.32,
      "text": "到香港去买了香港的商铺"
    },
    {
      "end": 5318.82,
      "start": 5316.82,
      "text": "香港的商铺"
    },
    {
      "end": 5320.82,
      "start": 5318.82,
      "text": "它是唯一可能跌一半"
    },
    {
      "end": 5322.82,
      "start": 5320.82,
      "text": "它不会跌到零的"
    },
    {
      "end": 5326.32,
      "start": 5322.82,
      "text": "而香港的豪宅是跌的"
    },
    {
      "end": 5328.82,
      "start": 5326.32,
      "text": "你这一点就能看出来就是"
    },
    {
      "end": 5329.82,
      "start": 5328.82,
      "text": "谁先跑"
    },
    {
      "end": 5332.82,
      "start": 5329.82,
      "text": "永远是共产党的亲爹亲娘亲闺妮"
    },
    {
      "end": 5334.82,
      "start": 5332.82,
      "text": "私生子女他们先跑"
    },
    {
      "end": 5336.82,
      "start": 5334.82,
      "text": "他们这小三小四先跑"
    },
    {
      "end": 5338.82,
      "start": 5336.82,
      "text": "这就是你问的问题非常好"
    },
    {
      "end": 5340.82,
      "start": 5338.82,
      "text": "国内战友咱们很多老百姓"
    },
    {
      "end": 5341.82,
      "start": 5340.82,
      "text": "你跑你往哪跑"
    },
    {
      "end": 5342.82,
      "start": 5341.82,
      "text": "你套不成线"
    },
    {
      "end": 5343.82,
      "start": 5342.82,
      "text": "你贷不了款"
    },
    {
      "end": 5344.82,
      "start": 5343.82,
      "text": "别人接不了手"
    },
    {
      "end": 5345.82,
      "start": 5344.82,
      "text": "即使你卖完了"
    },
    {
      "end": 5346.82,
      "start": 5345.82,
      "text": "你钱"
    },
    {
      "end": 5348.82,
      "start": 5346.82,
      "text": "你想把钱安全了都做不到"
    },
    {
      "end": 5351.82,
      "start": 5348.82,
      "text": "这是很可怕的立山你知道吗"
    },
    {
      "end": 5353.82,
      "start": 5351.82,
      "text": "就是太多这种故事了"
    },
    {
      "end": 5355.82,
      "start": 5353.82,
      "text": "我这有个朋友在成德的房子"
    },
    {
      "end": 5357.82,
      "start": 5355.82,
      "text": "在北京的房子全部处理完"
    },
    {
      "end": 5361.82,
      "start": 5357.82,
      "text": "都是打了八折七折卖完"
    },
    {
      "end": 5363.82,
      "start": 5361.82,
      "text": "钱到银行钱不让动了"
    },
    {
      "end": 5365.82,
      "start": 5363.82,
      "text": "纪委来找他"
    },
    {
      "end": 5367.82,
      "start": 5365.82,
      "text": "说你太太是国家公务员"
    },
    {
      "end": 5369.82,
      "start": 5367.82,
      "text": "你这钱哪来的"
    },
    {
      "end": 5371.82,
      "start": 5369.82,
      "text": "大概也小了将近两个亿呢"
    },
    {
      "end": 5373.82,
      "start": 5371.82,
      "text": "完了这哥们傻了"
    },
    {
      "end": 5375.82,
      "start": 5373.82,
      "text": "肯定也有说不出来的地方"
    },
    {
      "end": 5377.82,
      "start": 5375.82,
      "text": "说宁可拜全捐给国家"
    },
    {
      "end": 5378.82,
      "start": 5377.82,
      "text": "能不能不查我们了"
    },
    {
      "end": 5379.82,
      "start": 5378.82,
      "text": "捐钱也不行"
    },
    {
      "end": 5381.82,
      "start": 5379.82,
      "text": "把钱的来路房产的来路得查清楚"
    },
    {
      "end": 5385.82,
      "start": 5381.82,
      "text": "就是你想想习近平家卖房产有人去查吗"
    },
    {
      "end": 5387.82,
      "start": 5385.82,
      "text": "王岐山家卖房有人去查"
    },
    {
      "end": 5388.82,
      "start": 5387.82,
      "text": "没有人去查"
    },
    {
      "end": 5390.82,
      "start": 5388.82,
      "text": "孟建柱家卖人也没去查"
    },
    {
      "end": 5393.82,
      "start": 5390.82,
      "text": "就是6000多亿的香港的商业地产"
    },
    {
      "end": 5394.82,
      "start": 5393.82,
      "text": "证明了一个现象"
    },
    {
      "end": 5397.82,
      "start": 5394.82,
      "text": "共产党任何在灾难面前"
    },
    {
      "end": 5399.82,
      "start": 5397.82,
      "text": "他们家族都是利益优先"
