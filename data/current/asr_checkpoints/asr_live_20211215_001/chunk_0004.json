  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 3603.96,
      "start": 3600.0,
      "text": "我的女兒生下來以後長大18歲以後就是跟盤古活著的"
    },
    {
      "end": 3606.7,
      "start": 3604.3,
      "text": "他說我們一家兩代人都買了房子"
    },
    {
      "end": 3609.24,
      "start": 3607.24,
      "text": "他說現在我們在北京想賣房子說"
    },
    {
      "end": 3611.88,
      "start": 3609.82,
      "text": "我們降價賣不讓我們賣"
    },
    {
      "end": 3616.18,
      "start": 3614.06,
      "text": "而且一家人在過去他說"
    },
    {
      "end": 3620.16,
      "start": 3616.18,
      "text": "郭先生我就聽了你的我們全家買了正權的房子"
    },
    {
      "end": 3623.4,
      "start": 3620.16,
      "text": "也就是付了300塊人民幣的定金買的平方米的房子"
    },
    {
      "end": 3626.2,
      "start": 3624.04,
      "text": "他說每套房子都賺了兩千多萬"
    },
    {
      "end": 3629.6,
      "start": 3626.58,
      "text": "又聽了你七哥的直播我們把房子給賣了"
    },
    {
      "end": 3632.1,
      "start": 3630.72,
      "text": "我們錢也都拿回來了"
    },
    {
      "end": 3634.6,
      "start": 3632.32,
      "text": "現在是我們在外邊買的房子"
    },
    {
      "end": 3637.24,
      "start": 3635.24,
      "text": "就是打折賣沒人買"
    },
    {
      "end": 3641.8,
      "start": 3639.38,
      "text": "這是一個我們兩代的房子就沒聽你沒了"
    },
    {
      "end": 3644.84,
      "start": 3642.06,
      "text": "他說不但是我們這樣是整個北京"
    },
    {
      "end": 3646.8,
      "start": 3644.84,
      "text": "他說我問了一下我們四川的老鄉"
    },
    {
      "end": 3650.0,
      "start": 3647.32,
      "text": "幾乎是只要超過500萬的房子"
    },
    {
      "end": 3652.5,
      "start": 3650.48,
      "text": "你掛牌以後跟那個市場能要這樣"
    },
    {
      "end": 3653.5,
      "start": 3652.66,
      "text": "根本不可能"
    },
    {
      "end": 3655.28,
      "start": 3653.84,
      "text": "他最可怕的是銀行"
    },
    {
      "end": 3658.24,
      "start": 3655.78,
      "text": "他說銀行在春節前還讓我們跟他做假賬"
    },
    {
      "end": 3660.34,
      "start": 3658.24,
      "text": "什麼還貸款呢"
    },
    {
      "end": 3661.34,
      "start": 3660.34,
      "text": "你多給我點錢呢"
    },
    {
      "end": 3662.84,
      "start": 3661.34,
      "text": "我借給你點錢呢"
    },
    {
      "end": 3663.84,
      "start": 3662.84,
      "text": "你給我充實什麼貸款"
    },
    {
      "end": 3665.48,
      "start": 3663.84,
      "text": "他一堆複雜的東西"
    },
    {
      "end": 3668.84,
      "start": 3666.64,
      "text": "最後我們這位老戰友的娘"
    },
    {
      "end": 3670.34,
      "start": 3668.84,
      "text": "第一代戰友"
    },
    {
      "end": 3671.84,
      "start": 3670.34,
      "text": "第一代這個員工"
    },
    {
      "end": 3675.64,
      "start": 3671.84,
      "text": "他說郭先生是你讓我們變成了一切不一樣"
    },
    {
      "end": 3679.24,
      "start": 3675.64,
      "text": "但是現在是真的一切又想把我們打回到原形一樣"
    },
    {
      "end": 3683.74,
      "start": 3679.24,
      "text": "孩子去公司給的是N加2補償"
    },
    {
      "end": 3687.74,
      "start": 3683.74,
      "text": "公司據說我都不知道因為沒有任何能夠聯繫"
    },
    {
      "end": 3692.24,
      "start": 3687.74,
      "text": "結果是法院說不允許給N加1補償"
    },
    {
      "end": 3696.74,
      "start": 3692.74,
      "text": "大家你們要看一看全中國南北發行什麼事情"
    },
    {
      "end": 3699.24,
      "start": 3696.74,
      "text": "很多公司這事情就人家員工工這麼長"
    },
    {
      "end": 3701.34,
      "start": 3699.24,
      "text": "人家就該得到這個補償"
    },
    {
      "end": 3704.34,
      "start": 3701.34,
      "text": "當然盤古和玉達是最特別的公司"
    },
    {
      "end": 3705.34,
      "start": 3704.34,
      "text": "清理兵重"
    },
    {
      "end": 3707.34,
      "start": 3705.34,
      "text": "給員工公司這種情況下"
    },
    {
      "end": 3708.14,
      "start": 3707.34,
      "text": "記住啊"
    },
    {
      "end": 3710.34,
      "start": 3708.14,
      "text": "已經被全部沒收的情況下"
    },
    {
      "end": 3711.84,
      "start": 3710.34,
      "text": "還給N加2補償"
    },
    {
      "end": 3712.34,
      "start": 3711.84,
      "text": "法院不同意"
    },
    {
      "end": 3713.34,
      "start": 3712.34,
      "text": "N加1"
    },
    {
      "end": 3717.84,
      "start": 3714.34,
      "text": "公司要給所有員工遣三費之外的回家費"
    },
    {
      "end": 3718.64,
      "start": 3717.84,
      "text": "路費"
    },
    {
      "end": 3719.34,
      "start": 3718.64,
      "text": "搬家費"
    },
    {
      "end": 3722.24,
      "start": 3719.34,
      "text": "全部都是按三個月的工資給"
    },
    {
      "end": 3723.34,
      "start": 3722.24,
      "text": "法院不同意"
    },
    {
      "end": 3726.94,
      "start": 3723.34,
      "text": "更重要的事情"
    },
    {
      "end": 3728.64,
      "start": 3726.94,
      "text": "我們這位戰友的娘說了一句話"
    },
    {
      "end": 3730.74,
      "start": 3728.64,
      "text": "她說妳知道在我們老家現在發生什麼事"
    },
    {
      "end": 3732.74,
      "start": 3730.74,
      "text": "在我們老家的房子"
    },
    {
      "end": 3735.54,
      "start": 3732.74,
      "text": "現在政府登記完以後"
    },
    {
      "end": 3739.14,
      "start": 3735.54,
      "text": "馬上的要求妳答應"
    },
    {
      "end": 3740.24,
      "start": 3739.14,
      "text": "像咱們索幣呀"
    },
    {
      "end": 3741.04,
      "start": 3740.24,
      "text": "幣家嘴一樣"
    },
    {
      "end": 3742.34,
      "start": 3741.04,
      "text": "他們叫幣家房"
    },
    {
      "end": 3744.94,
      "start": 3742.34,
      "text": "三到五年內不能賣"
    },
    {
      "end": 3746.94,
      "start": 3744.94,
      "text": "因為妳曾經有過三套房"
    },
    {
      "end": 3751.84,
      "start": 3746.94,
      "text": "這不是已經共產"
    },
    {
      "end": 3753.84,
      "start": 3751.84,
      "text": "已經不是搶錢"
    },
    {
      "end": 3755.64,
      "start": 3753.84,
      "text": "已經不是山東養狗"
    },
    {
      "end": 3756.54,
      "start": 3755.64,
      "text": "養狗啊"
    },
    {
      "end": 3758.94,
      "start": 3756.54,
      "text": "警察告訴妳養狗一百塊人民幣"
    },
    {
      "end": 3761.14,
      "start": 3758.94,
      "text": "現在房子三年鎖房"
    },
    {
      "end": 3764.54,
      "start": 3762.14,
      "text": "而且銀行給妳造假"
    },
    {
      "end": 3766.64,
      "start": 3764.54,
      "text": "提前交三年物業管理費"
    },
    {
      "end": 3768.84,
      "start": 3766.64,
      "text": "銀行帶給妳的物業管理費"
    },
    {
      "end": 3773.94,
      "start": 3769.74,
      "text": "房地產現在是共產黨捂不住的"
    },
    {
      "end": 3776.54,
      "start": 3773.94,
      "text": "在庫當下那個大窟窿了已經"
    },
    {
      "end": 3778.94,
      "start": 3777.14,
      "text": "這是個天大的事情"
    },
    {
      "end": 3781.24,
      "start": 3778.94,
      "text": "這為什麼今天我們還要祭壇房產"
    },
    {
      "end": 3782.94,
      "start": 3781.24,
      "text": "讓所有的國內的同胞們"
    },
    {
      "end": 3784.54,
      "start": 3782.94,
      "text": "妳們一定要記住"
    },
    {
      "end": 3786.04,
      "start": 3784.54,
      "text": "我們告訴妳今天的話"
    },
    {
      "end": 3788.24,
      "start": 3786.04,
      "text": "房地產可以毀掉妳兩代人"
    },
    {
      "end": 3788.84,
      "start": 3788.24,
      "text": "三代人"
    },
    {
      "end": 3789.34,
      "start": 3788.84,
      "text": "四代人"
    },
    {
      "end": 3790.54,
      "start": 3789.34,
      "text": "或者妳成為房奴"
    },
    {
      "end": 3793.04,
      "start": 3791.34,
      "text": "咱現在暫時暫時這個"
    },
    {
      "end": 3794.24,
      "start": 3793.04,
      "text": "房地產現在的情況"
    },
    {
      "end": 3796.54,
      "start": 3796.14,
      "text": "好"
    },
    {
      "end": 3797.74,
      "start": 3796.54,
      "text": "就請草哥小哥"
    },
    {
      "end": 3800.24,
      "start": 3799.64,
      "text": "好的"
    },
    {
      "end": 3809.04,
      "start": 3800.24,
      "text": "中共房地產危局"
    },
    {
      "end": 3811.54,
      "start": 3809.04,
      "text": "謝謝咱們財經俱樂部和青山先生"
    },
    {
      "end": 3812.34,
      "start": 3811.54,
      "text": "OK"
    },
    {
      "end": 3812.94,
      "start": 3812.34,
      "text": "下一頁"
    },
    {
      "end": 3813.54,
      "start": 3812.94,
      "text": "大波"
    },
    {
      "end": 3818.04,
      "start": 3813.54,
      "text": "支撐中共虛假繁榮經濟的房地產已經完蛋了"
    },
    {
      "end": 3820.84,
      "start": 3818.04,
      "text": "根據這個貝殼研究院提供的數據"
    },
    {
      "end": 3826.74,
      "start": 3820.84,
      "text": "2021年第三季度全國351座城市住宅用地成交金額1.08萬億"
    },
    {
      "end": 3828.84,
      "start": 3826.74,
      "text": "同比下滑了37.01%"
    },
    {
      "end": 3831.54,
      "start": 3828.84,
      "text": "1到3季度累計成交額4.21萬億"
    },
    {
      "end": 3833.84,
      "start": 3831.54,
      "text": "同比下跌7.63"
    },
    {
      "end": 3839.14,
      "start": 3834.24,
      "text": "3季度成交規劃建築面積為3.09萬億平方米"
    },
    {
      "end": 3841.34,
      "start": 3839.14,
      "text": "同比下滑47.5%"
    },
    {
      "end": 3842.74,
      "start": 3841.64,
      "text": "這幾乎斷崖式"
    },
    {
      "end": 3843.44,
      "start": 3842.74,
      "text": "一日"
    },
    {
      "end": 3849.54,
      "start": 3844.04,
      "text": "三季度累計成交規劃建築面積為11.11萬億平方米"
    },
    {
      "end": 3851.84,
      "start": 3849.54,
      "text": "同比下跌28.44%"
    },
    {
      "end": 3853.84,
      "start": 3851.84,
      "text": "2021年1到9月"
    },
    {
      "end": 3856.94,
      "start": 3854.34,
      "text": "一共流拍地塊762宗"
    },
    {
      "end": 3858.54,
      "start": 3856.94,
      "text": "流拍率為12.1%"
    },
    {
      "end": 3861.64,
      "start": 3858.84,
      "text": "較去年同期增長2.6%"
    },
    {
      "end": 3864.14,
      "start": 3862.34,
      "text": "在第二批集中工地中"
    },
    {
      "end": 3866.94,
      "start": 3864.14,
      "text": "20個城市共有265宗地塊"
    },
    {
      "end": 3868.54,
      "start": 3866.94,
      "text": "走到流拍撤牌"
    },
    {
      "end": 3872.04,
      "start": 3868.74,
      "text": "占到這個推出地塊數量的31.8%"
    },
    {
      "end": 3876.64,
      "start": 3872.04,
      "text": "北京第二批集中工地掛牌43宗地塊"
    },
    {
      "end": 3881.04,
      "start": 3876.64,
      "text": "有17宗成交流拍撤牌率為60.5%"
    },
    {
      "end": 3883.44,
      "start": 3881.04,
      "text": "這廣州共推出48宗地塊"
    },
    {
      "end": 3886.64,
      "start": 3883.64,
      "text": "流拍25宗流拍率52.1%"
    },
    {
      "end": 3888.84,
      "start": 3886.64,
      "text": "就是在一線城市可能這個更嚴重"
    },
    {
      "end": 3889.64,
      "start": 3888.84,
      "text": "OK"
    },
    {
      "end": 3890.94,
      "start": 3889.64,
      "text": "麻煩導播下一頁"
    },
    {
      "end": 3893.34,
      "start": 3890.94,
      "text": "這個是多方面報道吧"
    },
    {
      "end": 3894.64,
      "start": 3893.34,
      "text": "然後關於海口"
    },
    {
      "end": 3895.14,
      "start": 3894.64,
      "text": "恒大"
    },
    {
      "end": 3896.04,
      "start": 3895.54,
      "text": "等等"
    },
    {
      "end": 3899.54,
      "start": 3896.04,
      "text": "這個支撐中共虛假繁榮經濟的這個房地產"
    },
    {
      "end": 3900.44,
      "start": 3899.54,
      "text": "已經完蛋了"
    },
    {
      "end": 3902.04,
      "start": 3900.44,
      "text": "等於說整個消息已經"
    },
    {
      "end": 3902.94,
      "start": 3902.34,
      "text": "捂不住了"
    },
    {
      "end": 3904.44,
      "start": 3902.94,
      "text": "就算是在中國國內"
    },
    {
      "end": 3906.84,
      "start": 3904.44,
      "text": "這方面負面消息也是破天蓋地"
    },
    {
      "end": 3907.94,
      "start": 3906.84,
      "text": "沒有人不知道"
    },
    {
      "end": 3910.54,
      "start": 3908.64,
      "text": "這個信息應該完了"
    },
    {
      "end": 3911.74,
      "start": 3910.54,
      "text": "還有一個關於"
    },
    {
      "end": 3914.54,
      "start": 3912.24,
      "text": "那個地方債的一個信息"
    },
    {
      "end": 3916.64,
      "start": 3914.54,
      "text": "好"
    },
    {
      "end": 3917.34,
      "start": 3916.64,
      "text": "麻煩導播"
    },
    {
      "end": 3919.74,
      "start": 3918.44,
      "text": "那個信息要播嗎"
    },
    {
      "end": 3920.94,
      "start": 3920.14,
      "text": "那個地方債的"
    },
    {
      "end": 3931.94,
      "start": 3931.54,
      "text": "OK"
    },
    {
      "end": 3933.74,
      "start": 3931.94,
      "text": "中小銀行"
    },
    {
      "end": 3935.84,
      "start": 3933.74,
      "text": "這個催債力度前所未有"
    },
    {
      "end": 3938.14,
      "start": 3935.84,
      "text": "中共徹底是缺錢了"
    },
    {
      "end": 3938.84,
      "start": 3938.54,
      "text": "OK"
    },
    {
      "end": 3939.54,
      "start": 3938.84,
      "text": "麻煩導播"
    },
    {
      "end": 3940.24,
      "start": 3939.54,
      "text": "下一張"
    },
    {
      "end": 3946.54,
      "start": 3940.24,
      "text": "某市中小銀行催債力度前所未有"
    },
    {
      "end": 3948.64,
      "start": 3946.54,
      "text": "這可能也不是一個個別行為"
    },
    {
      "end": 3951.34,
      "start": 3948.64,
      "text": "以往最多的就是省政府和銀行出面"
    },
    {
      "end": 3953.04,
      "start": 3951.34,
      "text": "這個本次這個省委省政府"
    },
    {
      "end": 3955.54,
      "start": 3953.04,
      "text": "紀委公安檢察院法院清朝出動"
    },
    {
      "end": 3959.04,
      "start": 3955.54,
      "text": "成立這個專門督導組催債"
    },
    {
      "end": 3961.14,
      "start": 3959.04,
      "text": "這變成一個政治任務"
    },
    {
      "end": 3962.94,
      "start": 3961.14,
      "text": "意味著這個官員辦事不力"
    },
    {
      "end": 3964.64,
      "start": 3962.94,
      "text": "有可能被上級紀委"
    },
    {
      "end": 3965.94,
      "start": 3964.64,
      "text": "檢察院查辦"
    },
    {
      "end": 3967.94,
      "start": 3965.94,
