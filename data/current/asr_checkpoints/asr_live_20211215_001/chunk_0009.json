    {
      "end": 8445.78,
      "start": 8444.78,
      "text": "是吧"
    },
    {
      "end": 8446.78,
      "start": 8445.78,
      "text": "进来以后你就会"
    },
    {
      "end": 8447.78,
      "start": 8446.78,
      "text": "你点什么菜"
    },
    {
      "end": 8449.78,
      "start": 8447.78,
      "text": "不然就点完吃完文艺"
    },
    {
      "end": 8451.78,
      "start": 8449.78,
      "text": "你这边点一个H$你就走了"
    },
    {
      "end": 8452.78,
      "start": 8451.78,
      "text": "永远不可查"
    },
    {
      "end": 8454.78,
      "start": 8452.78,
      "text": "就是如果拿到你警察以后"
    },
    {
      "end": 8455.78,
      "start": 8454.78,
      "text": "手机什么都看不见"
    },
    {
      "end": 8458.78,
      "start": 8456.78,
      "text": "不但看不见"
    },
    {
      "end": 8460.78,
