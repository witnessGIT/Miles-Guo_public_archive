    },
    {
      "end": 8675.78,
      "start": 8673.78,
      "text": "人家对方就说行了"
    },
    {
      "end": 8676.78,
      "start": 8675.78,
      "text": "我啥也不要你的"
    },
    {
      "end": 8678.78,
      "start": 8676.78,
      "text": "你现在开始你等着我就行了"
    },
    {
      "end": 8680.78,
      "start": 8678.78,
      "text": "就你告诉我你拥有的洗臂"
    },
    {
      "end": 8682.78,
      "start": 8680.78,
      "text": "我把你的护照全你申请完"
    },
    {
      "end": 8684.78,
      "start": 8682.78,
      "text": "就证明你有这个钱"
    },
    {
      "end": 8685.78,
      "start": 8684.78,
      "text": "你能在这能生存"
    },
    {
      "end": 8687.78,
      "start": 8685.78,
      "text": "就是因为他表现了洗臂"
    },
    {
      "end": 8691.78,
      "start": 8687.78,
      "text": "他已经在最快的时间拿到了护照"
    },
    {
      "end": 8693.78,
      "start": 8691.78,
      "text": "而且给他安排了工作"
    },
    {
      "end": 8696.78,
      "start": 8693.78,
      "text": "而且住进了个一室一厅的公寓"
    },
    {
      "end": 8697.78,
      "start": 8696.78,
      "text": "带着他的孩子"
    },
    {
      "end": 8700.78,
      "start": 8697.78,
      "text": "他已经超越了法币了"
    },
    {
      "end": 8704.78,
      "start": 8700.78,
      "text": "就是我们未来的在全球各地的帐战"
    },
    {
      "end": 8705.78,
      "start": 8704.78,
      "text": "我是蒙古人"
    },
    {
      "end": 8706.78,
      "start": 8705.78,
      "text": "我是西藏人"
    },
    {
      "end": 8707.78,
      "start": 8706.78,
      "text": "我们联络好以后"
    },
    {
      "end": 8708.78,
      "start": 8707.78,
      "text": "当时我有这个洗臂"
    },
    {
      "end": 8710.78,
      "start": 8708.78,
      "text": "他是一个基本鉴定"
    },
    {
      "end": 8712.78,
      "start": 8710.78,
      "text": "就像那个电影上写的一辆牌子"
    },
    {
      "end": 8713.78,
      "start": 8712.78,
      "text": "锦衣卫"
    },
    {
      "end": 8714.78,
      "start": 8713.78,
      "text": "是吧"
    },
    {
      "end": 8715.78,
      "start": 8714.78,
      "text": "锦衣卫"
    },
    {
      "end": 8716.78,
      "start": 8715.78,
      "text": "自己人"
    },
    {
      "end": 8717.78,
      "start": 8716.78,
      "text": "自己人"
    },
    {
      "end": 8718.78,
      "start": 8717.78,
      "text": "一辆这个"
    },
    {
      "end": 8719.78,
      "start": 8718.78,
      "text": "银牌"
    },
    {
      "end": 8720.78,
      "start": 8719.78,
      "text": "东厂"
    },
    {
      "end": 8721.78,
      "start": 8720.78,
      "text": "自己人"
    },
    {
      "end": 8722.78,
      "start": 8721.78,
      "text": "自己人"
    },
    {
      "end": 8723.78,
      "start": 8722.78,
      "text": "这是案"
    },
    {
      "end": 8724.78,
      "start": 8723.78,
      "text": "你干不了的"
    },
    {
      "end": 8725.78,
      "start": 8724.78,
      "text": "而且还不可复制"
    },
    {
      "end": 8726.78,
      "start": 8725.78,
      "text": "是吧"
    },
    {
      "end": 8727.78,
      "start": 8726.78,
      "text": "到时候兄弟还会进来"
    },
    {
      "end": 8728.78,
      "start": 8727.78,
      "text": "有吃有喝了"
    },
    {
      "end": 8729.78,
      "start": 8728.78,
      "text": "然后里边文艺"
    },
    {
      "end": 8730.78,
      "start": 8729.78,
      "text": "然后就出来了"
    },
    {
      "end": 8732.78,
      "start": 8730.78,
      "text": "热包子"
    },
    {
      "end": 8733.78,
      "start": 8732.78,
      "text": "文艺的包子"
    },
    {
      "end": 8734.78,
      "start": 8733.78,
      "text": "什么肉"
    },
    {
      "end": 8735.78,
      "start": 8734.78,
      "text": "全上来了"
    },
    {
      "end": 8736.78,
      "start": 8735.78,
      "text": "全家人"
    },
    {
      "end": 8738.78,
      "start": 8736.78,
      "text": "但是"
    },
    {
      "end": 8740.78,
      "start": 8738.78,
      "text": "不能像共产党是不能吃奶"
    },
    {
      "end": 8742.78,
      "start": 8740.78,
      "text": "绝对不能给吃奶"
    },
    {
      "end": 8744.78,
      "start": 8742.78,
      "text": "共产党一击都给喂奶"
    },
    {
      "end": 8745.78,
      "start": 8744.78,
      "text": "共产党一击都给喂奶"
    },
    {
      "end": 8747.78,
      "start": 8745.78,
      "text": "咱们搞这个"
    },
    {
      "end": 8750.78,
      "start": 8747.78,
      "text": "新冬来貌也不能搞喂奶文艺"
    },
    {
      "end": 8751.78,
      "start": 8750.78,
      "text": "这事不能干"
    },
    {
      "end": 8753.78,
      "start": 8751.78,
      "text": "所以说这就是战友们见面的"
    },
    {
      "end": 8754.78,
      "start": 8753.78,
      "text": "是不是"
    },
    {
      "end": 8755.78,
      "start": 8754.78,
      "text": "就像过去土豆土豆"
