      "text": "你有没有洗臂啊"
    },
    {
      "end": 8670.78,
      "start": 8669.78,
      "text": "他说我有洗臂啊"
    },
    {
      "end": 8672.78,
      "start": 8670.78,
      "text": "我这我买了郭先生"
    },
    {
      "end": 8673.78,
      "start": 8672.78,
