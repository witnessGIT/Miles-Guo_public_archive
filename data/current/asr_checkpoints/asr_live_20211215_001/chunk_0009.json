    },
    {
      "end": 8468.78,
      "start": 8467.78,
      "text": "直接就是一个B"
    },
    {
      "end": 8470.78,
      "start": 8468.78,
      "text": "可以给到世界任何人"
    },
    {
      "end": 8472.78,
      "start": 8471.78,
      "text": "这就是西藏人民"
    },
    {
      "end": 8473.78,
      "start": 8472.78,
      "text": "新疆人民"
    },
    {
      "end": 8475.78,
      "start": 8473.78,
      "text": "台湾人"
    },
    {
      "end": 8476.78,
      "start": 8475.78,
