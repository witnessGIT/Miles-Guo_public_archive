      "text": "这样的事情美食的发生"
    },
    {
      "end": 8764.78,
      "start": 8762.78,
      "text": "像毛病小哥在家里"
    },
    {
      "end": 8765.78,
      "start": 8764.78,
      "text": "待着他在店里边"
    },
    {
      "end": 8767.78,
      "start": 8765.78,
      "text": "来一战友一进去"
    },
    {
      "end": 8768.78,
      "start": 8767.78,
      "text": "啊"
    },
    {
      "end": 8770.78,
      "start": 8769.78,
      "text": "我洗臂洗臂洗臂"
    },
    {
      "end": 8772.78,
      "start": 8770.78,
      "text": "毛病小哥给那时候什么洗臂啊"
    },
    {
      "end": 8773.78,
