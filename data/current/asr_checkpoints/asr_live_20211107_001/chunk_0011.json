      "text": "也不要嫁给中国男的"
    },
    {
      "end": 10730.3,
      "start": 10728.3,
      "text": "言而无信"
    },
    {
      "end": 10731.3,
      "start": 10730.3,
      "text": "邋遢无比"
    },
    {
      "end": 10732.3,
