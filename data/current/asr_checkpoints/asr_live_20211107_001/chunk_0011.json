      "end": 10722.3,
      "start": 10720.3,
      "text": "我后来我很快我就接受了"
    },
    {
      "end": 10724.3,
      "start": 10722.3,
      "text": "我今天我就认为"
    },
    {
      "end": 10725.3,
      "start": 10724.3,
      "text": "我说聪明的就是"
    },
    {
      "end": 10726.3,
      "start": 10725.3,
      "text": "你可嫁给日本的老头儿"
    },
