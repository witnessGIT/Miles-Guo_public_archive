    {
      "end": 10769.3,
      "start": 10768.3,
      "text": "你喝断片全结束"
    },
    {
      "end": 10772.3,
      "start": 10770.3,
      "text": "我和日本所有的合作"
    },
    {
      "end": 10774.3,
      "start": 10772.3,
      "text": "日本人过来没有一次骗我的"
    },
    {
      "end": 10775.3,
      "start": 10774.3,
      "text": "我一个日本的"
    },
    {
      "end": 10776.3,
      "start": 10775.3,
      "text": "现在曾经的合作者"
    },
    {
      "end": 10777.3,
      "start": 10776.3,
      "text": "是日本现在"
    },
    {
      "end": 10779.3,
      "start": 10777.3,
      "text": "最高调的炫富者"
    },
    {
      "end": 10780.3,
      "start": 10779.3,
      "text": "最有钱的"
    },
    {
      "end": 10781.3,
      "start": 10780.3,
      "text": "百姨富豪"
    },
    {
      "end": 10783.3,
      "start": 10782.3,
      "text": "是我改变了他"
    },
    {
      "end": 10785.3,
      "start": 10783.3,
      "text": "日本人从来没有一个出了这个主"
