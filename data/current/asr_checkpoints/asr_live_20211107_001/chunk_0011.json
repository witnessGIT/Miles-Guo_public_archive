    {
      "end": 10703.3,
      "start": 10701.3,
      "text": "然后表明自己她是我老公"
    },
    {
      "end": 10706.3,
      "start": 10703.3,
      "text": "那时候对我来讲83年我才多大"
    },
    {
      "end": 10707.3,
      "start": 10706.3,
      "text": "我这13岁"
    },
    {
      "end": 10708.3,
      "start": 10707.3,
      "text": "是吧"
    },
    {
      "end": 10709.3,
      "start": 10708.3,
      "text": "看到这种情景"
    },
    {
      "end": 10711.3,
      "start": 10709.3,
      "text": "那时又羡慕又恨"
    },
    {
      "end": 10712.3,
      "start": 10711.3,
      "text": "那叫羡慕恨"
    },
    {
      "end": 10713.3,
      "start": 10712.3,
      "text": "真是羡慕恨"
    },
    {
      "end": 10714.3,
      "start": 10713.3,
      "text": "美女旁边"
    },
    {
      "end": 10715.3,
      "start": 10714.3,
      "text": "哇塞"
    },
    {
      "end": 10716.3,
      "start": 10715.3,
      "text": "结果属于她的"
