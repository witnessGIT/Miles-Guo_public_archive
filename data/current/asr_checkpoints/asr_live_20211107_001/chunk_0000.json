    {
      "end": 736.48,
      "start": 734.48,
      "text": "這個問題今天是大事兒"
    },
    {
      "end": 737.48,
      "start": 736.48,
      "text": "我給大家今天說了"
    },
    {
      "end": 739.48,
      "start": 737.48,
      "text": "為啥今天七哥很興奮啊"
