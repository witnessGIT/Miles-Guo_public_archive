    },
    {
      "end": 748.48,
      "start": 746.48,
      "text": "咱們上上次大直播"
    },
    {
      "end": 750.48,
      "start": 748.48,
      "text": "我說有大好事發生"
    },
    {
      "end": 752.48,
      "start": 750.48,
      "text": "本來就說這事兒能發生的"
    },
    {
      "end": 755.48,
      "start": 752.48,
      "text": "但是美國啥事兒都跟你想像都要晚一點"
