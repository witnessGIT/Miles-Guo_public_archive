      "text": "我說我不丟人"
    },
    {
      "end": 767.48,
      "start": 766.48,
      "text": "結果我看"
    },
    {
      "end": 768.48,
      "start": 767.48,
      "text": "都推出來了"
    },
    {
      "end": 770.48,
      "start": 768.48,
      "text": "我經過確認"
    },
    {
      "end": 771.48,
      "start": 770.48,
      "text": "然後呢"
    },
    {
      "end": 772.48,
      "start": 771.48,
      "text": "我們的班農先生"
    },
    {
      "end": 773.48,
      "start": 772.48,
      "text": "就昨天跟我一天都在一起"
