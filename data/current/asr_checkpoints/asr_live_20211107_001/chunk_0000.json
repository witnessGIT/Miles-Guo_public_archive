    {
      "end": 777.48,
      "start": 776.48,
      "text": "我得看公布出來"
    },
    {
      "end": 779.48,
      "start": 777.48,
      "text": "才能算數"
    },
    {
      "end": 781.48,
      "start": 779.48,
      "text": "這個絕對就是戰鬥史幹的"
