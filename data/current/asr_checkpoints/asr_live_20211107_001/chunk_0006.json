{
  "chunk_audio_sha256": "a176694cb734aef084016006c86692e5208f93f89d873373182ac73306cff49d",
  "chunk_index": 6,
  "completed_at": "2026-10-21T08:24:03Z",
  "language": "zh",
  "live_id": "LIVE_20211107_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
