  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 3601.86,
      "start": 3600.0,
      "text": "但这个乘数是多少"
    },
    {
      "end": 3604.48,
      "start": 3601.86,
      "text": "其实有的情况下也是天差地别的"
    },
    {
      "end": 3606.62,
      "start": 3604.48,
      "text": "要看这个公司它的一个商业模式"
    },
    {
      "end": 3608.5,
      "start": 3606.62,
      "text": "像我们的盖特以后主要的"
    },
    {
      "end": 3610.98,
      "start": 3608.5,
      "text": "这个盈利来源是整个金融的体系"
    },
    {
      "end": 3613.3,
      "start": 3610.98,
      "text": "那在这个整个金融体系"
    },
    {
      "end": 3614.5,
      "start": 3613.3,
      "text": "在我们盖特配的加持下"
    },
    {
      "end": 3617.08,
      "start": 3614.5,
      "text": "每一个用户它的这个价值就更加大"
    },
    {
      "end": 3618.3,
      "start": 3617.08,
      "text": "那我们的乘数就会更多"
    },
    {
      "end": 3620.04,
      "start": 3618.3,
      "text": "这样赚出来的估值就会更大"
    },
    {
      "end": 3622.02,
      "start": 3620.04,
      "text": "另外一个就是基于公司的资产"
    },
    {
      "end": 3623.2,
      "start": 3622.02,
      "text": "像以后我们的洗联储"
    },
    {
      "end": 3625.7,
      "start": 3623.2,
      "text": "可能会是一个非常重资产的公司"
    },
    {
      "end": 3627.06,
      "start": 3625.7,
      "text": "我们有很多黄金储备"
    },
    {
      "end": 3628.0,
      "start": 3627.06,
      "text": "然后我们有洗币"
    },
    {
      "end": 3629.36,
      "start": 3628.0,
      "text": "有洗币的发行权等等"
    },
    {
      "end": 3631.84,
      "start": 3629.36,
      "text": "这些都会是我们的资产"
    },
    {
      "end": 3633.74,
      "start": 3631.84,
      "text": "可以通过这个资产去换算出"
    },
    {
      "end": 3635.12,
      "start": 3633.74,
      "text": "我们整个洗联储的一个估值"
    },
    {
      "end": 3637.44,
      "start": 3635.12,
      "text": "好 然后最后我们翻到最后一页"
    },
    {
      "end": 3640.3,
      "start": 3637.44,
      "text": "就那这个市值和估值"
    },
    {
      "end": 3641.28,
      "start": 3640.3,
      "text": "到底有什么区别呢"
    },
    {
      "end": 3642.86,
      "start": 3641.28,
      "text": "其实从理论上来看的话"
    },
    {
      "end": 3644.6,
      "start": 3642.86,
      "text": "在没有操控的这种"
    },
    {
      "end": 3645.76,
      "start": 3644.6,
      "text": "完全市场的概况下"
    },
    {
      "end": 3647.28,
      "start": 3645.76,
      "text": "应该说这个总市值和"
    },
    {
      "end": 3649.88,
      "start": 3647.28,
      "text": "这个公司的估值应该是一致的"
    },
    {
      "end": 3651.06,
      "start": 3649.88,
      "text": "但是呢 现实和这个"
    },
    {
      "end": 3653.3,
      "start": 3651.06,
      "text": "基本上是完全不会是完美的"
    },
    {
      "end": 3654.88,
      "start": 3653.3,
      "text": "那如果存在市场操控的话"
    },
    {
      "end": 3656.46,
      "start": 3654.88,
      "text": "这个市场价格就会有人为的"
    },
    {
      "end": 3657.72,
      "start": 3656.46,
      "text": "这个控制"
    },
    {
      "end": 3660.08,
      "start": 3657.72,
      "text": "那市值和估值就会存在便利"
    },
    {
      "end": 3661.86,
      "start": 3660.08,
      "text": "那如果市值达到一定量的话"
    },
    {
      "end": 3663.14,
      "start": 3661.86,
      "text": "那市场操纵难度"
    },
    {
      "end": 3664.68,
      "start": 3663.14,
      "text": "当然也就相应的增加了"
    },
    {
      "end": 3667.0,
      "start": 3664.68,
      "text": "那整个市值和估值也会趋向于一致"
    },
    {
      "end": 3669.2,
      "start": 3667.0,
      "text": "好 这个就是今天我们想和大家分享的"
    },
    {
      "end": 3670.76,
      "start": 3669.2,
      "text": "关于加密货币的相关内容"
    },
    {
      "end": 3671.2,
      "start": 3670.76,
      "text": "谢谢"
    },
    {
      "end": 3674.7,
      "start": 3671.2,
      "text": "好的 谢谢郑青"
    },
    {
      "end": 3676.82,
      "start": 3674.7,
      "text": "那秦哥 您先来"
    },
    {
      "end": 3680.06,
      "start": 3676.82,
      "text": "这个好 今天郑青做的这个战友们"
    },
    {
      "end": 3681.24,
      "start": 3680.06,
      "text": "做的特别好啊"
    },
    {
      "end": 3683.54,
      "start": 3681.24,
      "text": "我这个我好好学习了"
    },
    {
      "end": 3687.28,
      "start": 3683.54,
      "text": "我们现在要把几个关系分的非常非常清楚"
    },
    {
      "end": 3690.08,
      "start": 3687.72,
      "text": "就很多人没分清楚的"
    },
    {
      "end": 3697.0,
      "start": 3690.08,
      "text": "这个虚拟货币交易所和虚拟货币"
    },
    {
      "end": 3702.08,
      "start": 3697.0,
      "text": "还有市场价值和估值的几个问题搞得清清楚楚"
    },
    {
      "end": 3705.72,
      "start": 3702.08,
      "text": "然后今天关心的一个大家要谈到一个提现的问题"
    },
    {
      "end": 3711.76,
      "start": 3705.72,
      "text": "什么叫银行和交易所是什么关系"
    },
    {
      "end": 3712.88,
      "start": 3711.76,
      "text": "我要问你们六个人"
    },
    {
      "end": 3715.0,
      "start": 3712.88,
      "text": "我保证你们回家都是错的"
    },
    {
      "end": 3717.0,
      "start": 3715.0,
      "text": "最简单的话"
    },
    {
      "end": 3720.08,
      "start": 3717.0,
      "text": "银行和货币交易所"
    },
    {
      "end": 3723.8,
      "start": 3720.08,
      "text": "它就是一个真的业总会"
    },
    {
      "end": 3727.88,
      "start": 3723.8,
      "text": "还有就业总会的整个的业总会"
    },
    {
      "end": 3729.84,
      "start": 3727.88,
      "text": "还有和妈妈桑的区别"
    },
    {
      "end": 3731.92,
      "start": 3729.84,
      "text": "知道了吗"
    },
    {
      "end": 3732.94,
      "start": 3731.92,
      "text": "你别把这搞错了"
    },
    {
      "end": 3735.3,
      "start": 3732.94,
      "text": "业总会那是什么都包含了"
    },
    {
      "end": 3737.36,
      "start": 3735.3,
      "text": "包含妈妈桑就叫银行"
    },
    {
      "end": 3739.12,
      "start": 3737.36,
      "text": "那叫业总会"
    },
    {
      "end": 3740.5,
      "start": 3739.12,
      "text": "骗你钱的 是吧"
    },
    {
      "end": 3743.3,
      "start": 3740.5,
      "text": "这个交易所啊"
    },
    {
      "end": 3744.14,
      "start": 3743.3,
      "text": "就是跟妈妈桑"
    },
    {
      "end": 3745.36,
      "start": 3744.14,
      "text": "只是给你中介的"
    },
    {
      "end": 3753.58,
      "start": 3745.36,
      "text": "整个交易所妈妈桑和业总会银行"
    },
    {
      "end": 3755.82,
      "start": 3753.58,
      "text": "它上面是谁你知道吗"
    },
    {
      "end": 3758.42,
      "start": 3755.82,
      "text": "它上面就是皇帝"
    },
    {
      "end": 3760.3,
      "start": 3758.42,
      "text": "就是这个权力的老大"
    },
    {
      "end": 3762.46,
      "start": 3760.3,
      "text": "它可以决定业总会开不开门"
    },
    {
      "end": 3764.46,
      "start": 3762.46,
      "text": "它可以决定你妈妈桑是谁"
    },
    {
      "end": 3766.92,
      "start": 3764.46,
      "text": "就叫主权"
    },
    {
      "end": 3769.74,
      "start": 3766.92,
      "text": "也叫住币权"
    },
    {
      "end": 3771.14,
      "start": 3769.74,
      "text": "也叫国防权"
    },
    {
      "end": 3776.06,
      "start": 3771.14,
      "text": "能不能提现是谁说了算呢"
    },
    {
      "end": 3776.86,
      "start": 3776.06,
      "text": "是不是"
    },
    {
      "end": 3778.7,
      "start": 3776.86,
      "text": "能不能兑现谁说了算呢"
    },
    {
      "end": 3781.24,
      "start": 3778.7,
      "text": "就是咱们生活中所说的"
    },
    {
      "end": 3783.02,
      "start": 3781.24,
      "text": "就是咱们所说的管家"
    },
    {
      "end": 3785.86,
      "start": 3783.02,
      "text": "你都哪有多少钱拿多少钱"
    },
    {
      "end": 3787.08,
      "start": 3785.86,
      "text": "就妈妈桑挣的钱"
    },
    {
      "end": 3788.6,
      "start": 3787.08,
      "text": "业总会也弄的钱"
    },
    {
      "end": 3790.52,
      "start": 3788.6,
      "text": "最后你那个小姐"
    },
    {
      "end": 3791.54,
      "start": 3790.52,
      "text": "能不能拿走钱啊"
    },
    {
      "end": 3791.76,
      "start": 3791.54,
      "text": "是不是"
    },
    {
      "end": 3792.62,
      "start": 3791.76,
      "text": "管家说"
    },
    {
      "end": 3793.96,
      "start": 3792.62,
      "text": "给你多少是多少"
    },
    {
      "end": 3795.42,
      "start": 3793.96,
      "text": "拿到手才是你的钱"
    },
    {
      "end": 3800.22,
      "start": 3795.42,
      "text": "那么我们现在整个洗联署是什么"
    },
    {
      "end": 3801.3,
      "start": 3800.22,
      "text": "大家一定要搞清楚"
    },
    {
      "end": 3806.26,
      "start": 3801.3,
      "text": "我们洗联署既是拥有皇帝的住币权"
    },
    {
      "end": 3807.22,
      "start": 3806.26,
      "text": "管理权"
    },
    {
      "end": 3808.5,
      "start": 3807.22,
      "text": "还有分配权"
    },
    {
      "end": 3810.62,
      "start": 3808.5,
      "text": "还有一个叫什么"
    },
    {
      "end": 3811.42,
      "start": 3810.62,
      "text": "叶总会"
    },
    {
      "end": 3813.82,
      "start": 3811.42,
      "text": "这个叶总会就是叫洗联署"
    },
    {
      "end": 3815.46,
      "start": 3813.82,
      "text": "叶总会下边还有什么"
    },
    {
      "end": 3816.54,
      "start": 3815.46,
      "text": "还有妈妈桑"
    },
    {
      "end": 3818.7,
      "start": 3816.54,
      "text": "妈妈桑就是交易所"
    },
    {
      "end": 3820.18,
      "start": 3818.7,
      "text": "咱都有"
    },
    {
      "end": 3821.82,
      "start": 3820.18,
      "text": "还有财政总管"
    },
    {
      "end": 3823.62,
      "start": 3821.82,
      "text": "财务总管是谁啊"
    },
    {
      "end": 3825.94,
      "start": 3823.62,
      "text": "财务总管也是咱们这个洗联署"
    },
    {
      "end": 3828.34,
      "start": 3825.94,
      "text": "你别把这几个事搞错了"
    },
    {
      "end": 3830.38,
      "start": 3828.34,
      "text": "很多人那些伪类"
    },
    {
      "end": 3832.3,
      "start": 3830.38,
      "text": "你知道他们有多可怜吗"
    },
    {
      "end": 3834.38,
      "start": 3832.3,
      "text": "就要饭的人"
    },
    {
      "end": 3835.38,
      "start": 3834.38,
      "text": "他为啥要饭呢"
    },
    {
      "end": 3836.22,
      "start": 3835.38,
      "text": "要饭只有一个"
    },
    {
      "end": 3836.94,
      "start": 3836.22,
      "text": "我想吃饱"
    },
    {
      "end": 3838.86,
      "start": 3836.94,
      "text": "把饭给我"
    },
    {
      "end": 3840.54,
      "start": 3838.86,
      "text": "吃到嘴里才算饭"
    },
    {
      "end": 3843.0,
      "start": 3840.54,
      "text": "要饭的还有个级别"
    },
    {
      "end": 3843.74,
      "start": 3843.0,
      "text": "叫要钱"
    },
    {
      "end": 3844.86,
      "start": 3843.74,
      "text": "我不要饭"
    },
    {
      "end": 3846.3,
      "start": 3844.86,
      "text": "就像我跟你们讲过"
    },
    {
      "end": 3847.26,
      "start": 3846.3,
      "text": "2017年爆料"
    },
    {
      "end": 3847.9,
      "start": 3847.26,
      "text": "我要问Rachel"
    },
    {
      "end": 3848.98,
      "start": 3847.9,
      "text": "Rachel肯定会阿布出来"
    },
    {
      "end": 3849.62,
      "start": 3848.98,
      "text": "我"
    },
    {
      "end": 3850.38,
      "start": 3849.62,
      "text": "哎"
    },
    {
      "end": 3851.66,
      "start": 3850.38,
      "text": "凯雷希老战友"
    },
    {
      "end": 3853.58,
      "start": 3851.66,
      "text": "我说过我在伦敦"
    },
    {
      "end": 3855.06,
      "start": 3853.58,
      "text": "我儿子跟要饭这件事"
    },
    {
      "end": 3855.98,
      "start": 3855.06,
      "text": "你还记得的故事吗"
    },
    {
      "end": 3857.38,
      "start": 3855.98,
      "text": "凯雷希"
    },
    {
      "end": 3859.42,
      "start": 3857.38,
      "text": "嗯"
    },
    {
      "end": 3859.94,
      "start": 3859.42,
      "text": "你说说"
    },
    {
      "end": 3861.34,
      "start": 3859.94,
      "text": "Rachel肯定会说"
    },
    {
      "end": 3863.02,
      "start": 3861.34,
      "text": "你说我问你呢"
    },
    {
      "end": 3863.98,
      "start": 3863.02,
      "text": "什么叫我几个说"
    },
    {
      "end": 3865.34,
      "start": 3863.98,
      "text": "你忽悠谁呢"
    },
    {
      "end": 3866.66,
      "start": 3865.34,
      "text": "2017年我说过"
    },
    {
      "end": 3868.86,
      "start": 3866.66,
      "text": "我儿子跟一个要饭者之间发生的故事"
    },
    {
      "end": 3869.54,
      "start": 3868.86,
      "text": "你还记得吗"
    },
    {
      "end": 3871.34,
      "start": 3869.54,
      "text": "你不是老七哥老爆料吗"
    },
    {
      "end": 3872.42,
      "start": 3871.34,
      "text": "老战友吗"
    },
    {
      "end": 3873.34,
      "start": 3872.42,
      "text": "你说"
    },
    {
      "end": 3875.3,
      "start": 3873.34,
      "text": "我忘记了"
    },
    {
      "end": 3876.34,
      "start": 3875.3,
      "text": "谁记得你们几个"
    },
    {
      "end": 3877.42,
      "start": 3876.34,
      "text": "咋样"
    },
    {
      "end": 3878.34,
      "start": 3877.42,
      "text": "咋样"
    },
    {
      "end": 3879.74,
      "start": 3878.34,
      "text": "我赶励去"
    },
    {
      "end": 3880.5,
      "start": 3879.74,
      "text": "考几次"
    },
    {
      "end": 3881.34,
      "start": 3880.5,
      "text": "你输一次"
    },
    {
      "end": 3883.42,
      "start": 3881.34,
      "text": "看着佛祖菩萨没帮你"
    },
    {
      "end": 3885.78,
      "start": 3883.42,
      "text": "我当时二十年爆料的时候"
    },
    {
      "end": 3888.9,
      "start": 3885.78,
      "text": "就是说在英国当年两千年千禧年的时候"
    },
    {
      "end": 3891.1,
      "start": 3888.9,
      "text": "我跟我儿子跟我女儿跟我"
    },
    {
      "end": 3891.94,
      "start": 3891.1,
      "text": "跟你七嫂"
    },
    {
      "end": 3894.74,
      "start": 3891.94,
      "text": "在那个整个观看两千年"
    },
    {
      "end": 3896.9,
      "start": 3894.74,
      "text": "大千禧年从桥回来"
    },
    {
      "end": 3900.74,
      "start": 3896.9,
      "text": "走到这个白金汉宫后面有要饭在那儿"
    },
    {
      "end": 3903.26,
      "start": 3900.74,
      "text": "我儿子就给我要钱"
    },
    {
      "end": 3904.5,
      "start": 3903.26,
      "text": "给他钱"
    },
    {
      "end": 3907.22,
      "start": 3904.5,
      "text": "我就给他那个英棒的硬泵"
    },
    {
      "end": 3908.14,
      "start": 3907.22,
      "text": "是几棒啊"
    },
    {
      "end": 3909.74,
      "start": 3908.14,
      "text": "我记得五棒还是十棒"
    },
    {
      "end": 3911.74,
      "start": 3909.74,
      "text": "然后呢"
    },
    {
      "end": 3913.46,
      "start": 3911.74,
