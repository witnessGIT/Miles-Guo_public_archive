    },
    {
      "end": 6797.76,
      "start": 6795.76,
      "text": "就在这里确实"
    },
    {
      "end": 6798.76,
      "start": 6797.76,
      "text": "中国的男人嘛"
    },
    {
      "end": 6799.76,
      "start": 6798.76,
      "text": "有很多都是真的"
    },
    {
      "end": 6800.76,
