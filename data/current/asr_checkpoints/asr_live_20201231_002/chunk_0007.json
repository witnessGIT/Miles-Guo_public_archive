    },
    {
      "end": 6825.76,
      "start": 6824.76,
      "text": "一天晚上吃三顿晚餐"
    },
    {
      "end": 6826.76,
      "start": 6825.76,
      "text": "喝那些茅台酒"
    },
    {
      "end": 6827.76,
      "start": 6826.76,
      "text": "有时候还喝假酒"
    },
    {
      "end": 6828.76,
      "start": 6827.76,
      "text": "是吧"
    },
    {
      "end": 6830.76,
      "start": 6828.76,
      "text": "然后瞪眼听他说瞎话"
    },
    {
      "end": 6831.76,
      "start": 6830.76,
      "text": "然后胡扯八道的"
    },
    {
      "end": 6832.76,
      "start": 6831.76,
      "text": "年复一年"
    },
    {
      "end": 6833.76,
      "start": 6832.76,
      "text": "日复一日"
    },
    {
      "end": 6835.76,
      "start": 6833.76,
      "text": "我觉得真的浪费生命"
    },
    {
      "end": 6836.76,
      "start": 6835.76,
      "text": "而我们今天"
    },
    {
      "end": 6838.76,
      "start": 6836.76,
      "text": "所有的一切都不是重复的"
    },
    {
      "end": 6840.76,
      "start": 6838.76,
      "text": "所有的一切都是新的"
    },
    {
      "end": 6841.76,
      "start": 6840.76,
      "text": "都是崭新的"
    },
    {
      "end": 6842.76,
      "start": 6841.76,
      "text": "你看我今天看到"
    },
    {
      "end": 6844.76,
      "start": 6842.76,
      "text": "威廉王和唐平妹坐在这儿说"
    },
    {
      "end": 6845.76,
      "start": 6844.76,
      "text": "我很有感受"
    },
    {
      "end": 6846.76,
      "start": 6845.76,
      "text": "旁边这个男人"
    },
    {
      "end": 6847.76,
      "start": 6846.76,
      "text": "威廉王"
    },
    {
      "end": 6848.76,
      "start": 6847.76,
      "text": "他的变化是巨大的"
    },
    {
      "end": 6851.76,
      "start": 6848.76,
      "text": "如果他不参加爆料革命"
    },
    {
      "end": 6852.76,
      "start": 6851.76,
      "text": "不搞这个"
    },
    {
      "end": 6853.76,
      "start": 6852.76,
      "text": "真的唐平"
    },
    {
      "end": 6854.76,
      "start": 6853.76,
      "text": "我觉得这个女人"
    },
    {
      "end": 6855.76,
      "start": 6854.76,
      "text": "是养男人的女人"
    },
    {
      "end": 6857.76,
