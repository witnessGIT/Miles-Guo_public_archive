    },
    {
      "end": 2654.64,
      "start": 2650.98,
      "text": "我是冠军的后妈"
    },
    {
      "end": 2657.36,
      "start": 2654.64,
      "text": "然后我非常感激你们"
    },
    {
      "end": 2659.6,
      "start": 2657.36,
      "text": "可以把我在英雄的赛场上"
    },
    {
      "end": 2660.78,
