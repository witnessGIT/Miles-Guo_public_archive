    {
      "end": 3988.66,
      "start": 3987.38,
      "text": "然后我就希望说"
    },
    {
      "end": 3988.88,
      "start": 3988.66,
      "text": "哇"
    },
    {
      "end": 3991.84,
      "start": 3988.88,
      "text": "我希望我能慢慢的把你们的优点都学会"
    },
    {
      "end": 3993.04,
