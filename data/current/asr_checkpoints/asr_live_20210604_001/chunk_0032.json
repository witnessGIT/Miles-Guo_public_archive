    },
    {
      "end": 29142.76,
      "start": 29141.76,
      "text": "而且我還不能說的話"
    },
    {
      "end": 29143.76,
      "start": 29142.76,
      "text": "以後再說"
    },
    {
      "end": 29145.76,
      "start": 29143.76,
      "text": "有幾個絕對性的英雄"
    },
    {
      "end": 29147.76,
      "start": 29145.76,
      "text": "我相信在場的很多戰友"
    },
    {
