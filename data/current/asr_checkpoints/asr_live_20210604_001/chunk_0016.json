    },
    {
      "end": 14508.0,
      "start": 14500.0,
      "text": "新中国联邦宣言"
    },
    {
      "end": 14514.0,
      "start": 14508.0,
      "text": "新中国联邦宣言"
    },
    {
      "end": 14520.0,
      "start": 14514.0,
      "text": "建议新中国联邦"
    },
    {
      "end": 14526.0,
      "start": 14520.0,
      "text": "新中国联邦"
    },
    {
      "end": 14530.0,
      "start": 14526.0,
      "text": "新中国联邦参照西方民主法治体系和相应国际法"
    },
    {
      "end": 14536.0,
      "start": 14530.0,
      "text": "在国际机构和喜马拉雅公司机构的共同监督下制定宪法"
    },
    {
      "end": 14538.0,
      "start": 14536.0,
      "text": "以三权分立正常"
    },
    {
      "end": 14540.0,
      "start": 14538.0,
      "text": "消灭中共是正义的需要"
    },
    {
      "end": 14542.0,
      "start": 14540.0,
      "text": "中共是共产国际俱误的"
    },
    {
      "end": 14544.0,
      "start": 14542.0,
      "text": "中国联邦宣言"
    },
    {
      "end": 14546.0,
      "start": 14544.0,
      "text": "中国合法政府的恐怖组织"
    },
    {
      "end": 14548.0,
      "start": 14546.0,
      "text": "其在中国的侵权团队"
    },
    {
      "end": 14552.0,
      "start": 14548.0,
      "text": "将会发展为彻底的反人类暴行"
    },
    {
      "end": 14554.0,
      "start": 14552.0,
      "text": "于世人权"
    },
    {
      "end": 14556.0,
      "start": 14554.0,
      "text": "摧毁人性"
    },
    {
      "end": 14558.0,
      "start": 14556.0,
      "text": "踐踏民主"
    },
    {
      "end": 14560.0,
      "start": 14558.0,
      "text": "违背法制"
    },
    {
      "end": 14562.0,
      "start": 14560.0,
      "text": "撕毁合约"
    },
    {
      "end": 14563.0,
      "start": 14562.0,
      "text": "输出腐败"
    },
    {
      "end": 14564.0,
      "start": 14563.0,
      "text": "危害全球"
    },
    {
      "end": 14566.0,
      "start": 14564.0,
      "text": "更有胜者"
    },
    {
      "end": 14568.0,
      "start": 14566.0,
      "text": "将以中共病毒"
    },
    {
      "end": 14571.0,
      "start": 14568.0,
      "text": "对全世界发动生化袭击战"
    },
    {
      "end": 14574.0,
      "start": 14571.0,
      "text": "严重威胁人类健康和生存"
    },
    {
      "end": 14577.0,
      "start": 14574.0,
      "text": "其罪恶至极"
    },
    {
      "end": 14578.0,
      "start": 14577.0,
      "text": "全体难容"
    },
    {
      "end": 14580.0,
      "start": 14578.0,
      "text": "相变中共"
    },
    {
      "end": 14582.0,
      "start": 14580.0,
      "text": "是打碎中国人民"
    },
    {
      "end": 14583.0,
      "start": 14582.0,
      "text": "奴隶家属"
    },
    {
      "end": 14586.0,
      "start": 14583.0,
      "text": "和真正实现世界和平之必须"
    },
    {
      "end": 14588.0,
      "start": 14586.0,
      "text": "没有中共的新中国联邦"
    },
    {
      "end": 14590.0,
      "start": 14588.0,
      "text": "是全体人民"
    },
    {
      "end": 14591.0,
      "start": 14590.0,
      "text": "和世界繁荣"
    },
    {
      "end": 14592.0,
      "start": 14591.0,
      "text": "是必须"
    },
    {
      "end": 14610.0,
      "start": 14608.0,
      "text": "中国西传人"
    },
    {
      "end": 14612.0,
      "start": 14610.0,
      "text": "祝新中国联邦"
    },
    {
      "end": 14614.0,
