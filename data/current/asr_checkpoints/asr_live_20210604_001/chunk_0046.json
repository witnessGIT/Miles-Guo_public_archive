    },
    {
      "end": 41936.34,
      "start": 41935.4,
      "text": "谢谢你们"
    },
    {
      "end": 41938.46,
      "start": 41936.34,
      "text": "谢谢你们做的所有的一切"
    },
    {
      "end": 41941.64,
