      "text": "我是日本櫻花團的MC文藝"
    },
    {
      "end": 43491.92,
      "start": 43490.92,
      "text": "今天啊"
    },
    {
      "end": 43494.92,
      "start": 43491.92,
      "text": "我們有許許多多的熟悉的面孔"
    },
    {
      "end": 43495.92,
      "start": 43494.92,
      "text": "老戰友"
    },
    {
      "end": 43497.92,
      "start": 43495.92,
      "text": "新戰友齊聚一堂"
    },
    {
      "end": 43498.92,
      "start": 43497.92,
      "text": "那麼呢"
    },
    {
      "end": 43500.92,
      "start": 43498.92,
      "text": "我們第一位呢"
    },
    {
      "end": 43502.92,
      "start": 43500.92,
      "text": "請我們的魔女戰友"
    },
    {
      "end": 43505.92,
      "start": 43502.92,
      "text": "來向大家致以問候"
    },
    {
      "end": 43507.92,
      "start": 43505.92,
      "text": "有請"
