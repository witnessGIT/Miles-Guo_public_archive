    {
      "end": 43514.92,
      "start": 43507.92,
      "text": "prises"
    },
    {
      "end": 43515.92,
      "start": 43514.92,
      "text": "ons extrude"
    },
    {
      "end": 43517.92,
      "start": 43515.92,
      "text": "神經"
    },
    {
      "end": 43518.92,
      "start": 43517.92,
      "text": "歡迎"
    },
    {
      "end": 43519.92,
      "start": 43518.92,
      "text": "azzi"
    },
    {
      "end": 43523.42,
      "start": 43519.92,
      "text": "亲爱的战友们"
    },
    {
      "end": 43524.48,
      "start": 43523.42,
      "text": "大家好"
    },
    {
      "end": 43525.94,
      "start": 43524.48,
      "text": "方舟农场"
    },
    {
      "end": 43528.14,
      "start": 43525.94,
      "text": "我们的樱花农场"
    },
    {
      "end": 43530.68,
      "start": 43528.14,
      "text": "还有我们筹备的银河系农场"
    },
    {
      "end": 43531.72,
      "start": 43530.68,
      "text": "大家好"
    },
    {
      "end": 43532.64,
      "start": 43531.72,
      "text": "我们的战友们"
    },
    {
      "end": 43535.62,
      "start": 43532.64,
      "text": "还有全球的所有的战友们"
    },
    {
      "end": 43536.36,
      "start": 43535.62,
      "text": "大家好"
    },
    {
      "end": 43541.48,
      "start": 43536.36,
      "text": "我们分场日本"
    },
    {
      "end": 43543.3,
      "start": 43541.48,
      "text": "我们所有的战友"
    },
    {
      "end": 43547.94,
      "start": 43543.3,
      "text": "向全世界的所有的农场的义工们问好"
    },
    {
      "end": 43549.22,
      "start": 43547.94,
      "text": "你们辛苦了"
    },
    {
      "end": 43554.52,
      "start": 43549.22,
      "text": "我在这里也致谢我们所有的捐款"
    },
    {
      "end": 43555.48,
      "start": 43554.52,
      "text": "法治基金"
    },
    {
      "end": 43558.22,
      "start": 43555.48,
      "text": "法治社会的所有的捐款人"
    },
    {
      "end": 43559.46,
      "start": 43558.22,
      "text": "谢谢你们"
    },
    {
      "end": 43561.1,
      "start": 43559.46,
      "text": "我们能够聚会在这里"
    },
    {
      "end": 43566.18,
      "start": 43561.1,
      "text": "非常非常的感谢你们的捐献"
    },
    {
      "end": 43568.04,
      "start": 43566.18,
      "text": "然后我们这一年"
    },
    {
      "end": 43571.52,
      "start": 43568.04,
      "text": "跟随着我们亲爱的文贵先生"
    },
    {
      "end": 43574.54,
      "start": 43571.52,
      "text": "然后我们每一个人都找到了我们的"
    },
    {
      "end": 43576.14,
      "start": 43574.54,
      "text": "在爆料革命中的位置"
    },
    {
      "end": 43577.94,
      "start": 43576.14,
      "text": "然后我们每一个人身边"
    },
    {
      "end": 43579.7,
      "start": 43577.94,
      "text": "都有很多亲爱的战友"
    },
    {
      "end": 43581.72,
      "start": 43579.7,
      "text": "我衷心地爱你们"
    },
    {
      "end": 43582.56,
      "start": 43581.72,
      "text": "爱大家"
    },
    {
      "end": 43583.96,
      "start": 43582.56,
      "text": "然后我知道"
    },
    {
      "end": 43587.7,
      "start": 43583.96,
      "text": "很多的战友在GTV上认识我"
    },
    {
      "end": 43589.0,
      "start": 43587.7,
      "text": "通过极客的连线"
    },
    {
      "end": 43589.96,
      "start": 43589.0,
      "text": "也认识我"
    },
    {
      "end": 43593.64,
      "start": 43589.96,
      "text": "还有跟我日以继夜的在一起战斗的"
    },
    {
      "end": 43594.88,
      "start": 43593.64,
      "text": "虽然我们都在线上"
    },
    {
      "end": 43597.0,
      "start": 43594.88,
      "text": "但是我们知道我们的共同的目标"
    },
    {
      "end": 43598.22,
      "start": 43597.0,
      "text": "今年呢"
    },
    {
      "end": 43599.66,
      "start": 43598.22,
      "text": "我们能够聚会在这里"
    },
    {
      "end": 43602.72,
      "start": 43599.66,
      "text": "去年我们记得我们是在电视机前"
    },
    {
      "end": 43604.42,
      "start": 43602.72,
      "text": "陪伴着我们的震撼"
    },
    {
      "end": 43605.3,
      "start": 43604.42,
      "text": "我们的激动"
    },
    {
      "end": 43606.12,
      "start": 43605.3,
      "text": "我们的感动"
    },
    {
      "end": 43607.34,
      "start": 43606.12,
      "text": "然后明年呢"
    },
    {
      "end": 43609.2,
      "start": 43607.34,
      "text": "我们是不是还会在地球上"
    },
    {
      "end": 43610.24,
      "start": 43609.2,
      "text": "都不一定了"
    },
    {
      "end": 43611.58,
      "start": 43610.24,
      "text": "所以呢"
    },
    {
      "end": 43613.62,
      "start": 43611.58,
      "text": "从现在开始"
    },
    {
      "end": 43616.74,
      "start": 43613.62,
      "text": "我们还是要继续地继续地努力"
    },
    {
      "end": 43617.3,
      "start": 43616.74,
      "text": "好"
    },
    {
      "end": 43618.0,
      "start": 43617.3,
      "text": "谢谢大家"
    },
    {
      "end": 43619.36,
      "start": 43618.0,
      "text": "感谢魔女战友"
    },
    {
      "end": 43622.64,
      "start": 43619.36,
      "text": "感谢魔女战友对大家的热烈问候"
    },
    {
      "end": 43623.96,
      "start": 43622.64,
      "text": "感谢感谢"
    },
    {
      "end": 43625.54,
      "start": 43623.96,
      "text": "今天的一次同时"
    },
    {
      "end": 43628.34,
      "start": 43625.54,
      "text": "我们日本樱花团的我们团长"
    },
    {
      "end": 43630.76,
      "start": 43628.34,
      "text": "定宇二尊先生也来到了现场"
