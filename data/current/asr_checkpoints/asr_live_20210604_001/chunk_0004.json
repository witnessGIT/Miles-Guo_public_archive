      "end": 4221.44,
      "start": 4219.9,
      "text": "重回那片"
    },
    {
      "end": 4223.9,
      "start": 4221.44,
      "text": "大好河山"
    },
    {
      "end": 4242.62,
      "start": 4237.5,
      "text": "我的女神"
    },
    {
      "end": 4244.56,
      "start": 4242.62,
      "text": "离开"
    },
    {
      "end": 4245.4,
      "start": 4244.56,
      "text": "我的音乐"
    },
    {
      "end": 4246.8,
      "start": 4245.4,
      "text": "我们继续"
    },
    {
      "end": 4248.42,
      "start": 4246.8,
      "text": "把某"
    },
    {
      "end": 4249.58,
      "start": 4248.42,
      "text": "把某"
    },
    {
      "end": 4250.58,
