      "end": 4287.64,
      "start": 4285.28,
      "text": "中国国共内战杀戮了无数同胞后"
    },
    {
      "end": 4289.94,
      "start": 4287.64,
      "text": "1949年共产党夺取了政权"
    },
    {
      "end": 4292.92,
      "start": 4289.94,
      "text": "建立了一整套独裁的官僚体系"
    },
    {
      "end": 4294.94,
      "start": 4292.92,
      "text": "化身为党就是政府"
    },
    {
      "end": 4296.9,
      "start": 4294.94,
      "text": "爹亲娘亲不如党亲"
    },
    {
      "end": 4298.06,
      "start": 4296.9,
      "text": "党代表一切"
    },
    {
      "end": 4300.42,
      "start": 4298.06,
      "text": "共产党夺取政权后的行径"
    },
    {
      "end": 4302.26,
      "start": 4300.42,
      "text": "更是一个血腥的杀戮史"
    },
    {
      "end": 4304.7,
      "start": 4302.26,
      "text": "1950年镇压反革命"
    },
    {
      "end": 4308.58,
      "start": 4304.7,
      "text": "1952年中共通过无反运动和公私合营"
    },
    {
      "end": 4309.98,
      "start": 4308.58,
      "text": "将民营企业整肃"
    },
    {
      "end": 4311.9,
      "start": 4309.98,
      "text": "以虚妄的国家名义充公"
    },
    {
      "end": 4313.92,
      "start": 4311.9,
      "text": "及时按共产党的统计"
    },
    {
      "end": 4317.02,
      "start": 4313.92,
      "text": "镇反运动中就有260亿万人被捕"
    },
    {
      "end": 4319.14,
      "start": 4317.02,
      "text": "130亿万人被监禁"
    },
    {
      "end": 4321.68,
      "start": 4319.14,
      "text": "另有71.2万人被处决"
    },
    {
      "end": 4325.08,
      "start": 4321.68,
      "text": "1953年共产党实行第一个五年计划"
    },
    {
      "end": 4327.1,
      "start": 4325.08,
      "text": "其计划剥夺了人民的一切"
    },
    {
      "end": 4330.74,
      "start": 4327.1,
      "text": "土地 房屋 财产 自由 尊严和人格"
    },
    {
      "end": 4332.52,
      "start": 4330.74,
      "text": "消灭了地主和资本家"
    },
    {
      "end": 4336.18,
      "start": 4332.52,
      "text": "共产党充当了全中国的总地主和总资本家"
    },
    {
      "end": 4338.4,
      "start": 4336.18,
      "text": "也就是全中国的总奴隶主"
    },
    {
      "end": 4340.94,
      "start": 4338.4,
      "text": "在农村一切生产资料归功"
    },
    {
      "end": 4343.5,
      "start": 4340.94,
      "text": "农民丧失的一切土地工具"
    },
    {
      "end": 4345.32,
      "start": 4343.5,
      "text": "彻底沦为农业奴隶"
    },
    {
      "end": 4347.78,
      "start": 4345.32,
      "text": "在城市工厂企业被共产"
    },
    {
      "end": 4348.96,
      "start": 4347.78,
      "text": "强行公有化"
    },
    {
      "end": 4350.96,
      "start": 4348.96,
      "text": "所有人沦为工业奴隶"
    },
    {
      "end": 4353.34,
      "start": 4350.96,
      "text": "1958年大跃进开始"
    },
    {
      "end": 4356.14,
      "start": 4353.34,
      "text": "工业大链钢铁破坏代替生产"
    },
    {
      "end": 4357.58,
      "start": 4356.14,
      "text": "农业密集种植"
    },
    {
      "end": 4358.98,
      "start": 4357.58,
      "text": "结果颗粒无收"
    },
    {
      "end": 4361.28,
      "start": 4358.98,
      "text": "中共的报纸上宣传的却是"
    },
    {
      "end": 4362.42,
      "start": 4361.28,
      "text": "母产十万斤"
    },
    {
      "end": 4363.92,
      "start": 4362.42,
      "text": "母猪赛大象等等"
    },
    {
      "end": 4366.14,
      "start": 4363.92,
      "text": "造成的结果就是民不聊生"
    },
    {
      "end": 4367.12,
      "start": 4366.14,
      "text": "饿瓢遍地"
    },
    {
      "end": 4369.3,
      "start": 4367.12,
      "text": "饥饿的人们吃光了草根树皮"
    },
    {
      "end": 4371.22,
      "start": 4369.3,
      "text": "大跃进最终酿称"
    },
    {
      "end": 4374.06,
      "start": 4371.22,
      "text": "1958年到1962年的大饥荒"
    },
    {
      "end": 4376.1,
      "start": 4374.06,
      "text": "按中共自己出版的记录"
    },
    {
      "end": 4378.82,
      "start": 4376.1,
      "text": "就超过4000万人非正常死亡"
    },
    {
      "end": 4381.24,
      "start": 4378.82,
      "text": "实际死亡人数远超于此"
    },
    {
      "end": 4384.64,
      "start": 4381.24,
      "text": "现今中共对这段历史轻轻一笔代国"
    },
    {
      "end": 4387.08,
      "start": 4384.64,
      "text": "归咎于虚构的三年自然灾害"
    },
    {
      "end": 4388.52,
      "start": 4387.08,
      "text": "1966年"
    },
    {
      "end": 4391.32,
      "start": 4388.52,
      "text": "毛泽东发动了全国性的文化革命运动"
    },
    {
      "end": 4393.26,
      "start": 4391.32,
      "text": "深入到社会的每个阶层"
    },
    {
      "end": 4394.26,
      "start": 4393.26,
      "text": "鼓励批斗"
    },
    {
      "end": 4395.42,
      "start": 4394.26,
      "text": "抄家及告密"
    },
    {
      "end": 4398.74,
      "start": 4395.42,
      "text": "使中国传统文化与道德彻底沦丧"
    },
    {
      "end": 4402.3,
      "start": 4398.74,
      "text": "大量文物估计在破斯球中被破坏殆尽"
    },
    {
      "end": 4404.28,
      "start": 4402.3,
      "text": "为其十年的文化大革命"
    },
    {
      "end": 4406.5,
      "start": 4404.28,
      "text": "造成2000万人非正常死亡"
    },
    {
      "end": 4408.96,
      "start": 4406.5,
      "text": "人与人互相仇恨和举报"
    },
    {
      "end": 4412.06,
      "start": 4408.96,
      "text": "对所有人的身体和精神双面折磨"
    },
    {
      "end": 4414.24,
      "start": 4412.06,
      "text": "造成的社会影响持续到今"
    },
    {
      "end": 4416.56,
      "start": 4414.24,
      "text": "无数的冤魂飘落荒野"
    },
    {
      "end": 4419.12,
      "start": 4416.56,
      "text": "中共却一直刻意淡化那段历史"
    },
    {
      "end": 4420.36,
      "start": 4419.12,
      "text": "更为荒诞的是"
    },
    {
      "end": 4423.7,
      "start": 4420.36,
      "text": "当今的中共又继续在国内发动文革2.0"
    },
    {
      "end": 4425.44,
      "start": 4423.7,
      "text": "1981年"
    },
    {
      "end": 4428.92,
      "start": 4425.44,
      "text": "中共强制性一台化的寄生政策终于出台"
    },
    {
      "end": 4430.84,
      "start": 4428.92,
      "text": "并被广泛暴力的实施"
    },
    {
      "end": 4434.0,
      "start": 4430.84,
      "text": "凡违背这一国策都会受到经济处罚"
    },
    {
      "end": 4438.8,
      "start": 4434.0,
      "text": "提罕正常死亡灾原"
    },
    {
      "end": 4439.8,
      "start": 4438.8,
      "text": "受达期 failures"
    },
    {
      "end": 4441.14,
      "start": 4439.8,
      "text": "工匪过灾"
    },
    {
      "end": 4442.3,
      "start": 4441.14,
      "text": "禁止"
    },
    {
      "end": 4443.46,
      "start": 4442.3,
      "text": "通过"
    },
    {
      "end": 4444.58,
      "start": 4443.46,
      "text": "更为罪rade"
    },
    {
      "end": 4445.64,
      "start": 4444.58,
      "text": "……"
    },
    {
      "end": 4446.68,
      "start": 4445.64,
      "text": "推"
    },
    {
      "end": 4449.92,
      "start": 4446.68,
      "text": "試圖干擾啊,試圖干擾啊"
    },
    {
      "end": 4453.56,
      "start": 4449.92,
      "text": "共匪很猖狂,正在干擾中啊"
    },
    {
      "end": 4457.12,
      "start": 4453.56,
      "text": "共匪正在試圖在破壞中啊"
    },
    {
      "end": 4461.8,
      "start": 4457.12,
      "text": "現在聲音怎麼樣?聲音怎麼樣?"
    },
    {
      "end": 4464.5,
      "start": 4461.8,
      "text": "可以了,聲音夠大嗎?"
    },
    {
      "end": 4469.68,
      "start": 4464.5,
      "text": "約翰哥哥在場,如果不出點問題那也不正常,是吧?"
    },
    {
      "end": 4475.48,
      "start": 4469.68,
      "text": "這就是清華的水平嘛,非常好,非常好,OK了"
    },
    {
      "end": 4477.48,
      "start": 4475.48,
      "text": "他們現在幾點到?"
    },
    {
      "end": 4481.48,
      "start": 4477.48,
      "text": "我們時間已經是佔用了十幾分鐘時間,我沒有時間再佔用了"
    },
    {
      "end": 4485.48,
      "start": 4481.48,
      "text": "不行,我們還按老計劃了,把時間讓給主臺了"
    },
    {
      "end": 4487.48,
      "start": 4485.48,
      "text": "好吧?"
    },
    {
      "end": 4491.48,
      "start": 4487.48,
      "text": "你如果是不讓人換你佔用那麼多時間"
    },
    {
      "end": 4495.48,
      "start": 4491.48,
      "text": "我們每秒每分都是極為寶貴啊"
    },
    {
      "end": 4497.48,
      "start": 4495.48,
      "text": "全世界都是搶我們的每分每秒"
    },
    {
      "end": 4500.48,
      "start": 4497.48,
      "text": "這個背後的故事哪天等到"
    }
