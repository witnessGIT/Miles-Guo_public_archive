  "segments": [
    {
      "end": 45000.94,
      "start": 45000.0,
      "text": "小飞象"
    },
    {
      "end": 45002.38,
      "start": 45000.94,
      "text": "小王子"
    },
    {
      "end": 45003.46,
      "start": 45002.38,
      "text": "小飞侠"
    },
    {
      "end": 45004.7,
      "start": 45003.46,
      "text": "这是飞子辈的"
    },
    {
      "end": 45006.68,
      "start": 45004.7,
      "text": "真的是太棒了"
    },
    {
      "end": 45007.4,
      "start": 45006.68,
      "text": "太棒了"
    },
    {
      "end": 45010.62,
      "start": 45007.4,
      "text": "这些都是我们新中国联邦的年轻人"
    },
    {
      "end": 45011.72,
      "start": 45010.62,
      "text": "是我们未来"
    },
    {
      "end": 45012.66,
      "start": 45011.72,
      "text": "我们的希望"
    },
    {
      "end": 45014.52,
      "start": 45012.66,
      "text": "这就是我的感受"
    },
    {
      "end": 45016.48,
      "start": 45014.52,
      "text": "好的"
    },
    {
      "end": 45020.6,
      "start": 45016.48,
      "text": "好的"
    },
    {
      "end": 45023.08,
      "start": 45020.6,
      "text": "非常感谢阿斌女士精彩的回答"
    },
    {
      "end": 45025.52,
      "start": 45023.08,
      "text": "那么下面我们有幸邀请到了"
    },
    {
      "end": 45029.04,
      "start": 45025.52,
      "text": "来自于加拿大洋帆农场的飞翔的小鸟"
    },
    {
      "end": 45030.92,
      "start": 45029.04,
      "text": "那么飞翔的小鸟女士"
    },
    {
      "end": 45033.9,
      "start": 45030.92,
      "text": "因为您这次是作为一个不远万里"
    },
    {
      "end": 45035.86,
      "start": 45033.9,
      "text": "从加拿大来到我们现场参加"
    },
    {
      "end": 45038.28,
      "start": 45035.86,
      "text": "这个我们整个庆典活动的一位嘉宾"
    },
    {
      "end": 45039.7,
      "start": 45038.28,
      "text": "那么作为嘉宾"
    },
    {
      "end": 45041.78,
      "start": 45039.7,
      "text": "请您对我们整个这个活动"
    },
    {
      "end": 45042.56,
      "start": 45041.78,
      "text": "我们的安排"
    },
    {
      "end": 45043.52,
      "start": 45042.56,
      "text": "我们的流程"
    },
    {
      "end": 45044.76,
      "start": 45043.52,
      "text": "在整个过程中"
    },
    {
      "end": 45046.72,
      "start": 45044.76,
      "text": "您最感动的一刻"
    },
    {
      "end": 45048.06,
      "start": 45046.72,
      "text": "一个时刻是什么呢"
    },
    {
      "end": 45054.56,
      "start": 45048.06,
      "text": "最让我感动的是"
    },
    {
      "end": 45056.66,
      "start": 45054.56,
      "text": "整个流程"
    },
    {
      "end": 45062.32,
      "start": 45056.66,
      "text": "我觉得就比CCP中央电台"
    },
    {
      "end": 45064.9,
      "start": 45062.32,
      "text": "感觉还要"
    },
    {
      "end": 45070.1,
      "start": 45064.9,
      "text": "我觉得感觉还要流畅"
    },
    {
      "end": 45075.56,
      "start": 45070.1,
      "text": "而且在这个世贸中心102"
    },
    {
      "end": 45077.96,
      "start": 45075.56,
      "text": "102层见到了"
    },
    {
      "end": 45082.38,
      "start": 45077.96,
      "text": "很多来自世界各地的战友"
    },
    {
      "end": 45085.8,
      "start": 45082.38,
      "text": "还有美国的美国的朋友"
    },
    {
      "end": 45088.5,
      "start": 45085.8,
      "text": "我觉得我们新中国联邦"
    },
    {
      "end": 45090.62,
      "start": 45088.5,
      "text": "未来"
    },
    {
      "end": 45094.04,
      "start": 45090.62,
      "text": "是拯救世界的"
    },
    {
      "end": 45095.52,
      "start": 45094.04,
      "text": "世界的希望"
    },
    {
      "end": 45096.92,
      "start": 45095.52,
      "text": "是全人类"
    },
    {
      "end": 45098.84,
      "start": 45096.92,
      "text": "全人类的希望"
    },
    {
      "end": 45099.96,
      "start": 45098.84,
      "text": "谢谢"
    },
    {
      "end": 45107.26,
      "start": 45099.96,
      "text": "好的"
    },
    {
      "end": 45111.22,
      "start": 45107.26,
      "text": "我们非常感谢加拿大温哥华杨帆农场的"
    },
    {
      "end": 45112.66,
      "start": 45111.22,
      "text": "目前负责人"
    },
    {
      "end": 45113.84,
      "start": 45112.66,
      "text": "飞翔的小鸟战友"
    },
    {
      "end": 45115.96,
      "start": 45113.84,
      "text": "那么接下来让我们邀请"
    },
    {
      "end": 45118.96,
      "start": 45115.96,
      "text": "加拿大多伦多枫叶农场的负责人"
    },
    {
      "end": 45119.8,
      "start": 45118.96,
      "text": "文峰女士"
    },
    {
      "end": 45121.88,
      "start": 45119.8,
      "text": "我想问文峰女士的是"
    },
    {
      "end": 45123.96,
      "start": 45121.88,
      "text": "今天在场的很多战友"
    },
    {
      "end": 45125.1,
      "start": 45123.96,
      "text": "都非常荣幸"
    },
    {
      "end": 45126.26,
      "start": 45125.1,
      "text": "也非常激动地"
    },
    {
      "end": 45127.82,
      "start": 45126.26,
      "text": "见到了英雄科学家"
    },
    {
      "end": 45130.48,
      "start": 45127.82,
      "text": "严厉梦博士以及我们的路德先生"
    },
    {
      "end": 45132.4,
      "start": 45130.48,
      "text": "那我想采访一下您"
    },
    {
      "end": 45134.4,
      "start": 45132.4,
      "text": "见到这二位英雄的时候"
    },
    {
      "end": 45136.08,
      "start": 45134.4,
      "text": "您的感受是怎么样的"
    },
    {
      "end": 45137.16,
      "start": 45136.08,
      "text": "文峰女士"
    },
    {
      "end": 45141.32,
      "start": 45137.16,
      "text": "战友们好"
    },
    {
      "end": 45143.28,
      "start": 45141.32,
      "text": "包括郭先生好"
    },
    {
      "end": 45146.02,
      "start": 45143.28,
      "text": "我知道郭先生在看着这个屏幕呢"
    },
    {
      "end": 45149.4,
      "start": 45146.02,
      "text": "我们在这个反光的镜子里面"
    },
    {
      "end": 45150.46,
      "start": 45149.4,
      "text": "能看到郭先生"
    },
    {
      "end": 45153.28,
      "start": 45150.46,
      "text": "真的津津有味地看着我们的表现"
    },
    {
      "end": 45156.62,
      "start": 45153.28,
      "text": "我想说今天最大的惊喜"
    },
    {
      "end": 45159.28,
      "start": 45156.62,
      "text": "真的就是严博士的出现"
    },
    {
      "end": 45161.2,
      "start": 45159.28,
      "text": "因为当时"
    },
    {
      "end": 45162.2,
      "start": 45161.2,
      "text": "啊"
    },
    {
      "end": 45163.2,
      "start": 45162.2,
      "text": "张大哥说"
    },
    {
      "end": 45164.88,
      "start": 45163.2,
      "text": "让我们农场主下去"
    },
    {
      "end": 45167.2,
      "start": 45164.88,
      "text": "列队欢迎一个贵宾"
    },
    {
      "end": 45169.88,
      "start": 45167.2,
      "text": "我想我能猜到的"
    },
    {
      "end": 45170.96,
      "start": 45169.88,
      "text": "要么就是"
    },
    {
      "end": 45172.66,
      "start": 45170.96,
      "text": "蓬佩奥先生"
    },
    {
      "end": 45174.78,
      "start": 45172.66,
      "text": "或者说路德先生"
    },
    {
      "end": 45177.2,
      "start": 45174.78,
      "text": "但是真是万万没有想到"
    },
    {
      "end": 45181.2,
      "start": 45177.2,
      "text": "严博士就冒着各种危险来到现场"
    },
    {
      "end": 45184.78,
      "start": 45181.2,
      "text": "然后他那个演讲真的是太精彩了"
    },
    {
      "end": 45186.94,
      "start": 45184.78,
      "text": "就是他讲的每句话"
    },
    {
      "end": 45188.86,
      "start": 45186.94,
      "text": "每个字就像子弹一样"
    },
    {
      "end": 45190.78,
      "start": 45188.86,
      "text": "真的特别铿锵有力"
    },
    {
      "end": 45193.12,
      "start": 45190.78,
      "text": "就是特别鼓励人心"
    },
    {
      "end": 45196.12,
      "start": 45193.12,
      "text": "然后包括在场的班农先生啊"
    },
    {
      "end": 45200.44,
      "start": 45196.12,
      "text": "还有几位邀请来的呃"
    },
    {
      "end": 45201.7,
      "start": 45200.44,
      "text": "贵宾啊"
    },
    {
      "end": 45204.2,
      "start": 45201.7,
      "text": "他们都是就是无数次的"
    },
    {
      "end": 45206.78,
      "start": 45204.2,
      "text": "应该是听过颜博士的演讲吧"
    },
    {
      "end": 45210.16,
      "start": 45206.78,
      "text": "但是都是每一次他讲的都是"
    },
    {
      "end": 45214.28,
      "start": 45210.16,
      "text": "让人觉得他真的是上天派来的天使"
    },
    {
      "end": 45215.92,
      "start": 45214.28,
      "text": "他的那个"
    },
    {
      "end": 45220.28,
      "start": 45215.92,
      "text": "就是对这个病毒的这个揭露真相"
    },
    {
      "end": 45224.6,
      "start": 45220.28,
      "text": "为拯救世界人民的这个伟大的贡献"
    },
    {
      "end": 45227.78,
      "start": 45224.6,
      "text": "我觉得真的是我们新中国联邦人的骄傲"
    },
    {
      "end": 45230.0,
      "start": 45227.78,
      "text": "然后这个路德先生"
    },
    {
      "end": 45232.38,
      "start": 45230.0,
      "text": "你真的是要感谢他"
    },
    {
      "end": 45234.16,
      "start": 45232.38,
      "text": "没有他一直这样"
    },
    {
      "end": 45240.28,
      "start": 45234.16,
      "text": "呃努力的每天两级建立起来这种这种信誉"
    },
    {
      "end": 45245.92,
      "start": 45240.28,
      "text": "呃这个颜博士也不会说是通过他来把这个病毒真相"
    },
    {
      "end": 45247.28,
      "start": 45245.92,
      "text": "带到世界来"
    },
    {
      "end": 45251.04,
      "start": 45247.28,
      "text": "所以我到现在我都回忆起当时"
    },
    {
      "end": 45253.28,
      "start": 45251.04,
      "text": "颜博士还有路德先生"
    },
    {
      "end": 45258.16,
      "start": 45253.28,
      "text": "他讲的就是呃这个博士是怎么出逃的"
    },
    {
      "end": 45260.16,
      "start": 45258.16,
      "text": "其实那一天我觉得"
    },
    {
      "end": 45265.4,
      "start": 45260.16,
      "text": "我也很记得4月29号应该是颜博士到达美国"
    },
    {
      "end": 45268.28,
      "start": 45265.4,
      "text": "其实我到现在我觉得这是冥冥之中"
    },
    {
      "end": 45271.32,
      "start": 45268.28,
      "text": "真的颜博士就是上天派来的"
    },
    {
      "end": 45274.04,
      "start": 45271.32,
      "text": "就是那天我也记得是那时候私募"
    },
    {
      "end": 45276.66,
      "start": 45274.04,
      "text": "郭先生那天我还跟他说"
    },
    {
      "end": 45279.0,
      "start": 45276.66,
      "text": "我卖掉了一套房子"
    },
    {
      "end": 45281.46,
      "start": 45279.0,
      "text": "就是因为听了这个爆料革命"
    },
    {
      "end": 45282.28,
      "start": 45281.46,
      "text": "然后呢"
    },
    {
      "end": 45284.46,
      "start": 45282.28,
      "text": "我投资这个私募"
    },
    {
      "end": 45287.0,
      "start": 45284.46,
      "text": "然后你说这个世界是多么奇妙"
    },
    {
      "end": 45290.24,
      "start": 45287.0,
      "text": "颜博士在那一天到达美国"
    },
    {
      "end": 45294.12,
      "start": 45290.24,
      "text": "然后我们听了爆料革命这么多年啊"
    },
    {
      "end": 45298.16,
      "start": 45294.12,
      "text": "啊这么当时郭先生也好啊"
    },
    {
      "end": 45300.8,
      "start": 45298.16,
      "text": "路德先生也好"
    },
    {
      "end": 45303.12,
      "start": 45300.8,
      "text": "他们拯救了无数的人"
    },
    {
      "end": 45306.24,
      "start": 45303.12,
      "text": "真的就是每一个普通人也好"
    },
    {
      "end": 45309.36,
      "start": 45306.24,
      "text": "或者一些伟大的人物也好"
    },
    {
      "end": 45312.36,
      "start": 45309.36,
      "text": "都是得益于这个爆料革命啊"
    },
    {
      "end": 45315.48,
      "start": 45312.36,
      "text": "包括不只拯救的是中国人民"
    },
    {
      "end": 45317.36,
      "start": 45315.48,
      "text": "还是世界人民"
    },
    {
      "end": 45320.36,
      "start": 45317.36,
      "text": "所以我觉得颜博士跟路德先生"
    },
    {
      "end": 45323.36,
      "start": 45320.36,
      "text": "真的就是我们中国人民的骄傲"
    },
    {
      "end": 45325.48,
      "start": 45323.36,
      "text": "也是新中国联邦"
    },
    {
      "end": 45329.36,
      "start": 45325.48,
      "text": "呃我们的呃两个天使啊"
    },
    {
      "end": 45333.48,
      "start": 45329.36,
      "text": "所以我今天最大的惊喜就是见到他们两个"
    },
    {
      "end": 45335.96,
      "start": 45333.48,
      "text": "我特别感谢他们两个的到来"
    },
    {
      "end": 45336.48,
      "start": 45335.96,
      "text": "谢谢啊"
    },
    {
      "end": 45340.48,
      "start": 45336.48,
      "text": "好的"
    },
    {
      "end": 45343.48,
      "start": 45340.48,
      "text": "非常感谢文峰女士精彩的回答"
    },
    {
      "end": 45344.68,
      "start": 45343.48,
      "text": "那么下面呢"
    },
    {
      "end": 45349.6,
      "start": 45344.68,
      "text": "我们来采访来自波士顿五月花农场的七哥老妹"
    },
    {
      "end": 45351.32,
      "start": 45349.6,
      "text": "那么七哥老妹战友"
    },
    {
      "end": 45352.76,
      "start": 45351.32,
      "text": "呃您今天呢"
    },
    {
      "end": 45355.16,
      "start": 45352.76,
      "text": "也是跟着您的丈夫不远万里呃"
    },
    {
      "end": 45356.24,
      "start": 45355.16,
      "text": "来到了我们的现场"
    },
    {
      "end": 45359.24,
      "start": 45356.24,
      "text": "也是一直参与背后的主要的组织者之一"
    },
    {
      "end": 45361.56,
      "start": 45359.24,
      "text": "那么我们今天我今天非常想想问您"
    },
    {
      "end": 45362.16,
      "start": 45361.56,
      "text": "呃"
    },
    {
      "end": 45365.4,
      "start": 45362.16,
      "text": "那么整个现场除了七哥班农先生"
    },
    {
      "end": 45367.8,
      "start": 45365.4,
      "text": "您的丈夫还有我还有我们书知的战友以外"
    },
    {
      "end": 45370.32,
      "start": 45367.8,
      "text": "您认为最帅的七的战友是哪一位呢"
    },
    {
      "end": 45371.52,
      "start": 45370.32,
      "text": "男战友"
    },
    {
      "end": 45373.6,
      "start": 45371.52,
      "text": "哈哈哈哈"
    },
    {
      "end": 45377.52,
      "start": 45373.6,
      "text": "最帅的还是我们七哥"
    },
    {
      "end": 45379.48,
      "start": 45377.52,
      "text": "哈哈哈哈哈哈"
    },
    {
      "end": 45381.76,
      "start": 45379.48,
      "text": "哦"
    },
    {
      "end": 45383.0,
      "start": 45381.76,
      "text": "谢谢呃"
    },
    {
      "end": 45384.04,
      "start": 45383.0,
      "text": "谢谢小王子"
    },
    {
      "end": 45384.84,
      "start": 45384.04,
      "text": "呃"
    },
    {
      "end": 45385.96,
      "start": 45384.84,
      "text": "谢谢主持人"
    },
    {
      "end": 45387.96,
      "start": 45385.96,
      "text": "那个呃"
    },
    {
      "end": 45388.96,
      "start": 45387.96,
      "text": "呃"
    },
    {
      "end": 45392.96,
      "start": 45388.96,
      "text": "这一次活动哈非常的辛苦也非常的非常的开心"
    },
    {
      "end": 45393.6,
      "start": 45392.96,
      "text": "呃"
    },
    {
      "end": 45395.6,
      "start": 45393.6,
      "text": "但是看到今天的这个盛况"
    },
    {
      "end": 45398.6,
      "start": 45395.6,
      "text": "我觉得一切都是非常的非常的值"
    },
    {
