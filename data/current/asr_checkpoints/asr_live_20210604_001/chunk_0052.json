      "text": "是不是"
    },
    {
      "end": 47351.8,
      "start": 47349.8,
      "text": "是个子老虎"
    },
    {
      "end": 47353.94,
      "start": 47351.8,
      "text": "我也是做地产"
    },
    {
      "end": 47355.9,
