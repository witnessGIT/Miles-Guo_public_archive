    },
    {
      "end": 23477.14,
      "start": 23473.82,
      "text": "We got to stop talking about it and it must happen."
    },
    {
      "end": 23479.96,
      "start": 23477.14,
      "text": "They must be held accountable. That's a great word."
    },
    {
      "end": 23486.58,
      "start": 23480.06,
