{
  "chunk_audio_sha256": "ca1387d0d94509a6a8974dbfa83c096412bee4aa4d3b992bac6599e786b469c2",
  "chunk_index": 14,
  "completed_at": "2026-10-18T15:22:47Z",
  "language": "zh",
  "live_id": "LIVE_20210604_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 12600,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 12601.3,
      "start": 12600.0,
      "text": "而且成了富的"
    },
    {
      "end": 12603.5,
      "start": 12601.3,
      "text": "科學家有自己的丈夫"
    },
    {
      "end": 12605.4,
      "start": 12603.5,
      "text": "有自己的爹媽、自己的親人"
    },
    {
      "end": 12607.8,
      "start": 12605.4,
      "text": "一個非常年輕美好的生活"
    },
    {
      "end": 12609.4,
      "start": 12607.8,
      "text": "所有人想要他都有了"
    },
    {
      "end": 12610.8,
      "start": 12609.4,
      "text": "他全都放棄了"
    },
    {
      "end": 12612.9,
      "start": 12610.8,
      "text": "他從來沒想過要什麼名啊"
    },
    {
      "end": 12614.2,
      "start": 12612.9,
      "text": "什麼勳章啊"
    },
    {
      "end": 12615.5,
      "start": 12614.2,
      "text": "更沒有想要多少錢"
    },
    {
      "end": 12616.5,
      "start": 12615.5,
      "text": "他沒有概念"
    },
    {
      "end": 12618.8,
      "start": 12616.5,
      "text": "我們路德先生也可以看得出來"
    },
    {
      "end": 12622.0,
      "start": 12618.8,
      "text": "過去的幾年在爆料革命從始到今"
    },
    {
      "end": 12625.5,
      "start": 12622.0,
      "text": "可以說經歷了多大的考驗和生死的挑戰"
    },
    {
      "end": 12627.5,
      "start": 12625.5,
      "text": "帶著撒孩子、帶著妻子"
    },
    {
      "end": 12629.2,
      "start": 12627.5,
      "text": "一天兩天"
    },
    {
      "end": 12631.9,
      "start": 12629.2,
      "text": "我們這些戰友都證明了什麼"
    },
    {
      "end": 12633.5,
      "start": 12631.9,
      "text": "不是追求名利的"
    },
    {
      "end": 12638.2,
      "start": 12633.5,
      "text": "所有為了公義的權利和追求正義的人"
    },
    {
      "end": 12641.0,
      "start": 12638.2,
      "text": "任何有名義、力圖之心都是偽正義"
    },
    {
      "end": 12642.4,
      "start": 12641.0,
      "text": "我說我們絕對不是"
    },
    {
      "end": 12646.8,
      "start": 12642.4,
      "text": "這位朋友呢非常承認我的想法"
    },
    {
      "end": 12647.6,
      "start": 12646.8,
      "text": "我跟科學家說"
    },
    {
      "end": 12648.6,
      "start": 12647.6,
      "text": "我跟路德先生說"
    },
    {
      "end": 12651.2,
      "start": 12648.6,
      "text": "沒有任何容易配上我們新中國聯邦人"
    },
    {
      "end": 12654.2,
      "start": 12651.2,
      "text": "特別沒有任何人配上我們的郝海東先生"
    },
    {
      "end": 12655.3,
      "start": 12654.2,
      "text": "葉招影妹妹"
    },
    {
      "end": 12657.3,
      "start": 12655.3,
      "text": "我們的閻麗夢這個博士"
    },
    {
      "end": 12658.5,
      "start": 12657.3,
      "text": "還有我們路德先生"
    },
    {
      "end": 12661.2,
      "start": 12658.5,
      "text": "包括我們的博士軍團和億萬個戰友"
    },
    {
      "end": 12663.8,
      "start": 12661.2,
      "text": "因為我們圖這些不會幹這種事"
    },
    {
      "end": 12666.7,
      "start": 12663.8,
      "text": "這種買賣實在是太不和划算了"
    },
    {
      "end": 12668.2,
      "start": 12666.7,
      "text": "是拿全家的生命"
    },
    {
      "end": 12669.7,
      "start": 12668.2,
      "text": "就像剛才張友妹妹"
    },
    {
      "end": 12672.4,
      "start": 12669.7,
      "text": "自己的父母、自己的女兒受到了威脅"
    },
    {
      "end": 12673.7,
      "start": 12672.4,
      "text": "郝海東先生的家人"
    },
    {
      "end": 12674.7,
      "start": 12673.7,
      "text": "據我所知"
    },
    {
      "end": 12677.1,
      "start": 12674.7,
      "text": "爆料革命的內部爆料人都是受到威脅"
    },
    {
      "end": 12679.2,
      "start": 12677.1,
      "text": "而且郝海東先生的家人非常智慧"
    },
    {
      "end": 12680.6,
      "start": 12679.2,
      "text": "我們家已經跟他斷交了"
    },
    {
      "end": 12681.9,
      "start": 12680.6,
      "text": "他是個逆子"
    },
    {
      "end": 12683.1,
      "start": 12681.9,
      "text": "不要跟我們說這個"
    },
    {
      "end": 12686.9,
      "start": 12683.1,
      "text": "這就是今天咱們這個桌上幾個都是山東人啊"
    },
    {
      "end": 12687.9,
      "start": 12686.9,
      "text": "山東京都的"
    },
    {
      "end": 12690.6,
      "start": 12687.9,
      "text": "我們有了科學家還有這個我們路德先生"
    },
    {
      "end": 12691.6,
      "start": 12690.6,
      "text": "我們這些人"
    },
    {
      "end": 12693.2,
      "start": 12691.6,
      "text": "我們有共同的成長背景"
    },
    {
      "end": 12697.6,
      "start": 12693.2,
      "text": "我們有了共同的受到共產黨的這種欺負和打壓"
    },
    {
      "end": 12698.8,
      "start": 12697.6,
      "text": "沒有共產黨"
    },
    {
      "end": 12700.6,
      "start": 12698.8,
      "text": "我相信中國比這個還好"
    },
    {
      "end": 12701.6,
      "start": 12700.6,
      "text": "沒有共產黨"
    },
    {
      "end": 12704.6,
      "start": 12701.6,
      "text": "我們這些人的DNA和智商和能力"
    },
    {
      "end": 12705.9,
      "start": 12704.6,
      "text": "比今天還好"
    },
    {
      "end": 12708.9,
      "start": 12705.9,
      "text": "不是一切都聽黨的都好"
    },
    {
      "end": 12711.9,
      "start": 12708.9,
      "text": "你葉昭穎妹妹科學家路德先生"
    },
    {
      "end": 12715.1,
      "start": 12711.9,
      "text": "我都曾經不管是貌事還是真的"
    },
    {
      "end": 12717.3,
      "start": 12715.1,
      "text": "都曾經絕對聽過黨的"
    },
    {
      "end": 12718.6,
      "start": 12717.3,
      "text": "結果是什麼呢"
    },
    {
      "end": 12720.3,
      "start": 12718.6,
      "text": "他拿走我們的一切"
    },
    {
      "end": 12721.3,
      "start": 12720.3,
      "text": "惡奪了我們一切"
    },
    {
      "end": 12724.4,
      "start": 12721.3,
      "text": "我們不可能再讓我們的子孫後代在這樣"
    },
    {
      "end": 12728.0,
      "start": 12724.4,
      "text": "所以說今天海東兄弟還有昭穎妹妹"
    },
    {
      "end": 12732.2,
      "start": 12728.0,
      "text": "這個昨天某軍隊的一位這個上將"
    },
    {
      "end": 12734.7,
      "start": 12732.2,
      "text": "他的司機給我發了個信息"
    },
    {
      "end": 12736.0,
      "start": 12734.7,
      "text": "民間啊"
    },
    {
      "end": 12740.2,
      "start": 12736.0,
      "text": "盡量不要讓東還有影出太多鏡頭"
    },
    {
      "end": 12742.0,
      "start": 12740.2,
      "text": "讓他倆安全點吧"
    },
    {
      "end": 12742.7,
      "start": 12742.0,
      "text": "啊"
    },
    {
      "end": 12744.0,
      "start": 12742.7,
      "text": "我給他發了個信息"
    },
    {
      "end": 12745.2,
      "start": 12744.0,
      "text": "為了安全"
    },
    {
      "end": 12746.7,
      "start": 12745.2,
      "text": "最好就是多出鏡頭"
    },
    {
      "end": 12748.2,
      "start": 12746.7,
      "text": "這就是他倆的選擇"
    },
    {
      "end": 12749.5,
      "start": 12748.2,
      "text": "所以說東弟營妹妹"
    },
    {
      "end": 12752.3,
      "start": 12749.5,
      "text": "很多國內的有良知的戰友們"
    },
    {
      "end": 12754.9,
      "start": 12752.3,
      "text": "還有體制內的這些有良知的人"
    },
    {
      "end": 12756.8,
      "start": 12754.9,
      "text": "就等待著我們鎮臂一戶"
    },
    {
      "end": 12757.9,
      "start": 12756.8,
      "text": "他們在關心我們"
    },
    {
      "end": 12758.7,
      "start": 12757.9,
      "text": "他在愛我們"
    },
    {
      "end": 12760.9,
      "start": 12758.7,
      "text": "我特別的感謝你們一直以來"
    },
    {
      "end": 12764.7,
      "start": 12760.9,
      "text": "和路德先生科學家和我們一萬個戰友所遵循的"
    },
    {
      "end": 12767.7,
      "start": 12764.7,
      "text": "絕對共產黨內部99都是我們的戰友"
    },
    {
      "end": 12769.9,
      "start": 12767.7,
      "text": "是我們可團結的還有是好人"
    },
    {
      "end": 12771.9,
      "start": 12769.9,
      "text": "我們滅的是共產黨的體制"
    },
    {
      "end": 12773.4,
      "start": 12771.9,
      "text": "我們不針對任何人"
    },
    {
      "end": 12776.9,
      "start": 12773.4,
      "text": "而且我們要的事情要剷除這個體制"
    },
    {
      "end": 12778.9,
      "start": 12776.9,
      "text": "而且要釋放所有的中國人"
    },
    {
      "end": 12780.7,
      "start": 12778.9,
      "text": "而且不是種族仇恨"
    },
    {
      "end": 12783.4,
      "start": 12780.7,
      "text": "也不是社會大清洗也不是大屠殺"
    },
    {
      "end": 12786.4,
      "start": 12783.4,
      "text": "特別的感謝您為西藏新疆"
    },
    {
      "end": 12788.9,
      "start": 12786.4,
      "text": "台灣香港所有同胞都呼籲"
    },
    {
      "end": 12792.4,
      "start": 12788.9,
      "text": "現在東弟營妹妹現在路德先生科學家在這兒"
    },
    {
      "end": 12793.9,
      "start": 12792.4,
      "text": "你給他倆有什麽要說的"
    },
    {
      "end": 12795.7,
      "start": 12793.9,
      "text": "現在把鏡頭切一下"
    },
    {
      "end": 12796.7,
      "start": 12795.7,
      "text": "約翰哥哥"
    },
    {
      "end": 12798.7,
      "start": 12796.7,
      "text": "約翰哥哥已經睡著了很抱歉啊"
    },
    {
      "end": 12801.7,
      "start": 12800.7,
      "text": "這是"
    },
    {
      "end": 12806.7,
      "start": 12805.7,
      "text": "這個"
    },
    {
      "end": 12811.7,
      "start": 12806.7,
      "text": "這個葉女俠您先說"
    },
    {
      "end": 12816.7,
      "start": 12811.7,
      "text": "你說你說路德說"
    },
    {
      "end": 12820.7,
      "start": 12816.7,
      "text": "您看坐在這裏啊"
    },
    {
      "end": 12822.7,
      "start": 12820.7,
      "text": "文貴先生代表什麽"
    },
    {
      "end": 12825.7,
      "start": 12822.7,
      "text": "中國的真正的商界"
    },
    {
      "end": 12830.7,
      "start": 12825.7,
      "text": "甚至在有產者的站出來"
    },
    {
      "end": 12832.7,
      "start": 12830.7,
      "text": "科學家代表什麽"
    },
    {
      "end": 12834.7,
      "start": 12832.7,
      "text": "科學界是吧"
    },
    {
      "end": 12837.7,
      "start": 12834.7,
      "text": "郝董和葉女俠體育界"
    },
    {
      "end": 12840.7,
      "start": 12837.7,
      "text": "這三界可以說是中共"
    },
    {
      "end": 12843.7,
      "start": 12840.7,
      "text": "可以說是最最重視的"
    },
    {
      "end": 12844.7,
      "start": 12843.7,
      "text": "他可以這個"
    },
    {
      "end": 12846.7,
      "start": 12844.7,
      "text": "比如說你開餐廳的話他也不去管"
    },
    {
      "end": 12850.7,
      "start": 12846.7,
      "text": "但這三界無論是從思想上"
    },
    {
      "end": 12852.7,
      "start": 12850.7,
      "text": "還是從行為上"
    },
    {
      "end": 12853.7,
      "start": 12852.7,
      "text": "從小可以說"
    },
    {
      "end": 12854.7,
      "start": 12853.7,
      "text": "郝董不用說了"
    },
    {
      "end": 12857.7,
      "start": 12854.7,
      "text": "那十歲就開始在部隊裏是吧"
    },
    {
      "end": 12860.7,
      "start": 12857.7,
      "text": "你們站在這裏的鎮臂以後"
    },
    {
      "end": 12863.7,
      "start": 12860.7,
      "text": "就揭穿了一個中共的"
    },
    {
      "end": 12866.7,
      "start": 12863.7,
      "text": "從小的這種洗腦體制的徹底的示範"
    },
    {
      "end": 12867.7,
      "start": 12866.7,
      "text": "是吧"
    },
    {
      "end": 12868.7,
      "start": 12867.7,
      "text": "往這一站"
    },
    {
      "end": 12870.7,
      "start": 12868.7,
      "text": "特別是郝董和葉女俠"
    },
    {
      "end": 12872.7,
      "start": 12870.7,
      "text": "體育界"
    },
    {
      "end": 12874.7,
      "start": 12872.7,
      "text": "這是中共用來洗腦"
    },
    {
      "end": 12876.7,
      "start": 12874.7,
      "text": "對中國人"
    },
    {
      "end": 12877.7,
      "start": 12876.7,
      "text": "植入"
    },
    {
      "end": 12878.7,
      "start": 12877.7,
      "text": "就是前天"
    },
    {
      "end": 12879.7,
      "start": 12878.7,
      "text": "前天"
    },
    {
      "end": 12880.7,
      "start": 12879.7,
      "text": "前天"
    },
    {
      "end": 12883.7,
      "start": 12880.7,
      "text": "習近平專門在中央政治局"
    },
    {
      "end": 12886.7,
      "start": 12883.7,
      "text": "關於如何擴大國際"
    },
    {
      "end": 12887.7,
      "start": 12886.7,
      "text": "什麽這個話語權"
    },
    {
      "end": 12890.7,
      "start": 12887.7,
      "text": "最重要的一個點就是體育界"
    },
    {
      "end": 12892.7,
      "start": 12891.7,
      "text": "體育界裡頭"
    },
    {
      "end": 12893.7,
      "start": 12892.7,
      "text": "羽毛球"
    },
    {
      "end": 12894.7,
      "start": 12893.7,
      "text": "那蟲球"
    },
    {
      "end": 12896.7,
      "start": 12894.7,
      "text": "那是凝聚多少人的這種夢想"
    },
    {
      "end": 12897.7,
      "start": 12896.7,
      "text": "和多少人的心"
    },
    {
      "end": 12898.7,
      "start": 12897.7,
      "text": "在那裏面"
    },
    {
      "end": 12899.7,
      "start": 12898.7,
      "text": "羽毛球"
    },
    {
      "end": 12900.7,
      "start": 12899.7,
      "text": "讓中國人"
    },
    {
      "end": 12901.7,
      "start": 12900.7,
      "text": "我們年輕的時候"
    },
    {
      "end": 12903.7,
      "start": 12901.7,
      "text": "我們小的時候上大學都驕傲"
    },
    {
      "end": 12905.7,
      "start": 12903.7,
      "text": "葉昭義為中國"
    },
    {
      "end": 12907.7,
      "start": 12905.7,
      "text": "奪取冠軍"
    },
    {
      "end": 12911.7,
      "start": 12907.7,
      "text": "但是今天他們看到了"
    },
    {
      "end": 12913.7,
      "start": 12911.7,
      "text": "這三個"
    },
    {
      "end": 12915.7,
      "start": 12913.7,
      "text": "這三界裡頭"
    },
    {
      "end": 12917.7,
      "start": 12915.7,
      "text": "可以說是涵蓋的"
    },
    {
      "end": 12918.7,
      "start": 12917.7,
      "text": "最頂端的"
    },
    {
      "end": 12919.7,
      "start": 12918.7,
      "text": "絕對最頂端的"
    },
    {
      "end": 12920.7,
      "start": 12919.7,
      "text": "文貴先生"
    },
    {
      "end": 12921.7,
      "start": 12920.7,
      "text": "絕對是商界最頂端"
    },
    {
      "end": 12922.7,
      "start": 12921.7,
      "text": "好懂"
    },
    {
      "end": 12923.7,
      "start": 12922.7,
      "text": "絕對是足球界"
    },
    {
      "end": 12924.7,
      "start": 12923.7,
      "text": "百五百最頂端"
    },
    {
      "end": 12926.7,
      "start": 12924.7,
      "text": "那葉女俠"
    },
    {
      "end": 12927.7,
      "start": 12926.7,
