      "end": 13220.3,
      "start": 13219.32,
      "text": "一個爺爺不知道"
    },
    {
      "end": 13222.4,
      "start": 13220.3,
      "text": "其實沒那麼怎麼著"
    },
    {
      "end": 13223.64,
      "start": 13222.4,
      "text": "我把這個"
    },
    {
      "end": 13224.86,
      "start": 13223.64,
      "text": "我自己弄小剪刀"
    },
    {
      "end": 13225.46,
      "start": 13224.86,
      "text": "拿酒精"
    },
    {
      "end": 13226.8,
      "start": 13225.46,
      "text": "拿那個火柴"
    },
    {
      "end": 13227.68,
      "start": 13226.8,
      "text": "燒一燒"
    },
    {
      "end": 13230.0,
      "start": 13227.68,
      "text": "剪完自己就給燉了"
    },
    {
      "end": 13230.5,
      "start": 13230.0,
      "text": "拆線"
    },
    {
      "end": 13231.8,
      "start": 13230.5,
      "text": "根本不去醫院"
    },
    {
      "end": 13232.4,
      "start": 13231.8,
      "text": "是吧"
    },
    {
      "end": 13233.4,
      "start": 13232.4,
      "text": "我頭破血流"
    },
    {
      "end": 13234.38,
      "start": 13233.4,
      "text": "接著比賽"
    },
    {
      "end": 13236.14,
      "start": 13234.38,
      "text": "接著縫吞不打麻藥"
    },
    {
      "end": 13237.68,
      "start": 13236.14,
      "text": "我十幾歲腿上"
    },
    {
      "end": 13238.24,
      "start": 13237.68,
      "text": "對吧"
    },
    {
      "end": 13239.6,
      "start": 13238.24,
      "text": "十七針"
    },
    {
      "end": 13240.04,
      "start": 13239.6,
      "text": "對吧"
    },
    {
      "end": 13240.98,
      "start": 13240.04,
      "text": "都踢開了"
    },
    {
      "end": 13242.24,
      "start": 13240.98,
      "text": "都肩骨頭"
    },
    {
      "end": 13242.82,
      "start": 13242.24,
      "text": "對吧"
    },
    {
      "end": 13244.72,
      "start": 13242.82,
      "text": "郝愛同沒人坑過一聲"
    },
    {
      "end": 13245.12,
      "start": 13244.72,
      "text": "對吧"
    },
    {
      "end": 13246.18,
      "start": 13245.12,
      "text": "接著跟他們對抗"
    },
    {
      "end": 13247.74,
      "start": 13246.18,
      "text": "接著我在場上打主力"
    },
    {
      "end": 13249.62,
      "start": 13247.74,
      "text": "你想想一個十幾歲的孩子"
    },
    {
      "end": 13250.46,
      "start": 13249.62,
      "text": "都敢這樣"
    },
    {
      "end": 13252.16,
      "start": 13250.46,
      "text": "你共產黨嚇唬我啥"
    },
    {
      "end": 13252.78,
      "start": 13252.16,
      "text": "嚇唬我們"
    },
    {
      "end": 13253.86,
      "start": 13252.78,
      "text": "他吹牛逼"
    },
    {
      "end": 13254.86,
      "start": 13253.86,
      "text": "對吧"
    },
    {
      "end": 13258.26,
      "start": 13255.76,
      "text": "中共宣傳一直說"
    },
    {
      "end": 13259.86,
      "start": 13258.26,
      "text": "正能量正能量"
    },
    {
      "end": 13261.76,
      "start": 13259.86,
      "text": "正能量就在這裡"
    },
    {
      "end": 13263.14,
      "start": 13261.76,
      "text": "就在郝總"
    },
    {
      "end": 13264.16,
      "start": 13263.14,
      "text": "文維協說"
    },
    {
      "end": 13265.9,
      "start": 13264.16,
      "text": "嚴格勢"
    },
    {
      "end": 13266.86,
      "start": 13265.9,
      "text": "葉女俠這裡"
    },
    {
      "end": 13267.54,
      "start": 13266.86,
      "text": "葉女俠"
    },
    {
      "end": 13268.88,
      "start": 13267.54,
      "text": "你看前幾天"
    },
    {
      "end": 13270.08,
      "start": 13268.88,
      "text": "甘肅的這個長跑"
    },
    {
      "end": 13270.94,
      "start": 13270.08,
      "text": "死這麼多人"
    },
    {
      "end": 13271.94,
      "start": 13270.94,
      "text": "後來我一看"
    },
    {
      "end": 13274.22,
      "start": 13271.94,
      "text": "葉女俠是北京最出名的"
    },
    {
      "end": 13276.18,
      "start": 13274.22,
      "text": "葉思跑的創始人"
    },
    {
      "end": 13277.22,
      "start": 13276.18,
      "text": "組織呢"
    },
    {
      "end": 13280.16,
      "start": 13277.22,
      "text": "當時多少人"
    },
    {
      "end": 13282.22,
      "start": 13280.16,
      "text": "多少影視明星"
    },
    {
      "end": 13284.46,
      "start": 13282.22,
      "text": "要加入這個葉思跑"
    },
    {
      "end": 13285.16,
      "start": 13284.46,
      "text": "是吧"
    },
    {
      "end": 13286.16,
      "start": 13285.16,
      "text": "搞得轟轟烈烈"
    },
    {
      "end": 13288.3,
      "start": 13286.16,
      "text": "整個影響極其大"
    },
    {
      "end": 13289.2,
      "start": 13288.3,
      "text": "登上過"
    },
    {
      "end": 13294.6,
      "start": 13289.2,
      "text": "登上過世界第二高峰叫什麼"
    },
    {
      "end": 13295.88,
      "start": 13294.6,
      "text": "不是第二高峰"
    },
    {
      "end": 13298.48,
      "start": 13295.88,
      "text": "就是雪山之父"
    },
    {
      "end": 13300.68,
      "start": 13298.48,
      "text": "這個穆斯塔格"
    },
    {
      "end": 13302.54,
      "start": 13300.68,
      "text": "新疆穆斯塔格風"
    },
    {
      "end": 13303.14,
      "start": 13302.54,
      "text": "就是"
    },
    {
      "end": 13304.04,
      "start": 13303.14,
      "text": "七千多米"
    },
    {
      "end": 13304.68,
      "start": 13304.04,
      "text": "對"
    },
    {
      "end": 13307.22,
      "start": 13304.68,
      "text": "七五四六"
    },
    {
      "end": 13308.12,
      "start": 13307.22,
      "text": "那登頂"
    },
    {
      "end": 13308.68,
      "start": 13308.12,
      "text": "是吧"
    },
    {
      "end": 13309.88,
      "start": 13308.68,
      "text": "不用吹牛逼"
    },
    {
      "end": 13310.92,
      "start": 13309.88,
      "text": "你腳沒有用"
    },
    {
      "end": 13311.16,
      "start": 13310.92,
      "text": "對吧"
    },
    {
      "end": 13311.96,
      "start": 13311.16,
      "text": "齊克"
    },
    {
      "end": 13314.0,
      "start": 13311.96,
      "text": "別求他們共產黨吹牛逼"
    },
    {
      "end": 13314.9,
      "start": 13314.0,
      "text": "他們在那什麼"
    },
    {
      "end": 13316.6,
      "start": 13314.9,
      "text": "一個肩膀不換肩"
    },
    {
      "end": 13318.5,
      "start": 13316.6,
      "text": "什麼胖子多少"
    },
    {
      "end": 13320.6,
      "start": 13318.5,
      "text": "他們吹牛逼在上場"
    },
    {
      "end": 13321.84,
      "start": 13320.6,
      "text": "跑兩步吹牛逼"
    },
    {
      "end": 13322.14,
      "start": 13321.84,
      "text": "對吧"
    },
    {
      "end": 13325.04,
      "start": 13322.14,
      "text": "你基本的常識邏輯得有"
    },
    {
      "end": 13326.68,
      "start": 13325.04,
      "text": "你不能說你可以的勁"
    },
    {
      "end": 13327.3,
      "start": 13326.68,
      "text": "可以的"
    },
    {
      "end": 13328.78,
      "start": 13327.3,
      "text": "你不能換肩嗎"
    },
    {
      "end": 13330.28,
      "start": 13328.78,
      "text": "這個人他們不行啊"
    },
    {
      "end": 13330.62,
      "start": 13330.28,
      "text": "對吧"
    },
    {
      "end": 13332.04,
      "start": 13330.62,
      "text": "你有點常識"
    },
    {
      "end": 13333.38,
      "start": 13332.04,
      "text": "對吧"
    },
    {
      "end": 13335.38,
      "start": 13333.38,
      "text": "他們連歌都"
    },
    {
      "end": 13336.26,
      "start": 13335.38,
      "text": "對吧"
    },
    {
      "end": 13337.28,
      "start": 13336.26,
      "text": "嚴峰是你想"
    },
    {
      "end": 13339.28,
      "start": 13337.28,
      "text": "穢學常識他們都不懂"
    },
    {
      "end": 13340.46,
      "start": 13339.28,
      "text": "對吧"
    },
    {
      "end": 13342.22,
      "start": 13340.46,
      "text": "所以他們真的贏不了"
    },
    {
      "end": 13342.82,
      "start": 13342.22,
      "text": "對"
    },
    {
      "end": 13346.22,
      "start": 13342.82,
      "text": "就像路德剛才說的"
    },
    {
      "end": 13347.06,
      "start": 13346.22,
      "text": "這個體育"
    },
    {
      "end": 13348.7,
      "start": 13347.06,
      "text": "其實中美建交"
    },
    {
      "end": 13351.26,
      "start": 13348.7,
      "text": "它很重要的就是乒乓外交"
    },
    {
      "end": 13352.94,
      "start": 13351.26,
      "text": "就是從體育"
    },
    {
      "end": 13355.1,
      "start": 13352.94,
      "text": "來和國際上的"
    },
    {
      "end": 13357.3,
      "start": 13355.1,
      "text": "這個有一些勾兌"
    },
    {
      "end": 13357.84,
      "start": 13357.3,
      "text": "開始"
    },
    {
      "end": 13360.58,
      "start": 13357.84,
      "text": "他就開始搞這套東西了"
    },
    {
      "end": 13362.88,
      "start": 13360.58,
      "text": "所以我們的出來"
    },
    {
      "end": 13365.02,
      "start": 13362.88,
      "text": "也是用他認為的"
    },
    {
      "end": 13366.28,
      "start": 13365.02,
      "text": "最好在國際上的"
    },
    {
      "end": 13368.18,
      "start": 13366.28,
      "text": "這個跟人勾兌的"
    },
    {
      "end": 13371.02,
      "start": 13368.18,
      "text": "這個我們用這個來打他"
    },
    {
      "end": 13372.12,
      "start": 13371.02,
      "text": "就是"
    },
    {
      "end": 13373.32,
      "start": 13372.12,
      "text": "我們的乒乓球"
    },
    {
      "end": 13375.16,
      "start": 13373.32,
      "text": "一個省的臺子"
    },
    {
      "end": 13376.66,
      "start": 13375.16,
      "text": "運動員比人家"
    },
    {
      "end": 13378.46,
      "start": 13376.66,
      "text": "這個全世界多"
    },
    {
      "end": 13378.76,
      "start": 13378.46,
      "text": "是吧"
    },
    {
      "end": 13381.14,
      "start": 13378.76,
      "text": "你用專業打人家的業餘"
    },
    {
      "end": 13383.96,
      "start": 13381.14,
      "text": "玩了互相之間的讓球"
    },
    {
      "end": 13386.24,
      "start": 13383.96,
      "text": "之間的這種最骯髒的"
    },
    {
      "end": 13387.48,
      "start": 13386.24,
      "text": "他們的睡覺"
    },
    {
      "end": 13389.98,
      "start": 13387.48,
      "text": "這些國家體育總局"
    },
    {
      "end": 13391.5,
      "start": 13389.98,
      "text": "旁邊有一個夜總會"
    },
    {
      "end": 13393.64,
      "start": 13391.5,
      "text": "當時他都在崇文區"
    },
    {
      "end": 13394.4,
      "start": 13393.64,
      "text": "問一問"
    },
    {
      "end": 13395.4,
      "start": 13394.4,
      "text": "劉國良"
    },
    {
      "end": 13396.34,
      "start": 13395.4,
      "text": "蔡振華"
    },
    {
      "end": 13398.8,
      "start": 13396.34,
      "text": "這幫孫子天天去"
    },
    {
      "end": 13399.84,
      "start": 13398.8,
      "text": "就在崇文區"
    },
    {
      "end": 13400.74,
      "start": 13399.84,
      "text": "合併之前"
    },
    {
      "end": 13401.84,
      "start": 13400.74,
      "text": "他叫崇文區"
    },
    {
      "end": 13403.44,
      "start": 13401.84,
      "text": "現在可能都歸了東城"
    },
    {
      "end": 13404.54,
      "start": 13403.44,
      "text": "還是東城一半"
    },
    {
      "end": 13405.84,
      "start": 13404.54,
      "text": "西城一半"
    },
    {
      "end": 13406.72,
      "start": 13405.84,
      "text": "是崇文區"
    },
    {
      "end": 13408.08,
      "start": 13406.72,
      "text": "離著訓練局"
    },
    {
      "end": 13409.22,
      "start": 13408.08,
      "text": "比較近的一個夜總會"
    },
    {
      "end": 13410.06,
      "start": 13409.22,
      "text": "你去問一問"
    },
    {
      "end": 13410.88,
      "start": 13410.06,
      "text": "這幫孫子"
    },
    {
      "end": 13412.96,
      "start": 13410.88,
      "text": "都是最骯髒的東西"
    },
    {
      "end": 13414.56,
      "start": 13412.96,
      "text": "互相之間的給錢"
    },
    {
      "end": 13415.26,
      "start": 13414.56,
      "text": "給教練錢"
    },
    {
      "end": 13416.16,
      "start": 13415.26,
      "text": "都打到比賽"
    },
    {
      "end": 13417.26,
      "start": 13416.16,
      "text": "互相賠稅"
    },
    {
      "end": 13419.32,
      "start": 13417.26,
      "text": "互相之間的親壓"
    },
    {
      "end": 13421.46,
      "start": 13419.32,
      "text": "完了以後他們在世界上"
    },
    {
      "end": 13422.46,
      "start": 13421.46,
      "text": "拿個金牌"
    },
    {
      "end": 13424.96,
      "start": 13422.46,
      "text": "為什麼別人不做這個東西"
    },
    {
      "end": 13426.9,
      "start": 13424.96,
      "text": "別人沒有職業化"
    },
    {
      "end": 13428.7,
      "start": 13426.9,
      "text": "他來愚弄老百姓"
    },
    {
      "end": 13431.4,
      "start": 13428.7,
      "text": "所以這些我們一定要"
    },
    {
      "end": 13433.3,
      "start": 13431.4,
      "text": "講給我們中國老百姓聽"
    },
    {
      "end": 13435.7,
      "start": 13433.3,
      "text": "讓他們更加的認清楚"
    },
    {
      "end": 13437.68,
      "start": 13435.7,
      "text": "什麼才是真正的人生"
    },
    {
      "end": 13438.3,
      "start": 13437.68,
      "text": "跟生活"
    },
    {
      "end": 13439.84,
      "start": 13438.3,
      "text": "要有點邏輯"
    },
    {
      "end": 13440.78,
      "start": 13439.84,
      "text": "就像"
    },
    {
      "end": 13441.88,
      "start": 13440.78,
      "text": "閻利夢博士"
    },
    {
      "end": 13443.58,
      "start": 13441.88,
      "text": "他在香港、港大"
    },
    {
      "end": 13445.88,
      "start": 13443.58,
      "text": "最後雙博士、雙學位"
    },
    {
      "end": 13446.84,
      "start": 13445.88,
      "text": "也類似這樣"
    },
    {
      "end": 13449.08,
      "start": 13446.84,
      "text": "但是他要在中共國內的話"
    },
    {
      "end": 13450.82,
      "start": 13449.08,
      "text": "他被潛規則死了"
    },
    {
      "end": 13452.42,
      "start": 13450.82,
      "text": "可能最後很難"
    },
    {
      "end": 13454.72,
      "start": 13452.42,
      "text": "最後拿到一個權位"
    },
    {
      "end": 13455.42,
      "start": 13454.72,
      "text": "對吧"
    },
    {
      "end": 13456.8,
      "start": 13455.42,
      "text": "太多了這樣的"
    },
    {
      "end": 13457.42,
      "start": 13456.8,
      "text": "對吧"
    },
    {
      "end": 13458.22,
      "start": 13457.42,
      "text": "我的女兒"
    },
    {
      "end": 13458.62,
      "start": 13458.22,
      "text": "是吧"
    },
    {
      "end": 13461.0,
      "start": 13458.62,
      "text": "世界專業排名第一的"
    },
    {
      "end": 13461.82,
      "start": 13461.0,
      "text": "今年第一"
    },
    {
      "end": 13463.96,
      "start": 13461.82,
      "text": "兩萬多字的論文"
    },
    {
      "end": 13465.26,
      "start": 13463.96,
      "text": "導師一下就過"
    },
    {
      "end": 13465.64,
      "start": 13465.26,
      "text": "對吧"
    },
    {
      "end": 13466.64,
      "start": 13465.64,
      "text": "不需要賠稅"
    },
    {
      "end": 13467.6,
      "start": 13466.64,
      "text": "他在國外"
    },
    {
      "end": 13470.24,
      "start": 13467.6,
      "text": "在國內可能嗎"
    },
    {
      "end": 13471.48,
      "start": 13470.24,
      "text": "弄死你"
    },
    {
      "end": 13471.98,
      "start": 13471.48,
      "text": "是吧"
    },
    {
      "end": 13474.58,
      "start": 13471.98,
      "text": "這裡面就是中共最大的惡"
    },
    {
      "end": 13476.58,
      "start": 13474.58,
      "text": "他們以為我們不知道"
    },
