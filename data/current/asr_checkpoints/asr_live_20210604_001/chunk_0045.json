    {
      "end": 41249.3,
      "start": 41248.2,
      "text": "有一次我去吃饭"
    },
    {
      "end": 41250.92,
      "start": 41249.3,
      "text": "然后有一个人过来跟我说"
    },
    {
      "end": 41252.66,
      "start": 41250.92,
      "text": "一切都是刚刚开始"
    },
    {
      "end": 41254.82,
      "start": 41252.66,
      "text": "然后有一次我的商场购物"
    },
    {
      "end": 41256.26,
      "start": 41254.82,
      "text": "我就碰到了金柜子家"
    },
    {
      "end": 41257.52,
      "start": 41256.26,
      "text": "有说你是卡卡吗"
    },
    {
      "end": 41259.02,
      "start": 41257.52,
      "text": "所以你突然发现"
    },
    {
      "end": 41262.24,
      "start": 41259.02,
      "text": "原来我们生活的这个奥克兰变得不一样了"
