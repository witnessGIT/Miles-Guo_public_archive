    {
      "end": 41185.16,
      "start": 41183.04,
      "text": "所以当时我能清楚的记得"
    },
    {
      "end": 41187.18,
      "start": 41185.16,
      "text": "当时我来的路上还是非常忐忑的"
    },
    {
      "end": 41188.84,
      "start": 41187.18,
      "text": "因为毕竟人生的第一次嘛"
