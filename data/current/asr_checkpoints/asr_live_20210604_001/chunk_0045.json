{
  "chunk_audio_sha256": "a44e9a3696db617e992c3310099adbe2c76c0732c6c8eed0b570e13a0fe5416f",
  "chunk_index": 45,
  "completed_at": "2026-10-18T17:11:38Z",
  "language": "zh",
  "live_id": "LIVE_20210604_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 40500,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 40504.8,
      "start": 40500.0,
      "text": "然后这次领队的是我们新西兰空军最后一个战斗机飞行员"
    },
    {
      "end": 40507.04,
      "start": 40504.8,
      "text": "领队这个7架的Hava"
    },
    {
      "end": 40507.84,
      "start": 40507.04,
      "text": "然后飞上天"
    },
    {
      "end": 40510.94,
      "start": 40507.84,
      "text": "然后我觉得今天这个意义特别的特别的重大"
    },
    {
      "end": 40511.84,
      "start": 40510.94,
      "text": "而且特别的好"
    },
    {
      "end": 40512.44,
      "start": 40511.84,
      "text": "为什么呢"
    },
    {
      "end": 40516.8,
      "start": 40512.44,
      "text": "因为当初我们像中国人在辛亥革命以后"
    },
    {
      "end": 40519.76,
      "start": 40516.8,
      "text": "其实一直都是西方的重要的一个盟友"
    },
    {
      "end": 40521.96,
      "start": 40519.76,
      "text": "在一战二战我们都是战胜国"
    },
    {
      "end": 40523.88,
      "start": 40521.96,
      "text": "而且我们都是打得非常的漂亮"
    },
    {
      "end": 40524.86,
      "start": 40523.88,
      "text": "虽然有点凄惨"
    },
    {
      "end": 40526.1,
      "start": 40524.86,
      "text": "但是因为国力不行"
    },
    {
      "end": 40530.04,
      "start": 40526.1,
      "text": "所以当时有很多的西方的这些的技术跟军事力"
    },
    {
      "end": 40531.2,
      "start": 40530.04,
      "text": "我们看到我们"
    },
    {
      "end": 40536.84,
      "start": 40531.2,
      "text": "但今天我们看到在新中国联邦在打的一场是也是新型的战争"
    },
    {
      "end": 40539.48,
      "start": 40536.84,
      "text": "到这里我想介绍一下我的名字"
    },
    {
      "end": 40540.56,
      "start": 40539.48,
      "text": "我叫Tex Hill"
    },
    {
      "end": 40543.42,
      "start": 40540.56,
      "text": "然后有一次我又觉得我想看一看"
    },
    {
      "end": 40546.78,
      "start": 40543.42,
      "text": "在Google上面看一看到底叫Tex Hill的人都长什么样子"
    },
    {
      "end": 40548.7,
      "start": 40546.78,
      "text": "因为有时候有些名字你打上去"
    },
    {
      "end": 40551.56,
      "start": 40548.7,
      "text": "第一页出来的时候会觉得你想要换名字"
    },
    {
      "end": 40553.46,
      "start": 40551.56,
      "text": "但我打完Tex Hill上去"
    },
    {
      "end": 40554.66,
      "start": 40553.46,
      "text": "我Google出来以后"
    },
    {
      "end": 40556.4,
      "start": 40554.66,
      "text": "第一页把我震撼了"
    },
    {
      "end": 40557.6,
      "start": 40556.4,
      "text": "因为都是一个人"
    },
    {
      "end": 40558.6,
      "start": 40557.6,
      "text": "他就叫Tex Hill"
    },
    {
      "end": 40565.4,
      "start": 40558.6,
      "text": "然后他是当时美国空军援助中国战场的著名的飞"
    },
    {
      "end": 40569.9,
      "start": 40565.4,
      "text": "飞行中队叫飞虎队里面的Ace王牌的飞行员"
    },
    {
      "end": 40572.42,
      "start": 40569.9,
      "text": "他打下过非常多的日本的飞机"
    },
    {
      "end": 40575.92,
      "start": 40572.42,
      "text": "战功非常的卓越卓越是美国的英雄"
    },
    {
      "end": 40577.62,
      "start": 40575.92,
      "text": "他也是中国的英雄"
    },
    {
      "end": 40583.42,
      "start": 40577.62,
      "text": "今天我这样子一个穿越到21世纪的Tex Hill坐在这样子一个飞机上面"
    },
    {
      "end": 40585.16,
      "start": 40583.42,
      "text": "我感觉哇特别兴奋"
    },
    {
      "end": 40587.36,
      "start": 40585.16,
      "text": "也看到其实在当时的时候"
    },
    {
      "end": 40594.16,
      "start": 40587.36,
      "text": "是美国人帮帮助我们来打这样子一个当时是非常新型的一个战争叫空战"
    },
    {
      "end": 40600.1,
      "start": 40594.16,
      "text": "那今天我们是去帮美国跟西方打一个更新型的战争叫超限战"
    },
    {
      "end": 40601.0,
      "start": 40600.1,
      "text": "信息战"
    },
    {
      "end": 40609.9,
      "start": 40601.0,
      "text": "在这个方面我们看到新中国联邦是绝对是支援西方的帮助他帮助他们能够胜过共产党的这样子一个重要重要的力量"
    },
    {
      "end": 40611.64,
      "start": 40609.9,
      "text": "所以今天在这个上面非常的激动"
    },
    {
      "end": 40613.64,
      "start": 40611.64,
      "text": "我不知道等一下感觉会怎么样"
    },
    {
      "end": 40617.38,
      "start": 40613.64,
      "text": "但是啊到快快到的时候我再我再回来给大家播报吧"
    },
    {
      "end": 40618.58,
      "start": 40617.38,
      "text": "好不好谢谢"
    },
    {
      "end": 40620.72,
      "start": 40618.58,
      "text": "OK谢谢Tex"
    },
    {
      "end": 40624.22,
      "start": 40620.72,
      "text": "果然很不一样的惊喜啊"
    },
    {
      "end": 40627.72,
      "start": 40624.22,
      "text": "Tex刚才这一段解说的真是非常的好"
    },
    {
      "end": 40630.22,
      "start": 40627.72,
      "text": "不过我的注意力完全被他的胡子吸引了"
    },
    {
      "end": 40632.16,
      "start": 40630.22,
      "text": "他为什么连胡子也不刮一下呢"
    },
    {
      "end": 40633.26,
      "start": 40632.16,
      "text": "因为太激动了"
    },
    {
      "end": 40634.92,
      "start": 40633.26,
      "text": "而且最近Tex真的是很忙的"
    },
    {
      "end": 40636.96,
      "start": 40634.92,
      "text": "我们有没有稍微养眼一点的可以看"
    },
    {
      "end": 40638.4,
      "start": 40636.96,
      "text": "哎我要插一句啊"
    },
    {
      "end": 40639.52,
      "start": 40638.4,
      "text": "你被胡子吸引了"
    },
    {
      "end": 40640.7,
      "start": 40639.52,
      "text": "其实我是个帽子控"
    },
    {
      "end": 40642.4,
      "start": 40640.7,
      "text": "我被他的帽子给吸引了"
    },
    {
      "end": 40644.44,
      "start": 40642.4,
      "text": "他那里帽子还是很漂亮的"
    },
    {
      "end": 40644.78,
      "start": 40644.44,
      "text": "对"
    },
    {
      "end": 40646.52,
      "start": 40644.78,
      "text": "说到养眼啊"
    },
    {
      "end": 40648.98,
      "start": 40646.52,
      "text": "我们的另外一位战友糖果战友"
    },
    {
      "end": 40651.78,
      "start": 40648.98,
      "text": "也给我们准备了一份小小的惊喜哦"
    },
    {
      "end": 40652.08,
      "start": 40651.78,
      "text": "是的"
    },
    {
      "end": 40652.58,
      "start": 40652.08,
      "text": "对"
    },
    {
      "end": 40654.82,
      "start": 40652.58,
      "text": "好像他在一个很漂亮的地方"
    },
    {
      "end": 40657.06,
      "start": 40654.82,
      "text": "一个很特殊的仪式"
    },
    {
      "end": 40660.66,
      "start": 40657.06,
      "text": "所以有请导播帮我们转到糖果那边好不好"
    },
    {
      "end": 40677.88,
      "start": 40674.78,
      "text": "好非常感谢我们的卡卡"
    },
    {
      "end": 40679.62,
      "start": 40677.88,
      "text": "亲爱的战友们大家好"
    },
    {
      "end": 40680.66,
      "start": 40679.62,
      "text": "我是糖果"
    },
    {
      "end": 40684.68,
      "start": 40680.66,
      "text": "我们现在呢正处在奥克兰郊外一处风景"
    },
    {
      "end": 40686.26,
      "start": 40684.68,
      "text": "非常优美的地方"
    },
    {
      "end": 40687.62,
      "start": 40686.26,
      "text": "那么今天呢"
    },
    {
      "end": 40690.26,
      "start": 40687.62,
      "text": "我们来到这边是有一个特别的任务"
    },
    {
      "end": 40692.36,
      "start": 40690.26,
      "text": "一份特别的礼物送给大家"
    },
    {
      "end": 40695.46,
      "start": 40692.36,
      "text": "2020年的6月4日"
    },
    {
      "end": 40698.64,
      "start": 40695.46,
      "text": "是我们新中国联邦成立的日子"
    },
    {
      "end": 40700.34,
      "start": 40698.64,
      "text": "那么到今天为止呢"
    },
    {
      "end": 40701.9,
      "start": 40700.34,
      "text": "刚刚好一周年"
    },
    {
      "end": 40704.86,
      "start": 40701.9,
      "text": "那今天也是我们的周年大庆"
    },
    {
      "end": 40707.26,
      "start": 40704.86,
      "text": "在过去的一年里呢"
    },
    {
      "end": 40710.16,
      "start": 40707.26,
      "text": "我们经历了非常多的困难和险阻"
    },
    {
      "end": 40714.32,
      "start": 40710.16,
      "text": "但我们同时也取得了非常优异的成绩"
    },
    {
      "end": 40717.18,
      "start": 40714.32,
      "text": "在今天这个特殊的日子里"
    },
    {
      "end": 40722.1,
      "start": 40717.18,
      "text": "新西兰团队将为大家奉献一份特殊的升旗仪式"
    },
    {
      "end": 40725.94,
      "start": 40722.1,
      "text": "作为新中国联邦的大庆典礼的礼物"
    },
    {
      "end": 40726.56,
      "start": 40725.94,
      "text": "对"
    },
    {
      "end": 40730.36,
      "start": 40726.56,
      "text": "大家请看我身后的这个火箭"
    },
    {
      "end": 40732.4,
      "start": 40730.36,
      "text": "看到了吗"
    },
    {
      "end": 40732.84,
      "start": 40732.4,
      "text": "对"
    },
    {
      "end": 40734.4,
      "start": 40732.84,
      "text": "这个火箭呢"
    },
    {
      "end": 40737.06,
      "start": 40734.4,
      "text": "上面承载着我们新中国联邦的国旗"
    },
    {
      "end": 40738.78,
      "start": 40737.06,
      "text": "和我们的信仰之星"
    },
    {
      "end": 40739.64,
      "start": 40738.78,
      "text": "期盲星"
    },
    {
      "end": 40740.94,
      "start": 40739.64,
      "text": "待会儿呢"
    },
    {
      "end": 40745.36,
      "start": 40740.94,
      "text": "我们的工作人员就会把他们一起发向我们奥克兰的高空"
    },
    {
      "end": 40747.44,
      "start": 40745.36,
      "text": "那向我们所有的奥克兰人"
    },
    {
      "end": 40752.3,
      "start": 40747.44,
      "text": "新西兰人甚至世界人民去展现我们新中国联邦的风采"
    },
    {
      "end": 40754.64,
      "start": 40752.3,
      "text": "他同时呢"
    },
    {
      "end": 40758.74,
      "start": 40754.64,
      "text": "也寓意着我们新中国联邦及我们新中国联邦人"
    },
    {
      "end": 40763.02,
      "start": 40758.74,
      "text": "会在未来一飞冲天前途无限"
    },
    {
      "end": 40763.96,
      "start": 40763.02,
      "text": "谢谢"
    },
    {
      "end": 40765.54,
      "start": 40763.96,
      "text": "那现在呢"
    },
    {
      "end": 40769.66,
      "start": 40765.54,
      "text": "我们因为我们的工作人员还需要一些前期的准备"
    },
    {
      "end": 40771.92,
      "start": 40769.66,
      "text": "然后我们稍后再把镜头切换回来"
    },
    {
      "end": 40775.16,
      "start": 40771.92,
      "text": "现在我们先把时间交还给我们的主播卡卡"
    },
    {
      "end": 40775.54,
      "start": 40775.16,
      "text": "谢谢"
    },
    {
      "end": 40777.06,
      "start": 40775.54,
      "text": "好"
    },
    {
      "end": 40778.06,
      "start": 40777.06,
      "text": "好谢谢糖果"
    },
    {
      "end": 40779.2,
      "start": 40778.06,
      "text": "那新西兰呢"
    },
    {
      "end": 40781.46,
      "start": 40779.2,
      "text": "真的是风景如画的地方"
    },
    {
      "end": 40783.16,
      "start": 40781.46,
      "text": "那我们所有的战友呢"
    },
    {
      "end": 40786.4,
      "start": 40783.16,
      "text": "可以透过我们背后的这个窗户可以看到啊"
    },
    {
      "end": 40789.6,
      "start": 40786.4,
      "text": "我们背后是有非常非常漂亮的风景的"
    },
    {
      "end": 40791.52,
      "start": 40789.6,
      "text": "然后这里是我们的海港"
    },
    {
      "end": 40792.54,
      "start": 40791.52,
      "text": "奥克兰的海港"
    },
    {
      "end": 40794.42,
      "start": 40792.54,
      "text": "那前一段时间在这个地方呢"
    },
    {
      "end": 40797.34,
      "start": 40794.42,
      "text": "举行了第36届美洲杯翻船比赛"
    },
    {
      "end": 40798.84,
      "start": 40797.34,
      "text": "那我当时是在现场的"
    },
    {
      "end": 40799.98,
      "start": 40798.84,
      "text": "就是决赛的那一天"
    },
    {
      "end": 40800.84,
      "start": 40799.98,
      "text": "然后呢"
    },
    {
      "end": 40802.54,
      "start": 40800.84,
      "text": "对面的那个桥是可以打开"
    },
    {
      "end": 40804.52,
      "start": 40802.54,
      "text": "然后许多船只从这里进来"
    },
    {
      "end": 40805.28,
      "start": 40804.52,
      "text": "然后出港"
    },
    {
      "end": 40810.94,
      "start": 40805.28,
      "text": "然后我们也是在这个地方迎接我们获得冠军的新西兰队从这里进来的"
    },
    {
      "end": 40811.42,
      "start": 40810.94,
      "text": "对"
    },
    {
      "end": 40811.98,
      "start": 40811.42,
      "text": "所以呢"
    },
    {
      "end": 40814.06,
      "start": 40811.98,
      "text": "这个地方是非常非常漂亮的"
    },
    {
      "end": 40814.38,
      "start": 40814.06,
      "text": "对"
    },
    {
      "end": 40815.06,
      "start": 40814.38,
      "text": "未来呢"
    },
    {
      "end": 40819.26,
      "start": 40815.06,
      "text": "我们的愿望就是我们新西兰农场占我们的船能停满这个哈勃"
    },
    {
      "end": 40820.72,
      "start": 40819.26,
      "text": "然后然后对"
    },
    {
      "end": 40822.62,
      "start": 40820.72,
      "text": "然后我们老板长的船停在这"
    },
    {
      "end": 40823.72,
      "start": 40822.62,
      "text": "孙风呢停在这"
    },
    {
      "end": 40824.82,
      "start": 40823.72,
      "text": "我的就不停了"
    },
    {
      "end": 40826.1,
      "start": 40824.82,
      "text": "我的可能讲话丢了"
    },
    {
      "end": 40829.18,
      "start": 40826.1,
      "text": "你到时候还买带奖的船是吗"
    },
    {
      "end": 40829.5,
      "start": 40829.18,
      "text": "知道"
    },
    {
      "end": 40830.74,
      "start": 40829.5,
      "text": "对"
    },
    {
      "end": 40831.64,
      "start": 40830.74,
      "text": "好吧好吧"
    },
    {
      "end": 40833.56,
      "start": 40831.64,
      "text": "希望我们所有战友啊"
    },
    {
      "end": 40834.62,
      "start": 40833.56,
      "text": "梦想成真啊"
    },
    {
      "end": 40836.14,
      "start": 40834.62,
      "text": "托你这句话的福啊"
    },
    {
      "end": 40837.72,
      "start": 40836.14,
      "text": "我也买一辆放在那里"
    },
    {
      "end": 40838.02,
      "start": 40837.72,
      "text": "好的"
    },
    {
      "end": 40840.0,
      "start": 40838.02,
      "text": "我一定要买一个不带奖的船啊"
    },
    {
      "end": 40841.26,
      "start": 40840.0,
      "text": "对对对"
    },
    {
      "end": 40845.36,
      "start": 40841.26,
      "text": "那今天呢是我们新中国联邦的一岁生日"
    },
    {
      "end": 40850.92,
      "start": 40845.36,
      "text": "那其实在去年的5月21号也是我们伊甸农场成立的日子"
    },
    {
      "end": 40851.64,
      "start": 40850.92,
      "text": "我所以呢"
    },
    {
      "end": 40853.64,
      "start": 40851.64,
      "text": "我们新中国联邦是一岁"
    },
    {
      "end": 40855.26,
      "start": 40853.64,
      "text": "我们的农场也是一岁"
    },
    {
      "end": 40857.26,
      "start": 40855.26,
      "text": "别小看我们是一岁哦"
    },
    {
      "end": 40860.0,
      "start": 40857.26,
      "text": "其实我们做了许多的事情了"
    },
    {
      "end": 40862.38,
      "start": 40860.0,
      "text": "我们取得了许多许多的成绩的"
    },
    {
      "end": 40863.32,
      "start": 40862.38,
      "text": "对对"
    },
    {
      "end": 40865.52,
      "start": 40863.32,
      "text": "就像去年一年我也跟随着成长"
    },
    {
      "end": 40866.7,
      "start": 40865.52,
      "text": "也很多"
    },
    {
      "end": 40870.32,
      "start": 40866.7,
      "text": "包括我们通过去年一年各种全球的大事件"
    },
    {
      "end": 40872.72,
      "start": 40870.32,
      "text": "我们的心情其实呢也是起起伏伏"
    },
    {
      "end": 40874.84,
      "start": 40872.72,
      "text": "然后经历过一些挫折啊"
    },
    {
      "end": 40876.48,
      "start": 40874.84,
      "text": "也经历过很多有希望的事情"
    },
    {
      "end": 40878.68,
      "start": 40876.48,
      "text": "所以我们的成长也是非常的快的"
    },
    {
      "end": 40880.62,
      "start": 40878.68,
      "text": "我相信每个战友都是一样的"
    },
    {
      "end": 40881.84,
      "start": 40880.62,
      "text": "经历过不同的"
    },
    {
      "end": 40883.64,
      "start": 40881.84,
      "text": "我们过去的一年经历的事情"
    },
    {
      "end": 40885.9,
      "start": 40883.64,
      "text": "真的是我们一辈子都很难经历到的"
    },
    {
      "end": 40888.04,
      "start": 40885.9,
      "text": "是一个非常浓缩的一个精华的过程"
    },
    {
      "end": 40890.56,
      "start": 40888.04,
      "text": "所以我希望我们能够很享受这个过程"
    },
    {
      "end": 40891.18,
      "start": 40890.56,
      "text": "对"
    },
    {
      "end": 40893.92,
      "start": 40891.18,
      "text": "我们就等于是重新发现了我们自己"
    },
    {
      "end": 40896.0,
      "start": 40893.92,
      "text": "而且解锁了许多新的技能"
    },
    {
      "end": 40899.54,
      "start": 40896.0,
      "text": "那在我们农场有一位战友叫大麦的老婆"
    },
    {
      "end": 40902.9,
      "start": 40899.54,
      "text": "他一直有帮农场在做农场大事迹"
    },
    {
      "end": 40906.5,
      "start": 40902.9,
      "text": "那我们现在呢就通过视频来看一下"
    },
    {
      "end": 40910.56,
      "start": 40906.5,
      "text": "我们伊甸农场这一年的成长经历"
    },
    {
      "end": 40910.94,
      "start": 40910.56,
      "text": "好不好"
    },
    {
      "end": 40911.5,
