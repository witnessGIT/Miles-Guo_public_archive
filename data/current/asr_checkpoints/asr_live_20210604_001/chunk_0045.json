    },
    {
      "end": 40952.18,
      "start": 40950.98,
      "text": "这就可以看出来"
    },
    {
      "end": 40953.72,
      "start": 40952.18,
      "text": "谁是过界老鼠"
    },
    {
      "end": 40957.04,
      "start": 40953.72,
