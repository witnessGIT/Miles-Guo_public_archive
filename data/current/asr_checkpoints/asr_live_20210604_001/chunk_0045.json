    {
      "end": 40937.88,
      "start": 40935.38,
      "text": "生存于虚幻的正义之战"
    },
    {
      "end": 40940.04,
      "start": 40937.88,
      "text": "我们是一个人"
    },
    {
      "end": 40941.04,
      "start": 40940.04,
      "text": "我们爱你"
    },
    {
      "end": 40943.04,
