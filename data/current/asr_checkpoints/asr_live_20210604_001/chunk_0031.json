{
  "chunk_audio_sha256": "b958a96d1a1c680b5b907fdceeb63e963239ab8b988b974b0683d0eedefade38",
  "chunk_index": 31,
  "completed_at": "2026-10-18T16:16:10Z",
  "language": "zh",
  "live_id": "LIVE_20210604_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 27900,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 27902.94,
      "start": 27900.0,
      "text": "後來威廉王說這好啊,"
    },
    {
      "end": 27904.6,
      "start": 27902.94,
      "text": "你倆給我解釋我覺得是對的。"
    },
    {
      "end": 27907.04,
      "start": 27904.6,
      "text": "我深深地思考過它帶來的意義,"
    },
    {
      "end": 27908.32,
      "start": 27907.04,
      "text": "因為它爆料革命嘛,"
    },
    {
      "end": 27910.68,
      "start": 27908.32,
      "text": "新中國聯盟都考慮到國際、政治、"
    },
    {
      "end": 27913.02,
      "start": 27910.68,
      "text": "國內的各種影響的問題,"
    },
    {
      "end": 27914.82,
      "start": 27913.02,
      "text": "還有我們的立場的問題,"
    },
    {
      "end": 27916.18,
      "start": 27914.82,
      "text": "它不是那麼簡單。"
    },
    {
      "end": 27919.62,
      "start": 27916.18,
      "text": "所以最後我覺得這個歌真的是太太棒了。"
    },
    {
      "end": 27921.18,
      "start": 27919.62,
      "text": "還有一個我給大家爆料,"
    },
    {
      "end": 27922.96,
      "start": 27921.18,
      "text": "可能唐平妹妹知道,"
    },
    {
      "end": 27924.06,
      "start": 27922.96,
      "text": "這個威廉王,"
    },
    {
      "end": 27926.86,
      "start": 27924.06,
      "text": "我是跟你嫂子結婚這馬上36年了,"
    },
    {
      "end": 27929.76,
      "start": 27926.86,
      "text": "她從來沒參加過我的一次拍的,"
    },
    {
      "end": 27933.2,
      "start": 27929.76,
      "text": "她沒有跟著我出去參加過一次聚會,"
    },
    {
      "end": 27935.76,
      "start": 27933.2,
      "text": "我的公司的機會她沒去過。"
    },
    {
      "end": 27937.7,
      "start": 27935.76,
      "text": "那麼這是第一次,"
    },
    {
      "end": 27940.14,
      "start": 27937.7,
      "text": "就是錄MV哥的時候當天晚上,"
    },
    {
      "end": 27943.0,
      "start": 27940.14,
      "text": "我說明天我希望你能去跟我去錄MV,"
    },
    {
      "end": 27944.04,
      "start": 27943.0,
      "text": "你嫂子下外了,"
    },
    {
      "end": 27945.44,
      "start": 27944.04,
      "text": "這對她來講,"
    },
    {
      "end": 27947.98,
      "start": 27945.44,
      "text": "三十幾年從來沒有參加,"
    },
    {
      "end": 27949.92,
      "start": 27947.98,
      "text": "這對她是個極為恐懼的事情,"
    },
    {
      "end": 27952.78,
      "start": 27949.92,
      "text": "真的是小白醋要放到原始大森林去了。"
    },
    {
      "end": 27954.82,
      "start": 27952.78,
      "text": "她說我為什麼要去啊?"
    },
    {
      "end": 27956.62,
      "start": 27954.82,
      "text": "我說我明天我們沒有幾個人,"
    },
    {
      "end": 27959.22,
      "start": 27956.62,
      "text": "這個都是,我都不認識你,"
    },
    {
      "end": 27960.86,
      "start": 27959.22,
      "text": "我們就兩三個人。"
    },
    {
      "end": 27963.02,
      "start": 27960.86,
      "text": "結果她說我不想去,"
    },
    {
      "end": 27964.1,
      "start": 27963.02,
      "text": "她非常痛苦的,"
    },
    {
      "end": 27965.0,
      "start": 27964.1,
      "text": "我說我需要你去,"
    },
    {
      "end": 27965.9,
      "start": 27965.0,
      "text": "我會唱得更好。"
    },
    {
      "end": 27967.6,
      "start": 27965.9,
      "text": "然後她就說,"
    },
    {
      "end": 27969.0,
      "start": 27967.6,
      "text": "哎那怎麼樣啊?"
    },
    {
      "end": 27970.44,
      "start": 27969.0,
      "text": "我說你就隨便嘛,"
    },
    {
      "end": 27971.46,
      "start": 27970.44,
      "text": "穿個衣服就跟我去,"
    },
    {
      "end": 27971.94,
      "start": 27971.46,
      "text": "戴個口罩,"
    },
    {
      "end": 27972.94,
      "start": 27971.94,
      "text": "認識你。"
    },
    {
      "end": 27974.24,
      "start": 27972.94,
      "text": "結果我們就去了,"
    },
    {
      "end": 27975.44,
      "start": 27974.24,
      "text": "到了現場以後,"
    },
    {
      "end": 27977.0,
      "start": 27975.44,
      "text": "因為那些跳舞的人知道啊,"
    },
    {
      "end": 27978.34,
      "start": 27977.0,
      "text": "都查過背景資料。"
    },
    {
      "end": 27979.88,
      "start": 27978.34,
      "text": "她說你真的結婚三十幾年,"
    },
    {
      "end": 27980.54,
      "start": 27979.88,
      "text": "沒換老婆?"
    },
    {
      "end": 27982.28,
      "start": 27980.54,
      "text": "中國的富豪每天都換老婆呀。"
    },
    {
      "end": 27983.18,
      "start": 27982.28,
      "text": "我說沒有。"
    },
    {
      "end": 27985.08,
      "start": 27983.18,
      "text": "結果第二天國待就聚了,"
    },
    {
      "end": 27986.12,
      "start": 27985.08,
      "text": "我就介紹給他們。"
    },
    {
      "end": 27988.06,
      "start": 27986.12,
      "text": "然後那些導演們啊,"
    },
    {
      "end": 27990.16,
      "start": 27988.06,
      "text": "MV人都過來跟國待打招呼。"
    },
    {
      "end": 27992.26,
      "start": 27990.16,
      "text": "然後那天我們的港妹也在,"
    },
    {
      "end": 27993.62,
      "start": 27992.26,
      "text": "港妹也在,"
    },
    {
      "end": 27994.82,
      "start": 27993.62,
      "text": "結果咱們一個戰友呢,"
    },
    {
      "end": 27996.1,
      "start": 27994.82,
      "text": "雞翻身的也來了。"
    },
    {
      "end": 27997.5,
      "start": 27996.1,
      "text": "她也出現在那裡了,"
    },
    {
      "end": 27999.4,
      "start": 27997.5,
      "text": "在那個RV車上,"
    },
    {
      "end": 28000.56,
      "start": 27999.4,
      "text": "你嫂吓了大跳。"
    },
    {
      "end": 28001.8,
      "start": 28000.56,
      "text": "我說她也來了,"
    },
    {
      "end": 28002.76,
      "start": 28001.8,
      "text": "我真是跟我們戰友,"
    },
    {
      "end": 28003.4,
      "start": 28002.76,
      "text": "結果呢,"
    },
    {
      "end": 28005.94,
      "start": 28003.4,
      "text": "你嫂子跟她聊得特別開心。"
    },
    {
      "end": 28007.78,
      "start": 28005.94,
      "text": "她從來也不看這個GTV,"
    },
    {
      "end": 28009.04,
      "start": 28007.78,
      "text": "說我說啥她也不看。"
    },
    {
      "end": 28011.58,
      "start": 28009.04,
      "text": "但是那天是我真的額外的一個禮物,"
    },
    {
      "end": 28012.94,
      "start": 28011.58,
      "text": "就是我讓你嫂子,"
    },
    {
      "end": 28016.32,
      "start": 28012.94,
      "text": "第一次走進了我們爆料革命的現場。"
    },
    {
      "end": 28018.92,
      "start": 28016.32,
      "text": "而且她在現場看到這歌詞,"
    },
    {
      "end": 28022.32,
      "start": 28018.92,
      "text": "而且從頭到尾看到完她很興奮。"
    },
    {
      "end": 28024.82,
      "start": 28022.32,
      "text": "當錄完MV的時候我在車上,"
    },
    {
      "end": 28026.22,
      "start": 28024.82,
      "text": "我就故意不吱聲,"
    },
    {
      "end": 28028.56,
      "start": 28026.22,
      "text": "然後她就主動的給我開始說,"
    },
    {
      "end": 28030.32,
      "start": 28028.56,
      "text": "她什麼感受,什麼感受。"
    },
    {
      "end": 28033.44,
      "start": 28030.32,
      "text": "她說在中國很少有人能這樣唱歌。"
    },
    {
      "end": 28035.76,
      "start": 28033.44,
      "text": "然後美國這種分工明確,"
    },
    {
      "end": 28036.94,
      "start": 28035.76,
      "text": "專業化,"
    },
    {
      "end": 28038.64,
      "start": 28036.94,
      "text": "而且這種敬業精神,"
    },
    {
      "end": 28040.9,
      "start": 28038.64,
      "text": "然後她就唐平妹妹,"
    },
    {
      "end": 28041.98,
      "start": 28040.9,
      "text": "她是很喜歡的,"
    },
    {
      "end": 28043.28,
      "start": 28041.98,
      "text": "就是唐平說了半天,"
    },
    {
      "end": 28044.14,
      "start": 28043.28,
      "text": "然後威廉王大,"
    },
    {
      "end": 28045.18,
      "start": 28044.14,
      "text": "我說我給她介紹。"
    },
    {
      "end": 28047.38,
      "start": 28045.18,
      "text": "然後我就一路上跟她說,"
    },
    {
      "end": 28048.42,
      "start": 28047.38,
      "text": "第一次,"
    },
    {
      "end": 28050.32,
      "start": 28048.42,
      "text": "這是她來到美國來,"
    },
    {
      "end": 28053.36,
      "start": 28050.32,
      "text": "我們倆第一次最長時間談爆料革命,"
    },
    {
      "end": 28055.32,
      "start": 28053.36,
      "text": "最長時間談戰友,"
    },
    {
      "end": 28056.96,
      "start": 28055.32,
      "text": "最長時間談,"
    },
    {
      "end": 28059.0,
      "start": 28056.96,
      "text": "我說為什麼要這樣做。"
    },
    {
      "end": 28060.46,
      "start": 28059.0,
      "text": "你嫂子一路直上,"
    },
    {
      "end": 28061.4,
      "start": 28060.46,
      "text": "抽了很多錢,"
    },
    {
      "end": 28062.36,
      "start": 28061.4,
      "text": "她很感觸。"
    },
    {
      "end": 28063.8,
      "start": 28062.36,
      "text": "就是對你嫂子來講,"
    },
    {
      "end": 28065.56,
      "start": 28063.8,
      "text": "這是個真的是一個小白兔,"
    },
    {
      "end": 28067.74,
      "start": 28065.56,
      "text": "直接放到原始森林去了。"
    },
    {
      "end": 28070.28,
      "start": 28067.74,
      "text": "那天的感受讓我知道是什麼呢?"
    },
    {
      "end": 28073.92,
      "start": 28070.28,
      "text": "你對家人不要太多的過分的苛刻和要求,"
    },
    {
      "end": 28076.18,
      "start": 28073.92,
      "text": "不是每個人都能像我們一樣的。"
    },
    {
      "end": 28078.12,
      "start": 28076.18,
      "text": "人類的這個社會當中,"
    },
    {
      "end": 28079.78,
      "start": 28078.12,
      "text": "永遠是5%的壞蛋,"
    },
    {
      "end": 28081.28,
      "start": 28079.78,
      "text": "5%的絕對精英。"
    },
    {
      "end": 28083.92,
      "start": 28081.28,
      "text": "這10%的人決定了90%人的命運。"
    },
    {
      "end": 28087.5,
      "start": 28083.92,
      "text": "從來不是90%人決定這些100%人的命運。"
    },
    {
      "end": 28089.12,
      "start": 28087.5,
      "text": "那麼這5%的混蛋,"
    },
    {
      "end": 28090.7,
      "start": 28089.12,
      "text": "不管什麼制度下它都存在,"
    },
    {
      "end": 28091.8,
      "start": 28090.7,
      "text": "就像美國這個夫妻,"
    },
    {
      "end": 28092.6,
      "start": 28091.8,
      "text": "不是也一樣嗎?"
    },
    {
      "end": 28094.56,
      "start": 28092.6,
      "text": "什麼社會也有很多壞蛋。"
    },
    {
      "end": 28095.94,
      "start": 28094.56,
      "text": "那麼在這種情況下,"
    },
    {
      "end": 28097.64,
      "start": 28095.94,
      "text": "我們大家一定要知道,"
    },
    {
      "end": 28100.24,
      "start": 28097.64,
      "text": "不是你說服別人你成功了。"
    },
    {
      "end": 28102.14,
      "start": 28100.24,
      "text": "是你做的比別人好,"
    },
    {
      "end": 28103.92,
      "start": 28102.14,
      "text": "讓別人自然而然的尊重你,"
    },
    {
      "end": 28104.58,
      "start": 28103.92,
      "text": "來跟隨你,"
    },
    {
      "end": 28105.92,
      "start": 28104.58,
      "text": "你成功了。"
    },
    {
      "end": 28107.14,
      "start": 28105.92,
      "text": "真正的有本事,"
    },
    {
      "end": 28107.94,
      "start": 28107.14,
      "text": "有能力的人,"
    },
    {
      "end": 28110.08,
      "start": 28107.94,
      "text": "不需要去說服別人。"
    },
    {
      "end": 28111.42,
      "start": 28110.08,
      "text": "你做給別人看,"
    },
    {
      "end": 28113.56,
      "start": 28111.42,
      "text": "就像剛才你說的唱歌一樣。"
    },
    {
      "end": 28115.92,
      "start": 28113.56,
      "text": "如果我在那塊有一次放棄,"
    },
    {
      "end": 28117.32,
      "start": 28115.92,
      "text": "你倆肯定就不會再做下去了。"
    },
    {
      "end": 28118.82,
      "start": 28117.32,
      "text": "因為你覺得七個累了,"
    },
    {
      "end": 28119.76,
      "start": 28118.82,
      "text": "有情緒了,"
    },
    {
      "end": 28121.0,
      "start": 28119.76,
      "text": "我是不可能的。"
    },
    {
      "end": 28122.4,
      "start": 28121.0,
      "text": "因為你倆才做的事情,"
    },
    {
      "end": 28123.22,
      "start": 28122.4,
      "text": "不是跟你倆做的,"
    },
    {
      "end": 28124.6,
      "start": 28123.22,
      "text": "一分錢沒拿,"
    },
    {
      "end": 28126.26,
      "start": 28124.6,
      "text": "一口水沒喝著。"
    },
    {
      "end": 28126.66,
      "start": 28126.26,
      "text": "是不是?"
    },
    {
      "end": 28128.04,
      "start": 28126.66,
      "text": "你倆在這塊兒洗。"
    },
    {
      "end": 28131.3,
      "start": 28128.04,
      "text": "那這是為什麼一分錢不分立,"
    },
    {
      "end": 28132.4,
      "start": 28131.3,
      "text": "不圖明,"
    },
    {
      "end": 28132.84,
      "start": 28132.4,
      "text": "是不是?"
    },
    {
      "end": 28134.6,
      "start": 28132.84,
      "text": "還受那麼多挑戰和威脅,"
    },
    {
      "end": 28136.74,
      "start": 28134.6,
      "text": "還把船給你放水箱淹死你們,"
    },
    {
      "end": 28138.3,
      "start": 28136.74,
      "text": "還給家裡放火。"
    },
    {
      "end": 28139.34,
      "start": 28138.3,
      "text": "這不是為了別人嗎?"
    },
    {
      "end": 28141.92,
      "start": 28139.34,
      "text": "我有什麼資格去放棄呢?"
    },
    {
      "end": 28143.58,
      "start": 28141.92,
      "text": "你真的明白這一點的時候,"
    },
    {
      "end": 28145.28,
      "start": 28143.58,
      "text": "你不會放棄的。"
    },
    {
      "end": 28146.72,
      "start": 28145.28,
      "text": "所以當我唱的時候,"
    },
    {
      "end": 28147.88,
      "start": 28146.72,
      "text": "不管唱多少小時,"
    },
    {
      "end": 28148.96,
      "start": 28147.88,
      "text": "你嫂子那天說,"
    },
    {
      "end": 28151.06,
      "start": 28148.96,
      "text": "哎呦,中間吃冰棍,"
    },
    {
      "end": 28152.48,
      "start": 28151.06,
      "text": "過送冰棍你倆記得吧,"
    },
    {
      "end": 28153.62,
      "start": 28152.48,
      "text": "去吃冰棍。"
    },
    {
      "end": 28154.36,
      "start": 28153.62,
      "text": "然後你嫂子說,"
    },
    {
      "end": 28155.56,
      "start": 28154.36,
      "text": "哎呀,你這嗓子都快啞了。"
    },
    {
      "end": 28156.2,
      "start": 28155.56,
      "text": "我說沒事,"
    },
    {
      "end": 28157.26,
      "start": 28156.2,
      "text": "我一定能堅持下去,"
    },
    {
      "end": 28158.96,
      "start": 28157.26,
      "text": "而且唱得都非常好。"
    },
    {
      "end": 28160.76,
      "start": 28158.96,
      "text": "所以說每次唱完以後,"
    },
    {
      "end": 28162.96,
      "start": 28160.76,
      "text": "我不是誇你倆,"
    },
    {
      "end": 28164.24,
      "start": 28162.96,
      "text": "我最感動的是你倆,"
    },
    {
      "end": 28165.44,
      "start": 28164.24,
      "text": "我說最多的是,"
    },
    {
      "end": 28167.3,
      "start": 28165.44,
      "text": "我跟你嫂子跟旁邊說,"
    },
    {
      "end": 28169.74,
      "start": 28167.3,
      "text": "中國的精英太多了。"
    },
    {
      "end": 28170.8,
      "start": 28169.74,
      "text": "像唐平,"
    },
    {
      "end": 28171.54,
      "start": 28170.8,
      "text": "像威廉王,"
    },
    {
      "end": 28172.34,
      "start": 28171.54,
      "text": "像我們背後,"
    },
    {
      "end": 28173.3,
      "start": 28172.34,
      "text": "像Q妹,"
    },
    {
      "end": 28174.58,
      "start": 28173.3,
      "text": "還有Q妹的先生,"
    },
    {
      "end": 28175.38,
      "start": 28174.58,
      "text": "還有無數位的,"
    },
    {
      "end": 28176.04,
      "start": 28175.38,
      "text": "後面編輯的,"
    },
    {
      "end": 28177.12,
      "start": 28176.04,
      "text": "還有那幾個戰友,"
    },
    {
      "end": 28178.96,
      "start": 28177.12,
      "text": "咱們太感謝你們了。"
    },
    {
      "end": 28180.96,
      "start": 28178.96,
      "text": "七哥是一個被你們,"
    },
    {
      "end": 28182.18,
      "start": 28180.96,
      "text": "把一個狗屎,"
    },
    {
      "end": 28184.96,
      "start": 28182.18,
      "text": "現在做成了最甜的甜麵包的一個人。"
    },
    {
      "end": 28187.46,
      "start": 28184.96,
      "text": "我這個狗屎是沒有資格來批評,"
    },
    {
      "end": 28188.9,
      "start": 28187.46,
      "text": "廚師做得好不好。"
    },
    {
      "end": 28190.1,
      "start": 28188.9,
      "text": "而我要感謝的是,"
    },
    {
      "end": 28192.44,
      "start": 28190.1,
      "text": "你們這些無名的戰友,"
    },
    {
      "end": 28193.44,
      "start": 28192.44,
      "text": "和背後的戰友,"
    },
    {
      "end": 28194.84,
      "start": 28193.44,
      "text": "真的是發自內心的。"
    },
    {
      "end": 28198.04,
      "start": 28194.84,
      "text": "是你們把這個不能唱歌的狗屎的七哥,"
    },
    {
      "end": 28200.24,
      "start": 28198.04,
      "text": "變成了世界上最甜的蛋糕。"
    },
    {
      "end": 28201.5,
      "start": 28200.24,
      "text": "我要感謝的是你們,"
    },
    {
      "end": 28202.58,
      "start": 28201.5,
      "text": "發自內心的。"
    },
    {
      "end": 28203.92,
      "start": 28202.58,
      "text": "特別是讓我唱,"
    },
    {
      "end": 28205.12,
      "start": 28203.92,
      "text": "我願意唱。"
    },
    {
      "end": 28207.62,
      "start": 28205.12,
      "text": "特別是我覺得我唱完以後,"
    },
    {
      "end": 28210.32,
      "start": 28207.62,
      "text": "我非常驕傲這樣的歌。"
    },
    {
      "end": 28212.42,
      "start": 28210.32,
      "text": "而且我聽到這個歌詞,"
    },
    {
      "end": 28213.96,
      "start": 28212.42,
      "text": "看到這個MV的時候,"
    },
    {
      "end": 28217.12,
      "start": 28213.96,
      "text": "我覺得我們不需要表演給任何人看。"
    },
    {
      "end": 28219.3,
      "start": 28217.12,
      "text": "我最在乎的是戰友今天,"
    },
    {
      "end": 28220.36,
      "start": 28219.3,
      "text": "在102層,"
    },
    {
      "end": 28221.9,
      "start": 28220.36,
      "text": "還有在電視機前面,"
    },
    {
      "end": 28224.24,
      "start": 28221.9,
      "text": "我們真正的製造爆料革命的,"
    },
    {
      "end": 28226.08,
      "start": 28224.24,
      "text": "和真正的新中國聯邦人,"
    },
    {
      "end": 28227.7,
      "start": 28226.08,
      "text": "和真正有良知的人,"
    },
    {
      "end": 28230.84,
      "start": 28227.7,
      "text": "而且不是狹隘的共產黨的種族主義者,"
    },
    {
      "end": 28232.48,
      "start": 28230.84,
      "text": "來看待蒙古的事情,"
    },
    {
      "end": 28235.14,
      "start": 28232.48,
      "text": "而且把蒙古的事情看成是我們的事情。"
    },
    {
      "end": 28236.94,
      "start": 28235.14,
      "text": "這個意義大了去了,"
    },
    {
      "end": 28239.98,
      "start": 28236.94,
      "text": "真的維廉王、唐平妹妹非常非常感激,"
    },
    {
      "end": 28242.36,
      "start": 28239.98,
      "text": "還有所有背後的兄弟姐妹們,"
    },
    {
      "end": 28245.06,
      "start": 28243.56,
      "text": "你倆講講。"
    },
    {
      "end": 28248.12,
      "start": 28247.0,
      "text": "謝謝七哥,"
    },
    {
      "end": 28250.26,
      "start": 28248.12,
      "text": "謝謝七哥。"
    },
    {
      "end": 28252.26,
      "start": 28250.26,
      "text": "然後我覺得這首歌主要就是,"
    },
    {
      "end": 28254.1,
      "start": 28253.4,
      "text": "思想、"
    },
    {
      "end": 28255.16,
      "start": 28254.6,
      "text": "生命、"
    },
    {
      "end": 28256.04,
      "start": 28255.16,
      "text": "還有靈魂。"
    },
    {
      "end": 28258.3,
      "start": 28257.04,
      "text": "思想從我這裡出,"
    },
    {
      "end": 28259.04,
      "start": 28258.3,
      "text": "然後呢,"
    },
    {
      "end": 28261.24,
      "start": 28259.54,
      "text": "小狼姐賦予了這首歌的,"
    },
    {
      "end": 28262.6,
      "start": 28261.6,
      "text": "有血有肉的生命。"
    },
    {
      "end": 28265.18,
      "start": 28262.6,
      "text": "然後最重要的是七哥賦予了這首歌的靈魂。"
    },
    {
      "end": 28267.04,
      "start": 28265.48,
      "text": "我相信任何壞一個人唱,"
    },
    {
      "end": 28268.18,
      "start": 28267.04,
      "text": "不管是這個地球上,"
    },
    {
      "end": 28269.34,
      "start": 28268.44,
      "text": "其他人誰唱,"
    },
    {
      "end": 28270.82,
      "start": 28269.68,
      "text": "都唱不出這個,"
    },
    {
      "end": 28272.52,
      "start": 28271.02,
      "text": "這首歌真正要表達的意義,"
    },
    {
      "end": 28273.82,
      "start": 28272.52,
      "text": "和都不能,"
    },
    {
      "end": 28275.78,
      "start": 28274.08,
      "text": "讓這首歌真正的意義去,"
    },
    {
      "end": 28279.02,
      "start": 28276.48,
      "text": "直觸到每一個聽了這首歌的人心裡。"
    },
    {
      "end": 28280.52,
      "start": 28279.02,
      "text": "不管他是能聽得懂,"
    },
    {
      "end": 28281.76,
      "start": 28280.52,
      "text": "還是聽不懂中文,"
    },
    {
      "end": 28284.2,
      "start": 28281.76,
      "text": "他都能產生一個心裡的衝擊力。"
    },
    {
      "end": 28288.2,
      "start": 28284.2,
      "text": "然後去產生探究的欲望到底是什麼情感。"
    },
    {
      "end": 28289.0,
      "start": 28288.2,
      "text": "然後,"
    },
    {
      "end": 28290.04,
      "start": 28289.0,
      "text": "哎呀,"
    },
    {
      "end": 28292.14,
      "start": 28290.04,
      "text": "反正是三者缺一不可,"
    },
    {
      "end": 28294.8,
      "start": 28292.14,
      "text": "所以我還要給七哥再寫一百首。"
    },
    {
      "end": 28300.54,
      "start": 28294.8,
      "text": "兩者金字如果还能聽 Hall just"
    },
    {
      "end": 28304.78,
      "start": 28300.88,
      "text": "關於 yelling 100會不會放υτա那關於"
    },
    {
      "end": 28307.38,
      "start": 28305.04,
      "text": "哪一個音樂人的反應 Car"
    },
    {
      "end": 28309.54,
      "start": 28307.64,
      "text": "愛情接受者這個時間ła"
    },
    {
      "end": 28310.64,
      "start": 28309.82,
      "text": "哦。"
    },
    {
      "end": 28313.78,
      "start": 28311.02,
      "text": "又今天她跟着她們走ื似做者的чик"
    },
    {
      "end": 28315.54,
      "start": 28314.06,
      "text": "figuring out"
    },
    {
      "end": 28320.14,
      "start": 28315.54,
      "text": "然後還能找到一個這樣的一個靈魂的聲音"
    },
    {
      "end": 28323.98,
      "start": 28320.14,
      "text": "一個靈魂的隔著一個領路人一個領軍人"
    },
    {
      "end": 28326.8,
      "start": 28323.98,
      "text": "他要去帶動這一場革命"
    },
    {
      "end": 28330.38,
      "start": 28326.8,
      "text": "他要去為這個不公而去發聲"
    },
    {
      "end": 28335.26,
      "start": 28330.38,
      "text": "為去拯救全人類我們爆料革命的戰友都是走在最前線的"
    },
    {
      "end": 28339.86,
      "start": 28335.26,
      "text": "那這種精神必須要承載這樣的"
    },
    {
      "end": 28344.22,
      "start": 28339.86,
      "text": "完全完全就是要承載世界上最好的音樂"
    },
    {
      "end": 28348.58,
      "start": 28344.22,
      "text": "那麼現在目前來看好像我是有責任要去這麼做的"
    },
    {
      "end": 28352.16,
      "start": 28348.58,
      "text": "所以我太榮幸也是太幸福了"
    },
    {
      "end": 28356.0,
      "start": 28352.16,
      "text": "就是很享受這個過程真的"
    },
    {
      "end": 28359.58,
      "start": 28356.0,
      "text": "還要感謝這個我們編曲的SFG戰友"
    },
    {
      "end": 28360.6,
      "start": 28359.58,
      "text": "是的"
    },
    {
      "end": 28362.66,
      "start": 28360.6,
      "text": "《九滅中共》也是他編的"
    },
    {
      "end": 28367.52,
      "start": 28362.66,
      "text": "所以一直為什麼我經常給七哥有的時候發信息是上午發"
    },
    {
      "end": 28371.86,
      "start": 28367.52,
      "text": "因為我基本上的時差就是牆內是一樣的"
    },
    {
      "end": 28374.16,
      "start": 28371.86,
      "text": "對 太感恩 太感恩"
    },
    {
      "end": 28376.22,
      "start": 28374.16,
      "text": "感謝每個戰友"
    },
    {
      "end": 28378.0,
      "start": 28376.22,
      "text": "對 我們這個SFG戰友"
    },
    {
      "end": 28379.8,
      "start": 28378.0,
      "text": "感動的故事SFG戰友"
    },
    {
      "end": 28383.12,
      "start": 28379.8,
      "text": "還有我們在背後的這個付出的戰友"
    },
    {
      "end": 28386.2,
      "start": 28383.12,
      "text": "我們這個歌呢就是剛才所說的一樣"
    },
    {
      "end": 28389.26,
      "start": 28386.2,
      "text": "他在歌頌正義"
    },
    {
      "end": 28390.3,
      "start": 28389.26,
      "text": "歌頌善良"
    },
    {
      "end": 28391.82,
      "start": 28390.3,
      "text": "歌頌真實"
    },
    {
      "end": 28393.1,
      "start": 28391.82,
      "text": "歌頌人性"
    },
    {
      "end": 28395.4,
      "start": 28393.1,
      "text": "而且上天在溝通啊"
    },
    {
      "end": 28398.74,
      "start": 28395.4,
      "text": "而且我覺得我們唱到偉大的蒼生天的時候"
    },
    {
      "end": 28399.24,
      "start": 28398.74,
      "text": "是吧"
    },
    {
      "end": 28401.04,
      "start": 28399.24,
      "text": "我那裡魂與你同在啊"
    },
    {
      "end": 28403.08,
      "start": 28401.04,
      "text": "這是我們的草原"
    },
    {
      "end": 28405.14,
      "start": 28403.08,
      "text": "我覺得這個這種力量啊"
    },
    {
      "end": 28407.94,
      "start": 28405.14,
      "text": "只有身在其中的人是有感受的"
    },
    {
      "end": 28410.5,
      "start": 28407.94,
      "text": "這個那天我去看那個馬的時候"
    },
    {
      "end": 28413.06,
      "start": 28410.5,
      "text": "這馬過來就是親我啊主動就親我"
    },
    {
      "end": 28414.6,
      "start": 28413.06,
      "text": "哎呀我就摸著馬啊"
    },
    {
      "end": 28415.88,
      "start": 28414.6,
      "text": "馬一直就靠著我"
    },
    {
      "end": 28417.94,
      "start": 28415.88,
      "text": "很特別的自然"
    },
    {
      "end": 28420.5,
      "start": 28417.94,
      "text": "我當時心裡邊就一下子就"
    },
    {
      "end": 28421.52,
      "start": 28420.5,
      "text": "一下子就趕出了"
    },
    {
      "end": 28423.58,
      "start": 28421.52,
      "text": "因為蒙古的馬都被吃了"
    },
    {
      "end": 28424.6,
      "start": 28423.58,
      "text": "啊"
    },
    {
      "end": 28426.38,
      "start": 28424.6,
      "text": "鎂骨的馬都在表演"
    },
    {
      "end": 28426.9,
      "start": 28426.38,
      "text": "啊"
    },
    {
      "end": 28429.2,
      "start": 28426.9,
      "text": "蒙古的馬都成了已經盤中肉了"
    },
    {
      "end": 28430.22,
      "start": 28429.2,
      "text": "是吧"
    },
    {
      "end": 28432.28,
      "start": 28430.22,
      "text": "現在到蒙古去連狼都被吃了"
    },
    {
      "end": 28433.3,
      "start": 28432.28,
      "text": "都打狼嘛"
    },
    {
      "end": 28434.84,
      "start": 28433.3,
      "text": "送給那個我到蒙古去以後"
    },
    {
      "end": 28436.62,
      "start": 28434.84,
      "text": "他們一下過來"
    },
    {
      "end": 28438.94,
      "start": 28436.62,
      "text": "拿著六個狗牙啊"
    },
    {
      "end": 28439.96,
      "start": 28438.94,
      "text": "狼牙啊"
    },
    {
      "end": 28440.72,
      "start": 28439.96,
      "text": "啊"
    },
    {
      "end": 28443.28,
      "start": 28440.72,
      "text": "說這是我們打這野狼的狼牙"
    },
    {
      "end": 28444.3,
      "start": 28443.28,
      "text": "哇塞"
    },
    {
      "end": 28445.84,
      "start": 28444.3,
      "text": "狼鋒騰"
    },
    {
      "end": 28449.42,
      "start": 28445.84,
      "text": "蒙古人竟然把狼的牙拿來作為了項鍊"
    },
    {
      "end": 28451.48,
      "start": 28449.42,
      "text": "說辟邪啊"
    },
    {
      "end": 28453.52,
      "start": 28451.48,
      "text": "對我當時是很大震撼的啊"
    },
    {
      "end": 28455.56,
      "start": 28453.52,
      "text": "我身上不會有任點傷害這些東西"
    },
    {
      "end": 28457.36,
      "start": 28455.56,
      "text": "我覺得是邪氣"
    },
    {
      "end": 28458.9,
      "start": 28457.36,
      "text": "我當時就拒絕了啊"
    },
    {
      "end": 28461.2,
      "start": 28458.9,
      "text": "但那晚上我喝了爆醉啊"
    },
    {
      "end": 28462.48,
      "start": 28461.2,
      "text": "然後呢蒙古包裡面"
    },
    {
      "end": 28464.02,
      "start": 28462.48,
      "text": "然後呢這個這個喝爆醉"
    },
    {
      "end": 28465.3,
      "start": 28464.02,
      "text": "還吐血那天啊"
    },
    {
      "end": 28467.86,
      "start": 28465.3,
      "text": "什麼整羊蒙古人跳舞"
    },
    {
      "end": 28469.14,
      "start": 28467.86,
      "text": "後來我都記不清楚了"
    },
    {
      "end": 28470.42,
      "start": 28469.14,
      "text": "都喝過了"
    },
    {
      "end": 28472.46,
      "start": 28470.42,
      "text": "但是在那天之後呢"
    },
    {
      "end": 28473.74,
      "start": 28472.46,
      "text": "第二天我醒來的時候"
    },
    {
      "end": 28475.28,
      "start": 28473.74,
      "text": "我見了這個蒙古的朋友"
    },
    {
      "end": 28478.86,
      "start": 28475.28,
      "text": "我說你以後能不能不去打蒙古的狼呢"
    },
    {
      "end": 28481.42,
      "start": 28478.86,
      "text": "這個狼圖騰是你們的驕傲"
    },
    {
      "end": 28483.98,
      "start": 28481.42,
      "text": "他說這是我們給貴賓的待遇"
    },
    {
      "end": 28486.54,
      "start": 28483.98,
      "text": "我說你知道這個貴賓只要你這個狼牙的"
    },
    {
      "end": 28488.34,
      "start": 28486.54,
      "text": "他都是孫子你知道嗎"
    },
    {
      "end": 28489.62,
      "start": 28488.34,
      "text": "他就不是人"
    },
    {
      "end": 28491.66,
      "start": 28489.62,
      "text": "那個狼招你惹你了"
    },
    {
      "end": 28495.0,
      "start": 28491.66,
      "text": "蒙古的草原都沙漠化了"
    },
    {
      "end": 28496.8,
      "start": 28495.0,
      "text": "有幾個狼啊"
    },
    {
      "end": 28498.58,
      "start": 28496.8,
      "text": "你們把他給打了"
    },
    {
