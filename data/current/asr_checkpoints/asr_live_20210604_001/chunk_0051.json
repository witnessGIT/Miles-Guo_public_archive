    {
      "end": 46464.98,
      "start": 46463.98,
      "text": "非常厉害的"
    },
    {
      "end": 46466.98,
      "start": 46464.98,
      "text": "我太太哭得要命"
    },
    {
      "end": 46468.98,
      "start": 46466.98,
      "text": "我说你不用怕"
    },
    {
      "end": 46470.98,
      "start": 46468.98,
      "text": "这个时候呢"
    },
    {
      "end": 46474.98,
      "start": 46470.98,
      "text": "他们又从国内又派人专程来美国"
    },
    {
      "end": 46476.98,
