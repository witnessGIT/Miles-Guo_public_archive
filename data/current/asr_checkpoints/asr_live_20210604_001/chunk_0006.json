    },
    {
      "end": 5740.38,
      "start": 5731.72,
      "text": "愛之夜 神祖無名號家人"
    },
    {
      "end": 5745.42,
      "start": 5740.38,
      "text": "萬悔自由新年"
    },
    {
      "end": 5753.98,
