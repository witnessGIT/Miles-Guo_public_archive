    },
    {
      "end": 5708.76,
      "start": 5706.76,
      "text": "斩写了 与心变弃"
    },
    {
      "end": 5712.76,
      "start": 5708.76,
      "text": "千余 十宝背着 勤尊"
    },
    {
      "end": 5714.76,
