    },
    {
      "end": 6043.74,
      "start": 6034.46,
      "text": "Oh say can you see by the dawn's early light"
    },
    {
      "end": 6051.74,
      "start": 6043.74,
      "text": "What so proudly we hailed at the twilight's last gleaming"
    },
    {
      "end": 6060.98,
      "start": 6051.74,
      "text": "Whose broad stripes and bright stars through the perilous fight"
    },
    {
      "end": 6064.98,
      "start": 6060.98,
      "text": "O'er the ramparts we watched"
    },
    {
      "end": 6068.98,
      "start": 6064.98,
      "text": "were so gallantly streaming"
    },
    {
      "end": 6070.98,
      "start": 6068.98,
