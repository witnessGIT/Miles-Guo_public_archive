  "segments": [
    {
      "end": 5404.16,
      "start": 5400.0,
      "text": "打造了一個運用世界最前沿科技"
    },
    {
      "end": 5407.76,
      "start": 5404.16,
      "text": "和以前滅共的金融生態圈"
    },
    {
      "end": 5416.64,
      "start": 5407.76,
      "text": "為新中國聯邦人描繪了未來和平、富裕、文明、幸福的光明前景"
    },
    {
      "end": 5422.8,
      "start": 5416.64,
      "text": "也向世界展示了華人對藝術、文化、時尚"
    },
    {
      "end": 5427.2,
      "start": 5422.8,
      "text": "和一切美好事物的領悟和追求"
    },
    {
      "end": 5432.0,
      "start": 5427.2,
      "text": "四年跟隨郭文貴先生爆料革命"
    },
    {
      "end": 5436.8,
      "start": 5432.0,
      "text": "讓我們每個新中國聯邦人日益成熟"
    },
    {
      "end": 5441.2,
      "start": 5436.8,
      "text": "精神上得到了脫胎換骨般的洗禮"
    },
    {
      "end": 5448.4,
      "start": 5441.2,
      "text": "這些是我們每個新中國聯邦人都應該銘記和感恩的"
    },
    {
      "end": 5452.0,
      "start": 5448.4,
      "text": "路漫漫其修遠西"
    },
    {
      "end": 5456.4,
      "start": 5452.0,
      "text": "新中國聯邦的未來是披荊斬棘的過程"
    },
    {
      "end": 5462.0,
      "start": 5456.4,
      "text": "考驗著每個新中國聯邦人的正義、補我和勇氣"
    },
    {
      "end": 5467.2,
      "start": 5462.0,
      "text": "我們選擇了這條崎嶇並充滿荊棘的修行之路"
    },
    {
      "end": 5474.0,
      "start": 5467.2,
      "text": "在相愛、相尊、相知的信條下互相幫助、彼此關心"
    },
    {
      "end": 5477.2,
      "start": 5474.0,
      "text": "加入新中國聯邦不分先後"
    },
    {
      "end": 5479.2,
      "start": 5477.2,
      "text": "跟隨郭文貴先生"
    },
    {
      "end": 5489.6,
      "start": 5479.2,
      "text": "為天地立心、為聲明立命、為往盛即絕學、為萬事開太平"
    },
    {
      "end": 5492.4,
      "start": 5489.6,
      "text": "新中國聯邦的同胞們"
    },
    {
      "end": 5494.2,
      "start": 5492.4,
      "text": "起約無依"
    },
    {
      "end": 5496.0,
      "start": 5494.2,
      "text": "與子同袍"
    },
    {
      "end": 5499.6,
      "start": 5496.0,
      "text": "自己別於無力為關心"
    },
    {
      "end": 5502.88,
      "start": 5499.6,
      "text": "進入"
    },
    {
      "end": 5505.36,
      "start": 5502.88,
