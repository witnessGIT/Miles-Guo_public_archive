      "text": "怎么开对"
    },
    {
      "end": 51333.54,
      "start": 51330.0,
      "text": "七十年前顾北川的战力"
    },
    {
      "end": 51336.04,
      "start": 51333.54,
      "text": "如今一九四年在出发大地"
    },
    {
      "end": 51338.46,
      "start": 51336.04,
      "text": "关天关地关空气"
    },
    {
      "end": 51340.74,
      "start": 51338.46,
      "text": "终将来关着你的生殖心"
    },
    {
      "end": 51343.18,
      "start": 51340.74,
      "text": "老百姓们活的不如出稿"
    },
    {
      "end": 51345.56,
      "start": 51343.18,
      "text": "没得散不被他们吐出全跑"
    },
    {
      "end": 51347.96,
      "start": 51345.56,
      "text": "传统和话 传统和话无有"
    },
    {
      "end": 51350.4,
      "start": 51347.96,
      "text": "那他也没人敢到还没收口"
    },
    {
      "end": 51352.8,
      "start": 51350.4,
      "text": "你把孙大肩肩的高伤胸"
    },
    {
      "end": 51355.24,
      "start": 51352.8,
      "text": "是放你的高 把你死降左右"
    },
    {
      "end": 51357.62,
      "start": 51355.24,
      "text": "看不去的眼泪不停的流"
    },
    {
      "end": 51360.32,
      "start": 51357.62,
      "text": "喝点小抗社会 我去你个头"
    },
    {
      "end": 51366.86,
      "start": 51360.32,
      "text": "喝了散地酒啊 看不中共家何仇"
    },
    {
      "end": 51373.92,
      "start": 51366.86,
      "text": "喝了散地酒啊 赞尽心埋得自由"
    },
    {
      "end": 51380.42,
      "start": 51373.92,
      "text": "喝了散地酒啊 只痛三后一生"
    },
    {
      "end": 51387.6,
      "start": 51380.42,
      "text": "喝了散地酒啊 无面恶当师父"
    },
    {
      "end": 51391.44,
      "start": 51387.6,
      "text": "喝了散地酒啊 万艺悶当师父"
    },
    {
      "end": 51398.44,
      "start": 51391.44,
      "text": "大旅遊中 全新的空跟我走"
    },
    {
      "end": 51402.44,
      "start": 51398.44,
      "text": "好久啊好久啊好久"
    },
    {
      "end": 51405.44,
