      "no_speech_prob": 0.0,
      "start": 5400.0,
      "text": "然後再給自己找理由解脫嗎?"
    },
    {
      "avg_logprob": -0.52209,
      "compression_ratio": 0.923729,
      "end": 5424.38,
      "no_speech_prob": 0.0,
      "start": 5422.08,
      "text": "七哥真的這些天最大的痛苦"
    },
    {
      "avg_logprob": -0.52209,
      "compression_ratio": 0.923729,
      "end": 5426.02,
      "no_speech_prob": 0.0,
      "start": 5424.82,
      "text": "莫過於如此"
    },
    {
      "avg_logprob": -0.52209,
      "compression_ratio": 0.923729,
      "end": 5427.82,
      "no_speech_prob": 0.0,
      "start": 5426.42,
      "text": "就看著我們同胞"
    },
    {
      "avg_logprob": -0.424387,
      "compression_ratio": 1.262295,
      "end": 5430.38,
      "no_speech_prob": 0.0,
      "start": 5427.82,
      "text": "在文化大革命"
    },
    {
      "avg_logprob": -0.424387,
      "compression_ratio": 1.262295,
      "end": 5432.18,
      "no_speech_prob": 0.0,
      "start": 5431.66,
      "text": "餓死"
    },
    {
      "avg_logprob": -0.424387,
      "compression_ratio": 1.262295,
      "end": 5433.58,
      "no_speech_prob": 0.0,
      "start": 5432.94,
      "text": "生產隊"
    },
    {
      "avg_logprob": -0.424387,
      "compression_ratio": 1.262295,
      "end": 5434.48,
      "no_speech_prob": 0.0,
      "start": 5433.78,
      "text": "群居"
    },
    {
      "avg_logprob": -0.424387,
      "compression_ratio": 1.262295,
      "end": 5438.32,
      "no_speech_prob": 0.0,
      "start": 5437.3,
      "text": "三反五反"
    },
    {
      "avg_logprob": -0.424387,
      "compression_ratio": 1.262295,
      "end": 5441.26,
      "no_speech_prob": 0.0,
      "start": 5440.2,
      "text": "然後搞土改"
    },
    {
      "avg_logprob": -0.424387,
      "compression_ratio": 1.262295,
      "end": 5442.78,
      "no_speech_prob": 0.0,
      "start": 5441.58,
      "text": "殺了兩百多萬地主"
    },
    {
      "avg_logprob": -0.424387,
      "compression_ratio": 1.262295,
      "end": 5444.72,
      "no_speech_prob": 0.0,
      "start": 5442.98,
      "text": "結果死了六千多萬老百姓"
    },
    {
      "avg_logprob": -0.424387,
      "compression_ratio": 1.262295,
      "end": 5450.98,
      "no_speech_prob": 0.0,
      "start": 5447.54,
      "text": "文化大革命把中國老祖宗上五千年的一切"
    },
    {
      "avg_logprob": -0.424387,
      "compression_ratio": 1.262295,
      "end": 5452.82,
      "no_speech_prob": 0.0,
      "start": 5451.44,
      "text": "毀於一旦"
    },
    {
      "avg_logprob": -0.424387,
      "compression_ratio": 1.262295,
      "end": 5454.82,
      "no_speech_prob": 0.0,
      "start": 5453.68,
      "text": "然後還享受其中"
