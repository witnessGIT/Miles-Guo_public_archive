    {
      "avg_logprob": -0.327025,
      "compression_ratio": 1.5,
      "end": 5471.14,
      "no_speech_prob": 0.0,
      "start": 5470.1,
      "text": "我現在告訴大家"
    },
    {
      "avg_logprob": -0.327025,
      "compression_ratio": 1.5,
      "end": 5472.16,
      "no_speech_prob": 0.0,
      "start": 5471.14,
