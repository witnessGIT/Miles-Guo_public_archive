    {
      "avg_logprob": -0.168712,
      "compression_ratio": 1.304688,
      "end": 34300.2,
      "no_speech_prob": 0.0,
      "start": 34298.2,
      "text": "感謝郭先生開創了爆料革命。"
    },
    {
      "avg_logprob": -0.168712,
      "compression_ratio": 1.304688,
      "end": 34305.2,
      "no_speech_prob": 0.0,
      "start": 34300.2,
      "text": "感謝郭先生給了無數中國人一個希望,我們的力量和郭先生相比是渺小的,但是不要忘了。"
    },
