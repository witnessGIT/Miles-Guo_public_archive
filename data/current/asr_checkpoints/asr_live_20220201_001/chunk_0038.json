    },
    {
      "avg_logprob": -0.168712,
      "compression_ratio": 1.304688,
      "end": 34293.2,
      "no_speech_prob": 0.0,
      "start": 34289.2,
      "text": "宣傳中共的邪惡和疫苗和對全人的危害是我的使命。"
    },
    {
      "avg_logprob": -0.168712,
      "compression_ratio": 1.304688,
      "end": 34298.2,
      "no_speech_prob": 0.0,
      "start": 34293.2,
      "text": "今年非常高興出現在全世界戰友面前,和郭先生直接連線。"
