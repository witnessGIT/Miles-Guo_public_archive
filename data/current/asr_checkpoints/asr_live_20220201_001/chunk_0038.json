    {
      "avg_logprob": -0.259415,
      "compression_ratio": 1.258242,
      "end": 34285.2,
      "no_speech_prob": 0.0,
      "start": 34275.2,
      "text": "郭先生好,戰友們好,我是黑夜勇士,我是來自西班牙洗衣場戰友。"
    },
    {
      "avg_logprob": -0.168712,
      "compression_ratio": 1.304688,
      "end": 34289.2,
      "no_speech_prob": 0.0,
      "start": 34285.2,
