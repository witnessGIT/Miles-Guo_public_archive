      "avg_logprob": -0.13945,
      "compression_ratio": 1.235577,
      "end": 5923.6,
      "no_speech_prob": 0.0,
      "start": 5913.6,
      "text": "不要在任何人面前随便评价和议论别人,这是基本的做人原则。"
