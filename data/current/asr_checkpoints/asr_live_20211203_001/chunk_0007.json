      "text": "希臘60歲以上強制疫苗"
    },
    {
      "end": 7153.9,
      "start": 7150.9,
      "text": "據說沒有打疫苗的還有交罰款"
    },
    {
      "end": 7154.9,
      "start": 7153.9,
      "text": "每個月100歐元"
    },
    {
      "end": 7160.9,
      "start": 7157.9,
      "text": "德國的強制疫苗政策"
    },
    {
      "end": 7163.9,
      "start": 7160.9,
      "text": "德國的總理安格拉默克爾宣布"
    },
    {
      "end": 7167.9,
      "start": 7163.9,
      "text": "德國將禁止未接種疫苗的人進入公共生活的大部分地區"
