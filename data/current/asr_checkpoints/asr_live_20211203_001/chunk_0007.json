      "text": "包括商店文化休閒休閒設施活動"
    },
    {
      "end": 7172.9,
      "start": 7170.9,
      "text": "並考慮實施強制疫苗"
    },
    {
      "end": 7175.9,
      "start": 7172.9,
      "text": "德國聯邦政府和州政府決定"
    },
    {
      "end": 7179.9,
