      "end": 7073.9,
      "start": 7071.9,
      "text": "傍晚時分又公布了"
    },
    {
      "end": 7077.9,
      "start": 7073.9,
      "text": "接種第二針疫苗不超過八個月的也考慮提前接種"
    },
    {
      "end": 7079.9,
      "start": 7077.9,
      "text": "非常的快啊"
    },
    {
      "end": 7085.9,
      "start": 7079.9,
      "text": "歐洲呢出現了截然不同的疫苗政策"
    },
