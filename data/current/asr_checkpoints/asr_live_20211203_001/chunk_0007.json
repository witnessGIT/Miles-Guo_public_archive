      "end": 7126.9,
      "start": 7123.9,
      "text": "考慮強制性疫苗接種的時刻到了"
    },
    {
      "end": 7128.9,
      "start": 7126.9,
      "text": "這就是幾月決定的"
    },
    {
      "end": 7129.9,
      "start": 7128.9,
      "text": "三月份"
    },
    {
      "end": 7130.9,
      "start": 7129.9,
      "text": "三月份決定的"
    },
    {
      "end": 7135.9,
      "start": 7130.9,
      "text": "那麼周三現在表示考慮強制性疫苗接種的時刻"
    },
    {
      "end": 7140.9,
      "start": 7135.9,
      "text": "奧地利呢表示二月將開始全民強制疫苗"
    },
    {
      "end": 7144.9,
      "start": 7140.9,
      "text": "並計劃以滅視法庭罪的修正案來推行強制疫苗"
    },
    {
      "end": 7147.9,
