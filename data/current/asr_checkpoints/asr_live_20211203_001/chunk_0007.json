      "end": 7064.9,
      "start": 7062.9,
      "text": "11月30日"
    },
    {
      "end": 7066.9,
      "start": 7064.9,
      "text": "日本的早上公布了"
    },
    {
      "end": 7069.9,
      "start": 7066.9,
      "text": "接種第二針疫苗超過八個月開始的第三針"
    },
    {
      "end": 7071.9,
      "start": 7069.9,
      "text": "且醫護人員優先接種"
