    {
      "end": 2524.0,
      "start": 2523.0,
      "text": "百分之百給拿下了"
    },
    {
      "end": 2525.0,
      "start": 2524.0,
      "text": "我給你們講一個故事啊"
    },
    {
      "end": 2526.0,
