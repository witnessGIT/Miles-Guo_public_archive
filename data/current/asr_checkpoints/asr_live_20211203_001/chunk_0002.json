      "text": "第二天我打電話"
    },
    {
      "end": 2548.0,
      "start": 2547.0,
      "text": "我說你幹嘛"
    },
    {
      "end": 2549.0,
      "start": 2548.0,
      "text": "我有急事問你"
    },
    {
      "end": 2550.0,
      "start": 2549.0,
      "text": "就是那個價格的事"
    },
    {
      "end": 2551.0,
      "start": 2550.0,
      "text": "怎麼漲那麼快啊"
    },
    {
      "end": 2552.0,
      "start": 2551.0,
      "text": "他說大哥"
    },
    {
      "end": 2553.0,
      "start": 2552.0,
      "text": "等我一會給你回電話"
    },
    {
      "end": 2555.0,
      "start": 2553.0,
      "text": "我正在弄那個賭牌的事兒"
