      "text": "你咋辦呢"
    },
    {
      "end": 2583.0,
      "start": 2582.0,
      "text": "你說"
    },
    {
      "end": 2584.0,
      "start": 2583.0,
      "text": "我說我心疼你"
    },
    {
      "end": 2585.0,
      "start": 2584.0,
      "text": "真是白心疼了"
    },
    {
      "end": 2586.0,
