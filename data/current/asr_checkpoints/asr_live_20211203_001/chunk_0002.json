      "text": "放在一起"
    },
    {
      "end": 2653.0,
      "start": 2652.0,
      "text": "因為只能接受"
    },
    {
      "end": 2655.0,
      "start": 2653.0,
      "text": "他不能低於11個股東"
    },
    {
      "end": 2657.0,
      "start": 2655.0,
      "text": "他也不能接受小股東"
