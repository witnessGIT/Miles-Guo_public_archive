{
  "chunk_audio_sha256": "edfcc6d039520c23f972b8587f80655bcf57904eace2b31bd400839c16b11347",
  "chunk_index": 6,
  "completed_at": "2026-10-21T10:00:32Z",
  "language": "zh",
  "live_id": "LIVE_20211203_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 5400,
