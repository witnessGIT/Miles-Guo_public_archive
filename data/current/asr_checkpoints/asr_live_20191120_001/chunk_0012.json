  "segments": [
    {
      "end": 10802.9,
      "start": 10800.0,
      "text": "再講妳所有的這是王芳"
    },
    {
      "end": 10806.9,
      "start": 10802.9,
      "text": "黃芳啊所有的走"
    },
    {
      "end": 10810.9,
      "start": 10808.1,
      "text": "黃芳妳在跟法官檢察官說"
    },
    {
      "end": 10814.2,
      "start": 10811.2,
      "text": "那件T恤衫是妳給他賣的"
    },
    {
      "end": 10816.46,
      "start": 10814.66,
      "text": "褲衫是妳給他買妳拿走了"
    },
    {
      "end": 10818.24,
      "start": 10816.46,
      "text": "身上的物品妳拿走了"
    },
    {
      "end": 10821.24,
      "start": 10818.32,
      "text": "而且妳說王健出門就愛在牆上照片"
    },
    {
      "end": 10822.5,
      "start": 10821.24,
      "text": "這是他的習慣"
    },
    {
      "end": 10825.54,
      "start": 10824.54,
      "text": "就這麽多"
    },
    {
      "end": 10827.66,
      "start": 10826.56,
      "text": "大家看壹看"
    },
    {
      "end": 10832.66,
      "start": 10827.66,
      "text": "王健的夫人死亡之後黃芳所有的就這麽多"
    },
    {
      "end": 10834.86,
      "start": 10833.36,
      "text": "大家覺得正常嗎"
    },
    {
      "end": 10838.06,
      "start": 10836.06,
      "text": "大家覺得正常嗎"
    },
    {
      "end": 10840.16,
      "start": 10838.06,
      "text": "大家看著剛才那個信息"
    },
    {
      "end": 10844.26,
      "start": 10840.16,
      "text": "黃芳已經被人家安排好田丁盯著他"
    },
    {
      "end": 10848.86,
      "start": 10844.26,
      "text": "大家想到路德先生記得不田丁當時就在西雅圖住在他家裏面"
    },
    {
      "end": 10850.46,
      "start": 10848.86,
      "text": "我們拍到的視頻"
    },
    {
      "end": 10856.06,
      "start": 10850.46,
      "text": "好吧現在我們跟我們的今天總導演大衛先生連線"
    },
    {
      "end": 10857.26,
      "start": 10856.06,
      "text": "大衛先生"
    },
    {
      "end": 10859.66,
      "start": 10857.66,
      "text": "看看大衛先生的心臟怎麽樣"
    },
    {
      "end": 10860.66,
      "start": 10859.66,
      "text": "受得了嗎"
    },
    {
      "end": 10861.66,
      "start": 10860.66,
      "text": "大衛先生"
    },
    {
      "end": 10862.66,
      "start": 10861.66,
      "text": "大衛先生"
    },
    {
      "end": 10863.66,
      "start": 10862.66,
      "text": "大衛先生"
    },
    {
      "end": 10866.9,
      "start": 10863.66,
      "text": "67問"
    },
    {
      "end": 10867.86,
      "start": 10866.9,
      "text": "哎七哥我在能聽見嗎"
    },
    {
      "end": 10868.96,
      "start": 10867.86,
      "text": "你好兄弟嚇到什麽感受"
    },
    {
      "end": 10869.76,
      "start": 10868.96,
      "text": "你說吧"
    },
    {
      "end": 10872.64,
      "start": 10869.76,
      "text": "首先七哥我感叹您"
    },
    {
      "end": 10876.98,
      "start": 10872.64,
      "text": "咱们就是去年王健案在侦查的过程当中"
    },
    {
      "end": 10880.54,
      "start": 10876.98,
      "text": "您有几次释放了这个消息"
    },
    {
      "end": 10882.02,
      "start": 10880.54,
      "text": "然后这个消息呢"
    },
    {
      "end": 10884.14,
      "start": 10882.02,
      "text": "现在回看那个照片和证据"
    },
    {
      "end": 10887.96,
      "start": 10884.14,
      "text": "成功的把这个CDP阵脚打乱"
    },
    {
      "end": 10890.66,
      "start": 10887.96,
      "text": "然后我就想跟赞文分享一个问题"
    },
    {
      "end": 10891.7,
      "start": 10890.66,
      "text": "请大家回忆一下"
    },
    {
      "end": 10893.3,
      "start": 10891.7,
      "text": "就是我们这个案子"
    },
    {
      "end": 10896.32,
      "start": 10893.3,
      "text": "为什么王健这个案子要发生在法国"
    },
    {
      "end": 10899.42,
      "start": 10896.32,
      "text": "大家看一看七哥先把什么证据拿出来"
    },
    {
      "end": 10901.44,
      "start": 10899.42,
      "text": "是先把这几个人的照片"
    },
    {
      "end": 10903.8,
      "start": 10901.44,
      "text": "而且那个照片拍得非常清楚"
    },
    {
      "end": 10905.82,
      "start": 10903.8,
      "text": "是在教堂的那个墙的附近"
    },
    {
      "end": 10906.82,
      "start": 10905.82,
      "text": "那个小树林"
    },
    {
      "end": 10907.86,
      "start": 10906.82,
      "text": "这是第一个点"
    },
    {
      "end": 10909.2,
      "start": 10907.86,
      "text": "这个能证明什么"
    },
    {
      "end": 10912.78,
      "start": 10909.2,
      "text": "把后面所有人的证词就不攻而破了"
    },
    {
      "end": 10913.86,
      "start": 10912.78,
      "text": "这是第一点"
    },
    {
      "end": 10916.3,
      "start": 10913.86,
      "text": "第二大家再明白一点"
    },
    {
      "end": 10919.24,
      "start": 10916.3,
      "text": "华斌坐在车里没有上那个墙"
    },
    {
      "end": 10922.44,
      "start": 10919.24,
      "text": "但是王健为什么要跟着上那个荒凉的教堂"
    },
    {
      "end": 10923.14,
      "start": 10922.44,
      "text": "他要见谁"
    },
    {
      "end": 10925.52,
      "start": 10923.14,
      "text": "这是证据链上核心的一点"
    },
    {
      "end": 10928.48,
      "start": 10925.52,
      "text": "那么在刚刚出事的手机上的"
    },
    {
      "end": 10929.76,
      "start": 10928.48,
      "text": "一个短信"
    },
    {
      "end": 10931.5,
      "start": 10929.76,
      "text": "大家已经找到答案了"
    },
    {
      "end": 10933.1,
      "start": 10931.5,
      "text": "那么证据链上还有一点"
    },
    {
      "end": 10935.86,
      "start": 10933.1,
      "text": "就是田丁你的短信发给谁"
    },
    {
      "end": 10937.4,
      "start": 10935.86,
      "text": "你拿的药"
    },
    {
      "end": 10940.62,
      "start": 10937.4,
      "text": "还有你这个拍了餐厅的照片"
    },
    {
      "end": 10941.32,
      "start": 10940.62,
      "text": "你又给谁"
    },
    {
      "end": 10942.86,
      "start": 10941.32,
      "text": "这个证据链"
    },
    {
      "end": 10943.58,
      "start": 10942.86,
      "text": "说白了"
    },
    {
      "end": 10944.96,
      "start": 10943.58,
      "text": "七哥拿出来这些东西"
    },
    {
      "end": 10946.76,
      "start": 10944.96,
      "text": "是非常有指向性的"
    },
    {
      "end": 10948.72,
      "start": 10946.76,
      "text": "指向了王岐山"
    },
    {
      "end": 10950.6,
      "start": 10948.72,
      "text": "还有一个单位"
    },
    {
      "end": 10951.36,
      "start": 10950.6,
      "text": "共产党的部门"
    },
    {
      "end": 10952.28,
      "start": 10951.36,
      "text": "我要跟赞文分享"
    },
    {
      "end": 10953.42,
      "start": 10952.28,
      "text": "那就是国安委"
    },
    {
      "end": 10956.6,
      "start": 10953.42,
      "text": "这个案子能用国安委的人"
    },
    {
      "end": 10957.88,
      "start": 10956.6,
      "text": "到达法国 大家注意听"
    },
    {
      "end": 10959.62,
      "start": 10957.88,
      "text": "没有带着自己的身份"
    },
    {
      "end": 10962.42,
      "start": 10959.62,
      "text": "而是跟当地法国的外交部"
    },
    {
      "end": 10963.86,
      "start": 10962.42,
      "text": "予以外交官的身份"
    },
    {
      "end": 10965.12,
      "start": 10963.86,
      "text": "来介入这个案件调查"
    },
    {
      "end": 10966.2,
      "start": 10965.12,
      "text": "我请问战友们"
    },
    {
      "end": 10967.22,
      "start": 10966.2,
      "text": "两个国家"
    },
    {
      "end": 10968.12,
      "start": 10967.22,
      "text": "你的外交部"
    },
    {
      "end": 10969.56,
      "start": 10968.12,
      "text": "你有什么资格来指挥"
    },
    {
      "end": 10971.02,
      "start": 10969.56,
      "text": "另外一个主权国家"
    },
    {
      "end": 10972.22,
      "start": 10971.02,
      "text": "法国的司法部门"
    },
    {
      "end": 10973.08,
      "start": 10972.22,
      "text": "对吧"
    },
    {
      "end": 10975.22,
      "start": 10973.08,
      "text": "你为什么要隐盖自己的身份"
    },
    {
      "end": 10976.18,
      "start": 10975.22,
      "text": "那么国安委是谁"
    },
    {
      "end": 10976.56,
      "start": 10976.18,
      "text": "战友们"
    },
    {
      "end": 10979.06,
      "start": 10976.56,
      "text": "国安委没有丁薛祥的知晓"
    },
    {
      "end": 10980.5,
      "start": 10979.06,
      "text": "再没有上面的人"
    },
    {
      "end": 10981.22,
      "start": 10980.5,
      "text": "老大知晓"
    },
    {
      "end": 10982.52,
      "start": 10981.22,
      "text": "这个案子你怎么进行"
    },
    {
      "end": 10983.86,
      "start": 10982.52,
      "text": "那么你做的"
    },
    {
      "end": 10985.72,
      "start": 10983.86,
      "text": "这个所谓的法国当地的笔录"
    },
    {
      "end": 10986.46,
      "start": 10985.72,
      "text": "还有调查"
    },
    {
      "end": 10988.14,
      "start": 10986.46,
      "text": "你最后要对谁汇报"
    },
    {
      "end": 10988.98,
      "start": 10988.14,
      "text": "对吧"
    },
    {
      "end": 10990.12,
      "start": 10988.98,
      "text": "这么大的国家的事情"
    },
    {
      "end": 10991.24,
      "start": 10990.12,
      "text": "全程参与"
    },
    {
      "end": 10991.9,
      "start": 10991.24,
      "text": "所以呢"
    },
    {
      "end": 10993.52,
      "start": 10991.9,
      "text": "七哥给我们展示的证据"
    },
    {
      "end": 10994.74,
      "start": 10993.52,
      "text": "首先把照片拿出来"
    },
    {
      "end": 10996.0,
      "start": 10994.74,
      "text": "还有刚才的"
    },
    {
      "end": 10997.32,
      "start": 10996.0,
      "text": "王健上车的录像"
    },
    {
      "end": 10998.8,
      "start": 10997.32,
      "text": "还有王健的这个"
    },
    {
      "end": 11001.92,
      "start": 10998.8,
      "text": "这个身上的这个衣服"
    },
    {
      "end": 11002.44,
      "start": 11001.92,
      "text": "衣物"
    },
    {
      "end": 11003.78,
      "start": 11002.44,
      "text": "关键性证词"
    },
    {
      "end": 11005.14,
      "start": 11003.78,
      "text": "把所有前面"
    },
    {
      "end": 11007.48,
      "start": 11005.14,
      "text": "孟宏伟取证的法国笔录"
    },
    {
      "end": 11008.66,
      "start": 11007.48,
      "text": "荡然无存"
    },
    {
      "end": 11009.34,
      "start": 11008.66,
      "text": "全部打碎"
    },
    {
      "end": 11011.42,
      "start": 11009.34,
      "text": "那么大家千万别忘了"
    },
    {
      "end": 11014.52,
      "start": 11011.42,
      "text": "做笔录本身就是一个重大司法犯罪"
    },
    {
      "end": 11016.1,
      "start": 11014.52,
      "text": "也就是说上面每个人"
    },
    {
      "end": 11017.42,
      "start": 11016.1,
      "text": "参与这个案子的人"
    },
    {
      "end": 11018.92,
      "start": 11017.42,
      "text": "还有每个人参与的"
    },
    {
      "end": 11020.0,
      "start": 11018.92,
      "text": "写的每一个字"
    },
    {
      "end": 11022.7,
      "start": 11020.0,
      "text": "这些摆在前面"
    },
    {
      "end": 11024.24,
      "start": 11022.7,
      "text": "就是真正正的证据"
    },
    {
      "end": 11025.4,
      "start": 11024.24,
      "text": "对吧"
    },
    {
      "end": 11025.86,
      "start": 11025.4,
      "text": "所以呢"
    },
    {
      "end": 11027.9,
      "start": 11025.86,
      "text": "我佩服七哥的这个调查的战略"
    },
    {
      "end": 11030.58,
      "start": 11027.9,
      "text": "然后老弟也跟着"
    },
    {
      "end": 11033.04,
      "start": 11030.58,
      "text": "也跟着这个参与了这么多节目"
    },
    {
      "end": 11035.68,
      "start": 11033.04,
      "text": "但是我始终在等您揭开这个锅盖"
    },
    {
      "end": 11037.72,
      "start": 11035.68,
      "text": "当我真看到上面这个证据"
    },
    {
      "end": 11039.24,
      "start": 11037.72,
      "text": "我一是被佩服七哥"
    },
    {
      "end": 11040.2,
      "start": 11039.24,
      "text": "第二我也震惊"
    },
    {
      "end": 11041.44,
      "start": 11040.2,
      "text": "我震惊的是"
    },
    {
      "end": 11043.24,
      "start": 11041.44,
      "text": "共产党战友们一定要明白"
    },
    {
      "end": 11044.72,
      "start": 11043.24,
      "text": "能动用国安委"
    },
    {
      "end": 11046.48,
      "start": 11044.72,
      "text": "能动用外交手段"
    },
    {
      "end": 11049.16,
      "start": 11046.48,
      "text": "对一个国家的司法进行这样的渗透的话"
    },
    {
      "end": 11050.0,
      "start": 11049.16,
      "text": "我请问战友们"
    },
    {
      "end": 11051.38,
      "start": 11050.0,
      "text": "我们爆料革命的意义在哪里"
    },
    {
      "end": 11053.4,
      "start": 11051.38,
      "text": "我们就是以真灭共"
    },
    {
      "end": 11054.16,
      "start": 11053.4,
      "text": "以法灭共"
    },
    {
      "end": 11057.26,
      "start": 11054.16,
      "text": "让全世界看清共产党在西方的渗透"
    },
    {
      "end": 11057.86,
      "start": 11057.26,
      "text": "蓝金黄"
    },
    {
      "end": 11060.2,
      "start": 11057.86,
      "text": "看透共产党的对全人类的威胁"
    },
    {
      "end": 11061.98,
      "start": 11060.2,
      "text": "也就是说爆料革命到现在"
    },
    {
      "end": 11064.06,
      "start": 11061.98,
      "text": "这不是一场私人的恩怨的较量"
    },
    {
      "end": 11067.34,
      "start": 11064.06,
      "text": "不是一场说文贵先生想证明自己的较量"
    },
    {
      "end": 11068.84,
      "start": 11067.34,
      "text": "这是让全世界人明白"
    },
    {
      "end": 11070.3,
      "start": 11068.84,
      "text": "共产党的本质"
    },
    {
      "end": 11071.0,
      "start": 11070.3,
      "text": "邪恶"
    },
    {
      "end": 11072.1,
      "start": 11071.0,
      "text": "虚伪和残恶"
    },
    {
      "end": 11073.02,
      "start": 11072.1,
      "text": "谢谢七哥"
    },
    {
      "end": 11074.5,
      "start": 11073.02,
      "text": "我就简单说到这"
    },
    {
      "end": 11076.66,
      "start": 11074.5,
      "text": "大卫兄弟啊"
    },
    {
      "end": 11078.76,
      "start": 11076.66,
      "text": "你和郑氏小哥"
    },
    {
      "end": 11082.46,
      "start": 11078.76,
      "text": "是当时这个整个王健案子"
    },
    {
      "end": 11084.46,
      "start": 11082.46,
      "text": "你是当时是跟的最多的"
    },
    {
      "end": 11086.16,
      "start": 11084.46,
      "text": "那么今天啊"
    },
    {
      "end": 11088.12,
      "start": 11086.16,
      "text": "这个你的解答和解读"
    },
    {
      "end": 11090.06,
      "start": 11088.12,
      "text": "我就这么短的时间"
    },
    {
      "end": 11090.62,
      "start": 11090.06,
      "text": "我相信"
    },
    {
      "end": 11091.92,
      "start": 11090.62,
      "text": "你还没崩差"
    },
    {
      "end": 11093.92,
      "start": 11091.92,
      "text": "这个说明你是非常镇定的"
    },
    {
      "end": 11096.02,
      "start": 11093.92,
      "text": "你看到了这个事情的本质"
    },
    {
      "end": 11097.98,
      "start": 11096.02,
      "text": "这个两国的关系"
    },
    {
      "end": 11098.98,
      "start": 11097.98,
      "text": "刑事调查"
    },
    {
      "end": 11101.06,
      "start": 11098.98,
      "text": "任何一个常人都知道"
    },
