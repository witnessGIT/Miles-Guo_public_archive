{
  "chunk_audio_sha256": "0d0a6f991ee19d3781fa4ac5afb77b3b4003d5d21e2ba2ea89d2e31f345dd143",
  "chunk_index": 6,
  "completed_at": "2026-10-20T03:31:27Z",
  "language": "zh",
  "live_id": "LIVE_20191120_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 5400,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 5404.74,
      "start": 5400.0,
      "text": "誰簽的啊王岐山"
    },
    {
      "end": 5406.4,
      "start": 5405.0,
      "text": "還有王岐山的老闆啊"
    },
    {
      "end": 5407.44,
      "start": 5406.4,
      "text": "我安就不服了"
    },
    {
      "end": 5413.82,
      "start": 5410.76,
      "text": "妳怎麽能老顯示妳那95塊錢那個"
    },
    {
      "end": 5414.98,
      "start": 5413.82,
      "text": "4塊4毛8的"
    },
    {
      "end": 5416.68,
      "start": 5415.12,
      "text": "那老顯示那個路德先生那個"
    },
    {
      "end": 5417.48,
      "start": 5416.84,
      "text": "Drive那個"
    },
    {
      "end": 5418.52,
      "start": 5417.98,
      "text": "還有票呢"
    },
    {
      "end": 5419.88,
      "start": 5418.52,
      "text": "妳怎麽老顯示那幾個人啊"
    },
    {
      "end": 5422.4,
      "start": 5421.74,
      "text": "看著"
    },
    {
      "end": 5429.32,
      "start": 5427.9,
      "text": "誰說妳不是顯示判定嗎"
    },
    {
      "end": 5434.18,
      "start": 5430.0,
      "text": "妳那麽一樣壹個人在捐是嗎"
    },
    {
      "end": 5436.6,
      "start": 5435.4,
      "text": "哦是嗎"
    },
    {
      "end": 5438.48,
      "start": 5437.2,
      "text": "哦天哪還有壹個人"
    },
    {
      "end": 5441.08,
      "start": 5438.48,
      "text": "天哪戰友們妳勸太多了壹直在捐"
    },
    {
      "end": 5446.58,
      "start": 5443.22,
      "text": "今天誰都捐就是路德先生沒捐"
    },
    {
      "end": 5451.96,
      "start": 5447.96,
      "text": "路德先生沒錢只有錢交女朋友沒錢捐"
    },
    {
      "end": 5454.6,
      "start": 5452.28,
      "text": "所以說大家看到這個華冰的時候"
    },
    {
      "end": 5455.7,
      "start": 5454.7,
      "text": "我們了解到"
    },
    {
      "end": 5459.9,
      "start": 5455.96,
      "text": "為什麽華冰能成為法國的公開登記的間諜"
    },
    {
      "end": 5460.7,
      "start": 5459.9,
      "text": "黑陣"
    },
    {
      "end": 5462.9,
      "start": 5461.5,
      "text": "而且是外交官"
    },
    {
      "end": 5466.08,
      "start": 5463.54,
      "text": "而且他在這個最關鍵"
    },
    {
      "end": 5467.38,
      "start": 5466.3,
      "text": "壹會兒往大家看"
    },
    {
      "end": 5470.38,
      "start": 5467.98,
      "text": "華冰沒上沒上教堂"
    },
    {
      "end": 5473.12,
      "start": 5470.92,
      "text": "華冰是誰沒讓他上的教堂"
    },
    {
      "end": 5476.42,
      "start": 5473.48,
      "text": "到教堂為什麽王健突然去教堂"
    },
    {
      "end": 5478.42,
      "start": 5476.82,
      "text": "為什麽王健到健堂"
    },
    {
      "end": 5481.42,
      "start": 5478.42,
      "text": "我跟他說過他去見誰去啦"
    },
    {
      "end": 5485.9,
      "start": 5482.82,
      "text": "妳會發現華冰這個王八蛋簡直太壞了"
    },
    {
      "end": 5488.84,
      "start": 5486.1,
      "text": "這個整個殺害王健的整個陰謀"
    },
    {
      "end": 5491.74,
      "start": 5488.9,
      "text": "整個兇手最重要的指揮就是華冰"
    },
    {
      "end": 5495.2,
      "start": 5493.26,
      "text": "他壹個字都沒留下"
    },
    {
      "end": 5499.54,
      "start": 5495.2,
      "text": "這妳就知道法國的檢察官"
    },
    {
      "end": 5500.6,
      "start": 5499.78,
      "text": "警察"
    },
    {
      "end": 5501.74,
      "start": 5500.74,
      "text": "消防官"
    },
    {
      "end": 5502.5,
      "start": 5501.94,
      "text": "法官"
    },
    {
      "end": 5503.74,
      "start": 5502.5,
      "text": "混蛋至極"
    },
    {
      "end": 5505.18,
      "start": 5503.98,
      "text": "都是壹幫騙子"
    },
    {
      "end": 5506.38,
      "start": 5505.38,
      "text": "全照的假"
    },
    {
      "end": 5508.52,
      "start": 5507.64,
      "text": "下壹個是誰"
    },
    {
      "end": 5515.02,
      "start": 5514.12,
      "text": "撥片"
    },
    {
      "end": 5517.22,
      "start": 5516.58,
      "text": "撥片"
    },
    {
      "end": 5518.52,
      "start": 5517.42,
      "text": "那就撥片吧"
    },
    {
      "end": 5521.5,
      "start": 5519.96,
      "text": "又要撥短片了"
    },
    {
      "end": 5523.8,
      "start": 5521.62,
      "text": "戰友們提供的短片"
    },
    {
      "end": 5528.2,
      "start": 5525.2,
      "text": "啊講的興奮吶"
    },
    {
      "end": 5531.2,
      "start": 5530.2,
      "text": "開始撥片啊"
    },
    {
      "end": 5541.98,
      "start": 5540.82,
      "text": "治王健的壹封信"
    },
    {
      "end": 5544.42,
      "start": 5541.98,
      "text": "這個是咱們戰友誰做的這是"
    },
    {
      "end": 5547.16,
      "start": 5546.32,
      "text": "這是誰做的"
    },
    {
      "end": 5550.02,
      "start": 5549.22,
      "text": "有聲音啊"
    },
    {
      "end": 5554.96,
      "start": 5553.5,
      "text": "MIP做的太好了太好了"
    },
    {
      "end": 5557.44,
      "start": 5555.2,
      "text": "妳的死亡最想調查真相的"
    },
    {
      "end": 5559.7,
      "start": 5557.9,
      "text": "不是妳那結髮之妻黃芳"
    },
    {
      "end": 5561.2,
      "start": 5559.98,
      "text": "也不是妳的弟弟王偉"
    },
    {
      "end": 5563.34,
      "start": 5561.64,
      "text": "更不是創業夥伴陳峰"
    },
    {
      "end": 5566.32,
      "start": 5563.74,
      "text": "也不可能是妳的老闆王岐山"
    },
    {
      "end": 5569.54,
      "start": 5567.28,
      "text": "正是把海航集團送上斷頭臺的"
    },
    {
      "end": 5570.42,
      "start": 5569.78,
      "text": "妳的敵人"
    },
    {
      "end": 5571.42,
      "start": 5570.88,
      "text": "郭文貴"
    },
    {
      "end": 5574.06,
      "start": 5573.08,
      "text": "妳死後沒過幾天"
    },
    {
      "end": 5577.16,
      "start": 5574.32,
      "text": "郭先生就分六次派出團隊去了法國"
    },
    {
      "end": 5579.62,
      "start": 5577.82,
      "text": "這些團隊是由前紐約警察"
    },
    {
      "end": 5582.06,
      "start": 5579.92,
      "text": "和前FBI組成的調查團隊"
    },
    {
      "end": 5584.82,
      "start": 5582.06,
      "text": "他們走訪了妳生前到過的所有地方"
    },
    {
      "end": 5586.74,
      "start": 5585.4,
      "text": "見了所有與妳接觸的人"
    },
    {
      "end": 5590.36,
      "start": 5587.16,
      "text": "以及辦理妳案件的法國政府部門"
    },
    {
      "end": 5594.66,
      "start": 5590.36,
      "text": "雖然中國警方早於調查團隊來到了法國"
    },
    {
      "end": 5597.8,
      "start": 5594.86,
      "text": "要求相關知情人不能透露任何信息"
    },
    {
      "end": 5601.4,
      "start": 5598.3,
      "text": "但是郭先生團隊還是拿到了許多證據"
    },
    {
      "end": 5603.54,
      "start": 5602.34,
      "text": "甚至找到了第一位"
    },
    {
      "end": 5605.34,
      "start": 5603.54,
      "text": "趕到死亡現場的目擊者"
    },
    {
      "end": 5609.22,
      "start": 5605.94,
      "text": "也邀請了他來到美國參加了由班農先生"
    },
    {
      "end": 5612.72,
      "start": 5609.22,
      "text": "一起舉辦的王健之死新聞發布會"
    },
    {
      "end": 5616.16,
      "start": 5614.16,
      "text": "郭先生對於妳死亡真相的調查"
    },
    {
      "end": 5617.66,
      "start": 5616.46,
      "text": "真是煞費苦心了"
    },
    {
      "end": 5620.56,
      "start": 5618.28,
      "text": "這裡妳真的欠了一聲感謝"
    },
    {
      "end": 5622.46,
      "start": 5621.42,
      "text": "但是絕對不要以為"
    },
    {
      "end": 5623.46,
      "start": 5622.52,
      "text": "郭先生這麼做"
    },
    {
      "end": 5625.02,
      "start": 5623.52,
      "text": "僅僅是為了妳一個人"
    },
    {
      "end": 5628.0,
      "start": 5625.6,
      "text": "正如他在那場新聞發布會上所說的"
    },
    {
      "end": 5630.36,
      "start": 5628.46,
      "text": "王健到底是怎麼死的"
    },
    {
      "end": 5632.66,
      "start": 5630.36,
      "text": "對於我們大家來講都很重要"
    },
    {
      "end": 5635.2,
      "start": 5632.8,
      "text": "否則我們每個人都可能成為下一個王健"
    },
    {
      "end": 5636.8,
      "start": 5636.2,
      "text": "王健先生"
    },
    {
      "end": 5638.64,
      "start": 5637.06,
      "text": "妳死後的這500來天裏"
    },
    {
      "end": 5639.76,
      "start": 5638.8,
      "text": "發生了很多事"
    },
    {
      "end": 5642.6,
      "start": 5640.44,
      "text": "首先關於海航是徹底完了"
    },
    {
      "end": 5644.34,
      "start": 5643.34,
      "text": "郭先生爆料之後"
    },
    {
      "end": 5647.34,
      "start": 5644.58,
      "text": "海航在國際社會上是徹底失去了信用"
    },
    {
      "end": 5648.98,
      "start": 5648.32,
      "text": "為了還債"
    },
    {
      "end": 5650.08,
      "start": 5649.38,
      "text": "賣股權"
    },
    {
      "end": 5650.84,
      "start": 5650.22,
      "text": "賣房產"
    },
    {
      "end": 5652.08,
      "start": 5651.18,
      "text": "甚至賣飛機"
    },
    {
      "end": 5654.06,
      "start": 5652.48,
      "text": "能變現的都在賣"
    },
    {
      "end": 5656.58,
      "start": 5654.82,
      "text": "海航持有的德意志銀行股份"
    },
    {
      "end": 5660.06,
      "start": 5657.06,
      "text": "已經有9.9%減持到了6.3%"
    },
    {
      "end": 5663.06,
      "start": 5660.36,
      "text": "甚至有出售所有股份的傳言流出"
    },
    {
      "end": 5666.94,
      "start": 5663.66,
      "text": "香港新九龍那塊地虧了7.4億港幣"
    },
    {
      "end": 5669.16,
      "start": 5667.2,
      "text": "但是還是出售賣給了下架"
    },
    {
      "end": 5671.3,
      "start": 5669.7,
      "text": "妳們是做航空起家的"
    },
    {
      "end": 5673.28,
      "start": 5671.48,
      "text": "航空業可以說是老本行了"
    },
    {
      "end": 5676.38,
      "start": 5673.7,
      "text": "但是海航不但出售了旗下航空公司的股"
    },
    {
      "end": 5677.08,
      "start": 5676.38,
      "text": "全部說"
    },
    {
      "end": 5678.74,
      "start": 5677.28,
      "text": "連飛機都在賣"
    },
    {
      "end": 5681.94,
      "start": 5679.08,
      "text": "這兩年海南航空的收入也是不斷的驟減"
    },
    {
      "end": 5686.86,
      "start": 5682.38,
      "text": "2018年海航航空集團營業收入2000萬元左右"
    },
    {
      "end": 5689.16,
      "start": 5687.36,
      "text": "净虧損4.6億元"
    },
    {
      "end": 5691.66,
      "start": 5689.16,
      "text": "而到了2019年上半年"
    },
    {
      "end": 5695.46,
      "start": 5691.86,
      "text": "營收報降至73.83萬元"
    },
    {
      "end": 5698.36,
      "start": 5695.74,
      "text": "净虧損3.76億元"
    },
    {
      "end": 5702.78,
      "start": 5698.74,
      "text": "就這海航還有近千億的債務等待償還"
    },
    {
      "end": 5705.48,
      "start": 5702.78,
      "text": "妳覺得這樣的海航還有救嗎"
    },
    {
      "end": 5709.86,
      "start": 5706.58,
      "text": "人們都在問這巨額的債務到底是誰造成的"
    },
    {
      "end": 5715.16,
      "start": 5710.48,
      "text": "妳的好基友陳峰毫不留情的把這頂帽子重重的扣在了妳的頭上"
    },
    {
      "end": 5719.16,
      "start": 5715.9,
      "text": "陳峰接受采訪談及海航失敗原因時說道"
    },
    {
      "end": 5722.66,
      "start": 5719.16,
      "text": "內因是主因我們自身修養不夠"
    },
    {
      "end": 5726.24,
      "start": 5722.86,
      "text": "欲望太大速度過快步伐不穩"
    },
    {
      "end": 5729.74,
      "start": 5726.66,
      "text": "把我這樣本來退居二線的人都給逼住來了"
    },
    {
      "end": 5731.28,
      "start": 5730.28,
      "text": "妳看看妳看看"
    },
    {
      "end": 5735.04,
      "start": 5731.5,
      "text": "他完全把責任推給了妳並且撇清了自己的關係"
    },
    {
      "end": 5739.04,
      "start": 5735.04,
      "text": "陳峰甚至在妳一周年忌日的時候弄了一篇名為"
    },
    {
      "end": 5741.54,
      "start": 5739.24,
      "text": "《陳峰撥亂反正》的文章"
    },
    {
      "end": 5746.66,
      "start": 5741.84,
      "text": "裏面說在2016年的時候妳就要求高管們簽署了一份陽光宣言"
    },
    {
      "end": 5748.12,
      "start": 5747.12,
      "text": "對妳表忠心"
    },
    {
      "end": 5752.42,
      "start": 5748.38,
      "text": "而且還口頭通知要對陳峰執行三部政策"
    },
    {
      "end": 5754.8,
      "start": 5752.62,
      "text": "完全隔離排擠陳峰"
    },
    {
      "end": 5757.3,
      "start": 5755.36,
      "text": "我想問問真有這個事嗎"
    },
    {
      "end": 5759.64,
      "start": 5758.16,
      "text": "另外對於妳的離奇死亡"
    },
    {
      "end": 5761.16,
      "start": 5759.64,
      "text": "陳峰也認為是很正常"
    },
    {
      "end": 5763.7,
      "start": 5761.6,
      "text": "她說妳喜歡冒險又喜歡照相"
    },
    {
      "end": 5765.16,
      "start": 5763.7,
      "text": "砰的一下吊了下去"
    },
    {
      "end": 5766.2,
      "start": 5765.16,
      "text": "就這麼簡單"
    },
    {
      "end": 5768.78,
      "start": 5766.7,
      "text": "妳這位昔日一同創業的戰友"
    },
    {
      "end": 5772.0,
      "start": 5768.78,
      "text": "我怎麼覺得她這麼做有點太無情了呢"
    },
    {
      "end": 5773.28,
      "start": 5772.28,
      "text": "不過話說回來"
    },
    {
      "end": 5776.62,
      "start": 5773.28,
      "text": "對於妳的死訊反應最為強烈的還是馬雲"
    },
    {
      "end": 5779.32,
      "start": 5777.04,
      "text": "聽說她當時聽到妳去世的消息"
    },
    {
      "end": 5780.58,
      "start": 5779.32,
      "text": "整個人都傻了"
    },
    {
      "end": 5785.16,
      "start": 5781.12,
      "text": "兩個月後她就公布了要辭去阿里巴巴董事長職務的消息"
    },
    {
      "end": 5786.62,
      "start": 5785.46,
      "text": "而就在這一天"
    },
    {
      "end": 5790.66,
      "start": 5786.62,
      "text": "她旗下的支付寶也正式被中國銀聯收編了"
    },
    {
      "end": 5792.7,
      "start": 5791.36,
      "text": "在今年的9月10日"
    },
    {
      "end": 5794.7,
      "start": 5792.7,
      "text": "馬雲正式辭職"
    },
    {
      "end": 5796.0,
      "start": 5794.7,
      "text": "完成了交接"
    },
    {
      "end": 5797.28,
      "start": 5796.0,
      "text": "她激流勇退"
    },
    {
      "end": 5798.4,
      "start": 5797.28,
      "text": "捨才保命"
    },
    {
      "end": 5801.0,
      "start": 5798.4,
      "text": "這招金蟬脫鞘固然高明"
    },
    {
      "end": 5804.08,
      "start": 5801.0,
      "text": "但是似乎也沒完全能夠擺脫中共的控制"
    },
    {
      "end": 5805.58,
      "start": 5804.08,
      "text": "就在她辭職之後"
    },
    {
      "end": 5806.94,
      "start": 5805.58,
      "text": "微信上就瘋傳"
    },
    {
      "end": 5809.62,
      "start": 5806.94,
      "text": "馬雲全家患癌症的消息"
    },
    {
      "end": 5810.92,
      "start": 5809.62,
      "text": "這裡面的含義"
    },
    {
      "end": 5812.58,
      "start": 5810.92,
      "text": "相信妳也是懂的"
    },
    {
      "end": 5815.66,
      "start": 5813.58,
      "text": "馬雲正式辭職的10天後"
    },
    {
      "end": 5817.62,
      "start": 5815.66,
      "text": "馬化騰也低調卸任了"
    },
    {
      "end": 5820.16,
      "start": 5817.62,
      "text": "騰訊公司法定代表人"
    },
    {
      "end": 5822.16,
      "start": 5820.16,
      "text": "及執行董事的職務"
    },
    {
      "end": 5823.46,
      "start": 5822.16,
      "text": "不光是他們"
    },
    {
      "end": 5825.96,
      "start": 5823.46,
      "text": "其他一些企業家的日子也不好過"
    },
    {
      "end": 5831.76,
      "start": 5825.96,
      "text": "王健林沒有被邀請參加去年習近平召開的中國民營企業家座談會"
    },
    {
      "end": 5836.24,
      "start": 5831.76,
      "text": "百名傑出民營企業家的名單上也沒有他的名字"
    },
    {
      "end": 5840.54,
      "start": 5836.24,
      "text": "所以她在今年4月份的時候去延安良家河村"
    },
    {
      "end": 5843.82,
      "start": 5840.54,
      "text": "在習近平雨露前拍照表忠心"
    },
    {
      "end": 5847.62,
      "start": 5843.82,
      "text": "但她的孩子王思聰還是在今年10月份出了事"
    },
    {
      "end": 5852.16,
      "start": 5847.62,
      "text": "不僅王思聰創辦的普斯資本股權遭凍結"
    },
    {
      "end": 5857.0,
      "start": 5852.16,
      "text": "他擔任高管或股東的數十家公司的股權也被凍結"
    },
    {
      "end": 5860.26,
      "start": 5857.0,
      "text": "他本人也因金融失信變成了老賴"
    },
    {
      "end": 5863.76,
      "start": 5860.26,
      "text": "直接從一個高富帥變成了一個高富帥"
    },
    {
      "end": 5865.84,
      "start": 5863.76,
      "text": "徐家印的情況也不佳"
    },
    {
      "end": 5868.06,
      "start": 5865.84,
      "text": "聽說已經被邊控不能出國了"
    },
    {
      "end": 5870.26,
      "start": 5868.06,
      "text": "要我說你們都是自己做的"
    },
    {
      "end": 5873.88,
      "start": 5870.26,
      "text": "如果早聽郭先生在18年年初說的這段話的話"
    },
    {
      "end": 5875.64,
      "start": 5873.88,
      "text": "估計都還有救"
    },
    {
      "end": 5878.02,
      "start": 5875.64,
      "text": "接下來這些事實往下走"
    },
    {
      "end": 5883.22,
      "start": 5878.02,
      "text": "中國內部將實行全民經濟被講嚴謀"
    },
    {
      "end": 5887.6,
      "start": 5883.22,
      "text": "然後內部首付的公私聯營制"
    },
    {
      "end": 5889.6,
      "start": 5887.6,
      "text": "經濟大動盪"
    },
    {
      "end": 5892.22,
      "start": 5889.6,
      "text": "然後黨內清黨"
    },
    {
      "end": 5895.06,
      "start": 5892.22,
      "text": "清黨將是大運動"
    },
    {
      "end": 5897.84,
      "start": 5895.06,
      "text": "然後海外極度擴張"
    },
    {
      "end": 5900.6,
      "start": 5897.84,
      "text": "派駐軍事各個基地"
    },
    {
      "end": 5903.8,
      "start": 5900.6,
      "text": "然後挑戰以美國為首的西方"
    },
    {
      "end": 5908.52,
      "start": 5903.8,
      "text": "然後中國所有的私人權進入最悲慘的時代"
    },
    {
      "end": 5910.22,
      "start": 5908.52,
      "text": "因為叫剪羊毛"
    },
    {
      "end": 5915.22,
      "start": 5910.22,
      "text": "這就是1932年的德國到1972年的德國"
    },
    {
      "end": 5917.6,
      "start": 5915.22,
      "text": "然後受到壓力最大的"
    },
    {
      "end": 5919.22,
      "start": 5917.6,
      "text": "那就是台灣"
    },
    {
      "end": 5921.22,
      "start": 5919.22,
      "text": "香港"
    },
    {
      "end": 5923.14,
      "start": 5921.22,
      "text": "然後周邊的日本"
    },
    {
      "end": 5928.18,
      "start": 5923.14,
      "text": "會大肆地在國內煽動民族主義"
    },
    {
      "end": 5929.84,
      "start": 5928.18,
      "text": "國家仇恨主義"
    },
    {
      "end": 5931.84,
      "start": 5929.84,
      "text": "仇恨美國日本"
    },
    {
      "end": 5933.84,
      "start": 5931.84,
      "text": "禁仇日遠仇美"
    },
    {
      "end": 5936.02,
      "start": 5933.84,
      "text": "然後對外極度擴張"
    },
    {
      "end": 5939.84,
      "start": 5936.02,
      "text": "對內進行經濟上全面的剪羊毛"
    },
    {
      "end": 5944.22,
      "start": 5939.84,
      "text": "現在國內外的形勢跟郭先生當時說的一模一樣"
    },
    {
      "end": 5948.22,
      "start": 5944.22,
      "text": "你就這樣走了或許也少了一分提心吊膽吧"
    },
    {
      "end": 5948.84,
      "start": 5948.22,
      "text": "哦對了"
    },
    {
      "end": 5950.22,
      "start": 5948.84,
      "text": "你死後三個月"
    },
    {
      "end": 5951.72,
      "start": 5950.22,
      "text": "翻冰冰又出來了"
    },
    {
      "end": 5953.22,
      "start": 5951.72,
      "text": "被罰了快九個億"
    },
    {
      "end": 5955.22,
      "start": 5953.22,
      "text": "演藝圈也是一片狼藉"
    },
    {
      "end": 5959.22,
      "start": 5955.22,
      "text": "至於你生前持有的那近15%的海航股權"
    },
    {
      "end": 5961.22,
      "start": 5959.22,
      "text": "已經被轉到了磁航基金"
    },
    {
      "end": 5962.84,
      "start": 5961.22,
      "text": "這個你就別惦記了"
    },
    {
      "end": 5963.84,
      "start": 5962.84,
      "text": "好了"
    },
    {
      "end": 5964.84,
      "start": 5963.84,
      "text": "今年的1120"
    },
    {
      "end": 5968.22,
      "start": 5964.84,
      "text": "郭先生還會對於你死亡真相繼續爆料"
    },
    {
      "end": 5969.22,
      "start": 5968.22,
      "text": "不過你放心"
    },
    {
      "end": 5971.22,
      "start": 5969.22,
      "text": "最近香港同胞都挺給力"
    },
    {
      "end": 5973.22,
      "start": 5971.22,
      "text": "共產黨也快到頭了"
    },
    {
      "end": 5974.72,
      "start": 5973.22,
      "text": "明年的1120"
    },
    {
      "end": 5978.22,
      "start": 5974.72,
      "text": "全國人民一定會知道是誰把你給害死了"
    },
    {
      "end": 5979.22,
      "start": 5978.22,
      "text": "你放心吧"
    },
    {
      "end": 5981.22,
      "start": 5979.22,
      "text": "你放心吧"
    },
    {
      "end": 5985.8,
      "start": 5981.22,
      "text": "我"
    },
    {
      "end": 5989.88,
      "start": 5985.8,
      "text": "我"
    },
    {
      "end": 5996.84,
      "start": 5992.84,
      "text": "你看"
    },
    {
      "end": 5999.8,
      "start": 5999.22,
      "text": "哎呀"
    },
    {
      "end": 6001.22,
      "start": 5999.8,
      "text": "大家都激動了"
    },
    {
      "end": 6003.72,
      "start": 6001.22,
      "text": "有點兒激動"
    },
    {
      "end": 6004.46,
      "start": 6003.72,
      "text": "有點兒激動"
    },
    {
      "end": 6008.22,
      "start": 6005.58,
      "text": "這1120今年真不一樣你們"
    },
    {
      "end": 6014.76,
      "start": 6008.22,
      "text": "剛剛看到整個美國處於瘋狂狀態"
    },
    {
      "end": 6018.2,
      "start": 6014.76,
      "text": "昨天香港人權法案剛剛完"
    },
    {
      "end": 6019.5,
      "start": 6018.2,
      "text": "剛剛他們告訴我說"
    },
    {
      "end": 6024.0,
      "start": 6019.5,
      "text": "整個華盛頓十幾個智庫今天早上突然聯名"
    },
    {
      "end": 6025.4,
      "start": 6024.0,
      "text": "要到白宮去"
    },
    {
      "end": 6029.98,
      "start": 6025.4,
      "text": "要到白宮馬上成立《香港緊急救援法》"
    },
    {
      "end": 6032.62,
      "start": 6030.62,
      "text": "蘇德先生妳看下爐下爐"
    },
    {
      "end": 6034.3,
      "start": 6033.24,
      "text": "《香港緊急救援法》"
    },
    {
      "end": 6036.12,
      "start": 6034.3,
      "text": "緊急救援法要開戰吧"
    },
    {
      "end": 6038.62,
      "start": 6036.38,
      "text": "那就是追共產黨壹切開戰了"
    },
    {
      "end": 6044.32,
      "start": 6039.46,
      "text": "這些所有的藍金黃力量全部投降了"
    },
    {
      "end": 6046.4,
      "start": 6044.46,
      "text": "全部現在站在香港人那邊了"
    },
    {
      "end": 6049.64,
      "start": 6046.4,
      "text": "剛剛給我發了信息這不是開完"
    },
    {
      "end": 6050.74,
      "start": 6049.64,
      "text": "不是這"
    },
    {
      "end": 6053.3,
      "start": 6050.74,
      "text": "而且說今天和下午和明天"
    },
    {
      "end": 6058.08,
      "start": 6053.3,
      "text": "發生無數個不可思議的支持香港的故事"
    },
    {
      "end": 6058.64,
      "start": 6058.08,
      "text": "好吧"
    },
    {
      "end": 6060.32,
      "start": 6058.64,
      "text": "我現在是不是該這個了是吧"
    },
    {
      "end": 6060.94,
      "start": 6060.32,
      "text": "對"
    },
    {
      "end": 6061.64,
      "start": 6060.94,
      "text": "好了"
    },
    {
      "end": 6062.82,
      "start": 6061.64,
      "text": "這有節目單啊"
    },
    {
      "end": 6067.42,
      "start": 6064.56,
      "text": "這是叫周天天"
    },
    {
      "end": 6069.72,
      "start": 6067.42,
      "text": "周天天來了來了來了來了來了"
    },
    {
      "end": 6072.32,
      "start": 6070.02,
      "text": "周天天周天天周天天啊"
    },
    {
      "end": 6073.9,
      "start": 6072.46,
      "text": "周天天啊"
    },
    {
      "end": 6075.3,
      "start": 6074.2,
      "text": "周天天"
    },
    {
      "end": 6078.04,
      "start": 6076.4,
      "text": "我這說起周天天"
    },
    {
      "end": 6081.18,
      "start": 6078.4,
      "text": "我今天爆料的時候我給我自己有三個原則啊"
    },
    {
      "end": 6081.94,
      "start": 6081.18,
      "text": "第一個"
    },
    {
      "end": 6083.14,
      "start": 6082.1,
      "text": "輕鬆的講"
    },
    {
      "end": 6084.14,
      "start": 6083.4,
      "text": "不要激動"
    },
    {
      "end": 6086.18,
      "start": 6084.28,
      "text": "因為我壹激動我就受不了了就"
    },
    {
      "end": 6088.08,
      "start": 6086.34,
      "text": "不是哭就是喊的這沒用是吧"
    },
    {
      "end": 6088.84,
      "start": 6088.08,
      "text": "那麽很累"
    },
    {
      "end": 6089.72,
      "start": 6089.04,
      "text": "是不是啊"
    },
    {
      "end": 6091.14,
      "start": 6089.88,
      "text": "這個我要不激動"
    },
    {
      "end": 6093.26,
      "start": 6091.34,
      "text": "第二個呢我把這個事情呢給它"
    },
    {
      "end": 6094.38,
      "start": 6093.42,
      "text": "輕鬆化"
    },
    {
      "end": 6096.62,
      "start": 6094.56,
      "text": "因為太沉重了咱都受不了"
    },
    {
      "end": 6097.92,
      "start": 6096.88,
      "text": "就沒法活了都"
    },
    {
      "end": 6099.42,
      "start": 6097.92,
      "text": "妳這得抑郁症了都"
    },
    {
      "end": 6102.72,
      "start": 6100.06,
      "text": "第三個就是我盡量把這事說的小壹點"
    },
    {
      "end": 6104.26,
      "start": 6102.72,
      "text": "越小越好"
    },
    {
      "end": 6106.76,
      "start": 6104.26,
      "text": "那就是讓大家自己去研究去發揮啊"
    },
    {
      "end": 6108.12,
      "start": 6106.76,
      "text": "我盡量的少說"
    },
    {
      "end": 6109.62,
      "start": 6108.12,
      "text": "大家根據這些文件"
    },
    {
      "end": 6110.5,
      "start": 6109.62,
      "text": "稍後啊"
    },
    {
      "end": 6116.3,
      "start": 6115.46,
      "text": "Sara"
    },
    {
      "end": 6117.6,
