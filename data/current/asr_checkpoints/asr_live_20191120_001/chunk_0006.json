    {
      "end": 6118.26,
      "start": 6117.6,
      "text": "好吧"
    },
    {
      "end": 6120.34,
      "start": 6118.26,
      "text": "妳們都在Gnews上都可以看到自己研究"
    },
    {
      "end": 6121.4,
