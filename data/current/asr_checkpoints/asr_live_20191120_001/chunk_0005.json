    {
      "end": 4772.5,
      "start": 4771.1,
      "text": "這句話壹定要記住"
    },
    {
      "end": 4773.3,
      "start": 4772.7,
      "text": "最後"
    },
    {
      "end": 4775.2,
      "start": 4773.5,
      "text": "我今天最後的爆料的手上"
    },
    {
      "end": 4778.1,
      "start": 4775.2,
      "text": "戰友們今天妳們每個人都會摔自己的頭"
    },
    {
      "end": 4779.1,
      "start": 4778.2,
      "text": "妳們都瘋狂"
    },
    {
      "end": 4780.7,
      "start": 4779.8,
      "text": "記住他這句話"
    },
    {
      "end": 4782.6,
      "start": 4781.4,
      "text": "華呆在車裏"
    },
    {
      "end": 4785.5,
      "start": 4783.5,
      "text": "就是有這個話"
    },
    {
      "end": 4788.5,
      "start": 4785.6,
      "text": "我看完以後我嚇傻了"
    },
    {
      "end": 4790.3,
      "start": 4789.2,
      "text": "我抽了兩根血架"
    },
    {
      "end": 4791.8,
      "start": 4790.7,
      "text": "其他所有人都出去了"
    },
    {
      "end": 4793.1,
      "start": 4791.8,
      "text": "我們直接去了教堂"
    },
    {
      "end": 4797.8,
      "start": 4795.3,
      "text": "太臉妳壹會兒讓小韓準備這豐富的午餐給我們"
    },
    {
      "end": 4798.6,
      "start": 4797.9,
      "text": "大餐啊"
    },
    {
      "end": 4799.6,
      "start": 4799.1,
      "text": "好不好"
    },
    {
      "end": 4800.7,
      "start": 4799.9,
      "text": "好好的我們吃"
    },
    {
      "end": 4802.9,
      "start": 4800.7,
      "text": "我們就都完了我們大家所有人大吃"
    },
    {
      "end": 4804.3,
      "start": 4803.5,
      "text": "更豪華餐"
    },
    {
      "end": 4808.6,
      "start": 4807.7,
      "text": "大家都吃"
    },
    {
      "end": 4809.5,
      "start": 4808.7,
      "text": "我們大家都吃"
    },
    {
      "end": 4812.2,
      "start": 4810.8,
      "text": "咱們有福同享"
    },
    {
      "end": 4813.6,
      "start": 4812.7,
      "text": "然後呢"
    },
    {
      "end": 4815.7,
      "start": 4813.7,
      "text": "但是其他時候去教堂"
    },
    {
      "end": 4817.4,
      "start": 4816.1,
      "text": "妳不是沒去教堂嗎"
    },
    {
      "end": 4818.7,
      "start": 4818.1,
      "text": "天定"
    },
    {
      "end": 4820.3,
      "start": 4819.1,
      "text": "妳不是沒去教堂嗎"
    },
    {
      "end": 4824.2,
      "start": 4820.5,
      "text": "我向妳介紹教堂的地圖來向我解釋我建議道華館嗎"
    },
    {
      "end": 4825.8,
      "start": 4824.3,
      "text": "我們把車停在咖啡館附近"
    },
    {
      "end": 4826.1,
      "start": 4825.8,
      "text": "這"
    },
    {
      "end": 4827.3,
      "start": 4826.3,
      "text": "停在咖啡館"
    },
    {
      "end": 4829.2,
      "start": 4827.6,
      "text": "咖啡館就是那個"
    },
    {
      "end": 4830.1,
      "start": 4829.3,
      "text": "我們"
    },
    {
      "end": 4831.3,
      "start": 4830.3,
      "text": "調錄像"
    },
    {
      "end": 4832.3,
      "start": 4831.6,
      "text": "還有"
    },
    {
      "end": 4834.1,
      "start": 4832.3,
      "text": "現在的錄像到時候我們沒有公佈啊"
    },
    {
      "end": 4835.7,
      "start": 4834.3,
      "text": "就是周天田"
    },
    {
      "end": 4837.4,
      "start": 4835.9,
      "text": "去到那兒喊報案"
    },
    {
      "end": 4839.0,
      "start": 4837.5,
      "text": "消防車說有人"
    },
    {
      "end": 4840.6,
      "start": 4839.2,
      "text": "可能會掉下來"
    },
    {
      "end": 4843.2,
      "start": 4840.8,
      "text": "還有在現場出生的小伙子那咖啡館"
    },
    {
      "end": 4845.6,
      "start": 4843.9,
      "text": "我們把車停在咖啡館附近"
    },
    {
      "end": 4846.6,
      "start": 4845.6,
      "text": "這條路是傾斜的"
    },
    {
      "end": 4848.0,
      "start": 4846.6,
      "text": "壹會我會給妳看照片"
    },
    {
      "end": 4850.7,
      "start": 4848.9,
      "text": "他不是停在咖啡館附近"
    },
    {
      "end": 4853.3,
      "start": 4850.9,
      "text": "是這幾個人全出現在咖啡館"
    },
    {
      "end": 4855.8,
      "start": 4854.4,
      "text": "這條路是傾斜的"
    },
    {
      "end": 4857.5,
      "start": 4856.2,
      "text": "我並不知道我們要去教堂"
    },
    {
      "end": 4859.7,
      "start": 4857.6,
      "text": "我並不知道我們要去教堂"
    },
    {
      "end": 4860.2,
      "start": 4859.7,
      "text": "說的啊"
    },
    {
      "end": 4861.7,
      "start": 4860.4,
      "text": "我只是跟著大家走"
    },
    {
      "end": 4863.6,
      "start": 4862.0,
      "text": "有樓梯我沒有進去教堂"
    },
    {
      "end": 4865.2,
      "start": 4863.9,
      "text": "我們到達華館的露台的時候"
    },
    {
      "end": 4866.0,
      "start": 4865.2,
      "text": "我們總是在壹起"
    },
    {
      "end": 4867.8,
      "start": 4866.1,
      "text": "我們在壹起散步距離很近"
    },
    {
      "end": 4868.8,
      "start": 4867.8,
      "text": "也許5至6米"
    },
    {
      "end": 4870.6,
      "start": 4869.0,
      "text": "主要是導遊和王先生在前面"
    },
    {
      "end": 4872.2,
      "start": 4870.6,
      "text": "然後我們王先生和他都在前面"
    },
    {
      "end": 4874.1,
      "start": 4872.2,
      "text": "對妳的問題王先生和我們說"
    },
    {
      "end": 4875.1,
      "start": 4874.1,
      "text": "我幫妳保存隱私"
    },
    {
      "end": 4876.3,
      "start": 4875.1,
      "text": "我們不黏著他"
    },
    {
      "end": 4877.3,
      "start": 4876.3,
      "text": "我們離的很遠"
    },
    {
      "end": 4877.9,
      "start": 4877.3,
      "text": "往上走"
    },
    {
      "end": 4882.8,
      "start": 4880.6,
      "text": "實際上他雙手按在了牆上"
    },
    {
      "end": 4885.5,
      "start": 4883.0,
      "text": "試圖在牆上抬上壹隻腳"
    },
    {
      "end": 4887.2,
      "start": 4885.7,
      "text": "我認為是左腳"
    },
    {
      "end": 4888.4,
      "start": 4887.4,
      "text": "但他不能"
    },
    {
      "end": 4889.9,
      "start": 4888.4,
      "text": "他又跌倒在腿上"
    },
    {
      "end": 4890.8,
      "start": 4889.9,
      "text": "他沒有跌倒"
    },
    {
      "end": 4891.9,
      "start": 4891.0,
      "text": "沒有摔倒啊"
    },
    {
      "end": 4893.4,
      "start": 4892.0,
      "text": "可能這翻譯有點錯誤啊"
    },
    {
      "end": 4894.4,
      "start": 4893.4,
      "text": "關於妳的問題"
    },
    {
      "end": 4896.2,
      "start": 4894.4,
      "text": "我回答王先生有70公斤什麽什麽"
    },
    {
      "end": 4897.1,
      "start": 4896.2,
      "text": "相當靈活"
    },
    {
      "end": 4898.8,
      "start": 4897.7,
      "text": "我們現在靠近"
    },
    {
      "end": 4900.9,
      "start": 4898.8,
      "text": "同時在兩隻手放在牆上"
    },
    {
      "end": 4902.6,
      "start": 4901.2,
      "text": "以征響自己的力量"
    },
    {
      "end": 4904.5,
      "start": 4903.0,
      "text": "他的腳靠在了牆上"
    },
    {
      "end": 4905.9,
      "start": 4904.7,
      "text": "他得到了支撐"
    },
    {
      "end": 4907.4,
      "start": 4906.5,
      "text": "有壹點打滑"
    },
    {
      "end": 4909.4,
      "start": 4907.4,
      "text": "然後他撐過將另一腳放在牆上頂部"
    },
    {
      "end": 4910.6,
      "start": 4909.4,
      "text": "然後剩下第二隻腳"
    },
    {
      "end": 4912.5,
      "start": 4910.7,
      "text": "他發現自己蹲在牆頂上"
    },
    {
      "end": 4913.1,
      "start": 4912.5,
      "text": "跌倒了"
    },
    {
      "end": 4914.3,
      "start": 4913.3,
      "text": "我只看到他背"
    },
    {
      "end": 4915.5,
      "start": 4914.3,
      "text": "然後再也看不到他了"
    },
    {
      "end": 4916.7,
      "start": 4915.9,
      "text": "還有什麽事不答應"
    },
    {
      "end": 4917.7,
      "start": 4916.7,
      "text": "我什麽也沒聽到"
    },
    {
      "end": 4919.5,
      "start": 4917.8,
      "text": "妳為什麽認為他跌倒了"
    },
    {
      "end": 4921.2,
      "start": 4919.6,
      "text": "對我來說他沒有法刹車"
    },
    {
      "end": 4922.7,
      "start": 4921.3,
      "text": "他把自己的動力所驅使"
    },
    {
      "end": 4923.5,
      "start": 4922.7,
      "text": "他跌倒的時候"
    },
    {
      "end": 4924.8,
      "start": 4923.5,
      "text": "我大約三或四米外"
    },
    {
      "end": 4926.2,
      "start": 4924.8,
      "text": "至於李寧先生和孫先生"
    },
    {
      "end": 4927.1,
      "start": 4926.4,
      "text": "他們離牆很近"
    },
    {
      "end": 4928.8,
      "start": 4927.1,
      "text": "我認為王先生並沒有任何接觸"
    },
    {
      "end": 4929.6,
      "start": 4929.0,
      "text": "實際上"
    },
    {
      "end": 4931.0,
      "start": 4929.6,
      "text": "妳看先給他拿洗地啊"
    },
    {
      "end": 4931.8,
      "start": 4931.0,
      "text": "沒任何接觸"
    },
    {
      "end": 4933.0,
      "start": 4932.0,
      "text": "實際上像我壹樣"
    },
    {
      "end": 4934.8,
      "start": 4933.2,
      "text": "當他們看到王先生第一次敗時"
    },
    {
      "end": 4935.8,
      "start": 4935.0,
      "text": "我們就接近他"
    },
    {
      "end": 4937.2,
      "start": 4935.8,
      "text": "為了試著幫助他"
    },
    {
      "end": 4938.6,
      "start": 4937.4,
      "text": "但是我們沒有時間"
    },
    {
      "end": 4940.1,
      "start": 4938.9,
      "text": "在走進這堂牆之前"
    },
    {
      "end": 4942.6,
      "start": 4940.1,
      "text": "王先生給王先生交給他的東西"
    },
    {
      "end": 4943.6,
      "start": 4942.6,
      "text": "他告訴妳"
    },
    {
      "end": 4944.7,
      "start": 4943.7,
      "text": "他打算做什麽"
    },
    {
      "end": 4946.9,
      "start": 4944.9,
      "text": "他的秘書孫先生"
    },
    {
      "end": 4949.0,
      "start": 4947.0,
      "text": "已經拿了他的個人物品"
    },
    {
      "end": 4950.6,
      "start": 4949.0,
      "text": "包電話燈"
    },
    {
      "end": 4954.7,
      "start": 4953.2,
      "text": "跳牆前把包和電話"
    },
    {
      "end": 4956.2,
      "start": 4955.2,
      "text": "交給了孫先生"
    },
    {
      "end": 4957.1,
      "start": 4956.2,
      "text": "孫景浩"
    },
    {
      "end": 4959.4,
      "start": 4957.6,
      "text": "然後財心說他是拍照"
    },
    {
      "end": 4962.7,
      "start": 4961.3,
      "text": "路德先生妳覺得這對嗎"
    },
    {
      "end": 4966.2,
      "start": 4964.5,
      "text": "他不是剛才說他沒有去教堂嗎"
    },
    {
      "end": 4968.0,
      "start": 4966.7,
      "text": "為啥這又剛才"
    },
    {
      "end": 4969.2,
      "start": 4968.2,
      "text": "第一次說沒去教堂"
    },
    {
      "end": 4970.5,
      "start": 4969.2,
      "text": "這又沒去過教堂"
    },
    {
      "end": 4971.3,
      "start": 4970.6,
      "text": "沒參與"
    },
    {
      "end": 4972.1,
      "start": 4971.3,
      "text": "也沒參與"
    },
    {
      "end": 4972.8,
      "start": 4972.2,
      "text": "頭壹天的晚"
    },
    {
      "end": 4973.8,
      "start": 4972.8,
      "text": "七月二晚餐"
    },
    {
      "end": 4975.3,
      "start": 4974.0,
      "text": "然後跟他去了"
    },
    {
      "end": 4976.5,
      "start": 4975.3,
      "text": "距離五六米"
    },
    {
      "end": 4977.5,
      "start": 4976.6,
      "text": "然後您"
    },
    {
      "end": 4978.7,
      "start": 4977.7,
      "text": "上牆前"
    },
    {
      "end": 4980.2,
      "start": 4978.8,
      "text": "搬著腿還把電話"
    },
    {
      "end": 4981.1,
      "start": 4980.4,
      "text": "那包給他"
    },
    {
      "end": 4982.2,
      "start": 4981.2,
      "text": "不是什麽人"
    },
    {
      "end": 4983.6,
      "start": 4982.2,
      "text": "路德先生妳在跳牆前"
    },
    {
      "end": 4985.3,
      "start": 4983.6,
      "text": "妳把包和電話給我叫給身邊的人"
    },
    {
      "end": 4986.5,
      "start": 4985.3,
      "text": "我都納悶了"
    },
    {
      "end": 4988.5,
      "start": 4987.8,
      "text": "我沒有聽到"
    },
    {
      "end": 4989.4,
      "start": 4988.5,
      "text": "我也看著風景"
    },
    {
      "end": 4990.1,
      "start": 4989.4,
      "text": "我的手機"
    },
    {
      "end": 4991.6,
      "start": 4990.1,
      "text": "王先生和妳分開是他在跑嗎"
    },
    {
      "end": 4992.1,
      "start": 4991.6,
      "text": "沒有"
    },
    {
      "end": 4993.6,
      "start": 4992.2,
      "text": "他走路正常走向牆壁"
    },
    {
      "end": 4994.4,
      "start": 4993.6,
      "text": "他什麽也沒說"
    },
    {
      "end": 4996.5,
      "start": 4994.4,
      "text": "他說是走路什麽都沒說"
    },
    {
      "end": 4997.8,
      "start": 4996.5,
      "text": "不是衝上牆壁"
    },
    {
      "end": 4998.2,
      "start": 4997.8,
      "text": "啊"
    },
    {
      "end": 4999.0,
      "start": 4998.2,
      "text": "往下走"
    },
    {
      "end": 5001.5,
      "start": 5000.3,
      "text": "這是田丁的"
    },
    {
      "end": 5003.8,
      "start": 5002.5,
      "text": "田丁的筆錄"
    },
    {
      "end": 5005.3,
      "start": 5003.8,
      "text": "旁邊都是法文"
    },
    {
      "end": 5007.8,
      "start": 5006.4,
      "text": "我想告訴大家的事情"
    },
    {
      "end": 5009.7,
      "start": 5008.0,
      "text": "妳們記住田丁說的"
    },
    {
      "end": 5011.5,
      "start": 5009.7,
      "text": "最早他說他沒參與"
    },
    {
      "end": 5012.6,
      "start": 5011.6,
      "text": "沒上教堂"
    },
    {
      "end": 5015.7,
      "start": 5013.1,
      "text": "第二他說他到了那咖啡廳下車"
    },
    {
      "end": 5016.8,
      "start": 5015.7,
      "text": "他不是到了咖啡廳"
    },
    {
      "end": 5018.5,
      "start": 5016.8,
      "text": "我會給妳們照片看"
    },
    {
      "end": 5019.7,
      "start": 5018.5,
      "text": "他進了咖啡廳"
    },
    {
      "end": 5021.5,
      "start": 5020.1,
      "text": "這就是那個第三組合"
    },
    {
      "end": 5023.2,
      "start": 5022.3,
      "text": "來來"
    },
    {
      "end": 5024.2,
      "start": 5023.2,
      "text": "又來了"
    },
    {
      "end": 5027.7,
      "start": 5027.1,
      "text": "哈哈"
    },
    {
      "end": 5028.2,
      "start": 5027.7,
      "text": "對對對"
    },
    {
      "end": 5029.2,
      "start": 5028.2,
      "text": "給他個麥"
    },
    {
      "end": 5030.9,
      "start": 5030.4,
      "text": "謝謝了"
    },
    {
      "end": 5036.1,
      "start": 5035.1,
      "text": "來來來我幫妳看"
    },
    {
      "end": 5040.6,
      "start": 5039.1,
      "text": "9點08分呢"
    },
    {
      "end": 5043.0,
      "start": 5040.6,
      "text": "這位姓陶的先生"
    },
    {
      "end": 5043.9,
      "start": 5043.0,
      "text": "應該是壹位先生"
    },
    {
      "end": 5044.8,
      "start": 5043.9,
      "text": "因為我看到的名字"
    },
    {
      "end": 5046.4,
      "start": 5044.8,
      "text": "他應該是壹位先生的名字"
    },
    {
      "end": 5048.6,
      "start": 5046.4,
      "text": "他從9點08分開始呢"
    },
    {
      "end": 5050.8,
      "start": 5048.6,
      "text": "每壹到兩分鐘就進行壹次"
    },
    {
      "end": 5053.9,
      "start": 5050.8,
      "text": "4500美金的壹個捐款"
    },
    {
      "end": 5055.6,
      "start": 5054.2,
      "text": "他的郵箱是壹個"
    },
    {
      "end": 5056.3,
      "start": 5055.6,
      "text": "Enjoy"
    },
    {
      "end": 5060.2,
      "start": 5056.3,
      "text": "然後後邊的內容我就不再去報"
    },
    {
      "end": 5061.1,
      "start": 5060.2,
      "text": "就透露了"
    },
    {
      "end": 5063.8,
      "start": 5061.1,
      "text": "然後他的手機號碼是壹個138國內的手機號碼"
    },
    {
      "end": 5064.3,
      "start": 5063.8,
      "text": "我牽到"
    },
    {
      "end": 5065.2,
      "start": 5064.3,
      "text": "這位先生呢"
    },
    {
      "end": 5066.3,
      "start": 5065.2,
      "text": "他特別特別的"
    },
    {
      "end": 5066.8,
      "start": 5066.3,
      "text": "妳說著"
    },
    {
      "end": 5067.8,
      "start": 5066.8,
      "text": "特別特別的"
    },
    {
      "end": 5069.5,
      "start": 5067.8,
      "text": "特殊這位姓陶的先生"
    },
    {
      "end": 5072.8,
      "start": 5069.5,
      "text": "這位先生已經在過去將近三個多月時間內"
    },
    {
      "end": 5078.8,
      "start": 5072.8,
      "text": "幾乎每個星期都會集中大筆的在我們的法治基金去捐款"
    },
    {
      "end": 5079.4,
      "start": 5078.8,
      "text": "整個法治基金"
    },
    {
      "end": 5083.0,
      "start": 5079.4,
      "text": "我是替法治基金在這裏去公布或者宣布這個事情"
    },
    {
      "end": 5084.4,
      "start": 5083.0,
      "text": "這位先生今天又來了"
    },
    {
      "end": 5086.7,
      "start": 5084.4,
      "text": "他是從早上9點08開始捐款的"
    },
    {
      "end": 5088.5,
      "start": 5086.7,
      "text": "每壹到兩分鐘4500美金"
    },
    {
      "end": 5089.5,
      "start": 5088.5,
      "text": "這個非常重要"
    },
    {
      "end": 5091.2,
      "start": 5089.5,
      "text": "給大家分享壹下"
    },
    {
      "end": 5092.9,
      "start": 5091.2,
      "text": "我原來在直播中說過"
    },
    {
      "end": 5093.3,
      "start": 5092.9,
      "text": "對"
    },
    {
      "end": 5094.3,
      "start": 5093.3,
      "text": "姓陶的這位先生"
    },
    {
      "end": 5096.2,
      "start": 5094.3,
      "text": "他是國內的138的壹個手機號碼"
    },
    {
      "end": 5098.1,
      "start": 5096.2,
      "text": "他的用箱裏邊是有壹個Enjoy"
    },
    {
      "end": 5098.9,
      "start": 5098.1,
      "text": "壹個英文詞"
    },
    {
      "end": 5100.2,
      "start": 5098.9,
      "text": "其他的我就不再公布了"
    },
    {
      "end": 5107.6,
      "start": 5100.2,
      "text": "然後9點17分的時候我們收到了1.04個Million美金的一個捐款"
    },
    {
      "end": 5109.2,
      "start": 5107.6,
      "text": "相當於是104萬美金"
    },
    {
      "end": 5110.7,
      "start": 5109.2,
      "text": "然後這個捐款呢"
    },
    {
      "end": 5112.5,
      "start": 5110.7,
      "text": "來自於壹家公司"
    },
    {
      "end": 5114.8,
      "start": 5112.5,
      "text": "就公司的壹個名字我就不說了"
    },
    {
      "end": 5116.2,
      "start": 5114.8,
      "text": "第二個字母的話"
    },
    {
      "end": 5117.7,
      "start": 5116.2,
      "text": "第二個單詞是叫Links"
    },
    {
      "end": 5119.5,
      "start": 5117.7,
      "text": "L-I-N-K-S"
    },
    {
      "end": 5123.2,
      "start": 5119.5,
      "text": "然後後邊的單詞是PTY.L-T-D"
    },
    {
      "end": 5125.9,
      "start": 5123.2,
      "text": "然後來自於Bank of New York Mellon"
    },
    {
      "end": 5127.7,
      "start": 5125.9,
      "text": "這應該是紐約的壹家地方的銀行"
    },
    {
      "end": 5128.7,
      "start": 5127.7,
      "text": "是104萬美金"
    },
    {
      "end": 5129.7,
      "start": 5128.7,
      "text": "這個可能有手續費"
    },
    {
      "end": 5130.5,
      "start": 5129.7,
      "text": "所以就扣掉了"
    },
    {
