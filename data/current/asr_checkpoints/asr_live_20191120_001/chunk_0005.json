  "segments": [
    {
      "end": 4502.0,
      "start": 4500.0,
      "text": "路德先生妳覺得有這種偶然嗎"
    },
    {
      "end": 4518.2,
      "start": 4515.6,
      "text": "再回到日本的那個情況下"
    },
    {
      "end": 4519.9,
      "start": 4518.4,
      "text": "親愛的兄弟姐妹們"
    },
    {
      "end": 4522.44,
      "start": 4520.44,
      "text": "妳們現在慎不慎的黃哥"
    },
    {
      "end": 4532.0,
      "start": 4530.0,
      "text": "黃店的長褲都長到了"
    },
    {
      "end": 4533.6,
      "start": 4532.0,
      "text": "哈哈哈哈"
    },
    {
      "end": 4534.6,
      "start": 4533.6,
      "text": "來來來"
    },
    {
      "end": 4537.2,
      "start": 4535.2,
      "text": "哎戰友們"
    },
    {
      "end": 4540.5,
      "start": 4538.9,
      "text": "我黃芳女士"
    },
    {
      "end": 4545.3,
      "start": 4541.4,
      "text": "妳拿走的這個衣服妳拿走的長褲妳拿走的T恤"
    },
    {
      "end": 4547.1,
      "start": 4545.8,
      "text": "妳是美國公民"
    },
    {
      "end": 4552.2,
      "start": 4548.0,
      "text": "妳敢把這東西銷毀妳在美國妳要蹲壹輩子的監獄"
    },
    {
      "end": 4556.2,
      "start": 4553.4,
      "text": "妳是跟殺人同罪的在美國刑法上查壹查"
    },
    {
      "end": 4561.7,
      "start": 4556.2,
      "text": "只要妳銷毀殺人證據是以殺人同罪的"
    },
    {
      "end": 4563.8,
      "start": 4562.9,
      "text": "這是妳拿走的"
    },
    {
      "end": 4566.3,
      "start": 4564.3,
      "text": "我壹會兒給妳展示妳拿走的文件"
    },
    {
      "end": 4567.9,
      "start": 4566.3,
      "text": "妳簽了名的"
    },
    {
      "end": 4570.4,
      "start": 4569.0,
      "text": "再下壹個短褲"
    },
    {
      "end": 4573.0,
      "start": 4571.7,
      "text": "妳的內褲"
    },
    {
      "end": 4576.8,
      "start": 4574.0,
      "text": "黃建的內褲沒把郭文貴的內褲給扒了"
    },
    {
      "end": 4578.4,
      "start": 4576.8,
      "text": "也沒把路德的內褲給扒了"
    },
    {
      "end": 4580.4,
      "start": 4578.6,
      "text": "那路德是壹個情人"
    },
    {
      "end": 4582.0,
      "start": 4580.5,
      "text": "郭文貴內褲壹扒開"
    },
    {
      "end": 4583.3,
      "start": 4582.3,
      "text": "壹點毛沒有"
    },
    {
      "end": 4587.2,
      "start": 4583.3,
      "text": "現在王建同志全都是毛啊"
    },
    {
      "end": 4589.1,
      "start": 4587.7,
      "text": "內褲再往下壹張"
    },
    {
      "end": 4592.2,
      "start": 4590.1,
      "text": "更誇張妳這個短褲還在上面"
    },
    {
      "end": 4594.4,
      "start": 4592.7,
      "text": "妳看待我下個彩色那個"
    },
    {
      "end": 4597.1,
      "start": 4595.1,
      "text": "妳看她這個對比下妳這個"
    },
    {
      "end": 4598.7,
      "start": 4597.9,
      "text": "待我下壹張"
    },
    {
      "end": 4600.5,
      "start": 4599.6,
      "text": "待我下壹張"
    },
    {
      "end": 4602.7,
      "start": 4601.2,
      "text": "妳這個也太瘋狂了"
    },
    {
      "end": 4606.0,
      "start": 4604.0,
      "text": "也戴眼鏡王建也戴眼鏡"
    },
    {
      "end": 4607.8,
      "start": 4606.4,
      "text": "膝蓋上拋著衫"
    },
    {
      "end": 4610.5,
      "start": 4608.3,
      "text": "我們查過這個衣服妳知道路德先生"
    },
    {
      "end": 4613.8,
      "start": 4610.5,
      "text": "這個衣服生產件數不超"
    },
    {
      "end": 4615.6,
      "start": 4613.8,
      "text": "全球不超過3000件"
    },
    {
      "end": 4619.8,
      "start": 4616.9,
      "text": "竟然出現了南普羅旺斯同壹時間"
    },
    {
      "end": 4623.4,
      "start": 4620.5,
      "text": "半小時以內戴著同壹個眼鏡"
    },
    {
      "end": 4625.5,
      "start": 4623.5,
      "text": "同壹個T恤同壹個褲子"
    },
    {
      "end": 4627.2,
      "start": 4625.5,
      "text": "內褲在這裏看不見啊"
    },
    {
      "end": 4628.1,
      "start": 4627.2,
      "text": "這看不見啊"
    },
    {
      "end": 4629.8,
      "start": 4628.8,
      "text": "出現在這"
    },
    {
      "end": 4632.6,
      "start": 4631.2,
      "text": "親愛的兄弟姐妹們"
    },
    {
      "end": 4634.6,
      "start": 4632.8,
      "text": "發生了什麽情況"
    },
    {
      "end": 4638.1,
      "start": 4636.0,
      "text": "這這這意味什麽難道說"
    },
    {
      "end": 4640.2,
      "start": 4638.4,
      "text": "這個日本人是踢死鬼"
    },
    {
      "end": 4642.4,
      "start": 4641.0,
      "text": "或者把他衣服給拔下來了"
    },
    {
      "end": 4643.3,
      "start": 4642.4,
      "text": "妳想知道嗎"
    },
    {
      "end": 4644.0,
      "start": 4643.3,
      "text": "捐錢啊"
    },
    {
      "end": 4648.0,
      "start": 4646.1,
      "text": "這個捐二百萬的戰友"
    },
    {
      "end": 4649.7,
      "start": 4648.1,
      "text": "他壹定會捐壹個億美元"
    },
    {
      "end": 4654.3,
      "start": 4651.4,
      "text": "他是被共產黨殘害最深的"
    },
    {
      "end": 4657.6,
      "start": 4655.1,
      "text": "通常要給我買壹個喜馬拉雅大使館的樓給我們"
    },
    {
      "end": 4659.2,
      "start": 4658.4,
      "text": "我拒絕了"
    },
    {
      "end": 4660.8,
      "start": 4659.3,
      "text": "昨天說文貴妳知道我捐多少"
    },
    {
      "end": 4662.0,
      "start": 4660.9,
      "text": "壹千萬我壹個人全捐了"
    },
    {
      "end": 4663.0,
      "start": 4662.0,
      "text": "我說妳別這樣"
    },
    {
      "end": 4664.9,
      "start": 4663.2,
      "text": "妳知道捐都沒意思了嗎"
    },
    {
      "end": 4665.4,
      "start": 4664.9,
      "text": "是吧"
    },
    {
      "end": 4666.4,
      "start": 4665.5,
      "text": "大家都捐"
    },
    {
      "end": 4667.5,
      "start": 4666.4,
      "text": "這是大家"
    },
    {
      "end": 4668.5,
      "start": 4667.6,
      "text": "大家在做飯"
    },
    {
      "end": 4670.3,
      "start": 4668.5,
      "text": "都添了這才財物吃的都香"
    },
    {
      "end": 4670.8,
      "start": 4670.3,
      "text": "對不對"
    },
    {
      "end": 4672.4,
      "start": 4670.8,
      "text": "妳都英文權了沒意思"
    },
    {
      "end": 4673.9,
      "start": 4672.9,
      "text": "這位朋友"
    },
    {
      "end": 4676.7,
      "start": 4674.8,
      "text": "就是王健曾經的好友"
    },
    {
      "end": 4678.7,
      "start": 4677.9,
      "text": "他說文貴"
    },
    {
      "end": 4679.9,
      "start": 4678.9,
      "text": "王健"
    },
    {
      "end": 4681.7,
      "start": 4680.2,
      "text": "這件事情告明白"
    },
    {
      "end": 4683.7,
      "start": 4683.2,
      "text": "!"
    },
    {
      "end": 4685.1,
      "start": 4683.7,
      "text": "證明盜國賊"
    },
    {
      "end": 4689.1,
      "start": 4685.6,
      "text": "我昨天跟妳說那個就是那些領導批示我給他看了壹下"
    },
    {
      "end": 4689.4,
      "start": 4689.1,
      "text": "嗯"
    },
    {
      "end": 4690.2,
      "start": 4689.4,
      "text": "他傻眼了"
    },
    {
      "end": 4692.1,
      "start": 4690.5,
      "text": "他今天我不會放"
    },
    {
      "end": 4696.0,
      "start": 4692.3,
      "text": "因為那個放了有人還沒出來壹看就知道誰給的啊"
    },
    {
      "end": 4698.5,
      "start": 4696.4,
      "text": "中央領導批示把這些文件"
    },
    {
      "end": 4701.1,
      "start": 4699.2,
      "text": "畢為國家最高機密"
    },
    {
      "end": 4704.6,
      "start": 4702.2,
      "text": "政法委書記和公安部長"
    },
    {
      "end": 4709.1,
      "start": 4705.4,
      "text": "和國家安全委員會辦公主任聯合簽名才能約"
    },
    {
      "end": 4709.9,
      "start": 4709.1,
      "text": "啊"
    },
    {
      "end": 4710.9,
      "start": 4709.9,
      "text": "啊"
    },
    {
      "end": 4711.9,
      "start": 4710.9,
      "text": "為啥絕密啊"
    },
    {
      "end": 4714.5,
      "start": 4713.4,
      "text": "其中壹條就說到了"
    },
    {
      "end": 4716.0,
      "start": 4714.7,
      "text": "絕不能英王健案"
    },
    {
      "end": 4720.3,
      "start": 4716.2,
      "text": "暴露在美國所有的我們的關心狂"
    },
    {
      "end": 4723.4,
      "start": 4722.7,
      "text": "厲害吧"
    },
    {
      "end": 4724.8,
      "start": 4724.0,
      "text": "大家看看"
    },
    {
      "end": 4726.2,
      "start": 4725.6,
      "text": "厲害吧"
    },
    {
      "end": 4728.8,
      "start": 4727.2,
      "text": "行了說到這兒我們接著下壹個"
    },
    {
      "end": 4731.0,
      "start": 4728.9,
      "text": "天丁還不記得回到天丁的口供來"
    },
    {
      "end": 4732.9,
      "start": 4731.6,
      "text": "回到天丁的口供啊"
    },
    {
      "end": 4737.2,
      "start": 4735.6,
      "text": "這壹點打亂妳們抱歉啊"
    },
    {
      "end": 4738.8,
      "start": 4737.2,
      "text": "妳們應該有心裏準備"
    },
    {
      "end": 4740.3,
      "start": 4738.8,
      "text": "這不打亂妳不叫郭文貴吧"
    },
    {
      "end": 4745.3,
      "start": 4744.4,
      "text": "我們壹會兒再看這視頻"
    },
    {
      "end": 4745.9,
      "start": 4745.3,
      "text": "好"
    },
    {
      "end": 4747.4,
      "start": 4746.6,
      "text": "我可以吧"
    },
    {
      "end": 4750.1,
      "start": 4747.9,
      "text": "我們再看這個卷中啊"
    },
    {
      "end": 4754.4,
      "start": 4752.2,
      "text": "壹輛車上是孫"
    },
    {
      "end": 4756.6,
      "start": 4755.9,
      "text": "和華"
    },
    {
      "end": 4759.7,
      "start": 4757.6,
      "text": "第二輛車上有李寧和我"
    },
    {
      "end": 4763.0,
      "start": 4761.8,
      "text": "孫和華斌"
    },
    {
      "end": 4765.6,
      "start": 4763.0,
      "text": "王健他119是王健"
    },
    {
      "end": 4767.9,
      "start": 4765.6,
      "text": "華呆在車裏其他所有人都出現"
