  "segments": [
    {
      "end": 11701.98,
      "start": 11700.0,
      "text": "粉条和这个蘑菇的故事嘛"
    },
    {
      "end": 11703.74,
      "start": 11701.98,
      "text": "现在这还有下文"
    },
    {
      "end": 11705.76,
      "start": 11703.74,
      "text": "不光说买粉条的时候"
    },
    {
      "end": 11706.78,
      "start": 11705.76,
      "text": "猪要跑"
    },
    {
      "end": 11708.5,
      "start": 11706.78,
      "text": "猪刚刚要跑"
    },
    {
      "end": 11709.44,
      "start": 11708.5,
      "text": "他的饲养员"
    },
    {
      "end": 11710.52,
      "start": 11709.44,
      "text": "主人说你跑啥"
    },
    {
      "end": 11712.84,
      "start": 11710.52,
      "text": "说你买粉条要炖我了"
    },
    {
      "end": 11716.02,
      "start": 11712.84,
      "text": "主人说别听海外这些人的忽悠"
    },
    {
      "end": 11717.92,
      "start": 11716.02,
      "text": "我们现在改配方了"
    },
    {
      "end": 11719.48,
      "start": 11717.92,
      "text": "是要粉条炖鸡"
    },
    {
      "end": 11719.86,
      "start": 11719.48,
      "text": "你放心"
    },
    {
      "end": 11721.62,
      "start": 11719.86,
      "text": "肯定不是你这次"
    },
    {
      "end": 11723.0,
      "start": 11721.62,
      "text": "所以说呀"
    },
    {
      "end": 11724.8,
      "start": 11723.0,
      "text": "这些所有的民营企业家"
    },
    {
      "end": 11725.82,
      "start": 11724.8,
      "text": "一想也对啊"
    },
    {
      "end": 11726.52,
      "start": 11725.82,
      "text": "要相信党"
    },
    {
      "end": 11728.04,
      "start": 11726.52,
      "text": "全部留在国内"
    },
    {
      "end": 11729.9,
      "start": 11728.04,
      "text": "人家去买粉条了"
    },
    {
      "end": 11731.54,
      "start": 11729.9,
      "text": "你还在相信要去炖鸡"
    },
    {
      "end": 11732.66,
      "start": 11731.54,
      "text": "这里边就要说"
    },
    {
      "end": 11734.02,
      "start": 11732.66,
      "text": "木齐中出狱的时候"
    },
    {
      "end": 11735.68,
      "start": 11734.02,
      "text": "他还觉得他在北京"
    },
    {
      "end": 11737.34,
      "start": 11735.68,
      "text": "有264套房子呢"
    },
    {
      "end": 11739.58,
      "start": 11737.34,
      "text": "还在这算计价值10亿多"
    },
    {
      "end": 11740.98,
      "start": 11739.58,
      "text": "还要募捐一"
    },
    {
      "end": 11742.76,
      "start": 11740.98,
      "text": "募集1000亿的资产"
    },
    {
      "end": 11743.82,
      "start": 11742.76,
      "text": "东山再起"
    },
    {
      "end": 11744.98,
      "start": 11743.82,
      "text": "他出来以后他发现"
    },
    {
      "end": 11746.86,
      "start": 11744.98,
      "text": "他一套房子都没有了"
    },
    {
      "end": 11748.76,
      "start": 11746.86,
      "text": "还有在狱里的这个"
    },
    {
      "end": 11750.5,
      "start": 11748.76,
      "text": "整个的这个叫"
    },
    {
      "end": 11752.4,
      "start": 11750.5,
      "text": "黄光狱"
    },
    {
      "end": 11753.54,
      "start": 11752.4,
      "text": "他还做梦"
    },
    {
      "end": 11756.08,
      "start": 11753.54,
      "text": "觉得有这个两三百亿的资产"
    },
    {
      "end": 11758.44,
      "start": 11756.08,
      "text": "你早就被安排好"
    },
    {
      "end": 11760.08,
      "start": 11758.44,
      "text": "下一道的菜谱里了"
    },
    {
      "end": 11761.2,
      "start": 11760.08,
      "text": "所以说呀"
    },
    {
      "end": 11764.56,
      "start": 11761.2,
      "text": "中共的这些忽悠的这些"
    },
    {
      "end": 11767.56,
      "start": 11764.56,
      "text": "挡着粉条炖鸡的这些猪们"
    },
    {
      "end": 11770.26,
      "start": 11767.56,
      "text": "还在那做着侥幸的发财梦"
    },
    {
      "end": 11771.4,
      "start": 11770.26,
      "text": "和保财梦"
    },
    {
      "end": 11772.38,
      "start": 11771.4,
      "text": "看看王健"
    },
    {
      "end": 11774.6,
      "start": 11772.38,
      "text": "看看所有被宰的这些猪"
    },
    {
      "end": 11775.94,
      "start": 11774.6,
      "text": "都是怎么被忽悠上"
    },
    {
      "end": 11776.72,
      "start": 11775.94,
      "text": "站板上"
    },
    {
      "end": 11778.28,
      "start": 11776.72,
      "text": "自己蹦蹦跳跳"
    },
    {
      "end": 11778.98,
      "start": 11778.28,
      "text": "唱着歌"
    },
    {
      "end": 11780.84,
      "start": 11778.98,
      "text": "冲到了厨房去的"
    },
    {
      "end": 11782.0,
      "start": 11780.84,
      "text": "好的"
    },
    {
      "end": 11782.5,
      "start": 11782.0,
      "text": "孟贵先生"
    },
    {
      "end": 11783.6,
      "start": 11782.5,
      "text": "我就想做这些"
    },
    {
      "end": 11784.12,
      "start": 11783.6,
      "text": "谢谢"
    },
    {
      "end": 11787.68,
      "start": 11784.12,
      "text": "咱们江蔡生讲的非常好"
    },
    {
      "end": 11789.78,
      "start": 11787.68,
      "text": "各位是江蔡生搞金融的"
    },
    {
      "end": 11790.8,
      "start": 11789.78,
      "text": "我坐这了"
    },
    {
      "end": 11792.4,
      "start": 11790.8,
      "text": "搞金融的人"
    },
    {
      "end": 11794.64,
      "start": 11792.4,
      "text": "这个当你搞金融的人"
    },
    {
      "end": 11795.98,
      "start": 11794.64,
      "text": "看到这些事的时候"
    },
    {
      "end": 11798.82,
      "start": 11795.98,
      "text": "你就知道他们做杀人"
    },
    {
      "end": 11800.16,
      "start": 11798.82,
      "text": "为什么在法国杀"
    },
    {
      "end": 11803.36,
      "start": 11800.16,
      "text": "他们是要拿钱的"
    },
    {
      "end": 11805.94,
      "start": 11803.36,
      "text": "那天谁去他房间"
    },
    {
      "end": 11807.82,
      "start": 11805.94,
      "text": "在他房间里拿走"
    },
    {
      "end": 11809.16,
      "start": 11807.82,
      "text": "签的合同是什么"
    },
    {
      "end": 11813.04,
      "start": 11809.16,
      "text": "王健为什么在T恤衫上"
    },
    {
      "end": 11814.94,
      "start": 11813.04,
      "text": "是跟这个日本是一样"
    },
    {
      "end": 11819.54,
      "start": 11814.94,
      "text": "我们接下来还有五大谜团要解开"
    },
    {
      "end": 11822.56,
      "start": 11819.54,
      "text": "这六万张之后我还都没看"
    },
    {
      "end": 11824.46,
      "start": 11822.56,
      "text": "我连六千张也没看了"
    },
    {
      "end": 11825.9,
      "start": 11824.46,
      "text": "第一个"
    },
    {
      "end": 11829.5,
      "start": 11825.9,
      "text": "这个日本人的T恤怎么跑到王健身上去"
    },
    {
      "end": 11831.7,
      "start": 11829.5,
      "text": "我们要搞明白"
    },
    {
      "end": 11833.18,
      "start": 11831.7,
      "text": "第二个"
    },
    {
      "end": 11835.26,
      "start": 11833.18,
      "text": "王健在西雅图的尸体"
    },
    {
      "end": 11837.94,
      "start": 11835.26,
      "text": "他必须要重新要开棺验尸"
    },
    {
      "end": 11839.7,
      "start": 11837.94,
      "text": "第三个"
    },
    {
      "end": 11842.3,
      "start": 11839.7,
      "text": "这些账上的钱最后去了哪里"
    },
    {
      "end": 11844.06,
      "start": 11842.3,
      "text": "第四个"
    },
    {
      "end": 11847.28,
      "start": 11844.06,
      "text": "法国人是怎么接受他们的贿赂"
    },
    {
      "end": 11848.22,
      "start": 11847.28,
      "text": "造这些假的"
    },
    {
      "end": 11849.5,
      "start": 11848.22,
      "text": "第五个"
    },
    {
      "end": 11851.92,
      "start": 11849.5,
      "text": "美国必须行事礼案"
    },
    {
      "end": 11855.12,
      "start": 11851.92,
      "text": "让杨光 让冠军 让刘成杰"
    },
    {
      "end": 11858.36,
      "start": 11855.12,
      "text": "让孙瑶 让黄芳"
    },
    {
      "end": 11861.74,
      "start": 11858.36,
      "text": "让陈峰"
    },
    {
      "end": 11863.9,
      "start": 11861.74,
      "text": "让陈峰的儿子陈晓峰"
    },
    {
      "end": 11866.84,
      "start": 11863.9,
      "text": "在美国接受刑事调查"
    },
    {
      "end": 11872.24,
      "start": 11866.84,
      "text": "这五大招少一招都不行"
    },
    {
      "end": 11875.48,
      "start": 11872.24,
      "text": "我刚才说的事儿"
    },
    {
      "end": 11877.14,
      "start": 11875.48,
      "text": "你都当成我自己造的"
    },
    {
      "end": 11879.2,
      "start": 11877.14,
      "text": "跟都没关系"
    },
    {
      "end": 11883.88,
      "start": 11879.2,
      "text": "王岸之死的答案今天没有"
    },
    {
      "end": 11891.44,
      "start": 11883.88,
      "text": "王健之死的答案只有在以上五个条件的满足下"
    },
    {
      "end": 11894.28,
      "start": 11891.44,
      "text": "才能算是搞清楚"
    },
    {
      "end": 11898.04,
      "start": 11894.28,
      "text": "为什么文贵要等到一年"
    },
    {
      "end": 11900.58,
      "start": 11898.04,
      "text": "因为这件事儿太大了"
    },
    {
      "end": 11901.98,
      "start": 11900.58,
      "text": "哎呦我的娘了这么多钱"
    },
    {
      "end": 11906.08,
      "start": 11901.98,
      "text": "这为什么是这样"
    },
    {
      "end": 11909.48,
      "start": 11906.08,
      "text": "因为战友们都是大智慧的人"
    },
    {
      "end": 11911.92,
      "start": 11909.48,
      "text": "我们提前报没用"
    },
    {
      "end": 11915.32,
      "start": 11911.92,
      "text": "我们材料不全没用"
    },
    {
      "end": 11920.22,
      "start": 11915.32,
      "text": "我们要不让他们心服口服没用"
    },
    {
      "end": 11923.48,
      "start": 11920.22,
      "text": "我们不要把不把王岐山还有孟建柱"
    },
    {
      "end": 11928.88,
      "start": 11923.48,
      "text": "还有那个孟宏伟这些人黑手给弄清楚没用"
    },
    {
      "end": 11931.88,
      "start": 11928.88,
      "text": "王健到这死能死"
    },
    {
      "end": 11934.08,
      "start": 11931.88,
      "text": "我告诉大家我50%怀疑他没死"
    },
    {
      "end": 11938.88,
      "start": 11934.08,
      "text": "今天晚上王健可能给我们捐100亿美元"
    },
    {
      "end": 11940.88,
      "start": 11938.88,
      "text": "我们明天说哎呀不知道"
    },
    {
      "end": 11944.08,
      "start": 11940.88,
      "text": "王健有50%可能没死"
    },
    {
      "end": 11949.68,
      "start": 11944.08,
      "text": "但是王健把很多人给保下来了"
    },
    {
      "end": 11951.68,
      "start": 11949.68,
      "text": "王健你在哪呢要没死"
    },
    {
      "end": 11954.18,
      "start": 11951.68,
      "text": "王健能在哪我都能想到"
    },
    {
      "end": 11957.28,
      "start": 11954.18,
      "text": "如果王健要是真死了"
    },
    {
      "end": 11959.58,
      "start": 11957.28,
      "text": "王健的故事刚刚开始"
    },
    {
      "end": 11963.28,
      "start": 11959.58,
      "text": "因为王健一定会留下很多东西"
    },
    {
      "end": 11966.28,
      "start": 11963.28,
      "text": "这个案子不再重新调查是不可能的"
    },
    {
      "end": 11969.08,
      "start": 11966.28,
      "text": "美国也调查法国也得调查"
    },
    {
      "end": 11970.58,
      "start": 11969.08,
      "text": "我可以负责任告诉你们"
    },
    {
      "end": 11973.88,
      "start": 11970.58,
      "text": "法国会全国人民都会要把事整明白的"
    },
    {
      "end": 11977.38,
      "start": 11975.18,
      "text": "只要一个人说我撒了谎"
    },
    {
      "end": 11978.68,
      "start": 11977.38,
      "text": "谁让我撒了谎"
    },
    {
      "end": 11979.88,
      "start": 11978.68,
      "text": "这个事就大了"
    },
    {
      "end": 11981.78,
      "start": 11980.48,
      "text": "对吧路德先生"
    },
    {
      "end": 11983.08,
      "start": 11982.08,
      "text": "你想想"
    },
    {
      "end": 11985.28,
      "start": 11983.18,
      "text": "一个法国人想说这是我造假了"
    },
    {
      "end": 11989.28,
      "start": 11985.78,
      "text": "或者周天天说我造假了"
    },
    {
      "end": 11990.18,
      "start": 11989.28,
      "text": "谁让你造假"
    },
    {
      "end": 11991.18,
      "start": 11990.18,
      "text": "为什么造假"
    },
    {
      "end": 11992.78,
      "start": 11991.18,
      "text": "一切从头来"
    },
    {
      "end": 11998.28,
      "start": 11994.88,
      "text": "这个王健之死事大了去了"
    },
    {
      "end": 12001.58,
      "start": 11998.28,
      "text": "法国和美国能愿意吗"
    },
    {
      "end": 12004.58,
      "start": 12001.58,
      "text": "设计到瑞士银行美国炸弹银行美国能愿意吗"
    },
    {
      "end": 12005.58,
      "start": 12004.58,
      "text": "设计到瑞士银行美国炸弹银行美国能愿意吗"
    },
    {
      "end": 12011.48,
      "start": 12009.58,
      "text": "如果王健是炸死"
    },
    {
      "end": 12014.58,
      "start": 12011.48,
      "text": "把他把美国法国中国全骗了"
    },
    {
      "end": 12016.08,
      "start": 12014.58,
      "text": "那太牛了"
    },
    {
      "end": 12017.88,
      "start": 12016.08,
      "text": "那个日本人去哪了"
    },
    {
      "end": 12019.38,
      "start": 12017.88,
      "text": "日本人是不是死了呀"
    },
    {
      "end": 12020.38,
      "start": 12019.38,
      "text": "那肯定是日本人死了呀"
    },
    {
      "end": 12023.88,
      "start": 12020.38,
      "text": "从停时间到验尸房"
    },
    {
      "end": 12026.88,
      "start": 12023.88,
      "text": "我们查了这个所谓的验尸观"
    },
    {
      "end": 12029.38,
      "start": 12026.88,
      "text": "这完全是胡扯八道的"
    },
    {
      "end": 12031.88,
      "start": 12029.38,
      "text": "名不见经不乱的那个主"
    },
    {
      "end": 12038.38,
      "start": 12035.38,
      "text": "然后是我们爆料导致了重新做笔录"
    },
    {
      "end": 12041.68,
      "start": 12038.38,
      "text": "孟宏伟全面协调"
    },
    {
      "end": 12043.88,
      "start": 12041.68,
      "text": "最后把协调的孟宏伟也给做掉了"
    },
    {
      "end": 12048.18,
      "start": 12045.58,
      "text": "这不是15亿的事才能有这个动力"
    },
    {
      "end": 12049.68,
      "start": 12048.18,
      "text": "广15亿是不可能的"
    },
    {
      "end": 12052.68,
      "start": 12051.98,
      "text": "对吧"
    },
    {
      "end": 12056.18,
      "start": 12053.28,
      "text": "今天咱们战友赚了大概有1000多万了吗"
    },
    {
      "end": 12057.68,
      "start": 12056.18,
      "text": "大概多少1000多万啊"
    },
    {
      "end": 12059.68,
      "start": 12058.38,
      "text": "跟人家的钱比上啥呀"
    },
    {
      "end": 12062.18,
      "start": 12060.28,
      "text": "零头零头"
    },
    {
      "end": 12063.48,
      "start": 12062.48,
      "text": "四四岁啦"
    },
    {
      "end": 12067.18,
      "start": 12065.58,
      "text": "他们拿走了中国多少钱"
    },
    {
      "end": 12069.68,
      "start": 12067.18,
      "text": "你看看中国的老板都被干掉了"
    },
    {
      "end": 12072.18,
      "start": 12069.68,
      "text": "马云什么马化腾什么王健"
    },
    {
      "end": 12073.48,
      "start": 12072.18,
      "text": "海航还在那呢"
    },
    {
      "end": 12075.98,
      "start": 12074.28,
      "text": "海航欠了多少钱"
