      "text": "字幕志愿者 李宗盛"
    },
    {
      "end": 7570.72,
      "start": 7568.72,
      "text": "李宗盛 李宗盛"
    },
    {
      "end": 7571.72,
      "start": 7570.72,
      "text": "哎呦 木蘭啊"
    },
    {
      "end": 7572.72,
      "start": 7571.72,
      "text": "哎呦 我木蘭妹妹來了"
    },
    {
      "end": 7574.72,
      "start": 7572.72,
      "text": "哎呦 我打起精神"
    },
    {
      "end": 7576.72,
      "start": 7574.72,
      "text": "木蘭妹妹好 你在線嗎"
    },
    {
      "end": 7581.72,
      "start": 7579.72,
      "text": "哎 七哥好 七哥好"
    },
    {
      "end": 7582.72,
      "start": 7581.72,
      "text": "能聽到我嗎"
    },
    {
      "end": 7584.72,
      "start": 7582.72,
      "text": "哎呦 哇 你的聲音又出現"
    },
    {
      "end": 7586.72,
