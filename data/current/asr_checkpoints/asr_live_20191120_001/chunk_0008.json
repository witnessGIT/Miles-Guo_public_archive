    },
    {
      "end": 7418.86,
      "start": 7416.28,
      "text": "妳前天說自己根本沒到教堂"
    },
    {
      "end": 7421.0,
      "start": 7418.86,
      "text": "然後相距5米"
    },
    {
      "end": 7424.9,
      "start": 7421.0,
      "text": "然後李寧和孫景奧都相隔5米"
    },
    {
      "end": 7428.0,
      "start": 7424.9,
      "text": "然後他們說從來沒有不知道"
    },
    {
      "end": 7431.68,
      "start": 7428.0,
      "text": "王健和他們都不知道牆的那邊還有那麽深"
    },
    {
      "end": 7435.78,
      "start": 7431.68,
      "text": "然後呢王寧說我希望他摔到一個平臺上"
    },
    {
      "end": 7438.28,
      "start": 7435.78,
      "text": "妳既然不知道那麽深妳怎麽知道那有平臺啊"
    },
    {
      "end": 7442.28,
      "start": 7438.28,
      "text": "妳既然沒俱樂教堂妳幹嘛出現在那裏照片啊"
    },
    {
      "end": 7444.28,
      "start": 7442.28,
      "text": "妳為什麽做兩次筆錄啊"
    },
    {
      "end": 7446.28,
      "start": 7444.28,
      "text": "兩次筆錄完全不壹樣啊"
    },
    {
      "end": 7449.28,
      "start": 7446.28,
      "text": "妳為什麽妳們參加了晚餐不說在壹起參加晚餐呢"
    },
    {
      "end": 7452.28,
      "start": 7449.28,
      "text": "妳為什麽王健認識妳不敢承認妳倆認識啊"
    },
    {
      "end": 7453.28,
      "start": 7452.28,
      "text": "妳倆認識啊"
    },
    {
      "end": 7456.28,
      "start": 7454.28,
      "text": "什麽意思啊戰友們"
    },
    {
      "end": 7461.28,
      "start": 7459.28,
      "text": "關於所安靜沒有往上走"
    },
    {
      "end": 7463.28,
      "start": 7462.28,
      "text": "走"
    },
    {
      "end": 7464.28,
      "start": 7463.28,
      "text": "走"
    },
    {
      "end": 7465.28,
      "start": 7464.28,
      "text": "好"
    },
    {
      "end": 7467.28,
      "start": 7465.28,
      "text": "咱們下個節目"
    },
    {
      "end": 7469.28,
      "start": 7467.28,
      "text": "下個節目"
    },
    {
      "end": 7470.28,
      "start": 7469.28,
      "text": "下個節目"
    },
    {
      "end": 7471.28,
      "start": 7470.28,
      "text": "越說越弧度啦"
    },
    {
      "end": 7472.28,
      "start": 7471.28,
      "text": "越說越有意思啦"
    },
    {
      "end": 7473.28,
      "start": 7472.28,
      "text": "哎"
    },
    {
      "end": 7474.28,
      "start": 7473.28,
      "text": "啊"
    },
    {
      "end": 7475.28,
