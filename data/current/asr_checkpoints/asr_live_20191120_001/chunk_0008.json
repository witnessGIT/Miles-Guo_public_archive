    },
    {
      "end": 7477.28,
      "start": 7476.28,
      "text": "撥片"
    },
    {
      "end": 7479.28,
      "start": 7477.28,
      "text": "我以為妳要掛檔呢撥片"
    },
    {
      "end": 7480.28,
      "start": 7479.28,
      "text": "那就撥片吧"
    },
    {
      "end": 7481.28,
      "start": 7480.28,
      "text": "呵呵呵"
    },
    {
      "end": 7483.28,
      "start": 7481.28,
      "text": "哎呀真好"
    },
    {
      "end": 7484.28,
      "start": 7483.28,
      "text": "戰友們"
    },
    {
      "end": 7487.28,
      "start": 7484.28,
      "text": "妳們看啥感覺妳們得趕快看看這個華盛頓還得"
    },
    {
      "end": 7489.28,
