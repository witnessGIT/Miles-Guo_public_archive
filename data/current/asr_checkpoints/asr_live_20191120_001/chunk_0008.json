  "segments": [
    {
      "end": 7203.14,
      "start": 7200.0,
      "text": "因素相反把因素碾碎了"
    },
    {
      "end": 7206.28,
      "start": 7203.14,
      "text": "包括王先生在那時候都為這種誤解而大笑"
    },
    {
      "end": 7210.4,
      "start": 7207.22,
      "text": "說沒有王健很輕鬆很開心啊"
    },
    {
      "end": 7214.08,
      "start": 7211.42,
      "text": "然後我繼續向王先生發表對普羅王子的評論"
    },
    {
      "end": 7216.7,
      "start": 7214.08,
      "text": "特別因素和熏語場的主題王先生什麽也沒說"
    },
    {
      "end": 7218.22,
      "start": 7216.7,
      "text": "我不知道他是否有興趣"
    },
    {
      "end": 7221.68,
      "start": 7218.22,
      "text": "見課之後當我仍在王先生說關於出名熏語場的英雄話時"
    },
    {
      "end": 7225.22,
      "start": 7221.68,
      "text": "他沒有對我說什麽在他大約離我們至少兩臂住時"
    },
    {
      "end": 7227.06,
      "start": 7225.22,
      "text": "他跑起來衝向牆"
    },
    {
      "end": 7229.1,
      "start": 7227.06,
      "text": "我不明白發什麽而且很快"
    },
    {
      "end": 7231.62,
      "start": 7229.1,
      "text": "為了回答您的問題王先生一下就從雙腳上"
    },
    {
      "end": 7234.08,
      "start": 7231.62,
      "text": "雙腳上了牆上但他並沒有保持平衡"
    },
    {
      "end": 7235.98,
      "start": 7234.08,
      "text": "在那時不遠處的後來就說"
    },
    {
      "end": 7239.32,
      "start": 7235.98,
      "text": "哦老闆在著疑問的表情好像是想問他做什麽"
    },
    {
      "end": 7244.16,
      "start": 7239.32,
      "text": "王先生沒有回答在這些助手說了幾句話後"
    },
    {
      "end": 7245.78,
      "start": 7244.16,
      "text": "他的倒塌就立法上了"
    },
    {
      "end": 7249.38,
      "start": 7245.78,
      "text": "因爲他的倒下就翻譯有問題啊"
    },
    {
      "end": 7252.38,
      "start": 7249.38,
      "text": "走您能像我瞄著王先生跌倒了這些牆身體知識嗎"
    },
    {
      "end": 7256.32,
      "start": 7252.38,
      "text": "據我的記憶他並沒有全說自己就是很硬"
    },
    {
      "end": 7258.12,
      "start": 7256.32,
      "text": "而他應該處於半蹲狀態"
    },
    {
      "end": 7260.12,
      "start": 7258.12,
      "text": "王先生跌倒之前壹刻在牆上臉什麽樣"
    },
    {
      "end": 7261.34,
      "start": 7260.12,
      "text": "妳答我沒看到他"
    },
    {
      "end": 7263.7,
      "start": 7261.34,
      "text": "您的記憶到第二天這時候王先生住手離他最遠"
    },
    {
      "end": 7264.26,
      "start": 7263.7,
      "text": "這住手離他最遠這住手"
    },
    {
      "end": 7265.0,
      "start": 7264.26,
      "text": "問到王先生嗎"
    },
    {
      "end": 7268.42,
      "start": 7265.26,
      "text": "他們離他很近相距甚至不到壹米"
    },
    {
      "end": 7276.22,
      "start": 7270.4,
      "text": "和田丁和李寧和孫景浩說的五米和六米和兩米都是不對的"
    },
    {
      "end": 7280.6,
      "start": 7276.22,
      "text": "我無法回答妳的問題如果他們能夠在王先生教之前觸摸到他"
    },
    {
      "end": 7282.3,
      "start": 7280.6,
      "text": "王先生教室是否我和他喊大叫"
    },
    {
      "end": 7285.86,
      "start": 7282.3,
      "text": "王先生跌倒是沒有尖叫甚至沒有說話妳叫了嗎"
    },
    {
      "end": 7288.0,
      "start": 7285.86,
      "text": "是的我和王先生住手在跌倒是大喊大叫"
    },
    {
      "end": 7291.5,
      "start": 7288.0,
      "text": "跌倒沒有大喊大叫我又和他大喊大叫"
    },
    {
      "end": 7294.52,
      "start": 7291.5,
      "text": "跌倒後發生什麽王先生住手很快就去了他下落地點"
    },
    {
      "end": 7297.64,
      "start": 7294.52,
      "text": "並請求我去叫壹輛小巴開過來所以我離開"
    },
    {
      "end": 7299.54,
      "start": 7297.64,
      "text": "然後留下住手在王先生現場"
    },
    {
      "end": 7300.94,
      "start": 7299.54,
      "text": "在王先生跌倒是沒有死"
    },
    {
      "end": 7303.04,
      "start": 7300.94,
      "text": "我知的抱怨說他又腿疼"
    },
    {
      "end": 7305.94,
      "start": 7303.04,
      "text": "尤其是要求他的住手幫助他坐起來"
    },
    {
      "end": 7308.06,
      "start": 7305.94,
      "text": "當消防員趕到現場後他死了"
    },
    {
      "end": 7309.26,
      "start": 7308.06,
      "text": "我了解到王先生住手"
    },
    {
      "end": 7313.26,
      "start": 7309.26,
      "text": "我天天曾經試圖用針灸血位和中藥救王先生"
    },
    {
      "end": 7315.56,
      "start": 7314.12,
      "text": "再發生一下幾下情況"
    },
    {
      "end": 7317.26,
      "start": 7315.56,
      "text": "王曼妳所提到的他的住手"
    },
    {
      "end": 7318.92,
      "start": 7317.26,
      "text": "尤其是他可能說什麽"
    },
    {
      "end": 7321.46,
      "start": 7318.92,
      "text": "我什麽是一個重強的他們會發唆"
    },
    {
      "end": 7323.06,
      "start": 7321.46,
      "text": "妳什麽這個有點犯意問題啊"
    },
    {
      "end": 7326.26,
      "start": 7323.76,
      "text": "考慮過王先生提出談話我不知道他能做什麽"
    },
    {
      "end": 7328.26,
      "start": 7326.26,
      "text": "去妳介紹王健有事例問題沒有"
    },
    {
      "end": 7331.64,
      "start": 7329.2,
      "text": "他說是吧他九年也沒有九星什麽的"
    },
    {
      "end": 7333.56,
      "start": 7331.64,
      "text": "妳的介紹王先生提到的就跑向牆"
    },
    {
      "end": 7336.58,
      "start": 7334.66,
      "text": "我的第一印象是不想看全景"
    },
    {
      "end": 7338.04,
      "start": 7336.58,
      "text": "我想說到現在高度去看"
    },
    {
      "end": 7339.78,
      "start": 7338.04,
      "text": "但另一方面我對此表示懷疑"
    },
    {
      "end": 7341.4,
      "start": 7339.78,
      "text": "我對此表示懷疑"
    },
    {
      "end": 7342.92,
      "start": 7341.4,
      "text": "因為正如之前我告訴過妳"
    },
    {
      "end": 7344.88,
      "start": 7342.92,
      "text": "我和王健的兩個都曾經在這個特定的地方"
    },
    {
      "end": 7346.34,
      "start": 7344.88,
      "text": "看過這條全景圖"
    },
    {
      "end": 7351.28,
      "start": 7348.02,
      "text": "這壹段就是他和王健看過這裏了"
    },
    {
      "end": 7352.78,
      "start": 7351.28,
      "text": "也看過那個懸崖了"
    },
    {
      "end": 7355.58,
      "start": 7352.78,
      "text": "摔下去的十二米的地下了"
    },
    {
      "end": 7358.26,
      "start": 7356.26,
      "text": "實際上我根本不知道他"
    },
    {
      "end": 7359.4,
      "start": 7358.26,
      "text": "像孩子把他那樣反應"
    },
    {
      "end": 7360.56,
      "start": 7359.4,
      "text": "王健的宗教信仰是什麽"
    },
    {
      "end": 7362.54,
      "start": 7360.56,
      "text": "佛教啊什麽罪惡"
    },
    {
      "end": 7363.46,
      "start": 7362.54,
      "text": "宗教信仰"
    },
    {
      "end": 7363.96,
      "start": 7363.46,
      "text": "EOS"
    },
    {
      "end": 7364.66,
      "start": 7363.96,
      "text": "王健的宗教信仰"
    },
    {
      "end": 7366.1,
      "start": 7364.66,
      "text": "從學啊這都沒有用了"
    },
    {
      "end": 7367.28,
      "start": 7366.1,
      "text": "廢話我上走了"
    },
    {
      "end": 7371.28,
      "start": 7369.48,
      "text": "保險金啊什麽的"
    },
    {
      "end": 7372.64,
      "start": 7371.28,
      "text": "了解王健是誰"
    },
    {
      "end": 7374.14,
      "start": 7372.64,
      "text": "最重要這句話"
    },
    {
      "end": 7375.64,
      "start": 7374.14,
      "text": "曹擔"
    },
    {
      "end": 7377.88,
      "start": 7376.64,
      "text": "我不知道他"
    },
    {
      "end": 7382.98,
      "start": 7377.88,
      "text": "我是在2018年7月2日晚上的晚餐中"
    },
    {
      "end": 7384.98,
      "start": 7382.98,
      "text": "我才了解王健先生是誰"
    },
    {
      "end": 7387.98,
      "start": 7385.98,
      "text": "周恬恬妳把我們當傻子呢"
    },
    {
      "end": 7391.18,
      "start": 7388.58,
      "text": "妳壹年前見過王健先生的老婆"
    },
    {
      "end": 7394.8,
      "start": 7391.38,
      "text": "妳跟王健先生的法國航空公司的總經理"
    },
    {
      "end": 7396.6,
      "start": 7394.8,
      "text": "妳跟李寧有聯繫"
    },
    {
      "end": 7399.36,
      "start": 7397.16,
      "text": "住在了法國最貴的飯店"
    },
    {
      "end": 7402.26,
      "start": 7399.9,
      "text": "妳到這個TGV去接他"
    },
    {
      "end": 7405.0,
      "start": 7402.6,
      "text": "我華賓跟妳這麽長的聯繫"
    },
    {
      "end": 7408.28,
      "start": 7405.0,
      "text": "妳不知道他是王健妳覺得路德可能嗎這句話"
    },
    {
      "end": 7412.16,
      "start": 7408.28,
      "text": "妳說妳7月2號妳才知道他是王健"
    },
    {
      "end": 7413.28,
      "start": 7412.16,
      "text": "妳覺得他覺得可能嗎"
    },
    {
      "end": 7413.78,
      "start": 7413.28,
      "text": "對"
    },
    {
      "end": 7414.28,
