    {
      "end": 9002.0,
      "start": 9000.0,
      "text": "兩萬多頁的只有一張"
    },
    {
      "end": 9004.9,
      "start": 9002.76,
      "text": "我經過法律團隊的允許"
    },
    {
      "end": 9008.82,
      "start": 9005.18,
      "text": "和正在調查的案件的刑事機關的允許"
    },
    {
      "end": 9011.62,
      "start": 9009.96,
      "text": "讓我把這個可以放出來"
    },
    {
      "end": 9017.08,
      "start": 9013.46,
      "text": "每個字兒都價值萬兩"
    },
    {
      "end": 9019.82,
      "start": 9018.4,
      "text": "如果妳們願意的話"
    },
    {
      "end": 9022.4,
      "start": 9020.02,
      "text": "妳們就多動手指頭多捐點錢"
    },
    {
      "end": 9026.48,
      "start": 9024.26,
      "text": "下壹個是啥先別推呢"
    },
    {
      "end": 9028.32,
      "start": 9026.56,
      "text": "等等妳們調整心腦"
    },
    {
      "end": 9031.22,
      "start": 9028.32,
      "text": "都去會洗手間"
    },
    {
      "end": 9033.22,
      "start": 9031.6,
      "text": "這不筆錄都完了嗎筆錄"
    },
    {
      "end": 9035.14,
      "start": 9033.62,
      "text": "筆錄都完了今天啊"
    },
    {
      "end": 9037.34,
      "start": 9035.9,
      "text": "下壹個視頻是誰的視頻啊"
    },
    {
      "end": 9050.44,
      "start": 9049.18,
      "text": "誰的開始吧"
    },
    {
      "end": 9061.22,
      "start": 9058.32,
      "text": "今天這個"
    },
    {
      "end": 9062.22,
      "start": 9061.22,
      "text": "誰做的呀"
    },
    {
      "end": 9064.22,
      "start": 9063.22,
      "text": "非常的不一樣"
    },
    {
      "end": 9068.22,
      "start": 9066.04,
      "text": "因為它不是一個普普通通的"
    },
    {
      "end": 9069.84,
      "start": 9068.62,
      "text": "媒體發布會"
    },
    {
      "end": 9071.6,
      "start": 9070.08,
      "text": "唯一的壹次中國人"
    },
    {
      "end": 9074.14,
      "start": 9071.66,
      "text": "站在了美國國際講談的反共產黨"
    },
    {
      "end": 9076.54,
      "start": 9074.14,
      "text": "第一次一個中國人"
    },
    {
      "end": 9078.54,
      "start": 9076.54,
      "text": "來為中國人民爭取自由"
    },
    {
      "end": 9079.74,
      "start": 9078.54,
      "text": "法治民主"
    },
    {
      "end": 9083.16,
      "start": 9079.74,
      "text": "第一次中國人公開的以法律行動"
    },
    {
      "end": 9086.04,
      "start": 9083.16,
      "text": "利用美國的自由的法律和民主制度"
    },
    {
      "end": 9088.38,
      "start": 9086.04,
      "text": "來反對共產黨的獨裁統治"
    },
    {
      "end": 9090.86,
      "start": 9089.04,
      "text": "第一次在美國這個"
    },
    {
      "end": 9093.28,
      "start": 9090.86,
      "text": "整個這個紐約自由的舞台上"
    },
    {
      "end": 9096.18,
      "start": 9093.28,
      "text": "為更多的中國人爭取我們的安全的"
    },
    {
      "end": 9097.18,
      "start": 9096.18,
      "text": "有信仰的"
    },
    {
      "end": 9098.18,
      "start": 9097.18,
      "text": "一個法治的未來"
    },
    {
      "end": 9100.18,
      "start": 9098.18,
      "text": "我認為我可以說"
    },
    {
      "end": 9102.18,
      "start": 9100.18,
      "text": "給米爾斯威爾說"
    },
    {
      "end": 9103.18,
      "start": 9102.18,
      "text": "那天是結束了"
    },
    {
      "end": 9105.18,
      "start": 9103.18,
      "text": "新的日子開始了"
    },
    {
      "end": 9118.08,
      "start": 9105.18,
      "text": "東京中國人"
    },
    {
      "end": 9120.94,
      "start": 9118.08,
      "text": "變成岳南北"
    },
    {
      "end": 9124.38,
      "start": 9121.96,
      "text": "北京市場"
    },
    {
      "end": 9128.1,
      "start": 9125.34,
      "text": "北京市場"
    },
    {
      "end": 9132.0,
      "start": 9129.24,
      "text": "北京市場"
    },
    {
      "end": 9134.68,
      "start": 9132.76,
      "text": "北京市場"
    },
    {
      "end": 9146.02,
      "start": 9135.18,
      "text": "中共已经知道美国正在推动一步脱口"
    },
    {
      "end": 9150.6,
      "start": 9146.02,
      "text": "实际上现在大家知道这是一半全数的增长"
    },
    {
      "end": 9151.64,
      "start": 9150.6,
      "text": "是什么问题"
    },
    {
      "end": 9155.3,
      "start": 9151.64,
      "text": "就看过中共那些海外的一代一个战略地点"
    },
    {
      "end": 9157.26,
      "start": 9155.3,
      "text": "不是港口就是机场"
    },
    {
      "end": 9159.1,
      "start": 9157.26,
      "text": "他们在干什么"
    },
    {
      "end": 9161.84,
      "start": 9159.1,
      "text": "金融市场的就是跟中共的决战"
    },
    {
      "end": 9164.6,
      "start": 9161.84,
      "text": "都是真正让我觉得兴奋的一天"
    },
    {
      "end": 9167.48,
      "start": 9164.6,
      "text": "金融上就把中共给它干掉"
    },
    {
      "end": 9168.32,
      "start": 9167.48,
      "text": "不放入市场"
    },
    {
      "end": 9171.48,
      "start": 9168.32,
      "text": "就怕有任何不稳定的因素"
    },
    {
      "end": 9174.76,
      "start": 9171.48,
      "text": "包括掩盖新闻真相"
    },
    {
      "end": 9177.08,
      "start": 9174.76,
      "text": "不让老百姓发生"
    },
    {
      "end": 9179.94,
      "start": 9177.08,
      "text": "将加上退均的机会"
    },
    {
      "end": 9182.24,
      "start": 9179.94,
      "text": "持续准面文明治"
    },
    {
      "end": 9183.12,
      "start": 9182.24,
      "text": "稳定"
    },
    {
      "end": 9187.16,
      "start": 9183.12,
      "text": "因为他在国家的研究"
    },
    {
      "end": 9188.84,
      "start": 9187.16,
      "text": "是专门点名的号位"
    },
    {
      "end": 9191.02,
      "start": 9188.84,
      "text": "这个就是他点名号位"
    },
    {
      "end": 9193.12,
      "start": 9191.02,
      "text": "这个就是一场进行物件"
    },
    {
      "end": 9196.32,
      "start": 9193.12,
      "text": "我希望原来都是王岐山的人"
    },
    {
      "end": 9197.88,
      "start": 9196.32,
      "text": "现在王岐山如果要保了"
    },
    {
      "end": 9199.24,
      "start": 9197.88,
      "text": "大家都要夺路而跑"
    },
    {
      "end": 9200.84,
      "start": 9199.24,
      "text": "一定会发生惨叹"
    },
    {
      "end": 9202.84,
      "start": 9200.84,
      "text": "我王岐山的就是说"
    },
    {
      "end": 9205.52,
      "start": 9202.84,
      "text": "也希望我的这个中共"
    },
    {
      "end": 9207.78,
      "start": 9205.52,
      "text": "能够观醒"
    },
    {
      "end": 9208.68,
      "start": 9207.78,
      "text": "能够带动"
    },
    {
      "end": 9211.0,
      "start": 9208.68,
      "text": "我们全国的这个国安系统"
    },
    {
      "end": 9213.84,
      "start": 9211.0,
      "text": "大家别注意在各种媒体"
    },
    {
      "end": 9215.0,
      "start": 9213.84,
      "text": "去宣扬这种"
    },
    {
      "end": 9216.96,
      "start": 9215.0,
      "text": "什么新极其当心结"
    },
    {
      "end": 9218.0,
      "start": 9216.96,
      "text": "和仇恨作用"
    },
    {
      "end": 9220.0,
      "start": 9218.0,
      "text": "王岐山的就是"
    },
    {
      "end": 9221.4,
      "start": 9220.0,
      "text": "我们在任何这个新枪"
    },
    {
      "end": 9222.08,
      "start": 9221.4,
      "text": "来做的"
    },
    {
      "end": 9223.12,
      "start": 9222.08,
      "text": "咱们刚才看到"
    },
    {
      "end": 9224.04,
      "start": 9223.12,
      "text": "强开"
    },
    {
      "end": 9225.56,
      "start": 9224.04,
      "text": "强开逮着老百姓"
    },
    {
      "end": 9226.52,
      "start": 9225.56,
      "text": "就他们哪里过"
    },
    {
      "end": 9227.4,
      "start": 9226.52,
      "text": "这些人都没有"
    },
    {
      "end": 9228.0,
      "start": 9227.4,
      "text": "通过"
    },
    {
      "end": 9229.0,
      "start": 9228.0,
      "text": "乌坎生"
    },
    {
      "end": 9231.0,
      "start": 9229.0,
      "text": "这几年一路走来"
    },
    {
      "end": 9233.2,
      "start": 9231.0,
      "text": "三党城方们"
    },
    {
      "end": 9237.2,
      "start": 9233.2,
      "text": "你们一旦不要被欺骗"
    },
    {
      "end": 9238.72,
      "start": 9237.2,
      "text": "所有的财富都在哪里"
    },
    {
      "end": 9239.88,
      "start": 9238.72,
      "text": "从这两方面"
    },
    {
      "end": 9241.32,
      "start": 9239.88,
      "text": "国台连续的人呢"
    },
    {
      "end": 9243.4,
      "start": 9241.32,
      "text": "就是狼狼一下哪一个棋子"
    },
    {
      "end": 9244.88,
      "start": 9243.4,
      "text": "所以东西教一个"
    },
    {
      "end": 9246.28,
      "start": 9244.88,
      "text": "除了供应量不够"
    },
    {
      "end": 9247.96,
      "start": 9246.28,
      "text": "以及错过膨胀的这个"
    },
    {
      "end": 9250.0,
      "start": 9247.96,
      "text": "直接反应已经出现短跌了"
    },
    {
      "end": 9251.16,
      "start": 9250.0,
      "text": "未来这个情况"
    },
    {
      "end": 9252.56,
      "start": 9251.16,
      "text": "只能从他走口"
    },
    {
      "end": 9255.96,
      "start": 9252.56,
      "text": "必须要遵守这种世界的"
    },
    {
      "end": 9257.8,
      "start": 9255.96,
      "text": "自我营主的这种程度"
    },
    {
      "end": 9260.16,
      "start": 9257.8,
      "text": "必须遵守大卫体用所需"
    },
    {
      "end": 9261.52,
      "start": 9260.16,
      "text": "很协议的"
    },
    {
      "end": 9263.64,
      "start": 9261.52,
      "text": "一个袭击"
    },
    {
      "end": 9265.72,
      "start": 9263.64,
      "text": "那就是"
    },
    {
      "end": 9267.4,
      "start": 9265.72,
      "text": "废掉共产门"
