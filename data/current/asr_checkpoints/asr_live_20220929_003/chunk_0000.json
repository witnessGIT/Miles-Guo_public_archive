    {
      "avg_logprob": -0.164758,
      "compression_ratio": 1.188172,
      "end": 58.0,
      "no_speech_prob": 0.0,
      "start": 53.0,
      "text": "但是我看到我们生活中谁懂得珍惜啊,是吧?"
