{
  "chunk_audio_sha256": "e5a3ae181ac6245d485d029878a948972c6a283c623881b6d8e1f1df2d1c9967",
  "chunk_index": 10,
  "completed_at": "2026-10-20T04:44:57Z",
  "language": "zh",
  "live_id": "LIVE_20201114_002",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
