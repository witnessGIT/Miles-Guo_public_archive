  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 9003.22,
      "start": 9000.0,
      "text": "我们认为这是一个极不严肃的表态"
    },
    {
      "end": 9007.48,
      "start": 9003.22,
      "text": "会为我们新西兰未来几年的发展"
    },
    {
      "end": 9010.36,
      "start": 9007.48,
      "text": "可能带来政治和经济的危机"
    },
    {
      "end": 9015.66,
      "start": 9010.36,
      "text": "我们对这样的一种不负责任的表态深表忧虑"
    },
    {
      "end": 9019.5,
      "start": 9015.66,
      "text": "我们第一时间就向我们的执政党联盟"
    },
    {
      "end": 9025.76,
      "start": 9019.5,
      "text": "以及反对党和各党派发出了我们的严重的关切"
    },
    {
      "end": 9029.32,
      "start": 9026.86,
      "text": "我们希望在这个历史性的时刻"
    },
    {
      "end": 9031.88,
      "start": 9029.32,
      "text": "大家不要盲目的选边站"
    },
    {
      "end": 9034.24,
      "start": 9031.88,
      "text": "首先要遵守美国的法律"
    },
    {
      "end": 9040.96,
      "start": 9034.24,
      "text": "按照美国的依法宣布的谁作为最终的总统当选者"
    },
    {
      "end": 9046.48,
      "start": 9040.96,
      "text": "而不要被左派媒体一些虚假的报道所阻挡"
    },
    {
      "end": 9048.86,
      "start": 9046.48,
      "text": "这是非常有危害的"
    },
    {
      "end": 9052.74,
      "start": 9048.86,
      "text": "我们知道今天我们已经非常明确的"
    },
    {
      "end": 9057.76,
      "start": 9053.6,
      "text": "可以肯定的说川普政府一定会赢"
    },
    {
      "end": 9060.04,
      "start": 9057.76,
      "text": "川普总统一定是下一任总统"
    },
    {
      "end": 9069.24,
      "start": 9060.04,
      "text": "那么我们新中国联邦一定将是未来的中国的合法的政府复生者"
    },
    {
      "end": 9072.02,
      "start": 9069.24,
      "text": "我们对此坚定不移"
    },
    {
      "end": 9073.96,
      "start": 9072.02,
      "text": "我们已经做好了很多的准备"
    },
    {
      "end": 9077.52,
      "start": 9073.96,
      "text": "这个世界正在发生历史性的变化"
    },
    {
      "end": 9080.62,
      "start": 9077.52,
      "text": "我们每一个人都应该做出历史性的选择"
    },
    {
      "end": 9085.24,
      "start": 9080.62,
      "text": "每一个国家都应该清醒的意识到这是历史的分水令"
    },
    {
      "end": 9086.94,
      "start": 9085.24,
      "text": "这是激动人性的一天"
    },
    {
      "end": 9087.82,
      "start": 9086.94,
      "text": "历史性的一天"
    },
    {
      "end": 9088.7,
      "start": 9087.82,
      "text": "谢谢主持人"
    },
    {
      "end": 9090.08,
      "start": 9088.7,
      "text": "谢谢老板长"
    },
    {
      "end": 9094.24,
      "start": 9090.08,
      "text": "最后请问您一个问题就是我们现场大概有四五百的兄弟姐妹"
    },
    {
      "end": 9097.36,
      "start": 9094.24,
      "text": "他们是很早啊大概六点多就是去到了现场"
    },
    {
      "end": 9101.0,
      "start": 9097.36,
      "text": "也是感谢我们这个DC的农场"
    },
    {
      "end": 9102.82,
      "start": 9101.0,
      "text": "还有是我们的美西的Sara"
    },
    {
      "end": 9106.66,
      "start": 9102.82,
      "text": "我们是非常感谢大家就是加入这样一个共同的一个集会"
    },
    {
      "end": 9109.76,
      "start": 9106.66,
      "text": "我想请问您对现场的这些兄弟姐妹"
    },
    {
      "end": 9110.7,
      "start": 9109.76,
      "text": "您有什么话说呢"
    },
    {
      "end": 9112.94,
      "start": 9110.7,
      "text": "或者是说怎么去鼓励他们呢"
    },
    {
      "end": 9114.82,
      "start": 9112.94,
      "text": "非常感谢"
    },
    {
      "end": 9116.46,
      "start": 9114.82,
      "text": "首先我像刚才所说的"
    },
    {
      "end": 9120.06,
      "start": 9116.46,
      "text": "我非常羡慕你们可以直接在第一线"
    },
    {
      "end": 9124.02,
      "start": 9120.06,
      "text": "可以在世界舞台中心华盛顿"
    },
    {
      "end": 9129.92,
      "start": 9124.02,
      "text": "来展现我们新中国人的新中国联邦人的新形象"
    },
    {
      "end": 9134.1,
      "start": 9129.92,
      "text": "我们在这一次我们不是简单的在见证历史"
    },
    {
      "end": 9136.24,
      "start": 9134.1,
      "text": "我们是在参与的这个历史"
    },
    {
      "end": 9138.66,
      "start": 9136.24,
      "text": "并且是我们是重要的推动者"
    },
    {
      "end": 9144.06,
      "start": 9138.66,
      "text": "那么我们中国人在过去的七十多年来"
    },
    {
      "end": 9148.5,
      "start": 9144.06,
      "text": "被共产党所欺杀压榨剥削"
    },
    {
      "end": 9151.4,
      "start": 9148.5,
      "text": "那么我们三年前"
    },
    {
      "end": 9153.94,
      "start": 9151.4,
      "text": "郭文贵先生引导的这个爆料革命"
    },
    {
      "end": 9157.02,
      "start": 9153.94,
      "text": "大家以为是中国人对共产党的抗争"
    },
    {
      "end": 9160.06,
      "start": 9157.02,
      "text": "今天事实可以展现在"
    },
    {
      "end": 9163.74,
      "start": 9160.06,
      "text": "共产党对世界的破坏"
    },
    {
      "end": 9166.3,
      "start": 9163.74,
      "text": "是远远超过大家想象的"
    },
    {
      "end": 9168.32,
      "start": 9166.3,
      "text": "我们中国人站起来"
    },
    {
      "end": 9170.3,
      "start": 9168.32,
      "text": "郭文贵先生发布的这个爆料革命"
    },
    {
      "end": 9172.76,
      "start": 9170.3,
      "text": "就向世界揭示了共产党的邪恶"
    },
    {
      "end": 9173.98,
      "start": 9172.76,
      "text": "那么在今天"
    },
    {
      "end": 9175.98,
      "start": 9173.98,
      "text": "全世界人民就被放行起来了"
    },
    {
      "end": 9177.96,
      "start": 9175.98,
      "text": "我们在DC的"
    },
    {
      "end": 9179.28,
      "start": 9177.96,
      "text": "在华盛顿的"
    },
    {
      "end": 9182.14,
      "start": 9179.28,
      "text": "在整个全美的全世界的战友"
    },
    {
      "end": 9183.8,
      "start": 9182.14,
      "text": "一起来"
    },
    {
      "end": 9186.04,
      "start": 9183.8,
      "text": "在参与这个历史的进程中"
    },
    {
      "end": 9187.78,
      "start": 9186.04,
      "text": "我们作为历史的重要"
    },
    {
      "end": 9189.64,
      "start": 9187.78,
      "text": "重要的一个见证的参与者"
    },
    {
      "end": 9191.54,
      "start": 9189.64,
      "text": "我们为大家感到自豪"
    },
    {
      "end": 9195.5,
      "start": 9191.54,
      "text": "所以我想请战友们继续的努力"
    },
    {
      "end": 9197.34,
      "start": 9195.5,
      "text": "我们的路刚刚才开始"
    },
    {
      "end": 9198.8,
      "start": 9197.34,
      "text": "远远没有结束"
    },
    {
      "end": 9199.48,
      "start": 9198.8,
      "text": "谢谢你们"
    },
    {
      "end": 9201.94,
      "start": 9199.48,
      "text": "感谢老板长您的鼓励"
    },
    {
      "end": 9203.16,
      "start": 9201.94,
      "text": "再次感谢您"
    },
    {
      "end": 9205.06,
      "start": 9203.16,
      "text": "谢谢谢谢"
    },
    {
      "end": 9206.34,
      "start": 9205.06,
      "text": "今天太激动了"
    },
    {
      "end": 9206.56,
      "start": 9206.34,
      "text": "谢谢"
    },
    {
      "end": 9208.32,
      "start": 9206.56,
      "text": "我们都是一样的"
    },
    {
      "end": 9212.02,
      "start": 9208.32,
      "text": "所以战友们"
    },
    {
      "end": 9213.5,
      "start": 9212.02,
      "text": "我们还在等下一位嘉宾"
    },
    {
      "end": 9215.58,
      "start": 9213.5,
      "text": "下一位我们的嘉宾是老江先生"
    },
    {
      "end": 9217.54,
      "start": 9215.58,
      "text": "所以"
    },
    {
      "end": 9219.8,
      "start": 9217.54,
      "text": "朋友们和朋友们"
    },
    {
      "end": 9221.42,
      "start": 9219.8,
      "text": "我们等待我们下期待"
    },
    {
      "end": 9222.52,
      "start": 9221.42,
      "text": "所以就先跟着我"
    },
    {
      "end": 9224.2,
      "start": 9222.52,
      "text": "我们可以看到"
    },
    {
      "end": 9226.76,
      "start": 9224.2,
      "text": "我们的国家的帘子"
    },
    {
      "end": 9228.0,
      "start": 9226.76,
      "text": "还在飞着"
    },
    {
      "end": 9229.38,
      "start": 9228.0,
      "text": "老江先生您好"
    },
    {
      "end": 9231.38,
      "start": 9229.38,
      "text": "你好"
    },
    {
      "end": 9232.66,
      "start": 9231.38,
      "text": "主持人您好"
    },
    {
      "end": 9233.94,
      "start": 9232.66,
      "text": "尊敬的战友们好"
    },
    {
      "end": 9235.04,
      "start": 9233.94,
      "text": "老江先生"
    },
    {
      "end": 9238.38,
      "start": 9235.04,
      "text": "我想请问您在这样一个有历史意义的时间"
    },
    {
      "end": 9241.0,
      "start": 9238.38,
      "text": "在这样一个有历史意义的一个地方"
    },
    {
      "end": 9243.3,
      "start": 9241.0,
      "text": "我们的战友代表爆料革命"
    },
    {
      "end": 9244.78,
      "start": 9243.3,
      "text": "代表新中国联邦"
    },
    {
      "end": 9247.3,
      "start": 9244.78,
      "text": "到这个现场加入川普总统的游行"
    },
    {
      "end": 9249.08,
      "start": 9247.3,
      "text": "您觉得这个意义是怎么样子"
    },
    {
      "end": 9251.3,
      "start": 9249.08,
      "text": "以及您现在此时此刻的心情"
    },
    {
      "end": 9252.52,
      "start": 9251.3,
      "text": "可以跟我们分享一下吗"
    },
    {
      "end": 9255.78,
      "start": 9252.52,
      "text": "好的 非常感谢主持人"
    },
    {
      "end": 9256.62,
      "start": 9255.78,
      "text": "首先呢"
    },
    {
      "end": 9258.24,
      "start": 9256.62,
      "text": "这是一个新潮澎湃的时刻"
    },
    {
      "end": 9259.08,
      "start": 9258.24,
      "text": "也是呢"
    },
    {
      "end": 9261.42,
      "start": 9259.08,
      "text": "上天历史赋予我们的一个使命时刻"
    },
    {
      "end": 9265.22,
      "start": 9261.42,
      "text": "在我们这个爆料革命整个进行如火如荼的"
    },
    {
      "end": 9266.76,
      "start": 9265.22,
      "text": "进行了三年半的这样的"
    },
    {
      "end": 9271.38,
      "start": 9266.76,
      "text": "从开始起到一点点的壮大到现在整个的"
    },
    {
      "end": 9272.9,
      "start": 9271.38,
      "text": "蓬勃发展的这个时代的时候"
    },
    {
      "end": 9276.92,
      "start": 9272.9,
      "text": "我们必须站出来参与到国际上重大的"
    },
    {
      "end": 9278.56,
      "start": 9276.92,
      "text": "这样的政治事务当中"
    },
    {
      "end": 9280.8,
      "start": 9278.56,
      "text": "我们必须要有自己的发言权"
    },
    {
      "end": 9283.66,
      "start": 9280.8,
      "text": "要有自己的被认可的这样的一个认可度"
    },
    {
      "end": 9287.78,
      "start": 9283.66,
      "text": "所以我们要表明我们除了中国共产党"
    },
    {
      "end": 9289.82,
      "start": 9287.78,
      "text": "所执政的这个非法政府之外"
    },
    {
      "end": 9293.74,
      "start": 9289.82,
      "text": "我们海外在全世界还有一个这样一个"
    },
    {
      "end": 9297.14,
      "start": 9293.74,
      "text": "维护正义坚持为真不破"
    },
    {
      "end": 9300.9,
      "start": 9297.14,
      "text": "支持世界法治民主自由的"
    },
    {
      "end": 9303.34,
      "start": 9300.9,
      "text": "这样正义力量的这样一个团体"
    },
    {
      "end": 9305.22,
      "start": 9303.34,
      "text": "和未来的这样一个政权"
    },
    {
      "end": 9307.52,
      "start": 9305.22,
      "text": "所以这个意义的重大性就在于"
    },
    {
      "end": 9309.18,
      "start": 9307.52,
      "text": "向全世界向美国"
    },
    {
      "end": 9310.66,
      "start": 9309.18,
      "text": "向海外华人"
    },
    {
      "end": 9311.94,
      "start": 9310.66,
      "text": "向共产党"
    },
    {
      "end": 9315.24,
      "start": 9311.94,
      "text": "展示了我们新中国联邦的力量"
    },
    {
      "end": 9317.92,
      "start": 9315.24,
      "text": "我们的号召力我们的行动力"
    },
    {
      "end": 9321.52,
      "start": 9317.92,
      "text": "跟我们为真不破坚守正义的这样的立场"
    },
    {
      "end": 9321.86,
      "start": 9321.52,
      "text": "谢谢"
    },
    {
      "end": 9327.42,
      "start": 9321.86,
      "text": "先生您呢之前也是在这个加拿大的SEC"
    },
    {
      "end": 9329.26,
      "start": 9327.42,
      "text": "已经是游行非常多天了"
    },
    {
      "end": 9330.3,
      "start": 9329.26,
      "text": "以及有别的游行"
    },
    {
      "end": 9332.02,
      "start": 9330.3,
      "text": "您在这方面是非常有经验的"
    },
    {
      "end": 9333.46,
      "start": 9332.02,
      "text": "我想请问您就是"
    },
    {
      "end": 9337.54,
      "start": 9333.46,
      "text": "就是我们如果有其他的战友想加入"
    },
    {
      "end": 9340.1,
      "start": 9337.54,
      "text": "或者是有其他的地方想开展一个游行"
    },
    {
      "end": 9341.44,
      "start": 9340.1,
      "text": "您有什么建议呢"
    },
    {
      "end": 9344.48,
      "start": 9341.44,
      "text": "好的非常感谢主持人"
    },
    {
      "end": 9348.42,
      "start": 9344.48,
      "text": "在加拿大的SEC的这个几次的游行"
    },
    {
      "end": 9349.64,
      "start": 9348.42,
      "text": "包括在中领馆"
    },
    {
      "end": 9351.48,
      "start": 9349.64,
      "text": "使领馆门前的这个游行的"
    },
    {
      "end": 9354.44,
      "start": 9351.48,
      "text": "我们几次这个加拿大的战友啊"
    },
    {
      "end": 9356.16,
      "start": 9354.44,
      "text": "这个纷纷踊跃的去参加"
    },
    {
      "end": 9358.14,
      "start": 9356.16,
      "text": "那么这里面的意义呢"
    },
    {
      "end": 9359.04,
      "start": 9358.14,
      "text": "非常的重大"
    },
    {
      "end": 9359.78,
      "start": 9359.04,
      "text": "首先呢"
    },
    {
      "end": 9362.82,
      "start": 9359.78,
      "text": "加拿大是中共蓝金黄的重灾区"
    },
    {
      "end": 9364.7,
      "start": 9362.82,
      "text": "尤其在金融领域啊"
    },
    {
      "end": 9365.76,
      "start": 9364.7,
      "text": "在司法领域"
    },
    {
      "end": 9367.72,
      "start": 9365.76,
      "text": "整个人所做出的这种"
    },
    {
      "end": 9370.28,
      "start": 9367.72,
      "text": "这个背后的这种操纵"
    },
    {
      "end": 9372.22,
      "start": 9370.28,
      "text": "啊这种破坏"
    },
    {
      "end": 9374.32,
      "start": 9372.22,
      "text": "还有这种以司法超限战"
    },
    {
      "end": 9376.58,
      "start": 9374.32,
      "text": "媒体超限战啊"
    },
    {
      "end": 9378.32,
      "start": 9376.58,
      "text": "这个金融超限战啊"
    },
    {
      "end": 9380.58,
      "start": 9378.32,
      "text": "为主要的这几个的这个手段"
    },
    {
      "end": 9382.94,
      "start": 9380.58,
      "text": "把加拿大的这种啊"
    },
    {
      "end": 9385.74,
      "start": 9382.94,
      "text": "支持新中国联邦建设事业"
    },
    {
      "end": 9388.32,
      "start": 9385.74,
      "text": "还有这个金融运作事业"
    },
    {
      "end": 9390.02,
      "start": 9388.32,
      "text": "商业运作事业啊"
    },
    {
      "end": 9391.06,
      "start": 9390.02,
