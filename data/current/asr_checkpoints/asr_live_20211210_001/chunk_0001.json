      "text": "謝謝"
    },
    {
      "end": 1052.96,
      "start": 1050.96,
      "text": "好 謝謝Q妹"
    },
    {
      "end": 1055.96,
      "start": 1052.96,
      "text": "那我們請小堂姐和維廉王"
    },
    {
      "end": 1060.96,
      "start": 1056.96,
      "text": "今天大家發現人比較多 是吧"
    },
    {
      "end": 1063.96,
