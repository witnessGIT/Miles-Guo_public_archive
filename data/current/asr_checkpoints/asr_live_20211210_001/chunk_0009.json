      "start": 8423.2,
      "text": "孟建柱"
    },
    {
      "end": 8425.2,
      "start": 8424.2,
      "text": "他们的家人"
    },
    {
      "end": 8426.2,
      "start": 8425.2,
      "text": "现在绝对像"
    },
    {
      "end": 8427.2,
      "start": 8426.2,
      "text": "我们所有中国"
    },
    {
      "end": 8428.2,
      "start": 8427.2,
      "text": "被洗脑老百姓的幻想着"
    },
    {
      "end": 8430.2,
      "start": 8428.2,
      "text": "我会没事"
    },
    {
      "end": 8432.2,
      "start": 8430.2,
      "text": "我会长治九个案"
    },
    {
      "end": 8433.2,
      "start": 8432.2,
      "text": "无任何情况下"
    },
    {
      "end": 8434.2,
      "start": 8433.2,
      "text": "我都会降服"
