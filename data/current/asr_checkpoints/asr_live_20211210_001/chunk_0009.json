    },
    {
      "end": 8451.2,
      "start": 8450.2,
      "text": "你记住"
    },
    {
      "end": 8453.2,
      "start": 8451.2,
      "text": "全人类有史以来"
    },
    {
      "end": 8455.2,
      "start": 8453.2,
      "text": "跟所有人都有仇恨感的"
    },
    {
      "end": 8456.2,
      "start": 8455.2,
      "text": "就这一次"
    },
    {
      "end": 8457.2,
      "start": 8456.2,
      "text": "病毒疫苗"
    },
    {
      "end": 8460.2,
      "start": 8457.2,
      "text": "我们不用做任何事情"
    },
    {
      "end": 8462.2,
      "start": 8460.2,
      "text": "只要告诉说澳大利亚"
    },
    {
      "end": 8463.2,
      "start": 8462.2,
      "text": "墨尔本"
    },
    {
      "end": 8464.2,
      "start": 8463.2,
      "text": "悉尼"
    },
    {
      "end": 8465.2,
      "start": 8464.2,
      "text": "这是习近平的姐姐的家"
    },
    {
      "end": 8466.2,
      "start": 8465.2,
      "text": "安安的家"
    },
    {
      "end": 8467.2,
      "start": 8466.2,
      "text": "安安的女儿的家"
    },
    {
      "end": 8469.2,
      "start": 8467.2,
      "text": "我们告诉你"
    },
    {
      "end": 8470.2,
      "start": 8469.2,
      "text": "习远平的房子"
    },
    {
      "end": 8471.2,
      "start": 8470.2,
      "text": "我们告诉你"
    },
    {
      "end": 8473.2,
      "start": 8471.2,
      "text": "这是习永平的房子"
    },
    {
      "end": 8475.2,
      "start": 8473.2,
      "text": "我们告诉你"
    },
    {
      "end": 8476.2,
      "start": 8475.2,
      "text": "这是习建平的房子"
    },
    {
      "end": 8478.2,
      "start": 8476.2,
      "text": "告诉外国人就够了"
    },
    {
      "end": 8481.2,
      "start": 8478.2,
      "text": "我们不用在中共国当代助人"
    },
    {
      "end": 8482.2,
      "start": 8481.2,
      "text": "在外国就可以了"
    },
    {
      "end": 8483.2,
      "start": 8482.2,
      "text": "把棺材板一停"
    },
    {
      "end": 8484.2,
      "start": 8483.2,
      "text": "洗下来"
    },
    {
      "end": 8485.2,
      "start": 8484.2,
      "text": "这是谁的房子"
    },
    {
      "end": 8486.2,
      "start": 8485.2,
      "text": "他杀掉了你们"
    },
    {
      "end": 8487.2,
      "start": 8486.2,
      "text": "然后把这些消息"
    },
    {
      "end": 8489.2,
      "start": 8487.2,
      "text": "发给那些疫苗死亡的人去"
    },
    {
      "end": 8490.2,
