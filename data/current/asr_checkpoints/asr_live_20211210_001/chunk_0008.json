      "text": "是吧"
    },
    {
      "end": 7762.26,
      "start": 7761.26,
      "text": "你让我供气嘛"
    },
    {
      "end": 7764.26,
      "start": 7762.26,
      "text": "让我来个钱的收入嘛"
