      "end": 7806.26,
      "start": 7805.26,
      "text": "对不对"
    },
    {
      "end": 7807.26,
      "start": 7806.26,
      "text": "这最简单的道理啊"
    },
    {
      "end": 7809.26,
      "start": 7807.26,
      "text": "你瑞卡去了"
    },
    {
      "end": 7810.26,
      "start": 7809.26,
      "text": "大家还不知道"
