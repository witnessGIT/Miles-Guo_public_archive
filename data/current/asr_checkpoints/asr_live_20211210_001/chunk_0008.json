    {
      "end": 7769.26,
      "start": 7768.26,
      "text": "是吧"
    },
    {
      "end": 7770.26,
      "start": 7769.26,
      "text": "啊"
    },
    {
      "end": 7771.26,
      "start": 7770.26,
      "text": "拜登你让我这边西气"
    },
    {
      "end": 7773.26,
      "start": 7771.26,
      "text": "我就难气我就停"
    },
    {
      "end": 7775.26,
      "start": 7773.26,
      "text": "就这么简单"
    },
    {
      "end": 7776.26,
      "start": 7775.26,
      "text": "一系列的叫"
    },
    {
      "end": 7777.26,
      "start": 7776.26,
      "text": "这就叫普京"
    },
    {
      "end": 7779.26,
      "start": 7777.26,
      "text": "你不懂政治都不懂"
    },
    {
      "end": 7780.26,
      "start": 7779.26,
      "text": "你懂得知道"
    },
    {
      "end": 7781.26,
      "start": 7780.26,
      "text": "这是天大的事儿"
    },
    {
      "end": 7783.26,
      "start": 7781.26,
      "text": "对习是致命的伤害"
    },
    {
      "end": 7786.26,
      "start": 7783.26,
      "text": "这几乎就等头影"
