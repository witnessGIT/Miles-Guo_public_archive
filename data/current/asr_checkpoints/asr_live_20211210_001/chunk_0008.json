    {
      "end": 7793.26,
      "start": 7791.26,
      "text": "我就少点上七哥那直播"
    },
    {
      "end": 7794.26,
      "start": 7793.26,
      "text": "他就这概念"
    },
    {
      "end": 7795.26,
      "start": 7794.26,
      "text": "你别人上不了我"
    },
    {
      "end": 7796.26,
      "start": 7795.26,
      "text": "安红那么敢"
    },
    {
      "end": 7797.26,
      "start": 7796.26,
      "text": "他肯定把我上了"
