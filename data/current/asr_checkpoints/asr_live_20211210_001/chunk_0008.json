    {
      "end": 7816.26,
      "start": 7814.26,
      "text": "文峰现在也很著名"
    },
    {
      "end": 7817.26,
      "start": 7816.26,
      "text": "是吧"
    },
    {
      "end": 7818.26,
      "start": 7817.26,
      "text": "那你几个去"
    },
    {
      "end": 7819.26,
      "start": 7818.26,
      "text": "那肯定不行"
    },
    {
      "end": 7820.26,
      "start": 7819.26,
      "text": "现在对习来讲"
    },
    {
      "end": 7821.26,
      "start": 7820.26,
      "text": "他就是这么个简单的概念"
    },
    {
      "end": 7823.26,
      "start": 7821.26,
      "text": "相当于老班长"
    },
    {
      "end": 7825.26,
      "start": 7823.26,
      "text": "长脑哥也跟卢大脑袋一起"
    },
    {
      "end": 7826.26,
      "start": 7825.26,
      "text": "是吧"
    },
    {
      "end": 7827.26,
      "start": 7826.26,
      "text": "你想想我啥滋味啊"
    },
    {
      "end": 7828.26,
      "start": 7827.26,
      "text": "是不是啊"
    },
    {
      "end": 7829.26,
      "start": 7828.26,
      "text": "他是这么个概念"
    },
    {
      "end": 7830.26,
      "start": 7829.26,
      "text": "这一刻"
    },
    {
      "end": 7832.26,
      "start": 7830.26,
      "text": "对习是个什么概念"
    },
    {
      "end": 7834.26,
      "start": 7832.26,
      "text": "他更加穷凶极恶"
    },
    {
      "end": 7839.26,
      "start": 7836.26,
      "text": "任何政治家和所有的人类灾难"
    },
    {
      "end": 7843.26,
      "start": 7839.26,
      "text": "都是在穷凶极恶和丧失自我"
    },
    {
      "end": 7845.26,
      "start": 7843.26,
      "text": "丧心病狂以后的疯狂的举动"
    },
    {
      "end": 7849.26,
      "start": 7845.26,
      "text": "战争既是一个鲁莽和失败的"
    },
    {
      "end": 7852.26,
      "start": 7849.26,
      "text": "之后没有选择的最愚蠢的办法是战争"
