      "text": "科美柔上的直播"
    },
    {
      "end": 7803.26,
      "start": 7802.26,
      "text": "哇塞这路大脑袋"
    },
    {
      "end": 7804.26,
      "start": 7803.26,
      "text": "你想要什么兴奋"
    },
    {
      "end": 7805.26,
      "start": 7804.26,
      "text": "七哥最痛苦嘛"
    },
