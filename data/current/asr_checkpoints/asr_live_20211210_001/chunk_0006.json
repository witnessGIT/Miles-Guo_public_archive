{
  "chunk_audio_sha256": "edc40285ce3035d0117f10e713d544d5d9eb705442aff5979f60882ff63ad0ef",
  "chunk_index": 6,
  "completed_at": "2026-10-21T10:58:27Z",
  "language": "zh",
  "live_id": "LIVE_20211210_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 5400,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 5403.58,
      "start": 5400.0,
      "text": "我怎麽要給你遊啊"
    },
    {
      "end": 5405.12,
      "start": 5403.58,
      "text": "伊朗他肯定去啊"
    },
    {
      "end": 5407.82,
      "start": 5405.12,
      "text": "北朝鮮我得去我得做主席台上"
    },
    {
      "end": 5409.82,
      "start": 5407.82,
      "text": "大家要記住"
    },
    {
      "end": 5414.34,
      "start": 5409.82,
      "text": "壞人和黑社會和白社會和好人之間"
    },
    {
      "end": 5415.88,
      "start": 5414.34,
      "text": "大家永遠就這個比例"
    },
    {
      "end": 5418.5,
      "start": 5415.88,
      "text": "就是永遠善良的人"
    },
    {
      "end": 5422.2,
      "start": 5418.5,
      "text": "善良的人和被人家剝削的人"
    },
    {
      "end": 5424.58,
      "start": 5422.2,
      "text": "和不參與的爭和鬥的人"
    },
    {
      "end": 5425.8,
      "start": 5424.58,
      "text": "就像那個橄欖一樣"
    },
    {
      "end": 5428.3,
      "start": 5425.8,
      "text": "就中間的99橄欖型的"
    },
    {
      "end": 5432.26,
      "start": 5428.3,
      "text": "橄欖的另外壹邊是極端的獨裁者"
    },
    {
      "end": 5433.7,
      "start": 5432.26,
      "text": "另外壹邊是壞人"
    },
    {
      "end": 5436.18,
      "start": 5433.7,
      "text": "就黑到白到兩頭"
    },
    {
      "end": 5437.42,
      "start": 5436.18,
      "text": "中間就是咱們老百姓"
    },
    {
      "end": 5439.3,
      "start": 5437.42,
      "text": "他永遠是這個概念的"
    },
    {
      "end": 5442.88,
      "start": 5439.3,
      "text": "當你發現人類走到今天的時候"
    },
    {
      "end": 5444.5,
      "start": 5442.88,
      "text": "你永遠發現"
    },
    {
      "end": 5451.18,
      "start": 5444.5,
      "text": "為什麽在斯大林、希特勒、日本天皇、莫索里尼、"
    },
    {
      "end": 5454.6,
      "start": 5451.18,
      "text": "中國、毛澤東、撒達姆、卡扎菲"
    },
    {
      "end": 5458.0,
      "start": 5454.6,
      "text": "你看看整個烏龐的阿明"
    },
    {
      "end": 5460.46,
      "start": 5458.0,
      "text": "包括印尼、蘇哈托"
    },
    {
      "end": 5462.96,
      "start": 5460.46,
      "text": "這個世界上壞人從來沒少過"
    },
    {
      "end": 5466.0,
      "start": 5462.96,
      "text": "而且你看看從1912年"
    },
    {
      "end": 5469.96,
      "start": 5466.0,
      "text": "中華人、中國人結束了封建統治"
    },
    {
      "end": 5474.4,
      "start": 5469.96,
      "text": "建立了當時的這個所謂的中華民國"
    },
    {
      "end": 5476.86,
      "start": 5474.4,
      "text": "一直到今天"
    },
    {
      "end": 5478.36,
      "start": 5476.86,
      "text": "100多年"
    },
    {
      "end": 5480.36,
      "start": 5478.36,
      "text": "你再看看世界的歷史"
    },
    {
      "end": 5482.4,
      "start": 5480.36,
      "text": "從1911年"
    },
    {
      "end": 5484.4,
      "start": 5482.4,
      "text": "一十大戰、二十大戰"
    },
    {
      "end": 5486.4,
      "start": 5484.4,
      "text": "然後到了整個197幾年的"
    },
    {
      "end": 5488.36,
      "start": 5486.4,
      "text": "烏龐的阿明還吃人肉呢"
    },
    {
      "end": 5493.32,
      "start": 5488.36,
      "text": "蘇印尼排華幾十萬人的大屠殺"
    },
    {
      "end": 5497.32,
      "start": 5493.32,
      "text": "然後薩達姆是九幾年幹掉的"
    },
    {
      "end": 5499.32,
      "start": 5497.32,
      "text": "卡扎菲也是九幾年幹掉的"
    },
    {
      "end": 5504.28,
      "start": 5499.32,
      "text": "就是人類上這種獨裁荒唐的事情從來沒少過"
    },
    {
      "end": 5506.28,
      "start": 5504.28,
      "text": "壞人永遠站壹邊"
    },
    {
      "end": 5509.28,
      "start": 5506.28,
      "text": "獨裁者所謂的已經統合法統治"
    },
    {
      "end": 5510.28,
      "start": 5509.28,
      "text": "永遠站壹邊"
    },
    {
      "end": 5511.78,
      "start": 5510.28,
      "text": "然後這一邊又成了壞人"
    },
    {
      "end": 5513.28,
      "start": 5511.78,
      "text": "它就像中間那個橄欖一樣"
    },
    {
      "end": 5516.28,
      "start": 5513.28,
      "text": "永遠九十幾的人被愚弄被欺壓的"
    },
    {
      "end": 5519.24,
      "start": 5516.28,
      "text": "大家必須要問壹個問題"
    },
    {
      "end": 5523.24,
      "start": 5519.24,
      "text": "人類從來沒有停止過獨裁、殺略、人吃人"
    },
    {
      "end": 5528.24,
      "start": 5523.24,
      "text": "人類從來沒有像今天這樣"
    },
    {
      "end": 5532.24,
      "start": 5528.24,
      "text": "絕大多數人竟然被共產主義給玩成這個樣子"
    },
    {
      "end": 5534.24,
      "start": 5532.24,
      "text": "妳要看共產黨這個奧運會有幾個因素"
    },
    {
      "end": 5536.24,
      "start": 5534.24,
      "text": "妳們大家要注意到啊"
    },
    {
      "end": 5539.24,
      "start": 5536.24,
      "text": "蘇聯被抵制奧運會"
    },
    {
      "end": 5541.24,
      "start": 5539.24,
      "text": "希特勒被抵制奧運會"
    },
    {
      "end": 5544.24,
      "start": 5541.24,
      "text": "是明確的跟西方對抗"
    },
    {
      "end": 5546.24,
      "start": 5544.24,
      "text": "甚至發生戰爭"
    },
    {
      "end": 5552.04,
      "start": 5546.28,
      "text": "冷戰、火戰、民族之戰、種族之戰"
    },
    {
      "end": 5554.04,
      "start": 5552.04,
      "text": "這都是很清楚的"
    },
    {
      "end": 5557.88,
      "start": 5554.04,
      "text": "只有這壹次共產黨沒有明確說出來"
    },
    {
      "end": 5561.48,
      "start": 5557.88,
      "text": "跟西方和世界有火戰、有冷戰"
    },
    {
      "end": 5564.44,
      "start": 5561.48,
      "text": "還要兩國共同治理世界呢"
    },
    {
      "end": 5566.72,
      "start": 5564.44,
      "text": "發起了這場抵制奧運會"
    },
    {
      "end": 5567.92,
      "start": 5566.72,
      "text": "這個是什麼情況下"
    },
    {
      "end": 5571.98,
      "start": 5567.92,
      "text": "是七哥2019年說我們讓它開不成"
    },
    {
      "end": 5576.24,
      "start": 5571.98,
      "text": "記住啊2019年的世界和今天2021年可是沒有病毒"
    },
    {
      "end": 5577.84,
      "start": 5576.24,
      "text": "沒有疫苗"
    },
    {
      "end": 5581.0,
      "start": 5577.84,
      "text": "那個時候全世界認為滅共是個笑話"
    },
    {
      "end": 5582.0,
      "start": 5581.0,
      "text": "是瘋子的想法"
    },
    {
      "end": 5585.0,
      "start": 5582.0,
      "text": "大家想想新中聯邦的牛是牛有多大"
    },
    {
      "end": 5589.12,
      "start": 5585.0,
      "text": "你們永遠中國人不懂得愛自己的偉大"
    },
    {
      "end": 5590.48,
      "start": 5589.12,
      "text": "永遠看著別人的好"
    },
    {
      "end": 5596.0,
      "start": 5590.48,
      "text": "而且中國人是全世界最容易忘掉悲哀和傷痛的民族"
    },
    {
      "end": 5601.76,
      "start": 5596.0,
      "text": "我們也願意很容易忘掉自己的輝煌歷史好處"
    },
    {
      "end": 5605.76,
      "start": 5601.76,
      "text": "你想想2019年我就告訴你奧運會長都開不成"
    },
    {
      "end": 5614.2,
      "start": 5605.76,
      "text": "那麼共產黨竟然在張家口河北北邊開發了一個城啊"
    },
    {
      "end": 5615.76,
      "start": 5614.2,
      "text": "東澳城啊"
    },
    {
      "end": 5619.44,
      "start": 5615.76,
      "text": "而且東澳會的開幕式就在盤古的隔壁"
    },
    {
      "end": 5621.04,
      "start": 5619.44,
      "text": "還有很多儀式"
    },
    {
      "end": 5626.0,
      "start": 5621.04,
      "text": "你們想想這跟七哥的關係有多深啊"
    },
    {
      "end": 5628.2,
      "start": 5626.0,
      "text": "跟那爆料革命有多深啊"
    },
    {
      "end": 5631.04,
      "start": 5628.2,
      "text": "龍頭變成了包頭了變成鳥頭了"
    },
    {
      "end": 5633.04,
      "start": 5631.04,
      "text": "馬上又開東澳會了"
    },
    {
      "end": 5640.64,
      "start": 5633.04,
      "text": "這個時候你發現2019年之後很快全世界知道冠狀病毒來了"
    },
    {
      "end": 5642.4,
      "start": 5640.64,
      "text": "習近平不出國了"
    },
    {
      "end": 5644.4,
      "start": 5642.4,
      "text": "然後疫苗災難來了"
    },
    {
      "end": 5649.04,
      "start": 5644.4,
      "text": "然後現在馬上共產黨給全人類帶來最好的禮物"
    },
    {
      "end": 5653.28,
      "start": 5649.04,
      "text": "讓所有人失去麵包讓你的車沒有油就是經濟災難"
    },
    {
      "end": 5654.64,
      "start": 5653.28,
      "text": "恒大七哥說對了吧"
    },
    {
      "end": 5658.08,
      "start": 5654.64,
      "text": "我只要東澳會一說你不去馬上讓你破產"
    },
    {
      "end": 5664.08,
      "start": 5658.08,
      "text": "據說銀行內部已經發完文了三年前"
    },
    {
      "end": 5670.48,
      "start": 5664.08,
      "text": "說讓恒大所有的值錢的東西都要歸銀行所有"
    },
    {
      "end": 5672.88,
      "start": 5670.48,
      "text": "第一償還者銀行"
    },
    {
      "end": 5676.88,
      "start": 5672.88,
      "text": "第二償還者大家是誰誰都沒想到"
    },
    {
      "end": 5680.88,
      "start": 5676.88,
      "text": "恒大國內的票據銀行"
    },
    {
      "end": 5682.72,
      "start": 5680.88,
      "text": "大家記住啊"
    },
    {
      "end": 5688.08,
      "start": 5682.72,
      "text": "第三由中央統一協調的境外債務人"
    },
    {
      "end": 5688.72,
      "start": 5688.08,
      "text": "記住啊"
    },
    {
      "end": 5690.72,
      "start": 5688.72,
      "text": "統一協調的就是誰呀"
    },
    {
      "end": 5692.32,
      "start": 5690.72,
      "text": "欠唐平的"
    },
    {
      "end": 5693.32,
      "start": 5692.32,
      "text": "欠維廉王的"
    },
    {
      "end": 5693.92,
      "start": 5693.32,
      "text": "欠Q妹的"
    },
    {
      "end": 5695.52,
      "start": 5693.92,
      "text": "欠你Rikard的錢一概不管"
    },
    {
      "end": 5697.12,
      "start": 5695.52,
      "text": "欠郭惠錢就更不能還了"
    },
    {
      "end": 5697.52,
      "start": 5697.12,
      "text": "是吧"
    },
    {
      "end": 5698.72,
      "start": 5697.52,
      "text": "安保洪惠天機"
    },
    {
      "end": 5699.42,
      "start": 5698.72,
      "text": "哎"
    },
    {
      "end": 5702.32,
      "start": 5699.42,
      "text": "這倆人能不能團結一下給你倆點錢"
    },
    {
      "end": 5705.32,
      "start": 5702.32,
      "text": "就要拿債務來搞什麼橋水啊"
    },
    {
      "end": 5706.32,
      "start": 5705.32,
      "text": "Ridelio啊"
    },
    {
      "end": 5707.72,
      "start": 5706.32,
      "text": "什麼黑石啊"
    },
    {
      "end": 5709.12,
      "start": 5707.72,
      "text": "是吧你多幹的事兒嘛"
    },
    {
      "end": 5710.72,
      "start": 5709.12,
      "text": "拿債務威脅別人"
    },
    {
      "end": 5711.36,
      "start": 5710.72,
      "text": "你看這個"
    },
    {
      "end": 5712.32,
      "start": 5711.36,
      "text": "最後"
    },
    {
      "end": 5713.72,
      "start": 5712.72,
      "text": "是什麼"
    },
    {
      "end": 5715.12,
      "start": 5713.72,
      "text": "把所有的"
    },
    {
      "end": 5717.32,
      "start": 5715.12,
      "text": "處理完這個幾個優先之後"
    },
    {
      "end": 5718.72,
      "start": 5717.32,
      "text": "把部分資產"
    },
    {
      "end": 5720.72,
      "start": 5718.72,
      "text": "歸還為當地政府"
    },
    {
      "end": 5722.72,
      "start": 5720.72,
      "text": "涉及到敏感的"
    },
    {
      "end": 5724.32,
      "start": 5722.72,
      "text": "所謂的造成"
    },
    {
      "end": 5727.12,
      "start": 5724.32,
      "text": "這個不良反應的社會的一些債務"
    },
    {
      "end": 5728.32,
      "start": 5727.12,
      "text": "最後"
    },
    {
      "end": 5729.52,
      "start": 5728.32,
      "text": "是個人"
    },
    {
      "end": 5734.32,
      "start": 5731.52,
      "text": "你去想想這個這個銀行發文這個多可怕"
    },
    {
      "end": 5735.52,
      "start": 5734.32,
      "text": "所以說你冬奧會完了"
    },
    {
      "end": 5738.32,
      "start": 5735.52,
      "text": "馬上你經濟叫你崩潰"
    },
    {
      "end": 5739.72,
      "start": 5738.32,
      "text": "共產黨這個"
    },
    {
      "end": 5741.36,
      "start": 5739.72,
      "text": "結果崩潰還不說"
    },
    {
      "end": 5743.36,
      "start": 5741.36,
      "text": "他要連蘇抗美"
    },
    {
      "end": 5744.36,
      "start": 5743.36,
      "text": "連蘇打臺"
    },
    {
      "end": 5745.96,
      "start": 5744.36,
      "text": "你去烏克蘭"
    },
    {
      "end": 5746.76,
      "start": 5745.96,
      "text": "我去台灣"
    },
    {
      "end": 5749.36,
      "start": 5747.36,
      "text": "然後讓讓日本跪下"
    },
    {
      "end": 5750.76,
      "start": 5749.36,
      "text": "竟然對印度"
    },
    {
      "end": 5752.36,
      "start": 5750.76,
      "text": "那竟然私下威脅說什麼話"
    },
    {
      "end": 5754.96,
      "start": 5752.36,
      "text": "我要在這個冬奧會上你抵制我"
    },
    {
      "end": 5756.36,
      "start": 5754.96,
      "text": "你敢發高聲"
    },
    {
      "end": 5760.36,
      "start": 5756.36,
      "text": "我現在我整個我會讓你在喜馬拉雅山周圍"
    },
    {
      "end": 5764.36,
      "start": 5760.36,
      "text": "你會感受無法想像的冬天的到來"
    },
    {
      "end": 5766.36,
      "start": 5764.36,
      "text": "甚至更多的病毒的傳染"
    },
    {
      "end": 5767.36,
      "start": 5766.36,
      "text": "直接說"
    },
    {
      "end": 5767.96,
      "start": 5767.36,
      "text": "給印度"
    },
    {
      "end": 5769.76,
      "start": 5767.96,
      "text": "我現在對著印度事情說的"
    },
    {
      "end": 5771.36,
      "start": 5769.76,
      "text": "印度人這傻眼了"
    },
    {
      "end": 5772.36,
      "start": 5771.36,
      "text": "你這啥意思"
    },
    {
      "end": 5774.36,
      "start": 5772.36,
      "text": "他說我們只要不幫你防毒"
    },
    {
      "end": 5775.36,
      "start": 5774.36,
      "text": "你毒就會越來越多呀"
    },
    {
      "end": 5776.36,
      "start": 5775.36,
      "text": "這機會就告訴你"
    },
    {
      "end": 5778.36,
      "start": 5776.36,
      "text": "老子就是放毒的"
    },
    {
      "end": 5781.36,
      "start": 5780.36,
      "text": "把印度給瞎著腿軟"
    },
    {
      "end": 5784.36,
      "start": 5783.36,
      "text": "對日本也記乎明了"
    },
    {
      "end": 5786.36,
      "start": 5784.36,
      "text": "說你們現在病毒控制的不錯呀"
    },
    {
      "end": 5787.36,
      "start": 5786.36,
      "text": "是吧"
    },
    {
      "end": 5789.36,
      "start": 5787.36,
      "text": "你知道明年會有什麼病毒啊"
    },
    {
      "end": 5790.36,
      "start": 5789.36,
      "text": "你要搞抵制奧運"
    },
    {
      "end": 5791.36,
      "start": 5790.36,
      "text": "你要敢公開證明的話"
    },
    {
      "end": 5794.36,
      "start": 5791.36,
      "text": "我這塊病毒可能就控制不了了"
    },
    {
      "end": 5797.36,
      "start": 5794.36,
      "text": "最近的咱可是友邦啊"
    },
    {
      "end": 5799.36,
      "start": 5797.36,
      "text": "受害者可能是你日本的"
    },
    {
      "end": 5803.36,
      "start": 5799.36,
      "text": "大家要看到就是共產黨在這些決定"
    },
    {
      "end": 5805.36,
      "start": 5803.36,
      "text": "冬奧會這時候"
    },
    {
      "end": 5808.36,
      "start": 5805.36,
      "text": "它建了一個成河北的張家口"
    },
    {
      "end": 5812.36,
      "start": 5809.36,
      "text": "造成了大概13萬億到15萬億美元的"
    },
    {
      "end": 5815.36,
      "start": 5812.36,
      "text": "人民幣的房地產GDP歸零"
    },
    {
      "end": 5820.36,
      "start": 5815.36,
      "text": "然後所有的在北京再造的"
    },
    {
      "end": 5822.36,
      "start": 5820.36,
      "text": "所謂奧運村要活起來"
    },
    {
      "end": 5825.36,
      "start": 5822.36,
      "text": "藉此機會要把北京城的五環一北"
    },
    {
      "end": 5827.36,
      "start": 5825.36,
      "text": "變成現代化商務中心"
    },
    {
      "end": 5831.36,
      "start": 5827.36,
      "text": "亞商行亞投行亞洲基礎建設銀行"
    },
    {
      "end": 5836.36,
      "start": 5833.36,
      "text": "所有的你看看從四環到五環"
    },
    {
      "end": 5838.36,
      "start": 5836.36,
      "text": "亞運沖開發區"
    },
    {
      "end": 5841.36,
      "start": 5838.36,
      "text": "六百萬平方米的鞋子樓幾乎是空的"
    },
    {
      "end": 5844.36,
      "start": 5841.36,
      "text": "從盤古五環到往外一直往北"
    },
    {
      "end": 5846.36,
      "start": 5844.36,
      "text": "大量的房地產開發"
    },
    {
      "end": 5847.36,
      "start": 5846.36,
      "text": "這次完全沒了"
    },
    {
      "end": 5851.36,
      "start": 5849.36,
      "text": "再想到行政姐妹們"
    },
    {
      "end": 5854.36,
      "start": 5851.36,
      "text": "共產黨你覺得它放毒疫苗"
    },
    {
      "end": 5856.36,
      "start": 5854.36,
      "text": "包括對世界的整個房地產"
    },
    {
      "end": 5858.36,
      "start": 5856.36,
      "text": "它難道不知道這幾百萬億"
    },
    {
      "end": 5860.36,
      "start": 5858.36,
      "text": "會給世界經濟帶來崩潰嗎"
    },
    {
      "end": 5861.36,
      "start": 5860.36,
      "text": "它都知道"
    },
    {
      "end": 5863.36,
      "start": 5861.36,
      "text": "它也它一定要記住"
    },
    {
      "end": 5866.36,
      "start": 5863.36,
      "text": "它竟然相信它冬奧會能開城"
    },
    {
      "end": 5867.36,
      "start": 5866.36,
      "text": "這個是重點"
    },
    {
      "end": 5872.36,
      "start": 5867.36,
      "text": "直到現在它也沒放棄"
    },
    {
      "end": 5873.36,
      "start": 5872.36,
      "text": "外交部能大膽說什麽"
    },
    {
      "end": 5877.36,
      "start": 5873.36,
      "text": "不歡迎外國來賓來參觀"
    },
    {
      "end": 5879.36,
      "start": 5877.36,
      "text": "就運動員可以來"
    },
    {
      "end": 5880.36,
      "start": 5879.36,
      "text": "來搞成績"
    },
    {
      "end": 5883.36,
      "start": 5880.36,
      "text": "但絕對不允許外邊來參觀"
    },
    {
      "end": 5886.36,
      "start": 5883.36,
      "text": "一參觀記者來了媒體來了怎麽辦呢"
    },
    {
      "end": 5887.36,
      "start": 5886.36,
      "text": "病毒怎麽辦呢"
    },
    {
      "end": 5888.36,
      "start": 5887.36,
      "text": "露餡怎麽辦呢"
    },
    {
      "end": 5891.36,
      "start": 5888.36,
      "text": "這是無如何的狂妄啊"
    },
    {
      "end": 5895.36,
      "start": 5893.36,
      "text": "我要跟安紅全家開戰"
    },
    {
      "end": 5898.36,
      "start": 5895.36,
      "text": "我要讓你安紅來參加我今天的晚餐"
    },
    {
      "end": 5900.36,
      "start": 5898.36,
      "text": "但你孩子你老公不能來"
    },
    {
      "end": 5902.36,
      "start": 5900.36,
      "text": "你來的時候你得進來"
    },
    {
      "end": 5905.36,
      "start": 5902.36,
      "text": "經過三周的quarantine"
    },
    {
      "end": 5907.36,
      "start": 5905.36,
      "text": "然後換上我的衣裳內褲胸罩"
    },
    {
      "end": 5910.36,
      "start": 5907.36,
      "text": "然後呢經過我們無數次陌生"
    },
    {
      "end": 5911.36,
      "start": 5910.36,
      "text": "是吧跟你講無數次"
    },
    {
      "end": 5913.36,
      "start": 5911.36,
      "text": "這是我宇宙無限大"
    },
    {
      "end": 5915.36,
      "start": 5913.36,
      "text": "地球是一滴沙的故事"
    },
    {
      "end": 5917.36,
      "start": 5915.36,
      "text": "然後你能進到屋子參加我的晚餐"
    },
    {
      "end": 5919.36,
      "start": 5917.36,
      "text": "而你家人這個中間不能給你打電話"
    },
    {
      "end": 5924.36,
      "start": 5920.36,
      "text": "這是何等的狂妄可比前蘇聯希特勒狂妄得多了"
    },
    {
      "end": 5927.36,
      "start": 5924.36,
      "text": "當年希特勒蘇聯都做了什麽了"
    },
    {
      "end": 5929.36,
      "start": 5927.36,
      "text": "俄羅斯人不跟任何人爭冠軍"
    },
    {
      "end": 5930.36,
      "start": 5929.36,
      "text": "只要你們來"
    },
    {
      "end": 5932.36,
      "start": 5930.36,
      "text": "你們拿到一個獎牌乘以五"
    },
    {
      "end": 5934.36,
      "start": 5932.36,
      "text": "啥叫乘以五啊"
    },
    {
      "end": 5940.36,
      "start": 5934.36,
      "text": "你得到一塊獎牌等同一五倍的黃金價值的獎勵我給你"
    },
    {
      "end": 5942.36,
      "start": 5940.36,
      "text": "就這人家都不去"
    },
    {
      "end": 5944.36,
      "start": 5942.36,
      "text": "現在共產黨現在經常玩這什麽"
    },
    {
      "end": 5945.36,
      "start": 5944.36,
      "text": "你來"
    },
    {
      "end": 5947.36,
      "start": 5945.36,
      "text": "運動員我給你五到十倍"
    },
    {
      "end": 5949.36,
      "start": 5947.36,
      "text": "但是你國家的公民不能來"
    },
    {
      "end": 5951.36,
      "start": 5949.36,
      "text": "記者不能來"
    },
    {
      "end": 5952.36,
      "start": 5951.36,
      "text": "他怕誰呀"
    },
    {
      "end": 5953.36,
      "start": 5952.36,
      "text": "他怕的是記者"
    },
    {
      "end": 5955.36,
      "start": 5953.36,
      "text": "怕的是西方有良知的人"
    },
    {
      "end": 5958.36,
      "start": 5955.36,
      "text": "這是如此之狂妄啊"
    },
    {
      "end": 5961.36,
      "start": 5958.36,
      "text": "全世界威脅呀"
    },
    {
      "end": 5966.36,
      "start": 5961.36,
      "text": "這個事兒大到什麽程度人類前所未有"
    },
    {
      "end": 5969.36,
      "start": 5966.36,
      "text": "據說俄羅斯的普京說"
    },
    {
      "end": 5973.36,
      "start": 5969.36,
      "text": "我對習近平和共產黨的對全世界的野心"
    },
    {
      "end": 5976.36,
      "start": 5973.36,
      "text": "和他們的無恥和愚蠢"
    },
    {
      "end": 5980.36,
      "start": 5976.36,
      "text": "都讓我超出了我當初的所有預估"
    },
    {
      "end": 5982.36,
      "start": 5980.36,
      "text": "就是普京"
    },
    {
      "end": 5984.36,
      "start": 5982.36,
      "text": "普京按說的一句話"
    },
    {
      "end": 5986.36,
      "start": 5984.36,
      "text": "這個杯子裏的耐心"
    },
    {
      "end": 5988.36,
      "start": 5986.36,
      "text": "杯子裏的耐心"
    },
    {
      "end": 5989.36,
      "start": 5988.36,
      "text": "一個杯子裏的耐心"
    },
    {
      "end": 5991.36,
      "start": 5989.36,
      "text": "老子就給你玩杯子耐心"
    },
    {
      "end": 5994.36,
      "start": 5991.36,
      "text": "現在普京講了一句更著名的話"
    },
    {
      "end": 5996.36,
      "start": 5994.36,
      "text": "說跟美國人私下說的時候"
    },
    {
      "end": 5998.36,
      "start": 5996.36,
      "text": "說我們對待中國人"
    },
    {
      "end": 5999.36,
      "start": 5998.36,
      "text": "就是人家很明確的"
    },
    {
      "end": 6000.36,
      "start": 5999.36,
      "text": "不跟你們說中國人"
    },
    {
      "end": 6005.36,
      "start": 6000.36,
      "text": "中國人對習近平和中國這個國家的未來的走向"
    },
    {
      "end": 6008.36,
      "start": 6005.36,
      "text": "我們是完全已經沒有任何耐心"
    },
    {
      "end": 6009.36,
      "start": 6008.36,
      "text": "不抱任何幻想"
    },
    {
      "end": 6011.36,
      "start": 6009.36,
      "text": "我們跟你西方不一樣"
    },
    {
      "end": 6015.36,
      "start": 6013.36,
      "text": "戰友們這句話"
    },
    {
      "end": 6016.36,
      "start": 6015.36,
      "text": "這個普京絕對是你要在乎"
    },
    {
      "end": 6017.36,
      "start": 6016.36,
      "text": "這人是個天才"
    },
    {
      "end": 6018.36,
      "start": 6017.36,
      "text": "絕對是天才"
    },
    {
      "end": 6022.36,
      "start": 6018.36,
      "text": "一百個習近平跟普京的政治智慧比"
    },
    {
      "end": 6023.36,
      "start": 6022.36,
      "text": "那都不是一個層次"
    },
    {
      "end": 6025.36,
      "start": 6023.36,
      "text": "相當於搞音樂"
    },
    {
      "end": 6028.36,
      "start": 6025.36,
      "text": "我和Q妹和唐平威廉要搞音樂一樣"
    },
    {
      "end": 6029.36,
      "start": 6028.36,
      "text": "我啥也不是"
    },
    {
      "end": 6031.36,
      "start": 6029.36,
      "text": "就我在他撒面前我能搞音樂"
    },
    {
      "end": 6033.36,
      "start": 6031.36,
      "text": "那他撒我屁音樂搞不成"
    },
    {
      "end": 6034.36,
      "start": 6033.36,
      "text": "打什麼榜"
    },
    {
      "end": 6035.36,
      "start": 6034.36,
      "text": "是不是"
    },
    {
      "end": 6036.36,
      "start": 6035.36,
      "text": "打我們現成的榜都打不成"
    },
    {
      "end": 6040.36,
      "start": 6038.36,
      "text": "這個普京這話說到的"
    },
    {
      "end": 6041.36,
      "start": 6040.36,
      "text": "他對習近平的這種"
    },
    {
      "end": 6043.36,
      "start": 6041.36,
      "text": "對共產黨的全世界的野心"
    },
    {
      "end": 6045.36,
      "start": 6043.36,
      "text": "他沒有想到的"
    },
    {
      "end": 6046.36,
      "start": 6045.36,
      "text": "他真的發現"
    },
    {
      "end": 6047.36,
      "start": 6046.36,
      "text": "他原來以為吹吹牛"
    },
    {
      "end": 6048.36,
      "start": 6047.36,
      "text": "共產黨就是吹牛"
    },
    {
      "end": 6049.36,
      "start": 6048.36,
      "text": "他們說"
    },
    {
      "end": 6050.36,
      "start": 6049.36,
      "text": "他們就說"
    },
    {
      "end": 6051.36,
      "start": 6050.36,
      "text": "跟他玩兒吧"
    },
    {
      "end": 6052.36,
      "start": 6051.36,
      "text": "再把錢拿回來再說"
    },
    {
      "end": 6054.36,
      "start": 6052.36,
      "text": "簽上兩個4500億的合同"
    },
    {
      "end": 6055.36,
      "start": 6054.36,
      "text": "天然寄油"
    },
    {
      "end": 6057.36,
      "start": 6056.36,
      "text": "現在真的發現"
    },
    {
      "end": 6059.36,
      "start": 6057.36,
      "text": "共產黨想幹全世界"
    },
    {
      "end": 6061.36,
      "start": 6059.36,
      "text": "真的要幹別美國"
    },
    {
      "end": 6062.36,
      "start": 6061.36,
      "text": "真的要領導權人類"
    },
    {
      "end": 6063.36,
      "start": 6062.36,
      "text": "他也傻眼了"
    },
    {
      "end": 6067.36,
      "start": 6063.36,
      "text": "他的野心和愚蠢都超出他的預期的選項"
    },
    {
      "end": 6069.36,
      "start": 6067.36,
      "text": "對中國人對這個世界的未來"
    },
    {
      "end": 6070.36,
      "start": 6069.36,
      "text": "中國人的未來"
    },
    {
      "end": 6071.36,
      "start": 6070.36,
      "text": "不抱有任何關係"
    },
    {
      "end": 6078.36,
      "start": 6071.36,
      "text": "這是現在習近平絕對沒想到的"
    },
    {
      "end": 6081.36,
      "start": 6079.36,
      "text": "你知道習近平和普京是什麼關係嗎"
    },
    {
      "end": 6082.36,
      "start": 6081.36,
      "text": "我告訴大家"
    },
    {
      "end": 6084.36,
      "start": 6082.36,
      "text": "普京的女朋友"
    },
    {
      "end": 6088.36,
      "start": 6085.36,
      "text": "每一周最起碼一個月兩次"
    },
    {
      "end": 6091.36,
      "start": 6088.36,
      "text": "從俄羅斯飛機飛到索契"
    },
    {
      "end": 6092.36,
      "start": 6091.36,
      "text": "就是下都"
    },
    {
      "end": 6094.36,
      "start": 6092.36,
      "text": "從索契再換一架飛機"
    },
    {
      "end": 6095.36,
      "start": 6094.36,
      "text": "完全是密飛"
    },
    {
      "end": 6096.36,
      "start": 6095.36,
      "text": "國一國直接是密飛"
    },
    {
      "end": 6098.36,
      "start": 6096.36,
      "text": "就直接是軍人飛機過來"
    },
    {
      "end": 6100.36,
      "start": 6098.36,
      "text": "沒有什麼代碼尾碼就過來"
    },
    {
      "end": 6103.36,
      "start": 6100.36,
      "text": "從北京直接或者飛西苑機場"
    },
    {
      "end": 6105.36,
      "start": 6103.36,
      "text": "原來都飛北京首都機場"
    },
    {
      "end": 6106.36,
      "start": 6105.36,
      "text": "由於我報海航事以後"
    },
    {
      "end": 6108.36,
      "start": 6106.36,
      "text": "改為西郊機場"
    },
    {
      "end": 6109.36,
      "start": 6108.36,
      "text": "軍事機場"
    },
    {
      "end": 6110.36,
      "start": 6109.36,
      "text": "下來以後"
    },
    {
      "end": 6113.36,
      "start": 6110.36,
      "text": "這個姐妹穿的都是這麼高跟鞋"
    },
    {
      "end": 6115.36,
      "start": 6113.36,
      "text": "因為他當軍人出身"
    },
    {
      "end": 6116.36,
      "start": 6115.36,
      "text": "然後呢"
    },
    {
      "end": 6118.36,
      "start": 6116.36,
      "text": "小胸挺著"
    },
    {
      "end": 6120.36,
      "start": 6118.36,
      "text": "咔咔咔拎著文件包"
    },
    {
      "end": 6122.36,
      "start": 6120.36,
      "text": "這一手拎著是自己吃的東西"
    },
    {
      "end": 6124.36,
      "start": 6122.36,
      "text": "從來不吃北京的任何一個東西"
    },
    {
      "end": 6127.36,
      "start": 6124.36,
      "text": "都是帶自己的火腿自己吃的"
    },
    {
      "end": 6130.36,
      "start": 6127.36,
      "text": "其他的人都是習遠平安排替代"
    },
    {
      "end": 6133.36,
      "start": 6130.36,
      "text": "連丁薛祥都輪不著"
    },
    {
      "end": 6135.36,
      "start": 6133.36,
      "text": "這哥們直接去跟這些"
    },
    {
      "end": 6136.36,
      "start": 6135.36,
      "text": "都跟習當面談"
    },
    {
      "end": 6138.36,
      "start": 6136.36,
      "text": "把普京的話傳完"
    },
    {
      "end": 6139.36,
      "start": 6138.36,
      "text": "然後該簽的簽"
    },
    {
      "end": 6140.36,
      "start": 6139.36,
      "text": "該說的說完"
    },
    {
      "end": 6141.36,
      "start": 6140.36,
      "text": "扭著回去"
    },
    {
      "end": 6144.36,
      "start": 6142.36,
      "text": "習這邊誰去呢"
    },
    {
      "end": 6147.36,
      "start": 6144.36,
      "text": "偶爾習遠平去一去"
    },
    {
      "end": 6149.36,
      "start": 6147.36,
      "text": "曾經派楊介石傳過話"
    },
    {
      "end": 6151.36,
      "start": 6149.36,
      "text": "後來不讓楊介石參與"
    },
    {
      "end": 6152.36,
      "start": 6151.36,
      "text": "這是兩個人之間"
    },
    {
      "end": 6155.36,
      "start": 6152.36,
      "text": "他去俄羅斯"
    },
    {
      "end": 6156.36,
      "start": 6155.36,
      "text": "俄羅斯普京來這邊"
    },
    {
      "end": 6158.36,
      "start": 6156.36,
      "text": "都是這兩個個人之間溝通"
    },
    {
      "end": 6160.36,
      "start": 6158.36,
      "text": "好到這樣的程度"
    },
    {
      "end": 6165.36,
      "start": 6160.36,
      "text": "拿了一萬億美元的現金給了俄羅斯"
    },
    {
      "end": 6166.36,
      "start": 6165.36,
      "text": "就是要抗美"
    },
    {
      "end": 6168.36,
      "start": 6166.36,
      "text": "就是所謂的十年大戰略"
    },
    {
      "end": 6170.36,
      "start": 6168.36,
      "text": "習近平修憲"
    },
    {
      "end": 6172.36,
      "start": 6170.36,
      "text": "我修憲你修憲"
    },
    {
      "end": 6174.36,
      "start": 6172.36,
      "text": "我接著幹你接著幹"
    },
    {
      "end": 6176.36,
      "start": 6174.36,
      "text": "你弄烏克蘭我弄台灣"
    },
    {
      "end": 6177.36,
      "start": 6176.36,
      "text": "咱倆一起幹美國"
    },
    {
      "end": 6179.36,
      "start": 6177.36,
      "text": "然後歐洲"
    },
    {
      "end": 6181.36,
      "start": 6179.36,
      "text": "我取錢你取地"
    },
    {
      "end": 6182.36,
      "start": 6181.36,
      "text": "你取地"
    },
    {
      "end": 6183.36,
      "start": 6182.36,
      "text": "阻止歐北歐東闊"
    },
    {
      "end": 6184.36,
      "start": 6183.36,
      "text": "非洲是我的"
    },
    {
      "end": 6185.36,
      "start": 6184.36,
      "text": "中東是你的"
    },
    {
      "end": 6187.36,
      "start": 6185.36,
      "text": "然後中東咱倆一起分遊"
    },
    {
      "end": 6188.36,
      "start": 6187.36,
      "text": "你看"
    },
    {
      "end": 6190.36,
      "start": 6188.36,
      "text": "這都是給個兩聲好的"
    },
    {
      "end": 6192.36,
      "start": 6191.36,
      "text": "所以在這個東奧會上"
    },
    {
      "end": 6193.36,
      "start": 6192.36,
      "text": "俄羅斯也傻眼了"
    },
    {
      "end": 6195.36,
      "start": 6193.36,
      "text": "說你讓我去參加去"
    },
    {
      "end": 6196.36,
      "start": 6195.36,
      "text": "我這運動員去"
    },
    {
      "end": 6198.36,
      "start": 6196.36,
      "text": "我國家政府官員去"
    },
    {
      "end": 6199.36,
      "start": 6198.36,
      "text": "你給我啥呀"
    },
    {
      "end": 6200.36,
      "start": 6199.36,
      "text": "五倍成十倍"
    },
    {
      "end": 6202.36,
      "start": 6200.36,
      "text": "我可不圖這個"
    },
    {
      "end": 6203.36,
      "start": 6202.36,
      "text": "我要圖更多的"
    },
    {
      "end": 6205.36,
      "start": 6203.36,
      "text": "圖什麼"
    },
    {
      "end": 6206.36,
      "start": 6205.36,
      "text": "再簽個四千億的合同"
    },
    {
      "end": 6208.36,
      "start": 6206.36,
      "text": "你看著啊"
    },
    {
      "end": 6210.36,
      "start": 6208.36,
      "text": "馬上俄羅斯跟中國要簽合同了"
    },
    {
      "end": 6212.36,
      "start": 6210.36,
      "text": "冬奧會之前"
    },
    {
      "end": 6213.36,
      "start": 6212.36,
      "text": "簽完合同"
    },
    {
      "end": 6214.36,
      "start": 6213.36,
      "text": "付百分之五十"
    },
    {
      "end": 6216.36,
      "start": 6214.36,
      "text": "俄羅斯這個不跟你玩別的"
    },
    {
      "end": 6217.36,
      "start": 6216.36,
      "text": "不像路打腦袋"
    },
    {
      "end": 6218.36,
      "start": 6217.36,
      "text": "是要演傻叉"
    },
    {
      "end": 6219.36,
      "start": 6218.36,
      "text": "是吧"
    },
    {
      "end": 6220.36,
      "start": 6219.36,
      "text": "那房子他要過戶去"
    },
    {
      "end": 6221.36,
      "start": 6220.36,
      "text": "他拿不回來了"
    },
    {
      "end": 6222.36,
      "start": 6221.36,
      "text": "是不是啊"
    },
    {
      "end": 6223.36,
      "start": 6222.36,
      "text": "一鳥在手"
    },
    {
      "end": 6225.36,
      "start": 6223.36,
      "text": "比萬鳥在林好得多"
    },
    {
      "end": 6226.36,
      "start": 6225.36,
      "text": "俄羅斯永遠是哲學"
    },
    {
      "end": 6227.36,
      "start": 6226.36,
      "text": "一鳥在手"
    },
    {
      "end": 6228.36,
      "start": 6227.36,
      "text": "比萬鳥在林"
    },
    {
      "end": 6229.36,
      "start": 6228.36,
      "text": "老子先拿百分之五十"
    },
    {
      "end": 6231.36,
      "start": 6229.36,
      "text": "先給我拿走"
    },
    {
      "end": 6236.36,
      "start": 6231.36,
      "text": "這就是現在整個中國到這個時候你會發現什麼"
    },
    {
      "end": 6238.36,
      "start": 6236.36,
      "text": "因為他仰仗俄羅斯"
    },
    {
      "end": 6242.36,
      "start": 6238.36,
      "text": "因為他習近平相信跟俄羅斯達成的協議"
    },
    {
      "end": 6244.36,
      "start": 6242.36,
      "text": "我真的能統治全世界"
    },
    {
      "end": 6246.36,
      "start": 6244.36,
      "text": "萬邦來朝"
    },
    {
      "end": 6249.36,
      "start": 6247.36,
      "text": "冬奧會的政治資產"
    },
    {
      "end": 6251.36,
      "start": 6249.36,
      "text": "就形成了世界上"
    },
    {
      "end": 6254.36,
      "start": 6251.36,
      "text": "我習近平是世界上受尊重的國家"
    },
    {
      "end": 6256.36,
      "start": 6254.36,
      "text": "受尊重的領導人"
    },
    {
      "end": 6262.36,
      "start": 6256.36,
      "text": "我是世界上當年2012年和2015年在北京搞的"
    },
    {
      "end": 6265.36,
      "start": 6262.36,
      "text": "叫世界最大的黨派的會"
    },
    {
      "end": 6267.36,
      "start": 6265.36,
      "text": "記得嗎當時習近平出席"
    },
    {
      "end": 6270.36,
      "start": 6267.36,
      "text": "我是世界上最大的黨"
    },
    {
      "end": 6271.36,
      "start": 6270.36,
      "text": "習近平在最大黨派"
    },
    {
      "end": 6273.36,
      "start": 6271.36,
      "text": "關掉攝像機說過一句話"
    },
    {
      "end": 6276.36,
      "start": 6273.36,
      "text": "我們不但要成為世界上最大的黨"
    },
    {
      "end": 6278.36,
      "start": 6276.36,
      "text": "我們要成為你們最好的兄弟"
    },
    {
      "end": 6284.36,
      "start": 6278.36,
      "text": "我們不僅是全天候的兄弟戰略夥伴關係"
    },
    {
      "end": 6285.36,
      "start": 6284.36,
      "text": "這就是結盟了"
    },
    {
      "end": 6287.36,
      "start": 6285.36,
      "text": "我們還是你們可信賴的"
    },
    {
      "end": 6289.36,
      "start": 6287.36,
      "text": "經濟上"
    },
    {
      "end": 6290.36,
      "start": 6289.36,
      "text": "安全上"
    },
    {
      "end": 6292.36,
      "start": 6290.36,
      "text": "文化上"
    },
    {
      "end": 6293.36,
      "start": 6292.36,
      "text": "可信賴的老大哥"
    },
    {
      "end": 6295.36,
      "start": 6293.36,
      "text": "他自稱老大了"
    },
    {
      "end": 6296.36,
      "start": 6295.36,
      "text": "我說老大哥"
    },
    {
      "end": 6297.36,
      "start": 6296.36,
      "text": "咱們是兄弟姐妹啊"
    },
    {
      "end": 6299.36,
      "start": 6297.36,
      "text": "你不能叫七哥"
    },
    {
      "end": 6300.36,
      "start": 6299.36,
      "text": "通成大哥"
    }
