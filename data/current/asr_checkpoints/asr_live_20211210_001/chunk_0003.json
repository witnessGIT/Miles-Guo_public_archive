    {
      "end": 2887.52,
      "start": 2886.56,
      "text": "您请"
    },
    {
      "end": 2890.08,
      "start": 2887.52,
      "text": "好的 谢谢啊"
    },
    {
      "end": 2891.24,
      "start": 2890.08,
      "text": "就是那个"
    },
    {
      "end": 2893.18,
      "start": 2891.24,
      "text": "就是这个歌曲的力量"
    },
    {
      "end": 2894.42,
      "start": 2893.18,
      "text": "真的是非常大的"
    },
    {
      "end": 2896.98,
      "start": 2894.42,
      "text": "虽然我自己不怎么懂的音乐"
    },
    {
      "end": 2900.52,
      "start": 2896.98,
      "text": "但是我们家那个小战友就在他身上"
