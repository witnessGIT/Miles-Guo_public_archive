      "text": "全部都是這樣"
    },
    {
      "end": 3820.2,
      "start": 3816.8,
      "text": "從PAP 新奧爾良到哪去了"
    },
    {
      "end": 3823.8,
      "start": 3820.2,
      "text": "然後就直接就擴散到了美國的中西部"
    },
    {
      "end": 3827.3,
      "start": 3823.8,
      "text": "中西部這個時候就開始有什麼"
    },
    {
      "end": 3829.3,
      "start": 3827.3,
      "text": "大家最注意的"
    },
    {
      "end": 3830.5,
      "start": 3829.3,
      "text": "什麼Rock"
    },
    {
      "end": 3831.5,
      "start": 3830.5,
      "text": "搖滾"
    },
    {
      "end": 3832.5,
      "start": 3831.5,
      "text": "後來就是"
    },
    {
      "end": 3834.3,
      "start": 3832.5,
      "text": "我的名字這個來源"
    },
    {
      "end": 3835.4,
      "start": 3834.3,
      "text": "Miles Daewy"
    },
    {
      "end": 3836.8,
      "start": 3835.4,
      "text": "吹薩克斯"
    },
    {
      "end": 3838.2,
      "start": 3836.8,
      "text": "他這"
    },
    {
      "end": 3840.1,
      "start": 3838.2,
      "text": "薩克斯吹完以後"
    },
    {
      "end": 3841.7,
      "start": 3840.1,
      "text": "就實行了這所謂的"
    },
    {
      "end": 3845.3,
