      "text": "用嘴塊的"
    },
    {
      "end": 3877.6,
      "start": 3875.1,
      "text": "然後到了休斯頓"
    },
    {
      "end": 3879.1,
      "start": 3877.6,
      "text": "然後到了這個"
    },
    {
      "end": 3879.6,
      "start": 3879.1,
      "text": "這個"
    },
    {
      "end": 3880.1,
