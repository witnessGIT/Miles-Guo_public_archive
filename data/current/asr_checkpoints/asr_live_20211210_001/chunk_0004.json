      "text": "誕生了美國的黑人樂"
    },
    {
      "end": 3847.8,
      "start": 3846.9,
      "text": "然後就變成什麼"
    },
    {
      "end": 3848.8,
      "start": 3847.8,
      "text": "搖屁股"
    },
    {
      "end": 3850.9,
      "start": 3848.8,
      "text": "1932年"
    },
    {
      "end": 3854.4,
      "start": 3850.9,
      "text": "到1950年和到1965年之前"
    },
    {
      "end": 3855.9,
      "start": 3854.4,
      "text": "整個美國黑人音樂"
    },
    {
      "end": 3856.7,
      "start": 3855.9,
      "text": "最流行的"
    },
    {
      "end": 3857.9,
      "start": 3856.7,
      "text": "你去看看那個屁股窯子"
    },
    {
      "end": 3859.4,
      "start": 3857.9,
      "text": "女的就那個屁股"
    },
    {
      "end": 3860.8,
      "start": 3859.4,
      "text": "晃"
    },
    {
      "end": 3861.8,
      "start": 3860.8,
      "text": "一直晃屁股"
    },
    {
      "end": 3863.4,
      "start": 3861.8,
      "text": "晃到就像那個研究蛇一樣"
    },
    {
      "end": 3864.2,
      "start": 3863.4,
      "text": "啊"
    },
    {
      "end": 3865.4,
      "start": 3864.2,
      "text": "所有的那邊"
    },
    {
      "end": 3866.4,
      "start": 3865.4,
      "text": "晃屁股"
    },
    {
      "end": 3868.5,
      "start": 3866.4,
      "text": "就打了吸毒"
    },
    {
      "end": 3869.0,
      "start": 3868.5,
      "text": "販毒"
    },
    {
      "end": 3872.0,
