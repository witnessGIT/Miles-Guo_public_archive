    {
      "avg_logprob": -0.32262,
      "compression_ratio": 1.241228,
      "end": 5467.1,
      "no_speech_prob": 0.0,
      "start": 5464.8,
      "text": "大姐說他飯不用吃了 他說文正咱俩以後不認識"
