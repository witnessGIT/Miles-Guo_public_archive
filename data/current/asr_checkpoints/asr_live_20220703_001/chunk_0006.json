    {
      "avg_logprob": -0.250835,
      "compression_ratio": 1.240642,
      "end": 5499.2,
      "no_speech_prob": 0.0,
      "start": 5495.0,
      "text": "就吳征一次又一次的脫逃 一次又一次的騙人"
