    {
      "avg_logprob": -0.32262,
      "compression_ratio": 1.241228,
      "end": 5477.8,
      "no_speech_prob": 0.0,
      "start": 5474.8,
      "text": "我為你 我給你帶來了禮物"
    },
    {
      "avg_logprob": -0.250835,
      "compression_ratio": 1.240642,
      "end": 5482.5,
      "no_speech_prob": 0.0,
      "start": 5477.8,
      "text": "真給他帶來了禮物 不是假的 這就是吳征這小子厲害"
