    {
      "avg_logprob": -0.250835,
      "compression_ratio": 1.240642,
      "end": 5486.6,
      "no_speech_prob": 0.0,
      "start": 5482.5,
      "text": "一正一邪啊 說共產黨想定你什麼產品"
