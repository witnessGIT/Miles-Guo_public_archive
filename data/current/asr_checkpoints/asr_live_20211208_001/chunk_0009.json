    {
      "end": 8385.56,
      "start": 8384.46,
      "text": "还重生了"
    },
    {
      "end": 8387.86,
      "start": 8385.56,
      "text": "Gnews越来越强大"
    },
    {
      "end": 8389.46,
      "start": 8387.86,
      "text": "盖特越来越强大"
    },
    {
      "end": 8391.46,
      "start": 8389.46,
      "text": "G club人越来越多"
    },
    {
      "end": 8392.96,
      "start": 8391.46,
      "text": "从几百几千几万"
    },
    {
      "end": 8394.96,
      "start": 8392.96,
      "text": "现在马上到几十万进展了"
