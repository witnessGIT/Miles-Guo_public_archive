      "start": 8202.5,
      "text": "560万尺的房子"
    },
    {
      "end": 8206.14,
      "start": 8205.36,
      "text": "你接管走了"
    },
    {
      "end": 8208.92,
      "start": 8206.14,
      "text": "你以这种流氓的名义"
    },
    {
      "end": 8210.98,
