    },
    {
      "end": 8424.56,
      "start": 8422.96,
      "text": "他没有的我们都有"
    },
    {
      "end": 8428.56,
      "start": 8424.56,
      "text": "他只剩下一招去打台湾了"
    },
    {
      "end": 8431.16,
      "start": 8428.56,
      "text": "他只剩下一招他把我爹给顿了"
    },
    {
      "end": 8433.16,
      "start": 8431.16,
      "text": "你还能干啥呢"
    },
    {
      "end": 8434.76,
      "start": 8433.16,
      "text": "你还能干啥呢"
    },
    {
      "end": 8435.46,
      "start": 8434.76,
      "text": "共产党"
    },
    {
