    },
    {
      "end": 8195.14,
      "start": 8193.94,
      "text": "带着金鱼"
    },
    {
      "end": 8197.3,
      "start": 8195.14,
      "text": "以物业管理不善为名"
    },
    {
      "end": 8198.76,
      "start": 8197.3,
      "text": "接管七星酒店"
    },
    {
      "end": 8200.84,
      "start": 8198.76,
      "text": "盘古公寓所有业主"
    },
    {
      "end": 8202.5,
      "start": 8200.84,
