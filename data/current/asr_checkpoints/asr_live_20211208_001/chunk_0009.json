    {
      "end": 8399.86,
      "start": 8398.46,
      "text": "来个洗币洗美元"
    },
    {
      "end": 8400.86,
      "start": 8399.86,
      "text": "他更害怕了"
    },
    {
      "end": 8402.36,
      "start": 8400.86,
      "text": "他知道意味着什么"
    },
    {
      "end": 8408.16,
      "start": 8402.36,
      "text": "法治基金的捐款是我们第一个在全世界上"
    },
    {
      "end": 8409.96,
      "start": 8408.16,
      "text": "劝大家不捐款的"
