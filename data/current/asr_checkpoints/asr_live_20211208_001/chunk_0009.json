      "start": 8210.98,
      "text": "零下四度"
    },
    {
      "end": 8213.62,
      "start": 8211.96,
      "text": "连个鞋不让他穿"
    },
    {
      "end": 8214.5,
      "start": 8213.62,
      "text": "问你一句"
    },
    {
      "end": 8215.5,
      "start": 8214.5,
      "text": "你就拿枪拖打他"
    },
    {
      "end": 8217.74,
      "start": 8215.5,
      "text": "天下"
