    {
      "end": 8374.42,
      "start": 8371.66,
      "text": "我就原话告诉他"
    },
    {
      "end": 8376.26,
      "start": 8374.42,
      "text": "你儿子你姑娘事情我保证不谈"
    },
    {
      "end": 8381.46,
      "start": 8376.26,
      "text": "我知道共产党他觉得我们这段赢得太多了"
