    {
      "end": 8219.26,
      "start": 8217.74,
      "text": "在阿富汗"
    },
    {
      "end": 8222.26,
      "start": 8219.26,
      "text": "在北朝鲜能这样吗"
    },
    {
      "end": 8225.28,
