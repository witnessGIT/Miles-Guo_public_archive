    {
      "end": 8102.0,
      "start": 8100.0,
      "text": "没有一个哥哥联系我"
    },
    {
      "end": 8104.0,
      "start": 8102.0,
      "text": "我就是不想牵累他们"
    },
    {
      "end": 8105.88,
      "start": 8104.0,
      "text": "就这样"
    },
    {
      "end": 8109.2,
      "start": 8105.88,
      "text": "我跟我家人一次都没有联系"
    },
    {
      "end": 8112.06,
      "start": 8109.2,
      "text": "同样盘古玉达坚守着"
    },
    {
      "end": 8113.48,
      "start": 8112.06,
      "text": "养着员工"
    },
    {
      "end": 8116.36,
      "start": 8113.48,
      "text": "有将近几亿的产职"
    },
    {
      "end": 8119.02,
      "start": 8116.36,
      "text": "养活着这么多员工和家人"
    },
    {
      "end": 8122.4,
      "start": 8119.02,
      "text": "这些孩子很多人供房供车带"
    },
    {
      "end": 8124.2,
      "start": 8122.4,
      "text": "就那天被撵着大家全傻眼"
    },
    {
      "end": 8126.02,
      "start": 8124.2,
      "text": "因为他们下个月都不知道该怎么活"
    },
    {
      "end": 8129.12,
      "start": 8126.02,
      "text": "我们是真是为这些员工负责任"
    },
    {
      "end": 8130.64,
      "start": 8129.12,
      "text": "我也为了家人负责任"
    },
    {
      "end": 8131.56,
      "start": 8130.64,
      "text": "我一次不联系"
    },
    {
      "end": 8132.86,
      "start": 8131.56,
      "text": "我一次联系都没有"
    },
    {
      "end": 8134.14,
      "start": 8132.86,
      "text": "招有妹妹你还可以加油"
    },
    {
      "end": 8134.96,
      "start": 8134.14,
      "text": "我一次都没有"
    },
    {
      "end": 8138.02,
      "start": 8134.96,
      "text": "就这共产党都不放过你"
    },
    {
      "end": 8141.42,
      "start": 8138.02,
      "text": "就这给他赚了六个亿"
    },
    {
      "end": 8143.3,
      "start": 8141.42,
      "text": "养着这些员工"
    },
    {
      "end": 8144.56,
      "start": 8143.3,
      "text": "他也不放过你"
    },
    {
      "end": 8149.06,
      "start": 8144.56,
      "text": "就这这些无辜的员工"
    },
    {
      "end": 8152.0,
      "start": 8149.06,
      "text": "在我哥哥两抓两判两放"
    },
    {
      "end": 8153.96,
      "start": 8152.0,
      "text": "所有被赶上大街以后"
    },
    {
      "end": 8155.5,
      "start": 8153.96,
      "text": "我们还是家人闭嘴"
    },
    {
      "end": 8158.44,
      "start": 8155.5,
      "text": "他还不放过你"
    },
    {
      "end": 8161.8,
      "start": 8159.12,
      "text": "你让我们干什么呢"
    },
    {
      "end": 8163.28,
      "start": 8161.8,
      "text": "你让我们做什么呢"
    },
    {
      "end": 8164.94,
      "start": 8163.28,
      "text": "如果战友们"
    },
    {
      "end": 8166.98,
      "start": 8164.94,
      "text": "你们能当成郭文贵的时候"
    },
    {
      "end": 8168.64,
      "start": 8166.98,
      "text": "你能给这个国家"
    },
    {
      "end": 8169.82,
      "start": 8168.64,
      "text": "所谓的共产党的国"
    },
    {
      "end": 8171.22,
      "start": 8169.82,
      "text": "能做出这样的贡献的时候"
    },
    {
      "end": 8174.2,
      "start": 8171.22,
      "text": "你还要是被宰杀"
    },
    {
      "end": 8175.96,
      "start": 8174.2,
      "text": "你老爹被赶在马路上"
    },
    {
      "end": 8176.72,
      "start": 8175.96,
      "text": "你告诉我"
    },
    {
      "end": 8177.9,
      "start": 8176.72,
      "text": "像赵颖妹妹东弟"
    },
    {
      "end": 8179.42,
      "start": 8177.9,
      "text": "你就是给他服软"
    },
    {
      "end": 8180.9,
      "start": 8179.42,
      "text": "你就是不联系"
    },
    {
      "end": 8182.66,
      "start": 8180.9,
      "text": "你给他赚上六个亿"
    },
    {
      "end": 8184.22,
      "start": 8182.66,
      "text": "养上上万个员工"
    },
    {
      "end": 8185.46,
      "start": 8184.22,
      "text": "他还这么对你"
    },
    {
      "end": 8188.38,
      "start": 8185.46,
      "text": "你觉得他比魔鬼不还魔吗"
    },
    {
      "end": 8192.74,
      "start": 8188.38,
      "text": "你动用几百个警察"
    },
    {
      "end": 8193.94,
      "start": 8192.74,
