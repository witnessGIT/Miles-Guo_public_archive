  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 5402.84,
      "start": 5400.0,
      "text": "不善取消了公寓 接管"
    },
    {
      "end": 5403.84,
      "start": 5402.84,
      "text": "指定誰呢?"
    },
    {
      "end": 5410.24,
      "start": 5403.84,
      "text": "有林杉磚的大村派出所指定金羽公司"
    },
    {
      "end": 5412.54,
      "start": 5410.24,
      "text": "金羽公司它有什麼物業管理知識"
    },
    {
      "end": 5415.44,
      "start": 5412.54,
      "text": "你得經過人家住的公寓 接管公寓"
    },
    {
      "end": 5417.66,
      "start": 5415.44,
      "text": "好 你也正確"
    },
    {
      "end": 5421.16,
      "start": 5417.66,
      "text": "那我請問你 大家都有 只要四個人都懂得"
    },
    {
      "end": 5423.16,
      "start": 5421.16,
      "text": "酒店是有物業管理公司的嗎?"
    },
    {
      "end": 5428.16,
      "start": 5423.16,
      "text": "酒店是最特殊行業的就是靠管理來起家的"
    },
    {
      "end": 5430.4,
      "start": 5428.16,
      "text": "他沒有物業管理公司 他也沒有業主"
    },
    {
      "end": 5433.6,
      "start": 5430.4,
      "text": "你怎麼把酒店也接管了?"
    },
    {
      "end": 5437.0,
      "start": 5433.6,
      "text": "物業管理接管酒店管理公司人間第一招"
    },
    {
      "end": 5442.44,
      "start": 5437.0,
      "text": "他是七星級酒店 也接管了七星級酒店"
    },
    {
      "end": 5446.84,
      "start": 5442.44,
      "text": "這王八蛋 以物業為名接管公寓"
    },
    {
      "end": 5450.94,
      "start": 5446.84,
      "text": "然後物業管理費還是20到26"
    },
    {
      "end": 5453.88,
      "start": 5450.94,
      "text": "然後頂層公寓 就是四個月"
    },
    {
      "end": 5455.62,
      "start": 5453.88,
      "text": "然後把人趕出去"
    },
    {
      "end": 5457.86,
      "start": 5455.62,
      "text": "然後又接管 物業管理公司不善"
    },
    {
      "end": 5459.06,
      "start": 5457.86,
      "text": "又把酒店接管了"
    },
    {
      "end": 5461.06,
      "start": 5459.06,
      "text": "酒店跟你物業管理公司什麼關係?"
    },
    {
      "end": 5463.86,
      "start": 5461.06,
      "text": "而且七星級酒店一直在持續經營"
    },
    {
      "end": 5464.86,
      "start": 5463.86,
      "text": "還賺錢"
    },
    {
      "end": 5466.86,
      "start": 5464.86,
      "text": "大家記住手段是什麼?"
    },
    {
      "end": 5469.14,
      "start": 5466.86,
      "text": "300特警 300罰警"
    },
    {
      "end": 5471.14,
      "start": 5469.14,
      "text": "100個金羽的人進去以後"
    },
    {
      "end": 5474.34,
      "start": 5471.14,
      "text": "把整個盤古770米南北的樓"
    },
    {
      "end": 5476.58,
      "start": 5474.34,
      "text": "全面用車 警車"
    },
    {
      "end": 5479.18,
      "start": 5476.58,
      "text": "所有的房間線給攔上以後"
    },
    {
      "end": 5480.34,
      "start": 5479.18,
      "text": "當場幹的什麼事?"
    },
    {
      "end": 5483.78,
      "start": 5480.34,
      "text": "你們要記住 這都是財富"
    },
    {
      "end": 5486.78,
      "start": 5483.78,
      "text": "第一條 所有當場的手機都不管用"
    },
    {
      "end": 5492.22,
      "start": 5486.78,
      "text": "韓國酒店店停了 整個大樓店停了"
    },
    {
      "end": 5495.02,
      "start": 5492.22,
      "text": "所有的水給你停了"
    },
    {
      "end": 5496.42,
      "start": 5495.02,
      "text": "然後特警進去"
    },
    {
      "end": 5498.22,
      "start": 5496.42,
      "text": "留下的 哎 看到了這個啊"
    },
    {
      "end": 5500.7,
      "start": 5498.22,
      "text": "這是這個文件 大家都看到這個文件了"
    },
    {
      "end": 5502.94,
      "start": 5500.7,
      "text": "所有進去以後 你看管理"
    },
    {
      "end": 5506.38,
      "start": 5502.94,
      "text": "非常清楚的啊 因為企業管理"
    },
    {
      "end": 5508.78,
      "start": 5506.38,
      "text": "這麼叫做 育成職業有限公司"
    },
    {
      "end": 5511.02,
      "start": 5508.78,
      "text": "由於管理不善 業務"
    },
    {
      "end": 5513.18,
      "start": 5511.02,
      "text": "沒有散失 沒有選出"
    },
    {
      "end": 5514.38,
      "start": 5513.18,
      "text": "新物業 物業企業"
    },
    {
      "end": 5516.98,
      "start": 5514.38,
      "text": "為保證小區的持續和正常進行"
    },
    {
      "end": 5519.82,
      "start": 5516.98,
      "text": "保證小區業餘生活的品質"
    },
    {
      "end": 5521.22,
      "start": 5519.82,
      "text": "做好盤門工作"
    },
    {
      "end": 5523.02,
      "start": 5521.22,
      "text": "由接到辦理處"
    },
    {
      "end": 5524.82,
      "start": 5523.02,
      "text": "指定供應緊急服務"
    },
    {
      "end": 5527.14,
      "start": 5524.82,
      "text": "電停了 水停了"
    },
    {
      "end": 5529.74,
      "start": 5527.14,
      "text": "你原來的物業管理公司你也給廢了"
    },
    {
      "end": 5530.74,
      "start": 5529.74,
      "text": "你聽說過嗎?"
    },
    {
      "end": 5534.18,
      "start": 5530.74,
      "text": "應急服務企業 你指定的北京議程"
    },
    {
      "end": 5537.22,
      "start": 5534.18,
      "text": "進出小區 所有物業費還減"
    },
    {
      "end": 5540.22,
      "start": 5537.22,
      "text": "你把人給轟出去了"
    },
    {
      "end": 5543.78,
      "start": 5540.22,
      "text": "你看看這個盤古大官的全體業主"
    },
    {
      "end": 5545.58,
      "start": 5543.78,
      "text": "12月6號收到這個文件"
    },
    {
      "end": 5547.26,
      "start": 5545.58,
      "text": "他有多大的矛盾"
    },
    {
      "end": 5550.5,
      "start": 5547.26,
      "text": "完全還根據北京物業管理條例"
    },
    {
      "end": 5552.82,
      "start": 5550.5,
      "text": "所以說共產黨這個流氓"
    },
    {
      "end": 5555.26,
      "start": 5552.82,
      "text": "他要幹啥事 依法依歸"
    },
    {
      "end": 5557.54,
      "start": 5555.26,
      "text": "法是他的 歸是他的"
    },
    {
      "end": 5560.5,
      "start": 5557.54,
      "text": "他能做出這樣的文件"
    },
    {
      "end": 5562.34,
      "start": 5560.74,
      "text": "以業主的名義"
    },
    {
      "end": 5566.18,
      "start": 5562.34,
      "text": "把物業公司人 物業非法的一個國際管理公司給趕走"
    },
    {
      "end": 5567.22,
      "start": 5566.18,
      "text": "代表業主"
    },
    {
      "end": 5569.22,
      "start": 5567.22,
      "text": "由派出所"
    },
    {
      "end": 5570.22,
      "start": 5569.22,
      "text": "由國家企業"
    },
    {
      "end": 5572.22,
      "start": 5570.22,
      "text": "王岐山的家族企業"
    },
    {
      "end": 5573.86,
      "start": 5572.22,
      "text": "和所謂北京國營企業"
    },
    {
      "end": 5575.06,
      "start": 5573.86,
      "text": "給撵走"
    },
    {
      "end": 5578.06,
      "start": 5575.06,
      "text": "然後把七星機酒店用物業公司監管"
    },
    {
      "end": 5579.22,
      "start": 5578.06,
      "text": "成了人類最大小"
    },
    {
      "end": 5583.7,
      "start": 5579.22,
      "text": "大家記住啊 斷水 斷電 斷手機"
    },
    {
      "end": 5585.7,
      "start": 5583.7,
      "text": "然後是警察 特警"
    },
    {
      "end": 5587.7,
      "start": 5585.7,
      "text": "你覺得這像物業公司的接管嗎"
    },
    {
      "end": 5590.7,
      "start": 5587.7,
      "text": "全部完 記住 啪啪啪"
    },
    {
      "end": 5592.74,
      "start": 5590.7,
      "text": "特警 武警進入到你這個"
    },
    {
      "end": 5594.66,
      "start": 5592.74,
      "text": "第一進入哪兒 大家記住啊"
    },
    {
      "end": 5596.26,
      "start": 5594.66,
      "text": "請回到這全畫面"
    },
    {
      "end": 5599.54,
      "start": 5596.26,
      "text": "第一個進到的是哪兒 監控室"
    },
    {
      "end": 5602.26,
      "start": 5599.54,
      "text": "說監控室進了50個人"
    },
    {
      "end": 5605.54,
      "start": 5602.26,
      "text": "每4到6個特警和法警"
    },
    {
      "end": 5608.18,
      "start": 5605.54,
      "text": "監控著一個當時的監控的咱們"
    },
    {
      "end": 5610.18,
      "start": 5608.18,
      "text": "那這個樓的監控很嚴重的"
    },
    {
      "end": 5612.02,
      "start": 5610.18,
      "text": "基電監控不是管管人的"
    },
    {
      "end": 5614.18,
      "start": 5612.02,
      "text": "最重要的是水和電和氣"
    },
    {
      "end": 5615.62,
      "start": 5614.18,
      "text": "那你一爆炸整個樓就完了"
    },
    {
      "end": 5617.62,
      "start": 5615.62,
      "text": "潘古的樓是一個整體的"
    },
    {
      "end": 5621.22,
      "start": 5617.62,
      "text": "它是一個55萬平方米的一個整體的樓"
    },
    {
      "end": 5624.1,
      "start": 5621.22,
      "text": "一個天然氣爆炸啪就炸了就變火龍了"
    },
    {
      "end": 5630.1,
      "start": 5624.1,
      "text": "它主要監控基電水 氣 電 防這些運行"
    },
    {
      "end": 5632.34,
      "start": 5630.1,
      "text": "然後進去以後怕大家給錄像"
    },
    {
      "end": 5633.3,
      "start": 5632.34,
      "text": "馬上先監控"
    },
    {
      "end": 5634.1,
      "start": 5633.3,
      "text": "你看他們啊"
    },
    {
      "end": 5636.9,
      "start": 5634.1,
      "text": "第一個是把監控室幹掉"
    },
    {
      "end": 5638.9,
      "start": 5636.9,
      "text": "第二個就是財務部"
    },
    {
      "end": 5641.3,
      "start": 5638.9,
      "text": "把東西都別動 所有電腦都別動"
    },
    {
      "end": 5642.74,
      "start": 5641.3,
      "text": "然後特警到我們沒動"
    },
    {
      "end": 5644.1,
      "start": 5642.74,
      "text": "非常清楚"
    },
    {
      "end": 5645.94,
      "start": 5644.1,
      "text": "說就是幾分鐘的時間"
    },
    {
      "end": 5647.3,
      "start": 5645.94,
      "text": "迅速地衝進去"
    },
    {
      "end": 5648.58,
      "start": 5647.3,
      "text": "員工在虛設"
    },
    {
      "end": 5650.18,
      "start": 5648.58,
      "text": "因為它是三班老婆酒店"
    },
    {
      "end": 5650.58,
      "start": 5650.18,
      "text": "是吧"
    },
    {
      "end": 5651.54,
      "start": 5650.58,
      "text": "這8小時你幹"
    },
    {
      "end": 5652.58,
      "start": 5651.54,
      "text": "這8小時我休息"
    },
    {
      "end": 5654.42,
      "start": 5652.58,
      "text": "它是輪班的"
    },
    {
      "end": 5656.58,
      "start": 5654.42,
      "text": "咱們的員工很多是休息室"
    },
    {
      "end": 5657.62,
      "start": 5656.58,
      "text": "女孩男孩"
    },
    {
      "end": 5660.26,
      "start": 5657.62,
      "text": "酒店是女孩占80%啊"
    },
    {
      "end": 5661.46,
      "start": 5660.26,
      "text": "大多數是女孩"
    },
    {
      "end": 5662.5,
      "start": 5661.46,
      "text": "穿著睡一睡覺的"
    },
    {
      "end": 5663.46,
      "start": 5662.5,
      "text": "進去拿槍一頂"
    },
    {
      "end": 5664.26,
      "start": 5663.46,
      "text": "出去"
    },
    {
      "end": 5664.66,
      "start": 5664.26,
      "text": "啥一波呢"
    },
    {
      "end": 5665.06,
      "start": 5664.66,
      "text": "拿手機"
    },
    {
      "end": 5666.1,
      "start": 5665.06,
      "text": "不用拿"
    },
    {
      "end": 5666.74,
      "start": 5666.1,
      "text": "你說一動"
    },
    {
      "end": 5668.1,
      "start": 5666.74,
      "text": "啥一槍桌就給你砸下去"
    },
    {
      "end": 5671.54,
      "start": 5670.5,
      "text": "就這樣對待女孩"
    },
    {
      "end": 5673.14,
      "start": 5671.54,
      "text": "零下四度啊"
    },
    {
      "end": 5673.86,
      "start": 5673.14,
      "text": "全站大街上"
    },
    {
      "end": 5674.9,
      "start": 5673.86,
      "text": "有的女孩就是"
    },
    {
      "end": 5676.02,
      "start": 5674.9,
      "text": "真的光著腳有的"
    },
    {
      "end": 5676.78,
      "start": 5676.02,
      "text": "穿一支鞋就可以"
    },
    {
      "end": 5677.62,
      "start": 5676.78,
      "text": "趕大街上去了"
    },
    {
      "end": 5680.82,
      "start": 5678.58,
      "text": "你們想過這有多麼殘忍嗎"
    },
    {
      "end": 5681.94,
      "start": 5680.82,
      "text": "這是在北京首都"
    },
    {
      "end": 5682.98,
      "start": 5681.94,
      "text": "依法治國的"
    },
    {
      "end": 5684.26,
      "start": 5682.98,
      "text": "共產黨天下"
    },
    {
      "end": 5685.46,
      "start": 5684.26,
      "text": "人家客人呢"
    },
    {
      "end": 5686.82,
      "start": 5685.46,
      "text": "馬上就把海東兄的"
    },
    {
      "end": 5687.82,
      "start": 5686.82,
      "text": "敲門"
    },
    {
      "end": 5688.82,
      "start": 5687.82,
      "text": "馬上下去對方"
    },
    {
      "end": 5689.38,
      "start": 5688.82,
      "text": "走人"
    },
    {
      "end": 5692.18,
      "start": 5689.38,
      "text": "全是特警警察罰警"
    },
    {
      "end": 5696.02,
      "start": 5694.18,
      "text": "聽說有客人就問"
    },
    {
      "end": 5696.58,
      "start": 5696.02,
      "text": "咋不讓"
    },
    {
      "end": 5697.22,
      "start": 5696.58,
      "text": "大嘴巴的"
    },
    {
      "end": 5698.18,
      "start": 5697.22,
      "text": "馬上就刪上去了"
    },
    {
      "end": 5699.62,
      "start": 5698.18,
      "text": "我們執行特殊任務"
    },
    {
      "end": 5700.82,
      "start": 5699.62,
      "text": "國家安全需要"
    },
    {
      "end": 5701.62,
      "start": 5700.82,
      "text": "馬上下咯"
    },
    {
      "end": 5702.26,
      "start": 5701.62,
      "text": "別廢話"
    },
    {
      "end": 5702.98,
      "start": 5702.26,
      "text": "說我拿我包"
    },
    {
      "end": 5703.62,
      "start": 5702.98,
      "text": "不能拿"
    },
    {
      "end": 5706.26,
      "start": 5703.62,
      "text": "客人東西都不讓"
    },
    {
      "end": 5706.62,
      "start": 5706.26,
      "text": "拿"
    },
    {
      "end": 5709.46,
      "start": 5707.9,
      "text": "這個時候就到我爹那去了"
    },
    {
      "end": 5711.06,
      "start": 5709.46,
      "text": "我爹是中風事"
    },
    {
      "end": 5711.86,
      "start": 5711.06,
      "text": "一會兒清楚"
    },
    {
      "end": 5712.82,
      "start": 5711.86,
      "text": "一會兒不清楚"
    },
    {
      "end": 5714.14,
      "start": 5712.82,
      "text": "他們跟我爹"
    },
    {
      "end": 5715.54,
      "start": 5714.14,
      "text": "先進去的人打招呼"
    },
    {
      "end": 5716.74,
      "start": 5715.54,
      "text": "先跟我爹說"
    },
    {
      "end": 5718.5,
      "start": 5716.74,
      "text": "你是誰讓你住這啊"
    },
    {
      "end": 5719.06,
      "start": 5718.5,
      "text": "怎麼樣怎麼樣"
    },
    {
      "end": 5719.7,
      "start": 5719.06,
      "text": "說這話"
    },
