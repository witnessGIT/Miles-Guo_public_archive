      "start": 4336.36,
      "text": "别人也说"
    },
    {
      "end": 4339.96,
      "start": 4338.16,
      "text": "说我是脑子一根筋"
    },
    {
      "end": 4341.56,
      "start": 4339.96,
      "text": "我说我就是脑子一根筋"
    },
    {
      "end": 4343.56,
      "start": 4341.56,
      "text": "不见欢和不死心"
    },
    {
      "end": 4344.46,
      "start": 4343.56,
      "text": "我非得走这条路"
    },
    {
