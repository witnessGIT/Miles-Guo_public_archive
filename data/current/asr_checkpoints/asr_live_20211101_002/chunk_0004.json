      "text": "是吧"
    },
    {
      "end": 4265.56,
      "start": 4263.26,
      "text": "我去年的十月份"
    },
    {
      "end": 4266.56,
      "start": 4265.56,
      "text": "对去年的十月"
    },
    {
      "end": 4267.56,
      "start": 4266.56,
      "text": "对去年的十月"
    },
    {
      "end": 4268.56,
      "start": 4267.56,
      "text": "对"
    },
    {
      "end": 4269.56,
      "start": 4268.56,
      "text": "对"
    },
    {
      "end": 4270.56,
      "start": 4269.56,
      "text": "之前我们从来没有见过"
    },
    {
      "end": 4273.86,
      "start": 4270.56,
      "text": "但是十月份之前在六四的时候"
