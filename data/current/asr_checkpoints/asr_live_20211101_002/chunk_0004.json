    {
      "end": 4306.66,
      "start": 4304.96,
      "text": "最难的"
    },
    {
      "end": 4306.86,
      "start": 4306.66,
      "text": "对"
    },
    {
      "end": 4307.66,
      "start": 4306.86,
      "text": "非常难"
    },
    {
      "end": 4309.0,
      "start": 4307.66,
      "text": "但到今天为止"
    },
    {
      "end": 4309.56,
      "start": 4309.0,
      "text": "为什么"
    },
    {
      "end": 4311.26,
      "start": 4309.56,
      "text": "那当然我做的也很少"
    },
    {
