      "start": 3601.0,
      "text": "好消息"
    },
    {
      "end": 3607.28,
      "start": 3604.68,
      "text": "这么好看"
    },
    {
      "end": 3612.16,
      "start": 3610.28,
      "text": "我就跟大家说一下"
    },
    {
      "end": 3613.04,
      "start": 3612.16,
      "text": "我刚刚收到"
    },
    {
      "end": 3617.08,
      "start": 3613.04,
      "text": "这个新联署这边传过来的信息"
    },
    {
      "end": 3620.72,
      "start": 3617.08,
      "text": "预计在未来一个小时之内"
    },
    {
      "end": 3622.08,
      "start": 3621.08,
      "text": "一个小时之内"
    },
    {
      "end": 3624.0,
      "start": 3622.32,
      "text": "当然也有可能随时会发生"
    },
    {
      "end": 3626.28,
      "start": 3624.96,
      "text": "所以耐心等待"
    },
    {
      "end": 3636.2,
      "start": 3630.0,
      "text": "大卫已经耐不住了"
    },
    {
      "end": 3643.52,
      "start": 3636.2,
      "text": "好收到啊太高兴了啊"
    },
    {
      "end": 3644.92,
      "start": 3643.52,
      "text": "我回应一下"
    },
    {
      "end": 3646.52,
      "start": 3644.92,
      "text": "刚才七哥说的"
    },
    {
      "end": 3648.52,
      "start": 3646.52,
      "text": "讲的那段话的时候"
    },
    {
      "end": 3650.06,
      "start": 3648.52,
      "text": "七哥我突然想起您"
    },
    {
      "end": 3652.26,
      "start": 3650.06,
      "text": "以前跟我们铁学组开会的时候"
    },
    {
      "end": 3654.44,
      "start": 3652.26,
      "text": "您分享过一个理念"
    },
    {
      "end": 3656.72,
      "start": 3654.44,
      "text": "就是咱们墙内有四种人"
    },
    {
      "end": 3658.26,
      "start": 3656.72,
      "text": "我们有四种战友"
    },
    {
      "end": 3660.62,
      "start": 3658.26,
      "text": "简单啊给他划分四个类"
    },
    {
      "end": 3662.34,
      "start": 3660.62,
      "text": "不敢反"
    },
    {
      "end": 3663.58,
      "start": 3662.34,
      "text": "没能力反"
    },
    {
      "end": 3664.66,
      "start": 3663.58,
      "text": "对吧"
    },
    {
      "end": 3666.1,
      "start": 3664.66,
      "text": "敢反"
    },
    {
      "end": 3668.66,
      "start": 3666.1,
      "text": "然后呢他就没那个能力"
    },
    {
      "end": 3669.62,
      "start": 3668.66,
      "text": "缺钱"
    },
    {
      "end": 3671.06,
      "start": 3669.62,
      "text": "缺这个资源"
    },
    {
      "end": 3672.44,
      "start": 3671.06,
      "text": "还有一种是什么呢"
    },
    {
      "end": 3673.24,
      "start": 3672.44,
      "text": "他不能反"
    },
    {
      "end": 3674.02,
      "start": 3673.24,
      "text": "是吧"
    },
    {
      "end": 3675.78,
      "start": 3674.02,
      "text": "还有的就是我也敢反"
    },
    {
      "end": 3676.8,
      "start": 3675.78,
      "text": "我也有这个能力"
    },
    {
      "end": 3678.82,
      "start": 3676.8,
      "text": "可是他现在受种种条件的限制"
    },
    {
      "end": 3680.52,
      "start": 3678.82,
      "text": "可能就受经济条件的限制"
    },
    {
      "end": 3681.78,
      "start": 3680.52,
      "text": "他就差那一点"
    },
    {
      "end": 3683.1,
      "start": 3681.78,
      "text": "那个物质上的资源"
    },
    {
      "end": 3684.12,
      "start": 3683.1,
      "text": "所以呢"
    },
    {
      "end": 3685.58,
      "start": 3684.12,
      "text": "七哥的爆料革命这几年"
    },
    {
      "end": 3687.54,
      "start": 3685.58,
      "text": "尤其是从G系列"
    },
    {
      "end": 3689.18,
      "start": 3687.54,
      "text": "G生炭开始打造以来"
    },
    {
      "end": 3690.26,
      "start": 3689.18,
      "text": "战友们应该意识到"
    },
    {
      "end": 3691.92,
      "start": 3690.26,
      "text": "我们在灭共的同时"
    },
    {
      "end": 3693.68,
      "start": 3691.92,
      "text": "其实我们相当于两条嘴走路"
    },
    {
      "end": 3695.28,
      "start": 3693.68,
      "text": "第一个是在西方"
    },
    {
      "end": 3697.76,
      "start": 3695.28,
      "text": "我们建立起了强大的政商关系"
    },
    {
      "end": 3698.54,
      "start": 3697.76,
      "text": "这就是七哥说"
    },
    {
      "end": 3699.78,
      "start": 3698.54,
      "text": "我们不靠任何一个党"
    },
    {
      "end": 3701.86,
      "start": 3699.78,
      "text": "我们不依赖任何一个人"
    },
    {
      "end": 3703.18,
      "start": 3701.86,
      "text": "看某一个人的脸色"
    },
    {
      "end": 3704.28,
      "start": 3703.18,
      "text": "某一个党派的脸色"
    },
    {
      "end": 3706.14,
      "start": 3704.28,
      "text": "我们就做为真不破"
    },
    {
      "end": 3707.34,
      "start": 3706.14,
      "text": "把爆料革命"
    },
    {
      "end": 3708.8,
      "start": 3707.34,
      "text": "把新中国联邦的精髓"
    },
    {
      "end": 3710.4,
      "start": 3708.8,
      "text": "我们靠的是实力"
    },
    {
      "end": 3711.58,
      "start": 3710.4,
      "text": "情报的真实性"
    },
    {
      "end": 3712.86,
      "start": 3711.58,
      "text": "带给世界的真相"
    },
    {
      "end": 3713.84,
      "start": 3712.86,
      "text": "救人无数"
    },
    {
      "end": 3714.38,
      "start": 3713.84,
      "text": "对吧"
    },
    {
      "end": 3715.66,
      "start": 3714.38,
      "text": "这些都摆在眼前"
    },
    {
      "end": 3717.38,
      "start": 3715.66,
      "text": "时间一次次的验证"
    },
    {
      "end": 3718.6,
      "start": 3717.38,
      "text": "就像刚才七哥您讲"
    },
    {
      "end": 3719.3,
      "start": 3718.6,
      "text": "咱们事儿上见"
    },
    {
      "end": 3720.26,
      "start": 3719.3,
      "text": "另一方面"
    },
    {
      "end": 3721.22,
      "start": 3720.26,
      "text": "另一条腿什么的"
    },
    {
      "end": 3722.36,
      "start": 3721.22,
      "text": "打造G系列"
    },
    {
      "end": 3723.26,
      "start": 3722.36,
      "text": "打造金融体系"
    },
    {
      "end": 3724.96,
      "start": 3723.26,
      "text": "给无数的老百姓"
    },
    {
      "end": 3725.7,
      "start": 3724.96,
      "text": "明天一下"
    },
    {
      "end": 3726.9,
      "start": 3725.7,
      "text": "让每一个兄弟姐妹"
    },
    {
      "end": 3727.48,
      "start": 3726.9,
      "text": "那些战友"
    },
    {
      "end": 3728.68,
      "start": 3727.48,
      "text": "让他们敢反"
    },
    {
      "end": 3730.34,
      "start": 3728.68,
      "text": "所说的敢反"
    },
    {
      "end": 3731.66,
      "start": 3730.34,
      "text": "是我敢跟共产党说"
    },
    {
      "end": 3732.24,
      "start": 3731.66,
      "text": "说不"
    },
    {
      "end": 3732.8,
      "start": 3732.24,
      "text": "对不对"
    },
    {
      "end": 3734.52,
      "start": 3732.8,
      "text": "我敢去跟中共挑战"
    },
    {
      "end": 3735.66,
      "start": 3734.52,
      "text": "我有这个能力"
    },
    {
      "end": 3736.74,
      "start": 3735.66,
      "text": "我离开共产党"
    },
    {
      "end": 3738.04,
      "start": 3736.74,
      "text": "我可以过得很体面的生活"
    },
    {
      "end": 3739.5,
      "start": 3738.04,
      "text": "我可以穿得很好"
    },
    {
      "end": 3740.96,
      "start": 3739.5,
      "text": "我可以吃得很健康"
    },
    {
      "end": 3742.46,
      "start": 3740.96,
      "text": "我可以活得很有资严"
    },
    {
      "end": 3744.74,
      "start": 3742.46,
      "text": "我可以真正的孝敬我的父母"
    },
    {
      "end": 3745.18,
      "start": 3744.74,
      "text": "对吧"
    },
    {
      "end": 3746.24,
      "start": 3745.18,
      "text": "真正的孝"
    },
    {
      "end": 3746.88,
      "start": 3746.24,
      "text": "真正的孝"
    },
    {
      "end": 3747.8,
      "start": 3746.88,
      "text": "所以说"
    },
    {
      "end": 3749.06,
      "start": 3747.8,
      "text": "这几年的爆料革命"
    },
    {
      "end": 3750.42,
      "start": 3749.06,
      "text": "就是像这两条腿一样"
    },
    {
      "end": 3751.2,
      "start": 3750.42,
      "text": "政商关系"
    },
    {
      "end": 3751.8,
      "start": 3751.2,
      "text": "国际环境"
    },
    {
      "end": 3752.7,
      "start": 3751.8,
      "text": "新中国联邦"
    },
    {
      "end": 3753.38,
      "start": 3752.7,
      "text": "咱们的声誉"
    },
    {
      "end": 3754.74,
      "start": 3753.38,
      "text": "咱们的这个信誉率"
    },
    {
      "end": 3755.34,
      "start": 3754.74,
      "text": "这个credit"
    },
    {
      "end": 3756.86,
      "start": 3755.34,
      "text": "在一天天的积累"
    },
    {
      "end": 3757.62,
      "start": 3756.86,
      "text": "另一方面"
    },
    {
      "end": 3758.66,
      "start": 3757.62,
      "text": "战友们获得了"
    },
    {
      "end": 3759.42,
      "start": 3758.66,
      "text": "这个生活的"
    },
    {
      "end": 3760.64,
      "start": 3759.42,
      "text": "这个新的生态"
    },
    {
      "end": 3762.14,
      "start": 3760.64,
      "text": "新的生活圈子"
    },
    {
      "end": 3762.94,
      "start": 3762.14,
      "text": "你看我们的战友"
    },
    {
      "end": 3763.58,
      "start": 3762.94,
      "text": "这种感情"
    },
    {
      "end": 3764.84,
      "start": 3763.58,
      "text": "五湖四海"
    },
    {
      "end": 3765.78,
      "start": 3764.84,
      "text": "可以因为送药"
    },
    {
      "end": 3766.5,
      "start": 3765.78,
      "text": "大家相聚"
    },
    {
      "end": 3768.56,
      "start": 3766.5,
      "text": "大卫的命也是七哥救的"
    },
    {
      "end": 3770.02,
      "start": 3768.56,
      "text": "也是爆料革命战友救的"
    },
    {
      "end": 3770.32,
      "start": 3770.02,
      "text": "对不对"
    },
    {
      "end": 3772.92,
      "start": 3770.32,
      "text": "洗联主主席也亲自出手"
    },
    {
      "end": 3773.26,
      "start": 3772.92,
      "text": "是吧"
    },
    {
      "end": 3774.12,
      "start": 3773.26,
      "text": "所以说"
    },
    {
      "end": 3775.58,
      "start": 3774.12,
      "text": "这今天这一切"
    },
    {
      "end": 3776.84,
      "start": 3775.58,
      "text": "这是多少钱买不来的"
    },
    {
      "end": 3777.98,
      "start": 3776.84,
      "text": "何况我们现在"
    },
    {
      "end": 3778.86,
      "start": 3777.98,
      "text": "又有自己的货币"
    },
    {
      "end": 3780.84,
      "start": 3778.86,
      "text": "有自己未来的金融体系"
    },
    {
      "end": 3782.16,
      "start": 3780.84,
      "text": "我们有自己的支付系统"
    },
    {
      "end": 3783.62,
      "start": 3782.16,
      "text": "那整个整合在一起"
    },
    {
      "end": 3784.46,
      "start": 3783.62,
      "text": "战友们想想是什么"
    },
    {
      "end": 3785.8,
      "start": 3784.46,
      "text": "我们可以自由尊严"
    },
    {
      "end": 3786.74,
      "start": 3785.8,
      "text": "可以自由"
    },
    {
      "end": 3788.04,
      "start": 3786.74,
      "text": "可以骄傲的活着"
    },
    {
      "end": 3789.26,
      "start": 3788.04,
      "text": "不用看共产党的脸"
    },
    {
      "end": 3791.46,
      "start": 3789.26,
      "text": "我们可以对这个共产党说"
    },
    {
      "end": 3792.66,
      "start": 3791.46,
      "text": "共产党你滚蛋"
    },
    {
      "end": 3793.2,
      "start": 3792.66,
      "text": "你滚毒"
    },
    {
      "end": 3793.9,
      "start": 3793.2,
      "text": "是吧"
    },
    {
      "end": 3795.42,
      "start": 3793.9,
      "text": "不用跟我们玩那些假大空"
    },
    {
      "end": 3796.56,
      "start": 3795.42,
      "text": "所以今天"
    },
    {
      "end": 3798.22,
      "start": 3796.56,
      "text": "我觉得这个伟大的时刻"
    },
    {
      "end": 3799.22,
      "start": 3798.22,
      "text": "不仅仅是战友们"
    },
    {
      "end": 3800.26,
      "start": 3799.22,
      "text": "在财富面前"
    },
    {
      "end": 3801.84,
      "start": 3800.26,
      "text": "我们更要觉得就是什么呢"
    },
    {
      "end": 3803.0,
      "start": 3801.84,
      "text": "我们如何活"
    },
    {
      "end": 3804.0,
      "start": 3803.0,
      "text": "如何做一个人"
    },
    {
      "end": 3805.28,
      "start": 3804.0,
      "text": "是七哥让我们"
    },
    {
      "end": 3806.16,
      "start": 3805.28,
      "text": "有奴隶"
    },
    {
      "end": 3807.62,
      "start": 3806.16,
      "text": "像生购一样"
    },
    {
      "end": 3808.88,
      "start": 3807.62,
      "text": "今天我们站起来"
    },
    {
      "end": 3810.16,
      "start": 3808.88,
      "text": "并且有自己的头脑"
    },
    {
      "end": 3811.14,
      "start": 3810.16,
      "text": "有自己的尊严"
    },
    {
      "end": 3812.16,
      "start": 3811.14,
      "text": "有自己的自信"
    },
    {
      "end": 3813.42,
      "start": 3812.16,
      "text": "我觉得这是咱们"
    },
    {
      "end": 3814.36,
      "start": 3813.42,
      "text": "今天这个时刻"
    },
    {
      "end": 3816.3,
      "start": 3814.36,
      "text": "除了开盘"
    },
    {
      "end": 3816.9,
      "start": 3816.3,
      "text": "本身"
    },
    {
      "end": 3817.44,
      "start": 3816.9,
      "text": "价格"
    },
    {
      "end": 3818.78,
      "start": 3817.44,
      "text": "还有就是"
    },
    {
      "end": 3819.68,
      "start": 3818.78,
      "text": "这份"
    },
    {
      "end": 3821.48,
      "start": 3819.68,
      "text": "无法用语言形容"
    },
    {
      "end": 3823.48,
      "start": 3821.48,
      "text": "无法用财富来衡量的价值"
    },
    {
      "end": 3824.3,
      "start": 3823.48,
      "text": "谢谢七哥"
    },
    {
      "end": 3825.26,
      "start": 3824.3,
      "text": "谢谢战友们"
    },
    {
      "end": 3827.0,
      "start": 3825.26,
      "text": "我以新中国联邦人为"
    },
    {
      "end": 3828.4,
      "start": 3827.0,
      "text": "我告诉你"
    },
    {
      "end": 3829.28,
      "start": 3828.4,
      "text": "我再说一遍"
    },
    {
      "end": 3830.32,
      "start": 3829.28,
      "text": "我说四种人"
    },
    {
      "end": 3830.88,
      "start": 3830.32,
      "text": "第一种"
    },
    {
      "end": 3832.0,
      "start": 3830.88,
      "text": "绝大多数"
    },
    {
      "end": 3834.04,
      "start": 3832.0,
      "text": "绝大多数是不敢"
    },
    {
      "end": 3837.06,
      "start": 3834.04,
      "text": "第二种人就是不信"
    },
    {
      "end": 3838.8,
      "start": 3837.06,
      "text": "他就不信咱"
    },
    {
      "end": 3840.2,
      "start": 3838.8,
      "text": "第三种人"
    },
    {
      "end": 3841.84,
      "start": 3840.2,
      "text": "既不信也不敢"
    },
    {
      "end": 3844.16,
      "start": 3841.84,
      "text": "到第四种人就是"
    },
    {
      "end": 3845.3,
      "start": 3844.16,
      "text": "我信你"
    },
    {
      "end": 3846.16,
      "start": 3845.3,
      "text": "我敢"
    },
    {
      "end": 3846.82,
      "start": 3846.16,
      "text": "我不能"
    },
    {
      "end": 3847.9,
      "start": 3846.82,
      "text": "因为家人被绑架"
    },
    {
