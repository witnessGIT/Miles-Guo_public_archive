      "text": "或者爆料革命的一个信任"
    },
    {
      "end": 4326.96,
      "start": 4325.56,
      "text": "就是这么简单"
    },
    {
      "end": 4327.96,
      "start": 4326.96,
      "text": "其实他没有什么"
