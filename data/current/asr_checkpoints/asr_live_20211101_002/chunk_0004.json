    {
      "end": 4349.76,
      "start": 4349.26,
      "text": "非常感恩"
    },
    {
      "end": 4351.76,
      "start": 4349.76,
      "text": "就是我真的是"
    },
    {
      "end": 4354.06,
      "start": 4351.76,
      "text": "其他任何都不重要"
