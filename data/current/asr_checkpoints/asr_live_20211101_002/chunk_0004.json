      "text": "尽自己所能去做"
    },
    {
      "end": 4318.02,
      "start": 4317.16,
      "text": "所以为了什么"
    },
    {
      "end": 4318.76,
      "start": 4318.02,
      "text": "就是为了信"
    },
    {
      "end": 4321.62,
      "start": 4318.76,
      "text": "或者要为了自己的信"
    },
    {
      "end": 4323.16,
      "start": 4321.62,
      "text": "也为了别人的一个信任"
    },
    {
      "end": 4324.3,
      "start": 4323.16,
      "text": "就是七个的信任"
    },
    {
      "end": 4325.56,
