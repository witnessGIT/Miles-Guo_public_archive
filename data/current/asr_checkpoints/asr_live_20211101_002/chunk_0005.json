    {
      "end": 4705.5,
      "start": 4704.5,
      "text": "等着吧"
    },
    {
      "end": 4706.5,
      "start": 4705.5,
      "text": "我觉得"
    },
    {
      "end": 4708.5,
      "start": 4706.5,
      "text": "哎咱们现在要开始啊"
    },
    {
      "end": 4710.5,
      "start": 4708.5,
      "text": "咱要先为我提议啊"
    },
    {
      "end": 4711.5,
