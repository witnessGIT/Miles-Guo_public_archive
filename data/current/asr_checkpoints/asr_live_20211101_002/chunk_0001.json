    {
      "end": 1669.68,
      "start": 1667.7,
      "text": "助力我们早日灭共"
    },
    {
      "end": 1672.28,
      "start": 1669.68,
      "text": "见识美好的新中国联邦"
    },
    {
      "end": 1702.26,
      "start": 1672.28,
      "text": "我们的喜马拉雅"
    },
    {
      "end": 1703.46,
      "start": 1702.28,
      "text": "嗨大家好"
    },
    {
      "end": 1706.1,
      "start": 1703.46,
      "text": "我是西班牙喜悦农场小喜宴"
    },
    {
      "end": 1709.7,
      "start": 1706.1,
      "text": "十月今秋喜币上市了"
    },
    {
      "end": 1714.36,
      "start": 1709.7,
      "text": "人类社会的发展伴随着货币的发展"
    },
    {
      "end": 1716.94,
      "start": 1714.36,
      "text": "从最初的以物换物"
    },
    {
      "end": 1719.82,
      "start": 1716.94,
      "text": "到后来的用贝壳当货币"
    },
    {
      "end": 1723.08,
      "start": 1719.82,
      "text": "又到金银铜金属货币的出现"
    },
    {
      "end": 1725.8,
      "start": 1723.08,
      "text": "再到纸币的出现"
    },
    {
      "end": 1729.36,
      "start": 1725.8,
      "text": "直到今日虚拟货币出现了"
    },
    {
      "end": 1733.48,
      "start": 1729.36,
      "text": "构同性质货币的出现"
    },
    {
      "end": 1734.92,
      "start": 1733.48,
      "text": "从某一方面来讲"
    },
    {
      "end": 1736.78,
      "start": 1734.92,
      "text": "体现出了人类社会进步"
    },
    {
      "end": 1738.24,
      "start": 1736.78,
      "text": "和科技发展的水平"
    },
    {
      "end": 1741.32,
      "start": 1738.24,
      "text": "在数字化时代的今天"
    },
    {
      "end": 1745.32,
      "start": 1741.32,
      "text": "虚拟币必将走在世界货币改革的最前端"
    },
    {
      "end": 1748.94,
      "start": 1745.32,
      "text": "无数的历史证明"
    },
    {
      "end": 1751.14,
      "start": 1748.94,
      "text": "独裁者们对权力的追求"
    },
    {
      "end": 1754.08,
      "start": 1751.14,
      "text": "最终的目标都落在了铸币权上"
    },
    {
      "end": 1756.62,
      "start": 1754.08,
      "text": "因为一旦拥有了铸币权"
    },
    {
      "end": 1759.04,
      "start": 1756.62,
      "text": "他们便可以肆逆地虐夺"
    },
    {
      "end": 1760.44,
      "start": 1759.04,
      "text": "平民百姓的财富"
    },
    {
      "end": 1766.1,
      "start": 1760.44,
      "text": "而虚拟币区块链技术的出现"
    },
    {
      "end": 1769.4,
      "start": 1766.1,
      "text": "让那些独裁者们贪婪的美梦成功"
    },
    {
      "end": 1773.22,
      "start": 1769.4,
      "text": "虚拟币的安全性可靠性及私密性"
    },
    {
      "end": 1776.58,
      "start": 1773.22,
      "text": "是当代各国法币所不能比译的"
    },
    {
      "end": 1780.7,
      "start": 1776.58,
      "text": "去中心化的虚拟币"
    },
    {
      "end": 1782.06,
      "start": 1780.7,
      "text": "比如比特币"
    },
    {
      "end": 1783.98,
      "start": 1782.06,
      "text": "正因为没有了中心化"
    },
    {
      "end": 1786.08,
      "start": 1783.98,
      "text": "成为了犯罪者们的天堂"
    },
    {
      "end": 1789.68,
      "start": 1786.08,
      "text": "他们利用虚拟币的安全性及私密性"
    },
    {
      "end": 1794.62,
      "start": 1789.68,
      "text": "从事洗钱、毒品买卖、暗网交易等犯罪勾当"
    },
    {
      "end": 1797.16,
      "start": 1794.62,
      "text": "而洗币的中心化"
    },
    {
      "end": 1799.98,
      "start": 1797.16,
      "text": "使在国际法律允许的范围内"
