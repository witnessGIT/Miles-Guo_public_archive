    },
    {
      "end": 2903.62,
      "start": 2901.7,
      "text": "所以我们耐心的等待"
    },
    {
      "end": 2905.0,
      "start": 2903.62,
      "text": "完全不在乎"
    },
    {
      "end": 2906.24,
      "start": 2905.0,
      "text": "我等着的话你不在乎一起"
    },
    {
      "end": 2910.0,
