{
  "chunk_audio_sha256": "9195babd0f3e48ff774755dfcd7e611382f16f4f2e9babe1bbfbe73801c3636a",
  "chunk_index": 15,
  "completed_at": "2026-10-20T16:14:37Z",
  "language": "zh",
  "live_id": "LIVE_20211101_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 13500,
