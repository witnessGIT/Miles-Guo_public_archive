    {
      "end": 15089.3,
      "start": 15088.3,
      "text": "謝謝謝謝"
    },
    {
      "end": 15090.3,
      "start": 15089.3,
      "text": "謝謝謝謝"
    },
    {
      "end": 15091.3,
      "start": 15090.3,
      "text": "太感覺得了"
    },
    {
      "end": 15095.3,
      "start": 15091.3,
      "text": "我上次見幾次我覺得這次長了好像好多好多"
    },
    {
      "end": 15098.3,
