      "text": "让更多的孩子们跟爹妈"
    },
    {
      "end": 14535.22,
      "start": 14534.02,
      "text": "跟我们的爹娘"
    },
    {
      "end": 14536.48,
      "start": 14535.22,
      "text": "能堂堂正正"
    },
    {
      "end": 14539.08,
      "start": 14536.48,
      "text": "享受到这种带来的"
    },
    {
      "end": 14540.64,
      "start": 14539.08,
      "text": "喜马拉雅"
    },
    {
      "end": 14541.98,
