    {
      "end": 15160.3,
      "start": 15158.3,
      "text": "沒有財富自由的家庭"
    },
    {
      "end": 15162.3,
      "start": 15160.3,
      "text": "和諧"
    },
    {
      "end": 15164.3,
      "start": 15162.3,
