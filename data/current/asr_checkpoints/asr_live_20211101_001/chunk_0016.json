      "end": 15168.3,
      "start": 15167.3,
      "text": "第二個問題"
    },
    {
      "end": 15169.3,
      "start": 15168.3,
      "text": "當你走向社會"
    },
    {
      "end": 15171.3,
      "start": 15169.3,
      "text": "我經歷了清風幹守所"
