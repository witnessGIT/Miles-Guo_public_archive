    {
      "end": 15174.3,
      "start": 15171.3,
      "text": "我真的是感興那段時間"
    },
    {
      "end": 15176.3,
      "start": 15174.3,
      "text": "就在那裏讓我認識那麽多人"
    },
    {
      "end": 15178.3,
      "start": 15176.3,
      "text": "這麽多人被槍斃"
    },
    {
      "end": 15181.3,
      "start": 15178.3,
      "text": "他們把一生的精華都阻塗給了我"
    },
    {
      "end": 15183.3,
      "start": 15181.3,
      "text": "你想想那個時候"
    },
    {
      "end": 15184.3,
      "start": 15183.3,
      "text": "我看資本論"
    },
    {
      "end": 15185.3,
      "start": 15184.3,
      "text": "我看第一遍看不懂"
    },
    {
      "end": 15187.3,
      "start": 15185.3,
      "text": "所有說的事兒"
    },
    {
      "end": 15188.3,
      "start": 15187.3,
      "text": "所有人都不懂"
    },
    {
      "end": 15190.3,
      "start": 15188.3,
      "text": "人家掰碎了揉碎了說"
    },
    {
      "end": 15191.3,
      "start": 15190.3,
      "text": "這個註解三是啥"
    },
    {
      "end": 15192.3,
      "start": 15191.3,
      "text": "註解四是啥"
    },
    {
      "end": 15194.3,
      "start": 15192.3,
      "text": "讓我把資本論搞明白"
    },
    {
      "end": 15198.3,
      "start": 15194.3,
      "text": "財富的屬性最后都是社會的"
    },
    {
      "end": 15200.3,
      "start": 15198.3,
      "text": "這一句話就是所有的錢歸社會的"
