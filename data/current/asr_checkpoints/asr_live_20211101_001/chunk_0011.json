      "end": 10507.4,
      "start": 10503.32,
      "text": "2021年11月1日11時11分"
    },
    {
      "end": 10509.16,
      "start": 10507.4,
      "text": "洗幣隆重登場"
    },
    {
      "end": 10511.74,
      "start": 10509.16,
      "text": "郭文貴先生在蓋特直播中說"
    },
    {
      "end": 10516.28,
      "start": 10511.74,
      "text": "人們將從洗幣看出它能代表新中國聯邦人的善良"
    },
    {
      "end": 10517.1,
      "start": 10516.28,
      "text": "互愛"
    },
    {
      "end": 10519.64,
      "start": 10517.1,
      "text": "因為這是一群彼此相愛的人"
    },
    {
      "end": 10521.48,
      "start": 10519.64,
      "text": "互相幫助而擁有的"
    },
    {
      "end": 10524.28,
      "start": 10521.48,
      "text": "它能代表著新中國聯邦人的正義"
    },
    {
      "end": 10525.72,
      "start": 10524.28,
      "text": "我們創建它"
    },
    {
      "end": 10526.64,
      "start": 10525.72,
      "text": "購買它"
    },
    {
      "end": 10528.76,
      "start": 10526.64,
      "text": "就是為了推翻邪惡的共產黨"
    },
    {
      "end": 10532.08,
      "start": 10528.76,
      "text": "幫助更多受剝削的人們脫離了惡魔"
    },
    {
      "end": 10534.22,
      "start": 10532.08,
      "text": "新中國聯邦人擁有洗幣"
    },
    {
      "end": 10535.72,
      "start": 10534.22,
      "text": "更能代表能力"
    },
    {
      "end": 10538.56,
      "start": 10535.72,
      "text": "因為我們團結了全球的正義人士"
    },
    {
      "end": 10540.52,
      "start": 10538.56,
      "text": "共同打造了全球性"
    },
    {
      "end": 10542.36,
      "start": 10540.52,
      "text": "跨國界的洗聯儲"
    },
    {
      "end": 10545.32,
      "start": 10542.36,
      "text": "這是無界的低成本的金融系統"
    },
    {
      "end": 10547.6,
      "start": 10545.32,
      "text": "也將會成為全球性的聯儲"
    },
    {
      "end": 10551.2,
      "start": 10547.6,
      "text": "新中國聯邦將引領著虛擬貨幣新潮流"
    },
    {
      "end": 10556.4,
      "start": 10552.56,
      "text": "洗交所總裁談為何要投資加密貨幣"
    },
    {
      "end": 10559.6,
      "start": 10557.04,
      "text": "洗交所總裁傑希布朗"
    },
    {
      "end": 10561.48,
      "start": 10559.6,
      "text": "近期接受媒體採訪"
    },
    {
      "end": 10563.68,
      "start": 10561.48,
      "text": "談到數字貨幣的諸多優點"
    },
    {
      "end": 10566.88,
      "start": 10563.68,
      "text": "將在很多方面給人類社會帶來便利"
    },
    {
      "end": 10569.44,
      "start": 10566.88,
      "text": "首先是結實結算的便利"
    },
    {
      "end": 10572.64,
      "start": 10569.44,
      "text": "加密貨幣從設計上消除了第三方"
    },
    {
      "end": 10573.84,
      "start": 10572.64,
      "text": "比如銀行"
    },
    {
      "end": 10575.92,
      "start": 10573.84,
      "text": "只有支付方和收款方"
    },
    {
      "end": 10577.32,
      "start": 10575.92,
      "text": "結算所需時間"
    },
    {
      "end": 10580.08,
      "start": 10577.32,
      "text": "遠小於傳統資產轉移方式"
    },
    {
      "end": 10582.08,
      "start": 10580.08,
      "text": "第二費用更低"
    },
    {
      "end": 10585.48,
      "start": 10582.08,
      "text": "因為礦工的報酬主要有網絡支付"
    },
    {
      "end": 10587.4,
      "start": 10585.48,
      "text": "與傳統支付方式相比"
    },
    {
      "end": 10590.16,
      "start": 10587.4,
      "text": "加密貨幣轉帳的費用要少很多"
    },
    {
      "end": 10592.0,
      "start": 10590.16,
      "text": "第三保密性"
    },
    {
      "end": 10594.4,
      "start": 10592.0,
      "text": "加密貨幣則是貨幣持有人"
    },
    {
      "end": 10597.16,
      "start": 10594.4,
      "text": "將特地款項發送給收款人"
    },
    {
      "end": 10599.08,
      "start": 10597.16,
      "text": "無需提供更多信息"
    },
    {
      "end": 10601.68,
      "start": 10599.08,
      "text": "這是加密貨幣獨有的隱私保護"
    },
    {
      "end": 10603.48,
      "start": 10601.68,
      "text": "第四通用性"
    },
    {
      "end": 10608.36,
      "start": 10603.48,
      "text": "目前全球有22億人無法使用傳統銀行系統"
    },
    {
      "end": 10610.56,
      "start": 10608.36,
      "text": "加密貨幣消除這些阻礙"
    },
    {
      "end": 10613.8,
      "start": 10610.56,
      "text": "將現代經濟體系開放給每一個人"
    },
    {
      "end": 10615.64,
      "start": 10613.8,
      "text": "第五去中心化"
    },
    {
      "end": 10618.04,
      "start": 10615.64,
      "text": "加密貨幣採用區塊鏈技術"
    },
    {
      "end": 10620.6,
      "start": 10618.04,
      "text": "共同管理和記錄交易書記庫"
    },
    {
      "end": 10623.28,
      "start": 10620.6,
      "text": "而不是單一的中央機構來管理"
    },
    {
      "end": 10625.08,
      "start": 10623.28,
      "text": "第六全球通用"
    },
    {
      "end": 10628.88,
      "start": 10625.08,
      "text": "加密貨幣不受匯率利率交易費用的約束"
    },
    {
      "end": 10631.48,
      "start": 10628.88,
      "text": "可在國際上無障礙交流"
    },
    {
      "end": 10633.08,
      "start": 10631.48,
      "text": "最後透明度"
    },
    {
      "end": 10636.36,
      "start": 10633.08,
      "text": "互聯網上的公開帳戶都來自確認的交易"
    },
    {
      "end": 10638.2,
      "start": 10636.36,
      "text": "因此無法欺詐"
    },
    {
      "end": 10640.12,
      "start": 10638.2,
      "text": "區塊鏈使用智能合約"
    },
    {
      "end": 10642.12,
      "start": 10640.12,
      "text": "使加密貨幣不可破解"
    },
    {
      "end": 10644.32,
      "start": 10643.32,
      "text": "喜碧上市前"
    },
    {
      "end": 10646.92,
      "start": 10644.32,
      "text": "文貴先生給戰友們的三大提醒"
    },
    {
      "end": 10649.92,
      "start": 10647.72,
      "text": "喜馬拉雅虛擬貨幣即將上市"
    },
    {
      "end": 10650.6,
      "start": 10649.92,
      "text": "對此"
    },
    {
      "end": 10653.92,
      "start": 10650.6,
      "text": "郭文貴先生之前在GATE直播裡告訴戰友們"
    },
    {
      "end": 10657.92,
      "start": 10653.92,
      "text": "在迎接喜碧上市的這一歷史時刻到來的喜慶日子"
    },
    {
      "end": 10659.68,
      "start": 10657.92,
      "text": "戰友們要好好休息"
    },
    {
      "end": 10661.4,
      "start": 10659.68,
      "text": "迎接這一時刻的到來"
    },
    {
      "end": 10664.72,
      "start": 10661.4,
      "text": "郭先生同時嘱咐戰友和喜碧預購者們"
    },
    {
      "end": 10666.24,
      "start": 10664.72,
      "text": "大家要有心理準備"
    },
    {
      "end": 10668.12,
      "start": 10666.24,
      "text": "做好如下三大防範"
    },
    {
      "end": 10670.6,
      "start": 10668.12,
      "text": "首先要握緊手中的喜碧"
    },
    {
      "end": 10673.08,
      "start": 10670.6,
      "text": "它關係到長久的控股權"
    },
    {
      "end": 10675.52,
      "start": 10673.08,
      "text": "有控股權才有話語權"
    },
    {
      "end": 10677.92,
      "start": 10675.52,
      "text": "資本主義社會是資本說了算"
    },
    {
      "end": 10679.76,
      "start": 10677.92,
      "text": "要認識到它的重要性"
    },
    {
      "end": 10682.2,
      "start": 10679.76,
      "text": "其次要防備中共收幣"
    },
    {
      "end": 10683.92,
      "start": 10682.2,
      "text": "它們有一國之才"
    },
    {
      "end": 10685.92,
      "start": 10683.92,
      "text": "如果動用海外基金掃貨"
    },
    {
      "end": 10687.84,
      "start": 10685.92,
      "text": "心理承受能力差的佔有"
    },
    {
      "end": 10690.0,
      "start": 10687.84,
      "text": "手中的喜碧就會被洗走"
    },
    {
      "end": 10692.24,
      "start": 10690.0,
      "text": "將失去大好的發展機會"
    },
    {
      "end": 10695.12,
      "start": 10692.24,
      "text": "最後要小心許多基金囤币"
    },
    {
      "end": 10696.84,
      "start": 10695.12,
      "text": "他們是職業投資者"
    },
    {
      "end": 10698.84,
      "start": 10696.84,
      "text": "是經驗豐富的操盤手"
    },
    {
      "end": 10702.52,
      "start": 10698.84,
      "text": "如果戰友們手中的喜碧被他們洗去不賣了"
    },
    {
      "end": 10704.8,
      "start": 10702.52,
      "text": "他們就會向投資人要管理費"
    },
    {
      "end": 10706.2,
      "start": 10704.8,
      "text": "還會拿去抵押"
    },
    {
      "end": 10708.12,
      "start": 10706.2,
      "text": "獲得50%的貸款"
    },
    {
      "end": 10709.16,
      "start": 10708.12,
      "text": "倘若這樣"
    },
    {
      "end": 10711.72,
      "start": 10709.16,
      "text": "大好的賺錢機會就會被他們拿走"
    },
    {
      "end": 10713.88,
      "start": 10711.72,
      "text": "並用其控制喜碧價格"
    },
    {
      "end": 10717.8,
      "start": 10713.88,
      "text": "戰友們不要讓喜碧落入這些虎豹豺狼之手"
    },
    {
      "end": 10719.52,
      "start": 10717.8,
      "text": "文貴先生提醒戰友們"
    },
    {
      "end": 10721.48,
      "start": 10719.52,
      "text": "擁有喜碧就擁有未來"
    },
    {
      "end": 10722.68,
      "start": 10721.48,
      "text": "戰友們切記"
    },
    {
      "end": 10723.48,
      "start": 10722.68,
      "text": "切記"
    },
    {
      "end": 10724.08,
      "start": 10723.48,
      "text": "切記"
    },
    {
      "end": 10730.36,
      "start": 10725.76,
      "text": "西班牙馬德里出現第一家可以使用喜碧支付的商店"
    },
    {
      "end": 10736.4,
      "start": 10731.04,
      "text": "10月31日西班牙馬德里將出現第一家使用喜碧支付的商店"
    },
    {
      "end": 10739.4,
      "start": 10736.4,
      "text": "該商家在收音台上明顯的貼出"
    },
    {
      "end": 10742.8,
      "start": 10739.4,
      "text": "Himalaya Exchange和HPay的宣傳標誌"
    },
    {
      "end": 10746.4,
      "start": 10742.8,
      "text": "醒目的向顧客宣告可用於現實交易的"
    },
    {
      "end": 10749.96,
      "start": 10746.4,
      "text": "跨時代的虛擬貨幣和支付系統誕生了"
    },
    {
      "end": 10752.28,
      "start": 10749.96,
      "text": "喜美元和喜币在今日"
    },
    {
      "end": 10756.12,
      "start": 10752.28,
      "text": "2021年11月1日早上11時11分"
    },
    {
      "end": 10758.68,
      "start": 10756.12,
      "text": "在喜交所交易平台正式上市"
    },
    {
      "end": 10762.0,
      "start": 10758.68,
      "text": "與美元1比1自由兌換的喜美元"
    },
    {
      "end": 10766.2,
      "start": 10762.0,
      "text": "和以20%黃金為儲備的虛擬貨幣洗幣"
    },
    {
      "end": 10768.76,
      "start": 10766.2,
      "text": "雙幣結合啟動貨幣革命"
    },
    {
      "end": 10769.44,
      "start": 10768.76,
      "text": "隨後"
    },
    {
      "end": 10772.4,
      "start": 10769.44,
      "text": "喜交所將推出HPay支付系統"
    },
    {
      "end": 10776.92,
      "start": 10772.4,
      "text": "讓喜美元和喜币成為可以在現實中實際使用的貨幣"
    },
    {
      "end": 10780.72,
      "start": 10776.92,
      "text": "使虛擬貨幣不再只是被炒作的金融商品"
    },
    {
      "end": 10784.4,
      "start": 10780.72,
      "text": "化時代的喜聯儲系統和喜支付的設計"
    },
    {
      "end": 10786.48,
      "start": 10784.4,
      "text": "將把世界帶向更自由"
    },
    {
      "end": 10789.32,
      "start": 10786.48,
      "text": "迅速省錢便利的交易時代"
    },
    {
      "end": 10795.72,
      "start": 10789.32,
      "text": "10月30日"
    },
    {
      "end": 10797.68,
      "start": 10795.72,
      "text": "蓋特上的一張照片顯示"
    },
    {
      "end": 10799.8,
      "start": 10797.68,
      "text": "新著國聯邦已準備好的香檳"
    },
    {
      "end": 10827.14,
      "start": 10799.8,
      "text": "debit"
