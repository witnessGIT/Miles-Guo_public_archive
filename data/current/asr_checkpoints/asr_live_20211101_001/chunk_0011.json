  "segments": [
    {
      "end": 9902.16,
      "start": 9900.0,
      "text": "宣布参选"
    },
    {
      "end": 9903.62,
      "start": 9902.16,
      "text": "老板呢"
    },
    {
      "end": 9904.86,
      "start": 9903.62,
      "text": "你跟大卫草"
    },
    {
      "end": 9905.7,
      "start": 9904.86,
      "text": "跟你们先分享"
    },
    {
      "end": 9909.86,
      "start": 9905.7,
      "text": "我觉得近期"
    },
    {
      "end": 9911.12,
      "start": 9909.86,
      "text": "像川普总统这件事情"
    },
    {
      "end": 9913.36,
      "start": 9911.12,
      "text": "我觉得是大大的刺激"
    },
    {
      "end": 9914.72,
      "start": 9913.36,
      "text": "他们做出这个选择"
    },
    {
      "end": 9916.32,
      "start": 9914.72,
      "text": "因为我觉得"
    },
    {
      "end": 9917.66,
      "start": 9916.32,
      "text": "川普总统这件事情"
    },
    {
      "end": 9919.6,
      "start": 9917.66,
      "text": "实际上是给了蓬佩奥"
    },
    {
      "end": 9920.6,
      "start": 9919.6,
      "text": "一个最好的机会"
    },
    {
      "end": 9922.2,
      "start": 9920.6,
      "text": "当然皮特纳尔罗"
    },
    {
      "end": 9923.94,
      "start": 9922.2,
      "text": "或者是我们之前认为"
    },
    {
      "end": 9924.62,
      "start": 9923.94,
      "text": "像班农"
    },
    {
      "end": 9926.46,
      "start": 9924.62,
      "text": "他都有这个意愿的"
    },
    {
      "end": 9928.04,
      "start": 9926.46,
      "text": "所以他们应该有个"
    },
    {
      "end": 9929.94,
      "start": 9928.04,
      "text": "其实他们都出来的话"
    },
    {
      "end": 9932.92,
      "start": 9929.94,
      "text": "一定是一个非常尴尬的局面"
    },
    {
      "end": 9934.28,
      "start": 9932.92,
      "text": "然后大家去在党内"
    },
    {
      "end": 9935.98,
      "start": 9934.28,
      "text": "是如何才能推出来"
    },
    {
      "end": 9937.08,
      "start": 9935.98,
      "text": "现在我觉得"
    },
    {
      "end": 9939.38,
      "start": 9937.08,
      "text": "蓬佩奥如果能够宣布出来"
    },
    {
      "end": 9940.52,
      "start": 9939.38,
      "text": "那么一定是他们"
    },
    {
      "end": 9942.34,
      "start": 9940.52,
      "text": "已经也叫勾兑吧"
    },
    {
      "end": 9943.9,
      "start": 9942.34,
      "text": "也是私下的商量好了"
    },
    {
      "end": 9945.1,
      "start": 9943.9,
      "text": "也是一种勾兑"
    },
    {
      "end": 9946.24,
      "start": 9945.1,
      "text": "因为这个时机"
    },
    {
      "end": 9948.44,
      "start": 9946.24,
      "text": "我觉得这也是"
    },
    {
      "end": 9949.6,
      "start": 9948.44,
      "text": "对爆料革命来说"
    },
    {
      "end": 9950.24,
      "start": 9949.6,
      "text": "应该是一个"
    },
    {
      "end": 9952.18,
      "start": 9950.24,
      "text": "我们期待的"
    },
    {
      "end": 9953.5,
      "start": 9952.18,
      "text": "期待中的一个结果"
    },
    {
      "end": 9954.36,
      "start": 9953.5,
      "text": "我觉得这个事情"
    },
    {
      "end": 9956.66,
      "start": 9954.36,
      "text": "也是呼之欲出吧"
    },
    {
      "end": 9959.78,
      "start": 9956.66,
      "text": "因为我们心目中的"
    },
    {
      "end": 9961.18,
      "start": 9959.78,
      "text": "皮特纳瓦罗"
    },
    {
      "end": 9961.86,
      "start": 9961.18,
      "text": "可能有更好的"
    },
    {
      "end": 9963.82,
      "start": 9961.86,
      "text": "更希望我们觉得他"
    },
    {
      "end": 9964.36,
      "start": 9963.82,
      "text": "但我们"
    },
    {
      "end": 9965.16,
      "start": 9964.36,
      "text": "我们既然也不能做话"
    },
    {
      "end": 9966.16,
      "start": 9965.16,
      "text": "但是我们期待着"
    },
    {
      "end": 9967.02,
      "start": 9966.16,
      "text": "是另外一个位置"
    },
    {
      "end": 9968.08,
      "start": 9967.02,
      "text": "可能对我们爆料革命"
    },
    {
      "end": 9969.22,
      "start": 9968.08,
      "text": "对我们今天的事情"
    },
    {
      "end": 9971.12,
      "start": 9969.22,
      "text": "都有更深度的影响的"
    },
    {
      "end": 9973.42,
      "start": 9971.12,
      "text": "如果是蓬佩奥出来"
    },
    {
      "end": 9975.1,
      "start": 9973.42,
      "text": "如果是皮特纳瓦罗"
    },
    {
      "end": 9976.56,
      "start": 9975.1,
      "text": "有他另外的一些安排的话"
    },
    {
      "end": 9978.5,
      "start": 9976.56,
      "text": "那当班农先生不用说"
    },
    {
      "end": 9979.6,
      "start": 9978.5,
      "text": "也永远都是我们的战友"
    },
    {
      "end": 9980.66,
      "start": 9979.6,
      "text": "这样的话"
    },
    {
      "end": 9981.92,
      "start": 9980.66,
      "text": "我们形成了一种"
    },
    {
      "end": 9983.14,
      "start": 9981.92,
      "text": "三角稳定的架势"
    },
    {
      "end": 9983.78,
      "start": 9983.14,
      "text": "是对爆料革命"
    },
    {
      "end": 9984.4,
      "start": 9983.78,
      "text": "我觉得是"
    },
    {
      "end": 9986.66,
      "start": 9984.4,
      "text": "最好最好的一个结果吧"
    },
    {
      "end": 9989.54,
      "start": 9986.66,
      "text": "所以今天我觉得到现在为止"
    },
    {
      "end": 9990.28,
      "start": 9989.54,
      "text": "全是好消息"
    },
    {
      "end": 9992.14,
      "start": 9990.28,
      "text": "包括这个延迟的开始"
    },
    {
      "end": 9992.94,
      "start": 9992.14,
      "text": "谢谢"
    },
    {
      "end": 9994.7,
      "start": 9992.94,
      "text": "大卫"
    },
    {
      "end": 9999.98,
      "start": 9994.7,
      "text": "好了"
    },
    {
      "end": 10000.78,
      "start": 9999.98,
      "text": "谢谢"
    },
    {
      "end": 10004.76,
      "start": 10000.78,
      "text": "刚才我们都期待"
    },
    {
      "end": 10007.48,
      "start": 10004.76,
      "text": "去过很多好消息"
    },
    {
      "end": 10009.72,
      "start": 10007.48,
      "text": "大卫你的脉被黑了"
    },
    {
      "end": 10011.86,
      "start": 10009.72,
      "text": "对你的脉被关了问题"
    },
    {
      "end": 10012.46,
      "start": 10011.86,
      "text": "声音不对"
    },
    {
      "end": 10012.78,
      "start": 10012.46,
      "text": "对"
    },
    {
      "end": 10013.36,
      "start": 10012.78,
      "text": "声音是"
    },
    {
      "end": 10016.42,
      "start": 10013.36,
      "text": "现在能听见吗"
    },
    {
      "end": 10016.82,
      "start": 10016.42,
      "text": "哇"
    },
    {
      "end": 10017.26,
      "start": 10016.82,
      "text": "大卫"
    },
    {
      "end": 10018.36,
      "start": 10017.26,
      "text": "应该是挺黑了"
    },
    {
      "end": 10019.86,
      "start": 10018.36,
      "text": "你试一下"
    },
    {
      "end": 10020.52,
      "start": 10019.86,
      "text": "重新"
    },
    {
      "end": 10022.72,
      "start": 10020.52,
      "text": "声音不行"
    },
    {
      "end": 10023.64,
      "start": 10022.72,
      "text": "对"
    },
    {
      "end": 10026.04,
      "start": 10023.64,
      "text": "影响声音被黑了"
    },
    {
      "end": 10027.86,
      "start": 10026.04,
      "text": "嗯"
    },
    {
      "end": 10029.36,
      "start": 10027.86,
      "text": "对"
    },
    {
      "end": 10031.0,
      "start": 10029.36,
      "text": "啊我说的刚才那个交流声"
    },
    {
      "end": 10031.68,
      "start": 10031.0,
      "text": "就是他那边的"
    },
    {
      "end": 10031.88,
      "start": 10031.68,
      "text": "对"
    },
    {
      "end": 10033.4,
      "start": 10031.88,
      "text": "是大卫那边的"
    },
    {
      "end": 10034.3,
      "start": 10033.4,
      "text": "嗯"
    },
    {
      "end": 10035.1,
      "start": 10034.3,
      "text": "现在"
    },
    {
      "end": 10036.58,
      "start": 10035.1,
      "text": "可以尝试"
    },
    {
      "end": 10037.74,
      "start": 10036.58,
      "text": "现在"
    },
    {
      "end": 10039.08,
      "start": 10037.74,
      "text": "现在好了吗"
    },
    {
      "end": 10040.92,
      "start": 10039.08,
      "text": "没有没有"
    },
    {
      "end": 10042.28,
      "start": 10040.92,
      "text": "对一下吧"
    },
    {
      "end": 10043.58,
      "start": 10042.28,
      "text": "我退出"
    },
    {
      "end": 10046.22,
      "start": 10043.58,
      "text": "哈哈哈哈"
    },
    {
      "end": 10046.9,
      "start": 10046.22,
      "text": "那我就说"
    },
    {
      "end": 10048.46,
      "start": 10046.9,
      "text": "电线今天住了"
    },
    {
      "end": 10050.3,
      "start": 10048.46,
      "text": "特别像这个动作"
    },
    {
      "end": 10050.52,
      "start": 10050.3,
      "text": "对"
    },
    {
      "end": 10052.3,
      "start": 10050.52,
      "text": "那草根"
    },
    {
      "end": 10053.26,
      "start": 10052.3,
      "text": "草根"
    },
    {
      "end": 10054.1,
      "start": 10053.26,
      "text": "草根你今天"
    },
    {
      "end": 10054.94,
      "start": 10054.1,
      "text": "你来分享一下"
    },
    {
      "end": 10055.84,
      "start": 10054.94,
      "text": "今天这个"
    },
    {
      "end": 10057.4,
      "start": 10055.84,
      "text": "嗯"
    },
    {
      "end": 10058.9,
      "start": 10057.4,
      "text": "好的好的"
    },
    {
      "end": 10060.2,
      "start": 10058.9,
      "text": "就这个事情"
    },
    {
      "end": 10061.34,
      "start": 10060.2,
      "text": "就是大家应该都是"
    },
    {
      "end": 10062.14,
      "start": 10061.34,
      "text": "都是"
    },
    {
      "end": 10063.9,
      "start": 10062.14,
      "text": "我想都是可以预料到的"
    },
    {
      "end": 10065.4,
      "start": 10063.9,
      "text": "从川普总统开始"
    },
    {
      "end": 10067.24,
      "start": 10065.4,
      "text": "搞那个DWAC的"
    },
    {
      "end": 10068.54,
      "start": 10067.24,
      "text": "那一刻开始啊"
    },
    {
      "end": 10070.8,
      "start": 10068.54,
      "text": "这个竞选总统的机会就很低了"
    },
    {
      "end": 10073.38,
      "start": 10070.8,
      "text": "那么他们这几位相互之间啊"
    },
    {
      "end": 10074.84,
      "start": 10073.38,
      "text": "这个为了党派的利益"
    },
    {
      "end": 10076.54,
      "start": 10074.84,
      "text": "基本上是不可能会内耗的"
    },
    {
      "end": 10076.94,
      "start": 10076.54,
      "text": "是吧"
    },
    {
      "end": 10077.64,
      "start": 10076.94,
      "text": "几个人"
    },
    {
      "end": 10078.94,
      "start": 10077.64,
      "text": "这个党派都肯定是"
    },
    {
      "end": 10080.34,
      "start": 10078.94,
      "text": "利益提前划分好了"
    },
    {
      "end": 10084.02,
      "start": 10080.34,
      "text": "谁最适合这个退到前线来做总统啊"
    },
    {
      "end": 10084.96,
      "start": 10084.02,
      "text": "这几位这个"
    },
    {
      "end": 10086.48,
      "start": 10084.96,
      "text": "可以说是相当"
    },
    {
      "end": 10088.16,
      "start": 10086.48,
      "text": "他们之间也相当于战友吧"
    },
    {
      "end": 10089.46,
      "start": 10088.16,
      "text": "就是为了这个共和党"
    },
    {
      "end": 10091.86,
      "start": 10089.46,
      "text": "这个整个共和党的这个利益来说"
    },
    {
      "end": 10094.26,
      "start": 10091.86,
      "text": "那么现在整个民众呼声最高的呢"
    },
    {
      "end": 10095.3,
      "start": 10094.26,
      "text": "肯定是川普总统"
    },
    {
      "end": 10098.14,
      "start": 10095.3,
      "text": "但是由于这个DWAC这个事件啊"
    },
    {
      "end": 10099.34,
      "start": 10098.14,
      "text": "这个给它造来了"
    },
    {
      "end": 10101.24,
      "start": 10099.34,
      "text": "带来非常大的这个隐患啊"
    },
    {
      "end": 10102.2,
      "start": 10101.24,
      "text": "那么未来的话"
    },
    {
      "end": 10104.54,
      "start": 10102.2,
      "text": "在共和党目前呼声最高啊"
    },
    {
      "end": 10106.1,
      "start": 10104.54,
      "text": "这个民意支持率最高"
    },
    {
      "end": 10107.84,
      "start": 10106.1,
      "text": "也是最有前景的"
    },
    {
      "end": 10109.84,
      "start": 10107.84,
      "text": "那么就是麦克·蓬佩奥先生啊"
    },
    {
      "end": 10111.82,
      "start": 10109.84,
      "text": "这个我相信很多战友吧"
    },
    {
      "end": 10114.38,
      "start": 10111.82,
      "text": "大家都是可以预见到的这个事情啊"
    },
    {
      "end": 10115.38,
      "start": 10114.38,
      "text": "那么也是我们最"
    },
    {
      "end": 10117.58,
      "start": 10115.38,
      "text": "最想要喜闻乐见的一个事情"
    },
    {
      "end": 10119.02,
      "start": 10117.58,
      "text": "因为大家可以看到"
    },
    {
      "end": 10121.32,
      "start": 10119.02,
      "text": "这个蓬佩奥先生他相比于"
    },
    {
      "end": 10123.02,
      "start": 10121.32,
      "text": "其他任何政治家来说"
    },
    {
      "end": 10124.46,
      "start": 10123.02,
      "text": "他是最坚定的那一个人"
    },
    {
      "end": 10126.86,
      "start": 10124.46,
      "text": "然后也是跟这个"
    },
    {
      "end": 10128.22,
      "start": 10126.86,
      "text": "爆料革命走得最近"
    },
    {
      "end": 10130.3,
      "start": 10128.22,
      "text": "第一时间选择这个加入盖特"
    },
    {
      "end": 10131.76,
      "start": 10130.3,
      "text": "这个大家都看在眼里"
    },
    {
      "end": 10133.94,
      "start": 10131.76,
      "text": "而且包括为这个咱们中国人"
    },
    {
      "end": 10135.1,
      "start": 10133.94,
      "text": "华人发声啊"
    },
    {
      "end": 10137.56,
      "start": 10135.1,
      "text": "这个对国家上的所有的爆料啊"
    },
    {
      "end": 10139.78,
      "start": 10137.56,
      "text": "还有有一些那个建议啊"
    },
    {
      "end": 10141.78,
      "start": 10139.78,
      "text": "可以说是绝对的深信不疑"
    },
    {
      "end": 10144.98,
      "start": 10141.78,
      "text": "然后我相信这是对战友们来说"
    },
    {
      "end": 10147.62,
      "start": 10144.98,
      "text": "可以说是今天除了喜闭以外"
    },
    {
      "end": 10148.78,
      "start": 10147.62,
      "text": "最好的一个消息"
    },
    {
      "end": 10149.76,
      "start": 10148.78,
      "text": "如果说川普总统"
    },
    {
      "end": 10151.66,
      "start": 10149.76,
      "text": "继续要去竞选总统的话"
    },
    {
      "end": 10153.88,
      "start": 10151.66,
      "text": "他会成为中共的这个重视之地啊"
    },
    {
      "end": 10156.0,
      "start": 10153.88,
      "text": "就是包括这个民主党派的"
    },
    {
      "end": 10157.42,
      "start": 10156.0,
      "text": "这个攻击的主要目标"
    },
    {
      "end": 10160.76,
      "start": 10157.42,
      "text": "尤其是现在还摊上这个DWAC的这个"
    },
    {
      "end": 10162.66,
      "start": 10160.76,
      "text": "未来可能会变成一个"
    },
    {
      "end": 10165.1,
      "start": 10162.66,
      "text": "这个巨大的这个形式诉讼案啊"
    },
    {
      "end": 10167.6,
      "start": 10165.1,
      "text": "然后那么他现在退居二线的话"
    },
    {
      "end": 10168.7,
      "start": 10167.6,
      "text": "对他个人来讲"
    },
    {
      "end": 10170.54,
      "start": 10168.7,
      "text": "也是一个最好的一个结果"
    },
    {
      "end": 10172.58,
      "start": 10170.54,
      "text": "那么这个选择同时呢"
