  "segments": [
    {
      "end": 5402.04,
      "start": 5400.0,
      "text": "所有紛凡世界里面的"
    },
    {
      "end": 5404.72,
      "start": 5402.04,
      "text": "所谓要带来的一些威胁"
    },
    {
      "end": 5406.12,
      "start": 5404.72,
      "text": "他们都一样"
    },
    {
      "end": 5407.22,
      "start": 5406.12,
      "text": "他们也有选择"
    },
    {
      "end": 5408.92,
      "start": 5407.22,
      "text": "不是每个人都可以"
    },
    {
      "end": 5411.48,
      "start": 5408.92,
      "text": "像这个对双方台女儿"
    },
    {
      "end": 5412.92,
      "start": 5411.48,
      "text": "这么勇敢可爱的"
    },
    {
      "end": 5416.12,
      "start": 5412.92,
      "text": "来去面对的这些大众的"
    },
    {
      "end": 5418.46,
      "start": 5416.12,
      "text": "没有任何的遮掩"
    },
    {
      "end": 5420.3,
      "start": 5418.46,
      "text": "这些不敢脑面这帮孙子"
    },
    {
      "end": 5422.68,
      "start": 5420.3,
      "text": "所有那个博士团里面那些孙子"
    },
    {
      "end": 5424.6,
      "start": 5422.68,
      "text": "所谓天上吊屎"
    },
    {
      "end": 5426.04,
      "start": 5424.6,
      "text": "对吧"
    },
    {
      "end": 5427.64,
      "start": 5426.04,
      "text": "那个大粪的这帮孙子"
    },
    {
      "end": 5428.76,
      "start": 5427.64,
      "text": "有磕巴的"
    },
    {
      "end": 5429.64,
      "start": 5428.76,
      "text": "有不敢露脸"
    },
    {
      "end": 5431.68,
      "start": 5429.64,
      "text": "你说这帮孙子到了今天"
    },
    {
      "end": 5433.76,
      "start": 5431.68,
      "text": "连那么个脸你都没露"
    },
    {
      "end": 5435.86,
      "start": 5433.76,
      "text": "你们这帮孙子还告诉你们灭共"
    },
    {
      "end": 5437.52,
      "start": 5435.86,
      "text": "你们这帮孙子你说"
    },
    {
      "end": 5439.16,
      "start": 5437.52,
      "text": "这就是最大的假"
    },
    {
      "end": 5441.0,
      "start": 5439.16,
      "text": "最大的恶共产党"
    },
    {
      "end": 5441.32,
      "start": 5441.0,
      "text": "是吧"
    },
    {
      "end": 5443.82,
      "start": 5441.32,
      "text": "他们拿他们的假丑恶"
    },
    {
      "end": 5445.84,
      "start": 5443.82,
      "text": "来去糊弄老百姓"
    },
    {
      "end": 5446.32,
      "start": 5445.84,
      "text": "哎"
    },
    {
      "end": 5447.68,
      "start": 5446.32,
      "text": "这帮孙子之后"
    },
    {
      "end": 5449.24,
      "start": 5447.68,
      "text": "被洗脑的还都信了"
    },
    {
      "end": 5449.56,
      "start": 5449.24,
      "text": "是吧"
    },
    {
      "end": 5450.64,
      "start": 5449.56,
      "text": "这么点的孩子"
    },
    {
      "end": 5451.82,
      "start": 5450.64,
      "text": "有很多在国内的"
    },
    {
      "end": 5453.72,
      "start": 5451.82,
      "text": "那都是官腔十足啊"
    },
    {
      "end": 5455.34,
      "start": 5453.72,
      "text": "学生会主席啊"
    },
    {
      "end": 5456.46,
      "start": 5455.34,
      "text": "哦啊"
    },
    {
      "end": 5457.62,
      "start": 5456.46,
      "text": "那么的欺负人"
    },
    {
      "end": 5458.18,
      "start": 5457.62,
      "text": "是吧"
    },
    {
      "end": 5459.24,
      "start": 5458.18,
      "text": "睁眼说瞎话"
    },
    {
      "end": 5460.36,
      "start": 5459.24,
      "text": "给老师送礼"
    },
    {
      "end": 5462.12,
      "start": 5460.36,
      "text": "他们小学生啊"
    },
    {
      "end": 5463.76,
      "start": 5462.12,
      "text": "都有收钱的"
    },
    {
      "end": 5464.48,
      "start": 5463.76,
      "text": "是吧"
    },
    {
      "end": 5467.36,
      "start": 5464.48,
      "text": "所有的这些演艺界唱歌的"
    },
    {
      "end": 5469.36,
      "start": 5467.36,
      "text": "这帮孙子那简直是"
    },
    {
      "end": 5470.62,
      "start": 5469.36,
      "text": "恶心的你"
    },
    {
      "end": 5473.84,
      "start": 5470.62,
      "text": "都没办理我讲的孙男"
    },
    {
      "end": 5474.12,
      "start": 5473.84,
      "text": "是吧"
    },
    {
      "end": 5476.16,
      "start": 5474.12,
      "text": "包括这些什么唱歌的那些什么"
    },
    {
      "end": 5477.04,
      "start": 5476.16,
      "text": "红豆啊"
    },
    {
      "end": 5477.36,
      "start": 5477.04,
      "text": "孙昊"
    },
    {
      "end": 5478.84,
      "start": 5477.36,
      "text": "见了江湖的"
    },
    {
      "end": 5481.64,
      "start": 5478.84,
      "text": "把他的骰子都吃了"
    },
    {
      "end": 5482.16,
      "start": 5481.64,
      "text": "对吧"
    },
    {
      "end": 5483.76,
      "start": 5482.16,
      "text": "骰子都跪在那儿"
    },
    {
      "end": 5484.54,
      "start": 5483.76,
      "text": "啊我给你跪下"
    },
    {
      "end": 5485.56,
      "start": 5484.54,
      "text": "我那个"
    },
    {
      "end": 5487.92,
      "start": 5485.56,
      "text": "因为我前期当时有小孩"
    },
    {
      "end": 5488.38,
      "start": 5487.92,
      "text": "对吧"
    },
    {
      "end": 5488.88,
      "start": 5488.38,
      "text": "在一块"
    },
    {
      "end": 5489.42,
      "start": 5488.88,
      "text": "抽烟"
    },
    {
      "end": 5490.96,
      "start": 5489.42,
      "text": "说他一次他不听"
    },
    {
      "end": 5491.74,
      "start": 5490.96,
      "text": "第二次"
    },
    {
      "end": 5492.62,
      "start": 5491.74,
      "text": "打他完了"
    },
    {
      "end": 5494.1,
      "start": 5492.62,
      "text": "这帮孙子"
    },
    {
      "end": 5495.5,
      "start": 5494.1,
      "text": "你想想唐平"
    },
    {
      "end": 5498.02,
      "start": 5495.5,
      "text": "就是当你看到共产党的体制"
    },
    {
      "end": 5499.64,
      "start": 5498.02,
      "text": "培养出这种人的时候"
    },
    {
      "end": 5500.96,
      "start": 5499.64,
      "text": "你想想他能做好作品吗"
    },
    {
      "end": 5503.22,
      "start": 5500.96,
      "text": "他们这所有唱出来的"
    },
    {
      "end": 5504.0,
      "start": 5503.22,
      "text": "就是为了钱"
    },
    {
      "end": 5504.62,
      "start": 5504.0,
      "text": "对吧"
    },
    {
      "end": 5506.24,
      "start": 5504.62,
      "text": "怎么能胡乱当官的"
    },
    {
      "end": 5508.28,
      "start": 5506.24,
      "text": "怎么能骗老百姓的钱"
    },
    {
      "end": 5508.9,
      "start": 5508.28,
      "text": "是吧"
    },
    {
      "end": 5510.16,
      "start": 5508.9,
      "text": "他哪有什么创造力"
    },
    {
      "end": 5512.02,
      "start": 5510.16,
      "text": "想我自己创造一个作品"
    },
    {
      "end": 5513.5,
      "start": 5512.02,
      "text": "唤醒民众"
    },
    {
      "end": 5514.52,
      "start": 5513.5,
      "text": "狗屁"
    },
    {
      "end": 5515.12,
      "start": 5514.52,
      "text": "是吧"
    },
    {
      "end": 5516.82,
      "start": 5515.12,
      "text": "所以今天就是说通过"
    },
    {
      "end": 5519.7,
      "start": 5516.82,
      "text": "老板长这两个双方他女儿的演唱"
    },
    {
      "end": 5520.38,
      "start": 5519.7,
      "text": "我们都会"
    },
    {
      "end": 5524.18,
      "start": 5520.38,
      "text": "衍生出很多的这种事情"
    },
    {
      "end": 5525.34,
      "start": 5524.18,
      "text": "好的"
    },
    {
      "end": 5528.08,
      "start": 5525.34,
      "text": "谢谢"
    },
    {
      "end": 5531.64,
      "start": 5528.08,
      "text": "哇"
    },
    {
      "end": 5532.68,
      "start": 5531.64,
      "text": "听了这个"
    },
    {
      "end": 5537.0,
      "start": 5532.68,
      "text": "海东哥的发言"
    },
    {
      "end": 5538.38,
      "start": 5537.0,
      "text": "真的是特别有感而发"
    },
    {
      "end": 5539.18,
      "start": 5538.38,
      "text": "就是音乐界"
    },
    {
      "end": 5540.34,
      "start": 5539.18,
      "text": "特别的"
    },
    {
      "end": 5542.76,
      "start": 5540.34,
      "text": "在此我也特别特别的感恩"
    },
    {
      "end": 5544.04,
      "start": 5542.76,
      "text": "这个感恩爆料革命"
    },
    {
      "end": 5545.68,
      "start": 5544.04,
      "text": "真的是让我们能有机会"
    },
    {
      "end": 5546.72,
      "start": 5545.68,
      "text": "不为了"
    },
    {
      "end": 5548.32,
      "start": 5546.72,
      "text": "就是可以不为了钱"
    },
    {
      "end": 5549.48,
      "start": 5548.32,
      "text": "去创作"
    },
    {
      "end": 5550.1,
      "start": 5549.48,
      "text": "去结合"
    },
    {
      "end": 5551.3,
      "start": 5550.1,
      "text": "就是为了我们自己"
    },
    {
      "end": 5553.02,
      "start": 5551.3,
      "text": "心里最真实的想法"
    },
    {
      "end": 5554.0,
      "start": 5553.02,
      "text": "表达出来"
    },
    {
      "end": 5556.76,
      "start": 5554.0,
      "text": "然后去为正义发声"
    },
    {
      "end": 5558.54,
      "start": 5556.76,
      "text": "而不是去为了钱"
    },
    {
      "end": 5559.3,
      "start": 5558.54,
      "text": "让我们永远"
    },
    {
      "end": 5560.62,
      "start": 5559.3,
      "text": "不用为了无头敏"
    },
    {
      "end": 5562.34,
      "start": 5560.62,
      "text": "而主要去当任何人的"
    },
    {
      "end": 5563.84,
      "start": 5562.34,
      "text": "这个工具"
    },
    {
      "end": 5566.4,
      "start": 5563.84,
      "text": "或者是帮他们宣传任何的喜乐的东西"
    },
    {
      "end": 5569.36,
      "start": 5566.4,
      "text": "感谢七哥能让我们站着写歌"
    },
    {
      "end": 5570.28,
      "start": 5569.36,
      "text": "站着唱歌"
    },
    {
      "end": 5571.08,
      "start": 5570.28,
      "text": "感恩"
    },
    {
      "end": 5574.58,
      "start": 5571.08,
      "text": "谢谢"
    },
    {
      "end": 5575.14,
      "start": 5574.58,
      "text": "谢谢"
    },
    {
      "end": 5575.52,
      "start": 5575.14,
      "text": "谢谢"
    },
    {
      "end": 5575.62,
      "start": 5575.52,
      "text": "谢谢"
    },
    {
      "end": 5576.04,
      "start": 5575.62,
      "text": "太好了"
    },
    {
      "end": 5576.08,
      "start": 5576.04,
      "text": "太好了"
    },
    {
      "end": 5576.42,
      "start": 5576.08,
      "text": "好的"
    },
    {
      "end": 5583.4,
      "start": 5576.42,
      "text": "那么接下来我们现在就是隔离威励时间"
    },
    {
      "end": 5585.5,
      "start": 5583.4,
      "text": "11点11分了"
    },
    {
      "end": 5588.98,
      "start": 5585.5,
      "text": "那么也就是我们的美东时间的7点11分了"
    },
    {
      "end": 5594.8,
      "start": 5588.98,
      "text": "那现在我们有一个切金枪鱼的仪式"
    },
    {
      "end": 5595.4,
      "start": 5594.8,
      "text": "OK"
    },
    {
      "end": 5597.6,
      "start": 5595.4,
      "text": "那长导哥来带我们参观一下"
    },
    {
      "end": 5598.6,
      "start": 5597.6,
      "text": "好"
    },
    {
      "end": 5600.0,
      "start": 5598.6,
      "text": "那我们先进入一个"
    },
    {
      "end": 5600.6,
      "start": 5600.0,
      "text": "对"
    },
    {
      "end": 5603.36,
      "start": 5600.6,
      "text": "先进入一个十几秒的转场视频"
    },
    {
      "end": 5606.8,
      "start": 5603.36,
      "text": "然后我们就回来给大家带来最新鲜的"
    },
    {
      "end": 5608.86,
      "start": 5606.8,
      "text": "最漂亮的"
    },
    {
      "end": 5611.16,
      "start": 5608.86,
      "text": "最新鲜的金枪鱼"
    },
    {
      "end": 5615.74,
      "start": 5611.16,
      "text": "足 söyleye Eğer"
    },
    {
      "end": 5638.52,
      "start": 5634.02,
      "text": "爸爸"
    },
    {
      "end": 5643.52,
      "start": 5638.52,
      "text": "看到了吗?刚刚拿过来的,很新鲜的。"
    },
    {
      "end": 5652.52,
      "start": 5647.52,
      "text": "是不是老班长口水已经流出来了,我已经看到了。"
    },
    {
      "end": 5658.52,
      "start": 5653.52,
      "text": "老哥,正好早上还没吃饭,真想冲过去。"
    },
    {
      "end": 5662.52,
      "start": 5659.52,
      "text": "后悔没去,后悔没去,有没有。"
    },
    {
      "end": 5665.52,
      "start": 5663.52,
      "text": "对啊,他不是因为你啊。"
    },
    {
      "end": 5673.52,
      "start": 5665.52,
      "text": "你们知道为什么今天会安排这么一个金枪雨吗?"
    },
    {
      "end": 5678.52,
      "start": 5676.52,
      "text": "为什么?这仪式还真没经历过。"
    },
    {
      "end": 5685.52,
      "start": 5679.52,
      "text": "应该从日本来的吧,金枪雨从日本过来是非常非常昂贵的。"
    },
    {
      "end": 5692.52,
      "start": 5686.52,
      "text": "但是我具体话不是很懂,但是这个仪式导歌能不能透露点?"
    },
    {
      "end": 5702.52,
      "start": 5692.52,
      "text": "我之前钓过这个蓝骑金枪雨,还有那种蓝枪雨。"
    },
    {
      "end": 5707.52,
      "start": 5703.52,
      "text": "那个最大的那个,它的体重会达到800磅。"
    },
    {
      "end": 5709.52,
      "start": 5707.52,
      "text": "最大的那个蓝枪雨。"
    },
    {
      "end": 5716.52,
      "start": 5710.52,
      "text": "而且我还亲自还钓到过,就是我们从船上的人还钓到过。"
    },
    {
      "end": 5724.52,
      "start": 5717.52,
      "text": "他们要首先要申请一个,申请一个那个,就是一个配额吧,好像也是。"
    },
    {
      "end": 5728.52,
      "start": 5724.52,
      "text": "你是要去申请的,好像是10万块钱一个配额。"
    },
    {
      "end": 5732.52,
      "start": 5729.52,
      "text": "你才能去,有机会才能去钓到这个鱼。"
    },
    {
      "end": 5736.52,
      "start": 5733.52,
      "text": "然后呢,还要去量那个鱼的体温。"
    },
    {
      "end": 5738.52,
      "start": 5736.52,
      "text": "就是鱼的那个肉的体温。"
    },
    {
      "end": 5744.52,
      "start": 5739.52,
      "text": "当时是先要把这个鱼的,因为鱼太大了,拉不动。"
    },
    {
      "end": 5749.52,
      "start": 5745.52,
      "text": "然后呢,先要把鱼的血放掉,然后一直拖着。"
    },
    {
      "end": 5754.52,
      "start": 5750.52,
      "text": "不是把它倒到船上,而是一直拖着,拖着到岸边上。"
    },
    {
      "end": 5758.52,
      "start": 5755.52,
      "text": "这样,它那个鱼游了,就是被拖着,因为放了血了嘛。"
    },
    {
      "end": 5763.52,
      "start": 5758.52,
      "text": "然后到那个岸边的时候,基本上就已经是已经贫瘤了。"
    },
    {
      "end": 5770.52,
      "start": 5764.52,
      "text": "所以这个之前在太平洋吧,基本上就是很少见了。"
    },
    {
      "end": 5771.52,
      "start": 5770.52,
      "text": "现在还大西洋还有。"
    },
    {
      "end": 5774.52,
      "start": 5772.52,
      "text": "对,来,韦哥。"
    },
    {
      "end": 5784.52,
      "start": 5775.52,
      "text": "对,那个,其实这个鱼啊,我们之前都应该在昨天,前天之前,我们都没有这些环节,都不知道的。"
    },
    {
      "end": 5790.52,
      "start": 5784.52,
      "text": "我们就想着,就是正常的到时间,我们一起来迎接这个洗碟上市。"
    },
    {
      "end": 5793.52,
      "start": 5791.52,
      "text": "然后呢,七哥就马上安排。"
    },
    {
      "end": 5800.52,
      "start": 5794.52,
      "text": "这个这么激动能心的时刻,一定要配上这个最好的,最高品质的这个鱼。"
    },
    {
      "end": 5805.52,
      "start": 5801.52,
      "text": "其实鱼,这个其实也很简单,我们过去在国内的时候,"
    },
    {
      "end": 5813.52,
      "start": 5806.52,
      "text": "我记得我小时候有经历的,每年的30晚上,我们都会吃鱼,或者大年初一。"
    },
    {
      "end": 5815.52,
      "start": 5813.52,
      "text": "叫年年有余,是吧?"
    },
    {
      "end": 5817.52,
      "start": 5815.52,
      "text": "是不是也没有这个?"
    },
    {
      "end": 5818.52,
      "start": 5817.52,
      "text": "对。"
    },
    {
      "end": 5819.52,
      "start": 5818.52,
      "text": "老班长。"
    },
    {
      "end": 5821.52,
      "start": 5820.52,
      "text": "对,对,对,对。"
    },
    {
      "end": 5823.52,
      "start": 5821.52,
      "text": "但是我们年年没有这个年有余。"
    },
    {
      "end": 5829.52,
      "start": 5823.52,
      "text": "对,我们在吃鱼,这个鱼太好了,对吧?"
    },
    {
      "end": 5831.52,
      "start": 5829.52,
      "text": "级别太高了。"
    },
    {
      "end": 5836.52,
      "start": 5832.52,
      "text": "世界上最好的,我刚才接唐萍那句话,世界上最好的金枪鱼,"
    },
    {
      "end": 5839.52,
      "start": 5836.52,
      "text": "是不叫蓝骑马苏金枪鱼?"
    },
    {
      "end": 5841.52,
      "start": 5839.52,
      "text": "蓝骑马苏金枪鱼。"
    },
    {
      "end": 5843.52,
      "start": 5841.52,
      "text": "对,蓝骑金枪鱼。"
    },
    {
      "end": 5845.52,
      "start": 5843.52,
      "text": "蓝骑马苏金枪鱼相当的贵。"
    },
    {
      "end": 5849.52,
      "start": 5846.52,
      "text": "特别是在日本卖的相当的贵。"
    },
    {
      "end": 5850.52,
      "start": 5849.52,
      "text": "对。"
    },
    {
      "end": 5853.52,
      "start": 5850.52,
      "text": "看我们这个鱼能够卖。"
    },
    {
      "end": 5856.52,
      "start": 5853.52,
      "text": "切鱼的师父的帽子都换了。"
    },
    {
      "end": 5862.52,
      "start": 5861.52,
      "text": "应该是几十万吧。"
    },
    {
      "end": 5864.52,
      "start": 5862.52,
      "text": "看着非常贵。"
    },
    {
      "end": 5866.52,
      "start": 5864.52,
      "text": "老板娘说的。"
    },
    {
      "end": 5867.52,
      "start": 5866.52,
      "text": "这个我在。"
    },
    {
      "end": 5869.52,
      "start": 5867.52,
      "text": "张艺姐,张艺姐,你来。"
    },
    {
      "end": 5876.52,
      "start": 5869.52,
      "text": "对,我在2001年左右,刚退役以后,"
    },
    {
      "end": 5880.52,
      "start": 5876.52,
      "text": "然后去马尔代夫,当时去马尔代夫。"
    },
    {
      "end": 5884.52,
      "start": 5880.52,
      "text": "那时候马尔代夫这个旅行,"
    },
    {
      "end": 5888.52,
      "start": 5884.52,
      "text": "报旅行团,他还是在香港报的旅行团,"
    },
    {
      "end": 5890.52,
      "start": 5888.52,
      "text": "然后从香港去的马尔代夫。"
    },
    {
      "end": 5895.52,
      "start": 5890.52,
      "text": "当时在那儿就是钓鱼,什么看珊瑚。"
    },
    {
      "end": 5898.52,
      "start": 5895.52,
      "text": "就这些活动嘛,都是。"
    },
    {
      "end": 5901.52,
      "start": 5898.52,
      "text": "完了当时就是拿着这个金枪鱼的肉,"
    },
    {
      "end": 5904.52,
      "start": 5901.52,
      "text": "去到外面钓的鱼。"
    },
    {
      "end": 5908.52,
      "start": 5904.52,
      "text": "我那个金枪鱼吃完了以后,"
    },
    {
      "end": 5912.52,
      "start": 5908.52,
      "text": "这个我自从那次回到国内,"
    },
    {
      "end": 5914.52,
      "start": 5912.52,
      "text": "我的金枪鱼我再也不吃了。"
    },
    {
      "end": 5916.52,
      "start": 5914.52,
      "text": "因为感觉回在国内,"
    },
    {
      "end": 5919.52,
      "start": 5916.52,
      "text": "那个金枪鱼没法吃的味道是完全两种味道。"
    },
    {
      "end": 5923.52,
      "start": 5919.52,
      "text": "然后再后来就是到了日本以后,"
    },
    {
      "end": 5926.52,
      "start": 5923.52,
      "text": "才又开始恢复吃金枪鱼。"
    },
    {
      "end": 5929.52,
      "start": 5926.52,
      "text": "这个肯定是七哥,"
    },
    {
      "end": 5933.52,
      "start": 5929.52,
      "text": "是从日本发过来的金枪鱼。"
    },
    {
      "end": 5936.52,
      "start": 5933.52,
      "text": "这个金枪鱼最好的就是大斧,"
    },
    {
      "end": 5940.52,
      "start": 5936.52,
      "text": "它这整个一条金枪鱼里面最贵的就是大斧,"
    },
    {
      "end": 5943.52,
      "start": 5940.52,
      "text": "就是这个蓝旗金枪鱼的大斧,"
    },
    {
      "end": 5948.52,
      "start": 5943.52,
      "text": "就是它这块儿脂肪最饱和最大的。"
    },
    {
      "end": 5951.52,
      "start": 5948.52,
      "text": "反正在西班牙最好的吧,"
    },
    {
      "end": 5953.52,
      "start": 5951.52,
      "text": "就算日餐的noble的,"
    },
    {
      "end": 5955.52,
      "start": 5953.52,
      "text": "它一片12个欧嘛,"
    },
    {
      "end": 5957.52,
      "start": 5955.52,
      "text": "这就算最贵的。"
    },
    {
      "end": 5960.52,
      "start": 5957.52,
      "text": "在我们这边。"
    },
    {
      "end": 5962.52,
      "start": 5960.52,
      "text": "对,在我们这边。"
    },
    {
      "end": 5964.52,
      "start": 5962.52,
      "text": "七哥不是之前就说,"
    },
    {
      "end": 5966.5,
      "start": 5964.52,
      "text": "我这不是,我这不是,"
    },
    {
      "end": 5969.52,
      "start": 5966.52,
      "text": "它也是两星的乙鲤,"
    },
    {
      "end": 5971.52,
      "start": 5969.52,
      "text": "原先在英国有三星乙鲤,"
    },
    {
      "end": 5973.52,
      "start": 5971.52,
      "text": "但是慢慢它开的越来越多,"
    },
    {
      "end": 5975.52,
      "start": 5973.52,
      "text": "就慢慢就差了。"
    },
    {
      "end": 5978.52,
      "start": 5975.52,
      "text": "但是最好的这种金枪鱼的所谓品质啊,"
    },
    {
      "end": 5979.52,
      "start": 5978.52,
      "text": "什么的,"
    },
    {
      "end": 5980.52,
      "start": 5979.52,
      "text": "就是日本人最喜欢吃,"
    },
    {
      "end": 5982.52,
      "start": 5980.52,
      "text": "他们把这种生鱼片,"
    },
    {
      "end": 5985.52,
      "start": 5982.52,
      "text": "刺身啊做到极致,"
    },
    {
      "end": 5987.52,
      "start": 5985.52,
      "text": "就像它什么温度啊,"
    },
    {
      "end": 5988.52,
      "start": 5987.52,
      "text": "薄厚啊,"
    },
    {
      "end": 5990.52,
      "start": 5988.52,
      "text": "所有的这些脂肪的含量啊,"
    },
    {
      "end": 5992.52,
      "start": 5990.52,
      "text": "反正蓝旗金枪鱼的大腹,"
    },
    {
      "end": 5994.52,
      "start": 5992.52,
      "text": "它这里面最好的嘛,"
    },
    {
      "end": 5995.52,
      "start": 5994.52,
      "text": "它这一整条,"
    },
    {
      "end": 5997.52,
      "start": 5995.52,
      "text": "那尾巴的不是很好,"
    },
    {
      "end": 5998.52,
      "start": 5997.52,
      "text": "头的不是很好,"
    },
    {
      "end": 6000.52,
      "start": 5998.52,
      "text": "中间可能最好的这种,"
    },
    {
      "end": 6004.52,
      "start": 6000.52,
      "text": "虎步那一块儿的有一块,"
    },
    {
      "end": 6006.52,
      "start": 6004.52,
      "text": "那么是最好的,"
    },
    {
      "end": 6008.52,
      "start": 6006.52,
      "text": "叫蓝旗金枪大腹,"
    },
    {
      "end": 6010.52,
      "start": 6008.52,
      "text": "就是最高级的了呗,"
    },
    {
      "end": 6011.52,
      "start": 6010.52,
      "text": "确实,"
    },
    {
      "end": 6013.52,
      "start": 6011.52,
      "text": "中共国内,"
    },
    {
      "end": 6014.52,
      "start": 6013.52,
      "text": "别提了,"
    },
    {
      "end": 6016.52,
      "start": 6014.52,
      "text": "他们这帮孙子全都是假的,"
    },
    {
      "end": 6017.52,
      "start": 6016.52,
      "text": "完了一次冲好,"
    },
    {
      "end": 6018.52,
      "start": 6017.52,
      "text": "完了你想想,"
    },
    {
      "end": 6020.52,
      "start": 6018.52,
      "text": "他们这些三文鱼,"
    },
    {
      "end": 6021.52,
      "start": 6020.52,
      "text": "这不都是吗?"
    },
    {
      "end": 6022.52,
      "start": 6021.52,
      "text": "很多根本都是三文鱼,"
    },
    {
      "end": 6025.52,
      "start": 6022.52,
      "text": "拿国内的那种类似什么一种鱼,"
    },
    {
      "end": 6027.52,
      "start": 6025.52,
      "text": "就冒充了三文鱼,"
    },
    {
      "end": 6028.52,
      "start": 6027.52,
      "text": "你说,"
    },
    {
      "end": 6029.52,
      "start": 6028.52,
      "text": "共产党里面,"
    },
    {
      "end": 6030.52,
      "start": 6029.52,
      "text": "这帮孙子真的,"
    },
    {
      "end": 6031.52,
      "start": 6030.52,
      "text": "全都是假的,"
    },
    {
      "end": 6033.52,
      "start": 6031.52,
      "text": "完了就是用一些农药啊,"
    },
    {
      "end": 6034.52,
      "start": 6033.52,
      "text": "是吧,"
    },
    {
      "end": 6036.52,
      "start": 6034.52,
      "text": "所谓的这些养殖的,"
    },
    {
      "end": 6037.52,
      "start": 6036.52,
      "text": "我怕这没法,"
    },
    {
      "end": 6039.52,
      "start": 6037.52,
      "text": "抗生素,"
    },
    {
      "end": 6040.52,
      "start": 6039.52,
      "text": "吃完我们全都是,"
    },
    {
      "end": 6042.52,
      "start": 6040.52,
      "text": "真的我们是小白薯,"
    },
    {
      "end": 6044.52,
      "start": 6042.52,
      "text": "太可怜了,"
    },
    {
      "end": 6046.52,
      "start": 6044.52,
      "text": "老百姓太可怜了,"
    },
    {
      "end": 6047.52,
      "start": 6046.52,
      "text": "讲实话,"
    },
    {
      "end": 6049.52,
      "start": 6047.52,
      "text": "每个人都不可能,"
    },
    {
      "end": 6050.52,
      "start": 6049.52,
      "text": "你独善其身,"
    },
    {
      "end": 6052.52,
      "start": 6050.52,
      "text": "你中共老大毛们,"
    },
    {
      "end": 6054.52,
      "start": 6052.52,
      "text": "中南海那些人所谓特供了,"
    },
    {
      "end": 6056.52,
      "start": 6054.52,
      "text": "你空气能特供吗?"
    },
    {
      "end": 6057.52,
      "start": 6056.52,
      "text": "你水,"
    },
    {
      "end": 6058.52,
      "start": 6057.52,
      "text": "菜,"
    },
    {
      "end": 6059.52,
      "start": 6058.52,
      "text": "蛋,"
    },
    {
      "end": 6060.52,
      "start": 6059.52,
      "text": "你特供了,"
    },
    {
      "end": 6061.52,
      "start": 6060.52,
      "text": "空气最后,"
    },
    {
      "end": 6062.52,
      "start": 6061.52,
      "text": "PM2.5,"
    },
    {
      "end": 6063.52,
      "start": 6062.52,
      "text": "要把你堵死,"
    },
    {
      "end": 6064.52,
      "start": 6063.52,
      "text": "是吧,"
    },
    {
      "end": 6066.52,
      "start": 6064.52,
      "text": "所以在中共的体制底下,"
    },
    {
      "end": 6068.52,
      "start": 6066.52,
      "text": "你没有一个人,"
    },
    {
      "end": 6069.52,
      "start": 6068.52,
      "text": "是吧,"
    },
    {
      "end": 6070.52,
      "start": 6069.52,
      "text": "副超之下没有玩卵,"
    },
    {
      "end": 6073.52,
      "start": 6070.52,
      "text": "今天这个鱼啊,"
    },
    {
      "end": 6076.52,
      "start": 6073.52,
      "text": "我刚问了这个在场的师傅,"
    },
    {
      "end": 6077.52,
      "start": 6076.52,
      "text": "97磅,"
    },
    {
      "end": 6080.52,
      "start": 6077.52,
      "text": "97磅哪一金枪鱼?"
    },
    {
      "end": 6083.52,
      "start": 6080.52,
      "text": "可以看出来很新鲜啊,"
    },
    {
      "end": 6084.52,
      "start": 6083.52,
      "text": "一般鸡香鱼,"
    },
    {
      "end": 6085.52,
      "start": 6084.52,
      "text": "它如果稍微不新鲜,"
    },
    {
      "end": 6086.52,
      "start": 6085.52,
      "text": "它就会变成特别暗的,"
    },
    {
      "end": 6087.52,
      "start": 6086.52,
      "text": "暗红色,"
    },
    {
      "end": 6088.52,
      "start": 6087.52,
      "text": "暗红色,"
    },
    {
      "end": 6090.52,
      "start": 6088.52,
      "text": "之前在墙内,"
    },
    {
      "end": 6091.52,
      "start": 6090.52,
      "text": "在中国吃的时候,"
    },
    {
      "end": 6092.52,
      "start": 6091.52,
      "text": "都是基本上都快黑了,"
    },
    {
      "end": 6094.52,
      "start": 6092.52,
      "text": "那个鱼你在日本料理店,"
    },
    {
      "end": 6095.52,
      "start": 6094.52,
      "text": "对,"
    },
    {
      "end": 6096.52,
      "start": 6095.52,
      "text": "你只有在最高级的日本料理店,"
    },
    {
      "end": 6098.52,
      "start": 6096.52,
      "text": "你才能吃稍微新鲜一点的,"
    },
    {
      "end": 6099.52,
      "start": 6098.52,
      "text": "剩下的,"
    },
    {
      "end": 6101.52,
      "start": 6099.52,
      "text": "基本上给大家平民吃的,"
    },
    {
      "end": 6102.52,
      "start": 6101.52,
      "text": "都是那种特别暗红,"
    },
    {
      "end": 6104.52,
      "start": 6102.52,
      "text": "都不知道多长时间了,"
    },
    {
      "end": 6106.52,
      "start": 6104.52,
      "text": "真的是很感叹,"
    },
    {
      "end": 6107.52,
      "start": 6106.52,
      "text": "然后作为这个,"
    },
    {
      "end": 6110.52,
      "start": 6107.52,
      "text": "吃鱼的大货,"
    },
    {
      "end": 6113.52,
      "start": 6110.52,
      "text": "我们的草哥小哥肯定特别有心得,"
    },
    {
      "end": 6115.52,
      "start": 6113.52,
      "text": "又能给大家分享一下,"
    },
    {
      "end": 6117.52,
      "start": 6115.52,
      "text": "来自日本,"
    },
    {
      "end": 6118.52,
      "start": 6117.52,
      "text": "没有,"
    },
    {
      "end": 6120.52,
      "start": 6118.52,
      "text": "我真不是吃鱼大货,"
    },
    {
      "end": 6121.52,
      "start": 6120.52,
      "text": "人家都说我是农民,"
    },
    {
      "end": 6123.52,
      "start": 6121.52,
      "text": "我说他们是渔民,"
    },
    {
      "end": 6125.52,
      "start": 6123.52,
      "text": "我是吃粮食的,"
    },
    {
      "end": 6126.52,
      "start": 6125.52,
      "text": "不是吃鱼的,"
    },
    {
      "end": 6129.52,
      "start": 6126.52,
      "text": "日本人吃鱼吃得多,"
    },
    {
      "end": 6131.52,
      "start": 6129.52,
      "text": "对,"
    },
    {
      "end": 6132.52,
      "start": 6131.52,
      "text": "在这个,"
    },
    {
      "end": 6134.52,
      "start": 6132.52,
      "text": "这个十一分这个时刻,"
    },
    {
      "end": 6136.52,
      "start": 6134.52,
      "text": "把上这个金架鱼,"
    },
    {
      "end": 6137.52,
      "start": 6136.52,
      "text": "这个前天嘛,"
    },
    {
      "end": 6139.52,
      "start": 6137.52,
      "text": "跟七哥一起,"
    },
    {
      "end": 6140.52,
      "start": 6139.52,
      "text": "他在安排这个,"
    },
    {
      "end": 6141.52,
      "start": 6140.52,
      "text": "我也不知道,"
    },
    {
      "end": 6143.52,
      "start": 6141.52,
      "text": "这很惊喜,"
    },
    {
      "end": 6144.52,
      "start": 6143.52,
      "text": "那当然我想呢,"
    },
    {
      "end": 6146.52,
      "start": 6144.52,
      "text": "首先是咱们这个时候,"
    },
    {
      "end": 6147.52,
      "start": 6146.52,
      "text": "把这个,"
    },
    {
      "end": 6148.52,
      "start": 6147.52,
      "text": "上这个金架鱼,"
    },
    {
