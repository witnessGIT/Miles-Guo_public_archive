    {
      "end": 640.28,
      "start": 638.84,
      "text": "这个选举"
    },
    {
      "end": 642.44,
      "start": 640.28,
      "text": "几乎可以说是改变美国的命运"
    },
    {
      "end": 643.44,
      "start": 642.44,
      "text": "改变美国命运"
    },
    {
      "end": 645.38,
      "start": 643.44,
      "text": "就改变了世界的命运"
