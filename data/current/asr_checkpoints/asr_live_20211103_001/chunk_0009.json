    {
      "end": 8675.4,
      "start": 8673.5,
      "text": "为什么说挣房地产税"
    },
    {
      "end": 8676.88,
      "start": 8675.4,
      "text": "亡党亡国"
    },
    {
      "end": 8677.98,
      "start": 8676.88,
      "text": "你为什么就说的"
    },
    {
      "end": 8679.32,
      "start": 8677.98,
      "text": "确实当时啊"
    },
    {
      "end": 8682.68,
      "start": 8679.32,
      "text": "当时王沪宁还那时候见我很谦虚的"
    },
    {
      "end": 8684.22,
