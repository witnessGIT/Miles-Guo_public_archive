      "text": "听说你的高见"
    },
    {
      "end": 8684.92,
      "start": 8684.22,
      "text": "听听"
    },
    {
      "end": 8687.32,
      "start": 8684.92,
      "text": "我说你记住"
    },
    {
      "end": 8691.2,
      "start": 8687.32,
      "text": "你有没有给老百姓的土地永久权"
    },
    {
      "end": 8692.56,
      "start": 8691.2,
      "text": "没有个永久权"
    },
    {
      "end": 8698.56,
