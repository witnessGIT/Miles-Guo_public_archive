{
  "chunk_audio_sha256": "3a5e599309c04cfdddb1a312e1dde4fd833f477752e6fdaf4452544167080e22",
  "chunk_index": 8,
  "completed_at": "2026-10-21T08:00:57Z",
  "language": "zh",
  "live_id": "LIVE_20211103_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 7200,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 7202.88,
      "start": 7200.0,
      "text": "當年最好的一個就是姐妹"
    },
    {
      "end": 7206.7,
      "start": 7203.88,
      "text": "就是共產黨的意義是廣東當年的省委副書記"
    },
    {
      "end": 7208.9,
      "start": 7206.7,
      "text": "那個女的我忘了叫啥姓葉好像是什麼"
    },
    {
      "end": 7211.62,
      "start": 7208.9,
      "text": "一個女的省委副書記"
    },
    {
      "end": 7215.62,
      "start": 7212.78,
      "text": "曾慶紅那是把她當親媽一樣對待的"
    },
    {
      "end": 7218.02,
      "start": 7215.88,
      "text": "廣東就是曾下的天下"
    },
    {
      "end": 7221.78,
      "start": 7218.68,
      "text": "那多少年前曾慶紅穿的那很時髦"
    },
    {
      "end": 7223.12,
      "start": 7221.78,
      "text": "八十幾年的時候"
    },
    {
      "end": 7226.76,
      "start": 7223.12,
      "text": "那個半截咖啡車T恤穿戴著眼鏡"
    },
    {
      "end": 7229.9,
      "start": 7226.76,
      "text": "是不是到廣東去那已經到中石化了"
    },
    {
      "end": 7232.7,
      "start": 7230.0,
      "text": "到那以後省委書記省長全程陪著"
    },
    {
      "end": 7236.0,
      "start": 7233.7,
      "text": "那你現在開啥玩笑呢那是"
    },
    {
      "end": 7238.0,
      "start": 7236.0,
      "text": "是曾家是老大"
    },
    {
      "end": 7241.02,
      "start": 7238.0,
      "text": "所以曾寶寶在那塊發展哪兒也不去就在深圳"
    },
    {
      "end": 7242.28,
      "start": 7241.02,
      "text": "是不是江天華"
    },
    {
      "end": 7245.82,
      "start": 7242.28,
      "text": "張高麗成天生氣"
    },
    {
      "end": 7248.22,
      "start": 7245.82,
      "text": "曾寶寶要哪塊地你就必須給"
    },
    {
      "end": 7250.42,
      "start": 7248.22,
      "text": "甚至明天準備掛牌機段來了"
    },
    {
      "end": 7252.36,
      "start": 7250.42,
      "text": "你別掛了給我吧就拿走"
    },
    {
      "end": 7253.92,
      "start": 7252.36,
      "text": "就這麼牛"
    },
    {
      "end": 7256.46,
      "start": 7253.92,
      "text": "曾寶寶最崇拜的是誰呀"
    },
    {
      "end": 7258.22,
      "start": 7256.46,
      "text": "就這個誇張龍"
    },
    {
      "end": 7260.92,
      "start": 7258.22,
      "text": "我記得告訴你寶寶最崇拜叫好海東"
    },
    {
      "end": 7262.42,
      "start": 7260.92,
      "text": "他是其中之一"
    },
    {
      "end": 7264.82,
      "start": 7262.42,
      "text": "喜歡男足球明星"
    },
    {
      "end": 7269.24,
      "start": 7266.82,
      "text": "家裏邊你看他點頭了吧"
    },
    {
      "end": 7270.64,
      "start": 7269.24,
      "text": "你知道你秘密嗎兄弟"
    },
    {
      "end": 7272.2,
      "start": 7270.64,
      "text": "趙英在這兒我絕對知道你秘密"
    },
    {
      "end": 7273.1,
      "start": 7272.2,
      "text": "為什麼知道嗎"
    },
    {
      "end": 7275.64,
      "start": 7273.1,
      "text": "他爹他媽"
    },
    {
      "end": 7277.5,
      "start": 7275.64,
      "text": "讓他結婚他不急"
    },
    {
      "end": 7279.58,
      "start": 7277.5,
      "text": "他說他就像找明星找郝海東那樣"
    },
    {
      "end": 7281.94,
      "start": 7279.58,
      "text": "郝海東天天給你踢球那管啥用啊"
    },
    {
      "end": 7282.44,
      "start": 7281.94,
      "text": "是不是"
    },
    {
      "end": 7286.14,
      "start": 7282.44,
      "text": "我都知道這事因為他媽是外經貿委的"
    },
    {
      "end": 7288.44,
      "start": 7286.14,
      "text": "搞貿易的搞軍工貿易的"
    },
    {
      "end": 7290.14,
      "start": 7288.44,
      "text": "庆懷那時候"
    },
    {
      "end": 7291.62,
      "start": 7290.14,
      "text": "庆懷那時候還狗屁不是呢"
    },
    {
      "end": 7293.02,
      "start": 7291.62,
      "text": "在廣東"
    },
    {
      "end": 7295.46,
      "start": 7293.02,
      "text": "你知道當時曾寶寶啥權力呀"
    },
    {
      "end": 7297.02,
      "start": 7295.46,
      "text": "曾寶寶就代表曾家的"
    },
    {
      "end": 7299.72,
      "start": 7297.02,
      "text": "張高麗都是要見他要讓三分的"
    },
    {
      "end": 7303.12,
      "start": 7299.72,
      "text": "那你想想曾寶寶今天房地產都出事了"
    },
    {
      "end": 7304.92,
      "start": 7303.12,
      "text": "你說你張高麗算啥呀"
    },
    {
      "end": 7306.46,
      "start": 7304.92,
      "text": "算老幾呀"
    },
    {
      "end": 7307.96,
      "start": 7306.46,
      "text": "你去咋去算老毛啊"
    },
    {
      "end": 7311.36,
      "start": 7307.96,
      "text": "你永遠要記住那寶寶不是代表曾家的"
    },
    {
      "end": 7312.94,
      "start": 7311.36,
      "text": "他不是曾寶寶"
    },
    {
      "end": 7313.76,
      "start": 7312.94,
      "text": "他都完大了"
    },
    {
      "end": 7314.66,
      "start": 7313.76,
      "text": "你還想啥"
    },
    {
      "end": 7316.76,
      "start": 7314.66,
      "text": "是共產黨的房地產領域"
    },
    {
      "end": 7318.08,
      "start": 7316.76,
      "text": "整個都完"
    },
    {
      "end": 7322.5,
      "start": 7319.28,
      "text": "沒有一個共產黨願意讓房地產完的"
    },
    {
      "end": 7323.88,
      "start": 7322.5,
      "text": "因為共產黨房地產完"
    },
    {
      "end": 7325.82,
      "start": 7323.88,
      "text": "就你所有人在一個車上"
    },
    {
      "end": 7327.78,
      "start": 7325.82,
      "text": "這個車就沒氣了"
    },
    {
      "end": 7329.68,
      "start": 7327.78,
      "text": "沒油了"
    },
    {
      "end": 7330.62,
      "start": 7329.68,
      "text": "誰也不讓他玩"
    },
    {
      "end": 7332.18,
      "start": 7330.62,
      "text": "這跟誰都沒關係"
    },
    {
      "end": 7335.16,
      "start": 7333.08,
      "text": "但是房地產"
    },
    {
      "end": 7336.36,
      "start": 7335.16,
      "text": "崩塌之日"
    },
    {
      "end": 7337.42,
      "start": 7336.36,
      "text": "就是滅共之時"
    },
    {
      "end": 7338.78,
      "start": 7337.42,
      "text": "就是現在國內為啥"
    },
    {
      "end": 7340.26,
      "start": 7338.78,
      "text": "我說這話都有很有感覺的"
    },
    {
      "end": 7341.7,
      "start": 7340.26,
      "text": "就是這個曾寶寶"
    },
    {
      "end": 7343.16,
      "start": 7341.7,
      "text": "這個他身邊的人"
    },
    {
      "end": 7344.86,
      "start": 7343.16,
      "text": "就是這個說"
    },
    {
      "end": 7346.1,
      "start": 7344.86,
      "text": "寶寶最喜歡你"
    },
    {
      "end": 7349.0,
      "start": 7346.1,
      "text": "現在跟你一起看革命的郝海東"
    },
    {
      "end": 7350.56,
      "start": 7349.0,
      "text": "現在寶寶徹底完了"
    },
    {
      "end": 7351.44,
      "start": 7350.56,
      "text": "都說完了"
    },
    {
      "end": 7353.7,
      "start": 7351.44,
      "text": "現在我們都看你們的直播"
    },
    {
      "end": 7355.98,
      "start": 7353.7,
      "text": "他說我們唯一的看的就是你們的直播"
    },
    {
      "end": 7358.34,
      "start": 7355.98,
      "text": "啥也不看"
    },
    {
      "end": 7360.52,
      "start": 7358.34,
      "text": "這是他最親信的一位男士"
    },
    {
      "end": 7362.18,
      "start": 7360.52,
      "text": "搞就在我的樓下"
    },
    {
      "end": 7364.84,
      "start": 7362.18,
      "text": "這個華平基金的"
    },
    {
      "end": 7368.72,
      "start": 7364.84,
      "text": "所以說今天你知道他都救不了的時候"
    },
    {
      "end": 7370.18,
      "start": 7368.72,
      "text": "他昨天說給我發信息"
    },
    {
      "end": 7371.22,
      "start": 7370.18,
      "text": "七哥"
    },
    {
      "end": 7373.52,
      "start": 7371.22,
      "text": "我們就等著弄點洗屁了"
    },
    {
      "end": 7376.02,
      "start": 7373.52,
      "text": "他說共產黨是完了"
    },
    {
      "end": 7377.98,
      "start": 7376.02,
      "text": "他說房地產完了"
    },
    {
      "end": 7379.52,
      "start": 7377.98,
      "text": "銀行完了"
    },
    {
      "end": 7381.26,
      "start": 7379.52,
      "text": "民心也完了"
    },
    {
      "end": 7382.82,
      "start": 7381.26,
      "text": "所有人都等著一件事"
    },
    {
      "end": 7385.66,
      "start": 7382.82,
      "text": "習啥時候突然間隔屁了"
    },
    {
      "end": 7388.22,
      "start": 7385.66,
      "text": "整個江家曾家整個廣"
    },
    {
      "end": 7389.26,
      "start": 7388.22,
      "text": "就等著那一刻"
    },
    {
      "end": 7391.3,
      "start": 7389.26,
      "text": "崩一秒鐘"
    },
    {
      "end": 7392.34,
      "start": 7391.3,
      "text": "習沒了"
    },
    {
      "end": 7393.74,
      "start": 7392.34,
      "text": "所有人都叛了習"
    },
    {
      "end": 7395.8,
      "start": 7393.74,
      "text": "嘎們兒就沒了"
    },
    {
      "end": 7396.84,
      "start": 7395.8,
      "text": "就這件事"
    },
    {
      "end": 7401.38,
      "start": 7399.54,
      "text": "有意思啊"
    },
    {
      "end": 7404.28,
      "start": 7401.38,
      "text": "那現在這個房地產"
    },
    {
      "end": 7405.54,
      "start": 7404.28,
      "text": "最近又是"
    },
    {
      "end": 7408.42,
      "start": 7405.54,
      "text": "就是馬上要徵這個房地產稅"
    },
    {
      "end": 7411.22,
      "start": 7408.42,
      "text": "那他們既然不想讓這個房地產倒"
    },
    {
      "end": 7413.38,
      "start": 7411.22,
      "text": "這個增房地產稅是"
    },
    {
      "end": 7415.52,
      "start": 7413.38,
      "text": "其實是推動他們這個房地產"
    },
    {
      "end": 7417.1,
      "start": 7415.52,
      "text": "更快速的這個倒下"
    },
    {
      "end": 7419.6,
      "start": 7417.1,
      "text": "房地產稅跟啥都沒關係"
    },
    {
      "end": 7420.4,
      "start": 7419.6,
      "text": "很多人不懂"
    },
    {
      "end": 7421.54,
      "start": 7420.4,
      "text": "七哥是最牛的"
    },
    {
      "end": 7423.1,
      "start": 7421.54,
      "text": "可以說房地產的吧"
    },
    {
      "end": 7424.9,
      "start": 7423.86,
      "text": "我要說房地產"
    },
    {
      "end": 7425.9,
      "start": 7424.9,
      "text": "中國誰敢給我"
    },
    {
      "end": 7427.64,
      "start": 7425.9,
      "text": "我做房地產的有潘石屹嗎"
    },
    {
      "end": 7429.1,
      "start": 7427.64,
      "text": "那個傻傻在這塊兒"
    },
    {
      "end": 7430.28,
      "start": 7429.1,
      "text": "變統計令了"
    },
    {
      "end": 7431.4,
      "start": 7430.28,
      "text": "有馬雲嗎"
    },
    {
      "end": 7432.3,
      "start": 7431.4,
      "text": "有許家印嗎"
    },
    {
      "end": 7433.78,
      "start": 7432.3,
      "text": "他要宣少自主呢"
    },
    {
      "end": 7434.88,
      "start": 7434.48,
      "text": "是不是啊"
    },
    {
      "end": 7436.58,
      "start": 7434.88,
      "text": "我91年建立的玉達"
    },
    {
      "end": 7437.64,
      "start": 7436.58,
      "text": "建立的玉達花園"
    },
    {
      "end": 7440.78,
      "start": 7437.64,
      "text": "我開展的整個的帶天然氣"
    },
    {
      "end": 7441.92,
      "start": 7440.78,
      "text": "帶配套設施"
    },
    {
      "end": 7442.98,
      "start": 7441.92,
      "text": "鄭州的副市長"
    },
    {
      "end": 7444.74,
      "start": 7442.98,
      "text": "不知道啥叫配套設施"
    },
    {
      "end": 7445.94,
      "start": 7444.74,
      "text": "搞實際上我啥叫配套設施"
    },
    {
      "end": 7447.08,
      "start": 7445.94,
      "text": "我跟他預料了一遍"
    },
    {
      "end": 7448.12,
      "start": 7447.08,
      "text": "哎你回去"
    },
    {
      "end": 7448.92,
      "start": 7448.12,
      "text": "文貴你回去"
    },
    {
      "end": 7450.16,
      "start": 7448.92,
      "text": "阿姨給我謝謝"
    },
    {
      "end": 7451.56,
      "start": 7450.16,
      "text": "他倆老師就上我的來"
    },
    {
      "end": 7453.22,
      "start": 7451.56,
      "text": "哎文貴你給我弄弄"
    },
    {
      "end": 7455.3,
      "start": 7453.22,
      "text": "玉達整個市政府大門"
    },
    {
      "end": 7456.06,
      "start": 7455.3,
      "text": "是我給他建的"
    },
    {
      "end": 7457.72,
      "start": 7456.06,
      "text": "他竟然整個鄭州設計院"
    },
    {
      "end": 7458.42,
      "start": 7457.72,
      "text": "設計的門"
    },
    {
      "end": 7459.66,
      "start": 7458.42,
      "text": "都像骨灰盒一樣"
    },
    {
      "end": 7461.26,
      "start": 7459.66,
      "text": "我給他誇誇當場話頭"
    },
    {
      "end": 7462.66,
      "start": 7461.26,
      "text": "馬上建起來"
    },
    {
      "end": 7463.8,
      "start": 7462.66,
      "text": "我要說房地產"
    },
    {
      "end": 7464.84,
      "start": 7463.8,
      "text": "中國誰敢說房地產"
    },
    {
      "end": 7466.4,
      "start": 7464.84,
      "text": "我要耳子拔本堵路"
    },
    {
      "end": 7468.8,
      "start": 7466.4,
      "text": "我搞房地產你們都穿活當褲呢"
    },
    {
      "end": 7470.5,
      "start": 7468.8,
      "text": "房地產稅什麼時候開始的"
    },
    {
      "end": 7473.84,
      "start": 7472.2,
      "text": "房地產稅是真正的"
    },
    {
      "end": 7477.08,
      "start": 7473.84,
      "text": "是從93年到95年就開始討論"
    },
    {
      "end": 7478.62,
      "start": 7477.08,
      "text": "當時叫中房"
    },
    {
      "end": 7481.44,
      "start": 7478.62,
      "text": "當時中房是代表中國房地產的政策的"
    },
    {
      "end": 7483.16,
      "start": 7481.44,
      "text": "然後南部叫深房"
    },
    {
      "end": 7485.42,
      "start": 7483.16,
      "text": "叫北有中房南有深房"
    },
    {
      "end": 7488.42,
      "start": 7485.42,
      "text": "搞房地產看中房和深房"
    },
    {
      "end": 7489.62,
      "start": 7488.42,
      "text": "朱鎔基這個家伙"
    },
    {
      "end": 7491.5,
      "start": 7489.62,
      "text": "是個中國邪惡的趙高啊"
    },
    {
      "end": 7492.6,
      "start": 7491.5,
      "text": "李斯的中和帖"
    },
    {
      "end": 7493.96,
      "start": 7492.6,
      "text": "太王八蛋了"
    },
    {
      "end": 7495.76,
      "start": 7493.96,
      "text": "就他覺得中國老百姓"
    },
    {
      "end": 7497.52,
      "start": 7495.76,
      "text": "當年上下崗的時候"
    },
    {
      "end": 7498.96,
      "start": 7497.52,
      "text": "就是帶著老婆賣銀啊"
    },
    {
      "end": 7500.36,
      "start": 7498.96,
      "text": "帶著閨妮賣銀的事兒"
    },
    {
      "end": 7501.66,
      "start": 7500.36,
      "text": "他報告以後"
    },
    {
      "end": 7503.2,
      "start": 7501.66,
      "text": "朱鎔基是哈哈大笑的"
    },
    {
      "end": 7505.7,
      "start": 7504.74,
      "text": "朱鎔基說明什麼"
    },
    {
      "end": 7508.2,
      "start": 7505.7,
      "text": "他說我們還能穩定個十年二十年"
    },
    {
      "end": 7509.38,
      "start": 7508.2,
      "text": "就這個促生"
    },
    {
      "end": 7510.58,
      "start": 7509.38,
      "text": "他當時就說了"
    },
    {
      "end": 7512.1,
      "start": 7510.58,
      "text": "房地產稅"
    },
    {
      "end": 7515.22,
      "start": 7512.84,
      "text": "是解決所有中國歷史上"
    },
    {
      "end": 7517.16,
      "start": 7515.22,
      "text": "經濟問題的最重要的標誌"
    },
    {
      "end": 7519.02,
      "start": 7517.16,
      "text": "這是我朱鎔基"
    },
    {
      "end": 7521.56,
      "start": 7520.02,
      "text": "1987年"
    },
    {
      "end": 7524.0,
      "start": 7521.56,
      "text": "我記得非常87年11月份"
    },
    {
      "end": 7525.86,
      "start": 7524.66,
      "text": "他講的 你們去查下去"
    },
    {
      "end": 7530.56,
      "start": 7528.5,
      "text": "說徵房地產稅之日"
    },
    {
      "end": 7532.94,
      "start": 7530.56,
      "text": "就是中國經濟所有歷史問題都解決了"
    },
    {
      "end": 7534.94,
      "start": 7533.8,
      "text": "在這之前就賣地"
    },
    {
      "end": 7536.6,
      "start": 7534.94,
      "text": "叫地方債務"
    },
    {
      "end": 7538.8,
      "start": 7536.6,
      "text": "把你炒高"
    },
    {
      "end": 7540.14,
      "start": 7538.8,
      "text": "洗錢再洗錢"
    },
    {
      "end": 7541.94,
      "start": 7540.14,
      "text": "然後拿著這些熱錢"
    },
    {
      "end": 7543.1,
      "start": 7541.94,
      "text": "到外國去併購"
    },
    {
      "end": 7545.5,
      "start": 7543.1,
      "text": "然後說只要加入WTO"
    },
    {
      "end": 7547.04,
      "start": 7545.5,
      "text": "中國就會走上"
    },
    {
      "end": 7548.14,
      "start": 7547.04,
      "text": "世界的"
    },
    {
      "end": 7550.92,
      "start": 7548.14,
      "text": "就是主要大國的這個平等對話中"
    },
    {
      "end": 7552.44,
      "start": 7550.92,
      "text": "所以無疑當時"
    },
    {
      "end": 7553.36,
      "start": 7552.44,
      "text": "跟我很熟"
    },
    {
      "end": 7555.08,
      "start": 7553.36,
      "text": "你們這七個有資格說話吧"
    },
    {
      "end": 7556.36,
      "start": 7555.08,
      "text": "WTO之前"
    },
    {
      "end": 7560.14,
      "start": 7556.36,
      "text": "無疑跟我倆聊"
    },
    {
      "end": 7561.76,
      "start": 7560.14,
      "text": "一聊六七個小時啊"
    },
    {
      "end": 7564.14,
      "start": 7563.4,
      "text": "無疑說"
    },
    {
      "end": 7565.7,
      "start": 7564.14,
      "text": "這個中國加不了WTO"
    },
    {
      "end": 7566.84,
      "start": 7565.7,
      "text": "共產黨就沒了"
    },
    {
      "end": 7570.44,
      "start": 7568.98,
      "text": "我跟無疑倆倆坐在那兒"
    },
    {
      "end": 7571.54,
      "start": 7570.44,
      "text": "喝著小酒聊著"
    },
    {
      "end": 7572.84,
      "start": 7571.54,
      "text": "我無疑是袁哈克手"
    },
    {
      "end": 7574.08,
      "start": 7572.84,
      "text": "他說我跟任何一個男人"
    },
    {
      "end": 7575.14,
      "start": 7574.08,
      "text": "沒有超過三小時"
    },
    {
      "end": 7577.14,
      "start": 7575.14,
      "text": "包括我曾經愛的老師"
    },
    {
      "end": 7579.28,
      "start": 7578.28,
      "text": "在波斯頓的老師"
    },
    {
      "end": 7581.62,
      "start": 7579.92,
      "text": "我跟人沒有耐心聊過三小時"
    },
    {
      "end": 7583.46,
      "start": 7582.48,
      "text": "他說你能跟我聊"
    },
    {
      "end": 7584.96,
      "start": 7583.46,
      "text": "聊七個小時還真行"
    },
    {
      "end": 7586.12,
      "start": 7585.28,
      "text": "當時他說"
    },
    {
      "end": 7587.36,
      "start": 7586.12,
      "text": "怕我耳朵問我"
    },
    {
      "end": 7589.02,
      "start": 7588.02,
      "text": "溫貴你給我說實話"
    },
    {
      "end": 7590.02,
      "start": 7589.02,
      "text": "有多少女朋友"
    },
    {
      "end": 7591.1,
      "start": 7590.36,
      "text": "還有我大姐"
    },
    {
      "end": 7592.46,
      "start": 7591.1,
      "text": "我說這多了去了"
    },
    {
      "end": 7593.62,
      "start": 7592.72,
      "text": "這個你就不用問了"
    },
    {
      "end": 7594.7,
      "start": 7593.62,
      "text": "你可以掰在手竹子鼠"
    },
    {
      "end": 7595.56,
      "start": 7594.7,
      "text": "我一個掰在腳丫子鼠"
    },
    {
      "end": 7596.56,
      "start": 7595.56,
      "text": "笑了就不行了"
    },
    {
      "end": 7598.14,
      "start": 7596.56,
      "text": "說夠實在可以"
    },
    {
      "end": 7599.14,
      "start": 7598.14,
      "text": "那我問問你吧"
    },
    {
      "end": 7600.14,
      "start": 7599.14,
      "text": "你有幾個女朋友"
    },
    {
      "end": 7601.6,
      "start": 7600.54,
      "text": "他你咋問這問題"
    },
    {
      "end": 7602.2,
      "start": 7601.6,
      "text": "我問那你問我"
    },
    {
      "end": 7603.1,
      "start": 7602.2,
      "text": "我不能問你嗎"
    },
    {
      "end": 7605.5,
      "start": 7604.38,
      "text": "他說我有女朋友"
    },
    {
      "end": 7607.44,
      "start": 7606.1,
      "text": "第一次正式告誠"
    },
    {
      "end": 7608.84,
      "start": 7607.44,
      "text": "承認他是同性戀"
    },
    {
      "end": 7611.14,
      "start": 7609.74,
      "text": "他說但是我有過男朋友"
    },
    {
      "end": 7613.98,
      "start": 7612.14,
      "text": "我愛過人"
    },
    {
      "end": 7614.54,
      "start": 7613.98,
      "text": "我也有過男朋友"
    },
    {
      "end": 7615.04,
      "start": 7614.54,
      "text": "我有女朋友"
    },
    {
      "end": 7615.74,
      "start": 7615.04,
      "text": "我有女朋友"
    },
    {
      "end": 7616.28,
      "start": 7615.74,
      "text": "哇"
    },
    {
      "end": 7617.44,
      "start": 7616.28,
      "text": "我夠意思啊"
    },
    {
      "end": 7618.24,
      "start": 7617.44,
      "text": "咱們好好聊"
    },
    {
      "end": 7620.02,
      "start": 7618.24,
      "text": "這就有平等話語權了"
    },
    {
      "end": 7620.94,
      "start": 7620.02,
      "text": "真誠相耐"
    },
    {
      "end": 7622.58,
      "start": 7621.32,
      "text": "他說到朱鎔基的時候"
    },
    {
      "end": 7624.12,
      "start": 7622.58,
      "text": "他說朱鎔基這個傢伙"
    },
    {
      "end": 7626.02,
      "start": 7624.62,
      "text": "心裏有個魔"
    },
    {
      "end": 7628.98,
      "start": 7627.28,
      "text": "他說我就越看得越像當年的"
    },
    {
      "end": 7629.98,
      "start": 7628.98,
      "text": "毛澤東附身"
    },
    {
      "end": 7632.12,
      "start": 7630.62,
      "text": "他說他誓老百姓死亡"
    },
    {
      "end": 7633.18,
      "start": 7632.12,
      "text": "他當成興奮劑"
    },
    {
      "end": 7636.76,
      "start": 7635.08,
      "text": "他說提房地產稅"
    },
    {
      "end": 7637.96,
      "start": 7636.76,
      "text": "這個傢伙他想幹啥"
    },
    {
      "end": 7639.66,
      "start": 7638.82,
      "text": "後來我搞不懂"
    },
    {
      "end": 7640.56,
      "start": 7639.66,
      "text": "他說無疑"
    },
    {
      "end": 7642.6,
      "start": 7640.56,
      "text": "只要你能把這個WTO搞進去"
    },
    {
      "end": 7644.4,
      "start": 7643.66,
      "text": "咱們中國"
    },
    {
      "end": 7646.16,
      "start": 7644.6,
      "text": "咱共產黨再多活個一二十年"
    },
    {
      "end": 7647.8,
      "start": 7646.7,
      "text": "如果一徵房地產稅"
    },
    {
      "end": 7649.2,
      "start": 7647.8,
      "text": "歷史經濟問題全解決"
    },
    {
      "end": 7652.14,
      "start": 7649.2,
      "text": "這是當年無疑和朱鎔基都有的事"
    },
    {
      "end": 7654.34,
      "start": 7652.14,
      "text": "這個真跟誰都沒關係"
    },
    {
      "end": 7657.32,
      "start": 7655.44,
      "text": "江當時不敢"
    },
    {
      "end": 7658.92,
      "start": 7658.22,
      "text": "你知道嗎"
    },
    {
      "end": 7660.48,
      "start": 7659.14,
      "text": "他就蹦誇了嘛"
    },
    {
      "end": 7663.92,
      "start": 7660.48,
      "text": "所以說從2001年加入世貿的"
    },
    {
      "end": 7667.06,
      "start": 7664.16,
      "text": "中共國1.33萬億的GDP"
    },
    {
      "end": 7668.92,
      "start": 7667.36,
      "text": "到現在的15萬億"
    },
    {
      "end": 7671.72,
      "start": 7668.92,
      "text": "是美帝國主義讓中國共產黨強大的"
    },
    {
      "end": 7673.7,
      "start": 7672.56,
      "text": "賣了中國的肝"
    },
    {
      "end": 7674.66,
      "start": 7673.7,
      "text": "賣了中國的子宮"
    },
    {
      "end": 7675.26,
      "start": 7674.66,
      "text": "賣了地"
    },
    {
      "end": 7676.54,
      "start": 7675.26,
      "text": "賣所有的污染"
    },
    {
      "end": 7677.54,
      "start": 7676.76,
      "text": "廉價勞動力"
    },
    {
      "end": 7678.46,
      "start": 7677.54,
      "text": "剝削中國人民"
    },
    {
      "end": 7680.56,
      "start": 7679.7,
      "text": "然後"
    },
    {
      "end": 7682.86,
      "start": 7680.56,
      "text": "到了江湾州去胡錦濤"
    },
    {
      "end": 7685.46,
      "start": 7683.7,
      "text": "誰給胡錦濤提的知道嗎"
    },
    {
      "end": 7686.34,
      "start": 7685.46,
      "text": "滕文生"
    },
    {
      "end": 7688.1,
      "start": 7687.44,
      "text": "滕文生"
    },
    {
      "end": 7689.0,
      "start": 7688.1,
      "text": "在旁邊"
    },
    {
      "end": 7689.8,
      "start": 7689.3,
      "text": "在旁邊"
    },
    {
      "end": 7690.6,
      "start": 7689.8,
      "text": "他的女朋友"
    },
    {
      "end": 7692.34,
      "start": 7690.6,
      "text": "我今天可以告訴你們"
    },
    {
      "end": 7693.24,
      "start": 7692.34,
      "text": "就是吳宇娟"
    },
    {
      "end": 7694.54,
      "start": 7693.24,
      "text": "吳宇娟"
    },
    {
      "end": 7696.48,
      "start": 7695.14,
      "text": "吳宇娟老跟我說"
    },
    {
      "end": 7698.44,
      "start": 7697.38,
      "text": "文貴你把我包了吧"
    },
    {
      "end": 7699.64,
      "start": 7698.44,
      "text": "我說你可以當我阿姨了"
    },
    {
      "end": 7700.28,
      "start": 7699.64,
      "text": "我包你"
    },
    {
      "end": 7701.78,
      "start": 7700.28,
      "text": "你給我錢差不多"
    },
    {
      "end": 7703.42,
      "start": 7702.24,
      "text": "我說哪天喝醉酒了"
    },
    {
      "end": 7705.06,
      "start": 7703.42,
      "text": "咱倆來一次就算了"
    },
    {
      "end": 7706.16,
      "start": 7705.06,
      "text": "咱別留點遺憾"
    },
    {
      "end": 7707.18,
      "start": 7706.16,
      "text": "不喝酒也不行"
    },
    {
      "end": 7709.56,
      "start": 7708.78,
      "text": "吳宇娟在旁邊"
    },
    {
      "end": 7710.22,
      "start": 7709.56,
      "text": "給滕文生"
    },
    {
      "end": 7712.76,
      "start": 7710.22,
      "text": "我給緊張說了"
    },
    {
      "end": 7713.36,
      "start": 7712.76,
      "text": "啊"
    },
    {
      "end": 7714.52,
      "start": 7713.36,
      "text": "征房地產稅"
    },
    {
      "end": 7715.9,
      "start": 7714.52,
      "text": "我從來不說話"
    },
    {
      "end": 7717.8,
      "start": 7715.9,
      "text": "我跟這把人說話我都保留著"
    },
    {
      "end": 7719.06,
      "start": 7717.8,
      "text": "要不然我活不到今天"
    },
    {
      "end": 7720.66,
      "start": 7719.06,
      "text": "我都是裝傻充樂"
    },
    {
      "end": 7722.26,
      "start": 7720.66,
      "text": "一說激動咱也掉淚"
    },
    {
      "end": 7722.76,
      "start": 7722.26,
      "text": "是吧"
    },
    {
      "end": 7723.84,
      "start": 7722.76,
      "text": "中議黨啊"
    },
    {
      "end": 7724.6,
      "start": 7723.84,
      "text": "黨太偉大了"
    },
    {
      "end": 7725.84,
      "start": 7724.6,
      "text": "沒有黨哪我們的"
    },
    {
      "end": 7726.84,
      "start": 7725.84,
      "text": "快喝酒啊"
    },
    {
      "end": 7727.34,
      "start": 7726.84,
      "text": "是吧"
    },
    {
      "end": 7728.74,
      "start": 7727.34,
      "text": "絕對這樣啊"
    },
    {
      "end": 7729.74,
      "start": 7728.74,
      "text": "給領導來了"
    },
    {
      "end": 7730.8,
      "start": 7729.74,
      "text": "也給領導寄鞋帶"
    },
    {
      "end": 7731.5,
      "start": 7730.8,
      "text": "你知道嗎"
    },
    {
      "end": 7732.44,
      "start": 7731.5,
      "text": "這是絕對的啊"
    },
    {
      "end": 7734.28,
      "start": 7732.44,
      "text": "咱都能裝的可像了"
    },
    {
      "end": 7735.88,
      "start": 7734.28,
      "text": "房地產稅得家"
    },
    {
      "end": 7738.24,
      "start": 7735.88,
      "text": "然後說房地產稅得完完家"
    },
    {
      "end": 7739.54,
      "start": 7738.24,
      "text": "咱就得完完家"
    },
    {
      "end": 7741.38,
      "start": 7739.54,
      "text": "咱七哥可會了"
    },
    {
      "end": 7743.04,
      "start": 7741.38,
      "text": "你看我跟劉彥平的對話"
    },
    {
      "end": 7743.92,
      "start": 7743.04,
      "text": "和孫仁軍對話"
    },
    {
      "end": 7747.82,
      "start": 7743.92,
      "text": "你就知道我已經跟共產黨的交流之中"
    },
    {
      "end": 7749.5,
      "start": 7747.82,
      "text": "已經到了爐火純青了"
    },
    {
      "end": 7750.8,
      "start": 7749.5,
      "text": "爐火純青了"
    },
    {
      "end": 7754.2,
      "start": 7750.8,
      "text": "所以說當時滕文生把我視為知己"
    },
    {
      "end": 7756.46,
      "start": 7754.2,
      "text": "啥都問我"
    },
    {
      "end": 7758.14,
      "start": 7756.46,
      "text": "絕密文件都讓我看"
    },
    {
      "end": 7759.2,
      "start": 7758.14,
      "text": "但是從來不留給我"
    },
    {
      "end": 7760.3,
      "start": 7759.2,
      "text": "哥們兒很小心啊"
    },
    {
      "end": 7761.64,
      "start": 7760.3,
      "text": "就是每次都是"
    },
    {
      "end": 7762.78,
      "start": 7761.64,
      "text": "你看這個"
    },
    {
      "end": 7764.3,
      "start": 7762.78,
      "text": "看我又放在兜裏邊"
    },
    {
      "end": 7764.88,
      "start": 7764.3,
      "text": "啊"
    },
    {
      "end": 7766.14,
      "start": 7764.88,
      "text": "警察領著吳宇娟"
    },
    {
      "end": 7767.24,
      "start": 7766.14,
      "text": "還有另外一個小明星啊"
    },
    {
      "end": 7768.34,
      "start": 7767.24,
      "text": "你們都知道的啊"
    },
    {
      "end": 7770.28,
      "start": 7768.34,
      "text": "很知道的一個小明星啊"
    },
    {
      "end": 7771.58,
      "start": 7770.28,
      "text": "現在還挺火的"
    },
    {
      "end": 7772.92,
      "start": 7771.58,
      "text": "有時候帶著他來"
    },
    {
      "end": 7774.52,
      "start": 7772.92,
      "text": "然後就順便吃完飯"
    },
    {
      "end": 7776.32,
      "start": 7774.52,
      "text": "中午睡個午覺雙休一下"
    },
    {
      "end": 7778.62,
      "start": 7776.32,
      "text": "房地產稅是騰文生推的"
    },
    {
      "end": 7779.62,
      "start": 7778.62,
      "text": "胡錦濤不敢"
    },
    {
      "end": 7781.9,
      "start": 7779.62,
      "text": "後來騰文生一開始"
    },
    {
      "end": 7784.0,
      "start": 7781.9,
      "text": "以為我跟劉永青認識"
    },
    {
      "end": 7785.2,
      "start": 7784.0,
      "text": "跟錦濤不認識"
    },
    {
      "end": 7786.44,
      "start": 7785.2,
      "text": "他老給我吹牛"
    },
    {
      "end": 7789.14,
      "start": 7786.44,
      "text": "他突然發現我在錦濤辦公室"
    },
    {
      "end": 7790.1,
      "start": 7789.14,
      "text": "他愣來那了"
    },
    {
      "end": 7791.58,
      "start": 7790.1,
      "text": "他進來傻了"
    },
    {
      "end": 7793.14,
      "start": 7791.58,
      "text": "就說錦濤辦公室特別小"
    },
    {
      "end": 7794.94,
      "start": 7793.14,
      "text": "錦濤辦公室就是我這個辦公室"
    },
    {
      "end": 7796.14,
      "start": 7794.94,
      "text": "三分之二這麼大"
    },
    {
      "end": 7798.08,
      "start": 7796.14,
      "text": "一進門就說"
    },
    {
      "end": 7799.92,
      "start": 7798.08,
      "text": "就人得繞著屁股進去"
    },
    {
      "end": 7803.32,
      "start": 7799.92,
      "text": "很小的旁邊是他的秘書"
    },
    {
      "end": 7805.32,
      "start": 7803.32,
      "text": "兩個秘書的"
    },
    {
      "end": 7806.82,
      "start": 7805.32,
      "text": "另計劃還在外邊呢"
    },
    {
      "end": 7809.02,
      "start": 7806.82,
      "text": "他在那個中辦的那個樓上那塊"
    },
    {
      "end": 7812.04,
      "start": 7809.02,
      "text": "我上那他就一看"
    },
    {
      "end": 7814.2,
      "start": 7812.04,
      "text": "郭文貴的這樣他傻的看著"
    },
    {
      "end": 7815.1,
      "start": 7814.2,
      "text": "然後錦濤說"
    },
    {
      "end": 7816.6,
      "start": 7815.1,
      "text": "我知道你倆認識啊"
    },
    {
      "end": 7819.2,
      "start": 7816.6,
      "text": "今天這個文貴過來整著本書啊"
    },
    {
      "end": 7820.3,
      "start": 7819.2,
      "text": "給我送來了"
    },
    {
      "end": 7822.0,
      "start": 7820.3,
      "text": "我頭上臉都變了"
    },
    {
      "end": 7823.44,
      "start": 7822.0,
      "text": "你想認識我錦濤"
    },
    {
      "end": 7825.5,
      "start": 7823.44,
      "text": "他不知道我跟錦濤那麼好"
    },
    {
      "end": 7827.72,
      "start": 7825.5,
      "text": "我們倆在家裡邊他不提錦濤"
    },
    {
      "end": 7829.52,
      "start": 7827.72,
      "text": "他也不問你倆什麼認識的"
    },
    {
      "end": 7830.32,
      "start": 7829.52,
      "text": "喝酒"
    },
    {
      "end": 7833.52,
      "start": 7830.32,
      "text": "有一天我在他家錦濤家出來"
    },
    {
      "end": 7835.22,
      "start": 7833.52,
      "text": "錦濤搬完家了是吧"
    },
    {
      "end": 7836.88,
      "start": 7835.22,
      "text": "被他老婆給虐半天出來"
    },
    {
      "end": 7838.06,
      "start": 7836.88,
      "text": "他看到我出入裡面"
    },
    {
      "end": 7839.52,
      "start": 7838.06,
      "text": "拎著兩大鑼子書"
    },
    {
      "end": 7841.36,
      "start": 7839.52,
      "text": "錦濤送給我兩鑼子書"
    },
    {
      "end": 7842.66,
      "start": 7841.36,
      "text": "我在共產黨的什麼修養"
    },
    {
      "end": 7843.5,
      "start": 7842.66,
      "text": "這破書"
    },
    {
      "end": 7845.5,
      "start": 7843.5,
      "text": "出上面我就扔垃圾堆去了是吧"
    },
    {
      "end": 7847.94,
      "start": 7845.5,
      "text": "扔了那個三串本垃圾堆"
    },
    {
      "end": 7849.1,
      "start": 7847.94,
      "text": "我全給他扔了"
    },
    {
      "end": 7851.38,
      "start": 7849.1,
      "text": "兩本就給我出場玩什麼什麼玩"
    },
    {
      "end": 7852.88,
      "start": 7851.38,
      "text": "共產黨的錯心的話"
    },
    {
      "end": 7854.28,
      "start": 7852.88,
      "text": "你真不知"
    },
    {
      "end": 7855.68,
      "start": 7854.28,
      "text": "出去邊停車"
    },
    {
      "end": 7858.18,
      "start": 7855.68,
      "text": "三串本就扔垃圾堆去了"
    },
    {
      "end": 7860.62,
      "start": 7858.18,
      "text": "你說是胡扯不胡扯"
    },
    {
      "end": 7862.68,
      "start": 7860.62,
      "text": "那次騰濤搬給震住了"
    },
    {
      "end": 7866.46,
      "start": 7862.68,
      "text": "就是他知道錦濤女永青是不讓任何人去了家"
    },
    {
      "end": 7867.32,
      "start": 7866.46,
      "text": "當時就倆人"
    },
    {
      "end": 7869.12,
      "start": 7867.32,
      "text": "一個陳剛一個我"
    },
    {
      "end": 7871.02,
      "start": 7869.12,
      "text": "在陳剛之前有個姓唐的"
    },
    {
      "end": 7874.7,
      "start": 7871.02,
      "text": "姓唐結果泄露了錦濤心臟病的心脈圖"
    },
    {
      "end": 7876.14,
      "start": 7874.7,
      "text": "坐了那個搭橋"
    },
    {
      "end": 7877.14,
      "start": 7876.14,
      "text": "再也不讓他去家"
    },
    {
      "end": 7880.98,
      "start": 7878.9,
      "text": "所以只有我和陳剛去"
    },
    {
      "end": 7882.14,
      "start": 7880.98,
      "text": "陳剛北京副市長"
    },
    {
      "end": 7884.58,
      "start": 7882.14,
      "text": "是當年歸委的辦公室主任"
    },
    {
      "end": 7885.38,
      "start": 7884.58,
      "text": "副主任"
    },
    {
      "end": 7886.42,
      "start": 7885.38,
      "text": "林永青的秘書"
    },
    {
      "end": 7888.02,
      "start": 7886.42,
      "text": "林永青的秘書"
    },
    {
      "end": 7888.42,
      "start": 7888.02,
      "text": "記住啊"
    },
    {
      "end": 7889.88,
      "start": 7888.42,
      "text": "錦濤夫人的秘書"
    },
    {
      "end": 7891.08,
      "start": 7889.88,
      "text": "清華同學"
    },
    {
      "end": 7892.52,
      "start": 7891.08,
      "text": "絕對自信"
    },
    {
      "end": 7894.72,
      "start": 7892.52,
      "text": "如果錦濤還在的話"
    },
    {
      "end": 7896.52,
      "start": 7894.72,
      "text": "絕對陳剛是當總理的量"
    },
    {
      "end": 7897.96,
      "start": 7896.52,
      "text": "這是肯定甚至接班"
    },
    {
      "end": 7899.08,
      "start": 7897.96,
      "text": "結果把他給抓了"
    },
    {
      "end": 7901.36,
      "start": 7899.08,
      "text": "因為王岐山既用他又恨他"
    },
    {
      "end": 7901.96,
      "start": 7901.36,
      "text": "把他給抓了"
    },
    {
      "end": 7905.0,
      "start": 7901.96,
      "text": "王岐山跟錦濤的溝通人物就是陳剛"
    },
    {
      "end": 7906.52,
      "start": 7905.0,
      "text": "他抓了"
    },
    {
      "end": 7908.16,
      "start": 7906.52,
      "text": "所以當時"
    },
    {
      "end": 7911.56,
      "start": 7908.16,
      "text": "滕文生在我談房地產的時候"
    },
    {
      "end": 7913.96,
      "start": 7911.56,
      "text": "說文貴我這次認真聽到你房地產稅的問題"
    },
    {
      "end": 7914.72,
      "start": 7913.96,
      "text": "我給他說"
    },
    {
      "end": 7916.16,
      "start": 7914.72,
      "text": "我給你拿房地產稅只有兩個結果"
    },
    {
      "end": 7918.36,
      "start": 7916.16,
      "text": "第一個結果"
    },
    {
      "end": 7920.8,
      "start": 7918.36,
      "text": "共產黨拿完房地產稅"
    },
    {
      "end": 7922.44,
      "start": 7920.8,
      "text": "中國金融結構徹底改變"
    },
    {
      "end": 7923.96,
      "start": 7922.44,
      "text": "因為房地產"
    },
    {
      "end": 7925.28,
      "start": 7923.96,
      "text": "拿了房地產稅以後"
    },
    {
      "end": 7927.08,
      "start": 7925.28,
      "text": "房地價和老百姓"
    },
    {
      "end": 7929.64,
      "start": 7927.08,
      "text": "真的是房子用來住不能用來炒"
    },
    {
      "end": 7932.2,
      "start": 7929.64,
      "text": "你可以看看我什麼時候說的話"
    },
    {
      "end": 7933.64,
      "start": 7932.2,
      "text": "你查查我曾經說的話"
    },
    {
      "end": 7936.92,
      "start": 7933.64,
      "text": "盤古當年開設的時候"
    },
    {
      "end": 7938.52,
      "start": 7936.92,
      "text": "我們的秀樓車上說"
    },
    {
      "end": 7941.48,
      "start": 7938.52,
      "text": "房子是用來住的不是用來炒的"
    },
    {
      "end": 7943.48,
      "start": 7941.48,
      "text": "去看看盤古的消息樓葉"
    },
    {
      "end": 7946.16,
      "start": 7943.48,
      "text": "吹牛"
    },
    {
      "end": 7947.16,
      "start": 7946.16,
      "text": "你可以吹牛"
    },
    {
      "end": 7948.16,
      "start": 7947.16,
      "text": "別把牛吹死了"
    },
    {
      "end": 7949.12,
      "start": 7948.16,
      "text": "自己也吹死了"
    },
    {
      "end": 7950.52,
      "start": 7949.12,
      "text": "共產黨吹牛"
    },
    {
      "end": 7951.72,
      "start": 7950.52,
      "text": "把牛也吹死了"
    },
    {
      "end": 7952.6,
      "start": 7951.72,
      "text": "自己也吹死了"
    },
    {
      "end": 7953.56,
      "start": 7952.6,
      "text": "你去看看去"
    },
    {
      "end": 7954.16,
      "start": 7953.56,
      "text": "七哥說的"
    },
    {
      "end": 7956.8,
      "start": 7954.16,
      "text": "我只有一個國家房子是住的"
    },
    {
      "end": 7957.8,
      "start": 7956.8,
      "text": "不能用來炒的"
    },
    {
      "end": 7958.56,
      "start": 7957.8,
      "text": "這房產稅"
    },
    {
      "end": 7960.0,
      "start": 7958.56,
      "text": "那你只有上房地產稅"
    },
    {
      "end": 7962.4,
      "start": 7961.12,
      "text": "晚了滅國"
    },
    {
      "end": 7963.84,
      "start": 7963.04,
      "text": "早了滅黨"
    },
    {
      "end": 7965.44,
      "start": 7964.8,
      "text": "他說那你這兒說"
    },
    {
      "end": 7967.0,
      "start": 7965.44,
      "text": "那就別上了吧"
    },
    {
      "end": 7968.24,
      "start": 7967.0,
      "text": "我們就別研究這個了"
    },
    {
      "end": 7970.68,
      "start": 7969.08,
      "text": "不是現在要做的"
    },
    {
      "end": 7972.48,
      "start": 7971.6,
      "text": "可惜的事情"
    },
    {
      "end": 7975.44,
      "start": 7973.08,
      "text": "現在是真的要滅國還要滅黨"
    },
    {
      "end": 7978.84,
      "start": 7977.24,
      "text": "錦濤也問過我原話"
    },
    {
      "end": 7979.64,
      "start": 7978.84,
      "text": "包括李克強"
    },
    {
      "end": 7980.28,
      "start": 7979.64,
      "text": "李克強說"
    },
    {
      "end": 7981.16,
      "start": 7980.28,
      "text": "你怎麼開房子產稅"
    },
    {
      "end": 7983.36,
      "start": 7981.16,
      "text": "我說現在你要拿房子產稅"
    },
    {
      "end": 7984.56,
      "start": 7984.08,
      "text": "就是滅黨"
    },
    {
      "end": 7986.08,
      "start": 7985.12,
      "text": "早了就是滅國"
    },
    {
      "end": 7987.08,
      "start": 7986.08,
      "text": "那要是再晚了"
    },
    {
      "end": 7988.32,
      "start": 7987.08,
      "text": "再晚了既滅國還滅黨"
    },
    {
      "end": 7991.12,
      "start": 7988.56,
      "text": "現在就是硬了"
    },
    {
      "end": 7992.0,
      "start": 7991.12,
      "text": "滅國滅黨"
    },
    {
      "end": 7994.24,
      "start": 7993.76,
      "text": "是吧"
    },
    {
      "end": 7996.76,
      "start": 7995.04,
      "text": "當時這個誰那個那個"
    },
    {
      "end": 7998.16,
      "start": 7996.76,
      "text": "李克強大叔"
    },
    {
      "end": 7999.6,
      "start": 7998.16,
      "text": "我們經常聊天的時候"
    },
    {
      "end": 8001.6,
      "start": 7999.6,
      "text": "他說文貴你腦袋裝上什麼"
    },
    {
      "end": 8004.28,
      "start": 8002.08,
      "text": "我一直懷疑你的真實身份"
    },
    {
      "end": 8006.24,
      "start": 8004.28,
      "text": "你每次給我東西都不一樣"
    },
    {
      "end": 8008.64,
      "start": 8006.24,
      "text": "你一定背後有高人給你指點"
    },
    {
      "end": 8009.92,
      "start": 8008.64,
      "text": "我說我英文不行"
    },
    {
      "end": 8011.04,
      "start": 8009.92,
      "text": "日文也不行"
    },
    {
      "end": 8012.64,
      "start": 8011.04,
      "text": "普通話說不清楚"
    },
    {
      "end": 8013.84,
      "start": 8012.64,
      "text": "山東話說不標準"
    },
    {
      "end": 8015.04,
      "start": 8013.84,
      "text": "你說我後面有誰"
    },
    {
      "end": 8016.24,
      "start": 8015.04,
      "text": "何強總理"
    },
    {
      "end": 8017.72,
      "start": 8016.72,
      "text": "你們這就是高"
    },
    {
      "end": 8020.08,
      "start": 8017.72,
      "text": "你爹是縣委書記"
    },
    {
      "end": 8021.36,
      "start": 8020.08,
      "text": "你受過高等教育"
    },
    {
      "end": 8022.56,
      "start": 8021.36,
      "text": "我這受啥教育"
    },
    {
      "end": 8024.16,
      "start": 8022.56,
      "text": "我說就是愛讀書愛學習"
    },
    {
      "end": 8025.16,
      "start": 8024.16,
      "text": "所以我那時候"
    },
    {
      "end": 8026.72,
      "start": 8025.16,
      "text": "你看到我車上永遠是書"
    },
    {
      "end": 8028.0,
      "start": 8026.72,
      "text": "近周南科家老人家"
    },
    {
      "end": 8029.2,
      "start": 8028.0,
      "text": "永遠夾著一摩書"
    },
    {
      "end": 8030.4,
      "start": 8029.2,
      "text": "跟現在的辦農似的"
    },
    {
      "end": 8032.64,
      "start": 8030.4,
      "text": "所以人家的印象我愛讀書"
    },
    {
      "end": 8034.64,
      "start": 8032.64,
      "text": "實際上我書裡邊很多都是黃色書"
    },
    {
      "end": 8035.08,
      "start": 8034.64,
      "text": "你知道嗎"
    },
    {
      "end": 8036.4,
      "start": 8035.08,
      "text": "他們只是沒翻而已"
    },
    {
      "end": 8039.6,
      "start": 8036.4,
      "text": "所以說咱裏裝的很一樣樣"
    },
    {
      "end": 8040.08,
      "start": 8039.6,
      "text": "是吧"
    },
    {
      "end": 8042.08,
      "start": 8040.08,
      "text": "今天你看到了"
    },
    {
      "end": 8043.08,
      "start": 8042.08,
      "text": "你看到了"
    },
    {
      "end": 8044.36,
      "start": 8043.08,
      "text": "不是我那真的老帶的"
    },
    {
      "end": 8046.28,
      "start": 8044.36,
      "text": "我老帶的那些"
    },
    {
      "end": 8047.36,
      "start": 8046.28,
      "text": "金瓶梅什麼的"
    },
    {
      "end": 8048.56,
      "start": 8047.36,
      "text": "金瓶梅海外版"
    },
    {
      "end": 8050.2,
      "start": 8048.56,
      "text": "讓他們知道我不務正義"
    },
    {
      "end": 8051.32,
