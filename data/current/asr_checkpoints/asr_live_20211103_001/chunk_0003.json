{
  "chunk_audio_sha256": "05b5b071fecae2bb26d671bca51acdf6f4699f60a31b7501b7149f34627dbb3d",
  "chunk_index": 3,
  "completed_at": "2026-10-21T03:33:22Z",
  "language": "zh",
  "live_id": "LIVE_20211103_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 2700,
