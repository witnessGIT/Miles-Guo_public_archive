    {
      "end": 6209.7,
      "start": 6207.7,
      "text": "在报仇中搞死邓家"
    },
    {
      "end": 6212.9,
      "start": 6210.26,
      "text": "搞死当年让我娘在深圳不高兴的张高丽"
