  "segments": [
    {
      "end": 5402.0,
      "start": 5400.0,
      "text": "這幫孫子還在跟我講這些"
    },
    {
      "end": 5404.4,
      "start": 5402.0,
      "text": "我說你他們的這些跟人家"
    },
    {
