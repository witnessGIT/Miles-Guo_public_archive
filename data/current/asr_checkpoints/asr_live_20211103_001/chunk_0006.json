    {
      "end": 5591.5,
      "start": 5589.5,
      "text": "一毫毫一唱歌"
    },
    {
      "end": 5592.5,
      "start": 5591.5,
      "text": "從來多少年了"
    },
    {
      "end": 5594.5,
      "start": 5592.5,
      "text": "我從來沒給他見面"
    },
    {
      "end": 5596.5,
      "start": 5595.5,
      "text": "從來沒有"
    },
    {
      "end": 5597.5,
      "start": 5596.5,
      "text": "為什麼"
    },
    {
      "end": 5599.5,
      "start": 5597.5,
      "text": "我知道他們屁股有多髒"
    },
    {
      "end": 5601.5,
      "start": 5599.5,
      "text": "我知道他有多不適人"
    },
    {
      "end": 5603.5,
      "start": 5601.5,
      "text": "這個姚明每次就說"
    },
    {
      "end": 5604.5,
      "start": 5603.5,
      "text": "你們郭老闆"
    },
    {
      "end": 5605.5,
      "start": 5604.5,
      "text": "什麼什麼什麼"
    },
    {
      "end": 5606.5,
      "start": 5605.5,
      "text": "你給他給我什麼"
    },
    {
      "end": 5607.5,
      "start": 5606.5,
      "text": "牽的T恤"
    },
    {
      "end": 5609.5,
      "start": 5607.5,
      "text": "還牽的球"
    },
    {
      "end": 5611.5,
      "start": 5609.5,
      "text": "還說給郭先生的家人"
    },
    {
      "end": 5612.5,
      "start": 5611.5,
      "text": "帶的旅行"
    },
    {
      "end": 5613.5,
      "start": 5612.5,
      "text": "多了去了"
    },
    {
      "end": 5614.5,
      "start": 5613.5,
      "text": "從來我不要"
    },
    {
      "end": 5615.5,
      "start": 5614.5,
      "text": "因為我小孫兒給我說"
    },
    {
      "end": 5617.5,
      "start": 5615.5,
      "text": "他說這孫子變態著呢"
    },
    {
      "end": 5618.5,
      "start": 5617.5,
      "text": "那時候最火的時候"
    },
    {
      "end": 5620.5,
      "start": 5618.5,
      "text": "小孫兒是我老弟啊"
    },
    {
      "end": 5622.5,
      "start": 5620.5,
      "text": "他說我把他弄死個球的了"
    },
    {
      "end": 5624.5,
      "start": 5622.5,
      "text": "我把他底兒的查這個祖宗麻上"
    },
    {
      "end": 5626.5,
      "start": 5624.5,
      "text": "爹媽媽給我道歉"
    },
    {
      "end": 5627.5,
      "start": 5626.5,
      "text": "讓他幹啥他幹啥"
    },
    {
      "end": 5628.5,
      "start": 5627.5,
      "text": "我讓他幹啥"
    },
    {
      "end": 5629.5,
      "start": 5628.5,
      "text": "他給誰安檢定期"
    },
    {
      "end": 5630.5,
      "start": 5629.5,
      "text": "他給誰安檢定期"
    },
    {
      "end": 5631.5,
      "start": 5630.5,
      "text": "他給誰安檢定期"
    },
    {
      "end": 5632.5,
      "start": 5631.5,
      "text": "所有的人"
    },
    {
      "end": 5635.5,
      "start": 5632.5,
      "text": "我為啥我喜歡香港和臺灣呢"
    },
    {
      "end": 5637.5,
      "start": 5636.5,
      "text": "香港和臺灣"
    },
    {
      "end": 5638.5,
      "start": 5637.5,
      "text": "我在香港的夜總會"
    },
    {
      "end": 5640.5,
      "start": 5638.5,
      "text": "我親自經歷"
    },
    {
      "end": 5642.5,
      "start": 5640.5,
      "text": "就是國內的那大佬"
    },
    {
      "end": 5644.5,
      "start": 5642.5,
      "text": "還有安全部的什麼軍隊的來"
    },
    {
      "end": 5645.5,
      "start": 5644.5,
      "text": "穿著變裝來"
    },
    {
      "end": 5647.5,
      "start": 5645.5,
      "text": "就跟那現場唱歌小姑娘"
    },
    {
      "end": 5648.5,
      "start": 5647.5,
      "text": "他就摸人家就要說"
    },
    {
      "end": 5649.5,
      "start": 5648.5,
      "text": "哎呀香港姑娘"
    },
    {
      "end": 5650.5,
      "start": 5649.5,
      "text": "對對對"
    },
    {
      "end": 5651.5,
      "start": 5650.5,
      "text": "我是來唱歌的"
    },
    {
      "end": 5653.5,
      "start": 5651.5,
      "text": "我不是來跟你上床的"
    },
    {
      "end": 5654.5,
      "start": 5653.5,
      "text": "你說我就走了"
    },
    {
      "end": 5657.5,
      "start": 5655.5,
      "text": "其中有的長得很帥的"
    },
    {
      "end": 5659.5,
      "start": 5657.5,
      "text": "帥的就是國內的官員軍方"
    },
    {
      "end": 5660.5,
      "start": 5659.5,
      "text": "非常帥的"
    },
    {
      "end": 5661.5,
      "start": 5660.5,
      "text": "不是長得醜的很年輕的"
    },
    {
      "end": 5663.5,
      "start": 5661.5,
      "text": "你看我哪那不帥"
    },
    {
      "end": 5664.5,
      "start": 5663.5,
      "text": "你看我那不行"
    },
    {
      "end": 5666.5,
      "start": 5664.5,
      "text": "咱倆的混同朋友其中之一就是"
    },
    {
      "end": 5668.5,
      "start": 5666.5,
      "text": "到時香港還沒回歸呢"
    },
    {
      "end": 5670.5,
      "start": 5668.5,
      "text": "你看香港回歸我就是什麼什麼人"
    },
    {
      "end": 5671.5,
      "start": 5670.5,
      "text": "你那香港公司說"
    },
    {
      "end": 5673.5,
      "start": 5671.5,
      "text": "對不起我不陪上床"
    },
    {
      "end": 5674.5,
      "start": 5673.5,
      "text": "你多少錢"
    },
    {
      "end": 5675.5,
      "start": 5674.5,
      "text": "結果就有大老闆出來"
    },
    {
      "end": 5678.5,
      "start": 5675.5,
      "text": "喀放著200萬港幣"
    },
    {
      "end": 5680.5,
      "start": 5678.5,
      "text": "就陪高興"
    },
    {
      "end": 5682.5,
      "start": 5680.5,
      "text": "你給我兩千萬塊"
    },
    {
      "end": 5683.5,
      "start": 5682.5,
      "text": "你有時候就走"
    },
    {
      "end": 5685.5,
      "start": 5683.5,
      "text": "我經歷不是一回的事"
    },
    {
      "end": 5687.5,
      "start": 5685.5,
      "text": "我在台灣我親自經歷過"
    },
    {
      "end": 5688.5,
      "start": 5687.5,
      "text": "那王八蛋"
    },
    {
      "end": 5690.5,
      "start": 5688.5,
      "text": "那當時那個楊登奎"
    },
    {
      "end": 5691.5,
      "start": 5690.5,
      "text": "那帶著我那都是黑"
    },
    {
      "end": 5692.5,
      "start": 5691.5,
      "text": "台灣黑道的"
    },
    {
      "end": 5693.5,
      "start": 5692.5,
      "text": "那時候正經還穿胡當褲呢"
    },
    {
      "end": 5694.5,
      "start": 5693.5,
      "text": "艾米莉還"
    },
    {
      "end": 5696.5,
      "start": 5694.5,
      "text": "我當時就是晚上喝酒"
    },
    {
      "end": 5697.5,
      "start": 5696.5,
      "text": "台灣你還說"
    },
    {
      "end": 5698.5,
      "start": 5697.5,
      "text": "哎這是陪你上床的"
    },
    {
      "end": 5700.5,
      "start": 5698.5,
      "text": "穿綠褲子那陪你上床的"
    },
    {
      "end": 5703.5,
      "start": 5700.5,
      "text": "穿這個藍的白的自己衣服的"
    },
    {
      "end": 5704.5,
      "start": 5703.5,
      "text": "都不陪你上床的"
    },
    {
      "end": 5705.5,
      "start": 5704.5,
      "text": "你別想了啊"
    },
    {
      "end": 5706.5,
      "start": 5705.5,
      "text": "這不能想"
    },
    {
      "end": 5709.5,
      "start": 5706.5,
      "text": "而且人家帶來的大哥大姐"
    },
    {
      "end": 5710.5,
      "start": 5709.5,
      "text": "人家就說你千萬別想"
    },
    {
      "end": 5712.5,
      "start": 5710.5,
      "text": "你想這事就破規矩了"
    },
    {
      "end": 5715.5,
      "start": 5712.5,
      "text": "人家有原則知道嗎"
    },
    {
      "end": 5716.5,
      "start": 5715.5,
      "text": "黑幫"
    },
    {
      "end": 5717.5,
      "start": 5716.5,
      "text": "黑為啥叫幫啊"
    },
    {
      "end": 5719.5,
      "start": 5717.5,
      "text": "黑道有規矩"
    },
    {
      "end": 5721.5,
      "start": 5720.5,
      "text": "咱們那天上市"
    },
    {
      "end": 5722.5,
      "start": 5721.5,
      "text": "分這個這個"
    },
    {
      "end": 5723.5,
      "start": 5722.5,
      "text": "即時即利"
    },
    {
      "end": 5725.5,
      "start": 5723.5,
      "text": "咱們那老祖宗啥叫什麽"
    },
    {
      "end": 5728.5,
      "start": 5725.5,
      "text": "批的即時即日叫黃道"
    },
    {
      "end": 5730.5,
      "start": 5728.5,
      "text": "叫黃道即日"
    },
    {
      "end": 5733.5,
      "start": 5730.5,
      "text": "不即日日叫黑道"
    },
    {
      "end": 5735.5,
      "start": 5733.5,
      "text": "叫黑日"
    },
    {
      "end": 5737.5,
      "start": 5735.5,
      "text": "就不極力開業什麽大事"
    },
    {
      "end": 5738.5,
      "start": 5737.5,
      "text": "不極力結婚的"
    },
    {
      "end": 5741.5,
      "start": 5738.5,
      "text": "我們人類是從兩種文化都非黃黑道了"
    },
    {
      "end": 5742.5,
      "start": 5741.5,
      "text": "你告訴我"
    },
    {
      "end": 5743.5,
      "start": 5742.5,
      "text": "共產黨是哪道啊"
    },
    {
      "end": 5747.5,
      "start": 5744.5,
      "text": "既不黃又不黑又不紅又不白"
    },
    {
      "end": 5748.5,
      "start": 5747.5,
      "text": "這個王八蛋"
    },
    {
      "end": 5750.5,
      "start": 5748.5,
      "text": "簡直是個畜生幫"
    },
    {
      "end": 5752.5,
      "start": 5750.5,
      "text": "所以老弟你說姚明"
    },
    {
      "end": 5754.5,
      "start": 5752.5,
      "text": "你剛才說就把我處罰這事"
    },
    {
      "end": 5756.5,
      "start": 5754.5,
      "text": "你說你幾個早就太知道了"
    },
    {
      "end": 5757.5,
      "start": 5756.5,
      "text": "太知道了"
    },
    {
      "end": 5760.5,
      "start": 5757.5,
      "text": "我說實話我真不知道陶海東葉招影"
    },
    {
      "end": 5764.5,
      "start": 5760.5,
      "text": "我甚至在國內我聽到招影的名字"
    },
    {
      "end": 5766.5,
      "start": 5764.5,
      "text": "你們聽到我呀很少很少"
    },
    {
      "end": 5769.5,
      "start": 5766.5,
      "text": "你倆都沒去過盤骨你想想你是什麽概念"
    },
    {
      "end": 5771.5,
      "start": 5769.5,
      "text": "你倆高尚都已經沒有去過盤骨"
    },
    {
      "end": 5772.5,
      "start": 5771.5,
      "text": "那是什麽概念你想想"
    },
    {
      "end": 5775.5,
      "start": 5772.5,
      "text": "你沒去過盤骨就說明你也太乾淨了"
    },
    {
      "end": 5779.5,
      "start": 5777.5,
      "text": "盤骨的真的是"
    },
    {
      "end": 5781.5,
      "start": 5779.5,
      "text": "現在你在地板上刮一刮那精子卵子的"
    },
    {
      "end": 5784.5,
      "start": 5781.5,
      "text": "我估計培養個幾百億人口出來沒問題"
    },
    {
      "end": 5786.5,
      "start": 5784.5,
      "text": "到處都是屍啊"
    },
    {
      "end": 5787.5,
      "start": 5786.5,
      "text": "你知道嗎"
    },
    {
      "end": 5792.5,
      "start": 5787.5,
      "text": "所以說兄弟你剛才講的我太有感觸"
    },
    {
      "end": 5793.5,
      "start": 5792.5,
      "text": "啊"
    },
    {
      "end": 5794.5,
      "start": 5793.5,
      "text": "你沒明說"
    },
    {
      "end": 5797.5,
      "start": 5794.5,
      "text": "沒有人捨得為我們花錢"
    },
    {
      "end": 5800.5,
      "start": 5797.5,
      "text": "這個拿錢出來請我們去吃飯的"
    },
    {
      "end": 5802.5,
      "start": 5800.5,
      "text": "沒有人從來沒有人約過"
    },
    {
      "end": 5804.5,
      "start": 5802.5,
      "text": "說請我們去盤骨吃飯"
    },
    {
      "end": 5805.5,
      "start": 5804.5,
      "text": "從來沒有"
    },
    {
      "end": 5808.5,
      "start": 5805.5,
      "text": "盤骨幾乎百分之八九十吃飯都不是自己花錢的"
    },
    {
      "end": 5810.5,
      "start": 5808.5,
      "text": "也沒有人問價格也沒有人花多少錢"
    },
    {
      "end": 5813.5,
      "start": 5810.5,
      "text": "盤骨的卡就能賣十幾億也沒開業"
    },
    {
      "end": 5815.5,
      "start": 5813.5,
      "text": "你去想想吧"
    },
    {
      "end": 5816.5,
      "start": 5815.5,
      "text": "你去想想啥概念"
    },
    {
      "end": 5819.5,
      "start": 5816.5,
      "text": "到今天你都是沒有人可以跨破這個的"
    },
    {
      "end": 5822.5,
      "start": 5819.5,
      "text": "那裏邊我們漂亮的雙胞胎"
    },
    {
      "end": 5824.5,
      "start": 5822.5,
      "text": "好多雙胞胎"
    },
    {
      "end": 5825.5,
      "start": 5824.5,
      "text": "都雙胞胎來了"
    },
    {
      "end": 5826.5,
      "start": 5825.5,
      "text": "轉一年就走了"
    },
    {
      "end": 5828.5,
      "start": 5826.5,
      "text": "我都忘了好多雙胞胎來啊"
    },
    {
      "end": 5829.5,
      "start": 5828.5,
      "text": "好漂亮啊"
    },
    {
      "end": 5831.5,
      "start": 5829.5,
      "text": "來第一個藍金黃我"
    },
    {
      "end": 5833.5,
      "start": 5831.5,
      "text": "先把我藍金黃了是吧"
    },
    {
      "end": 5834.5,
      "start": 5833.5,
      "text": "然後再允許"
    },
    {
      "end": 5837.5,
      "start": 5834.5,
      "text": "在那邊賣卡啊賣卡百分之十十五現金啊"
    },
    {
      "end": 5840.5,
      "start": 5837.5,
      "text": "直接現金啊賣房子百分之五到十啊"
    },
    {
      "end": 5842.5,
      "start": 5840.5,
      "text": "一套房子當時都是八千萬到一個億"
    },
    {
      "end": 5844.5,
      "start": 5842.5,
      "text": "起價六千多萬"
    },
    {
      "end": 5846.5,
      "start": 5844.5,
      "text": "賣一個就是六百萬到一千萬的現金啊"
    },
    {
      "end": 5849.5,
      "start": 5846.5,
      "text": "喀喀現金總都是提現金的啊"
    },
    {
      "end": 5852.5,
      "start": 5849.5,
      "text": "賣一個卡一百萬的卡就是十萬現金啊"
    },
    {
      "end": 5857.5,
      "start": 5852.5,
      "text": "你像艾米利你像這個這個菲菲他根本打不住這種誘惑"
    },
    {
      "end": 5860.5,
      "start": 5857.5,
      "text": "你一天行兩天三天你自動就下去了"
    },
    {
      "end": 5864.5,
      "start": 5860.5,
      "text": "你這錢也不一定跟人家上床是吧"
    },
    {
      "end": 5865.5,
      "start": 5864.5,
      "text": "就我長得好看"
    },
    {
      "end": 5867.5,
      "start": 5865.5,
      "text": "說了喝幾杯酒"
    },
    {
      "end": 5868.5,
      "start": 5867.5,
      "text": "然後卡就賣了"
    },
    {
      "end": 5869.5,
      "start": 5868.5,
      "text": "一個中時"
    },
    {
      "end": 5873.5,
      "start": 5869.5,
      "text": "當時一個那個抓陳東海一個人買三千萬的卡"
    },
    {
      "end": 5875.5,
      "start": 5873.5,
      "text": "一個人買三千萬的卡"
    },
    {
      "end": 5878.5,
      "start": 5875.5,
      "text": "來一次一百萬來一次一百萬"
    },
    {
      "end": 5879.5,
      "start": 5878.5,
      "text": "他就有支票檔那搁著呢"
    },
    {
      "end": 5881.5,
      "start": 5879.5,
      "text": "哎買這姑娘一百萬卡啊"
    },
    {
      "end": 5883.5,
      "start": 5881.5,
      "text": "這姑娘喀在坐牌子啦"
    },
    {
      "end": 5885.5,
      "start": 5883.5,
      "text": "大哥我陪你喝一杯"
    },
    {
      "end": 5886.5,
      "start": 5885.5,
      "text": "哎呦我算"
    },
    {
      "end": 5887.5,
      "start": 5886.5,
      "text": "再來一百萬"
    },
    {
      "end": 5888.5,
      "start": 5887.5,
      "text": "是吧"
    },
    {
      "end": 5890.5,
      "start": 5888.5,
      "text": "這就是周一瓶五百萬"
    },
    {
      "end": 5892.5,
      "start": 5890.5,
      "text": "也三千萬"
    },
    {
      "end": 5894.5,
      "start": 5892.5,
      "text": "你們不知道"
    },
    {
      "end": 5896.5,
      "start": 5894.5,
      "text": "七哥知道人心和規則"
    },
    {
      "end": 5898.5,
      "start": 5896.5,
      "text": "這咱為啥今天能有洗淀珠"
    },
    {
      "end": 5899.5,
      "start": 5898.5,
      "text": "你看看這個"
    },
    {
      "end": 5901.5,
      "start": 5899.5,
      "text": "你看看"
    },
    {
      "end": 5903.5,
      "start": 5901.5,
      "text": "今天整個這個你看哪贏了啊"
    },
    {
      "end": 5908.5,
      "start": 5905.5,
      "text": "康尼迪克州共和黨全嫂"
    },
    {
      "end": 5910.5,
      "start": 5909.5,
      "text": "康尼迪克州你知道是"
    },
    {
      "end": 5912.5,
      "start": 5910.5,
      "text": "這是多牛啊"
    },
    {
      "end": 5913.5,
      "start": 5912.5,
      "text": "有錢人啊"
    },
    {
      "end": 5915.5,
      "start": 5913.5,
      "text": "長島全贏"
    },
    {
      "end": 5918.5,
      "start": 5915.5,
      "text": "所有的名人有錢全在那兒呢"
    },
    {
      "end": 5919.5,
      "start": 5918.5,
      "text": "不可能的啊"
    },
    {
      "end": 5920.5,
      "start": 5919.5,
      "text": "紐爵士"
    },
    {
      "end": 5921.5,
      "start": 5920.5,
      "text": "哇這祖奶奶呀"
    },
    {
      "end": 5923.5,
      "start": 5921.5,
      "text": "紐爵士啊"
    },
    {
      "end": 5925.5,
      "start": 5923.5,
      "text": "克里斯汀就是庫什納的"
    },
    {
      "end": 5926.5,
      "start": 5925.5,
      "text": "他爹在那地方啊"
    },
    {
      "end": 5928.5,
      "start": 5926.5,
      "text": "西雅圖"
    },
    {
      "end": 5930.5,
      "start": 5928.5,
      "text": "哇塞西雅圖全贏"
    },
    {
      "end": 5932.5,
      "start": 5930.5,
      "text": "福爾街尼亞這剛才知道了"
    },
    {
      "end": 5934.5,
      "start": 5932.5,
      "text": "幾乎是橫掃"
    },
    {
      "end": 5938.5,
      "start": 5936.5,
      "text": "你知道這剛才咱要談談疫苗的兄弟啊"
    },
    {
      "end": 5940.5,
      "start": 5938.5,
      "text": "有沒有"
    },
    {
      "end": 5942.5,
      "start": 5940.5,
      "text": "你知道疫苗是我們"
    },
    {
      "end": 5944.5,
      "start": 5942.5,
      "text": "我認我們一生當中最大的贏"
    },
    {
      "end": 5949.5,
      "start": 5944.5,
      "text": "就是要這個疫苗和病毒"
    },
    {
      "end": 5951.5,
      "start": 5949.5,
      "text": "是我們絕對新中國聯邦人"
    },
    {
      "end": 5953.5,
      "start": 5951.5,
      "text": "在世界上最大的贏"
    },
    {
      "end": 5955.5,
      "start": 5953.5,
      "text": "第二個"
    },
    {
      "end": 5957.5,
      "start": 5955.5,
      "text": "第二個"
    },
    {
      "end": 5961.5,
      "start": 5957.5,
      "text": "才是我們今天的整個喜聯儲和蓋特"
    },
    {
      "end": 5964.5,
      "start": 5961.5,
      "text": "蓋特扮演啥作用"
    },
    {
      "end": 5965.5,
      "start": 5964.5,
      "text": "你去想想去吧"
    },
    {
      "end": 5969.5,
      "start": 5965.5,
      "text": "三百萬人你看他的質量有多高"
    },
    {
      "end": 5970.5,
      "start": 5969.5,
      "text": "我搞"
    },
    {
      "end": 5972.5,
      "start": 5971.5,
      "text": "這是吹牛的嗎"
    },
    {
      "end": 5975.5,
      "start": 5973.5,
      "text": "你張高麗玩處女"
    },
    {
      "end": 5976.5,
      "start": 5975.5,
      "text": "你絕對玩不出這種水平出來"
    },
    {
      "end": 5978.5,
      "start": 5976.5,
      "text": "他就是一個國家副總理常委啊"
    },
    {
      "end": 5980.5,
      "start": 5978.5,
      "text": "他要跟你七個在一個平臺下"
    },
    {
      "end": 5981.5,
      "start": 5980.5,
      "text": "在美國較量"
    },
    {
      "end": 5983.5,
      "start": 5981.5,
      "text": "他最多啊"
    },
    {
      "end": 5984.5,
      "start": 5983.5,
      "text": "他給我開車門"
    },
    {
      "end": 5986.5,
      "start": 5984.5,
      "text": "而且是一年一天只能"
    },
    {
      "end": 5988.5,
      "start": 5986.5,
      "text": "一週只能工作四天我給他工資"
    },
    {
      "end": 5991.5,
      "start": 5989.5,
      "text": "我跟這個人見面就幾回啊"
    },
    {
      "end": 5993.5,
      "start": 5991.5,
      "text": "我跟張高麗在深圳見"
    },
    {
      "end": 5994.5,
      "start": 5993.5,
      "text": "就這個人就這個淫蕩"
    },
    {
      "end": 5997.5,
      "start": 5994.5,
      "text": "那個淫蕩那個臉那個假頭髮那個臉那個樣子"
    },
    {
      "end": 5999.5,
      "start": 5997.5,
      "text": "那個眼睛跟著就那個魚眼啊"
    },
    {
      "end": 6001.5,
      "start": 5999.5,
      "text": "就那個心不在焉"
    },
    {
      "end": 6002.5,
      "start": 6001.5,
      "text": "瞪眼說假話"
    },
    {
      "end": 6004.5,
      "start": 6002.5,
      "text": "就是我老家看到那個窮人農民"
    },
    {
      "end": 6006.5,
      "start": 6004.5,
      "text": "一旦得志以後"
    },
    {
      "end": 6007.5,
      "start": 6006.5,
      "text": "無原則無貶"
    },
    {
      "end": 6009.5,
      "start": 6007.5,
      "text": "頑嘴胡言"
    },
    {
      "end": 6010.5,
      "start": 6009.5,
      "text": "說他那喊說江澤民萬歲"
    },
    {
      "end": 6012.5,
      "start": 6011.5,
      "text": "整個江澤民萬歲"
    },
    {
      "end": 6013.5,
      "start": 6012.5,
      "text": "我都跟你們講幾個小時"
    },
    {
      "end": 6015.5,
      "start": 6013.5,
      "text": "整個過世怎麼誕生"
    },
    {
      "end": 6018.5,
      "start": 6015.5,
      "text": "其中我最好的兄弟現在呆在監獄去了"
    },
    {
      "end": 6020.5,
      "start": 6018.5,
      "text": "宋新斌"
    },
    {
      "end": 6023.5,
      "start": 6020.5,
      "text": "解放軍的大學裡邊的校長政委"
    },
    {
      "end": 6027.5,
      "start": 6023.5,
      "text": "他爸爸是山東的政法委書記"
    },
    {
      "end": 6029.5,
      "start": 6027.5,
      "text": "公安廳長"
    },
    {
      "end": 6031.5,
      "start": 6029.5,
      "text": "妹夫山東檢察長"
    },
    {
      "end": 6034.5,
      "start": 6031.5,
      "text": "另外妹夫是武警隊長"
    },
    {
      "end": 6038.5,
      "start": 6034.5,
      "text": "還有一個妹夫是山東的高法院的院長"
    },
    {
      "end": 6041.5,
      "start": 6038.5,
      "text": "全家政法老大宋家過去五十年"
    },
    {
      "end": 6043.5,
      "start": 6041.5,
      "text": "張高麗去第一拜他媽的"
    },
    {
      "end": 6045.5,
      "start": 6044.5,
      "text": "我太"
    },
    {
      "end": 6047.5,
      "start": 6045.5,
      "text": "所以這七哥上泰山"
    },
    {
      "end": 6048.5,
      "start": 6047.5,
      "text": "飛機飛過去"
    },
    {
      "end": 6049.5,
      "start": 6048.5,
      "text": "喀喀飛過去"
    },
    {
      "end": 6051.5,
      "start": 6049.5,
      "text": "整個全路也戒嚴"
    },
    {
      "end": 6053.5,
      "start": 6051.5,
      "text": "弄得我很不好意思"
    },
    {
      "end": 6055.5,
      "start": 6053.5,
      "text": "到山上以後都那個級別的"
    },
    {
      "end": 6056.5,
      "start": 6055.5,
      "text": "那我真說這啥"
    },
    {
      "end": 6059.5,
      "start": 6056.5,
      "text": "結果我自己開著個中巴帶著我的員工"
    },
    {
      "end": 6061.5,
      "start": 6059.5,
      "text": "我這四季山邊的我開"
    },
    {
      "end": 6063.5,
      "start": 6061.5,
      "text": "前面兩台警車後面幾個警車開著中巴"
    },
    {
      "end": 6064.5,
      "start": 6063.5,
      "text": "喳喳喳喳我就開過去了"
    },
    {
      "end": 6066.5,
      "start": 6064.5,
      "text": "結果一進山東就全是警車"
    },
    {
      "end": 6067.5,
      "start": 6066.5,
      "text": "我這幹啥的"
    },
    {
      "end": 6068.5,
      "start": 6067.5,
      "text": "接你來了"
    },
    {
      "end": 6070.5,
      "start": 6068.5,
      "text": "前面都沒有"
    },
    {
      "end": 6071.5,
      "start": 6070.5,
      "text": "哇哇哇閃開閃開閃開"
    },
    {
      "end": 6072.5,
      "start": 6071.5,
      "text": "我開著車"
    },
    {
      "end": 6076.5,
      "start": 6072.5,
      "text": "結果沒想到我開著中巴帶著我的裕達的員工"
    },
    {
      "end": 6078.5,
      "start": 6076.5,
      "text": "第七哥當年多搞笑啊"
    },
    {
      "end": 6079.5,
      "start": 6078.5,
      "text": "結果上山了"
    },
    {
      "end": 6080.5,
      "start": 6079.5,
      "text": "哇塞"
    },
    {
      "end": 6081.5,
      "start": 6080.5,
      "text": "全國在都是叫"
    },
    {
      "end": 6082.5,
      "start": 6081.5,
      "text": "我走上去的"
    },
    {
      "end": 6083.5,
      "start": 6082.5,
      "text": "我爹還跟著我"
    },
    {
      "end": 6084.5,
      "start": 6083.5,
      "text": "我爹還走上去的"
    },
    {
      "end": 6087.5,
      "start": 6086.5,
      "text": "我爹還走上去的"
    },
    {
      "end": 6088.5,
      "start": 6087.5,
      "text": "我爹厲害得很啊"
    },
    {
      "end": 6089.5,
      "start": 6088.5,
      "text": "我爹"
    },
    {
      "end": 6090.5,
      "start": 6089.5,
      "text": "喀喀喀的"
    },
    {
      "end": 6091.5,
      "start": 6090.5,
      "text": "我是一起上去的"
    },
    {
      "end": 6093.5,
      "start": 6092.5,
      "text": "這個人"
    },
    {
      "end": 6096.5,
      "start": 6093.5,
      "text": "就是當時經歷了所有的喊江澤民的外出"
