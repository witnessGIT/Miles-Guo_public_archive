    {
      "end": 6100.5,
      "start": 6096.5,
      "text": "所以江澤民當時把胡錦濤當成你狗屁不是"
    },
    {
      "end": 6102.5,
      "start": 6100.5,
      "text": "這是2006年我記得"
    },
    {
      "end": 6104.5,
      "start": 6102.5,
      "text": "而且江澤"
    },
    {
      "end": 6106.5,
      "start": 6104.5,
      "text": "就是張高麗說習"
    },
    {
      "end": 6107.5,
      "start": 6106.5,
      "text": "這傻貨啊"
    },
    {
      "end": 6109.5,
      "start": 6107.5,
      "text": "懂個屁他懂什麼政治啊"
    },
    {
      "end": 6110.5,
      "start": 6109.5,
      "text": "最多讓他幹什麼"
    },
    {
      "end": 6111.5,
      "start": 6110.5,
      "text": "五年滾打"
    },
    {
      "end": 6114.5,
      "start": 6111.5,
      "text": "最早絕對這話不是許才厚說的"
    },
    {
      "end": 6116.5,
      "start": 6114.5,
      "text": "是張高麗先說的"
    },
    {
      "end": 6118.5,
      "start": 6116.5,
      "text": "所以說習怎麼能不收拾他"
    },
    {
      "end": 6120.5,
      "start": 6118.5,
      "text": "所以說星的節目"
    },
    {
      "end": 6122.5,
      "start": 6120.5,
      "text": "咱們今天聊的這話題都是很重要"
    },
    {
      "end": 6123.5,
      "start": 6122.5,
      "text": "都是有關係的啊"
