    {
      "end": 6152.5,
      "start": 6151.5,
      "text": "我先說"
    },
    {
      "end": 6153.5,
      "start": 6152.5,
      "text": "我"
    },
    {
      "end": 6154.5,
      "start": 6153.5,
      "text": "市哥能不能預測一下"
    },
    {
      "end": 6155.5,
      "start": 6154.5,
      "text": "市哥能不能預測一下"
