      "text": "史玉柱"
    },
    {
      "end": 5567.5,
      "start": 5563.5,
      "text": "所有人幾乎是盤古的大多數營業人"
    },
    {
      "end": 5569.5,
      "start": 5567.5,
      "text": "都是填空白指標來的"
    },
    {
      "end": 5571.5,
      "start": 5569.5,
      "text": "我跟一個人沒握過手"
    },
    {
      "end": 5573.5,
      "start": 5571.5,
      "text": "誰要有我那麼牛"
    },
    {
      "end": 5575.5,
      "start": 5573.5,
      "text": "中國有一個郭文貴我扶你"
    },
    {
      "end": 5577.5,
      "start": 5575.5,
      "text": "我從來不會看他一眼"
    },
    {
      "end": 5579.5,
      "start": 5577.5,
      "text": "包括那些明星到那裡去"
    },
    {
      "end": 5581.5,
      "start": 5579.5,
      "text": "我從來不會有一個人過去"
    },
    {
      "end": 5583.5,
      "start": 5581.5,
      "text": "他們過來想認識我"
    },
    {
      "end": 5584.5,
      "start": 5583.5,
      "text": "我從來拒絕"
    },
    {
      "end": 5585.5,
      "start": 5584.5,
      "text": "你說那什麼孫男"
    },
    {
      "end": 5587.5,
      "start": 5585.5,
      "text": "幾乎生在長在"
    },
    {
      "end": 5588.5,
      "start": 5587.5,
      "text": "你說他老婆是河南人嗎"
    },
    {
      "end": 5589.5,
      "start": 5588.5,
      "text": "就在玉達俱樂部"
