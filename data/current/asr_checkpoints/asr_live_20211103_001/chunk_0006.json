    {
      "end": 6128.5,
      "start": 6127.5,
      "text": "實際上我們都有感覺"
    },
    {
      "end": 6129.5,
      "start": 6128.5,
      "text": "因爲什麽"
    },
    {
      "end": 6131.5,
      "start": 6129.5,
      "text": "他對我們所有的後代都是個威脅"
    },
    {
      "end": 6133.5,
      "start": 6132.5,
      "text": "你不滅共產黨"
    },
    {
      "end": 6135.5,
      "start": 6133.5,
      "text": "我們所有人的孩子都有可能被他給玩的"
    },
    {
      "end": 6137.5,
      "start": 6136.5,
      "text": "這是為啥我們今天談"
    },
    {
      "end": 6138.5,
      "start": 6137.5,
      "text": "東地這有意義吧"
    },
    {
      "end": 6140.5,
      "start": 6138.5,
      "text": "鄭青兄弟"
    },
    {
      "end": 6142.5,
      "start": 6140.5,
      "text": "艾米麗你們不害怕嗎"
    },
    {
      "end": 6144.5,
      "start": 6142.5,
      "text": "被共產黨要打到台灣你們不害怕嗎"
    },
    {
      "end": 6147.5,
      "start": 6145.5,
      "text": "他們真的是把你孩子合法的就跟你玩了"
