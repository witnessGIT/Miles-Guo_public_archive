{
  "chunk_audio_sha256": "a96c33200d3f393fdf7ddefc5f538502de2aca0461aa666d8928a33343bb4019",
  "chunk_index": 5,
  "completed_at": "2026-10-21T07:55:24Z",
  "language": "zh",
  "live_id": "LIVE_20211103_001",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 4500,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 4502.5,
      "start": 4500.0,
      "text": "他在廣東當書記了 他老在深圳住著"
    },
    {
      "end": 4506.04,
      "start": 4502.9,
      "text": "海平就說領導這個孩子來不了 我弟在上面"
    },
    {
      "end": 4509.44,
      "start": 4506.04,
      "text": "我還在咱口裡不高興了 你必讓他來"
    },
    {
      "end": 4512.36,
      "start": 4510.52,
      "text": "這時海平跪下來求他"
    },
    {
      "end": 4516.7,
      "start": 4512.62,
      "text": "領導 你都要高升了 你就別碰他了"
    },
    {
      "end": 4518.0,
      "start": 4516.98,
      "text": "萬一怎麽著的"
    },
    {
      "end": 4522.36,
      "start": 4519.32,
      "text": "我還想活著 領導 你一進北京我不給你進北京"
    },
    {
      "end": 4526.06,
      "start": 4523.06,
      "text": "我就留在這裏 我保證我守苦入貧"
    },
    {
      "end": 4527.6,
      "start": 4526.3,
      "text": "你把我全家都變空"
    },
    {
      "end": 4530.4,
      "start": 4527.6,
      "text": "孫海平全家一直變空"
    },
    {
      "end": 4533.0,
      "start": 4531.8,
      "text": "你們去查去"
    },
    {
      "end": 4536.6,
      "start": 4533.0,
      "text": "這個事兒 你知道嚇人不嚇人 孫海平的事兒"
    },
    {
      "end": 4540.5,
      "start": 4536.6,
      "text": "剛才你說到我們這個壁 那天開始的時候"
    },
    {
      "end": 4542.9,
      "start": 4541.0,
      "text": "天下就那麽小 下面都猜"
    },
    {
      "end": 4546.5,
      "start": 4542.9,
      "text": "啊 誰來了 你看看那個在主會場 後面擺著香檳"
    },
    {
      "end": 4549.0,
      "start": 4546.5,
      "text": "下面一片猜的誰啊 龐皮奧"
    },
    {
      "end": 4553.5,
      "start": 4550.0,
      "text": "猜皮特 納瓦羅 猜班農的 我很不高興"
    },
    {
      "end": 4557.0,
      "start": 4554.2,
      "text": "為什麽中國人這麽大事 也要請外國人來啊"
    },
    {
      "end": 4559.9,
      "start": 4558.4,
      "text": "他來了能給妳帶來啥呀"
    },
    {
      "end": 4564.4,
      "start": 4561.8,
      "text": "他不會給我們帶來壹分錢 只能我們給他們錢"
    },
    {
      "end": 4566.3,
      "start": 4564.6,
      "text": "他會給我們帶來合作"
    },
    {
      "end": 4567.9,
      "start": 4566.6,
      "text": "但是我們不能依靠他們"
    },
    {
      "end": 4570.9,
      "start": 4568.1,
      "text": "就是今天也不會依靠他們 永遠不會依靠他們"
    },
    {
      "end": 4573.0,
      "start": 4571.1,
      "text": "我們中國人怎麽就這麽賤呢"
    },
    {
      "end": 4575.9,
      "start": 4574.3,
      "text": "所以當時你知道"
    },
    {
      "end": 4579.5,
      "start": 4575.9,
      "text": "非常有意思 就是孫俊平的我們之間壹個好哥們"
    },
    {
      "end": 4583.0,
      "start": 4580.1,
      "text": "他也是咱戰友 現在絕對在電視機前面呢"
    },
    {
      "end": 4586.4,
      "start": 4583.4,
      "text": "現在是廣州市裏邊的壹個政協的高官"
    },
    {
      "end": 4587.4,
      "start": 4586.7,
      "text": "我發信息"
    },
    {
      "end": 4589.7,
      "start": 4587.9,
      "text": "七哥為什麽咱們戰友這麽賤呢"
    },
    {
      "end": 4591.2,
      "start": 4589.7,
      "text": "非要希望外國人來呢"
    },
    {
      "end": 4592.7,
      "start": 4591.2,
      "text": "就沒有壹個希望中國人來的"
    },
    {
      "end": 4597.0,
      "start": 4593.2,
      "text": "咱中國人啥時候妳有好事 別老想著外國人行不行"
    },
    {
      "end": 4599.6,
      "start": 4597.3,
      "text": "不是外國的月亮都是圓的"
    },
    {
      "end": 4603.0,
      "start": 4600.8,
      "text": "洗聯儲是我們中國人創造的"
    },
    {
      "end": 4605.9,
      "start": 4603.0,
      "text": "是中國人的駐幣單位 中國人的人民銀行"
    },
    {
      "end": 4608.4,
      "start": 4606.9,
      "text": "我那天最後我都沒宣布"
    },
    {
      "end": 4609.9,
      "start": 4608.7,
      "text": "那天意味著什麽 東地"
    },
    {
      "end": 4613.5,
      "start": 4610.3,
      "text": "我昨天問長島哥呢 我問墨鏡 我問Q妹 問他先生"
    },
    {
      "end": 4616.6,
      "start": 4614.6,
      "text": "我昨天下午在外面的時候 看著她們在這塊"
    },
    {
      "end": 4619.0,
      "start": 4616.8,
      "text": "Q妹戴著口罩手套在插玻璃"
    },
    {
      "end": 4622.5,
      "start": 4619.2,
      "text": "她老公在這裁燈 兒子在旁邊工作"
    },
    {
      "end": 4625.4,
      "start": 4622.7,
      "text": "長島哥在這忙於直播 她壹點都不疲勞"
    },
    {
      "end": 4626.6,
      "start": 4625.4,
      "text": "她現在成明星了現在"
    },
    {
      "end": 4629.6,
      "start": 4626.6,
      "text": "我們的小白墨鏡 妳看成了這麽好的直播平臺"
    },
    {
      "end": 4632.6,
      "start": 4630.8,
      "text": "她們從來沒有人想過壹個問題"
    },
    {
      "end": 4634.4,
      "start": 4632.6,
      "text": "妳們想過有兩個核心問題嗎"
    },
    {
      "end": 4637.6,
      "start": 4635.0,
      "text": "為什麽那壹天沒被黑客貪"
    },
    {
      "end": 4639.3,
      "start": 4637.9,
      "text": "這是我們最大的問題"
    },
    {
      "end": 4643.5,
      "start": 4640.5,
      "text": "我那天所有的擔心是被黑客貪掉"
    },
    {
      "end": 4645.8,
      "start": 4644.4,
      "text": "她沒被黑貪"
    },
    {
      "end": 4648.8,
      "start": 4646.4,
      "text": "她裏面意義是啥東西 妳們都明白的"
    },
    {
      "end": 4651.6,
      "start": 4648.8,
      "text": "妳們都明白的 沒被黑掉"
    },
    {
      "end": 4655.6,
      "start": 4653.7,
      "text": "幾百億次的秒計"
    },
    {
      "end": 4658.6,
      "start": 4655.6,
      "text": "不是幾百次 我那天說人家有內部這樣說"
    },
    {
      "end": 4660.6,
      "start": 4658.6,
      "text": "七哥妳說是幾百億次啊"
    },
    {
      "end": 4662.6,
      "start": 4661.6,
      "text": "就是第6S的攻擊"
    },
    {
      "end": 4665.6,
      "start": 4663.2,
      "text": "第二個 那壹天這說明了什麽"
    },
    {
      "end": 4670.6,
      "start": 4666.4,
      "text": "新中國聯邦人的中央銀行鑄幣中心成立了"
    },
    {
      "end": 4676.6,
      "start": 4670.6,
      "text": "不是妳真的掙了多少錢 真不是東地"
    },
    {
      "end": 4681.6,
      "start": 4677.6,
      "text": "妳那天宣布了六四的宣言 這壹次就正式宣布"
    },
    {
      "end": 4686.6,
      "start": 4682.6,
      "text": "新中國聯邦的中央銀行成立了 鑄幣中心成立了"
    },
    {
      "end": 4692.6,
      "start": 4686.6,
      "text": "而且是全世界公布的 未來我們要做啥東西妳知道嗎"
    },
    {
      "end": 4696.6,
      "start": 4693.6,
      "text": "這個鑄幣全力銀行 我們會發行多少股"
    },
    {
      "end": 4699.6,
      "start": 4696.6,
      "text": "這個股首先就給 馬上就會公布這事啊"
    },
    {
      "end": 4702.6,
      "start": 4699.6,
      "text": "就給所有從現在起和原來參加爆裂根"
    },
    {
      "end": 4706.6,
      "start": 4702.6,
      "text": "妳看妳們幾個肯定是了 妳們都承認妳是新中國聯邦人"
    },
    {
      "end": 4709.6,
      "start": 4706.6,
      "text": "我們未來會有個程序 妳承認新中國聯邦"
    },
    {
      "end": 4712.6,
      "start": 4709.6,
      "text": "妳支持新中國聯邦代表中國人 啊"
    },
    {
      "end": 4714.6,
      "start": 4712.6,
      "text": "提反共產黨 都給妳記下來"
    },
    {
      "end": 4719.6,
      "start": 4714.6,
      "text": "我們把所有這原始股的多少 終身歸大家所有"
    },
    {
      "end": 4724.6,
      "start": 4720.6,
      "text": "妳比如說現在艾米利 她未來可能分到一股或十股"
    },
    {
      "end": 4728.6,
      "start": 4725.6,
      "text": "終身擁有 祖宗萬代 永遠續傳"
    },
    {
      "end": 4733.6,
      "start": 4729.6,
      "text": "而且這個管理權永遠在國際上 它是上市的 是吧"
    },
    {
      "end": 4738.6,
      "start": 4733.6,
      "text": "我們共享財富不是吹牛的 七個那天是認真研究的"
    },
    {
      "end": 4741.6,
      "start": 4738.6,
      "text": "共享財富 我把共產黨的共享財富"
    },
    {
      "end": 4743.6,
      "start": 4741.6,
      "text": "這個目標是很好 但是它不能兌現 它是辮子"
    },
    {
      "end": 4747.6,
      "start": 4743.6,
      "text": "我們要把它說的話兌現 利益共同體"
    },
    {
      "end": 4750.6,
      "start": 4748.6,
      "text": "那天上市的結果不是畢廣漲多少錢"
    },
    {
      "end": 4754.6,
      "start": 4750.6,
      "text": "是把這個利益共同體 新章每個人聯在一起"
    },
    {
      "end": 4760.6,
      "start": 4754.6,
      "text": "而且是千宗萬代 這是我不是開玩笑的"
    },
    {
      "end": 4763.6,
      "start": 4760.6,
      "text": "我不是開玩笑的 利益共享 我們利益共同體"
    },
    {
      "end": 4769.6,
      "start": 4764.6,
      "text": "我們要打造一個真的是我們大家一個平等的社區群"
    },
    {
      "end": 4772.6,
      "start": 4770.6,
      "text": "所以那天第二個意義門兒 看這兩個意義"
    },
    {
      "end": 4776.6,
      "start": 4772.6,
      "text": "為啥沒被害灘 妳誰也沒想過 妳只管這股價漲了"
    },
    {
      "end": 4781.6,
      "start": 4776.6,
      "text": "那鄭青 安排股票 跟那邊講小兔子使劇跑 是吧"
    },
    {
      "end": 4783.6,
      "start": 4781.6,
      "text": "妳跑完以後洞都沒了妳有什麽用"
    },
    {
      "end": 4788.6,
      "start": 4783.6,
      "text": "第二個 它那一天就宣布了 新中國聯盟的中央銀行成立"
    },
    {
      "end": 4791.6,
      "start": 4788.6,
      "text": "而且妳們全是主人 而且未來我們出台政策"
    },
    {
      "end": 4794.6,
      "start": 4791.6,
      "text": "是所有香港人都要擁有這個 告訴我"
    },
    {
      "end": 4798.6,
      "start": 4794.6,
      "text": "我能把中央銀行的權力給妳們 連美國都沒做到"
    },
    {
      "end": 4803.6,
      "start": 4799.6,
      "text": "美國是家天下 是幾個家族擁有著整個新聯儲的"
    },
    {
      "end": 4808.6,
      "start": 4803.6,
      "text": "我們是第一天就是明天下 直接公開的 永不可更改"
    },
    {
      "end": 4816.6,
      "start": 4810.6,
      "text": "然後大家想到了 孫俊平說這個事情支流永退"
    },
    {
      "end": 4820.6,
      "start": 4816.6,
      "text": "看到結果是 張高麗事兒就出來了"
    },
    {
      "end": 4822.6,
      "start": 4820.6,
      "text": "我知道張高麗事兒 張高麗要出事兒什麽時候出事兒"
    },
    {
      "end": 4825.6,
      "start": 4822.6,
      "text": "一個月前 妳看我的蓋特直播就說"
    },
    {
      "end": 4829.6,
      "start": 4826.6,
      "text": "習江兩家的廝殺會出現什麽"
    },
    {
      "end": 4833.6,
      "start": 4829.6,
      "text": "所有江家的人會幹誰 還有四個人還開始"
    },
    {
      "end": 4838.6,
      "start": 4833.6,
      "text": "習幹他是完全是因為個人早就想幹的"
    },
    {
      "end": 4845.6,
      "start": 4838.6,
      "text": "但江家人主要是王岐山 孟建柱 曾慶紅 還有一個人我不方便說"
    },
    {
      "end": 4855.6,
      "start": 4847.6,
      "text": "這就是妳認識我認識的文元 俊平 咱都認識了多少年了 是吧"
    },
    {
      "end": 4858.6,
      "start": 4855.6,
      "text": "我有些話還不方便說 說了趴在裏邊說死人了"
    },
    {
      "end": 4862.6,
      "start": 4858.6,
      "text": "我這壹說真的死人妳知道嗎 我這死 廣州認證的"
    },
    {
      "end": 4867.6,
      "start": 4863.6,
      "text": "那說的就是多了 某個演員就像最火的之一的演員"
    },
    {
      "end": 4873.6,
      "start": 4867.6,
      "text": "從12歲就跟著某政治局一個人睡覺"
    },
    {
      "end": 4878.6,
      "start": 4873.6,
      "text": "打了7次臺 最後壹個不到16歲的孩子把子宮割了"
    },
    {
      "end": 4883.6,
      "start": 4878.6,
      "text": "妳等哪天她來爆料的時候 妳都嚇死妳了"
    },
    {
      "end": 4889.6,
      "start": 4883.6,
      "text": "妳共產黨的殘忍 好好看看吧 妳想陳峰都掏子宮"
    },
    {
      "end": 4894.6,
      "start": 4889.6,
      "text": "妳想想這政治局按級別的話 她得掏啥去啊"
    },
    {
      "end": 4900.6,
      "start": 4894.6,
      "text": "想過嗎 我這壹說看到那個納米的鼻子抽妳抽什麼"
    },
    {
      "end": 4904.6,
      "start": 4900.6,
      "text": "被掏妳子宮 好像妳很疼似的 裝啥裝的妳啊 是吧"
    },
    {
      "end": 4910.6,
      "start": 4905.6,
      "text": "我告訴妳這個最有名的明星 16歲把子宮給切了"
    },
    {
      "end": 4915.6,
      "start": 4910.6,
      "text": "打抬打到了把子宮割了 現在還跟著那個領導呢"
    },
    {
      "end": 4922.6,
      "start": 4915.6,
      "text": "共產黨的殘忍真不是妳們想像的 妳認不清共產黨殘忍"
    },
    {
      "end": 4926.6,
      "start": 4922.6,
      "text": "妳永遠不會跟新龍聯邦 然後呢 路大腦片叫什麼"
    },
    {
      "end": 4930.6,
      "start": 4926.6,
      "text": "全美國尋講 啥叫尋講 妳們知道嗎"
    },
    {
      "end": 4935.6,
      "start": 4930.6,
      "text": "妳見過天皇尋講過嗎 妳見過那個教宗尋講過嗎"
    },
    {
      "end": 4940.6,
      "start": 4935.6,
      "text": "妳見過那個教宗尋講過嗎 妳見過毛澤東尋講過嗎"
    },
    {
      "end": 4945.6,
      "start": 4940.6,
      "text": "妳見過四大天選 從來不會 啊"
    },
    {
      "end": 4949.6,
      "start": 4945.6,
      "text": "這個共產黨當年叫長征 曾經紅的媽媽鄧留斤跟我說"
    },
    {
      "end": 4951.6,
      "start": 4949.6,
      "text": "什麼叫長征啊 就是逃跑 什麼叫長征啊"
    },
    {
      "end": 4954.6,
      "start": 4951.6,
      "text": "被打倒著逃跑 逃跑還帶著我們這幾千個女的"
    },
    {
      "end": 4958.6,
      "start": 4954.6,
      "text": "我們什麼叫 什麼叫叫紅色這個娘子軍啊 胡扯"
    },
    {
      "end": 4964.6,
      "start": 4958.6,
      "text": "我們就是義技 有軍技 我們都不知道跟誰說的"
    },
    {
      "end": 4967.6,
      "start": 4964.6,
      "text": "來一個人走來一個人 誰認識啊 誰知道是誰啊"
    },
    {
      "end": 4969.6,
      "start": 4967.6,
      "text": "有的人就出幾門就死了啊 誰知道是誰啊"
    },
    {
      "end": 4974.6,
      "start": 4969.6,
      "text": "所謂的八十萬大軍最後剩下不到一萬人八千個人"
    },
    {
      "end": 4978.6,
      "start": 4974.6,
      "text": "還得抬著毛澤東 誰都可以死 就這些女的不能死"
    },
    {
      "end": 4983.6,
      "start": 4978.6,
      "text": "所以曾海生是懷孕 是不是 在河邊上"
    },
    {
      "end": 4989.6,
      "start": 4983.6,
      "text": "上面國民黨生下來別哭一哭就捏死他 她沒哭就叫曾海生嘛"
    },
    {
      "end": 4995.6,
      "start": 4990.6,
      "text": "妳說他爹真是誰 我真不知道 妳是不是曾三真沒驗過"
    },
    {
      "end": 4999.6,
      "start": 4995.6,
      "text": "妳覺得長得像 我就覺得長得不像 啊 兄弟姐們"
    },
    {
      "end": 5004.6,
      "start": 4999.6,
      "text": "共產黨這個流氓 妳認不清楚 妳不可能懂得幾臂的價值"
    },
    {
      "end": 5010.6,
      "start": 5004.6,
      "text": "妳也不懂得新中國聯邦的真正的價值 妳不懂他的邪格"
    },
    {
      "end": 5014.6,
      "start": 5010.6,
      "text": "妳什麼都不懂 我說呢 十六十歲小孩兒就妳們現在每天都來看那個小明星"
    },
    {
      "end": 5021.6,
      "start": 5014.6,
      "text": "她媽媽是我們的戰友 她媽媽曾經是個老演員"
    },
    {
      "end": 5027.6,
      "start": 5023.6,
      "text": "在香港 中國會有一次喝酒喝多了 是吧 把我褲子擦了給拖下去"
    },
    {
      "end": 5032.6,
      "start": 5027.6,
      "text": "這個 這個 這個 我們的很熟很熟了 當時是朱世貌"
    },
    {
      "end": 5036.6,
      "start": 5032.6,
      "text": "還有另外一個當時的一個女演員 哇塞 我說妳倆脫著我褲子了"
    },
    {
      "end": 5042.6,
      "start": 5036.6,
      "text": "我說 這是不是 昨天晚上我真是第一次 因為我看彭帥的事兒吧"
    },
    {
      "end": 5047.6,
      "start": 5042.6,
      "text": "老看得挺刺激的 我想要想入非非 突然回想起了國內的各種經歷"
    },
    {
      "end": 5054.6,
      "start": 5047.6,
      "text": "結果昨晚上兩次發的 都是做的春夢 醒來以後發現故人一床很可憐哪"
    },
    {
      "end": 5058.6,
      "start": 5054.6,
      "text": "我真做的是春夢 人妳老想啥她就做啥夢 妳看這晚上"
    },
    {
      "end": 5066.6,
      "start": 5058.6,
      "text": "我發現兩次我出這屋就我一個人 好孤獨啊 這地方也沒有什麽夜總會啥的 也沒法去"
    },
    {
      "end": 5072.6,
      "start": 5066.6,
      "text": "但是我昨天就想 我真就想到這一刻 當時被托哭了 想起這個孩子"
    },
    {
      "end": 5076.6,
      "start": 5072.6,
      "text": "我突然一想 這孩子怎麽是忍受過來的"
    },
    {
      "end": 5080.6,
      "start": 5078.6,
      "text": "好 洗臂多少錢了"
    },
    {
      "end": 5085.6,
      "start": 5083.6,
      "text": "十塊三年"
    },
    {
      "end": 5087.6,
      "start": 5085.6,
      "text": "十塊三年"
    },
    {
      "end": 5090.6,
      "start": 5088.6,
      "text": "十塊三年"
    },
    {
      "end": 5092.6,
      "start": 5090.6,
      "text": "十塊三年"
    },
    {
      "end": 5094.6,
      "start": 5092.6,
      "text": "十塊三年"
    },
    {
      "end": 5095.6,
      "start": 5094.6,
      "text": "哇塞"
    },
    {
      "end": 5096.6,
      "start": 5095.6,
      "text": "十塊03年"
    },
    {
      "end": 5101.6,
      "start": 5096.6,
      "text": "很多人以為這個洗臂要十塊十塊漲 那就瘋了 那就完了 爆炸了"
    },
    {
      "end": 5103.6,
      "start": 5101.6,
      "text": "幾分幾分漲的"
    },
    {
      "end": 5104.6,
      "start": 5103.6,
      "text": "在這兒"
    },
    {
      "end": 5105.6,
      "start": 5104.6,
      "text": "是嗎"
    },
    {
      "end": 5106.6,
      "start": 5105.6,
      "text": "能看 好好"
    },
    {
      "end": 5108.6,
      "start": 5106.6,
      "text": "亂忙了"
    },
    {
      "end": 5109.6,
      "start": 5108.6,
      "text": "嗯"
    },
    {
      "end": 5111.6,
      "start": 5109.6,
      "text": "妳讓我選在這兒"
    },
    {
      "end": 5113.6,
      "start": 5111.6,
      "text": "對啦 我要看著這個"
    },
    {
      "end": 5114.6,
      "start": 5113.6,
      "text": "十塊三"
    },
    {
      "end": 5115.6,
      "start": 5114.6,
      "text": "哇塞"
    },
    {
      "end": 5116.6,
      "start": 5115.6,
      "text": "十塊三"
    },
    {
      "end": 5117.6,
      "start": 5116.6,
      "text": "哇塞"
    },
    {
      "end": 5119.6,
      "start": 5118.6,
      "text": "!"
    },
    {
      "end": 5120.6,
      "start": 5119.6,
      "text": "東弟 來了 妳們說"
    },
    {
      "end": 5121.6,
      "start": 5120.6,
      "text": "艾美麗 妳們說"
    },
    {
      "end": 5126.6,
      "start": 5121.6,
      "text": "對 聽說完以後 都勾起我們這個"
    },
    {
      "end": 5131.6,
      "start": 5126.6,
      "text": "對共產黨這種邪惡的 七哥說到的這些演藝界呀"
    },
    {
      "end": 5134.6,
      "start": 5131.6,
      "text": "什麽娛樂界呀 體育界呀 這些"
    },
    {
      "end": 5148.6,
      "start": 5134.6,
      "text": "女孩子呀 男人被這些體制呀 被這種社會裏面這種摧殘 確實我們 真的我深有同感 因為我看到他們 以及我們曾經經歷過事情 我都跟大家講"
    },
    {
      "end": 5178.6,
      "start": 5148.6,
      "text": "在中共的體制裏 她在惡 像我們這些人可以得到體制的庇護 對吧 黃海東剛才七哥說了 妳有沒有過跟14歲的什麼 我這點我可以講 黃海東從來沒有跟18歲以下的女孩子發生過任何的關係 這點是指天發誓 如果有的話 我也到不了今天 共產黨一定早就把我滅了 因為一朝天子一朝城 是吧 但是你們知道"
    },
    {
      "end": 5204.6,
      "start": 5178.6,
      "text": "我多長的時間經歷裡面 黃海東從來沒幹過一點喪盡天良 危害行業的事情 這也就是為什麼 我可以現在依然坐在這裡 每一次直播的時候 我可以常常正正的在這兒 挺直胸膛的 抱他們每個人的料 因為黃海東沒幹過犯罪犯法的事情 知道嗎 沒有強姊 沒有幼女 沒有任何的那個"
    },
    {
      "end": 5234.6,
      "start": 5204.6,
      "text": "當然我沒有說 我沒有說 我沒有任何瑕疵 道德 蠻善 沒有 那是共產黨你們知道 你們不讓別人談戀愛 你們可以去搞幼女 是吧 你們不讓 你們能那個 是吧 就像剛才說的 這些小女孩 小演員 小妹 我可以告訴你 比如說大家知道 鸾束唱歌了吧 黑豹的 第一個黑豹樂隊的主唱 其實她的第一個女 鸾束"
    },
    {
      "end": 5264.6,
      "start": 5234.6,
      "text": "黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑豹 黑"
    },
    {
      "end": 5266.08,
      "start": 5264.6,
      "text": "美国的那个女人"
    },
    {
      "end": 5267.0,
      "start": 5266.08,
      "text": "这个孙子就"
    },
    {
      "end": 5269.12,
      "start": 5267.0,
      "text": "这乱书都跟我讲"
    },
    {
      "end": 5269.6,
      "start": 5269.12,
      "text": "他说"
    },
    {
      "end": 5270.54,
      "start": 5269.6,
      "text": "哎这个呢"
    },
    {
      "end": 5272.3,
      "start": 5270.54,
      "text": "我就不好意思跟你讲"
    },
    {
      "end": 5273.1,
      "start": 5272.3,
      "text": "就那个傻子"
    },
    {
      "end": 5273.8,
      "start": 5273.1,
      "text": "这么白领"
    },
    {
      "end": 5274.44,
      "start": 5273.8,
      "text": "什么什么"
    },
    {
      "end": 5275.7,
      "start": 5274.44,
      "text": "是我第一个女朋友"
    },
    {
      "end": 5276.56,
      "start": 5275.7,
      "text": "他嫌人家"
    },
    {
      "end": 5278.56,
      "start": 5276.56,
      "text": "当时在美国也是偷东西啊"
    },
    {
      "end": 5278.98,
      "start": 5278.56,
      "text": "被人抓"
    },
    {
      "end": 5280.24,
      "start": 5278.98,
      "text": "包括磕药啊"
    },
    {
      "end": 5281.92,
      "start": 5280.24,
      "text": "但是这个孙子"
    },
    {
      "end": 5283.3,
      "start": 5281.92,
      "text": "从来没有真正想"
    },
    {
      "end": 5285.22,
      "start": 5283.3,
      "text": "人家小女孩那么早跟了你"
    },
    {
      "end": 5285.56,
      "start": 5285.22,
      "text": "对吧"
    },
    {
      "end": 5286.0,
      "start": 5285.56,
      "text": "哦"
    },
    {
      "end": 5287.36,
      "start": 5286.0,
      "text": "你就感觉别人是"
    },
    {
      "end": 5287.7,
      "start": 5287.36,
      "text": "哇"
    },
    {
      "end": 5289.06,
      "start": 5287.7,
      "text": "他怎么会不好的"
    },
    {
      "end": 5292.94,
      "start": 5289.06,
      "text": "他是应该是一个文工团的"
    },
    {
      "end": 5294.46,
      "start": 5292.94,
      "text": "一个舞蹈演员"
    },
    {
      "end": 5298.22,
      "start": 5294.6,
      "text": "肯定从小也被别人曾经性侵略"
    },
    {
      "end": 5299.3,
      "start": 5298.22,
      "text": "啊"
    },
    {
      "end": 5301.2,
      "start": 5299.3,
      "text": "后来找了蓝树"
    },
    {
      "end": 5302.22,
      "start": 5301.2,
      "text": "啊"
    },
    {
      "end": 5304.2,
      "start": 5302.22,
      "text": "后来蓝树又跟人吹了"
    },
    {
      "end": 5305.12,
      "start": 5304.2,
      "text": "找他王飞"
    },
    {
      "end": 5307.08,
      "start": 5305.12,
      "text": "王飞就把他登了"
    },
    {
      "end": 5307.94,
      "start": 5307.08,
      "text": "一个乐队里"
    },
    {
      "end": 5308.96,
      "start": 5307.94,
      "text": "把他登了"
    },
    {
      "end": 5310.12,
      "start": 5308.96,
      "text": "找他斗尾"
    },
    {
      "end": 5311.26,
      "start": 5310.12,
      "text": "啊"
    },
    {
      "end": 5314.18,
      "start": 5311.26,
      "text": "这个东西都是他们最后"
    },
    {
      "end": 5316.4,
      "start": 5314.18,
      "text": "你们在中共的体制内"
    },
    {
      "end": 5317.82,
      "start": 5316.4,
      "text": "你们不尊重人"
    },
    {
      "end": 5318.38,
      "start": 5317.82,
      "text": "对吧"
    },
    {
      "end": 5320.14,
      "start": 5318.38,
      "text": "以为自己没问题"
    },
    {
      "end": 5320.74,
      "start": 5320.14,
      "text": "啊"
    },
    {
      "end": 5322.26,
      "start": 5320.74,
      "text": "是找到更好的"
    },
    {
      "end": 5323.38,
      "start": 5322.26,
      "text": "不负责任"
    },
    {
      "end": 5323.88,
      "start": 5323.38,
      "text": "啊"
    },
    {
      "end": 5325.38,
      "start": 5323.88,
      "text": "那个最后的结果"
    },
    {
      "end": 5327.92,
      "start": 5325.38,
      "text": "最后都会反射在你的身上"
    },
    {
      "end": 5329.18,
      "start": 5327.92,
      "text": "啊"
    },
    {
      "end": 5330.98,
      "start": 5329.18,
      "text": "这太多太多了"
    },
    {
      "end": 5332.16,
      "start": 5330.98,
      "text": "包括这些你们"
    },
    {
      "end": 5334.52,
      "start": 5332.16,
      "text": "看见在灌面堂皇的"
    },
    {
      "end": 5335.76,
      "start": 5334.52,
      "text": "在中央电视台"
    },
    {
      "end": 5337.44,
      "start": 5335.76,
      "text": "在所谓的国家的什么"
    },
    {
      "end": 5339.08,
      "start": 5337.44,
      "text": "哪个部位上"
    },
    {
      "end": 5340.72,
      "start": 5339.08,
      "text": "什么国家队的主教练"
    },
    {
      "end": 5341.78,
      "start": 5340.72,
      "text": "什么这个这个这个"
    },
    {
      "end": 5343.92,
      "start": 5341.78,
      "text": "这个中央电视台主持人"
    },
    {
      "end": 5345.06,
      "start": 5343.92,
      "text": "再讲一个啊"
    },
    {
      "end": 5346.06,
      "start": 5345.06,
      "text": "你们这个这个"
    },
    {
      "end": 5348.04,
      "start": 5346.06,
      "text": "这帮孙子知道"
    },
    {
      "end": 5350.06,
      "start": 5348.04,
      "text": "曾经打网球的"
    },
    {
      "end": 5350.6,
      "start": 5350.06,
      "text": "对吧"
    },
    {
      "end": 5351.9,
      "start": 5350.6,
      "text": "这个"
    },
    {
      "end": 5355.02,
      "start": 5351.9,
      "text": "都知道有一个叫许阳的"
    },
    {
      "end": 5355.86,
      "start": 5355.02,
      "text": "他不是许阳"
    },
    {
      "end": 5357.5,
      "start": 5355.86,
      "text": "不是踢足球的许阳"
    },
    {
      "end": 5359.0,
      "start": 5357.5,
      "text": "就是打网球"
    },
    {
      "end": 5361.7,
      "start": 5359.0,
      "text": "就是网球的中央电视台"
    },
    {
      "end": 5362.86,
      "start": 5361.7,
      "text": "经常解说"
    },
    {
      "end": 5363.26,
      "start": 5362.86,
      "text": "啊"
    },
    {
      "end": 5364.1,
      "start": 5363.26,
      "text": "他就在上面这个"
    },
    {
      "end": 5365.52,
      "start": 5364.1,
      "text": "这个这个这个这个人啊"
    },
    {
      "end": 5367.28,
      "start": 5365.52,
      "text": "这个叫许阳"
    },
    {
      "end": 5368.52,
      "start": 5367.28,
      "text": "言无许啊"
    },
    {
      "end": 5369.6,
      "start": 5368.52,
      "text": "不是单"
    },
    {
      "end": 5370.74,
      "start": 5369.6,
      "text": "双利而许啊"
    },
    {
      "end": 5371.6,
      "start": 5370.74,
      "text": "言无许阳"
    },
    {
      "end": 5372.78,
      "start": 5371.6,
      "text": "这个孙子"
    },
    {
      "end": 5373.7,
      "start": 5372.78,
      "text": "你说他"
    },
    {
      "end": 5374.72,
      "start": 5373.7,
      "text": "啊都跟周杨"
    },
    {
      "end": 5376.74,
      "start": 5374.72,
      "text": "他都利用网球"
    },
    {
      "end": 5378.04,
      "start": 5376.74,
      "text": "干了很多事"
    },
    {
      "end": 5379.7,
      "start": 5378.04,
      "text": "但是他断面仓皇的"
    },
    {
      "end": 5381.74,
      "start": 5379.7,
      "text": "在那儿站着位置的时候"
    },
    {
      "end": 5383.04,
      "start": 5381.74,
      "text": "那说的好听着呢"
    },
    {
      "end": 5384.84,
      "start": 5383.04,
      "text": "我来去灭共的时候"
    },
    {
      "end": 5385.88,
      "start": 5384.84,
      "text": "那他跟我讲的"
    },
    {
      "end": 5387.04,
      "start": 5385.88,
      "text": "一套一套的跟我讲"
    },
    {
      "end": 5387.56,
      "start": 5387.04,
      "text": "啊海东"
    },
    {
      "end": 5388.7,
