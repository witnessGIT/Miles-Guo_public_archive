{
  "chunk_audio_sha256": "0160d1c20f8da6533f461fb1e1d6192d0c8e28dbe8e45f5fc9653d401cfcc0b0",
  "chunk_index": 16,
  "completed_at": "2026-10-20T12:50:31Z",
  "language": "zh",
  "live_id": "LIVE_20210106_002",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
