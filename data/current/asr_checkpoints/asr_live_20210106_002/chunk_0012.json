{
  "chunk_audio_sha256": "1ec87359e81dbf6dc358734691523fca97a8a4d443c5fe5a6128116c28a6b48b",
  "chunk_index": 12,
  "completed_at": "2026-10-20T12:41:18Z",
  "language": "zh",
  "live_id": "LIVE_20210106_002",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 10800,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 10803.72,
      "start": 10800.0,
      "text": "包括耶稣 新约 人能平等等 博爱"
    },
    {
      "end": 10807.6,
      "start": 10803.72,
      "text": "但是你如何把这个东西变成实实在在"
    },
    {
      "end": 10812.42,
      "start": 10807.6,
      "text": "你生活中所有的体系只有基督做到了"
    },
    {
      "end": 10815.18,
      "start": 10812.42,
      "text": "只有天主教 基督的命"
    },
    {
      "end": 10818.56,
      "start": 10815.18,
      "text": "伊斯兰教当时阿拉伯帝国多牛 多强大"
    },
    {
      "end": 10821.44,
      "start": 10818.56,
      "text": "蒙古铁骑多牛 打到罗马帝国"
    },
    {
      "end": 10823.96,
      "start": 10821.44,
      "text": "把日耳曼人都打成啥样"
    },
    {
      "end": 10827.5,
      "start": 10823.96,
      "text": "但是蒙古人走到一个地方 图尘"
    },
    {
      "end": 10830.3,
      "start": 10827.5,
      "text": "图完尘以后不要了 这个尘一个人都不管"
    },
    {
      "end": 10831.9,
      "start": 10830.3,
      "text": "就往前面继续打"
    },
    {
      "end": 10834.94,
      "start": 10831.9,
      "text": "但是他打完以后 最终"
    },
    {
      "end": 10839.72,
      "start": 10834.94,
      "text": "罗马教宗就派一个人说你归顺我"
    },
    {
      "end": 10842.28,
      "start": 10839.72,
      "text": "归顺 我就可以那个"
    },
    {
      "end": 10845.92,
      "start": 10842.28,
      "text": "但是蒙古帝国他没有归顺 他们不知道这个概念"
    },
    {
      "end": 10849.06,
      "start": 10845.92,
      "text": "他觉得我这根本就不需要体系"
    },
    {
      "end": 10851.32,
      "start": 10849.06,
      "text": "我只要能抢下来就行了"
    },
    {
      "end": 10854.66,
      "start": 10851.32,
      "text": "但是最核心的 中国也是"
    },
    {
      "end": 10861.36,
      "start": 10854.66,
      "text": "我今天做节目也说中国只有孔子当时建立了一个叫做士大夫的体系"
    },
    {
      "end": 10864.2,
      "start": 10861.36,
      "text": "你得考45经 实际上就是一个认证体系"
    },
    {
      "end": 10868.68,
      "start": 10864.2,
      "text": "你过了这个45经的考试 你就是可以当官"
    },
    {
      "end": 10873.32,
      "start": 10868.68,
      "text": "但是并没有一个私有财产的一个整个的法律体系"
    },
    {
      "end": 10878.82,
      "start": 10873.32,
      "text": "我节目也说了 你说私有财产只有基督文明这个"
    },
    {
      "end": 10883.76,
      "start": 10878.82,
      "text": "你像欧洲这些国家 几十个国家来回混战的时候"
    },
    {
      "end": 10889.84,
      "start": 10883.76,
      "text": "你个人的财产 你在法国 巴黎 老佛爷那条街上的一栋楼的时候"
    },
    {
      "end": 10893.2,
      "start": 10889.84,
      "text": "你找谁要 比如说 拉破仑当皇帝的时候"
    },
    {
      "end": 10897.54,
      "start": 10893.2,
      "text": "和这个罗伯斯比尔当那个执政官的时候"
    },
    {
      "end": 10902.14,
      "start": 10897.54,
      "text": "共和国又是法兰西第一帝国 第二帝国 第三帝国的时候"
    },
    {
      "end": 10904.74,
      "start": 10902.14,
      "text": "按照中国是改朝换代"
    },
    {
      "end": 10909.12,
      "start": 10904.74,
      "text": "姓朱的来当皇帝的时候 那你元朝的全部认"
    },
    {
      "end": 10913.72,
      "start": 10909.12,
      "text": "这个大清国来的时候 你明朝的东西又不认"
    },
    {
      "end": 10918.8,
      "start": 10913.72,
      "text": "但是欧美 你像有些教堂是一千年 八百年了"
    },
    {
      "end": 10922.06,
      "start": 10918.8,
      "text": "你像那个德国最知名的教堂八百年"
    },
    {
      "end": 10925.64,
      "start": 10922.06,
      "text": "八百年德国从普鲁士到后面 是吧"
    },
    {
      "end": 10930.24,
      "start": 10925.64,
      "text": "普鲁士后面是什么 这个德意志 是吧 帝国到德意志"
    },
    {
      "end": 10934.08,
      "start": 10930.24,
      "text": "到德意志 这个第三帝国 就是纳粹那时候"
    },
    {
      "end": 10937.84,
      "start": 10934.08,
      "text": "到现在德国的共和国 换了多少政权"
    },
    {
      "end": 10942.58,
      "start": 10937.84,
      "text": "但是你这个资产归谁 他这个体系不变"
    },
    {
      "end": 10946.24,
      "start": 10942.58,
      "text": "基督文明是建立着这个 你想想啊"
    },
    {
      "end": 10949.78,
      "start": 10946.24,
      "text": "全世界再有钱的人 刚才文贵先生说的太对了"
    },
    {
      "end": 10953.22,
      "start": 10949.78,
      "text": "你这个世界上 你再牛的人"
    },
    {
      "end": 10958.7,
      "start": 10953.22,
      "text": "普通人根本没这个概念 资产过个五十亿 一百亿美金啊"
    },
    {
      "end": 10963.46,
      "start": 10958.7,
      "text": "名望到了 他一定第一时间跑到梵蒂冈去找教宗"
    },
    {
      "end": 10966.2,
      "start": 10963.46,
      "text": "是不是 几点嘛 第一"
    },
    {
      "end": 10970.0,
      "start": 10966.2,
      "text": "你 如果教宗看不上你 一句话"
    },
    {
      "end": 10973.44,
      "start": 10970.0,
      "text": "这个人是邪恶的 那完了 你这个企业也就结束了"
    },
    {
      "end": 10975.0,
      "start": 10973.44,
      "text": "只要一句话就行了"
    },
    {
      "end": 10978.78,
      "start": 10975.0,
      "text": "第二 他一定要让你建功立业"
    },
    {
      "end": 10981.78,
      "start": 10978.78,
      "text": "你要得到他给你一个封号 那就不得了了"
    },
    {
      "end": 10986.72,
      "start": 10981.78,
      "text": "比如说圣 圣女贞德 前面加上圣子"
    },
    {
      "end": 10993.96,
      "start": 10986.72,
      "text": "那你就等于说 你这世世代代 你都是免税 然后并且可以上天堂 还可以"
    },
    {
      "end": 10999.9,
      "start": 10993.96,
      "text": "是不是啊 这个家族你可以延续下去 别人追求的这个 他建立这个体系是很厉害的"
    },
    {
      "end": 11005.7,
      "start": 10999.9,
      "text": "中国到现在几千年 就没有 为什么私有财产从来没有保护"
    },
    {
      "end": 11009.7,
      "start": 11005.7,
      "text": "这中共他说 我们历朝历代就没有保护过私有财产"
    },
    {
      "end": 11015.54,
      "start": 11009.7,
      "text": "因为帅土之兵 莫非王土 是不是 你所有的东西都是属于我的"
    },
    {
      "end": 11024.34,
      "start": 11015.54,
      "text": "所以你就没有这个体系 你就不可能吸引最优秀的人 不可能吸引最有聪明的人"
    },
    {
      "end": 11031.84,
      "start": 11024.34,
      "text": "也就不可能吸引所有的财富 你这个 你这个 这片江土 他就建在空中楼阁"
    },
    {
      "end": 11037.34,
      "start": 11031.84,
      "text": "随时坍塌 随时坍塌 是不是 像刚才文贵先生说的 你像这个"
    },
    {
      "end": 11044.64,
      "start": 11037.34,
      "text": "樊地刚叫停的两千年 他的信誉的保证 是不是 你像这个YouTube 或者是什么"
    },
    {
      "end": 11051.74,
      "start": 11044.64,
      "text": "他建立的就是一个生态圈 但别人的生态圈是两千年了 你这生态圈最多十年二十年"
    },
    {
      "end": 11057.54,
      "start": 11051.74,
      "text": "我们之前啊 我们做生意 就是这样 你去投一个标 别人首先看"
    },
    {
      "end": 11063.54,
      "start": 11057.54,
      "text": "你这公司注册资金多少 你如果你是一个亿的标 你去拿这个工程"
    },
    {
      "end": 11066.34,
      "start": 11063.54,
      "text": "你的注册资金才一千万 别人不可能给你"
    },
    {
      "end": 11071.84,
      "start": 11066.34,
      "text": "美国 我们之前啊 我一个朋友 我一个同学 他就在IBM"
    },
    {
      "end": 11077.14,
      "start": 11071.84,
      "text": "他就是给什么 给麦当劳做全球服务的"
    },
    {
      "end": 11084.34,
      "start": 11077.14,
      "text": "我说 为什么IBM做 因为全世界只有IBM可以给他做担保"
    },
    {
      "end": 11090.34,
      "start": 11084.34,
      "text": "如果你这个服务做错了 做烂了 你这个几千亿资产 谁赔得起"
    },
    {
      "end": 11093.84,
      "start": 11090.34,
      "text": "IBM赔得起 没有任何一家公司赔得起"
    },
    {
      "end": 11100.34,
      "start": 11093.84,
      "text": "一样的 你想 如果一个人的资产过万亿 过几万亿 谁可以给他担保"
    },
    {
      "end": 11106.64,
      "start": 11100.34,
      "text": "只有罗马教廷 他减讯了两千多年 随便第五大道 那个大教堂"
    },
    {
      "end": 11112.34,
      "start": 11106.64,
      "text": "估计都至少几十亿美金 是不是啊 都属于他们的资产"
    },
    {
      "end": 11118.34,
      "start": 11112.34,
      "text": "谁可以给那些有钱的做担保 你别说 很多人说 几十亿算上"
    },
    {
      "end": 11123.84,
      "start": 11118.34,
      "text": "你想 我们首先想银行 银行后面的银行有再担保银行"
    },
    {
      "end": 11128.34,
      "start": 11123.84,
      "text": "再担保银行后面还有一个再再担保 再再担保"
    },
    {
      "end": 11133.84,
      "start": 11128.34,
      "text": "后面是谁 你去想 你想是谁 别人只能相信一个两千年的"
    },
    {
      "end": 11138.34,
      "start": 11133.84,
      "text": "一个这样背景的 延续下来有诚信的一个这样的组织"
    },
    {
      "end": 11141.34,
      "start": 11138.34,
      "text": "给你来担保 这就是这个体系"
    },
    {
      "end": 11145.34,
      "start": 11141.34,
      "text": "没有这个 我告诉你 中国人永远不可能"
    },
    {
      "end": 11148.84,
      "start": 11145.34,
      "text": "永远 我告诉你 你不可能有真正的文明"
    },
    {
      "end": 11151.84,
      "start": 11148.84,
      "text": "也不可能永远有知识产权的真正保护"
    },
    {
      "end": 11154.84,
      "start": 11151.84,
      "text": "也不可能有私有产权的真正保护"
    },
    {
      "end": 11158.84,
      "start": 11154.84,
      "text": "因为你最终 保护来 比如说咱们这个地气 中国的地气"
    },
    {
      "end": 11161.84,
      "start": 11158.84,
      "text": "或者说 现在是政府给你担保 政府"
    },
    {
      "end": 11165.84,
      "start": 11161.84,
      "text": "那政府这个倒了怎么办 找谁去啊"
    },
    {
      "end": 11169.84,
      "start": 11165.84,
      "text": "或者说 就是中华民国 那中华民国给你开的"
    },
    {
      "end": 11173.84,
      "start": 11169.84,
      "text": "这个叫做房产证 中华人民共和国不承认"
    },
    {
      "end": 11176.84,
      "start": 11173.84,
      "text": "它属于这样的一个地步 所以说"
    },
    {
      "end": 11180.84,
      "start": 11176.84,
      "text": "中国这几千年为什么在人类历史上"
    },
    {
      "end": 11185.84,
      "start": 11180.84,
      "text": "没有什么建树 没有政治文明 没有各种科技文明"
    },
    {
      "end": 11189.84,
      "start": 11185.84,
      "text": "最核心的就是这一点 根本就没有建立起这个体系"
    },
    {
      "end": 11191.84,
      "start": 11189.84,
      "text": "郭先生"
    },
    {
      "end": 11193.84,
      "start": 11191.84,
      "text": "好的 谢谢"
    },
    {
      "end": 11196.84,
      "start": 11193.84,
      "text": "路德先生 谢谢文科 我还有路德先生补充一下"
    },
    {
      "end": 11202.84,
      "start": 11196.84,
      "text": "很多战友说 路德先生讲教宗没有免去人罪的"
    },
    {
      "end": 11205.84,
      "start": 11202.84,
      "text": "这个理解是错的 大家都想当然"
    },
    {
      "end": 11209.84,
      "start": 11205.84,
      "text": "拿着你的认知来看待这个事情"
    },
    {
      "end": 11212.84,
      "start": 11209.84,
      "text": "这个人类上被豁免罪的不是说法律"
    },
    {
      "end": 11215.84,
      "start": 11212.84,
      "text": "就你认为就是法律 共产党那个县长"
    },
    {
      "end": 11219.84,
      "start": 11215.84,
      "text": "免了你罪了 管佑 人类最大的免是你自己的心"
    },
    {
      "end": 11223.84,
      "start": 11219.84,
      "text": "所有在教廷面前 或者在牧师面前"
    },
    {
      "end": 11225.84,
      "start": 11223.84,
      "text": "你心里面真的说 你就没罪了"
    },
    {
      "end": 11229.84,
      "start": 11225.84,
      "text": "你的罪已经我给你免了 我给你赦免了"
    },
    {
      "end": 11232.84,
      "start": 11229.84,
      "text": "你没有任何了 你干过什么事儿"
    },
    {
      "end": 11235.84,
      "start": 11232.84,
      "text": "比如说 我跟这个某某牧师谈的时候"
    },
    {
      "end": 11237.84,
      "start": 11235.84,
      "text": "什么跟他自己的亲姐姐发生性关系"
    },
    {
      "end": 11240.84,
      "start": 11237.84,
      "text": "他一直纠结不了 然后呢最后他就给牧师说了"
    },
    {
      "end": 11242.84,
      "start": 11240.84,
      "text": "他说 你跟我亲姐姐发生关系"
    },
    {
      "end": 11245.84,
      "start": 11242.84,
      "text": "而且从小很多年 然后这个罪"
    },
    {
      "end": 11248.84,
      "start": 11245.84,
      "text": "这个牧师说过来 照着脸啪啪啪两下子"
    },
    {
      "end": 11253.84,
      "start": 11248.84,
      "text": "照眼睛啪一根 再说一遍 再说一遍 多少次"
    },
    {
      "end": 11258.84,
      "start": 11253.84,
      "text": "什么要除罪 再说 大声说 说完以后啪啪啪几下"
    },
    {
      "end": 11260.84,
      "start": 11258.84,
      "text": "他就没见过这麽事儿 盖着头"
    },
    {
      "end": 11262.84,
      "start": 11260.84,
      "text": "你的罪已经没了 我全给你拿走了"
    },
    {
      "end": 11265.84,
      "start": 11262.84,
      "text": "从现在起来 你不能再提了 忘掉了"
    },
    {
      "end": 11267.84,
      "start": 11265.84,
      "text": "因为你是被什么什么魔给亲了"
    },
    {
      "end": 11270.84,
      "start": 11267.84,
      "text": "就是过去了 而且你的姐姐替你也除了魔"
    },
    {
      "end": 11273.84,
      "start": 11270.84,
      "text": "你们会幸福的 这哥们就不是一样了"
    },
    {
      "end": 11277.84,
      "start": 11273.84,
      "text": "这人就变了 最大的这种赎罪啊"
    },
    {
      "end": 11281.84,
      "start": 11277.84,
      "text": "免罪也是在这儿的 说这个认知有多重要"
    },
    {
      "end": 11285.84,
      "start": 11281.84,
      "text": "一说你就想着什么某某县 某某厂法官给你免罪才算对"
    },
    {
      "end": 11287.84,
      "start": 11285.84,
      "text": "说这种认知这很可怕"
    },
    {
      "end": 11292.84,
      "start": 11287.84,
      "text": "人心中的自己都有秘密 或者说都有自己的原队"
    },
    {
      "end": 11295.84,
      "start": 11292.84,
      "text": "你怎么把这拿掉 就像我们有爆料革命的修联"
    },
    {
      "end": 11299.84,
      "start": 11295.84,
      "text": "就像七哥 七哥过去经历有太多太多原队了"
    },
    {
      "end": 11303.84,
      "start": 11299.84,
      "text": "我怎么拿掉 我真的没想起哪个法官都把我罪过免了"
    },
    {
      "end": 11310.84,
      "start": 11303.84,
      "text": "我就是现在对战友好 灭共 然后改变我自己的缺点"
    },
    {
      "end": 11317.84,
      "start": 11310.84,
      "text": "灭掉我身上的缺漏 多做力他 减少贪嗔吃饭"
    },
    {
      "end": 11320.84,
      "start": 11317.84,
      "text": "我这就是我在捡我自己的罪啊"
    },
    {
      "end": 11324.84,
      "start": 11320.84,
      "text": "所以说很多人在听爆料 你是听热闹还是在听爆料"
    },
    {
      "end": 11327.84,
      "start": 11324.84,
      "text": "你要听明白了这叫爆料 你听不明白纯叫热闹"
    },
    {
      "end": 11330.84,
      "start": 11327.84,
      "text": "热闹叫胡闹 浪费生命你知道吗"
    },
    {
      "end": 11332.84,
      "start": 11330.84,
      "text": "谢谢文科 谢谢陆伯姐 太好了"
    },
    {
      "end": 11333.84,
      "start": 11332.84,
      "text": "谢谢"
    },
    {
      "end": 11342.84,
      "start": 11333.84,
      "text": "所以说我们信仰之心 咱们的国企设计的时候也是有咱们信仰之心"
    },
    {
      "end": 11347.84,
      "start": 11342.84,
      "text": "所以说我们感觉我们新中国联邦 听着陆伯器还有郭先生说的"
    },
    {
      "end": 11354.84,
      "start": 11347.84,
      "text": "就是我们转移到我们这个新中国联邦也是我们历史的必来"
    },
    {
      "end": 11356.84,
      "start": 11354.84,
      "text": "好 谢谢 时间交给下一位战友"
    },
    {
      "end": 11360.84,
      "start": 11356.84,
      "text": "谢谢文科"
    },
    {
      "end": 11363.84,
      "start": 11360.84,
      "text": "文科 您刚才说的你没说 你再说一下"
    },
    {
      "end": 11370.84,
      "start": 11363.84,
      "text": "文科 您要知道能到教廷去赦免的是什么人"
    },
    {
      "end": 11375.84,
      "start": 11370.84,
      "text": "那都是这个地球里数得上的人 是不是郭先生"
    },
    {
      "end": 11379.84,
      "start": 11375.84,
      "text": "你想他的财产他绝对可以让总统给他赦免"
    },
    {
      "end": 11384.84,
      "start": 11379.84,
      "text": "他的影响力是可以让甚至法律在法律之外的"
    },
    {
      "end": 11392.84,
      "start": 11384.84,
      "text": "但他心里的东西永远他赦免不了 最终他就只需要一个地方给你赦免"
    },
    {
      "end": 11396.84,
      "start": 11392.84,
      "text": "是不是 那只有在那些地方 所以说很多人他不明白"
    },
    {
      "end": 11401.84,
      "start": 11396.84,
      "text": "他以为说 啊这个当然了 特别是有些地方他是通过了法律"
    },
    {
      "end": 11405.84,
      "start": 11401.84,
      "text": "你比较南美洲有些地方 因为他们是天主教的国家"
    },
    {
      "end": 11407.84,
      "start": 11405.84,
      "text": "有些天主教的国家 通过了法律"
    },
    {
      "end": 11411.84,
      "start": 11407.84,
      "text": "就是说你得到什么大主教什么什么或者是教宗的赦免"
    },
    {
      "end": 11415.84,
      "start": 11411.84,
      "text": "你就可以胜美 就一样的权力 跟总统胜美权一样"
    },
    {
      "end": 11420.84,
      "start": 11415.84,
      "text": "但是毕竟美国他不是一个这样的国家 因为美国他不是一个天主教国家"
    },
    {
      "end": 11427.84,
      "start": 11420.84,
      "text": "所以呢 美国没有这个权力 但是南美洲很多都这样 包括欧洲有一些"
    },
    {
      "end": 11433.84,
      "start": 11429.84,
      "text": "对 对 对 太棒了 太棒了 百分之百分之"
    },
    {
      "end": 11437.84,
      "start": 11433.84,
      "text": "soaked up"
    },
    {
      "end": 11442.84,
      "start": 11437.84,
      "text": "七哥好 路德好 我是舒平峰"
    },
    {
      "end": 11444.84,
      "start": 11442.84,
      "text": "英文名称 Peacewind"
    },
    {
      "end": 11448.84,
      "start": 11444.84,
      "text": "我在小皮江的法国农场和木兰的秘密翻译组"
    },
    {
      "end": 11451.34,
      "start": 11448.84,
      "text": "在今天這個歷史時刻"
    },
    {
      "end": 11454.14,
      "start": 11451.34,
      "text": "能和七哥和路德對上直接對話"
    },
    {
      "end": 11456.34,
      "start": 11454.14,
      "text": "感到非常非常幸運"
    },
    {
      "end": 11459.14,
      "start": 11456.34,
      "text": "首先我藉此機會"
    },
    {
      "end": 11460.64,
      "start": 11459.14,
      "text": "首先想感恩七哥"
    },
    {
      "end": 11464.64,
      "start": 11460.64,
      "text": "謝謝七哥開創和引領了"
    },
    {
      "end": 11467.64,
      "start": 11464.64,
      "text": "這個滅掉共產黨的偉大事業"
    },
    {
      "end": 11469.14,
      "start": 11467.64,
      "text": "謝謝"
    },
    {
      "end": 11472.64,
      "start": 11469.14,
      "text": "另外我想謝謝路德"
    },
    {
      "end": 11475.84,
      "start": 11472.64,
      "text": "路德每天給我們提供兩個直播節目"
    },
    {
      "end": 11480.64,
      "start": 11475.84,
      "text": "讓我們能夠站在未來看歷史"
    },
    {
      "end": 11482.54,
      "start": 11480.64,
      "text": "非常感謝"
    },
    {
      "end": 11484.64,
      "start": 11482.54,
      "text": "最後我想感謝木蘭"
    },
    {
      "end": 11486.34,
      "start": 11484.64,
      "text": "因為木蘭 感恩木蘭"
    },
    {
      "end": 11488.84,
      "start": 11486.34,
      "text": "木蘭把我介紹給了七哥 謝謝"
    },
    {
      "end": 11491.64,
      "start": 11488.84,
      "text": "走路正題"
    },
    {
      "end": 11493.64,
      "start": 11491.64,
      "text": "剛才兩個小時前"
    },
    {
      "end": 11497.14,
      "start": 11493.64,
      "text": "郝海東先生提出了邏輯思維的重要性"
    },
    {
      "end": 11499.64,
      "start": 11497.14,
      "text": "在13天大戰時"
    },
    {
      "end": 11503.84,
      "start": 11499.64,
      "text": "我在GTV做了七八個邏輯分析的節目"
    },
    {
      "end": 11508.64,
      "start": 11503.84,
      "text": "揭露中國共產黨顛倒邏輯的種種欺騙"
    },
    {
      "end": 11510.64,
      "start": 11508.64,
      "text": "今天想和七哥路德"
    },
    {
      "end": 11512.64,
      "start": 11510.64,
      "text": "以及將你們分享一些"
    },
    {
      "end": 11515.64,
      "start": 11512.64,
      "text": "我對這次人類終極之戰"
    },
    {
      "end": 11519.64,
      "start": 11515.64,
      "text": "也是說大洗牌的邏輯分析"
    },
    {
      "end": 11522.64,
      "start": 11519.64,
      "text": "根據邏輯學的因果律"
    },
    {
      "end": 11524.14,
      "start": 11522.64,
      "text": "任何事物"
    },
    {
      "end": 11526.64,
      "start": 11524.14,
      "text": "都由其存在的充足理由"
    },
    {
      "end": 11531.44,
      "start": 11526.64,
      "text": "我想從天時地理與人和這三個方面"
    },
    {
      "end": 11533.44,
      "start": 11531.44,
      "text": "講講"
    },
    {
      "end": 11538.44,
      "start": 11533.44,
      "text": "就是川普的正義力量必贏的幾個理由"
    },
    {
      "end": 11540.44,
      "start": 11538.44,
      "text": "首先是天時"
    },
    {
      "end": 11545.44,
      "start": 11540.44,
      "text": "七哥在2017年初開啟了爆料革命"
    },
    {
      "end": 11546.44,
      "start": 11545.44,
      "text": "這個爆料革命"
    },
    {
      "end": 11550.44,
      "start": 11546.44,
      "text": "慢慢地喚醒了美國和中國國內的良知"
    },
    {
      "end": 11556.24,
      "start": 11550.44,
      "text": "是由良知的美國來認識到了中國的極端邪惡的本質"
    },
    {
      "end": 11559.24,
      "start": 11556.24,
      "text": "國內的戰友們給七哥提供了"
    },
    {
      "end": 11563.24,
      "start": 11559.24,
      "text": "中共極端邪惡的種種作惡的一系列證據"
    },
    {
      "end": 11566.24,
      "start": 11563.24,
      "text": "其中有病毒生物武器"
    },
    {
      "end": 11576.04,
      "start": 11566.24,
      "text": "當然也有這次策劃參與大選務必的確實確鑿證據"
    },
    {
      "end": 11580.04,
      "start": 11576.04,
      "text": "七哥基於國內戰友們的準確情報"
    },
    {
      "end": 11585.04,
      "start": 11580.04,
      "text": "在去年11月7號便預言了大選的進程"
    },
    {
      "end": 11586.04,
      "start": 11585.04,
      "text": "七哥當時說"
    },
    {
      "end": 11589.04,
      "start": 11586.04,
      "text": "一定要看參眾兩院"
    },
    {
      "end": 11591.04,
      "start": 11589.04,
      "text": "兩個副總統"
    },
    {
      "end": 11593.04,
      "start": 11591.04,
      "text": "要到最後一分鐘"
    },
    {
      "end": 11595.04,
      "start": 11593.04,
      "text": "看宣誓的總統是誰"
    },
    {
      "end": 11598.84,
      "start": 11595.04,
      "text": "所以說有了爆料革命"
    },
    {
      "end": 11600.84,
      "start": 11598.84,
      "text": "川普總統必贏"
    },
    {
      "end": 11602.84,
      "start": 11600.84,
      "text": "這是天時"
    },
    {
      "end": 11606.84,
      "start": 11602.84,
      "text": "就是說爆料革命給川普帶來了非常好的時機"
    },
    {
      "end": 11608.84,
      "start": 11606.84,
      "text": "必贏的時機"
    },
    {
      "end": 11610.84,
      "start": 11608.84,
      "text": "其次簡單說一下地理"
    },
    {
      "end": 11613.84,
      "start": 11610.84,
      "text": "我們知道美國是一個神奇的國度"
    },
    {
      "end": 11618.84,
      "start": 11613.84,
      "text": "美國建國的先父們制定了一個"
    },
    {
      "end": 11620.84,
      "start": 11618.84,
      "text": "可以說是世界上最好的憲法"
    },
    {
      "end": 11622.84,
      "start": 11620.84,
      "text": "當然還有重要的一條"
    },
    {
      "end": 11624.64,
      "start": 11622.84,
      "text": "民眾擁有"
    },
    {
      "end": 11626.64,
      "start": 11624.64,
      "text": "有擁圈的權利"
    },
    {
      "end": 11628.64,
      "start": 11626.64,
      "text": "他們可以推翻一個"
    },
    {
      "end": 11631.64,
      "start": 11628.64,
      "text": "違背民意的政府"
    },
    {
      "end": 11633.64,
      "start": 11631.64,
      "text": "當然這個政府是個寡裔政府"
    },
    {
      "end": 11634.64,
      "start": 11633.64,
      "text": "不僅包括行政"
    },
    {
      "end": 11636.64,
      "start": 11634.64,
      "text": "也包括現在說的國會最高法院"
    },
    {
      "end": 11638.64,
      "start": 11636.64,
      "text": "另外呢"
    },
    {
      "end": 11639.44,
      "start": 11638.64,
      "text": "另外呢"
    },
    {
      "end": 11640.44,
      "start": 11639.44,
      "text": "宇夕法尼亞"
    },
    {
      "end": 11641.44,
      "start": 11640.44,
      "text": "威斯康辛"
    },
    {
      "end": 11642.44,
      "start": 11641.44,
      "text": "密西根"
    },
    {
      "end": 11645.24,
      "start": 11642.44,
      "text": "等等這個所謂的搖擺舟的議會呢"
    },
    {
      "end": 11647.24,
      "start": 11645.24,
      "text": "均於共和黨控制"
    },
    {
      "end": 11649.24,
      "start": 11647.24,
      "text": "接著路德的話說"
    },
    {
      "end": 11651.24,
      "start": 11649.24,
      "text": "周欣的財務賬"
    },
    {
      "end": 11653.24,
      "start": 11651.24,
      "text": "和周議會的董事長賬"
    },
    {
      "end": 11654.24,
      "start": 11653.24,
      "text": "缺一不可"
    },
    {
      "end": 11656.24,
      "start": 11654.24,
      "text": "這就為選舉能票的國會論證"
    },
    {
      "end": 11658.24,
      "start": 11656.24,
      "text": "增進了法馬"
    },
    {
      "end": 11661.04,
      "start": 11658.24,
      "text": "這次美加黨將領國會"
    },
    {
      "end": 11662.04,
      "start": 11661.04,
      "text": "創作的條件"
    },
    {
      "end": 11665.04,
      "start": 11662.04,
      "text": "最後我想講"
    },
    {
      "end": 11666.04,
      "start": 11665.04,
      "text": "冷和"
    },
    {
      "end": 11668.04,
      "start": 11666.04,
      "text": "川普總統的身後"
    },
    {
      "end": 11671.04,
      "start": 11668.04,
      "text": "有至少八千萬選民的大力支持"
    },
    {
      "end": 11674.04,
      "start": 11671.04,
      "text": "這也是川普總統的最大實力"
    },
    {
      "end": 11675.04,
      "start": 11674.04,
      "text": "切哥說了"
    },
    {
      "end": 11676.04,
      "start": 11675.04,
      "text": "實力是最重要的"
    },
    {
      "end": 11679.04,
      "start": 11676.04,
      "text": "所以正義的實力是無敵的"
    },
    {
      "end": 11681.04,
      "start": 11679.04,
      "text": "因為這些美國人知道"
    },
    {
      "end": 11684.04,
      "start": 11681.04,
      "text": "他們絕對不願做共產主義的奴隸"
    },
    {
      "end": 11687.84,
      "start": 11684.04,
      "text": "他們要為他們的子孫守護做人的權利"
    },
    {
      "end": 11688.84,
      "start": 11687.84,
      "text": "他們說不起"
    },
    {
      "end": 11691.44,
      "start": 11688.84,
      "text": "否則人類將走路"
    },
    {
      "end": 11693.24,
      "start": 11691.44,
      "text": "中世紀一樣的黑暗"
    },
    {
      "end": 11695.44,
      "start": 11693.24,
      "text": "所以過了革命戰友們"
    },
    {
      "end": 11696.24,
      "start": 11695.44,
      "text": "一直驚信"
    },
    {
      "end": 11697.84,
      "start": 11696.24,
      "text": "川普總統必贏"
    },
    {
      "end": 11700.04,
      "start": 11697.84,
      "text": "現在是美加黨"
