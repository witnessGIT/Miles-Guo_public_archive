{
  "chunk_audio_sha256": "7cb596562113a21891b952cd59257a06d6e95a41d0bb536a901c0f644ee0c6e9",
  "chunk_index": 4,
  "completed_at": "2026-10-20T12:25:27Z",
  "language": "zh",
  "live_id": "LIVE_20210106_002",
  "media_committed_to_git": false,
  "model": "mlx-community/whisper-large-v3-turbo",
  "offset_sec": 3600,
  "paid_api_used": false,
  "processing_location": "github-hosted-macos-arm64",
  "schema_version": "cloud-asr-chunk-v1",
  "segments": [
    {
      "end": 3603.88,
      "start": 3600.0,
      "text": "刚才说到这个宗教什么的"
    },
    {
      "end": 3610.78,
      "start": 3603.88,
      "text": "是我更加认识到这些真正的你要思考的"
    },
    {
      "end": 3615.72,
      "start": 3610.78,
      "text": "那么最大的一个当时科萨诺维奇"
    },
    {
      "end": 3616.82,
      "start": 3615.72,
      "text": "我们2000年"
    },
    {
      "end": 3620.08,
      "start": 3616.82,
      "text": "他是前男的贝尔格莱德红星队的主教练"
    },
    {
      "end": 3625.2,
      "start": 3620.08,
      "text": "当时到了国内是万达"
    },
    {
      "end": 3627.96,
      "start": 3625.2,
      "text": "王建林先把他引进过来"
    },
    {
      "end": 3631.1,
      "start": 3627.96,
      "text": "后来万达又99年了2000年卖"
    },
    {
      "end": 3633.96,
      "start": 3631.1,
      "text": "因为王建林没法在大连带下去了"
    },
    {
      "end": 3635.6,
      "start": 3633.96,
      "text": "他得罪了博西来的"
    },
    {
      "end": 3637.44,
      "start": 3635.6,
      "text": "他又卖给了徐明"
    },
    {
      "end": 3639.1,
      "start": 3637.44,
      "text": "完了以后"
    },
    {
      "end": 3642.34,
      "start": 3639.1,
      "text": "那么他就2000年带着我们"
    },
    {
      "end": 3646.08,
      "start": 3642.34,
      "text": "那么他你想想20多年前"
    },
    {
      "end": 3652.42,
      "start": 3646.08,
      "text": "他都会说出来这些宗教的非常非常深的一些东西"
    },
    {
      "end": 3654.48,
      "start": 3652.42,
      "text": "而且他当时就说了一句话"
    },
    {
      "end": 3657.62,
      "start": 3654.48,
      "text": "不说动宗教包括说"
    },
    {
      "end": 3661.46,
      "start": 3657.62,
      "text": "说梵蒂冈啊他说过最大的洗钱"
    },
    {
      "end": 3667.1,
      "start": 3661.46,
      "text": "这对于我来讲就知道中共怎么来渗透"
    },
    {
      "end": 3671.5,
      "start": 3667.1,
      "text": "怎么来南京华怎么要控制"
    },
    {
      "end": 3673.96,
      "start": 3671.5,
      "text": "梵蒂冈啊教宗啊什么"
    },
    {
      "end": 3677.1,
      "start": 3673.96,
      "text": "就是让我很能清楚"
    },
    {
      "end": 3679.54,
      "start": 3677.1,
      "text": "很早我就能明白很多的事情"
    },
    {
      "end": 3688.18,
      "start": 3679.54,
      "text": "是因为职业化让我能更多的更早的举一反三"
    },
    {
      "end": 3690.92,
      "start": 3688.18,
      "text": "我从计划经济到市场经济"
    },
    {
      "end": 3693.18,
      "start": 3690.92,
      "text": "从专业体制到职业"
    },
    {
      "end": 3696.68,
      "start": 3693.18,
      "text": "那么你刚才说的我像"
    },
    {
      "end": 3702.2,
      "start": 3696.68,
      "text": "像国人像中国人说的一个最重要的"
    },
    {
      "end": 3706.94,
      "start": 3702.2,
      "text": "就是开启民智让他们的思维有逻辑思维能力"
    },
    {
      "end": 3710.84,
      "start": 3706.94,
      "text": "我们没有常识没有逻辑思维能力"
    },
    {
      "end": 3715.72,
      "start": 3710.84,
      "text": "所谓的读书全都是生产线上流水线上的产品"
    },
    {
      "end": 3719.08,
      "start": 3715.72,
      "text": "只告诉你背是吧考多少分"
    },
    {
      "end": 3723.42,
      "start": 3719.08,
      "text": "从来没有一个人要陪伴你成长"
    },
    {
      "end": 3726.1,
      "start": 3723.42,
      "text": "让你发挥聪明才智"
    },
    {
      "end": 3727.78,
      "start": 3726.1,
      "text": "让你有个性"
    },
    {
      "end": 3732.06,
      "start": 3727.78,
      "text": "让你神圣的公民的权利得到"
    },
    {
      "end": 3736.94,
      "start": 3732.2,
      "text": "保障我们从来没有给人任何的环境里面"
    },
    {
      "end": 3738.44,
      "start": 3736.94,
      "text": "有批判精神"
    },
    {
      "end": 3739.28,
      "start": 3738.44,
      "text": "非常可怕"
    },
    {
      "end": 3741.3,
      "start": 3739.28,
      "text": "全部是奴隶"
    },
    {
      "end": 3742.7,
      "start": 3741.3,
      "text": "全部是奴才"
    },
    {
      "end": 3744.18,
      "start": 3742.7,
      "text": "全部是太监"
    },
    {
      "end": 3747.58,
      "start": 3744.18,
      "text": "所以为什么我一直跟郭彦说"
    },
    {
      "end": 3749.42,
      "start": 3747.58,
      "text": "我说因为有了爆料革命"
    },
    {
      "end": 3752.32,
      "start": 3749.42,
      "text": "使我感觉到"
    },
    {
      "end": 3753.78,
      "start": 3752.32,
      "text": "使我在有生之年"
    },
    {
      "end": 3755.02,
      "start": 3753.78,
      "text": "我上海中"
    },
    {
      "end": 3761.92,
      "start": 3755.02,
      "text": "邪恶的独裁的政权共产党说不"
    },
    {
      "end": 3764.56,
      "start": 3761.92,
      "text": "这种机会错过了就不会再有了"
    },
    {
      "end": 3773.5,
      "start": 3764.56,
      "text": "所以我们俩是最深的感触就是我们在这种体制底下受到的所有的这种洗脑"
    },
    {
      "end": 3786.64,
      "start": 3773.5,
      "text": "不想让我的后人不想让我子孙后代足足被列就让我的子孙后代有任何的人受到共产党的这种洗脑虐待"
    },
    {
      "end": 3789.94,
      "start": 3786.64,
      "text": "它跟我们自身的利益没有任何的关系"
    },
    {
      "end": 3794.72,
      "start": 3789.94,
      "text": "我们在国内可以说不缺任何的是吧"
    },
    {
      "end": 3796.78,
      "start": 3794.72,
      "text": "我们不需要表白更多的"
    },
    {
      "end": 3798.56,
      "start": 3796.78,
      "text": "是不是因为我们做到"
    },
    {
      "end": 3802.54,
      "start": 3798.56,
      "text": "我们可以拿回来很多的东西依靠这个体制"
    },
    {
      "end": 3807.6,
      "start": 3802.54,
      "text": "但是这种体制底下绝对让你人性泯灭"
    },
    {
      "end": 3809.14,
      "start": 3807.6,
      "text": "没有自由"
    },
    {
      "end": 3810.38,
      "start": 3809.14,
      "text": "没有尊严"
    },
    {
      "end": 3813.28,
      "start": 3810.38,
      "text": "没有任何让自己感到高兴的"
    },
    {
      "end": 3814.98,
      "start": 3813.28,
      "text": "刚才郭先生说的有希望"
    },
    {
      "end": 3816.68,
      "start": 3814.98,
      "text": "这个东西很可怕"
    },
    {
      "end": 3817.28,
      "start": 3816.68,
      "text": "对吧"
    },
    {
      "end": 3820.28,
      "start": 3817.28,
      "text": "人活一辈子不仅仅是那份钱"
    },
    {
      "end": 3822.96,
      "start": 3820.28,
      "text": "是要尊严和自由的"
    },
    {
      "end": 3823.52,
      "start": 3822.96,
      "text": "是吧"
    },
    {
      "end": 3830.42,
      "start": 3823.52,
      "text": "我想图一笔在墙上的时候我这幅画我一定不是按照你美术学院的教授"
    },
    {
      "end": 3831.2,
      "start": 3830.42,
      "text": "对吧"
    },
    {
      "end": 3833.4,
      "start": 3831.2,
      "text": "谁来说的"
    },
    {
      "end": 3835.5,
      "start": 3833.4,
      "text": "沈从文可能没读过书啊"
    },
    {
      "end": 3836.2,
      "start": 3835.5,
      "text": "是吧"
    },
    {
      "end": 3838.3,
      "start": 3836.2,
      "text": "谁说应该我没记错的话"
    },
    {
      "end": 3838.8,
      "start": 3838.3,
      "text": "对吧"
    },
    {
      "end": 3842.38,
      "start": 3838.8,
      "text": "张大千没有在哪个美术学院他学过"
    },
    {
      "end": 3843.1,
      "start": 3842.38,
      "text": "对吧"
    },
    {
      "end": 3844.38,
      "start": 3843.1,
      "text": "敦煌对吧"
    },
    {
      "end": 3845.88,
      "start": 3844.38,
      "text": "念碧四年那五年"
    },
    {
      "end": 3846.34,
      "start": 3845.88,
      "text": "对吧"
    },
    {
      "end": 3847.88,
      "start": 3846.34,
      "text": "还有百年一大千"
    },
    {
      "end": 3848.42,
      "start": 3847.88,
      "text": "对吧"
    },
    {
      "end": 3849.58,
      "start": 3848.42,
      "text": "那是学出来的吗"
    },
    {
      "end": 3851.74,
      "start": 3849.58,
      "text": "那不可能在课堂里学出来"
    },
    {
      "end": 3858.64,
      "start": 3851.74,
      "text": "所以我们要向所有的中国人要说出来就是你们要有常识"
    },
    {
      "end": 3860.32,
      "start": 3858.64,
      "text": "要有逻辑思维能力"
    },
    {
      "end": 3862.76,
      "start": 3860.32,
      "text": "而且刚才郭先生说了嘛"
    },
    {
      "end": 3864.42,
      "start": 3862.76,
      "text": "中共不代表中国"
    },
    {
      "end": 3866.56,
      "start": 3864.42,
      "text": "中国共产党这些也不代表中国人"
    },
    {
      "end": 3869.7,
      "start": 3866.56,
      "text": "而且我们不要老被他们绑架洗脑"
    },
    {
      "end": 3872.9,
      "start": 3869.7,
      "text": "说是你不是什么你要反对的"
    },
    {
      "end": 3879.8,
      "start": 3872.9,
      "text": "你不是中国人我好像我说中国人就是中华人民共和国的人似的胡说八道对吧"
    },
    {
      "end": 3881.48,
      "start": 3879.8,
      "text": "那中华民国是不是"
    },
    {
      "end": 3885.44,
      "start": 3881.48,
      "text": "那他清朝的人是不是中国人对吧"
    },
    {
      "end": 3888.34,
      "start": 3885.44,
      "text": "我们都是中国人都叫华夏民族"
    },
    {
      "end": 3891.98,
      "start": 3888.34,
      "text": "不是你共产党治下的人就叫中国人"
    },
    {
      "end": 3892.18,
      "start": 3891.98,
      "text": "哦"
    },
    {
      "end": 3893.64,
      "start": 3892.18,
      "text": "我不承认你一个政党"
    },
    {
      "end": 3895.28,
      "start": 3893.64,
      "text": "你就告诉我不是中国人"
    },
    {
      "end": 3897.68,
      "start": 3895.28,
      "text": "你们这帮孙子不是胡说八道吗"
    },
    {
      "end": 3898.12,
      "start": 3897.68,
      "text": "对吧"
    },
    {
      "end": 3901.02,
      "start": 3898.12,
      "text": "他们给人的洗脑是在这里面"
    },
    {
      "end": 3904.26,
      "start": 3901.02,
      "text": "非常关键的就是我们的人没有逻辑"
    },
    {
      "end": 3905.96,
      "start": 3904.26,
      "text": "当我们有逻辑"
    },
    {
      "end": 3910.56,
      "start": 3905.96,
      "text": "有这种勇气来去站在平台上跟他们讲话的时候"
    },
    {
      "end": 3915.1,
      "start": 3910.56,
      "text": "这帮孙子没有一个人能来回答我们的问题"
    },
    {
      "end": 3919.1,
      "start": 3915.1,
      "text": "能敢于跟我们面对面正面交锋的没有一个"
    },
    {
      "end": 3921.16,
      "start": 3919.1,
      "text": "因为我从小在八一队"
    },
    {
      "end": 3924.68,
      "start": 3921.16,
      "text": "我从小知道这帮孙子是个什么鸟"
    },
    {
      "end": 3930.32,
      "start": 3924.68,
      "text": "他们所有的一切都建立在他们的专制集权底下"
    },
    {
      "end": 3931.76,
      "start": 3930.32,
      "text": "他们所谓的有军队"
    },
    {
      "end": 3932.48,
      "start": 3931.76,
      "text": "对吧"
    },
    {
      "end": 3933.72,
      "start": 3932.48,
      "text": "有两个满枪"
    },
    {
      "end": 3935.56,
      "start": 3933.72,
      "text": "你不行把你抓起来"
    },
    {
      "end": 3935.96,
      "start": 3935.56,
      "text": "对吧"
    },
    {
      "end": 3936.94,
      "start": 3935.96,
      "text": "给你们毙了"
    },
    {
      "end": 3938.5,
      "start": 3936.94,
      "text": "他们就这点本事"
    },
    {
      "end": 3940.22,
      "start": 3938.5,
      "text": "完了分化你"
    },
    {
      "end": 3942.04,
      "start": 3940.22,
      "text": "5%的人杀了"
    },
    {
      "end": 3942.98,
      "start": 3942.04,
      "text": "其他人"
    },
    {
      "end": 3945.42,
      "start": 3942.98,
      "text": "完了让你们听我的话"
    },
    {
      "end": 3946.68,
      "start": 3945.42,
      "text": "作为奴隶"
    },
    {
      "end": 3948.08,
      "start": 3946.68,
      "text": "作为奴才"
    },
    {
      "end": 3952.62,
      "start": 3948.08,
      "text": "这是非常非常可怕的事情"
    },
    {
      "end": 3955.7,
      "start": 3952.62,
      "text": "我也想向所有的中国人"
    },
    {
      "end": 3957.44,
      "start": 3955.7,
      "text": "所有我们祖国的同胞们"
    },
    {
      "end": 3959.1,
      "start": 3957.44,
      "text": "所有的说出来"
    },
    {
      "end": 3961.6,
      "start": 3959.1,
      "text": "我们内心的这种感受"
    },
    {
      "end": 3965.46,
      "start": 3961.6,
      "text": "你们不需要为他们的这种愚昧"
    },
    {
      "end": 3966.42,
      "start": 3965.46,
      "text": "他们的独裁"
    },
    {
      "end": 3970.68,
      "start": 3966.42,
      "text": "他们的这种集权来付出自己生命的代价"
    },
    {
      "end": 3971.94,
      "start": 3970.68,
      "text": "好的主持人"
    },
    {
      "end": 3974.72,
      "start": 3971.94,
      "text": "非常感谢郝先生的分享"
    },
    {
      "end": 3979.5,
      "start": 3974.72,
      "text": "中国共产党这70年毁掉了我们的信仰"
    },
    {
      "end": 3981.5,
      "start": 3979.5,
      "text": "毁掉了我们的创造力"
    },
    {
      "end": 3983.0,
      "start": 3981.5,
      "text": "所以才有郭先生"
    },
    {
      "end": 3988.16,
      "start": 3983.0,
      "text": "还有郝海东这些优秀的有武器的人带领我们实现我们的新中国联邦"
    },
    {
      "end": 3991.56,
      "start": 3988.16,
      "text": "那么您还有其他跟我们的债务分享的吗"
    },
    {
      "end": 3993.3,
      "start": 3991.56,
      "text": "对"
    },
    {
      "end": 3995.82,
      "start": 3993.3,
      "text": "就是我特别"
    },
    {
      "end": 3998.72,
      "start": 3995.82,
      "text": "就是能感受"
    },
    {
      "end": 4000.0,
      "start": 3998.72,
      "text": "感觉到"
    },
    {
      "end": 4001.14,
      "start": 4000.0,
      "text": "我们这些"
    },
    {
      "end": 4003.5,
      "start": 4001.14,
      "text": "这个老百姓"
    },
    {
      "end": 4004.42,
      "start": 4003.5,
      "text": "被我们"
    },
    {
      "end": 4006.12,
      "start": 4004.42,
      "text": "共产党"
    },
    {
      "end": 4007.64,
      "start": 4006.12,
      "text": "被这些人"
    },
    {
      "end": 4008.7,
      "start": 4007.64,
      "text": "给这个"
    },
    {
      "end": 4011.46,
      "start": 4008.7,
      "text": "洗脑的"
    },
    {
      "end": 4012.12,
      "start": 4011.46,
      "text": "一些"
    },
    {
      "end": 4014.2,
      "start": 4012.12,
      "text": "里面"
    },
    {
      "end": 4016.46,
      "start": 4014.2,
      "text": "就是比如说他们老说"
    },
    {
      "end": 4017.84,
      "start": 4016.46,
      "text": "没有国家培养"
    },
    {
      "end": 4020.42,
      "start": 4017.84,
      "text": "怎么有郝海东夜刀营你们取得的成绩"
    },
    {
      "end": 4022.42,
      "start": 4020.42,
      "text": "他们这种悖论"
    },
    {
      "end": 4024.42,
      "start": 4022.42,
      "text": "就在这里面"
    },
    {
      "end": 4028.26,
      "start": 4024.42,
      "text": "他就是完全的呈现出他们的悖论"
    },
    {
      "end": 4031.46,
      "start": 4028.26,
      "text": "好像是他们培养了我似的"
    },
    {
      "end": 4034.46,
      "start": 4031.46,
      "text": "好像我十栋凤里蹦出来"
    },
    {
      "end": 4038.92,
      "start": 4034.46,
      "text": "是我爹我娘也生养了我"
    },
    {
      "end": 4039.42,
      "start": 4038.92,
      "text": "对吧"
    },
    {
      "end": 4041.26,
      "start": 4039.42,
      "text": "你用你的体制"
    },
    {
      "end": 4044.96,
      "start": 4041.26,
      "text": "个别的人你把它弄到了八一队去"
    },
    {
      "end": 4047.5,
      "start": 4044.96,
      "text": "你灭了很多人"
    },
    {
      "end": 4049.06,
      "start": 4047.5,
      "text": "他们的逻辑就是"
    },
    {
      "end": 4054.06,
      "start": 4049.06,
      "text": "是因为我们被选到了这个审队"
    },
    {
      "end": 4056.06,
      "start": 4054.06,
      "text": "那都是国家花的钱"
    },
    {
      "end": 4059.06,
      "start": 4056.06,
      "text": "然后我们自己没有出一分钱"
    },
    {
      "end": 4062.06,
      "start": 4059.06,
      "text": "所以这是国家培养你的"
    },
    {
      "end": 4063.06,
      "start": 4062.06,
      "text": "他们是这个逻辑"
    },
    {
      "end": 4066.06,
      "start": 4063.06,
      "text": "他不知道社会体系"
    },
    {
      "end": 4071.06,
      "start": 4066.06,
      "text": "不需要你来去拿国家纳税人的钱"
    },
    {
      "end": 4075.06,
      "start": 4071.06,
      "text": "弄出来你来说几个人来提几个人来举重"
    },
    {
      "end": 4078.06,
      "start": 4075.06,
      "text": "几个人来体操几个人来打羽毛球"
    },
    {
      "end": 4079.06,
      "start": 4078.06,
      "text": "不是这样的"
    },
    {
      "end": 4082.06,
      "start": 4079.06,
      "text": "是一个社区文化"
    },
    {
      "end": 4084.06,
      "start": 4082.06,
      "text": "城市文化"
    },
    {
      "end": 4090.06,
      "start": 4084.06,
      "text": "是一个让社会来承担更多的这种责任"
    },
    {
      "end": 4092.06,
      "start": 4090.06,
      "text": "而不是让一个政党"
    },
    {
      "end": 4094.06,
      "start": 4092.06,
      "text": "我们所有的理念"
    },
    {
      "end": 4095.06,
      "start": 4094.06,
      "text": "所有的概念"
    },
    {
      "end": 4096.06,
      "start": 4095.06,
      "text": "他全混淆了"
    },
    {
      "end": 4099.06,
      "start": 4096.06,
      "text": "他把好事都弄到他身上"
    },
    {
      "end": 4102.06,
      "start": 4099.06,
      "text": "坏事你们干了"
    },
    {
      "end": 4103.06,
      "start": 4102.06,
      "text": "他们老说"
    },
    {
      "end": 4105.06,
      "start": 4103.06,
      "text": "你们足球不行"
    },
    {
      "end": 4107.06,
      "start": 4105.06,
      "text": "为什么别的项目行"
    },
    {
      "end": 4113.06,
      "start": 4107.06,
      "text": "他从来不说足球有多少的全世界的人的职业俱乐部"
    },
    {
      "end": 4117.06,
      "start": 4113.06,
      "text": "全世界足球好的有多少人在踢"
    },
    {
      "end": 4120.06,
      "start": 4117.06,
      "text": "他拿有多少的人口来算"
    },
    {
      "end": 4122.06,
      "start": 4120.06,
      "text": "那中国还有14亿人呢"
    },
    {
      "end": 4124.06,
      "start": 4122.06,
      "text": "自行车从来还法没赢过"
    },
    {
      "end": 4125.06,
      "start": 4124.06,
      "text": "怎么说"
    },
    {
      "end": 4128.06,
      "start": 4125.06,
      "text": "那全世界有五六十亿人"
    },
    {
      "end": 4130.06,
      "start": 4128.06,
      "text": "一个打平方球的都赢不了你"
    },
    {
      "end": 4133.06,
      "start": 4130.06,
      "text": "你认为全世界那些都是傻子吗"
    },
    {
      "end": 4134.06,
      "start": 4133.06,
      "text": "对吗"
    },
    {
      "end": 4136.06,
      "start": 4134.06,
      "text": "这种逻辑思维"
    },
    {
      "end": 4138.06,
      "start": 4136.06,
      "text": "为什么在我们的国家里面"
    },
    {
      "end": 4141.06,
      "start": 4138.06,
      "text": "没有人去这样反思"
    },
    {
      "end": 4142.06,
      "start": 4141.06,
      "text": "没有人去跟他们"
    },
    {
      "end": 4146.06,
      "start": 4142.06,
      "text": "跟他们在一起来去说这些事情"
    },
    {
      "end": 4149.06,
      "start": 4146.06,
      "text": "因为一旦你要是说了这些事情的时候"
    },
    {
      "end": 4151.06,
      "start": 4149.06,
      "text": "你就被消失"
    },
    {
      "end": 4152.06,
      "start": 4151.06,
      "text": "你就被穿小鞋"
    },
    {
      "end": 4154.06,
      "start": 4152.06,
      "text": "你就没有机会再去上升"
    },
    {
      "end": 4157.06,
      "start": 4154.06,
      "text": "而且他把你弄得死死的"
    },
    {
      "end": 4159.06,
      "start": 4157.06,
      "text": "你如果不进体制"
    },
    {
      "end": 4161.06,
      "start": 4159.06,
      "text": "你就是要被边缘化"
    },
    {
      "end": 4166.06,
      "start": 4161.06,
      "text": "你就没有机会再在你这个行业里面有保障"
    },
    {
      "end": 4169.06,
      "start": 4166.06,
      "text": "人连生存都没有保障的时候"
    },
    {
      "end": 4170.06,
      "start": 4169.06,
      "text": "那你想一想"
    },
    {
      "end": 4172.06,
      "start": 4170.06,
      "text": "他最后怎么办"
    },
    {
      "end": 4174.06,
      "start": 4172.06,
      "text": "很多人都屈服了"
    },
    {
      "end": 4179.06,
      "start": 4174.06,
      "text": "这就是他们一直在愚弄的老百姓的所有的这些"
    },
    {
      "end": 4181.06,
      "start": 4179.06,
      "text": "我就想走到今天的时候"
    },
    {
      "end": 4185.06,
      "start": 4181.06,
      "text": "我们为我们所有的国人能去进一份力"
    },
    {
      "end": 4190.06,
      "start": 4185.06,
      "text": "就是共产党一定完蛋"
    },
    {
      "end": 4192.06,
      "start": 4190.06,
      "text": "我一直坚信"
    },
    {
      "end": 4194.06,
      "start": 4192.06,
      "text": "只是说他时间的长短"
    },
    {
      "end": 4195.06,
      "start": 4194.06,
      "text": "那么有了爆料革命"
    },
    {
      "end": 4197.06,
      "start": 4195.06,
      "text": "有了新中国联邦"
    },
    {
      "end": 4200.06,
      "start": 4197.06,
      "text": "加速了他的这种灭亡的进程"
    },
    {
      "end": 4201.06,
      "start": 4200.06,
      "text": "因为什么"
    },
    {
      "end": 4203.06,
      "start": 4201.06,
      "text": "因为这是世界规律"
    },
    {
      "end": 4205.06,
      "start": 4203.06,
      "text": "文明向前的规律"
    },
    {
      "end": 4207.06,
      "start": 4205.06,
      "text": "2000多年的文明"
    },
    {
      "end": 4210.06,
      "start": 4207.06,
      "text": "以及美国代表的更多的这种科技力量"
    },
    {
      "end": 4211.06,
      "start": 4210.06,
      "text": "金融力量"
    },
    {
      "end": 4212.06,
      "start": 4211.06,
      "text": "这种军事力量"
    },
    {
      "end": 4216.06,
      "start": 4212.06,
      "text": "所有的这种两极的西方文明的代表的这种基督"
    },
    {
      "end": 4217.06,
      "start": 4216.06,
      "text": "天族"
    },
    {
      "end": 4219.06,
      "start": 4217.06,
      "text": "这种几千年的文明里面"
    },
    {
      "end": 4224.06,
      "start": 4219.06,
      "text": "所有的都比中共的共产主义时间更长"
    },
    {
      "end": 4225.06,
      "start": 4224.06,
      "text": "更有基础"
    },
    {
      "end": 4232.06,
      "start": 4225.06,
      "text": "比他那种独裁洗脑的70多年的这种独裁的这种洗脑更有力量"
    },
    {
      "end": 4242.06,
      "start": 4232.06,
      "text": "所以我就跟大家更多的分享的就是希望大家能去有自我的这种独立判断能力"
    },
    {
      "end": 4243.06,
      "start": 4242.06,
      "text": "独立思考能力"
    },
    {
      "end": 4250.06,
      "start": 4243.06,
      "text": "完了以后让自己有更多的信仰的这种在心中"
    },
    {
      "end": 4257.06,
      "start": 4250.06,
      "text": "完了以后有常识的有逻辑的有所有的分析能力的去看待未来"
    },
    {
      "end": 4262.06,
      "start": 4257.06,
      "text": "一定不能让共产党把我们绑架在他的战车上"
    },
    {
      "end": 4263.06,
      "start": 4262.06,
      "text": "因为太可怕了"
    },
    {
      "end": 4266.06,
      "start": 4263.06,
      "text": "所有的运动员都是一样的"
    },
    {
      "end": 4268.06,
      "start": 4266.06,
      "text": "他们就是一个棋子"
    },
    {
      "end": 4270.06,
      "start": 4268.06,
      "text": "当你在这种体育队"
    },
    {
      "end": 4272.06,
      "start": 4270.06,
      "text": "当你还能拿冠军的时候"
    },
    {
      "end": 4277.06,
      "start": 4272.06,
      "text": "你还算是他的利用的这种棋子"
    },
    {
      "end": 4279.06,
      "start": 4277.06,
      "text": "当你成第二的时候"
    },
    {
      "end": 4280.06,
      "start": 4279.06,
      "text": "第五的时候"
    },
    {
      "end": 4282.06,
      "start": 4280.06,
      "text": "你一点价值没有"
    },
    {
      "end": 4287.06,
      "start": 4282.06,
      "text": "这个在我们的所有的亲身经历当中都看到了"
    },
    {
      "end": 4289.06,
      "start": 4287.06,
      "text": "我们上面的运动员"
    },
    {
      "end": 4290.06,
      "start": 4289.06,
      "text": "我们对吧"
    },
    {
      "end": 4291.06,
      "start": 4290.06,
      "text": "比我们大的运动员"
    },
    {
      "end": 4293.06,
      "start": 4291.06,
      "text": "他们退役的惨状"
    },
    {
      "end": 4296.06,
      "start": 4293.06,
      "text": "以及成绩还不错"
    },
    {
      "end": 4297.06,
      "start": 4296.06,
      "text": "包括亚洲冠军"
    },
    {
      "end": 4300.06,
      "start": 4297.06,
      "text": "死都没有葬身之地"
    },
    {
      "end": 4302.06,
      "start": 4300.06,
      "text": "那财力"
    },
    {
      "end": 4303.06,
      "start": 4302.06,
      "text": "这不是我说的"
    },
    {
      "end": 4308.06,
      "start": 4303.06,
      "text": "共产党你们所有的你们都能看到浩海东说的每一句话"
    },
    {
      "end": 4311.06,
      "start": 4308.06,
      "text": "你们知道浩海东说的每一件事情"
    },
    {
      "end": 4313.06,
      "start": 4311.06,
      "text": "每一句话都是真实的"
    },
    {
      "end": 4315.06,
      "start": 4313.06,
      "text": "我从来不污蔑任何"
    },
    {
      "end": 4318.06,
      "start": 4315.06,
      "text": "我讲的任何一句话都对自己负责"
    },
    {
      "end": 4320.06,
      "start": 4318.06,
      "text": "而且我没讲过一句假话"
    },
    {
      "end": 4323.06,
      "start": 4320.06,
      "text": "我也知道是为什么特别特别佩服"
    },
    {
      "end": 4326.06,
      "start": 4323.06,
      "text": "特别认同郭先生说的这个为真不惑"
    },
    {
      "end": 4328.06,
      "start": 4326.06,
      "text": "人讲假话"
    },
    {
      "end": 4330.06,
      "start": 4328.06,
      "text": "一切诚信没有了"
    },
    {
      "end": 4332.06,
      "start": 4330.06,
      "text": "中国最可怕的之一也是在这"
    },
    {
      "end": 4333.06,
      "start": 4332.06,
      "text": "没有信用"
    },
    {
      "end": 4335.06,
      "start": 4334.06,
      "text": "是吧"
    },
    {
      "end": 4337.06,
      "start": 4335.06,
      "text": "共产党主席台上那些人讲的"
    },
    {
      "end": 4339.06,
      "start": 4337.06,
      "text": "每一个人都是放屁"
    },
    {
      "end": 4340.06,
      "start": 4339.06,
      "text": "都是假话"
    },
    {
      "end": 4342.06,
      "start": 4340.06,
      "text": "而且他能坐在主席台上的"
    },
    {
      "end": 4346.06,
      "start": 4342.06,
      "text": "一定是假丑恶假赌黑上去的"
    },
    {
      "end": 4349.06,
      "start": 4346.06,
      "text": "如果不是他就坐不到那个看台上"
    },
    {
      "end": 4350.06,
      "start": 4349.06,
      "text": "他那个主席台上"
    },
    {
      "end": 4354.06,
      "start": 4350.06,
      "text": "因为我们从小跟这些人在一块生活"
    },
    {
      "end": 4355.06,
      "start": 4354.06,
      "text": "在一块工作"
    },
    {
      "end": 4360.06,
      "start": 4355.06,
      "text": "在一起看到他们怎么一步一步走向这种权力的中心的时候"
    },
    {
      "end": 4363.06,
      "start": 4360.06,
      "text": "我们看到了他们的丑恶"
    },
    {
      "end": 4364.06,
      "start": 4363.06,
      "text": "在这里就是这样"
    },
    {
      "end": 4367.06,
      "start": 4364.06,
      "text": "而且小叶也有更多的这种亲身体会"
    },
    {
      "end": 4370.06,
      "start": 4367.06,
      "text": "因为他也在这种体制里面"
    },
    {
      "end": 4374.06,
      "start": 4370.06,
      "text": "他已经曾经的被迫害被胁迫"
    },
    {
      "end": 4376.06,
      "start": 4374.06,
      "text": "被别人强迫"
    },
    {
      "end": 4379.06,
      "start": 4376.06,
      "text": "所谓的拿国家荣誉来扯淡"
    },
    {
      "end": 4380.06,
      "start": 4379.06,
      "text": "是吧"
    },
    {
      "end": 4383.06,
      "start": 4380.06,
      "text": "那当时李永波就是说"
    },
    {
      "end": 4386.06,
      "start": 4383.06,
      "text": "他就是因为跟共产党有睡觉"
    },
    {
      "end": 4387.06,
      "start": 4386.06,
      "text": "是吧"
    },
    {
      "end": 4389.06,
      "start": 4387.06,
      "text": "完了以后就让小叶让给他"
    },
    {
      "end": 4392.06,
      "start": 4389.06,
      "text": "完了说是那个人如果"
    },
    {
      "end": 4394.06,
      "start": 4392.06,
      "text": "这个这个这个"
    },
    {
      "end": 4395.06,
      "start": 4394.06,
      "text": "来打"
    },
    {
      "end": 4397.06,
      "start": 4395.06,
      "text": "马铁而过来打的话"
    },
    {
      "end": 4401.06,
      "start": 4397.06,
      "text": "可能公志超赢的机会更多一些"
    },
    {
      "end": 4402.06,
      "start": 4401.06,
      "text": "是吧"
    },
    {
      "end": 4405.06,
      "start": 4402.06,
      "text": "他拿这个东西来去说"
    },
    {
      "end": 4407.06,
      "start": 4405.06,
      "text": "只有成者王后败者贼了"
    },
    {
      "end": 4409.06,
      "start": 4407.06,
      "text": "他从来没有"
    },
    {
      "end": 4410.06,
      "start": 4409.06,
      "text": "这种体制里面"
    },
    {
      "end": 4413.06,
      "start": 4410.06,
      "text": "从来没有让人能有这种"
    },
    {
      "end": 4417.06,
      "start": 4413.06,
      "text": "发挥尊重人性"
    },
    {
      "end": 4418.06,
      "start": 4417.06,
      "text": "从来没有"
    },
    {
      "end": 4419.06,
      "start": 4418.06,
      "text": "对吧"
    },
    {
      "end": 4420.06,
      "start": 4419.06,
      "text": "是的"
    },
    {
      "end": 4421.06,
      "start": 4420.06,
      "text": "感谢"
    },
    {
      "end": 4428.06,
      "start": 4425.06,
      "text": "谢谢郭先生"
    },
    {
      "end": 4430.06,
      "start": 4428.06,
      "text": "郭先生"
    },
    {
      "end": 4433.06,
      "start": 4430.06,
      "text": "对于我们中国的体制"
    },
    {
      "end": 4435.06,
      "start": 4433.06,
      "text": "对于现在的中共的体制"
    },
    {
      "end": 4436.06,
      "start": 4435.06,
      "text": "是非常非常的"
    },
    {
      "end": 4438.06,
      "start": 4436.06,
      "text": "就是深刻的人士"
    },
    {
      "end": 4440.06,
      "start": 4438.06,
      "text": "那么前天郭先生"
    },
    {
      "end": 4442.06,
      "start": 4440.06,
      "text": "在直播里面说起了这个"
    },
    {
      "end": 4443.06,
      "start": 4442.06,
      "text": "程虎的事件"
    },
    {
      "end": 4444.06,
      "start": 4443.06,
      "text": "我们知道这场病毒"
    },
    {
      "end": 4445.06,
      "start": 4444.06,
      "text": "人工病毒"
    },
    {
      "end": 4446.06,
      "start": 4445.06,
      "text": "对这个世界带来了一个"
    },
    {
      "end": 4447.06,
      "start": 4446.06,
      "text": "巨大的灾难"
    },
    {
      "end": 4452.06,
      "start": 4447.06,
      "text": "我想請問我們的這個郝海東先生"
    },
    {
      "end": 4456.36,
      "start": 4452.06,
      "text": "您對陳虎的這個被毒針注射的這個事件"
    },
    {
      "end": 4457.56,
      "start": 4456.36,
      "text": "您是怎麼看的呢?"
    },
    {
      "end": 4460.86,
      "start": 4458.56,
      "text": "我一點不奇怪"
    },
    {
      "end": 4465.36,
      "start": 4461.06,
      "text": "你們知道這個徐明啊"
    },
    {
      "end": 4468.36,
      "start": 4465.36,
      "text": "徐明你們應該知道啊"
    },
    {
      "end": 4471.36,
      "start": 4468.36,
      "text": "那麼他就是施德的這個老闆"
    },
    {
      "end": 4477.06,
      "start": 4471.36,
      "text": "其實這個在大年"
    },
    {
      "end": 4480.56,
      "start": 4477.06,
      "text": "他就是很小而且他是個農村人"
    },
    {
      "end": 4484.56,
      "start": 4480.56,
      "text": "他不是大年人他是裝河那個樣子"
    },
    {
      "end": 4488.56,
      "start": 4484.56,
      "text": "一個原先挖土石方的這麼一個小孩"
    },
    {
      "end": 4490.56,
      "start": 4488.56,
      "text": "他比我還小一歲71年"
    },
    {
      "end": 4495.06,
      "start": 4490.56,
      "text": "那他基本上都快死了"
    },
    {
      "end": 4499.56,
      "start": 4495.06,
      "text": "因為他很嚴重的肝硬化肝病"
