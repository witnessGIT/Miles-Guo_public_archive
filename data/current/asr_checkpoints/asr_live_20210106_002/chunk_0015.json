    },
    {
      "end": 14054.0,
      "start": 14052.0,
      "text": "他缺少的就是奴性"
    },
    {
      "end": 14055.0,
      "start": 14054.0,
      "text": "沒有的"
    },
    {
      "end": 14057.0,
      "start": 14055.0,
      "text": "謝謝"
    },
    {
      "end": 14058.0,
      "start": 14057.0,
      "text": "是的"
    },
    {
      "end": 14059.0,
      "start": 14058.0,
      "text": "非常感謝"
    },
    {
      "end": 14060.0,
      "start": 14059.0,
      "text": "謝謝你"
    },
    {
