    {
      "end": 13862.0,
      "start": 13860.0,
      "text": "一定堅信的"
    },
    {
      "end": 13863.0,
      "start": 13862.0,
      "text": "是的"
    },
    {
      "end": 13864.0,
      "start": 13863.0,
      "text": "非常感謝"
    },
    {
      "end": 13866.0,
      "start": 13864.0,
      "text": "暴了革命給我們一家帶來就是希望"
