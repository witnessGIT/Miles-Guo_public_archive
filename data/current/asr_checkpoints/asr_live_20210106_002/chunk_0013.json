    },
    {
      "end": 12090.0,
      "start": 12089.0,
      "text": "同樣的語言"
    },
    {
      "end": 12091.0,
      "start": 12090.0,
      "text": "同樣的文明"
    },
    {
      "end": 12092.0,
      "start": 12091.0,
      "text": "同樣的信仰"
    },
    {
      "end": 12093.0,
      "start": 12092.0,
      "text": "共產黨和它之間"
    },
    {
      "end": 12094.0,
      "start": 12093.0,
      "text": "都是相反的"
    },
    {
      "end": 12096.0,
      "start": 12094.0,
      "text": "最後是啥也不會有"
    },
    {
      "end": 12098.0,
      "start": 12096.0,
      "text": "所以說歐美之間"
    },
    {
      "end": 12099.0,
      "start": 12098.0,
      "text": "必將淵遠流長"
    },
    {
      "end": 12100.0,
      "start": 12099.0,
      "text": "謝謝清京廠"
    },
    {
      "end": 12102.0,
      "start": 12100.0,
      "text": "我現在馬上有個緊急電話"
    },
    {
      "end": 12103.0,
      "start": 12102.0,
      "text": "主持人"
    },
    {
      "end": 12104.0,
      "start": 12103.0,
      "text": "清京廠你們先說的"
    },
    {
      "end": 12106.0,
      "start": 12104.0,
      "text": "我要馬上來華盛頓的電話"
    },
    {
      "end": 12107.0,
      "start": 12106.0,
      "text": "我一會兒再回來"
    },
    {
      "end": 12108.0,
      "start": 12107.0,
